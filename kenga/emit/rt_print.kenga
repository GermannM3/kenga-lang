// Emit value printers for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_print.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_print.kenga — do not hand-edit */\n";
    s = s + "static void ensure_slot(ValA *slots, int64_t si) {\n";
    s = s + "  while ((int64_t)slots->len <= si) vala_push(slots, V_i64(0));\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t as_i64(Value v, const char *ctx) {\n";
    s = s + "  if (v.tag != TAG_I64) die(ctx);\n";
    s = s + "  return v.payload;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void print_val_raw(Value v, StrA *strs, ListHeap *lists, StructHeap *structs,\n";
    s = s + "                          StructType *stypes, size_t nstypes);\n";
    s = s + "\n";
    s = s + "static void print_value(Value v, StrA *strs, ListHeap *lists, StructHeap *structs,\n";
    s = s + "                        StructType *stypes, size_t nstypes) {\n";
    s = s + "  print_val_raw(v, strs, lists, structs, stypes, nstypes);\n";
    s = s + "  putchar('\\n');\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void print_val_raw(Value v, StrA *strs, ListHeap *lists, StructHeap *structs,\n";
    s = s + "                          StructType *stypes, size_t nstypes) {\n";
    s = s + "  if (v.tag == TAG_I64) {\n";
    s = s + "    printf(\"%lld\", (long long)v.payload);\n";
    s = s + "  } else if (v.tag == TAG_F64) {\n";
    s = s + "    printf(\"%g\", f64_bits(v));\n";
    s = s + "  } else if (v.tag == TAG_STR) {\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= strs->len) die(\"bad str handle\");\n";
    s = s + "    printf(\"%s\", strs->data[v.payload]);\n";
    s = s + "  } else if (v.tag == TAG_LIST) {\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= lists->len) die(\"bad list handle\");\n";
    s = s + "    ValA *L = &lists->data[v.payload];\n";
    s = s + "    putchar('[');\n";
    s = s + "    for (size_t i = 0; i < L->len; i++) {\n";
    s = s + "      if (i) printf(\", \");\n";
    s = s + "      print_val_raw(L->data[i], strs, lists, structs, stypes, nstypes);\n";
    s = s + "    }\n";
    s = s + "    putchar(']');\n";
    s = s + "  } else if (v.tag == TAG_STRUCT) {\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= structs->len) die(\"bad struct handle\");\n";
    s = s + "    StructObj *o = &structs->data[v.payload];\n";
    s = s + "    if (o->type_id < 0 || (size_t)o->type_id >= nstypes) die(\"bad struct type\");\n";
    s = s + "    printf(\"%s{\", stypes[o->type_id].name);\n";
    s = s + "    for (size_t i = 0; i < o->fields.len; i++) {\n";
    s = s + "      if (i) printf(\", \");\n";
    s = s + "      printf(\"%lld\", (long long)o->fields.data[i]);\n";
    s = s + "    }\n";
    s = s + "    putchar('}');\n";
    s = s + "  } else {\n";
    s = s + "    die(\"bad value tag\");\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int values_eq(Value a, Value b, StrA *strs) {\n";
    s = s + "  if (is_num(a) && is_num(b)) return to_f64(a, \"eq\") == to_f64(b, \"eq\");\n";
    s = s + "  if (a.tag != b.tag) return 0;\n";
    s = s + "  if (a.tag == TAG_I64) return a.payload == b.payload;\n";
    s = s + "  if (a.tag == TAG_STR) {\n";
    s = s + "    if (a.payload < 0 || b.payload < 0 || (size_t)a.payload >= strs->len ||\n";
    s = s + "        (size_t)b.payload >= strs->len)\n";
    s = s + "      die(\"bad str handle\");\n";
    s = s + "    return strcmp(strs->data[a.payload], strs->data[b.payload]) == 0;\n";
    s = s + "  }\n";
    s = s + "  if (a.tag == TAG_LIST) return a.payload == b.payload; /* same handle */\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_print.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_print.inc.c");
    println("rt_print ok");
    return 0;
}
