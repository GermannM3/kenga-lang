// Emit slice / index_of / starts_with / split for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_str.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_str.kenga — do not hand-edit */\n";
    s = s + "static void k_clamp_range(int64_t n, int64_t *start, int64_t *end) {\n";
    s = s + "  if (*start < 0) *start = 0;\n";
    s = s + "  if (*start > n) *start = n;\n";
    s = s + "  if (*end > n) *end = n;\n";
    s = s + "  if (*end < *start) *end = *start;\n";
    s = s + "}\n\n";
    s = s + "static char *k_slice(const char *in, int64_t start, int64_t end) {\n";
    s = s + "  size_t n;\n";
    s = s + "  size_t len;\n";
    s = s + "  char *o;\n";
    s = s + "  if (!in) in = \"\";\n";
    s = s + "  n = strlen(in);\n";
    s = s + "  k_clamp_range((int64_t)n, &start, &end);\n";
    s = s + "  len = (size_t)(end - start);\n";
    s = s + "  o = (char *)malloc(len + 1);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  if (len) memcpy(o, in + (size_t)start, len);\n";
    s = s + "  o[len] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static int64_t k_index_of(const char *s, const char *p) {\n";
    s = s + "  size_t n, m, i;\n";
    s = s + "  if (!s) s = \"\";\n";
    s = s + "  if (!p) p = \"\";\n";
    s = s + "  n = strlen(s);\n";
    s = s + "  m = strlen(p);\n";
    s = s + "  if (m == 0) return 0;\n";
    s = s + "  if (m > n) return -1;\n";
    s = s + "  for (i = 0; i + m <= n; i++) {\n";
    s = s + "    if (memcmp(s + i, p, m) == 0) return (int64_t)i;\n";
    s = s + "  }\n";
    s = s + "  return -1;\n";
    s = s + "}\n\n";
    s = s + "static int64_t k_starts_with(const char *s, const char *p) {\n";
    s = s + "  size_t m;\n";
    s = s + "  if (!s) s = \"\";\n";
    s = s + "  if (!p) p = \"\";\n";
    s = s + "  m = strlen(p);\n";
    s = s + "  if (m > strlen(s)) return 0;\n";
    s = s + "  return memcmp(s, p, m) == 0 ? 1 : 0;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_str.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_str.inc.c");
    println("rt_str ok");
    return 0;
}
