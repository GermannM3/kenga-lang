    s = s + "        else if (strcmp(id.name, \"ag_value\") == 0) op = OP_AG_VALUE;\n";
    s = s + "        else if (strcmp(id.name, \"ag_grad\") == 0) op = OP_AG_GRAD;\n";
    s = s + "        else if (strcmp(id.name, \"ag_backward\") == 0) op = OP_AG_BACKWARD;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in ag unary\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, op);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"ag_add\") == 0 || strcmp(id.name, \"ag_sub\") == 0 ||\n";
    s = s + "                 strcmp(id.name, \"ag_mul\") == 0 || strcmp(id.name, \"ag_matmul\") == 0 ||\n";
    s = s + "                 strcmp(id.name, \"ag_mse\") == 0 || strcmp(id.name, \"ag_scale\") == 0 ||\n";
    s = s + "                 strcmp(id.name, \"ag_reshape\") == 0 || strcmp(id.name, \"ag_step\") == 0) {\n";
    s = s + "        int64_t op = OP_AG_ADD;\n";
    s = s + "        if (strcmp(id.name, \"ag_sub\") == 0) op = OP_AG_SUB;\n";
    s = s + "        else if (strcmp(id.name, \"ag_mul\") == 0) op = OP_AG_MUL;\n";
    s = s + "        else if (strcmp(id.name, \"ag_matmul\") == 0) op = OP_AG_MATMUL;\n";
    s = s + "        else if (strcmp(id.name, \"ag_mse\") == 0) op = OP_AG_MSE;\n";
    s = s + "        else if (strcmp(id.name, \"ag_scale\") == 0) op = OP_AG_SCALE;\n";
    s = s + "        else if (strcmp(id.name, \"ag_reshape\") == 0) op = OP_AG_RESHAPE;\n";
    s = s + "        else if (strcmp(id.name, \"ag_step\") == 0) op = OP_AG_STEP;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in ag binary\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in ag binary\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, op);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"sweep\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in sweep\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_SWEEP);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"now_ms\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in now_ms\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_NOW_MS);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"println\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"println is a statement, not an expression\");\n";
    s = s + "      } else {\n";
    s = s + "        j++;\n";
    s = s + "        int argc = 0;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j < n && s[j] != ')') {\n";
    s = s + "          for (;;) {\n";
    s = s + "            j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "            argc++;\n";
    s = s + "            j = skip(s, j, n);\n";
    s = s + "            if (j < n && s[j] == ',') {\n";
    s = s + "              j++;\n";
    s = s + "              continue;\n";
    s = s + "            }\n";
    s = s + "            break;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in call\");\n";
    s = s + "        j++;\n";
    s = s + "        int found = 0;\n";
    s = s + "        size_t fni = 0;\n";
    s = s + "        for (size_t fi = 0; fi < fnames->len; fi++) {\n";
    s = s + "          if (strcmp(fnames->data[fi], id.name) == 0) {\n";
    s = s + "            found = 1;\n";
    s = s + "            fni = fi;\n";
    s = s + "            if (fargc->data[fi] != argc) die(\"argc mismatch\");\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        free(id.name);\n";
    s = s + "        if (!found) die(\"unknown function\");\n";
    s = s + "        /* addr patched in call_patches_apply after all fn bodies exist */\n";
    s = s + "        emit3(code, OP_CALL, 0, argc);\n";
    s = s + "        call_patch_add(code->len - 2, fni);\n";
    s = s + "        i = j;\n";
    s = s + "      }\n";
    s = s + "    } else {\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_LOAD, sl);\n";
    s = s + "      i = id.i;\n";
    s = s + "    }\n";
    s = s + "    } /* not true/false */\n";
    s = s + "  } else {\n";
    s = s + "    size_t ii = i;\n";
    s = s + "    ParsedNum num = parse_number(s, &ii, n);\n";
    s = s + "    if (num.is_float) {\n";
    s = s + "      int64_t bits = 0;\n";
    s = s + "      memcpy(&bits, &num.f, sizeof(double));\n";
    s = s + "      emit2(code, OP_CONST_F64, bits);\n";
    s = s + "    } else {\n";
    s = s + "      emit2(code, OP_CONST, num.i);\n";
    s = s + "    }\n";
    s = s + "    i = ii;\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  /* postfix: .field and [index], any chain */\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '.') {\n";
    s = s + "      /* `..` is range, not field */\n";
    s = s + "      if (i + 1 < n && s[i + 1] == '.') break;\n";
    s = s + "      i++;\n";
    s = s + "      Ident fld = parse_ident(s, i, n);\n";
    s = s + "      emit2(code, OP_GET_FIELD, intern_str(fld.name));\n";
    s = s + "      free(fld.name);\n";
    s = s + "      i = fld.i;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (s[i] == '[') {\n";
    s = s + "      i++;\n";
    s = s + "      i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i = skip(s, i, n);\n";
    s = s + "      if (i >= n || s[i] != ']') die(\"expected ]\");\n";
    s = s + "      i++;\n";
    s = s + "      i64a_push(code, OP_GET);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_factor.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_factor.inc.c");
    println("rt_factor ok");
    return 0;
}
