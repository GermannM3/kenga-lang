// Emit factor (literals, calls, postfix) for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_factor.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_factor.kenga — do not hand-edit */\n";
    s = s + "static int lite_ml_name(const char *n) {\n";
    s = s + "  return strcmp(n, \"t_from\") == 0 || strcmp(n, \"t_get\") == 0 || strcmp(n, \"t_set\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_shape\") == 0 || strcmp(n, \"t_add\") == 0 || strcmp(n, \"t_sub\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_mul\") == 0 || strcmp(n, \"t_matmul\") == 0 || strcmp(n, \"t_fill\") == 0 ||\n";
    s = s + "         strcmp(n, \"tensor\") == 0 || strcmp(n, \"t_reshape\") == 0 || strcmp(n, \"t_transpose\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_scale\") == 0 || strcmp(n, \"t_sum\") == 0 || strcmp(n, \"t_dot\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_exp\") == 0 || strcmp(n, \"t_log\") == 0 || strcmp(n, \"t_softmax\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_mean\") == 0 || strcmp(n, \"t_mse\") == 0 || strcmp(n, \"t_patch_mean\") == 0 ||\n";
    s = s + "         strcmp(n, \"t_linear_grad\") == 0 || strcmp(n, \"save_tensor\") == 0 ||\n";
    s = s + "         strcmp(n, \"load_tensor\") == 0 || strcmp(n, \"load_ppm\") == 0 || strcmp(n, \"load_wav\") == 0 ||\n";
    s = s + "         strcmp(n, \"memory_config\") == 0 || strcmp(n, \"memory\") == 0 || strcmp(n, \"remember\") == 0 ||\n";
    s = s + "         strcmp(n, \"remember_next\") == 0 || strcmp(n, \"surprise\") == 0 || strcmp(n, \"foresee\") == 0 ||\n";
    s = s + "         strcmp(n, \"foresee_n\") == 0 || strcmp(n, \"consolidate\") == 0 || strcmp(n, \"mem_stats\") == 0 ||\n";
    s = s + "         strcmp(n, \"recall\") == 0 || strcmp(n, \"save_mind\") == 0 || strcmp(n, \"load_mind\") == 0 ||\n";
    s = s + "         strcmp(n, \"learn\") == 0 || strcmp(n, \"predict\") == 0 || strcmp(n, \"unroll\") == 0 ||\n";
    s = s + "         strcmp(n, \"sweep\") == 0 || strcmp(n, \"ag_clear\") == 0 || strcmp(n, \"ag_param\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_const\") == 0 || strcmp(n, \"ag_add\") == 0 || strcmp(n, \"ag_sub\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_mul\") == 0 || strcmp(n, \"ag_matmul\") == 0 || strcmp(n, \"ag_mse\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_scale\") == 0 || strcmp(n, \"ag_relu\") == 0 || strcmp(n, \"ag_neg\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_transpose\") == 0 || strcmp(n, \"ag_reshape\") == 0 || strcmp(n, \"ag_exp\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_log\") == 0 || strcmp(n, \"ag_softmax\") == 0 || strcmp(n, \"ag_sum\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_value\") == 0 || strcmp(n, \"ag_grad\") == 0 || strcmp(n, \"ag_backward\") == 0 ||\n";
    s = s + "         strcmp(n, \"ag_step\") == 0;\n";
    s = s + "}\n";
    s = s + "static int lite_fn_defined(StrA *fnames, const char *n) {\n";
    s = s + "  size_t fi;\n";
    s = s + "  for (fi = 0; fi < fnames->len; fi++) {\n";
    s = s + "    if (strcmp(fnames->data[fi], n) == 0) return 1;\n";
    s = s + "  }\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "static size_t emit_factor(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                         StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i >= n) die(\"unexpected eof in factor\");\n";
    s = s + "\n";
    s = s + "  if (s[i] == '(') {\n";
    s = s + "    i = emit_cmp(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n || s[i] != ')') die(\"expected )\");\n";
    s = s + "    i = i + 1;\n";
    s = s + "  } else if (s[i] == '-') {\n";
    s = s + "    emit2(code, OP_CONST, 0);\n";
    s = s + "    i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_SUB);\n";
    s = s + "    return i; /* unary-minus already includes postfix via recurse */\n";
    s = s + "  } else if (s[i] == '!') {\n";
    s = s + "    i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_NOT);\n";
    s = s + "    return i;\n";
    s = s + "  } else if (s[i] == '~') {\n";
    s = s + "    i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_BNOT);\n";
    s = s + "    return i;\n";
    s = s + "  } else if (s[i] == '\"') {\n";
    s = s + "    size_t ii = i;\n";
    s = s + "    char *lit = parse_string(s, &ii, n);\n";
    s = s + "    int idx = intern_str(lit);\n";
    s = s + "    free(lit);\n";
    s = s + "    emit2(code, OP_CONST_STR, idx);\n";
    s = s + "    i = ii;\n";
    s = s + "  } else if (s[i] == '[') {\n";
    s = s + "    i++;\n";
    s = s + "    i64a_push(code, OP_LIST_NEW);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] != ']') {\n";
    s = s + "      for (;;) {\n";
    s = s + "        i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        i64a_push(code, OP_LIST_PUSH);\n";
    s = s + "        i = skip(s, i, n);\n";
    s = s + "        if (i < n && s[i] == ',') {\n";
    s = s + "          i++;\n";
    s = s + "          continue;\n";
    s = s + "        }\n";
    s = s + "        break;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n || s[i] != ']') die(\"expected ]\");\n";
    s = s + "    i++;\n";
    s = s + "  } else if (is_ident_start(s[i])) {\n";
    s = s + "    Ident id = parse_ident(s, i, n);\n";
    s = s + "    if (strcmp(id.name, \"true\") == 0) {\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_CONST, 1);\n";
    s = s + "      i = id.i;\n";
    s = s + "    } else if (strcmp(id.name, \"false\") == 0) {\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_CONST, 0);\n";
    s = s + "      i = id.i;\n";
    s = s + "    } else {\n";
    s = s + "    size_t j = skip(s, id.i, n);\n";
    s = s + "    if (j < n && s[j] == '{') {\n";
    s = s + "      /* struct literal only if name is a known struct (else `xs {` is for-body) */\n";
    s = s + "      int tid = find_struct_type(id.name);\n";
    s = s + "      if (tid < 0) {\n";
    s = s + "        int sl = slot_of(vnames, id.name);\n";
    s = s + "        free(id.name);\n";
    s = s + "        emit2(code, OP_LOAD, sl);\n";
    s = s + "        i = id.i;\n";
    s = s + "      } else {\n";
    s = s + "      free(id.name);\n";
    s = s + "      StructType *st = &g_stypes[tid];\n";
    s = s + "      j++;\n";
    s = s + "      StrA init_names = {0};\n";
    s = s + "      size_t *init_pos = NULL;\n";
    s = s + "      size_t ninit = 0, cap_init = 0;\n";
    s = s + "      j = skip(s, j, n);\n";
    s = s + "      if (j < n && s[j] != '}') {\n";
    s = s + "        for (;;) {\n";
    s = s + "          Ident fn = parse_ident(s, j, n);\n";
    s = s + "          j = skip(s, fn.i, n);\n";
    s = s + "          if (j >= n || s[j] != ':') {\n";
    s = s + "            free(fn.name);\n";
    s = s + "            die(\"expected : in struct literal\");\n";
    s = s + "          }\n";
    s = s + "          j++;\n";
    s = s + "          size_t expr_at = j;\n";
    s = s + "          size_t code_save = code->len;\n";
    s = s + "          j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          code->len = code_save; /* rewind: emit later in decl order */\n";
    s = s + "          if (field_index_of(st, fn.name) < 0) {\n";
    s = s + "            free(fn.name);\n";
    s = s + "            die(\"unknown struct field\");\n";
    s = s + "          }\n";
    s = s + "          for (size_t k = 0; k < ninit; k++) {\n";
    s = s + "            if (strcmp(init_names.data[k], fn.name) == 0) {\n";
    s = s + "              free(fn.name);\n";
    s = s + "              die(\"duplicate struct field\");\n";
    s = s + "            }\n";
    s = s + "          }\n";
    s = s + "          stra_push(&init_names, fn.name);\n";
    s = s + "          if (ninit + 1 > cap_init) {\n";
    s = s + "            cap_init = cap_init ? cap_init * 2 : 4;\n";
    s = s + "            init_pos = (size_t *)xrealloc(init_pos, cap_init * sizeof(size_t));\n";
    s = s + "          }\n";
    s = s + "          init_pos[ninit++] = expr_at;\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (j < n && s[j] == ',') {\n";
    s = s + "            j++;\n";
    s = s + "            j = skip(s, j, n);\n";
    s = s + "            continue;\n";
    s = s + "          }\n";
    s = s + "          break;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      j = skip(s, j, n);\n";
    s = s + "      if (j >= n || s[j] != '}') die(\"expected } in struct literal\");\n";
    s = s + "      j++;\n";
    s = s + "      if (ninit != st->fields.len) {\n";
    s = s + "        for (size_t k = 0; k < init_names.len; k++) free(init_names.data[k]);\n";
    s = s + "        free(init_names.data);\n";
    s = s + "        free(init_pos);\n";
    s = s + "        die(\"struct literal missing fields\");\n";
    s = s + "      }\n";
    s = s + "      for (size_t fi = 0; fi < st->fields.len; fi++) {\n";
    s = s + "        int found = -1;\n";
    s = s + "        for (size_t k = 0; k < ninit; k++) {\n";
    s = s + "          if (strcmp(init_names.data[k], st->fields.data[fi]) == 0) {\n";
    s = s + "            found = (int)k;\n";
    s = s + "            break;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (found < 0) {\n";
    s = s + "          for (size_t k = 0; k < init_names.len; k++) free(init_names.data[k]);\n";
    s = s + "          free(init_names.data);\n";
    s = s + "          free(init_pos);\n";
    s = s + "          die(\"struct literal missing fields\");\n";
    s = s + "        }\n";
    s = s + "        emit_cmp(s, init_pos[found], n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      }\n";
    s = s + "      for (size_t k = 0; k < init_names.len; k++) free(init_names.data[k]);\n";
    s = s + "      free(init_names.data);\n";
    s = s + "      free(init_pos);\n";
    s = s + "      emit2(code, OP_STRUCT_NEW, tid);\n";
    s = s + "      i = j;\n";
    s = s + "      } /* known struct literal */\n";
    s = s + "    } else if (j < n && s[j] == '(') {\n";
    s = s + "      /* builtins: len(xs), push(xs, v) */\n";
    s = s + "      if (lite_ml_name(id.name)) {\n";
    s = s + "        if (!lite_fn_defined(fnames, id.name)) die(\"ML via native_ml (need ml_host)\");\n";
    s = s + "        j++;\n";
    s = s + "        int argc = 0;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j < n && s[j] != ')') {\n";
    s = s + "          for (;;) {\n";
    s = s + "            j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "            argc++;\n";
    s = s + "            j = skip(s, j, n);\n";
    s = s + "            if (j < n && s[j] == ',') {\n";
    s = s + "              j++;\n";
    s = s + "              continue;\n";
    s = s + "            }\n";
    s = s + "            break;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in call\");\n";
    s = s + "        j++;\n";
    s = s + "        {\n";
    s = s + "          int found = 0;\n";
    s = s + "          size_t fni = 0;\n";
    s = s + "          size_t fi;\n";
    s = s + "          for (fi = 0; fi < fnames->len; fi++) {\n";
    s = s + "            if (strcmp(fnames->data[fi], id.name) == 0) {\n";
    s = s + "              found = 1;\n";
    s = s + "              fni = fi;\n";
    s = s + "              if (fargc->data[fi] != argc) die(\"argc mismatch\");\n";
    s = s + "            }\n";
    s = s + "          }\n";
    s = s + "          free(id.name);\n";
    s = s + "          if (!found) die(\"unknown function\");\n";
    s = s + "          emit3(code, OP_CALL, 0, argc);\n";
    s = s + "          call_patch_add(code->len - 2, fni);\n";
    s = s + "        }\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"len\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in len\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_LEN);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"push\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in push\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in push\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_LIST_PUSH);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"round\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in round\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ROUND);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"assert\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in assert\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ASSERT);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"ord\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in ord\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ORD);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"read_file\") == 0 || strcmp(id.name, \"read_bytes\") == 0) {\n";
    s = s + "        int64_t op = strcmp(id.name, \"read_bytes\") == 0 ? OP_READ_BYTES : OP_READ_FILE;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected )\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, op);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"write_file\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected ,\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected )\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_WRITE_FILE);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"emit\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in emit\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in emit\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_EMIT);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"pump\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in pump\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_PUMP);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"after_ms\") == 0) {\n";
    s = s + "        int k;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        for (k = 0; k < 3; k++) {\n";
    s = s + "          j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (k < 2) {\n";
    s = s + "            if (j >= n || s[j] != ',') die(\"expected , in after_ms\");\n";
    s = s + "            j++;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in after_ms\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_AFTER_MS);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"slice\") == 0) {\n";
    s = s + "        int k;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        for (k = 0; k < 3; k++) {\n";
    s = s + "          j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (k < 2) {\n";
    s = s + "            if (j >= n || s[j] != ',') die(\"expected , in slice\");\n";
    s = s + "            j++;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in slice\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_SLICE);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"flush_due\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in flush_due\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_FLUSH_DUE);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"timer_n\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in timer_n\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_TIMER_N);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"pending\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in pending\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_PENDING);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"listen\") == 0) {\n";
    s = s + "        /* listen(event, handlerName) — resolve handler name at runtime via Program */\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in listen\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in listen\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_LISTEN);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"typeof\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in typeof\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_TYPEOF);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"to_str\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in to_str\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_TO_STR);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"argc\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in argc\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ARGC);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"arg\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in arg\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ARG);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"ml_box\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in ml_box\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_ML_BOX);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"file_exists\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in file_exists\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_FILE_EXISTS);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"read_line\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in read_line\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_READ_LINE);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"now_ms\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in now_ms\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_NOW_MS);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"sleep_ms\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in sleep_ms\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_SLEEP_MS);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"getenv\") == 0 || strcmp(id.name, \"json_escape\") == 0 ||\n";
    s = s + "                 strcmp(id.name, \"url_encode\") == 0 || strcmp(id.name, \"html_text\") == 0) {\n";
    s = s + "        int opx = OP_GETENV;\n";
    s = s + "        if (strcmp(id.name, \"json_escape\") == 0) opx = OP_JSON_ESCAPE;\n";
    s = s + "        if (strcmp(id.name, \"url_encode\") == 0) opx = OP_URL_ENCODE;\n";
    s = s + "        if (strcmp(id.name, \"html_text\") == 0) opx = OP_HTML_TEXT;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in str-host\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, opx);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"json_get\") == 0 || strcmp(id.name, \"index_of\") == 0 ||\n";
    s = s + "                 strcmp(id.name, \"split\") == 0 ||\n";
    s = s + "                 (strcmp(id.name, \"starts_with\") == 0 && !lite_fn_defined(fnames, id.name))) {\n";
    s = s + "        int op2 = OP_JSON_GET;\n";
    s = s + "        if (strcmp(id.name, \"index_of\") == 0) op2 = OP_INDEX_OF;\n";
    s = s + "        if (strcmp(id.name, \"split\") == 0) op2 = OP_SPLIT;\n";
    s = s + "        if (strcmp(id.name, \"starts_with\") == 0) op2 = OP_STARTS_WITH;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in 2-str\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in 2-str\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, op2);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"http_request\") == 0) {\n";
    s = s + "        int k;\n";
    s = s + "        free(id.name);\n";
    s = s + "        j++;\n";
    s = s + "        for (k = 0; k < 4; k++) {\n";
    s = s + "          j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (k < 3) {\n";
    s = s + "            if (j >= n || s[j] != ',') die(\"expected , in http_request\");\n";
    s = s + "            j++;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in http_request\");\n";
    s = s + "        j++;\n";
    s = s + "        i64a_push(code, OP_HTTP_REQUEST);\n";
    s = s + "        i = j;\n";
    s = s + "      } else if (strcmp(id.name, \"println\") == 0 || strcmp(id.name, \"print\") == 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"print/println is a statement, not an expression\");\n";
    s = s + "      } else {\n";
    s = s + "        j++;\n";
    s = s + "        int argc = 0;\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j < n && s[j] != ')') {\n";
    s = s + "          for (;;) {\n";
    s = s + "            j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "            argc++;\n";
    s = s + "            j = skip(s, j, n);\n";
    s = s + "            if (j < n && s[j] == ',') {\n";
    s = s + "              j++;\n";
    s = s + "              continue;\n";
    s = s + "            }\n";
    s = s + "            break;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        if (j >= n || s[j] != ')') die(\"expected ) in call\");\n";
    s = s + "        j++;\n";
    s = s + "        int found = 0;\n";
    s = s + "        size_t fni = 0;\n";
    s = s + "        for (size_t fi = 0; fi < fnames->len; fi++) {\n";
    s = s + "          if (strcmp(fnames->data[fi], id.name) == 0) {\n";
    s = s + "            found = 1;\n";
    s = s + "            fni = fi;\n";
    s = s + "            if (fargc->data[fi] != argc) die(\"argc mismatch\");\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "        free(id.name);\n";
    s = s + "        if (!found) die(\"unknown function\");\n";
    s = s + "        /* addr patched in call_patches_apply after all fn bodies exist */\n";
    s = s + "        emit3(code, OP_CALL, 0, argc);\n";
    s = s + "        call_patch_add(code->len - 2, fni);\n";
    s = s + "        i = j;\n";
    s = s + "      }\n";
    s = s + "    } else if (j < n && s[j] == '.' && !(j + 1 < n && s[j + 1] == '.')) {\n";
    s = s + "      /* Color.Red → CONST tag; p.x still LOAD + GET via postfix */\n";
    s = s + "      int tid = find_struct_type(id.name);\n";
    s = s + "      if (tid >= 0) {\n";
    s = s + "        Ident fld;\n";
    s = s + "        int fidx;\n";
    s = s + "        free(id.name);\n";
    s = s + "        fld = parse_ident(s, j + 1, n);\n";
    s = s + "        fidx = field_index_of(&g_stypes[tid], fld.name);\n";
    s = s + "        if (fidx < 0) {\n";
    s = s + "          free(fld.name);\n";
    s = s + "          die(\"unknown enum variant\");\n";
    s = s + "        }\n";
    s = s + "        emit2(code, OP_CONST, fidx);\n";
    s = s + "        free(fld.name);\n";
    s = s + "        i = fld.i;\n";
    s = s + "      } else {\n";
    s = s + "        int sl = slot_of(vnames, id.name);\n";
    s = s + "        free(id.name);\n";
    s = s + "        emit2(code, OP_LOAD, sl);\n";
    s = s + "        i = id.i;\n";
    s = s + "      }\n";
    s = s + "    } else {\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_LOAD, sl);\n";
    s = s + "      i = id.i;\n";
    s = s + "    }\n";
    s = s + "    } /* not true/false */\n";
    s = s + "  } else {\n";
    s = s + "    size_t ii = i;\n";
    s = s + "    ParsedNum num = parse_number(s, &ii, n);\n";
    s = s + "    if (num.is_float) {\n";
    s = s + "      int64_t bits = 0;\n";
    s = s + "      memcpy(&bits, &num.f, sizeof(double));\n";
    s = s + "      emit2(code, OP_CONST_F64, bits);\n";
    s = s + "    } else {\n";
    s = s + "      emit2(code, OP_CONST, num.i);\n";
    s = s + "    }\n";
    s = s + "    i = ii;\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  /* postfix: .field and [index], any chain */\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '.') {\n";
    s = s + "      /* `..` is range, not field */\n";
    s = s + "      if (i + 1 < n && s[i + 1] == '.') break;\n";
    s = s + "      i++;\n";
    s = s + "      Ident fld = parse_ident(s, i, n);\n";
    s = s + "      emit2(code, OP_GET_FIELD, intern_str(fld.name));\n";
    s = s + "      free(fld.name);\n";
    s = s + "      i = fld.i;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (s[i] == '[') {\n";
    s = s + "      i++;\n";
    s = s + "      i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i = skip(s, i, n);\n";
    s = s + "      if (i >= n || s[i] != ']') die(\"expected ]\");\n";
    s = s + "      i++;\n";
    s = s + "      i64a_push(code, OP_GET);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_factor.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_factor.inc.c");
    println("rt_factor ok");
    return 0;
}
