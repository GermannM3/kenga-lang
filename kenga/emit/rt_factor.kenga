    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j >= n || s[j] != ',') die(\"expected , in memory_config\");\n";
    s = s + "        j++;\n";
    s = s + "        j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
