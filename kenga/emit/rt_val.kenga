// Emit Value constructors for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_val.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_val.kenga — do not hand-edit */\n";
    s = s + "static Value V_i64(int64_t x) {\n";
    s = s + "  Value v; v.tag = TAG_I64; v.payload = x; return v;\n";
    s = s + "}\n";
    s = s + "static Value V_str(int64_t h) {\n";
    s = s + "  Value v; v.tag = TAG_STR; v.payload = h; return v;\n";
    s = s + "}\n";
    s = s + "static Value V_list(int64_t h) {\n";
    s = s + "  Value v; v.tag = TAG_LIST; v.payload = h; return v;\n";
    s = s + "}\n";
    s = s + "static Value V_struct(int64_t h) {\n";
    s = s + "  Value v; v.tag = TAG_STRUCT; v.payload = h; return v;\n";
    s = s + "}\n";
    s = s + "static Value V_f64(double x) {\n";
    s = s + "  Value v; v.tag = TAG_F64; memcpy(&v.payload, &x, sizeof(double)); return v;\n";
    s = s + "}\n";
    s = s + "static double f64_bits(Value v) {\n";
    s = s + "  double d; memcpy(&d, &v.payload, sizeof(double)); return d;\n";
    s = s + "}\n";
    s = s + "static int is_num(Value v) { return v.tag == TAG_I64 || v.tag == TAG_F64; }\n";
    s = s + "static double to_f64(Value v, const char *ctx) {\n";
    s = s + "  if (v.tag == TAG_F64) return f64_bits(v);\n";
    s = s + "  if (v.tag == TAG_I64) return (double)v.payload;\n";
    s = s + "  die(ctx);\n";
    s = s + "  return 0.0;\n";
    s = s + "}\n";
    s = s + "static int64_t k_round_d(double x) {\n";
    s = s + "  return (int64_t)(x >= 0.0 ? x + 0.5 : x - 0.5);\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_val.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_val.inc.c");
    println("rt_val ok");
    return 0;
}
