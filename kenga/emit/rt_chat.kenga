// Emit leftover C chat (CLI no longer calls it — kenga/compiler/chat.kenga).
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_chat.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_chat.kenga — do not hand-edit */\n";
    s = s + "/* Interactive Prophet chat for kenga-lite — no Rust.\n";
    s = s + " * Included into kenga_lite.c after prophet_lite.inc.c */\n";
    s = s + "#ifndef KENGA_CHAT_LITE_INC\n";
    s = s + "#define KENGA_CHAT_LITE_INC\n";
    s = s + "\n";
    s = s + "#include <stdarg.h>\n";
    s = s + "\n";
    s = s + "static double g_last_obs[PL_DIM_MAX];\n";
    s = s + "static int g_last_obs_n;\n";
    s = s + "\n";
    s = s + "static int cl_contains(const char *hay, const char *needle) {\n";
    s = s + "  return needle && needle[0] && strstr(hay, needle) != NULL;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int cl_any(const char *hay, ...) {\n";
    s = s + "  va_list ap;\n";
    s = s + "  const char *n;\n";
    s = s + "  int hit = 0;\n";
    s = s + "  va_start(ap, hay);\n";
    s = s + "  while ((n = va_arg(ap, const char *)) != NULL) {\n";
    s = s + "    if (cl_contains(hay, n)) {\n";
    s = s + "      hit = 1;\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  va_end(ap);\n";
    s = s + "  return hit;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void cl_lower(char *s) {\n";
    s = s + "  for (; *s; s++) {\n";
    s = s + "    if ((unsigned char)*s < 128) *s = (char)tolower((unsigned char)*s);\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int cl_extract_nums(const char *s, double *out, int maxn) {\n";
    s = s + "  int n = 0;\n";
    s = s + "  const char *p = s;\n";
    s = s + "  while (*p && n < maxn) {\n";
    s = s + "    while (*p && !((*p >= '0' && *p <= '9') || *p == '-' || *p == '.')) p++;\n";
    s = s + "    if (!*p) break;\n";
    s = s + "    {\n";
    s = s + "      char *end = NULL;\n";
    s = s + "      double v = strtod(p, &end);\n";
    s = s + "      if (end == p) {\n";
    s = s + "        p++;\n";
    s = s + "        continue;\n";
    s = s + "      }\n";
    s = s + "      out[n++] = v;\n";
    s = s + "      p = end;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void cl_fmt_round(const double *xs, int n, char *buf, size_t cap) {\n";
    s = s + "  size_t o = 0;\n";
    s = s + "  int i;\n";
    s = s + "  buf[0] = 0;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    int w = snprintf(buf + o, cap > o ? cap - o : 0, \"%s%lld\", i ? \" \" : \"\",\n";
    s = s + "                     (long long)llround(xs[i]));\n";
    s = s + "    if (w < 0) break;\n";
    s = s + "    o += (size_t)w;\n";
    s = s + "    if (o >= cap) break;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void cl_print_help(void) {\n";
    s = s + "  printf(\"разговор:  привет | ты кто | что умеешь | поговорим | честно\\n\");\n";
    s = s + "  printf(\"модель:    смотри 5 1 6 | что будет через 4 | обучи 10\\n\");\n";
    s = s + "  printf(\"память:    научи 5 1 6 -> 6 1 5 | вспомни … | спи | сохрани\\n\");\n";
    s = s + "  printf(\"выход:     выход / quit\\n\");\n";
    s = s + "  printf(\"(lite, без Rust)\\n\");\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int cl_handle(ProphetMem **mind_slot, const char *path, const char *line) {\n";
    s = s + "  char lower[1024];\n";
    s = s + "  double nums[PL_DIM_MAX];\n";
    s = s + "  int nn;\n";
    s = s + "  ProphetMem *mind = *mind_slot;\n";
    s = s + "  size_t L;\n";
    s = s + "  if (!line) return 1;\n";
    s = s + "  L = strlen(line);\n";
    s = s + "  if (L >= sizeof(lower)) L = sizeof(lower) - 1;\n";
    s = s + "  memcpy(lower, line, L);\n";
    s = s + "  lower[L] = 0;\n";
    s = s + "  cl_lower(lower);\n";
    s = s + "  nn = cl_extract_nums(line, nums, PL_DIM_MAX);\n";
    s = s + "\n";
    s = s + "  if (cl_any(lower, \"quit\", \"exit\", \"выход\", \"пока\", NULL)) {\n";
    s = s + "    printf(\"пока — mind на диске, если сохранил\\n\");\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"привет\", \"hello\", \"hi\", \"здравств\", \"hey\", NULL)) {\n";
    s = s + "    printf(\"привет. я живой world-model Kenga на lite (steps=%llu, dim=%d).\\n\",\n";
    s = s + "           (unsigned long long)mind->model.steps, mind->model.dim);\n";
    s = s + "    if (mind->model.dim >= 9)\n";
    s = s + "      printf(\"этот mind — multimodal: картинка+звук → вектор → предсказание.\\n\");\n";
    s = s + "    else\n";
    s = s + "      printf(\"этот mind — физика агента [pos vel fuel].\\n\");\n";
    s = s + "    printf(\"можешь: «что умеешь», «поговорим», «смотри …», «помощь».\\n\");\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"что умеешь\", \"что ты умеешь\", \"что можешь\", \"возможности\", \"capabilities\", NULL)) {\n";
    s = s + "    printf(\"умею сейчас (lite):\\n\");\n";
    s = s + "    printf(\"  • предсказывать следующий вектор (predict / unroll)\\n\");\n";
    s = s + "    printf(\"  • удивляться и помнить эпизоды; спать (consolidate)\\n\");\n";
    s = s + "    printf(\"  • save/load .km без Rust\\n\");\n";
    s = s + "    if (mind->model.dim >= 9) printf(\"  • multimodal obs dim=%d\\n\", mind->model.dim);\n";
    s = s + "    printf(\"пока не умею: свободный диалог как у большой LLM.\\n\");\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"поговори\", \"поговорим\", \"просто поговорить\", \"хочу поговорить\", \"давай болтать\", NULL)) {\n";
    s = s + "    printf(\"давай. я говорю о том, что помню телом модели.\\n\");\n";
    s = s + "    printf(\"сейчас: steps=%llu dim=%d core=%d.\\n\", (unsigned long long)mind->model.steps,\n";
    s = s + "           mind->model.dim, mind->ncore);\n";
    s = s + "    printf(\"если нужна честность про потолок — «честно».\\n\");\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"ты кто\", \"кто ты\", \"расскажи о себе\", \"о себе\", \"what are you\", \"who are you\", NULL) ||\n";
    s = s + "      strcmp(lower, \"что ты\") == 0 || strncmp(lower, \"что ты такое\", 12) == 0) {\n";
    s = s + "    printf(\"я Prophet-mind: residual MLP, dim=%d, hidden=%d, steps=%llu.\\n\", mind->model.dim,\n";
    s = s + "           mind->model.hidden, (unsigned long long)mind->model.steps);\n";
    s = s + "    printf(\"episodic=%d, core=%d. sense→learn→sleep.\\n\", mind->nep, mind->ncore);\n";
    s = s + "    if (mind->model.dim >= 9) printf(\"обучен на PPM+WAV (living multimodal).\\n\");\n";
    s = s + "    printf(\"я ещё не чат-LLM — но живу в цикле на C-lite.\\n\");\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"честно\", \"ты ии\", \"ты llm\", \"как grok\", \"как gpt\", \"нейросеть\", \"языковая модель\", \"это всё\", NULL)) {\n";
    s = s + "    printf(\"честно: сейчас я world-model (векторы → векторы), не языковая модель.\\n\");\n";
    s = s + "    printf(\"«умная как Grok» = tiny LM → данные → f32/GPU. живой цикл уже есть.\\n\");\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (strcmp(lower, \"?\") == 0 || strcmp(lower, \"help\") == 0 || strcmp(lower, \"помощь\") == 0 ||\n";
    s = s + "      strncmp(lower, \"help \", 5) == 0 || strncmp(lower, \"помощь\", 6) == 0) {\n";
    s = s + "    cl_print_help();\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"status\", \"статус\", \"как дела\", \"stats\", NULL)) {\n";
    s = s + "    printf(\"я помню: ep=%d core=%d steps=%llu dim=%dx%d (lr=%g)\\n\", mind->nep, mind->ncore,\n";
    s = s + "           (unsigned long long)mind->model.steps, mind->model.dim, mind->model.hidden, mind->lr);\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"sleep\", \"спи\", \"консолид\", \"засни\", NULL)) {\n";
    s = s + "    printf(\"сон: в ядро ушло %lld\\n\", (long long)pl_consolidate(mind));\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"save\", \"сохрани\", \"запиши mind\", NULL)) {\n";
    s = s + "    if (!pl_save_mind(mind, path))\n";
    s = s + "      printf(\"не смог сохранить %s\\n\", path);\n";
    s = s + "    else\n";
    s = s + "      printf(\"сохранил %s\\n\", path);\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"load\", \"загрузи\", NULL)) {\n";
    s = s + "    int64_t h = pl_load_mind(path);\n";
    s = s + "    *mind_slot = pl_get(h);\n";
    s = s + "    printf(\"загрузил %s\\n\", path);\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"train\", \"обучи\", \"тренир\", \"учись\", NULL)) {\n";
    s = s + "    int epochs = nn > 0 ? (int)nums[0] : 8;\n";
    s = s + "    int e;\n";
    s = s + "    if (epochs < 1) epochs = 1;\n";
    s = s + "    if (epochs > 64) epochs = 64;\n";
    s = s + "    printf(\"учусь %d эпох…\\n\", epochs);\n";
    s = s + "    for (e = 0; e < epochs; e++) {\n";
    s = s + "      double loss = pl_train_physics_epoch(mind);\n";
    s = s + "      printf(\"  эпоха %d: loss=%.6f\\n\", e, loss);\n";
    s = s + "    }\n";
    s = s + "    printf(\"поспал, сложил эпизодов: %lld\\n\", (long long)pl_consolidate(mind));\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"future\", \"будущ\", \"через\", \"что будет\", \"unroll\", \"предскажи\", \"завтра\", \"скоро\", \"дальше\", NULL)) {\n";
    s = s + "    double obs[PL_DIM_MAX], traj[64 * PL_DIM_MAX];\n";
    s = s + "    int on = 0, steps = 4, os = 0, od = 0, i;\n";
    s = s + "    char buf[256];\n";
    s = s + "    if (cl_contains(lower, \"завтра\") || cl_contains(lower, \"скоро\")) steps = 1;\n";
    s = s + "    if (nn >= 4) {\n";
    s = s + "      steps = (int)nums[nn - 1];\n";
    s = s + "      on = nn - 1;\n";
    s = s + "      for (i = 0; i < on; i++) obs[i] = nums[i];\n";
    s = s + "    } else if (nn == 1 && !cl_contains(lower, \"смотри\")) {\n";
    s = s + "      steps = (int)nums[0];\n";
    s = s + "      on = g_last_obs_n;\n";
    s = s + "      for (i = 0; i < on; i++) obs[i] = g_last_obs[i];\n";
    s = s + "      if (on < 1) {\n";
    s = s + "        printf(\"сначала «смотри 5 1 6», потом «что будет…»\\n\");\n";
    s = s + "        return 1;\n";
    s = s + "      }\n";
    s = s + "    } else if (nn >= 3) {\n";
    s = s + "      on = nn;\n";
    s = s + "      for (i = 0; i < on; i++) obs[i] = nums[i];\n";
    s = s + "    } else {\n";
    s = s + "      on = g_last_obs_n;\n";
    s = s + "      for (i = 0; i < on; i++) obs[i] = g_last_obs[i];\n";
    s = s + "      if (on < 1) {\n";
    s = s + "        printf(\"usage: future n | future a b c n\\n\");\n";
    s = s + "        return 1;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    if (steps < 1) steps = 1;\n";
    s = s + "    pl_unroll(mind, obs, on, steps, traj, &os, &od);\n";
    s = s + "    cl_fmt_round(obs, on, buf, sizeof(buf));\n";
    s = s + "    printf(\"если старт %s, то через %d шагов:\\n\", buf, steps);\n";
    s = s + "    for (i = 0; i < os; i++) {\n";
    s = s + "      cl_fmt_round(traj + i * PL_DIM_MAX, od, buf, sizeof(buf));\n";
    s = s + "      printf(\"  +%d → %s\\n\", i + 1, buf);\n";
    s = s + "    }\n";
    s = s + "    g_last_obs_n = on;\n";
    s = s + "    for (i = 0; i < on; i++) g_last_obs[i] = obs[i];\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"see\", \"смотри\", \"наблюд\", \"сейчас\", \"состояние\", \"sense\", NULL) ||\n";
    s = s + "      (nn > 0 && line[strspn(line, \"0123456789.-+eE \\t\")] == 0)) {\n";
    s = s + "    double pred[PL_DIM_MAX], fore[PL_DIM_MAX];\n";
    s = s + "    int pn = 0, fn = 0, i, on = nn;\n";
    s = s + "    char buf[256];\n";
    s = s + "    double s;\n";
    s = s + "    if (on < 1) {\n";
    s = s + "      cl_print_help();\n";
    s = s + "      return 1;\n";
    s = s + "    }\n";
    s = s + "    pl_predict(mind, nums, on, pred, &pn);\n";
    s = s + "    pl_foresee(mind, nums, on, fore, &fn);\n";
    s = s + "    s = pl_surprise(pred, pn, nums, on);\n";
    s = s + "    cl_fmt_round(nums, on, buf, sizeof(buf));\n";
    s = s + "    printf(\"сейчас     %s\\n\", buf);\n";
    s = s + "    cl_fmt_round(pred, pn, buf, sizeof(buf));\n";
    s = s + "    printf(\"я жду      %s\\n\", buf);\n";
    s = s + "    cl_fmt_round(fore, fn, buf, sizeof(buf));\n";
    s = s + "    printf(\"гибрид     %s\\n\", buf);\n";
    s = s + "    if (s > 0.5)\n";
    s = s + "      printf(\"это для меня странновато (surprise=%.3f)\\n\", s);\n";
    s = s + "    else\n";
    s = s + "      printf(\"похоже на знакомое (surprise=%.3f)\\n\", s);\n";
    s = s + "    g_last_obs_n = on;\n";
    s = s + "    for (i = 0; i < on; i++) g_last_obs[i] = nums[i];\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"teach\", \"научи\", \"запомни\", \"выучи\", NULL) ||\n";
    s = s + "      cl_contains(line, \"->\") || cl_contains(line, \"→\")) {\n";
    s = s + "    int mid, i;\n";
    s = s + "    double loss;\n";
    s = s + "    char a[128], b[128];\n";
    s = s + "    if (nn < 2) {\n";
    s = s + "      printf(\"usage: научи 5 1 6 -> 6 1 5\\n\");\n";
    s = s + "      return 1;\n";
    s = s + "    }\n";
    s = s + "    mid = nn / 2;\n";
    s = s + "    pl_remember_pair(mind, nums, mid, nums + mid, nn - mid, 0.6, 0);\n";
    s = s + "    loss = pl_learn(mind, nums, mid, nums + mid, nn - mid);\n";
    s = s + "    cl_fmt_round(nums, mid, a, sizeof(a));\n";
    s = s + "    cl_fmt_round(nums + mid, nn - mid, b, sizeof(b));\n";
    s = s + "    printf(\"запомнил %s → %s  (loss=%.4f)\\n\", a, b, loss);\n";
    s = s + "    (void)i;\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (cl_any(lower, \"recall\", \"вспомни\", \"похож\", NULL)) {\n";
    s = s + "    /* reuse pl_recall via temporary list heap — print patterns simply */\n";
    s = s + "    double hits_d[16];\n";
    s = s + "    int hi, k = 3, i, j;\n";
    s = s + "    typedef struct {\n";
    s = s + "      double d;\n";
    s = s + "      int dim;\n";
    s = s + "      double p[PL_DIM_MAX];\n";
    s = s + "    } Hit;\n";
    s = s + "    Hit hits[PL_EP_MAX + PL_CORE_MAX];\n";
    s = s + "    int nh = 0;\n";
    s = s + "    char buf[256];\n";
    s = s + "    if (nn < 1) {\n";
    s = s + "      cl_print_help();\n";
    s = s + "      return 1;\n";
    s = s + "    }\n";
    s = s + "    for (i = 0; i < mind->ncore; i++) {\n";
    s = s + "      hits[nh].d = pl_surprise(mind->core[i].pattern, mind->core[i].dim, nums, nn);\n";
    s = s + "      hits[nh].dim = mind->core[i].dim;\n";
    s = s + "      for (j = 0; j < hits[nh].dim; j++) hits[nh].p[j] = mind->core[i].pattern[j];\n";
    s = s + "      nh++;\n";
    s = s + "    }\n";
    s = s + "    for (i = 0; i < mind->nep; i++) {\n";
    s = s + "      hits[nh].d = pl_surprise(mind->ep[i].pattern, mind->ep[i].dim, nums, nn);\n";
    s = s + "      hits[nh].dim = mind->ep[i].dim;\n";
    s = s + "      for (j = 0; j < hits[nh].dim; j++) hits[nh].p[j] = mind->ep[i].pattern[j];\n";
    s = s + "      nh++;\n";
    s = s + "    }\n";
    s = s + "    for (i = 0; i < nh; i++)\n";
    s = s + "      for (j = i + 1; j < nh; j++)\n";
    s = s + "        if (hits[j].d < hits[i].d) {\n";
    s = s + "          Hit t = hits[i];\n";
    s = s + "          hits[i] = hits[j];\n";
    s = s + "          hits[j] = t;\n";
    s = s + "        }\n";
    s = s + "    cl_fmt_round(nums, nn, buf, sizeof(buf));\n";
    s = s + "    printf(\"ближайшие следы к %s:\\n\", buf);\n";
    s = s + "    if (k > nh) k = nh;\n";
    s = s + "    for (hi = 0; hi < k; hi++) {\n";
    s = s + "      cl_fmt_round(hits[hi].p, hits[hi].dim, buf, sizeof(buf));\n";
    s = s + "      printf(\"  [%d] %s\\n\", hi, buf);\n";
    s = s + "    }\n";
    s = s + "    (void)hits_d;\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  printf(\"не распознал как команду: «%s»\\n\", line);\n";
    s = s + "  printf(\"я world-model (dim=%d, steps=%llu), не свободный чат-бот.\\n\", mind->model.dim,\n";
    s = s + "         (unsigned long long)mind->model.steps);\n";
    s = s + "  printf(\"попробуй «что умеешь», «поговорим», «честно» или «помощь».\\n\");\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int run_chat_lite(const char *mind_path, const char *script) {\n";
    s = s + "  const char *path = mind_path && mind_path[0] ? mind_path : \"minds/agent.km\";\n";
    s = s + "  ProphetMem *mind;\n";
    s = s + "  FILE *probe;\n";
    s = s + "  pl_mems_reset();\n";
    s = s + "  g_last_obs_n = 0;\n";
    s = s + "  probe = fopen(path, \"rb\");\n";
    s = s + "  if (probe) {\n";
    s = s + "    fclose(probe);\n";
    s = s + "    printf(\"loading %s\\n\", path);\n";
    s = s + "    mind = pl_get(pl_load_mind(path));\n";
    s = s + "  } else {\n";
    s = s + "    printf(\"new mind → will save to %s\\n\", path);\n";
    s = s + "    mind = pl_get(pl_mem_new(0.05, 128, 48));\n";
    s = s + "  }\n";
    s = s + "  printf(\"Kenga chat — живой world-model (lite, без Rust)\\n\");\n";
    s = s + "  printf(\"разговор: «привет», «ты кто», «что умеешь», «поговорим», «честно»\\n\");\n";
    s = s + "  printf(\"модель: «смотри 5 1 6», «что будет через 4», «обучи», «статус»\\n\\n\");\n";
    s = s + "  if (script) {\n";
    s = s + "    char *buf = (char *)malloc(strlen(script) + 1);\n";
    s = s + "    char *p, *line;\n";
    s = s + "    if (!buf) die(\"oom\");\n";
    s = s + "    memcpy(buf, script, strlen(script) + 1);\n";
    s = s + "    p = buf;\n";
    s = s + "    while (*p) {\n";
    s = s + "      line = p;\n";
    s = s + "      while (*p && *p != '\\n' && *p != '\\r') p++;\n";
    s = s + "      if (*p) {\n";
    s = s + "        *p = 0;\n";
    s = s + "        p++;\n";
    s = s + "        if (*p == '\\n') p++;\n";
    s = s + "      }\n";
    s = s + "      while (*line == ' ' || *line == '\\t') line++;\n";
    s = s + "      if (!*line || line[0] == '#') continue;\n";
    s = s + "      printf(\"> %s\\n\", line);\n";
    s = s + "      if (!cl_handle(&mind, path, line)) break;\n";
    s = s + "    }\n";
    s = s + "    free(buf);\n";
    s = s + "    pl_mems_reset();\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  for (;;) {\n";
    s = s + "    char line[1024];\n";
    s = s + "    printf(\"kenga> \");\n";
    s = s + "    fflush(stdout);\n";
    s = s + "    if (!fgets(line, (int)sizeof(line), stdin)) break;\n";
    s = s + "    {\n";
    s = s + "      size_t n = strlen(line);\n";
    s = s + "      while (n && (line[n - 1] == '\\n' || line[n - 1] == '\\r')) line[--n] = 0;\n";
    s = s + "    }\n";
    s = s + "    if (!line[0]) continue;\n";
    s = s + "    if (!cl_handle(&mind, path, line)) break;\n";
    s = s + "  }\n";
    s = s + "  pl_mems_reset();\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "#endif /* KENGA_CHAT_LITE_INC */\n";
    assert(write_file("bootstrap/generated/rt_chat.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_chat.inc.c");
    println("rt_chat ok");
    return 0;
}
