// Emit reverse-mode tape for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_tape.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_tape.kenga — do not hand-edit */\n";
    s = s + "/* Reverse-mode tape for kenga-lite — node ids are i64, values are Tensor/f64. */\n";
    s = s + "#ifndef KENGA_TAPE_LITE_INC\n";
    s = s + "#define KENGA_TAPE_LITE_INC\n";
    s = s + "\n";
    s = s + "#define AG_MAX_NODES 4096\n";
    s = s + "\n";
    s = s + "enum {\n";
    s = s + "  AG_LEAF = 0,\n";
    s = s + "  AG_ADD,\n";
    s = s + "  AG_SUB,\n";
    s = s + "  AG_MUL,\n";
    s = s + "  AG_MATMUL,\n";
    s = s + "  AG_SCALE,\n";
    s = s + "  AG_RELU,\n";
    s = s + "  AG_NEG,\n";
    s = s + "  AG_TRANSPOSE,\n";
    s = s + "  AG_RESHAPE,\n";
    s = s + "  AG_EXP,\n";
    s = s + "  AG_LOG,\n";
    s = s + "  AG_SOFTMAX,\n";
    s = s + "  AG_MSE,\n";
    s = s + "  AG_SUM\n";
    s = s + "};\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int is_scalar;\n";
    s = s + "  int64_t th;\n";
    s = s + "  double scalar;\n";
    s = s + "  int has_grad;\n";
    s = s + "  int grad_is_scalar;\n";
    s = s + "  int64_t gth;\n";
    s = s + "  double gscalar;\n";
    s = s + "  int op;\n";
    s = s + "  int pa, pb;\n";
    s = s + "  double scale;\n";
    s = s + "  int old_rank;\n";
    s = s + "  int old_shape[TL_RANK_MAX];\n";
    s = s + "  int requires_grad;\n";
    s = s + "} AgNode;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  AgNode nodes[AG_MAX_NODES];\n";
    s = s + "  int n;\n";
    s = s + "} AgTape;\n";
    s = s + "\n";
    s = s + "static AgTape g_ag;\n";
    s = s + "\n";
    s = s + "static void ag_clear(void) { g_ag.n = 0; }\n";
    s = s + "\n";
    s = s + "static AgNode *ag_node(int id) {\n";
    s = s + "  if (id < 0 || id >= g_ag.n) die(\"ag: bad node id\");\n";
    s = s + "  return &g_ag.nodes[id];\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_push(AgNode node) {\n";
    s = s + "  if (g_ag.n >= AG_MAX_NODES) die(\"ag: tape full\");\n";
    s = s + "  g_ag.nodes[g_ag.n] = node;\n";
    s = s + "  return (int64_t)g_ag.n++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_clone_tensor(int64_t th) {\n";
    s = s + "  Tensor *t = tl_get(th);\n";
    s = s + "  return tl_clone_shape_data(t->shape, t->rank, t->data, t->n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double tl_mse(int64_t ha, int64_t hb) {\n";
    s = s + "  Tensor *a = tl_get(ha), *b = tl_get(hb);\n";
    s = s + "  double s = 0.0;\n";
    s = s + "  int i, n;\n";
    s = s + "  if (a->n != b->n) die(\"ag_mse size mismatch\");\n";
    s = s + "  n = a->n > 0 ? a->n : 1;\n";
    s = s + "  for (i = 0; i < a->n; i++) {\n";
    s = s + "    double d = a->data[i] - b->data[i];\n";
    s = s + "    s += d * d;\n";
    s = s + "  }\n";
    s = s + "  return s / (double)n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ag_accum_tensor(AgNode *n, int64_t add_th) {\n";
    s = s + "  Tensor *add = tl_get(add_th);\n";
    s = s + "  int i;\n";
    s = s + "  if (!n->has_grad) {\n";
    s = s + "    n->has_grad = 1;\n";
    s = s + "    n->grad_is_scalar = 0;\n";
    s = s + "    n->gth = ag_clone_tensor(add_th);\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  if (n->grad_is_scalar) die(\"ag: grad type mismatch\");\n";
    s = s + "  {\n";
    s = s + "    Tensor *g = tl_get(n->gth);\n";
    s = s + "    if (g->n != add->n) die(\"ag: grad len mismatch\");\n";
    s = s + "    for (i = 0; i < g->n; i++) g->data[i] += add->data[i];\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ag_accum_scalar(AgNode *n, double add) {\n";
    s = s + "  if (!n->has_grad) {\n";
    s = s + "    n->has_grad = 1;\n";
    s = s + "    n->grad_is_scalar = 1;\n";
    s = s + "    n->gscalar = add;\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  if (!n->grad_is_scalar) die(\"ag: grad type mismatch\");\n";
    s = s + "  n->gscalar += add;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_param(int64_t th) {\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  n.th = ag_clone_tensor(th);\n";
    s = s + "  n.op = AG_LEAF;\n";
    s = s + "  n.requires_grad = 1;\n";
    s = s + "  n.pa = n.pb = -1;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_const_t(int64_t th) {\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  n.th = ag_clone_tensor(th);\n";
    s = s + "  n.op = AG_LEAF;\n";
    s = s + "  n.pa = n.pb = -1;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_const_f(double x) {\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  n.is_scalar = 1;\n";
    s = s + "  n.scalar = x;\n";
    s = s + "  n.op = AG_LEAF;\n";
    s = s + "  n.pa = n.pb = -1;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_ew_add_ids(int64_t a, int64_t b) { return tl_ew(a, b, tl_op_add); }\n";
    s = s + "static int64_t tl_ew_sub_ids(int64_t a, int64_t b) { return tl_ew(a, b, tl_op_sub); }\n";
    s = s + "static int64_t tl_ew_mul_ids(int64_t a, int64_t b) { return tl_ew(a, b, tl_op_mul); }\n";
    s = s + "\n";
    s = s + "static int64_t ag_bin(int a, int b, int op, int64_t (*tf)(int64_t, int64_t)) {\n";
    s = s + "  AgNode *na = ag_node(a), *nb = ag_node(b);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar || nb->is_scalar) die(\"ag bin expects tensors\");\n";
    s = s + "  n.th = tf(na->th, nb->th);\n";
    s = s + "  n.op = op;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = b;\n";
    s = s + "  n.requires_grad = na->requires_grad || nb->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_add_ids(int a, int b) { return ag_bin(a, b, AG_ADD, tl_ew_add_ids); }\n";
    s = s + "static int64_t ag_sub_ids(int a, int b) { return ag_bin(a, b, AG_SUB, tl_ew_sub_ids); }\n";
    s = s + "static int64_t ag_mul_ids(int a, int b) { return ag_bin(a, b, AG_MUL, tl_ew_mul_ids); }\n";
    s = s + "static int64_t ag_matmul_ids(int a, int b) { return ag_bin(a, b, AG_MATMUL, tl_matmul); }\n";
    s = s + "\n";
    s = s + "static int64_t ag_scale_n(int a, double s) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = na->scalar * s;\n";
    s = s + "  } else {\n";
    s = s + "    n.th = tl_scale(na->th, s);\n";
    s = s + "  }\n";
    s = s + "  n.op = AG_SCALE;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.scale = s;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_relu_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = na->scalar > 0.0 ? na->scalar : 0.0;\n";
    s = s + "  } else {\n";
    s = s + "    int64_t h = ag_clone_tensor(na->th);\n";
    s = s + "    Tensor *o = tl_get(h);\n";
    s = s + "    int i;\n";
    s = s + "    for (i = 0; i < o->n; i++)\n";
    s = s + "      if (o->data[i] < 0.0) o->data[i] = 0.0;\n";
    s = s + "    n.th = h;\n";
    s = s + "  }\n";
    s = s + "  n.op = AG_RELU;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_neg_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = -na->scalar;\n";
    s = s + "  } else\n";
    s = s + "    n.th = tl_scale(na->th, -1.0);\n";
    s = s + "  n.op = AG_NEG;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_transpose_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) die(\"ag_transpose expects tensor\");\n";
    s = s + "  n.th = tl_transpose(na->th);\n";
    s = s + "  n.op = AG_TRANSPOSE;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_reshape_n(int a, const int *shape, int rank) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  Tensor *t;\n";
    s = s + "  AgNode n;\n";
    s = s + "  int i, need;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) die(\"ag_reshape expects tensor\");\n";
    s = s + "  t = tl_get(na->th);\n";
    s = s + "  n.old_rank = t->rank;\n";
    s = s + "  for (i = 0; i < t->rank; i++) n.old_shape[i] = t->shape[i];\n";
    s = s + "  need = tl_product(shape, rank);\n";
    s = s + "  if (need != t->n) die(\"ag_reshape size mismatch\");\n";
    s = s + "  n.th = tl_clone_shape_data(shape, rank, t->data, t->n);\n";
    s = s + "  n.op = AG_RESHAPE;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_exp_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = exp(na->scalar);\n";
    s = s + "  } else\n";
    s = s + "    n.th = tl_exp(na->th);\n";
    s = s + "  n.op = AG_EXP;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_log_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    double x = na->scalar < 1e-12 ? 1e-12 : na->scalar;\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = log(x);\n";
    s = s + "  } else\n";
    s = s + "    n.th = tl_log(na->th);\n";
    s = s + "  n.op = AG_LOG;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_softmax_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) {\n";
    s = s + "    n.is_scalar = 1;\n";
    s = s + "    n.scalar = 1.0;\n";
    s = s + "  } else\n";
    s = s + "    n.th = tl_softmax(na->th);\n";
    s = s + "  n.op = AG_SOFTMAX;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_mse_n(int p, int t) {\n";
    s = s + "  AgNode *np = ag_node(p), *nt = ag_node(t);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (np->is_scalar || nt->is_scalar) die(\"ag_mse expects tensors\");\n";
    s = s + "  n.is_scalar = 1;\n";
    s = s + "  n.scalar = tl_mse(np->th, nt->th);\n";
    s = s + "  n.op = AG_MSE;\n";
    s = s + "  n.pa = p;\n";
    s = s + "  n.pb = t;\n";
    s = s + "  n.requires_grad = np->requires_grad || nt->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_sum_n(int a) {\n";
    s = s + "  AgNode *na = ag_node(a);\n";
    s = s + "  AgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  n.is_scalar = 1;\n";
    s = s + "  n.scalar = na->is_scalar ? na->scalar : tl_sum(na->th);\n";
    s = s + "  n.op = AG_SUM;\n";
    s = s + "  n.pa = a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return ag_push(n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ag_backward(int loss_id) {\n";
    s = s + "  int i;\n";
    s = s + "  if (loss_id < 0 || loss_id >= g_ag.n) die(\"ag_backward: bad loss id\");\n";
    s = s + "  for (i = 0; i < g_ag.n; i++) g_ag.nodes[i].has_grad = 0;\n";
    s = s + "  {\n";
    s = s + "    AgNode *loss = &g_ag.nodes[loss_id];\n";
    s = s + "    if (loss->is_scalar) {\n";
    s = s + "      loss->has_grad = 1;\n";
    s = s + "      loss->grad_is_scalar = 1;\n";
    s = s + "      loss->gscalar = 1.0;\n";
    s = s + "    } else {\n";
    s = s + "      Tensor *t = tl_get(loss->th);\n";
    s = s + "      int64_t h = tl_alloc(t->shape, t->rank, 0);\n";
    s = s + "      Tensor *o = tl_get(h);\n";
    s = s + "      int j;\n";
    s = s + "      for (j = 0; j < o->n; j++) o->data[j] = 1.0;\n";
    s = s + "      loss->has_grad = 1;\n";
    s = s + "      loss->grad_is_scalar = 0;\n";
    s = s + "      loss->gth = h;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  for (i = loss_id; i >= 0; i--) {\n";
    s = s + "    AgNode *node = &g_ag.nodes[i];\n";
    s = s + "    if (!node->has_grad) continue;\n";
    s = s + "    switch (node->op) {\n";
    s = s + "    case AG_LEAF:\n";
    s = s + "      break;\n";
    s = s + "    case AG_ADD:\n";
    s = s + "      if (node->grad_is_scalar) die(\"ag add grad\");\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pa], node->gth);\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pb], node->gth);\n";
    s = s + "      break;\n";
    s = s + "    case AG_SUB: {\n";
    s = s + "      int64_t neg;\n";
    s = s + "      if (node->grad_is_scalar) die(\"ag sub grad\");\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pa], node->gth);\n";
    s = s + "      neg = tl_scale(node->gth, -1.0);\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pb], neg);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_MUL: {\n";
    s = s + "      AgNode *a = &g_ag.nodes[node->pa], *b = &g_ag.nodes[node->pb];\n";
    s = s + "      int64_t ga = tl_ew(node->gth, b->th, tl_op_mul);\n";
    s = s + "      int64_t gb = tl_ew(node->gth, a->th, tl_op_mul);\n";
    s = s + "      ag_accum_tensor(a, ga);\n";
    s = s + "      ag_accum_tensor(b, gb);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_MATMUL: {\n";
    s = s + "      AgNode *a = &g_ag.nodes[node->pa], *b = &g_ag.nodes[node->pb];\n";
    s = s + "      int64_t bt = tl_transpose(b->th);\n";
    s = s + "      int64_t at = tl_transpose(a->th);\n";
    s = s + "      int64_t ga = tl_matmul(node->gth, bt);\n";
    s = s + "      int64_t gb = tl_matmul(at, node->gth);\n";
    s = s + "      ag_accum_tensor(a, ga);\n";
    s = s + "      ag_accum_tensor(b, gb);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_SCALE:\n";
    s = s + "      if (node->grad_is_scalar)\n";
    s = s + "        ag_accum_scalar(&g_ag.nodes[node->pa], node->gscalar * node->scale);\n";
    s = s + "      else\n";
    s = s + "        ag_accum_tensor(&g_ag.nodes[node->pa], tl_scale(node->gth, node->scale));\n";
    s = s + "      break;\n";
    s = s + "    case AG_RELU: {\n";
    s = s + "      AgNode *a = &g_ag.nodes[node->pa];\n";
    s = s + "      if (node->grad_is_scalar) {\n";
    s = s + "        double v = a->is_scalar ? a->scalar : 0.0;\n";
    s = s + "        ag_accum_scalar(a, v > 0.0 ? node->gscalar : 0.0);\n";
    s = s + "      } else {\n";
    s = s + "        Tensor *av = tl_get(a->th);\n";
    s = s + "        int64_t h = ag_clone_tensor(node->gth);\n";
    s = s + "        Tensor *o = tl_get(h);\n";
    s = s + "        int j;\n";
    s = s + "        for (j = 0; j < o->n; j++)\n";
    s = s + "          if (av->data[j] <= 0.0) o->data[j] = 0.0;\n";
    s = s + "        ag_accum_tensor(a, h);\n";
    s = s + "      }\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_NEG:\n";
    s = s + "      if (node->grad_is_scalar)\n";
    s = s + "        ag_accum_scalar(&g_ag.nodes[node->pa], -node->gscalar);\n";
    s = s + "      else\n";
    s = s + "        ag_accum_tensor(&g_ag.nodes[node->pa], tl_scale(node->gth, -1.0));\n";
    s = s + "      break;\n";
    s = s + "    case AG_TRANSPOSE:\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pa], tl_transpose(node->gth));\n";
    s = s + "      break;\n";
    s = s + "    case AG_RESHAPE: {\n";
    s = s + "      Tensor *g = tl_get(node->gth);\n";
    s = s + "      int64_t h = tl_clone_shape_data(node->old_shape, node->old_rank, g->data, g->n);\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pa], h);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_EXP:\n";
    s = s + "      if (node->is_scalar)\n";
    s = s + "        ag_accum_scalar(&g_ag.nodes[node->pa], node->gscalar * node->scalar);\n";
    s = s + "      else\n";
    s = s + "        ag_accum_tensor(&g_ag.nodes[node->pa], tl_ew(node->gth, node->th, tl_op_mul));\n";
    s = s + "      break;\n";
    s = s + "    case AG_LOG: {\n";
    s = s + "      /* g / x */\n";
    s = s + "      AgNode *a = &g_ag.nodes[node->pa];\n";
    s = s + "      if (node->grad_is_scalar) {\n";
    s = s + "        double x = a->is_scalar ? a->scalar : 1.0;\n";
    s = s + "        if (x < 1e-12) x = 1e-12;\n";
    s = s + "        ag_accum_scalar(a, node->gscalar / x);\n";
    s = s + "      } else {\n";
    s = s + "        Tensor *xv = tl_get(a->th);\n";
    s = s + "        Tensor *gg = tl_get(node->gth);\n";
    s = s + "        int64_t h = ag_clone_tensor(node->gth);\n";
    s = s + "        Tensor *o = tl_get(h);\n";
    s = s + "        int j;\n";
    s = s + "        for (j = 0; j < o->n; j++) {\n";
    s = s + "          double x = xv->data[j] < 1e-12 ? 1e-12 : xv->data[j];\n";
    s = s + "          o->data[j] = gg->data[j] / x;\n";
    s = s + "        }\n";
    s = s + "        ag_accum_tensor(a, h);\n";
    s = s + "      }\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_SOFTMAX: {\n";
    s = s + "      Tensor *y = tl_get(node->th);\n";
    s = s + "      Tensor *gy = tl_get(node->gth);\n";
    s = s + "      double dot = 0.0;\n";
    s = s + "      int j;\n";
    s = s + "      int64_t h;\n";
    s = s + "      Tensor *o;\n";
    s = s + "      if (y->n != gy->n) die(\"ag softmax grad len\");\n";
    s = s + "      for (j = 0; j < y->n; j++) dot += gy->data[j] * y->data[j];\n";
    s = s + "      h = ag_clone_tensor(node->th);\n";
    s = s + "      o = tl_get(h);\n";
    s = s + "      for (j = 0; j < o->n; j++) o->data[j] = y->data[j] * (gy->data[j] - dot);\n";
    s = s + "      ag_accum_tensor(&g_ag.nodes[node->pa], h);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_MSE: {\n";
    s = s + "      AgNode *p = &g_ag.nodes[node->pa], *t = &g_ag.nodes[node->pb];\n";
    s = s + "      double g = node->grad_is_scalar ? node->gscalar : 1.0;\n";
    s = s + "      int64_t err = tl_ew(p->th, t->th, tl_op_sub);\n";
    s = s + "      Tensor *e = tl_get(err);\n";
    s = s + "      double scale = 2.0 * g / (e->n > 0 ? (double)e->n : 1.0);\n";
    s = s + "      int64_t gp = tl_scale(err, scale);\n";
    s = s + "      int64_t gt = tl_scale(err, -scale);\n";
    s = s + "      ag_accum_tensor(p, gp);\n";
    s = s + "      ag_accum_tensor(t, gt);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case AG_SUM: {\n";
    s = s + "      AgNode *a = &g_ag.nodes[node->pa];\n";
    s = s + "      double g = node->grad_is_scalar ? node->gscalar : 1.0;\n";
    s = s + "      if (a->is_scalar)\n";
    s = s + "        ag_accum_scalar(a, g);\n";
    s = s + "      else {\n";
    s = s + "        Tensor *t = tl_get(a->th);\n";
    s = s + "        int64_t h = tl_alloc(t->shape, t->rank, 0);\n";
    s = s + "        Tensor *o = tl_get(h);\n";
    s = s + "        int j;\n";
    s = s + "        for (j = 0; j < o->n; j++) o->data[j] = g;\n";
    s = s + "        ag_accum_tensor(a, h);\n";
    s = s + "      }\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    default:\n";
    s = s + "      die(\"ag_backward: unknown op\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ag_step_n(int param_id, double lr) {\n";
    s = s + "  AgNode *n = ag_node(param_id);\n";
    s = s + "  int64_t step, out;\n";
    s = s + "  if (!n->has_grad) die(\"ag_step: missing grad\");\n";
    s = s + "  if (n->is_scalar || n->grad_is_scalar) die(\"ag_step expects tensor param\");\n";
    s = s + "  step = tl_scale(n->gth, lr);\n";
    s = s + "  out = tl_ew(n->th, step, tl_op_sub);\n";
    s = s + "  return out;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value ag_value_v(int id) {\n";
    s = s + "  AgNode *n = ag_node(id);\n";
    s = s + "  if (n->is_scalar) return V_f64(n->scalar);\n";
    s = s + "  return V_tensor(ag_clone_tensor(n->th));\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value ag_grad_v(int id) {\n";
    s = s + "  AgNode *n = ag_node(id);\n";
    s = s + "  if (!n->has_grad) die(\"ag_grad: no grad\");\n";
    s = s + "  if (n->grad_is_scalar) return V_f64(n->gscalar);\n";
    s = s + "  return V_tensor(ag_clone_tensor(n->gth));\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "#endif /* KENGA_TAPE_LITE_INC */\n";
    assert(write_file("bootstrap/generated/rt_tape.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_tape.inc.c");
    println("rt_tape ok");
    return 0;
}
