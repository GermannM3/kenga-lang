// General lowerer: i64 subset of Kenga → C99 text (no Rust).
// Stmt: let / assign / while / if-else / for-range / return / println / assert
// Expr: int, ident, (+ - * /), cmp, ().
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\lower_c.kenga

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i); let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch; i = i + 1;
    }
    return [name, i];
}
fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let out: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        out = digs[d] + out;
        x = x / 10;
    }
    if n < 0 { return "-" + out; }
    return out;
}
fn indent(n: i64) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < n { s = s + "  "; i = i + 1; }
    return s;
}

fn lower_factor(s: str, i: i64) -> list {
    i = skip(s, i);
    if s[i] == "(" {
        let r = lower_cmp(s, i + 1);
        i = skip(s, r[1]); assert(s[i] == ")");
        return ["(" + r[0] + ")", i + 1];
    }
    if s[i] == "-" {
        let r = lower_factor(s, i + 1);
        return ["(0 - " + r[0] + ")", r[1]];
    }
    if is_digit(s[i]) == 1 {
        let v: i64 = 0;
        while i < len(s) {
            if is_digit(s[i]) == 0 { break; }
            v = v * 10 + (ord(s[i]) - 48); i = i + 1;
        }
        return [itoa(v) + "LL", i];
    }
    assert(is_alpha(s[i]) == 1);
    let id = parse_ident(s, i);
    return [id[0], id[1]];
}

fn lower_term(s: str, i: i64) -> list {
    let r = lower_factor(s, i);
    let out: str = r[0]; i = r[1];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "*" {
            r = lower_factor(s, i + 1);
            out = "(" + out + " * " + r[0] + ")"; i = r[1];
        } else {
            if s[i] == "/" {
                r = lower_factor(s, i + 1);
                out = "(" + out + " / " + r[0] + ")"; i = r[1];
            } else { break; }
        }
    }
    return [out, i];
}

fn lower_sum(s: str, i: i64) -> list {
    let r = lower_term(s, i);
    let out: str = r[0]; i = r[1];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "+" {
            r = lower_term(s, i + 1);
            out = "(" + out + " + " + r[0] + ")"; i = r[1];
        } else {
            if s[i] == "-" {
                r = lower_term(s, i + 1);
                out = "(" + out + " - " + r[0] + ")"; i = r[1];
            } else { break; }
        }
    }
    return [out, i];
}

fn lower_cmp(s: str, i: i64) -> list {
    let r = lower_sum(s, i);
    let out: str = r[0]; i = r[1]; i = skip(s, i);
    if i >= len(s) { return [out, i]; }
    if starts_with(s, i, "<=") == 1 {
        r = lower_sum(s, i + 2); return ["(" + out + " <= " + r[0] + ")", r[1]];
    }
    if starts_with(s, i, ">=") == 1 {
        r = lower_sum(s, i + 2); return ["(" + out + " >= " + r[0] + ")", r[1]];
    }
    if starts_with(s, i, "==") == 1 {
        r = lower_sum(s, i + 2); return ["(" + out + " == " + r[0] + ")", r[1]];
    }
    if starts_with(s, i, "!=") == 1 {
        r = lower_sum(s, i + 2); return ["(" + out + " != " + r[0] + ")", r[1]];
    }
    if s[i] == "<" {
        r = lower_sum(s, i + 1); return ["(" + out + " < " + r[0] + ")", r[1]];
    }
    if s[i] == ">" {
        r = lower_sum(s, i + 1); return ["(" + out + " > " + r[0] + ")", r[1]];
    }
    return [out, i];
}

fn lower_block(s: str, i: i64, ind: i64, decls: list) -> list {
    // returns [c_text, new_i, decls]
    i = skip(s, i); assert(s[i] == "{"); i = i + 1;
    let out: str = "";
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = lower_stmt(s, i, ind, decls);
        out = out + st[0]; i = st[1]; decls = st[2];
    }
    assert(s[i] == "}");
    return [out, i + 1, decls];
}

fn ensure_decl(decls: list, name: str) -> list {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i] == name { return decls; }
        i = i + 1;
    }
    return push(decls, name);
}

fn lower_stmt(s: str, i: i64, ind: i64, decls: list) -> list {
    i = skip(s, i);
    let pad: str = indent(ind);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        assert(s[i] == "="); i = i + 1;
        let r = lower_cmp(s, i);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        decls = ensure_decl(decls, id[0]);
        return [pad + id[0] + " = " + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "return") == 1 {
        let r = lower_cmp(s, i + 6);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "return (int)" + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "printf(\"%lld\\n\", (long long)(" + r[0] + "));\n", i, decls];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "if (!(" + r[0] + ")) return 1;\n", i, decls];
    }
    if starts_kw(s, i, "while") == 1 {
        let r = lower_cmp(s, i + 5);
        let bl = lower_block(s, r[1], ind + 1, decls);
        let body: str = bl[0]; decls = bl[2];
        let out: str = pad + "while (" + r[0] + ") {\n" + body + pad + "}\n";
        return [out, bl[1], decls];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let var = parse_ident(s, i);
        i = skip(s, var[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let lo = lower_cmp(s, i);
        i = skip(s, lo[1]);
        assert(starts_with(s, i, "..") == 1);
        i = i + 2;
        let hi = lower_cmp(s, i);
        decls = ensure_decl(decls, var[0]);
        let bl = lower_block(s, hi[1], ind + 1, decls);
        decls = bl[2];
        let out: str = pad + "for (" + var[0] + " = " + lo[0] + "; " + var[0] + " < " + hi[0] + "; " + var[0] + " = " + var[0] + " + 1) {\n";
        out = out + bl[0] + pad + "}\n";
        return [out, bl[1], decls];
    }
    if starts_kw(s, i, "break") == 1 {
        i = skip(s, i + 5); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "break;\n", i, decls];
    }
    if starts_kw(s, i, "continue") == 1 {
        i = skip(s, i + 8); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "continue;\n", i, decls];
    }
    if starts_kw(s, i, "if") == 1 {
        let r = lower_cmp(s, i + 2);
        let th = lower_block(s, r[1], ind + 1, decls);
        decls = th[2];
        let out: str = pad + "if (" + r[0] + ") {\n" + th[0] + pad + "}";
        let j: i64 = skip(s, th[1]);
        if starts_kw(s, j, "else") == 1 {
            j = skip(s, j + 4);
            if starts_kw(s, j, "if") == 1 {
                let el = lower_stmt(s, j, ind, decls);
                // strip leading indent from nested if line — keep as else if
                out = out + " else {\n" + el[0] + pad + "}\n";
                return [out, el[1], el[2]];
            }
            let el = lower_block(s, j, ind + 1, decls);
            out = out + " else {\n" + el[0] + pad + "}\n";
            return [out, el[1], el[2]];
        }
        out = out + "\n";
        return [out, th[1], decls];
    }
    // assign or expr
    if is_alpha(s[i]) == 1 {
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "=" {
                if starts_with(s, j, "==") == 0 {
                    let r = lower_cmp(s, j + 1);
                    j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                    decls = ensure_decl(decls, id[0]);
                    return [pad + id[0] + " = " + r[0] + ";\n", j, decls];
                }
            }
        }
    }
    let r = lower_cmp(s, i);
    i = skip(s, r[1]); if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [pad + "(void)(" + r[0] + ");\n", i, decls];
}

fn lower_main(src: str) -> str {
    let i: i64 = skip(src, 0);
    assert(starts_kw(src, i, "fn") == 1);
    i = skip(src, i + 2);
    let id = parse_ident(src, i);
    assert(id[0] == "main");
    i = skip(src, id[1]);
    assert(src[i] == "("); i = skip(src, i + 1); assert(src[i] == ")");
    i = skip(src, i + 1);
    if starts_with(src, i, "->") == 1 {
        i = skip(src, i + 2);
        let ty = parse_ident(src, i);
        i = ty[1];
    }
    let decls: list = [];
    let bl = lower_block(src, i, 1, decls);
    let body: str = bl[0]; decls = bl[2];
    let out: str = "";
    out = out + "/* generated by kenga/emit/lower_c.kenga — no Rust */\n";
    out = out + "#include <stdio.h>\n#include <stdint.h>\n\n";
    out = out + "int main(void) {\n";
    let di: i64 = 0;
    while di < len(decls) {
        out = out + "  int64_t " + decls[di] + " = 0;\n";
        di = di + 1;
    }
    out = out + body;
    out = out + "  return 0;\n}\n";
    return out;
}

fn main() -> i64 {
    let fact: str = "fn main() -> i64 { let n = 1; let i = 1; while i <= 6 { n = n * i; i = i + 1; } println(n); assert(n == 720); return 0; }";
    let c1 = lower_main(fact);
    assert(write_file("bootstrap/bin/lower_fact.c", c1) == true);

    let brk: str = "fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } println(acc); assert(acc == 3); return 0; }";
    let c2 = lower_main(brk);
    assert(write_file("bootstrap/bin/lower_for.c", c2) == true);

    let iff: str = "fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } println(label); assert(label == 30); return 0; }";
    let c3 = lower_main(iff);
    assert(write_file("bootstrap/bin/lower_if.c", c3) == true);

    assert(len(read_file("bootstrap/bin/lower_fact.c")) > 80);
    println("wrote bootstrap/bin/lower_{fact,for,if}.c");
    println("lower_c ok");
    return 0;
}
