// General lowerer: Kenga i64/str/list subset → C99 (no Rust).
// + multi-fn, string literals, list [ ] / push / len / index,
//   events (on/emit/pump), import flatten, for-in-list, true/false,
//   && || % ! and block comments, typeof / to_str, print / sleep_ms / now_ms,
//   u8/u16/u32/u64 width types (declare in struct fields; pass-by-value),
//   intrinsics passthrough for bare-metal: mmio_readN, mmio_writeN, asm_hlt/cli/sti,
//   atomic_{load,store,cas,fence}, asm(code). Stubbed call to C runtime — the kernel
//   provides kf_alloc (weak) and friends in kf_rt.h.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\lower_c.kenga --freestanding -o out.c in.kenga

let g_freestanding: i64 = 0;

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
                if s[i + 1] == "*" {
                    i = i + 2;
                    let closed: i64 = 0;
                    while i + 1 < len(s) {
                        if s[i] == "*" {
                            if s[i + 1] == "/" {
                                i = i + 2;
                                closed = 1;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                    assert(closed == 1);
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i); let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch; i = i + 1;
    }
    return [name, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\"" { return [out, i + 1]; }
        if s[i] == "\\" {
            if i + 1 < len(s) {
                out = out + s[i + 1];
                i = i + 2;
                continue;
            }
        }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn c_escape(s: str) -> str {
    let out: str = "";
    let i: i64 = 0;
    while i < len(s) {
        if s[i] == "\\" {
            out = out + "\\\\";
        } else {
            if s[i] == "\"" {
                out = out + "\\\"";
            } else {
                out = out + s[i];
            }
        }
        i = i + 1;
    }
    return out;
}
fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let out: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        out = digs[d] + out;
        x = x / 10;
    }
    if n < 0 { return "-" + out; }
    return out;
}
fn indent(n: i64) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < n { s = s + "  "; i = i + 1; }
    return s;
}
fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "\"" {
            i = i + 1;
            while i < n {
                if src[i] == "\\" { i = i + 2; continue; }
                if src[i] == "\"" { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(0 == 1);
    return i;
}
fn skip_type_annot(s: str, i: i64) -> i64 {
    let r = parse_type_kind(s, i);
    return r[1];
}
fn parse_type_kind(s: str, i: i64) -> list {
    // returns [kind, new_i] kind 0=i64 1=list 2=str 3=f64 4=u8 5=u16 6=u32 7=u64 8=u8* 9=i8 10=i16 11=i32
    i = skip(s, i);
    if i >= len(s) { return [0, i]; }
    if s[i] != ":" { return [0, i]; }
    i = skip(s, i + 1);
    let ty = parse_ident(s, i);
    let k: i64 = 0;
    if ty[0] == "list" { k = 1; }
    if ty[0] == "str" { k = 2; }
    if ty[0] == "f64" { k = 3; }
    if ty[0] == "u8" { k = 4; }
    if ty[0] == "u16" { k = 5; }
    if ty[0] == "u32" { k = 6; }
    if ty[0] == "u64" { k = 7; }
    if ty[0] == "i8" { k = 9; }
    if ty[0] == "i16" { k = 10; }
    if ty[0] == "i32" { k = 11; }
    return [k, skip(s, ty[1])];
}
fn ctype(k: i64) -> str {
    if k == 1 { return "KList"; }
    if k == 2 { return "const char*"; }
    if k == 3 { return "double"; }
    if k == 4 { return "uint8_t"; }
    if k == 5 { return "uint16_t"; }
    if k == 6 { return "uint32_t"; }
    if k == 7 { return "uint64_t"; }
    if k == 9 { return "int8_t"; }
    if k == 10 { return "int16_t"; }
    if k == 11 { return "int32_t"; }
    return "int64_t";
}

// Build a C function call: prefix( e1, e2, ..., en )
// where prefix == "" means no namespace (e.g. for cast'd expressions).
// Returns just "prefix(e1, e2, ..., en)" without trailing semicolon.
fn lower_call_args(s: str, j: i64, decls: list, prefix: str, n: i64) -> str {
    assert(s[j] == "(");
    j = j + 1;
    let parts: str = "";
    let k: i64 = 0;
    while k < n {
        j = skip(s, j);
        let ax = lower_cmp(s, j, decls);
        if k > 0 { parts = parts + ", "; }
        parts = parts + ax[0];
        k = k + 1;
        j = skip(s, ax[1]);
        if k < n {
            assert(s[j] == ",");
            j = j + 1;
        }
    }
    assert(s[j] == ")");
    if len(prefix) > 0 {
        return prefix + "(" + parts + ")";
    }
    return parts;
}

fn find_struct(stypes: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(stypes) {
        if stypes[i][0] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn field_index(fields: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fields) {
        if fields[i] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn field_index_any(stypes: list, name: str) -> i64 {
    let si: i64 = 0;
    while si < len(stypes) {
        let fi: i64 = field_index(stypes[si][1], name);
        if fi >= 0 { return fi; }
        si = si + 1;
    }
    return 0 - 1;
}
fn stypes_of(decls: list) -> list {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i][0] == "__stypes__" { return decls[i][1]; }
        i = i + 1;
    }
    return [];
}

// decls: list of [name, kind] kind 0=i64 1=list 2=str 3=f64  (+ ["__stypes__", stypes])
fn decl_kind(decls: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i][0] == name { return decls[i][1]; }
        i = i + 1;
    }
    return 0;
}
fn ensure_decl(decls: list, name: str, kind: i64) -> list {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i][0] == name {
            decls[i] = [name, kind];
            return decls;
        }
        i = i + 1;
    }
    return push(decls, [name, kind]);
}

fn runtime_c() -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/lower_c.kenga — no Rust */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n";
    s = s + "#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#include <sys/time.h>\n#endif\n\n";
    s = s + "typedef struct { int64_t *d; size_t n, cap; } KList;\n";
    s = s + "static KList klist_new(void) { KList L; L.d=NULL; L.n=0; L.cap=0; return L; }\n";
    s = s + "static void klist_push(KList *L, int64_t v) {\n";
    s = s + "  if (L->n+1>L->cap) { size_t nc=L->cap?L->cap*2:4; L->d=(int64_t*)realloc(L->d,nc*sizeof(int64_t)); L->cap=nc; }\n";
    s = s + "  L->d[L->n++]=v;\n}\n";
    s = s + "static int64_t klist_get(KList *L, int64_t i) { return L->d[(size_t)i]; }\n";
    s = s + "static void klist_set(KList *L, int64_t i, int64_t v) { L->d[(size_t)i]=v; }\n";
    s = s + "static int64_t klist_len(KList *L) { return (int64_t)L->n; }\n";
    s = s + "static KList klist_push_ret(KList L, int64_t v) { klist_push(&L, v); return L; }\n";
    s = s + "static KList klist_of(const int64_t *a, size_t n) {\n";
    s = s + "  KList L = klist_new(); size_t i; for (i=0;i<n;i++) klist_push(&L, a[i]); return L;\n}\n";
    s = s + "static void klist_println(KList *L) {\n";
    s = s + "  size_t i; printf(\"[\"); for (i=0;i<L->n;i++) { if (i) printf(\", \"); printf(\"%lld\", (long long)L->d[i]); }\n";
    s = s + "  printf(\"]\\n\");\n}\n";
    s = s + "static void klist_print(KList *L) {\n";
    s = s + "  size_t i; printf(\"[\"); for (i=0;i<L->n;i++) { if (i) printf(\", \"); printf(\"%lld\", (long long)L->d[i]); }\n";
    s = s + "  printf(\"]\"); fflush(stdout);\n}\n";
    s = s + "static int64_t k_sleep_ms(int64_t n) {\n";
    s = s + "  if (n < 0) abort();\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "  Sleep((DWORD)(n));\n";
    s = s + "#else\n";
    s = s + "  {\n";
    s = s + "    unsigned long left = (unsigned long)n;\n";
    s = s + "    while (left > 0) {\n";
    s = s + "      unsigned long chunk = left > 999UL ? 999UL : left;\n";
    s = s + "      usleep((unsigned int)(chunk * 1000UL));\n";
    s = s + "      left = left - chunk;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "#endif\n";
    s = s + "  return 0;\n}\n";
    s = s + "static int64_t k_now_ms(void) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "  return (int64_t)GetTickCount64();\n";
    s = s + "#else\n";
    s = s + "  struct timeval tv;\n";
    s = s + "  gettimeofday(&tv, NULL);\n";
    s = s + "  return (int64_t)tv.tv_sec * 1000 + (int64_t)tv.tv_usec / 1000;\n";
    s = s + "#endif\n";
    s = s + "}\n\n";
    s = s + "static const char *k_to_str_i64(int64_t v) { static char b[32]; snprintf(b, sizeof(b), \"%lld\", (long long)v); return b; }\n";
    s = s + "static const char *k_to_str_f64(double v) { static char b[64]; snprintf(b, sizeof(b), \"%g\", v); return b; }\n";
    s = s + "static const char *kstr_concat(const char *a, const char *b) {\n";
    s = s + "  size_t na, nb; char *o;\n";
    s = s + "  if (!a) a = \"\"; if (!b) b = \"\";\n";
    s = s + "  na = strlen(a); nb = strlen(b);\n";
    s = s + "  o = (char *)malloc(na + nb + 1); if (!o) abort();\n";
    s = s + "  memcpy(o, a, na); memcpy(o + na, b, nb); o[na + nb] = 0; return o;\n}\n\n";
    s = s + "typedef void (*KeHandler)(int64_t);\n";
    s = s + "typedef struct { const char *name; KeHandler fn; int arity; } KeBind;\n";
    s = s + "static KeBind g_binds[64]; static int g_nbinds = 0;\n";
    s = s + "#define KE_QMAX 256\n";
    s = s + "static const char *g_qev[KE_QMAX]; static int64_t g_qval[KE_QMAX]; static int g_qn = 0;\n";
    s = s + "static void ke_listen(const char *name, KeHandler fn, int arity) {\n";
    s = s + "  g_binds[g_nbinds].name = name; g_binds[g_nbinds].fn = fn; g_binds[g_nbinds].arity = arity; g_nbinds++;\n}\n";
    s = s + "static int64_t ke_emit(const char *e, int64_t v) {\n";
    s = s + "  if (g_qn >= KE_QMAX) abort();\n";
    s = s + "  g_qev[g_qn] = e; g_qval[g_qn] = v; g_qn++; return 0;\n}\n";
    s = s + "static int64_t ke_pending(void) { return (int64_t)g_qn; }\n";
    s = s + "static int64_t ke_pump(int64_t maxn) {\n";
    s = s + "  int64_t done = 0;\n";
    s = s + "  while (maxn > 0 && g_qn > 0) {\n";
    s = s + "    const char *e = g_qev[0]; int64_t v = g_qval[0]; int i;\n";
    s = s + "    for (i = 1; i < g_qn; i++) { g_qev[i-1]=g_qev[i]; g_qval[i-1]=g_qval[i]; }\n";
    s = s + "    g_qn--; maxn--;\n";
    s = s + "    for (i = 0; i < g_nbinds; i++) {\n";
    s = s + "      if (strcmp(g_binds[i].name, e) == 0) {\n";
    s = s + "        if (g_binds[i].arity == 1) g_binds[i].fn(v); else g_binds[i].fn(0);\n";
    s = s + "        done++; break;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return done;\n}\n\n";
    return s;
}

fn lower_factor(s: str, i: i64, decls: list) -> list {
    // returns [c_expr, new_i, kind]
    i = skip(s, i);
    if s[i] == "(" {
        let r = lower_cmp(s, i + 1, decls);
        i = skip(s, r[1]); assert(s[i] == ")");
        return ["(" + r[0] + ")", i + 1, r[2]];
    }
    if s[i] == "-" {
        let r = lower_factor(s, i + 1, decls);
        return ["(0 - " + r[0] + ")", r[1], 0];
    }
    if s[i] == "!" {
        let r = lower_factor(s, i + 1, decls);
        return ["(!(" + r[0] + "))", r[1], 0];
    }
    if s[i] == "\"" {
        let ps = parse_string(s, i);
        return ["\"" + c_escape(ps[0]) + "\"", ps[1], 2];
    }
    if s[i] == "[" {
        i = i + 1;
        let elems: str = "";
        let n: i64 = 0;
        i = skip(s, i);
        if s[i] != "]" {
            while true {
                let ar = lower_cmp(s, i, decls);
                if n > 0 { elems = elems + ", "; }
                elems = elems + ar[0];
                n = n + 1;
                i = skip(s, ar[1]);
                if s[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(s[i] == "]"); i = i + 1;
        let lit: str = "klist_of((const int64_t[]){ " + elems + " }, " + itoa(n) + ")";
        return [lit, i, 1];
    }
    if is_digit(s[i]) == 1 {
        let start: i64 = i;
        let v: i64 = 0;
        while i < len(s) {
            if is_digit(s[i]) == 0 { break; }
            v = v * 10 + (ord(s[i]) - 48); i = i + 1;
        }
        // float if '.' then digit (not '..' range)
        if i < len(s) {
            if s[i] == "." {
                if i + 1 < len(s) {
                    if s[i + 1] != "." {
                        if is_digit(s[i + 1]) == 1 {
                            let lit: str = "";
                            let k: i64 = start;
                            while k < i { lit = lit + s[k]; k = k + 1; }
                            lit = lit + ".";
                            i = i + 1;
                            while i < len(s) {
                                if is_digit(s[i]) == 0 { break; }
                                lit = lit + s[i]; i = i + 1;
                            }
                            return [lit, i, 3];
                        }
                    }
                }
            }
        }
        return [itoa(v) + "LL", i, 0];
    }
    assert(is_alpha(s[i]) == 1);
    let id = parse_ident(s, i);
    let j: i64 = skip(s, id[1]);
    if id[0] == "true" { return ["1LL", id[1], 0]; }
    if id[0] == "false" { return ["0LL", id[1], 0]; }
    // Bare-metal intrinsics — passthrough as plain C (host provides in kf_rt.h).
    if id[0] == "mmio_read8"  { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_r8",  1) + " ;; (int64_t)", j, 0]; }
    if id[0] == "mmio_read16" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_r16", 1) + " ;; (int64_t)", j, 0]; }
    if id[0] == "mmio_read32" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_r32", 1) + " ;; (int64_t)", j, 0]; }
    if id[0] == "mmio_read64" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_r64", 1), j, 0]; }
    if id[0] == "mmio_write8"  { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_w8",  2) + " ;; 0LL", j, 0]; }
    if id[0] == "mmio_write16" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_w16", 2) + " ;; 0LL", j, 0]; }
    if id[0] == "mmio_write32" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_w32", 2) + " ;; 0LL", j, 0]; }
    if id[0] == "mmio_write64" { j = j + 1; return [lower_call_args(s, j, decls, "_k_mmio_w64", 2) + " ;; 0LL", j, 0]; }
    if id[0] == "asm_hlt"     { return ["__asm__ __volatile__(\"hlt\"); 0LL", id[1], 0]; }
    if id[0] == "asm_cli"     { return ["__asm__ __volatile__(\"cli\"); 0LL", id[1], 0]; }
    if id[0] == "asm_sti"     { return ["__asm__ __volatile__(\"sti\"); 0LL", id[1], 0]; }
    if id[0] == "atomic_fence" { return ["__atomic_thread_fence(__ATOMIC_SEQ_CST); 0LL", id[1], 0]; }
    if id[0] == "atomic_load"  { j = j + 1; return ["((int64_t)__atomic_load_n((volatile int64_t*)(uintptr_t)" + lower_call_args(s, j, decls, "", 1) + "))", j, 0]; }
    if id[0] == "atomic_store" { j = j + 1; return ["__atomic_store_n((volatile int64_t*)(uintptr_t)" + lower_call_args(s, j, decls, "", 2) + "); 0LL", j, 0]; }
    // asm(code) — Kenga emits string literal.
    if id[0] == "asm" { j = j + 1; return ["__asm__ __volatile__(" + lower_call_args(s, j, decls, "", 1) + "); 0LL", j, 0]; }
    if j < len(s) {
        if s[j] == "{" {
            let tid: i64 = find_struct(stypes_of(decls), id[0]);
            if tid >= 0 {
                let fields: list = stypes_of(decls)[tid][1];
                j = j + 1;
                let elems: str = "";
                let fi: i64 = 0;
                while fi < len(fields) {
                    j = skip(s, j);
                    let fnm = parse_ident(s, j);
                    assert(fnm[0] == fields[fi]);
                    j = skip(s, fnm[1]);
                    assert(s[j] == ":"); j = j + 1;
                    let ar = lower_cmp(s, j, decls);
                    if fi > 0 { elems = elems + ", "; }
                    elems = elems + ar[0];
                    j = skip(s, ar[1]);
                    if j < len(s) { if s[j] == "," { j = j + 1; } }
                    fi = fi + 1;
                }
                j = skip(s, j); assert(s[j] == "}"); j = j + 1;
                let lit: str = "klist_of((const int64_t[]){ " + elems + " }, " + itoa(len(fields)) + ")";
                return [lit, j, 1];
            }
        }
        if s[j] == "(" {
            j = j + 1; j = skip(s, j);
            if id[0] == "len" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                return ["klist_len(&(" + ar[0] + "))", j, 0];
            }
            if id[0] == "push" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ","); j = j + 1;
                let av = lower_cmp(s, j, decls);
                j = skip(s, av[1]); assert(s[j] == ")"); j = j + 1;
                return ["klist_push_ret(" + ar[0] + ", " + av[0] + ")", j, 1];
            }
            if id[0] == "round" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                return ["((int64_t)llround((double)(" + ar[0] + ")))", j, 0];
            }
            if id[0] == "sleep_ms" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                return ["k_sleep_ms(" + ar[0] + ")", j, 0];
            }
            if id[0] == "typeof" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                let tname: str = "i64";
                if ar[2] == 1 { tname = "list"; }
                if ar[2] == 2 { tname = "str"; }
                if ar[2] == 3 { tname = "f64"; }
                return ["\"" + tname + "\"", j, 2];
            }
            if id[0] == "to_str" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                if ar[2] == 2 {
                    return [ar[0], j, 2];
                } else {
                    if ar[2] == 3 {
                        return ["k_to_str_f64(" + ar[0] + ")", j, 2];
                    } else {
                        return ["k_to_str_i64(" + ar[0] + ")", j, 2];
                    }
                }
            }
            if id[0] == "emit" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ","); j = j + 1;
                let av = lower_cmp(s, j, decls);
                j = skip(s, av[1]); assert(s[j] == ")"); j = j + 1;
                return ["ke_emit(" + ar[0] + ", " + av[0] + ")", j, 0];
            }
            if id[0] == "pump" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                return ["ke_pump(" + ar[0] + ")", j, 0];
            }
            if id[0] == "pending" {
                assert(s[j] == ")"); j = j + 1;
                return ["ke_pending()", j, 0];
            }
            if id[0] == "now_ms" {
                assert(s[j] == ")"); j = j + 1;
                return ["k_now_ms()", j, 0];
            }
            // user fn call
            let args: str = "";
            let argc: i64 = 0;
            if s[j] != ")" {
                while true {
                    let ar = lower_cmp(s, j, decls);
                    if argc > 0 { args = args + ", "; }
                    args = args + ar[0];
                    argc = argc + 1;
                    j = skip(s, ar[1]);
                    if s[j] == "," { j = j + 1; continue; }
                    break;
                }
            }
            assert(s[j] == ")"); j = j + 1;
            return ["fn_" + id[0] + "(" + args + ")", j, 0];
        }
    }
    let k: i64 = decl_kind(decls, id[0]);
    return [id[0], id[1], k];
}

fn lower_index(s: str, i: i64, decls: list, base: str, bkind: i64) -> list {
    // after factor: [idx] gets and .field as list slots
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "[" {
            let ix = lower_cmp(s, i + 1, decls);
            i = skip(s, ix[1]); assert(s[i] == "]"); i = i + 1;
            base = "klist_get(&(" + base + "), " + ix[0] + ")";
            bkind = 0;
            continue;
        }
        if s[i] == "." {
            if i + 1 < len(s) {
                if s[i + 1] == "." { break; }
            }
            let fld = parse_ident(s, i + 1);
            let fidx: i64 = field_index_any(stypes_of(decls), fld[0]);
            assert(fidx >= 0);
            base = "klist_get(&(" + base + "), " + itoa(fidx) + "LL)";
            bkind = 0;
            i = fld[1];
            continue;
        }
        break;
    }
    return [base, i, bkind];
}

fn lower_term(s: str, i: i64, decls: list) -> list {
    let r = lower_factor(s, i, decls);
    r = lower_index(s, r[1], decls, r[0], r[2]);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "*" {
            r = lower_factor(s, i + 1, decls);
            r = lower_index(s, r[1], decls, r[0], r[2]);
            if kind == 3 { kind = 3; } else { if r[2] == 3 { kind = 3; } else { kind = 0; } }
            out = "(" + out + " * " + r[0] + ")"; i = r[1];
        } else {
            if s[i] == "/" {
                r = lower_factor(s, i + 1, decls);
                r = lower_index(s, r[1], decls, r[0], r[2]);
                if kind == 3 { kind = 3; } else { if r[2] == 3 { kind = 3; } else { kind = 0; } }
                out = "(" + out + " / " + r[0] + ")"; i = r[1];
            } else {
                if s[i] == "%" {
                    r = lower_factor(s, i + 1, decls);
                    r = lower_index(s, r[1], decls, r[0], r[2]);
                    if kind == 3 { kind = 3; } else { if r[2] == 3 { kind = 3; } else { kind = 0; } }
                    out = "(" + out + " % " + r[0] + ")"; i = r[1];
                } else { break; }
            }
        }
    }
    return [out, i, kind];
}

fn lower_sum(s: str, i: i64, decls: list) -> list {
    let r = lower_term(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "+" {
            r = lower_term(s, i + 1, decls);
            if kind == 2 {
                if r[2] == 2 {
                    out = "kstr_concat(" + out + ", " + r[0] + ")";
                    kind = 2;
                } else {
                    out = "(" + out + " + " + r[0] + ")"; kind = 0;
                }
            } else {
                if kind == 3 { kind = 3; } else { if r[2] == 3 { kind = 3; } else { kind = 0; } }
                out = "(" + out + " + " + r[0] + ")";
            }
            i = r[1];
        } else {
            if s[i] == "-" {
                r = lower_term(s, i + 1, decls);
                if kind == 3 { kind = 3; } else { if r[2] == 3 { kind = 3; } else { kind = 0; } }
                out = "(" + out + " - " + r[0] + ")"; i = r[1];
            } else { break; }
        }
    }
    return [out, i, kind];
}

fn lower_rel(s: str, i: i64, decls: list) -> list {
    let r = lower_sum(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2]; i = skip(s, i);
    if i >= len(s) { return [out, i, kind]; }
    if starts_with(s, i, "<=") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " <= " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, ">=") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " >= " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, "==") == 1 {
        r = lower_sum(s, i + 2, decls);
        if kind == 2 {
            return ["(strcmp(" + out + ", " + r[0] + ") == 0)", r[1], 0];
        }
        if r[2] == 2 {
            return ["(strcmp(" + out + ", " + r[0] + ") == 0)", r[1], 0];
        }
        return ["(" + out + " == " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, "!=") == 1 {
        r = lower_sum(s, i + 2, decls);
        if kind == 2 {
            return ["(strcmp(" + out + ", " + r[0] + ") != 0)", r[1], 0];
        }
        if r[2] == 2 {
            return ["(strcmp(" + out + ", " + r[0] + ") != 0)", r[1], 0];
        }
        return ["(" + out + " != " + r[0] + ")", r[1], 0];
    }
    if s[i] == "<" {
        r = lower_sum(s, i + 1, decls); return ["(" + out + " < " + r[0] + ")", r[1], 0];
    }
    if s[i] == ">" {
        r = lower_sum(s, i + 1, decls); return ["(" + out + " > " + r[0] + ")", r[1], 0];
    }
    return [out, i, kind];
}

fn lower_and(s: str, i: i64, decls: list) -> list {
    let r = lower_rel(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "&&") == 1 {
            r = lower_rel(s, i + 2, decls);
            out = "(" + out + " && " + r[0] + ")";
            i = r[1];
            kind = 0;
        } else { break; }
    }
    return [out, i, kind];
}

fn lower_or(s: str, i: i64, decls: list) -> list {
    let r = lower_and(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "||") == 1 {
            r = lower_and(s, i + 2, decls);
            out = "(" + out + " || " + r[0] + ")";
            i = r[1];
            kind = 0;
        } else { break; }
    }
    return [out, i, kind];
}

fn lower_cmp(s: str, i: i64, decls: list) -> list {
    return lower_or(s, i, decls);
}

fn lower_block(s: str, i: i64, ind: i64, decls: list) -> list {
    i = skip(s, i); assert(s[i] == "{"); i = i + 1;
    let out: str = "";
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = lower_stmt(s, i, ind, decls);
        out = out + st[0]; i = st[1]; decls = st[2];
    }
    assert(s[i] == "}");
    return [out, i + 1, decls];
}

fn lower_stmt(s: str, i: i64, ind: i64, decls: list) -> list {
    i = skip(s, i);
    let pad: str = indent(ind);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip_type_annot(s, id[1]);
        i = skip(s, i);
        assert(s[i] == "="); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        decls = ensure_decl(decls, id[0], r[2]);
        return [pad + id[0] + " = " + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "return") == 1 {
        let r = lower_cmp(s, i + 6, decls);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "return " + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        if r[2] == 2 {
            return [pad + "puts(" + r[0] + ");\n", i, decls];
        }
        if r[2] == 1 {
            return [pad + "klist_println(&(" + r[0] + "));\n", i, decls];
        }
        if r[2] == 3 {
            return [pad + "printf(\"%g\\n\", (double)(" + r[0] + "));\n", i, decls];
        }
        return [pad + "printf(\"%lld\\n\", (long long)(" + r[0] + "));\n", i, decls];
    }
    if starts_kw(s, i, "print") == 1 {
        i = skip(s, i + 5); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        if r[2] == 2 {
            return [pad + "fputs(" + r[0] + ", stdout); fflush(stdout);\n", i, decls];
        }
        if r[2] == 1 {
            return [pad + "klist_print(&(" + r[0] + "));\n", i, decls];
        }
        if r[2] == 3 {
            return [pad + "printf(\"%g\", (double)(" + r[0] + ")); fflush(stdout);\n", i, decls];
        }
        return [pad + "printf(\"%lld\", (long long)(" + r[0] + ")); fflush(stdout);\n", i, decls];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "if (!(" + r[0] + ")) return 1;\n", i, decls];
    }
    if starts_kw(s, i, "while") == 1 {
        let r = lower_cmp(s, i + 5, decls);
        let bl = lower_block(s, r[1], ind + 1, decls);
        return [pad + "while (" + r[0] + ") {\n" + bl[0] + pad + "}\n", bl[1], bl[2]];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let var = parse_ident(s, i);
        i = skip(s, var[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let lo = lower_cmp(s, i, decls);
        i = skip(s, lo[1]);
        if starts_with(s, i, "..") == 1 {
            i = i + 2;
            let hi = lower_cmp(s, i, decls);
            decls = ensure_decl(decls, var[0], 0);
            let bl = lower_block(s, hi[1], ind + 1, decls);
            let out: str = pad + "for (" + var[0] + " = " + lo[0] + "; " + var[0] + " < " + hi[0] + "; " + var[0] + " = " + var[0] + " + 1) {\n";
            out = out + bl[0] + pad + "}\n";
            return [out, bl[1], bl[2]];
        }
        // for v in xs { ... }
        let ti: str = "_fi" + itoa(i);
        let tl: str = "_fl" + itoa(i);
        decls = ensure_decl(decls, var[0], 0);
        decls = ensure_decl(decls, ti, 0);
        decls = ensure_decl(decls, tl, 1);
        let bl = lower_block(s, i, ind + 1, decls);
        let out: str = pad + tl + " = " + lo[0] + ";\n";
        out = out + pad + "for (" + ti + " = 0; " + ti + " < klist_len(&(" + tl + ")); " + ti + " = " + ti + " + 1) {\n";
        out = out + pad + "  " + var[0] + " = klist_get(&(" + tl + "), " + ti + ");\n";
        out = out + bl[0] + pad + "}\n";
        return [out, bl[1], bl[2]];
    }
    if starts_kw(s, i, "break") == 1 {
        i = skip(s, i + 5); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "break;\n", i, decls];
    }
    if starts_kw(s, i, "continue") == 1 {
        i = skip(s, i + 8); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "continue;\n", i, decls];
    }
    if starts_kw(s, i, "if") == 1 {
        let r = lower_cmp(s, i + 2, decls);
        let th = lower_block(s, r[1], ind + 1, decls);
        let out: str = pad + "if (" + r[0] + ") {\n" + th[0] + pad + "}";
        let j: i64 = skip(s, th[1]);
        if starts_kw(s, j, "else") == 1 {
            j = skip(s, j + 4);
            if starts_kw(s, j, "if") == 1 {
                let el = lower_stmt(s, j, ind, th[2]);
                out = out + " else {\n" + el[0] + pad + "}\n";
                return [out, el[1], el[2]];
            }
            let el = lower_block(s, j, ind + 1, th[2]);
            out = out + " else {\n" + el[0] + pad + "}\n";
            return [out, el[1], el[2]];
        }
        return [out + "\n", th[1], th[2]];
    }
    // xs[i] = v  or  x = v  or call
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let ix = lower_cmp(s, j + 1, decls);
                j = skip(s, ix[1]); assert(s[j] == "]"); j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        if starts_with(s, j, "==") == 0 {
                            let r = lower_cmp(s, j + 1, decls);
                            j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                            return [pad + "klist_set(&(" + id[0] + "), " + ix[0] + ", " + r[0] + ");\n", j, decls];
                        }
                    }
                }
                i = save;
            } else {
                if s[j] == "." {
                    if j + 1 < len(s) {
                        if s[j + 1] != "." {
                            let fld = parse_ident(s, j + 1);
                            let fidx: i64 = field_index_any(stypes_of(decls), fld[0]);
                            assert(fidx >= 0);
                            j = skip(s, fld[1]);
                            if j < len(s) {
                                if s[j] == "=" {
                                    if starts_with(s, j, "==") == 0 {
                                        let r = lower_cmp(s, j + 1, decls);
                                        j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                                        return [pad + "klist_set(&(" + id[0] + "), " + itoa(fidx) + "LL, " + r[0] + ");\n", j, decls];
                                    }
                                }
                            }
                            i = save;
                        }
                    }
                } else {
                    if s[j] == "=" {
                        if starts_with(s, j, "==") == 0 {
                            let r = lower_cmp(s, j + 1, decls);
                            j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                            decls = ensure_decl(decls, id[0], r[2]);
                            return [pad + id[0] + " = " + r[0] + ";\n", j, decls];
                        }
                    }
                }
            }
        }
    }
    let r = lower_cmp(s, i, decls);
    i = skip(s, r[1]); if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [pad + "(void)(" + r[0] + ");\n", i, decls];
}

fn lower_fn_body(body: str, params: list, stypes: list) -> list {
    // params: list of [name, kind]
    let decls: list = [];
    let pi: i64 = 0;
    while pi < len(params) {
        decls = ensure_decl(decls, params[pi][0], params[pi][1]);
        pi = pi + 1;
    }
    decls = push(decls, ["__stypes__", stypes]);
    let bl = lower_block(body, 0, 1, decls);
    let locals: list = bl[2];
    let pre: str = "";
    let li: i64 = 0;
    while li < len(locals) {
        let nm: str = locals[li][0];
        if nm == "__stypes__" {
            li = li + 1;
            continue;
        }
        let k: i64 = locals[li][1];
        let is_param: i64 = 0;
        let pj: i64 = 0;
        while pj < len(params) {
            if params[pj][0] == nm { is_param = 1; }
            pj = pj + 1;
        }
        if is_param == 0 {
            if k == 1 {
                pre = pre + "  KList " + nm + " = klist_new();\n";
            } else {
                if k == 2 {
                    pre = pre + "  const char* " + nm + " = \"\";\n";
                } else {
                    if k == 3 {
                        pre = pre + "  double " + nm + " = 0.0;\n";
                    } else {
                        pre = pre + "  int64_t " + nm + " = 0;\n";
                    }
                }
            }
        }
        li = li + 1;
    }
    return [pre + bl[0]];
}

fn dirname_of(path: str) -> str {
    let i: i64 = len(path) - 1;
    while i >= 0 {
        if path[i] == "/" { break; }
        if path[i] == "\\" { break; }
        i = i - 1;
    }
    if i < 0 { return "."; }
    let out: str = "";
    let j: i64 = 0;
    while j < i { out = out + path[j]; j = j + 1; }
    if len(out) == 0 { return "."; }
    return out;
}
fn join_path(dir: str, rel: str) -> str {
    if len(dir) == 0 { return rel; }
    if dir == "." { return rel; }
    return dir + "/" + rel;
}
fn resolve_imports(path: str, depth: i64) -> str {
    assert(depth < 32);
    let src: str = read_file(path);
    let dir: str = dirname_of(path);
    let i: i64 = 0;
    let acc: str = "";
    while true {
        i = skip(src, i);
        if starts_kw(src, i, "import") == 0 { break; }
        i = skip(src, i + 6);
        assert(src[i] == "\"");
        let ps = parse_string(src, i);
        i = ps[1];
        i = skip(src, i);
        if i < len(src) { if src[i] == ";" { i = i + 1; } }
        let dep_path: str = join_path(dir, ps[0]);
        acc = acc + resolve_imports(dep_path, depth + 1);
        acc = acc + "\n";
    }
    let rest: str = "";
    while i < len(src) { rest = rest + src[i]; i = i + 1; }
    return acc + rest;
}

fn lower_program(src: str) -> str {
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let fkinds: list = []; // 0=fn, 1=on-handler, 2=main
    let events: list = []; // [event_name, handler_cname, arity]
    let stypes: list = [];
    let on_serial: i64 = 0;
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        if starts_kw(src, i, "struct") == 1 {
            i = skip(src, i + 6);
            let id = parse_ident(src, i);
            i = skip(src, id[1]);
            assert(src[i] == "{"); i = i + 1;
            let fields: list = [];
            i = skip(src, i);
            if src[i] != "}" {
                while true {
                    let fnm = parse_ident(src, i);
                    fields = push(fields, fnm[0]);
                    i = skip_type_annot(src, fnm[1]);
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; i = skip(src, i); continue; }
                    break;
                }
            }
            assert(src[i] == "}"); i = i + 1;
            stypes = push(stypes, [id[0], fields]);
            continue;
        }
        if starts_kw(src, i, "on") == 1 {
            i = skip(src, i + 2);
            assert(src[i] == "\"");
            let ps = parse_string(src, i);
            let ev: str = ps[0]; i = ps[1];
            i = skip(src, i);
            assert(src[i] == "("); i = i + 1;
            let params: list = [];
            i = skip(src, i);
            if src[i] != ")" {
                while true {
                    let pn = parse_ident(src, i);
                    let tk = parse_type_kind(src, pn[1]);
                    params = push(params, [pn[0], tk[0]]);
                    i = skip(src, tk[1]);
                    if src[i] == "," { i = i + 1; continue; }
                    break;
                }
            }
            assert(src[i] == ")");
            i = skip(src, i + 1);
            assert(src[i] == "{");
            let start: i64 = i;
            i = match_brace(src, i);
            let body: str = "";
            let bi: i64 = start;
            while bi < i { body = body + src[bi]; bi = bi + 1; }
            let hname: str = "on_" + itoa(on_serial);
            on_serial = on_serial + 1;
            events = push(events, [ev, hname, len(params)]);
            fnames = push(fnames, hname);
            fparams = push(fparams, params);
            fbodies = push(fbodies, body);
            fkinds = push(fkinds, 1);
            continue;
        }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "("); i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                let tk = parse_type_kind(src, pn[1]);
                params = push(params, [pn[0], tk[0]]);
                i = skip(src, tk[1]);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
        if id[0] == "main" {
            fkinds = push(fkinds, 2);
        } else {
            fkinds = push(fkinds, 0);
        }
    }

    let out: str = runtime_c();
    // prototypes for regular fns + on handlers
    let fi: i64 = 0;
    while fi < len(fnames) {
        if fkinds[fi] == 0 {
            out = out + "static int64_t fn_" + fnames[fi] + "(";
            let pj: i64 = 0;
            while pj < len(fparams[fi]) {
                if pj > 0 { out = out + ", "; }
                out = out + ctype(fparams[fi][pj][1]) + " " + fparams[fi][pj][0];
                pj = pj + 1;
            }
            out = out + ");\n";
        }
        if fkinds[fi] == 1 {
            out = out + "static void " + fnames[fi] + "(";
            if len(fparams[fi]) == 1 {
                out = out + ctype(fparams[fi][0][1]) + " " + fparams[fi][0][0];
            } else {
                out = out + "int64_t __unused";
            }
            out = out + ");\n";
        }
        fi = fi + 1;
    }
    out = out + "\n";

    fi = 0;
    while fi < len(fnames) {
        if fkinds[fi] == 1 {
            out = out + "static void " + fnames[fi] + "(";
            if len(fparams[fi]) == 1 {
                out = out + ctype(fparams[fi][0][1]) + " " + fparams[fi][0][0];
            } else {
                out = out + "int64_t __unused";
            }
            out = out + ") {\n";
            let body = lower_fn_body(fbodies[fi], fparams[fi], stypes);
            out = out + body[0] + "}\n\n";
        }
        if fkinds[fi] == 0 {
            out = out + "static int64_t fn_" + fnames[fi] + "(";
            let pj: i64 = 0;
            while pj < len(fparams[fi]) {
                if pj > 0 { out = out + ", "; }
                out = out + ctype(fparams[fi][pj][1]) + " " + fparams[fi][pj][0];
                pj = pj + 1;
            }
            out = out + ") {\n";
            let body = lower_fn_body(fbodies[fi], fparams[fi], stypes);
            out = out + body[0] + "  return 0;\n}\n\n";
        }
        if fkinds[fi] == 2 {
            let body = lower_fn_body(fbodies[fi], fparams[fi], stypes);
            out = out + "int main(void) {\n";
            let ei: i64 = 0;
            while ei < len(events) {
                out = out + "  ke_listen(\"" + c_escape(events[ei][0]) + "\", " + events[ei][1] + ", " + itoa(events[ei][2]) + ");\n";
                ei = ei + 1;
            }
            out = out + body[0] + "  return 0;\n}\n\n";
        }
        fi = fi + 1;
    }
    return out;
}

fn main() -> i64 {
    let fact: str = "fn main() -> i64 { let n = 1; let i = 1; while i <= 6 { n = n * i; i = i + 1; } println(n); assert(n == 720); return 0; }";
    assert(write_file("bootstrap/bin/lower_fact.c", lower_program(fact)) == true);

    let brk: str = "fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } println(acc); assert(acc == 3); return 0; }";
    assert(write_file("bootstrap/bin/lower_for.c", lower_program(brk)) == true);

    let iff: str = "fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } println(label); assert(label == 30); return 0; }";
    assert(write_file("bootstrap/bin/lower_if.c", lower_program(iff)) == true);

    let multi: str = "fn add(a: i64, b: i64) -> i64 { return a + b; } fn main() -> i64 { let x = add(20, 22); println(x); assert(x == 42); return 0; }";
    assert(write_file("bootstrap/bin/lower_fn.c", lower_program(multi)) == true);

    let lists: str = "fn main() { let xs = [1, 2, 3, 4]; xs[0] = 10; let s = 0; let i = 0; while i < len(xs) { s = s + xs[i]; i = i + 1; } println(s); assert(s == 19); return 0; }";
    assert(write_file("bootstrap/bin/lower_list.c", lower_program(lists)) == true);

    let hello: str = "fn main() { println(\"hello\"); return 0; }";
    assert(write_file("bootstrap/bin/lower_str.c", lower_program(hello)) == true);

    let ping: str = "on \"ping\"(x) { emit(\"pong\", x); } on \"pong\"(x) { println(x); } fn main() { emit(\"ping\", 7); assert(pump(8) == 2); assert(pending() == 0); return 0; }";
    assert(write_file("bootstrap/bin/lower_events.c", lower_program(ping)) == true);

    let agent = resolve_imports("examples/agent.kenga", 0);
    assert(write_file("bootstrap/bin/lower_agent.c", lower_program(agent)) == true);

    let imp = resolve_imports("examples/selfhost/lower_import.kenga", 0);
    assert(write_file("bootstrap/bin/lower_import.c", lower_program(imp)) == true);

    let forlite = resolve_imports("examples/selfhost/for_lite.kenga", 0);
    assert(write_file("bootstrap/bin/lower_for_lite.c", lower_program(forlite)) == true);

    let lists = resolve_imports("examples/selfhost/lists_lite.kenga", 0);
    assert(write_file("bootstrap/bin/lower_lists_lite.c", lower_program(lists)) == true);

    let stru = resolve_imports("examples/selfhost/struct_lite.kenga", 0);
    assert(write_file("bootstrap/bin/lower_struct_lite.c", lower_program(stru)) == true);

    let elifs = resolve_imports("examples/selfhost/elif_lite.kenga", 0);
    assert(write_file("bootstrap/bin/lower_elif_lite.c", lower_program(elifs)) == true);

    let floats = resolve_imports("examples/selfhost/float_lite.kenga", 0);
    assert(write_file("bootstrap/bin/lower_float_lite.c", lower_program(floats)) == true);

    let em_and = lower_cmp("1 && 0", 0, []);
    assert(em_and[0] == "(1LL && 0LL)");
    let em_mod = lower_cmp("10 % 3", 0, []);
    assert(em_mod[0] == "(10LL % 3LL)");
    let em_not = lower_cmp("!0", 0, []);
    assert(em_not[0] == "(!(0LL))");
    let em_typeof = lower_cmp("typeof(1)", 0, []);
    assert(em_typeof[0] == "\"i64\"");
    assert(em_typeof[2] == 2);
    let em_tostr = lower_cmp("to_str(42)", 0, []);
    assert(em_tostr[0] == "k_to_str_i64(42LL)");
    assert(em_tostr[2] == 2);
    let em_cat = lower_cmp("\"n=\" + to_str(42)", 0, []);
    assert(em_cat[0] == "kstr_concat(\"n=\", k_to_str_i64(42LL))");
    assert(em_cat[2] == 2);
    let em_print = lower_stmt("print(\"x\");", 0, 1, []);
    assert(em_print[0] == "  fputs(\"x\", stdout); fflush(stdout);\n");
    let em_sleep = lower_cmp("sleep_ms(0)", 0, []);
    assert(em_sleep[0] == "k_sleep_ms(0LL)");
    assert(em_sleep[2] == 0);
    let em_now = lower_cmp("now_ms()", 0, []);
    assert(em_now[0] == "k_now_ms()");
    assert(em_now[2] == 0);

    let logic = resolve_imports("examples/selfhost/lower_logic.kenga", 0);
    assert(write_file("bootstrap/bin/lower_logic.c", lower_program(logic)) == true);

    let tof = resolve_imports("examples/selfhost/lower_typeof.kenga", 0);
    assert(write_file("bootstrap/bin/lower_typeof.c", lower_program(tof)) == true);

    let prn = resolve_imports("examples/selfhost/lower_print.kenga", 0);
    assert(write_file("bootstrap/bin/lower_print.c", lower_program(prn)) == true);

    let nowf = resolve_imports("examples/selfhost/lower_now.kenga", 0);
    assert(write_file("bootstrap/bin/lower_now.c", lower_program(nowf)) == true);

    println("wrote bootstrap/bin/lower_*.c (events/agent/import/for/lists/struct/elif/float/logic/typeof/print/now)");
    println("lower_c ok");
    return 0;
}
