// General lowerer: Kenga i64/str/list subset → C99 (no Rust).
// + multi-fn, string literals, list [ ] / push / len / index.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\lower_c.kenga

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i); let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch; i = i + 1;
    }
    return [name, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\"" { return [out, i + 1]; }
        if s[i] == "\\" {
            if i + 1 < len(s) {
                out = out + s[i + 1];
                i = i + 2;
                continue;
            }
        }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn c_escape(s: str) -> str {
    let out: str = "";
    let i: i64 = 0;
    while i < len(s) {
        if s[i] == "\\" {
            out = out + "\\\\";
        } else {
            if s[i] == "\"" {
                out = out + "\\\"";
            } else {
                out = out + s[i];
            }
        }
        i = i + 1;
    }
    return out;
}
fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let out: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        out = digs[d] + out;
        x = x / 10;
    }
    if n < 0 { return "-" + out; }
    return out;
}
fn indent(n: i64) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < n { s = s + "  "; i = i + 1; }
    return s;
}
fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "\"" {
            i = i + 1;
            while i < n {
                if src[i] == "\\" { i = i + 2; continue; }
                if src[i] == "\"" { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(0 == 1);
    return i;
}
fn skip_type_annot(s: str, i: i64) -> i64 {
    i = skip(s, i);
    if i >= len(s) { return i; }
    if s[i] != ":" { return i; }
    i = skip(s, i + 1);
    let ty = parse_ident(s, i);
    return skip(s, ty[1]);
}

// decls: list of [name, kind] kind 0=i64 1=list 2=str
fn decl_kind(decls: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i][0] == name { return decls[i][1]; }
        i = i + 1;
    }
    return 0;
}
fn ensure_decl(decls: list, name: str, kind: i64) -> list {
    let i: i64 = 0;
    while i < len(decls) {
        if decls[i][0] == name {
            decls[i] = [name, kind];
            return decls;
        }
        i = i + 1;
    }
    return push(decls, [name, kind]);
}

fn runtime_c() -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/lower_c.kenga — no Rust */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\n";
    s = s + "typedef struct { int64_t *d; size_t n, cap; } KList;\n";
    s = s + "static KList klist_new(void) { KList L; L.d=NULL; L.n=0; L.cap=0; return L; }\n";
    s = s + "static void klist_push(KList *L, int64_t v) {\n";
    s = s + "  if (L->n+1>L->cap) { size_t nc=L->cap?L->cap*2:4; L->d=(int64_t*)realloc(L->d,nc*sizeof(int64_t)); L->cap=nc; }\n";
    s = s + "  L->d[L->n++]=v;\n}\n";
    s = s + "static int64_t klist_get(KList *L, int64_t i) { return L->d[(size_t)i]; }\n";
    s = s + "static void klist_set(KList *L, int64_t i, int64_t v) { L->d[(size_t)i]=v; }\n";
    s = s + "static int64_t klist_len(KList *L) { return (int64_t)L->n; }\n";
    s = s + "static KList klist_push_ret(KList L, int64_t v) { klist_push(&L, v); return L; }\n";
    s = s + "static KList klist_of(const int64_t *a, size_t n) {\n";
    s = s + "  KList L = klist_new(); size_t i; for (i=0;i<n;i++) klist_push(&L, a[i]); return L;\n}\n\n";
    return s;
}

fn lower_factor(s: str, i: i64, decls: list) -> list {
    // returns [c_expr, new_i, kind]
    i = skip(s, i);
    if s[i] == "(" {
        let r = lower_cmp(s, i + 1, decls);
        i = skip(s, r[1]); assert(s[i] == ")");
        return ["(" + r[0] + ")", i + 1, r[2]];
    }
    if s[i] == "-" {
        let r = lower_factor(s, i + 1, decls);
        return ["(0 - " + r[0] + ")", r[1], 0];
    }
    if s[i] == "\"" {
        let ps = parse_string(s, i);
        return ["\"" + c_escape(ps[0]) + "\"", ps[1], 2];
    }
    if s[i] == "[" {
        i = i + 1;
        let elems: str = "";
        let n: i64 = 0;
        i = skip(s, i);
        if s[i] != "]" {
            while true {
                let ar = lower_cmp(s, i, decls);
                if n > 0 { elems = elems + ", "; }
                elems = elems + ar[0];
                n = n + 1;
                i = skip(s, ar[1]);
                if s[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(s[i] == "]"); i = i + 1;
        let lit: str = "klist_of((const int64_t[]){ " + elems + " }, " + itoa(n) + ")";
        return [lit, i, 1];
    }
    if is_digit(s[i]) == 1 {
        let v: i64 = 0;
        while i < len(s) {
            if is_digit(s[i]) == 0 { break; }
            v = v * 10 + (ord(s[i]) - 48); i = i + 1;
        }
        return [itoa(v) + "LL", i, 0];
    }
    assert(is_alpha(s[i]) == 1);
    let id = parse_ident(s, i);
    let j: i64 = skip(s, id[1]);
    if j < len(s) {
        if s[j] == "(" {
            j = j + 1; j = skip(s, j);
            if id[0] == "len" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ")"); j = j + 1;
                return ["klist_len(&(" + ar[0] + "))", j, 0];
            }
            if id[0] == "push" {
                let ar = lower_cmp(s, j, decls);
                j = skip(s, ar[1]); assert(s[j] == ","); j = j + 1;
                let av = lower_cmp(s, j, decls);
                j = skip(s, av[1]); assert(s[j] == ")"); j = j + 1;
                return ["klist_push_ret(" + ar[0] + ", " + av[0] + ")", j, 1];
            }
            // user fn call
            let args: str = "";
            let argc: i64 = 0;
            if s[j] != ")" {
                while true {
                    let ar = lower_cmp(s, j, decls);
                    if argc > 0 { args = args + ", "; }
                    args = args + ar[0];
                    argc = argc + 1;
                    j = skip(s, ar[1]);
                    if s[j] == "," { j = j + 1; continue; }
                    break;
                }
            }
            assert(s[j] == ")"); j = j + 1;
            return ["fn_" + id[0] + "(" + args + ")", j, 0];
        }
    }
    let k: i64 = decl_kind(decls, id[0]);
    return [id[0], id[1], k];
}

fn lower_index(s: str, i: i64, decls: list, base: str, bkind: i64) -> list {
    // after factor, optional [idx] get
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "[" { break; }
        let ix = lower_cmp(s, i + 1, decls);
        i = skip(s, ix[1]); assert(s[i] == "]"); i = i + 1;
        base = "klist_get(&(" + base + "), " + ix[0] + ")";
        bkind = 0;
    }
    return [base, i, bkind];
}

fn lower_term(s: str, i: i64, decls: list) -> list {
    let r = lower_factor(s, i, decls);
    r = lower_index(s, r[1], decls, r[0], r[2]);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "*" {
            r = lower_factor(s, i + 1, decls);
            r = lower_index(s, r[1], decls, r[0], r[2]);
            out = "(" + out + " * " + r[0] + ")"; i = r[1]; kind = 0;
        } else {
            if s[i] == "/" {
                r = lower_factor(s, i + 1, decls);
                r = lower_index(s, r[1], decls, r[0], r[2]);
                out = "(" + out + " / " + r[0] + ")"; i = r[1]; kind = 0;
            } else { break; }
        }
    }
    return [out, i, kind];
}

fn lower_sum(s: str, i: i64, decls: list) -> list {
    let r = lower_term(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "+" {
            r = lower_term(s, i + 1, decls);
            if kind == 2 {
                if r[2] == 2 {
                    out = "\"/*str+str not lowered*/\"";
                    kind = 2;
                } else {
                    out = "(" + out + " + " + r[0] + ")"; kind = 0;
                }
            } else {
                out = "(" + out + " + " + r[0] + ")"; kind = 0;
            }
            i = r[1];
        } else {
            if s[i] == "-" {
                r = lower_term(s, i + 1, decls);
                out = "(" + out + " - " + r[0] + ")"; i = r[1]; kind = 0;
            } else { break; }
        }
    }
    return [out, i, kind];
}

fn lower_cmp(s: str, i: i64, decls: list) -> list {
    let r = lower_sum(s, i, decls);
    let out: str = r[0]; i = r[1]; let kind: i64 = r[2]; i = skip(s, i);
    if i >= len(s) { return [out, i, kind]; }
    if starts_with(s, i, "<=") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " <= " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, ">=") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " >= " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, "==") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " == " + r[0] + ")", r[1], 0];
    }
    if starts_with(s, i, "!=") == 1 {
        r = lower_sum(s, i + 2, decls); return ["(" + out + " != " + r[0] + ")", r[1], 0];
    }
    if s[i] == "<" {
        r = lower_sum(s, i + 1, decls); return ["(" + out + " < " + r[0] + ")", r[1], 0];
    }
    if s[i] == ">" {
        r = lower_sum(s, i + 1, decls); return ["(" + out + " > " + r[0] + ")", r[1], 0];
    }
    return [out, i, kind];
}

fn lower_block(s: str, i: i64, ind: i64, decls: list) -> list {
    i = skip(s, i); assert(s[i] == "{"); i = i + 1;
    let out: str = "";
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = lower_stmt(s, i, ind, decls);
        out = out + st[0]; i = st[1]; decls = st[2];
    }
    assert(s[i] == "}");
    return [out, i + 1, decls];
}

fn lower_stmt(s: str, i: i64, ind: i64, decls: list) -> list {
    i = skip(s, i);
    let pad: str = indent(ind);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip_type_annot(s, id[1]);
        i = skip(s, i);
        assert(s[i] == "="); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        decls = ensure_decl(decls, id[0], r[2]);
        return [pad + id[0] + " = " + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "return") == 1 {
        let r = lower_cmp(s, i + 6, decls);
        i = r[1]; i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "return " + r[0] + ";\n", i, decls];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        if r[2] == 2 {
            return [pad + "puts(" + r[0] + ");\n", i, decls];
        }
        return [pad + "printf(\"%lld\\n\", (long long)(" + r[0] + "));\n", i, decls];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6); assert(s[i] == "("); i = i + 1;
        let r = lower_cmp(s, i, decls);
        i = skip(s, r[1]); assert(s[i] == ")"); i = i + 1;
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "if (!(" + r[0] + ")) return 1;\n", i, decls];
    }
    if starts_kw(s, i, "while") == 1 {
        let r = lower_cmp(s, i + 5, decls);
        let bl = lower_block(s, r[1], ind + 1, decls);
        return [pad + "while (" + r[0] + ") {\n" + bl[0] + pad + "}\n", bl[1], bl[2]];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let var = parse_ident(s, i);
        i = skip(s, var[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let lo = lower_cmp(s, i, decls);
        i = skip(s, lo[1]);
        assert(starts_with(s, i, "..") == 1);
        i = i + 2;
        let hi = lower_cmp(s, i, decls);
        decls = ensure_decl(decls, var[0], 0);
        let bl = lower_block(s, hi[1], ind + 1, decls);
        let out: str = pad + "for (" + var[0] + " = " + lo[0] + "; " + var[0] + " < " + hi[0] + "; " + var[0] + " = " + var[0] + " + 1) {\n";
        out = out + bl[0] + pad + "}\n";
        return [out, bl[1], bl[2]];
    }
    if starts_kw(s, i, "break") == 1 {
        i = skip(s, i + 5); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "break;\n", i, decls];
    }
    if starts_kw(s, i, "continue") == 1 {
        i = skip(s, i + 8); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [pad + "continue;\n", i, decls];
    }
    if starts_kw(s, i, "if") == 1 {
        let r = lower_cmp(s, i + 2, decls);
        let th = lower_block(s, r[1], ind + 1, decls);
        let out: str = pad + "if (" + r[0] + ") {\n" + th[0] + pad + "}";
        let j: i64 = skip(s, th[1]);
        if starts_kw(s, j, "else") == 1 {
            j = skip(s, j + 4);
            if starts_kw(s, j, "if") == 1 {
                let el = lower_stmt(s, j, ind, th[2]);
                out = out + " else {\n" + el[0] + pad + "}\n";
                return [out, el[1], el[2]];
            }
            let el = lower_block(s, j, ind + 1, th[2]);
            out = out + " else {\n" + el[0] + pad + "}\n";
            return [out, el[1], el[2]];
        }
        return [out + "\n", th[1], th[2]];
    }
    // xs[i] = v  or  x = v  or call
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let ix = lower_cmp(s, j + 1, decls);
                j = skip(s, ix[1]); assert(s[j] == "]"); j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        if starts_with(s, j, "==") == 0 {
                            let r = lower_cmp(s, j + 1, decls);
                            j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                            return [pad + "klist_set(&(" + id[0] + "), " + ix[0] + ", " + r[0] + ");\n", j, decls];
                        }
                    }
                }
                i = save;
            } else {
                if s[j] == "=" {
                    if starts_with(s, j, "==") == 0 {
                        let r = lower_cmp(s, j + 1, decls);
                        j = r[1]; j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                        decls = ensure_decl(decls, id[0], r[2]);
                        return [pad + id[0] + " = " + r[0] + ";\n", j, decls];
                    }
                }
            }
        }
    }
    let r = lower_cmp(s, i, decls);
    i = skip(s, r[1]); if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [pad + "(void)(" + r[0] + ");\n", i, decls];
}

fn lower_fn_body(body: str, params: list) -> list {
    // returns [c_body_with_decls_inside, _]
    let decls: list = [];
    let pi: i64 = 0;
    while pi < len(params) {
        decls = ensure_decl(decls, params[pi], 0);
        pi = pi + 1;
    }
    let bl = lower_block(body, 0, 1, decls);
    let locals: list = bl[2];
    let pre: str = "";
    let li: i64 = 0;
    while li < len(locals) {
        let nm: str = locals[li][0];
        let k: i64 = locals[li][1];
        let is_param: i64 = 0;
        let pj: i64 = 0;
        while pj < len(params) {
            if params[pj] == nm { is_param = 1; }
            pj = pj + 1;
        }
        if is_param == 0 {
            if k == 1 {
                pre = pre + "  KList " + nm + " = klist_new();\n";
            } else {
                if k == 2 {
                    pre = pre + "  const char* " + nm + " = \"\";\n";
                } else {
                    pre = pre + "  int64_t " + nm + " = 0;\n";
                }
            }
        }
        li = li + 1;
    }
    return [pre + bl[0]];
}

fn lower_program(src: str) -> str {
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "("); i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                params = push(params, pn[0]);
                i = skip_type_annot(src, pn[1]);
                i = skip(src, i);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
    }

    let out: str = runtime_c();
    // prototypes
    let fi: i64 = 0;
    while fi < len(fnames) {
        if fnames[fi] != "main" {
            out = out + "static int64_t fn_" + fnames[fi] + "(";
            let pj: i64 = 0;
            while pj < len(fparams[fi]) {
                if pj > 0 { out = out + ", "; }
                out = out + "int64_t " + fparams[fi][pj];
                pj = pj + 1;
            }
            out = out + ");\n";
        }
        fi = fi + 1;
    }
    out = out + "\n";

    fi = 0;
    while fi < len(fnames) {
        if fnames[fi] == "main" {
            let body = lower_fn_body(fbodies[fi], fparams[fi]);
            out = out + "int main(void) {\n" + body[0] + "  return 0;\n}\n\n";
        } else {
            out = out + "static int64_t fn_" + fnames[fi] + "(";
            let pj: i64 = 0;
            while pj < len(fparams[fi]) {
                if pj > 0 { out = out + ", "; }
                out = out + "int64_t " + fparams[fi][pj];
                pj = pj + 1;
            }
            out = out + ") {\n";
            let body = lower_fn_body(fbodies[fi], fparams[fi]);
            out = out + body[0] + "  return 0;\n}\n\n";
        }
        fi = fi + 1;
    }
    return out;
}

fn main() -> i64 {
    let fact: str = "fn main() -> i64 { let n = 1; let i = 1; while i <= 6 { n = n * i; i = i + 1; } println(n); assert(n == 720); return 0; }";
    assert(write_file("bootstrap/bin/lower_fact.c", lower_program(fact)) == true);

    let brk: str = "fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } println(acc); assert(acc == 3); return 0; }";
    assert(write_file("bootstrap/bin/lower_for.c", lower_program(brk)) == true);

    let iff: str = "fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } println(label); assert(label == 30); return 0; }";
    assert(write_file("bootstrap/bin/lower_if.c", lower_program(iff)) == true);

    let multi: str = "fn add(a: i64, b: i64) -> i64 { return a + b; } fn main() -> i64 { let x = add(20, 22); println(x); assert(x == 42); return 0; }";
    assert(write_file("bootstrap/bin/lower_fn.c", lower_program(multi)) == true);

    let lists: str = "fn main() { let xs = [1, 2, 3, 4]; xs[0] = 10; let s = 0; let i = 0; while i < len(xs) { s = s + xs[i]; i = i + 1; } println(s); assert(s == 19); return 0; }";
    assert(write_file("bootstrap/bin/lower_list.c", lower_program(lists)) == true);

    let hello: str = "fn main() { println(\"hello\"); return 0; }";
    assert(write_file("bootstrap/bin/lower_str.c", lower_program(hello)) == true);

    println("wrote bootstrap/bin/lower_{fact,for,if,fn,list,str}.c");
    println("lower_c ok");
    return 0;
}
