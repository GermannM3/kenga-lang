// Emit kenga-lite CLI (main) from Kenga. Host includes the generated file.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_cli.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_cli.kenga — do not hand-edit */\n";
    s = s + "int main(int argc, char **argv) {\n";
    s = s + "  if (argc == 1) return selftest();\n";
    s = s + "  if (argc >= 3 && strcmp(argv[1], \"run\") == 0) {\n";
    s = s + "    char *src;\n";
    s = s + "    int64_t r;\n";
    s = s + "    const char *file = argv[2];\n";
    s = s + "    const char *more;\n";
    s = s + "    if (!is_host_kenga(file) && (more = find_more_path()) != NULL) {\n";
    s = s + "      static char *abuf[64];\n";
    s = s + "      int n = 0;\n";
    s = s + "      int i;\n";
    s = s + "      abuf[n++] = (char *)more;\n";
    s = s + "      abuf[n++] = (char *)file;\n";
    s = s + "      for (i = 3; i < argc && n < 63; i++) abuf[n++] = argv[i];\n";
    s = s + "      g_kargc = n;\n";
    s = s + "      g_kargv = abuf;\n";
    s = s + "      src = load_with_imports(more, 0);\n";
    s = s + "    } else {\n";
    s = s + "      g_kargc = argc - 2;\n";
    s = s + "      g_kargv = argv + 2;\n";
    s = s + "      src = load_with_imports(file, 0);\n";
    s = s + "    }\n";
    s = s + "    r = run_lite(src);\n";
    s = s + "    free(src);\n";
    s = s + "    if (r != 0) return (int)r;\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  if (argc >= 3 && strcmp(argv[1], \"eval\") == 0) {\n";
    s = s + "    int64_t r;\n";
    s = s + "    g_kargc = 0;\n";
    s = s + "    g_kargv = NULL;\n";
    s = s + "    r = run_lite(argv[2]);\n";
    s = s + "    printf(\"%lld\\n\", (long long)r);\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  if (argc >= 2 && strcmp(argv[1], \"chat\") == 0) {\n";
    s = s + "    const char *mind = \"minds/agent.km\";\n";
    s = s + "    const char *script_path = NULL;\n";
    s = s + "    char *script = NULL;\n";
    s = s + "    int i, rc;\n";
    s = s + "    for (i = 2; i < argc; i++) {\n";
    s = s + "      if (strcmp(argv[i], \"--script\") == 0 && i + 1 < argc) {\n";
    s = s + "        script_path = argv[++i];\n";
    s = s + "      } else if (strstr(argv[i], \".km\")) {\n";
    s = s + "        mind = argv[i];\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    if (script_path) {\n";
    s = s + "      script = pl_read_file(script_path, NULL);\n";
    s = s + "      if (!script) {\n";
    s = s + "        fprintf(stderr, \"cannot read script %s\\n\", script_path);\n";
    s = s + "        return 1;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    rc = run_chat_lite(mind, script);\n";
    s = s + "    free(script);\n";
    s = s + "    return rc;\n";
    s = s + "  }\n";
    s = s + "  fprintf(stderr,\n";
    s = s + "          \"usage:\\n  kenga-lite\\n  kenga-lite run <file.kenga>\\n  kenga-lite \"\n";
    s = s + "          \"eval '<src>'\\n  kenga-lite chat [mind.km] [--script file]\\n\");\n";
    s = s + "  return 2;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_cli.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_cli.inc.c");
    println("rt_cli ok");
    return 0;
}
