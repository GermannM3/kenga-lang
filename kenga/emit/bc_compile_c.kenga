// Mini compiler: while/i64 subset → bytecode → C VM driver (no Rust).
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\bc_compile_c.kenga

fn OP_CONST() -> i64 { return 1; }
fn OP_LOAD() -> i64 { return 2; }
fn OP_STORE() -> i64 { return 3; }
fn OP_ADD() -> i64 { return 4; }
fn OP_LT() -> i64 { return 8; }
fn OP_JMP() -> i64 { return 11; }
fn OP_JMPF() -> i64 { return 12; }
fn OP_HALT() -> i64 { return 13; }
fn OP_PRINTLN() -> i64 { return 17; }

fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let s: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        s = digs[d] + s;
        x = x / 10;
    }
    if n < 0 { return "-" + s; }
    return s;
}

fn emit_code(code: list) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < len(code) {
        if i > 0 { s = s + ", "; }
        s = s + itoa(code[i]);
        i = i + 1;
    }
    return s;
}

fn compile_sum() -> list {
    // let n=0; let i=1; while i<=5 { n=n+i; i=i+1; } println(n);
    // slots: 0=n, 1=i
    let code: list = [];
    // n = 0
    code = push(code, OP_CONST()); code = push(code, 0);
    code = push(code, OP_STORE()); code = push(code, 0);
    // i = 1
    code = push(code, OP_CONST()); code = push(code, 1);
    code = push(code, OP_STORE()); code = push(code, 1);
    // loop:
    let loop_ip: i64 = len(code);
    // i <= 5  →  i < 6
    code = push(code, OP_LOAD()); code = push(code, 1);
    code = push(code, OP_CONST()); code = push(code, 6);
    code = push(code, OP_LT());
    let jmpf_at: i64 = len(code);
    code = push(code, OP_JMPF()); code = push(code, 0); // patch
    // n = n + i
    code = push(code, OP_LOAD()); code = push(code, 0);
    code = push(code, OP_LOAD()); code = push(code, 1);
    code = push(code, OP_ADD());
    code = push(code, OP_STORE()); code = push(code, 0);
    // i = i + 1
    code = push(code, OP_LOAD()); code = push(code, 1);
    code = push(code, OP_CONST()); code = push(code, 1);
    code = push(code, OP_ADD());
    code = push(code, OP_STORE()); code = push(code, 1);
    // jmp loop
    code = push(code, OP_JMP()); code = push(code, loop_ip);
    let after: i64 = len(code);
    code[jmpf_at + 1] = after;
    // println(n)
    code = push(code, OP_LOAD()); code = push(code, 0);
    code = push(code, OP_PRINTLN());
    code = push(code, OP_HALT());
    return code;
}

fn main() -> i64 {
    let code = compile_sum();
    assert(len(code) > 10);

    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/bc_compile_c.kenga — while-sum bytecode */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n";
    s = s + "#include \"opcodes.inc.c\"\n\n";
    s = s + "static int64_t vm_run(const int64_t *code, int64_t n) {\n";
    s = s + "  int64_t stack[256]; int sp = 0; int64_t slots[16]; int64_t ip = 0; int i;\n";
    s = s + "  for (i = 0; i < 16; i++) slots[i] = 0;\n";
    s = s + "  while (ip < n) {\n";
    s = s + "    int64_t op = code[ip++];\n";
    s = s + "    if (op == OP_CONST) { stack[sp++] = code[ip++]; }\n";
    s = s + "    else if (op == OP_LOAD) { stack[sp++] = slots[code[ip++]]; }\n";
    s = s + "    else if (op == OP_STORE) { slots[code[ip++]] = stack[--sp]; }\n";
    s = s + "    else if (op == OP_ADD) { int64_t b=stack[--sp]; int64_t a=stack[--sp]; stack[sp++]=a+b; }\n";
    s = s + "    else if (op == OP_LT) { int64_t b=stack[--sp]; int64_t a=stack[--sp]; stack[sp++]= a<b; }\n";
    s = s + "    else if (op == OP_JMP) { ip = code[ip]; }\n";
    s = s + "    else if (op == OP_JMPF) { int64_t t=code[ip++]; int64_t c=stack[--sp]; if (!c) ip = t; }\n";
    s = s + "    else if (op == OP_PRINTLN) { printf(\"%lld\\n\", (long long)stack[--sp]); }\n";
    s = s + "    else if (op == OP_HALT) { return 0; }\n";
    s = s + "    else { fprintf(stderr, \"bad op %lld\\n\", (long long)op); exit(1); }\n";
    s = s + "  }\n";
    s = s + "  return 0;\n}\n\n";
    s = s + "int main(void) {\n";
    s = s + "  static const int64_t code[] = { " + emit_code(code) + " };\n";
    s = s + "  vm_run(code, (int64_t)(sizeof(code)/sizeof(code[0])));\n";
    s = s + "  return 0;\n}\n";

    assert(write_file("bootstrap/generated/bc_while_sum.c", s) == true);
    println("wrote bootstrap/generated/bc_while_sum.c");
    println("bc_compile ok");
    return 0;
}
