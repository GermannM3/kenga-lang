// Emit die / xrealloc / xstrdup for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_mem.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_mem.kenga — do not hand-edit */\n";
    s = s + "static void die(const char *msg) {\n";
    s = s + "  fprintf(stderr, \"kenga-lite: %s\\n\", msg);\n";
    s = s + "  exit(1);\n";
    s = s + "}\n\n";
    s = s + "static void *xrealloc(void *p, size_t n) {\n";
    s = s + "  void *q = realloc(p, n);\n";
    s = s + "  if (!q) die(\"oom\");\n";
    s = s + "  return q;\n";
    s = s + "}\n\n";
    s = s + "static char *xstrdup(const char *s) {\n";
    s = s + "  size_t n = strlen(s) + 1;\n";
    s = s + "  char *d = (char *)malloc(n);\n";
    s = s + "  if (!d) die(\"oom\");\n";
    s = s + "  memcpy(d, s, n);\n";
    s = s + "  return d;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_mem.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_mem.inc.c");
    println("rt_mem ok");
    return 0;
}
