// Emit the event bus for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_events.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_events.kenga — do not hand-edit */\n";
    s = s + "/* Event bus for kenga-lite: on/listen/emit/pump/pending — no Rust. */\n";
    s = s + "#ifndef KENGA_EVENTS_LITE_INC\n";
    s = s + "#define KENGA_EVENTS_LITE_INC\n";
    s = s + "\n";
    s = s + "#define EV_LISTEN_MAX 64\n";
    s = s + "#define EV_QUEUE_MAX 256\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *event;\n";
    s = s + "  int64_t addr;\n";
    s = s + "  int arity;\n";
    s = s + "} EvHandler;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *event;\n";
    s = s + "  Value val;\n";
    s = s + "} EvItem;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  EvHandler handlers[EV_LISTEN_MAX];\n";
    s = s + "  int nhandlers;\n";
    s = s + "  EvItem queue[EV_QUEUE_MAX];\n";
    s = s + "  int qh, qt, qn;\n";
    s = s + "} EvBus;\n";
    s = s + "\n";
    s = s + "static EvBus g_ev;\n";
    s = s + "#define EV_TIMER_MAX 64\n";
    s = s + "typedef struct {\n";
    s = s + "  int used;\n";
    s = s + "  int64_t due;\n";
    s = s + "  char *event;\n";
    s = s + "  Value val;\n";
    s = s + "} EvTimer;\n";
    s = s + "static EvTimer g_tm[EV_TIMER_MAX];\n";
    s = s + "static void ev_emit(const char *event, Value val);\n";
    s = s + "\n";
    s = s + "static int64_t ev_now_ms(void) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "  return (int64_t)GetTickCount64();\n";
    s = s + "#else\n";
    s = s + "  struct timeval tv;\n";
    s = s + "  gettimeofday(&tv, 0);\n";
    s = s + "  return (int64_t)tv.tv_sec * 1000 + (int64_t)tv.tv_usec / 1000;\n";
    s = s + "#endif\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_timers_clear(void) {\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < EV_TIMER_MAX; i++) {\n";
    s = s + "    if (g_tm[i].used) free(g_tm[i].event);\n";
    s = s + "    g_tm[i].used = 0;\n";
    s = s + "    g_tm[i].event = NULL;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_reset(void) {\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < g_ev.nhandlers; i++) free(g_ev.handlers[i].event);\n";
    s = s + "  for (i = 0; i < g_ev.qn; i++) {\n";
    s = s + "    int idx = (g_ev.qh + i) % EV_QUEUE_MAX;\n";
    s = s + "    free(g_ev.queue[idx].event);\n";
    s = s + "  }\n";
    s = s + "  memset(&g_ev, 0, sizeof(g_ev));\n";
    s = s + "  ev_timers_clear();\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_after(int64_t ms, const char *event, Value val) {\n";
    s = s + "  int i;\n";
    s = s + "  int64_t due;\n";
    s = s + "  if (ms < 0) ms = 0;\n";
    s = s + "  due = ev_now_ms() + ms;\n";
    s = s + "  for (i = 0; i < EV_TIMER_MAX; i++) {\n";
    s = s + "    if (!g_tm[i].used) {\n";
    s = s + "      g_tm[i].used = 1;\n";
    s = s + "      g_tm[i].due = due;\n";
    s = s + "      g_tm[i].event = xstrdup(event);\n";
    s = s + "      g_tm[i].val = val;\n";
    s = s + "      return;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  die(\"too many after_ms timers\");\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int ev_take_due(char **event_out, Value *val_out) {\n";
    s = s + "  int i;\n";
    s = s + "  int64_t now = ev_now_ms();\n";
    s = s + "  for (i = 0; i < EV_TIMER_MAX; i++) {\n";
    s = s + "    if (g_tm[i].used && g_tm[i].due <= now) {\n";
    s = s + "      *event_out = g_tm[i].event;\n";
    s = s + "      *val_out = g_tm[i].val;\n";
    s = s + "      g_tm[i].used = 0;\n";
    s = s + "      g_tm[i].event = NULL;\n";
    s = s + "      return 1;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_flush_due_bus(void) {\n";
    s = s + "  char *en;\n";
    s = s + "  Value v;\n";
    s = s + "  while (ev_take_due(&en, &v)) {\n";
    s = s + "    ev_emit(en, v);\n";
    s = s + "    free(en);\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ev_timer_n(void) {\n";
    s = s + "  int i, n = 0;\n";
    s = s + "  for (i = 0; i < EV_TIMER_MAX; i++) if (g_tm[i].used) n++;\n";
    s = s + "  return (int64_t)n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_listen(const char *event, int64_t addr, int arity) {\n";
    s = s + "  int i;\n";
    s = s + "  if (arity > 1) die(\"event handler arity must be 0 or 1\");\n";
    s = s + "  for (i = 0; i < g_ev.nhandlers; i++) {\n";
    s = s + "    if (strcmp(g_ev.handlers[i].event, event) == 0) {\n";
    s = s + "      g_ev.handlers[i].addr = addr;\n";
    s = s + "      g_ev.handlers[i].arity = arity;\n";
    s = s + "      return;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (g_ev.nhandlers >= EV_LISTEN_MAX) die(\"too many listeners\");\n";
    s = s + "  g_ev.handlers[g_ev.nhandlers].event = xstrdup(event);\n";
    s = s + "  g_ev.handlers[g_ev.nhandlers].addr = addr;\n";
    s = s + "  g_ev.handlers[g_ev.nhandlers].arity = arity;\n";
    s = s + "  g_ev.nhandlers++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static EvHandler *ev_find(const char *event) {\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < g_ev.nhandlers; i++)\n";
    s = s + "    if (strcmp(g_ev.handlers[i].event, event) == 0) return &g_ev.handlers[i];\n";
    s = s + "  return NULL;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void ev_emit(const char *event, Value val) {\n";
    s = s + "  int idx;\n";
    s = s + "  if (g_ev.qn >= EV_QUEUE_MAX) die(\"event queue full\");\n";
    s = s + "  idx = g_ev.qt;\n";
    s = s + "  g_ev.queue[idx].event = xstrdup(event);\n";
    s = s + "  g_ev.queue[idx].val = val;\n";
    s = s + "  g_ev.qt = (g_ev.qt + 1) % EV_QUEUE_MAX;\n";
    s = s + "  g_ev.qn++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int ev_dequeue(char **event_out, Value *val_out) {\n";
    s = s + "  int idx;\n";
    s = s + "  if (g_ev.qn < 1) return 0;\n";
    s = s + "  idx = g_ev.qh;\n";
    s = s + "  *event_out = g_ev.queue[idx].event;\n";
    s = s + "  *val_out = g_ev.queue[idx].val;\n";
    s = s + "  g_ev.queue[idx].event = NULL;\n";
    s = s + "  g_ev.qh = (g_ev.qh + 1) % EV_QUEUE_MAX;\n";
    s = s + "  g_ev.qn--;\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t ev_pending(void) { return (int64_t)g_ev.qn + ev_timer_n(); }\n";
    s = s + "\n";
    s = s + "#endif /* KENGA_EVENTS_LITE_INC */\n";
    assert(write_file("bootstrap/generated/rt_events.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_events.inc.c");
    println("rt_events ok");
    return 0;
}
