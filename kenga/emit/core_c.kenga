// Core codegen: parse tiny Kenga fragments → C99 (no Rust).
// Covers: while, if/else, for-range, list sum.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\core_c.kenga
// (also: kenga/emit/mini_codegen.kenga stays as thin alias wrapper)

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 0 { break; }
        i = i + 1;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn parse_int(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    while i < len(s) {
        let c: i64 = ord(s[i]);
        if c < 48 { break; }
        if c > 57 { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return [v, i];
}
fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let out: str = "";
    let x: i64 = n;
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        out = digs[d] + out;
        x = x / 10;
    }
    return out;
}

fn c_header() -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/core_c.kenga — no Rust */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n\n";
    return s;
}

fn emit_while_fn(start: i64, limit: i64) -> str {
    let s: str = "";
    s = s + "static int test_while(void) {\n";
    s = s + "  int64_t x = " + itoa(start) + ";\n";
    s = s + "  while (x < " + itoa(limit) + ") { x = x + 1; }\n";
    s = s + "  if (x != " + itoa(limit) + ") return 1;\n";
    s = s + "  printf(\"while %lld\\n\", (long long)x);\n";
    s = s + "  return 0;\n}\n\n";
    return s;
}

fn emit_if_fn(n: i64, want: i64) -> str {
    // if n == 0 { 10 } else if n == 1 { 20 } else if n == 2 { 30 } else { 40 }
    let s: str = "";
    s = s + "static int test_if(void) {\n";
    s = s + "  int64_t n = " + itoa(n) + ";\n";
    s = s + "  int64_t label = 0;\n";
    s = s + "  if (n == 0) { label = 10; }\n";
    s = s + "  else if (n == 1) { label = 20; }\n";
    s = s + "  else if (n == 2) { label = 30; }\n";
    s = s + "  else { label = 40; }\n";
    s = s + "  if (label != " + itoa(want) + ") return 1;\n";
    s = s + "  printf(\"if %lld\\n\", (long long)label);\n";
    s = s + "  return 0;\n}\n\n";
    return s;
}

fn emit_for_fn(lo: i64, hi: i64, want: i64) -> str {
    // sum for i in lo..hi
    let s: str = "";
    s = s + "static int test_for(void) {\n";
    s = s + "  int64_t acc = 0;\n";
    s = s + "  int64_t i;\n";
    s = s + "  for (i = " + itoa(lo) + "; i < " + itoa(hi) + "; i = i + 1) {\n";
    s = s + "    if (i == 3) { break; }\n";
    s = s + "    acc = acc + i;\n";
    s = s + "  }\n";
    s = s + "  if (acc != " + itoa(want) + ") return 1;\n";
    s = s + "  printf(\"for %lld\\n\", (long long)acc);\n";
    s = s + "  return 0;\n}\n\n";
    return s;
}

fn emit_list_fn(a: i64, b: i64, c: i64, d: i64, want: i64) -> str {
    let s: str = "";
    s = s + "static int test_list(void) {\n";
    s = s + "  int64_t xs[4];\n";
    s = s + "  xs[0] = " + itoa(a) + "; xs[1] = " + itoa(b) + ";\n";
    s = s + "  xs[2] = " + itoa(c) + "; xs[3] = " + itoa(d) + ";\n";
    s = s + "  xs[0] = 10;\n";
    s = s + "  {\n";
    s = s + "    int64_t sum = 0; int64_t i;\n";
    s = s + "    for (i = 0; i < 4; i = i + 1) { sum = sum + xs[i]; }\n";
    s = s + "    if (sum != " + itoa(want) + ") return 1;\n";
    s = s + "    printf(\"list %lld\\n\", (long long)sum);\n";
    s = s + "  }\n";
    s = s + "  return 0;\n}\n\n";
    return s;
}

fn parse_while_prog(src: str) -> list {
    let i: i64 = skip(src, 0);
    assert(starts_with(src, i, "fn main()") == 1);
    i = skip(src, i + 9);
    assert(src[i] == "{"); i = i + 1;
    i = skip(src, i);
    assert(starts_with(src, i, "let x =") == 1);
    i = skip(src, i + 7);
    let a = parse_int(src, i); i = a[1];
    i = skip(src, i); if src[i] == ";" { i = i + 1; }
    i = skip(src, i);
    assert(starts_with(src, i, "while x <") == 1);
    i = skip(src, i + 9);
    let b = parse_int(src, i);
    return [a[0], b[0]];
}

fn parse_if_prog(src: str) -> list {
    // fn main() { let n = N; ... }  — extract N and expected from trailing comment want=W
    let i: i64 = skip(src, 0);
    assert(starts_with(src, i, "fn main()") == 1);
    i = skip(src, i + 9);
    assert(src[i] == "{"); i = i + 1;
    i = skip(src, i);
    assert(starts_with(src, i, "let n =") == 1);
    i = skip(src, i + 7);
    let n = parse_int(src, i);
    return [n[0]];
}

fn parse_for_prog(src: str) -> list {
    // for i in LO..HI with break at 3 — return [lo, hi]
    let i: i64 = skip(src, 0);
    assert(starts_with(src, i, "fn main()") == 1);
    i = skip(src, i + 9);
    assert(src[i] == "{"); i = i + 1;
    i = skip(src, i);
    assert(starts_with(src, i, "let acc =") == 1);
    i = skip(src, i + 9);
    let z = parse_int(src, i); i = z[1];
    i = skip(src, i); if src[i] == ";" { i = i + 1; }
    i = skip(src, i);
    assert(starts_with(src, i, "for i in ") == 1);
    i = skip(src, i + 9);
    let lo = parse_int(src, i); i = lo[1];
    assert(starts_with(src, i, "..") == 1);
    i = i + 2;
    let hi = parse_int(src, i);
    return [lo[0], hi[0]];
}

fn parse_list_prog(src: str) -> list {
    // let xs = [A, B, C, D];
    let i: i64 = skip(src, 0);
    assert(starts_with(src, i, "fn main()") == 1);
    i = skip(src, i + 9);
    assert(src[i] == "{"); i = i + 1;
    i = skip(src, i);
    assert(starts_with(src, i, "let xs = [") == 1);
    i = skip(src, i + 10);
    let a = parse_int(src, i); i = a[1];
    i = skip(src, i); assert(src[i] == ","); i = i + 1;
    let b = parse_int(src, i); i = b[1];
    i = skip(src, i); assert(src[i] == ","); i = i + 1;
    let c = parse_int(src, i); i = c[1];
    i = skip(src, i); assert(src[i] == ","); i = i + 1;
    let d = parse_int(src, i);
    return [a[0], b[0], c[0], d[0]];
}

fn expected_if(n: i64) -> i64 {
    if n == 0 { return 10; }
    if n == 1 { return 20; }
    if n == 2 { return 30; }
    return 40;
}

fn expected_for_break3(lo: i64, hi: i64) -> i64 {
    let acc: i64 = 0;
    let i: i64 = lo;
    while i < hi {
        if i == 3 { break; }
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn expected_list(a: i64, b: i64, c: i64, d: i64) -> i64 {
    // xs[0] = 10 then sum
    return 10 + b + c + d;
}

fn main() -> i64 {
    let wsrc: str = "fn main() { let x = 0; while x < 5 { x = x + 1; } return x; }";
    let w = parse_while_prog(wsrc);
    assert(w[0] == 0); assert(w[1] == 5);

    let isrc: str = "fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } label }";
    let iv = parse_if_prog(isrc);
    assert(iv[0] == 2);
    let iwant: i64 = expected_if(iv[0]);
    assert(iwant == 30);

    let fsrc: str = "fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } acc }";
    let f = parse_for_prog(fsrc);
    assert(f[0] == 0); assert(f[1] == 5);
    let fwant: i64 = expected_for_break3(f[0], f[1]);
    assert(fwant == 3);

    let lsrc: str = "fn main() { let xs = [1, 2, 3, 4]; xs[0] = 10; }";
    let lv = parse_list_prog(lsrc);
    assert(lv[0] == 1); assert(lv[3] == 4);
    let lwant: i64 = expected_list(lv[0], lv[1], lv[2], lv[3]);
    assert(lwant == 19);

    let out: str = c_header();
    out = out + emit_while_fn(w[0], w[1]);
    out = out + emit_if_fn(iv[0], iwant);
    out = out + emit_for_fn(f[0], f[1], fwant);
    out = out + emit_list_fn(lv[0], lv[1], lv[2], lv[3], lwant);
    out = out + "int main(void) {\n";
    out = out + "  if (test_while()) return 1;\n";
    out = out + "  if (test_if()) return 1;\n";
    out = out + "  if (test_for()) return 1;\n";
    out = out + "  if (test_list()) return 1;\n";
    out = out + "  printf(\"core_c ok\\n\");\n";
    out = out + "  return 0;\n}\n";

    assert(write_file("bootstrap/bin/core_from_kenga.c", out) == true);
    let mini: str = c_header() + emit_while_fn(w[0], w[1]) + "int main(void){ return test_while(); }\n";
    assert(write_file("bootstrap/bin/mini_from_kenga.c", mini) == true);
    assert(len(read_file("bootstrap/bin/core_from_kenga.c")) > 200);
    println("wrote bootstrap/bin/core_from_kenga.c");
    println("core_c ok");
    return 0;
}
