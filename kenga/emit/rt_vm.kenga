// Emit the bytecode VM for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_vm.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_vm.kenga — do not hand-edit */\n";
    s = s + "static char *k_to_str(Value v, StrA *strs, ListHeap *lists) {\n";
    s = s + "  char buf[64];\n";
    s = s + "  if (v.tag == TAG_I64) {\n";
    s = s + "    snprintf(buf, sizeof(buf), \"%lld\", (long long)v.payload);\n";
    s = s + "    return xstrdup(buf);\n";
    s = s + "  }\n";
    s = s + "  if (v.tag == TAG_F64) {\n";
    s = s + "    snprintf(buf, sizeof(buf), \"%g\", f64_bits(v));\n";
    s = s + "    return xstrdup(buf);\n";
    s = s + "  }\n";
    s = s + "  if (v.tag == TAG_STR) {\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= strs->len) die(\"bad str\");\n";
    s = s + "    return xstrdup(strs->data[v.payload]);\n";
    s = s + "  }\n";
    s = s + "  if (v.tag == TAG_LIST) {\n";
    s = s + "    ValA *L;\n";
    s = s + "    char *out;\n";
    s = s + "    size_t cap, len, i;\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= lists->len) die(\"bad list handle\");\n";
    s = s + "    L = &lists->data[v.payload];\n";
    s = s + "    cap = 32;\n";
    s = s + "    len = 0;\n";
    s = s + "    out = (char *)malloc(cap);\n";
    s = s + "    if (!out) die(\"oom\");\n";
    s = s + "    out[len++] = '[';\n";
    s = s + "    for (i = 0; i < L->len; i++) {\n";
    s = s + "      char *part = k_to_str(L->data[i], strs, lists);\n";
    s = s + "      size_t pl = strlen(part);\n";
    s = s + "      size_t need = len + pl + 4;\n";
    s = s + "      if (need > cap) {\n";
    s = s + "        while (need > cap) cap *= 2;\n";
    s = s + "        out = (char *)xrealloc(out, cap);\n";
    s = s + "      }\n";
    s = s + "      if (i) {\n";
    s = s + "        out[len++] = ',';\n";
    s = s + "        out[len++] = ' ';\n";
    s = s + "      }\n";
    s = s + "      memcpy(out + len, part, pl);\n";
    s = s + "      len += pl;\n";
    s = s + "      free(part);\n";
    s = s + "    }\n";
    s = s + "    if (len + 2 > cap) out = (char *)xrealloc(out, len + 2);\n";
    s = s + "    out[len++] = ']';\n";
    s = s + "    out[len] = 0;\n";
    s = s + "    return out;\n";
    s = s + "  }\n";
    s = s + "  return xstrdup(\"?\");\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t vm_exec(Program *prog) {\n";
    s = s + "  ValA stack = {0};\n";
    s = s + "  ValA slots = {0};\n";
    s = s + "  I64A ret_ips = {0};\n";
    s = s + "  I64A slot_bases = {0};\n";
    s = s + "  I64A stack_bases = {0};\n";
    s = s + "  ListHeap lists = {0};\n";
    s = s + "  StructHeap structs = {0};\n";
    s = s + "  size_t ip = 0;\n";
    s = s + "  int64_t slot_base = 0;\n";
    s = s + "  int64_t pump_left = 0, pump_done = 0;\n";
    s = s + "  size_t pump_ret_ip = 0;\n";
    s = s + "  I64A *code = &prog->code;\n";
    s = s + "  StrA *strs = &prog->strs;\n";
    s = s + "  size_t bi;\n";
    s = s + "  g_strtab = strs;\n";
    s = s + "  ev_reset();\n";
    s = s + "  for (bi = 0; bi < prog->nbinds; bi++)\n";
    s = s + "    ev_listen(prog->binds[bi].event, prog->binds[bi].fn_index, prog->binds[bi].arity);\n";
    s = s + "\n";
    s = s + "  while (ip < code->len) {\n";
    s = s + "    int64_t op = code->data[ip++];\n";
    s = s + "    if (op == OP_HALT) {\n";
    s = s + "      int64_t r = 0;\n";
    s = s + "      if (stack.len) {\n";
    s = s + "        Value top = stack.data[stack.len - 1];\n";
    s = s + "        if (top.tag != TAG_I64) die(\"main must return i64\");\n";
    s = s + "        r = top.payload;\n";
    s = s + "      }\n";
    s = s + "      vala_free(&stack);\n";
    s = s + "      vala_free(&slots);\n";
    s = s + "      i64a_free(&ret_ips);\n";
    s = s + "      i64a_free(&slot_bases);\n";
    s = s + "      i64a_free(&stack_bases);\n";
    s = s + "      listh_free(&lists);\n";
    s = s + "      structh_free(&structs);\n";
    s = s + "      pl_mems_reset();\n";
    s = s + "      tl_tensors_reset();\n";
    s = s + "      ag_clear();\n";
    s = s + "      ev_reset();\n";
    s = s + "      return r;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_CONST) {\n";
    s = s + "      vala_push(&stack, V_i64(code->data[ip++]));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_CONST_F64) {\n";
    s = s + "      int64_t bits = code->data[ip++];\n";
    s = s + "      double d;\n";
    s = s + "      memcpy(&d, &bits, sizeof(double));\n";
    s = s + "      vala_push(&stack, V_f64(d));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_CONST_STR) {\n";
    s = s + "      vala_push(&stack, V_str(code->data[ip++]));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LOAD) {\n";
    s = s + "      int64_t si = slot_base + code->data[ip++];\n";
    s = s + "      ensure_slot(&slots, si);\n";
    s = s + "      vala_push(&stack, slots.data[si]);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_STORE) {\n";
    s = s + "      int64_t si = slot_base + code->data[ip++];\n";
    s = s + "      ensure_slot(&slots, si);\n";
    s = s + "      if (!stack.len) die(\"stack underflow STORE\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      slots.data[si] = v;\n";
    s = s + "      vala_push(&stack, v);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_PRINTLN) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow PRINTLN\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      print_value(v, strs, &lists, &structs, prog->stypes, prog->nstypes);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LIST_NEW) {\n";
    s = s + "      ValA empty = {0};\n";
    s = s + "      int64_t h = (int64_t)lists.len;\n";
    s = s + "      listh_push(&lists, empty);\n";
    s = s + "      vala_push(&stack, V_list(h));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LIST_PUSH) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow LIST_PUSH\");\n";
    s = s + "      Value vv = stack.data[--stack.len];\n";
    s = s + "      Value lv = stack.data[--stack.len];\n";
    s = s + "      if (lv.tag != TAG_LIST) die(\"push: not a list\");\n";
    s = s + "      if (lv.payload < 0 || (size_t)lv.payload >= lists.len) die(\"bad list handle\");\n";
    s = s + "      vala_push(&lists.data[lv.payload], vv);\n";
    s = s + "      vala_push(&stack, lv);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LEN) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow LEN\");\n";
    s = s + "      Value lv = stack.data[--stack.len];\n";
    s = s + "      if (lv.tag == TAG_LIST) {\n";
    s = s + "        if (lv.payload < 0 || (size_t)lv.payload >= lists.len) die(\"bad list handle\");\n";
    s = s + "        vala_push(&stack, V_i64((int64_t)lists.data[lv.payload].len));\n";
    s = s + "      } else if (lv.tag == TAG_STR) {\n";
    s = s + "        if (lv.payload < 0 || (size_t)lv.payload >= strs->len) die(\"bad str handle\");\n";
    s = s + "        vala_push(&stack, V_i64((int64_t)strlen(strs->data[lv.payload])));\n";
    s = s + "      } else {\n";
    s = s + "        die(\"len: not a list/str\");\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_GET) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow GET\");\n";
    s = s + "      Value iv = stack.data[--stack.len];\n";
    s = s + "      Value lv = stack.data[--stack.len];\n";
    s = s + "      int64_t idx = as_i64(iv, \"index must be i64\");\n";
    s = s + "      if (lv.tag == TAG_LIST) {\n";
    s = s + "        if (lv.payload < 0 || (size_t)lv.payload >= lists.len) die(\"bad list handle\");\n";
    s = s + "        ValA *L = &lists.data[lv.payload];\n";
    s = s + "        if (idx < 0 || (size_t)idx >= L->len) die(\"index out of bounds\");\n";
    s = s + "        vala_push(&stack, L->data[idx]);\n";
    s = s + "      } else if (lv.tag == TAG_STR) {\n";
    s = s + "        if (lv.payload < 0 || (size_t)lv.payload >= strs->len) die(\"bad str handle\");\n";
    s = s + "        const char *s = strs->data[lv.payload];\n";
    s = s + "        size_t n = strlen(s);\n";
    s = s + "        if (idx < 0 || (size_t)idx >= n) die(\"str index out of bounds\");\n";
    s = s + "        char buf[2] = {s[idx], 0};\n";
    s = s + "        int h = intern_str(buf);\n";
    s = s + "        vala_push(&stack, V_str(h));\n";
    s = s + "      } else {\n";
    s = s + "        die(\"index: not a list/str\");\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SET) {\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow SET\");\n";
    s = s + "      Value vv = stack.data[--stack.len];\n";
    s = s + "      Value iv = stack.data[--stack.len];\n";
    s = s + "      Value lv = stack.data[--stack.len];\n";
    s = s + "      int64_t idx = as_i64(iv, \"index must be i64\");\n";
    s = s + "      if (lv.tag != TAG_LIST) die(\"index assign: not a list\");\n";
    s = s + "      if (lv.payload < 0 || (size_t)lv.payload >= lists.len) die(\"bad list handle\");\n";
    s = s + "      ValA *L = &lists.data[lv.payload];\n";
    s = s + "      if (idx < 0 || (size_t)idx >= L->len) die(\"index out of bounds\");\n";
    s = s + "      L->data[idx] = vv;\n";
    s = s + "      vala_push(&stack, vv);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_ORD) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow ORD\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      if (v.tag != TAG_STR) die(\"ord expects str\");\n";
    s = s + "      if (v.payload < 0 || (size_t)v.payload >= strs->len) die(\"bad str handle\");\n";
    s = s + "      const char *s = strs->data[v.payload];\n";
    s = s + "      vala_push(&stack, V_i64(s[0] ? (unsigned char)s[0] : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_CONFIG) {\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow memory_config\");\n";
    s = s + "      Value vc = stack.data[--stack.len];\n";
    s = s + "      Value ve = stack.data[--stack.len];\n";
    s = s + "      Value vt = stack.data[--stack.len];\n";
    s = s + "      int64_t core_cap = as_i64(vc, \"memory_config\");\n";
    s = s + "      int64_t ep_cap = as_i64(ve, \"memory_config\");\n";
    s = s + "      double thr = to_f64(vt, \"memory_config\");\n";
    s = s + "      if (vt.tag == TAG_I64) thr = (double)vt.payload / 100.0;\n";
    s = s + "      vala_push(&stack, V_mem(pl_mem_new(thr, (int)ep_cap, (int)core_cap)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_REMEMBER) {\n";
    s = s + "      double pat[PL_DIM_MAX];\n";
    s = s + "      int pn = 0;\n";
    s = s + "      double surprise;\n";
    s = s + "      Value vs, vo, vm;\n";
    s = s + "      ProphetMem *m;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow remember\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      vo = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"remember expects Memory\");\n";
    s = s + "      surprise = to_f64(vs, \"remember surprise\");\n";
    s = s + "      if (vs.tag == TAG_I64) surprise = (double)vs.payload / 100.0;\n";
    s = s + "      pl_value_to_pat(vo, &lists, pat, &pn);\n";
    s = s + "      m = pl_get(vm.payload);\n";
    s = s + "      vala_push(&stack, V_i64(pl_remember(m, pat, pn, surprise) ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_SURPRISE) {\n";
    s = s + "      double a[PL_DIM_MAX], b[PL_DIM_MAX];\n";
    s = s + "      int an = 0, bn = 0;\n";
    s = s + "      Value vb, va;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow surprise\");\n";
    s = s + "      vb = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      pl_value_to_pat(va, &lists, a, &an);\n";
    s = s + "      pl_value_to_pat(vb, &lists, b, &bn);\n";
    s = s + "      vala_push(&stack, V_f64(pl_surprise(a, an, b, bn)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_FORESEE) {\n";
    s = s + "      double pat[PL_DIM_MAX], out[PL_DIM_MAX];\n";
    s = s + "      int pn = 0, on = 0;\n";
    s = s + "      Value vo, vm;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow foresee\");\n";
    s = s + "      vo = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"foresee expects Memory\");\n";
    s = s + "      pl_value_to_pat(vo, &lists, pat, &pn);\n";
    s = s + "      pl_foresee(pl_get(vm.payload), pat, pn, out, &on);\n";
    s = s + "      vala_push(&stack, pl_pat_to_list(out, on, &lists));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_CONSOLIDATE) {\n";
    s = s + "      Value vm;\n";
    s = s + "      if (!stack.len) die(\"stack underflow consolidate\");\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"consolidate expects Memory\");\n";
    s = s + "      vala_push(&stack, V_i64(pl_consolidate(pl_get(vm.payload))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_STATS) {\n";
    s = s + "      Value vm;\n";
    s = s + "      if (!stack.len) die(\"stack underflow mem_stats\");\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"mem_stats expects Memory\");\n";
    s = s + "      vala_push(&stack, pl_stats(pl_get(vm.payload), &lists));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MEM_RECALL) {\n";
    s = s + "      double pat[PL_DIM_MAX];\n";
    s = s + "      int pn = 0;\n";
    s = s + "      Value vk, vq, vm;\n";
    s = s + "      int64_t k;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow recall\");\n";
    s = s + "      vk = stack.data[--stack.len];\n";
    s = s + "      vq = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"recall expects Memory\");\n";
    s = s + "      k = as_i64(vk, \"recall k\");\n";
    s = s + "      pl_value_to_pat(vq, &lists, pat, &pn);\n";
    s = s + "      vala_push(&stack, pl_recall(pl_get(vm.payload), pat, pn, (int)k, &lists));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SAVE_MIND) {\n";
    s = s + "      Value vp, vm;\n";
    s = s + "      const char *path;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow save_mind\");\n";
    s = s + "      vp = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"save_mind expects Memory\");\n";
    s = s + "      if (vp.tag != TAG_STR) die(\"save_mind path must be str\");\n";
    s = s + "      if (vp.payload < 0 || (size_t)vp.payload >= strs->len) die(\"bad str\");\n";
    s = s + "      path = strs->data[vp.payload];\n";
    s = s + "      if (!pl_save_mind(pl_get(vm.payload), path)) die(\"save_mind failed\");\n";
    s = s + "      vala_push(&stack, V_i64(1));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LOAD_MIND) {\n";
    s = s + "      Value vp;\n";
    s = s + "      const char *path;\n";
    s = s + "      if (!stack.len) die(\"stack underflow load_mind\");\n";
    s = s + "      vp = stack.data[--stack.len];\n";
    s = s + "      if (vp.tag != TAG_STR) die(\"load_mind path must be str\");\n";
    s = s + "      if (vp.payload < 0 || (size_t)vp.payload >= strs->len) die(\"bad str\");\n";
    s = s + "      path = strs->data[vp.payload];\n";
    s = s + "      vala_push(&stack, V_mem(pl_load_mind(path)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_TENSOR) {\n";
    s = s + "      int argc = (int)code->data[ip++];\n";
    s = s + "      int shape[TL_RANK_MAX];\n";
    s = s + "      int i;\n";
    s = s + "      if (argc < 1 || argc > TL_RANK_MAX) die(\"bad tensor argc\");\n";
    s = s + "      if ((int)stack.len < argc) die(\"stack underflow tensor\");\n";
    s = s + "      for (i = 0; i < argc; i++) {\n";
    s = s + "        Value v = stack.data[--stack.len];\n";
    s = s + "        shape[i] = (int)as_i64(v, \"tensor dim\");\n";
    s = s + "      }\n";
    s = s + "      for (i = 0; i < argc / 2; i++) {\n";
    s = s + "        int tmp = shape[i];\n";
    s = s + "        shape[i] = shape[argc - 1 - i];\n";
    s = s + "        shape[argc - 1 - i] = tmp;\n";
    s = s + "      }\n";
    s = s + "      vala_push(&stack, V_tensor(tl_zeros(shape, argc)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_FROM) {\n";
    s = s + "      Value vd, vs;\n";
    s = s + "      int shape[TL_RANK_MAX], rank = 0, n;\n";
    s = s + "      double *buf;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_from\");\n";
    s = s + "      vd = stack.data[--stack.len];\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      tl_shape_from_list(vs, &lists, shape, &rank);\n";
    s = s + "      n = tl_product(shape, rank);\n";
    s = s + "      buf = n > 0 ? (double *)malloc((size_t)n * sizeof(double)) : NULL;\n";
    s = s + "      if (n > 0 && !buf) die(\"oom\");\n";
    s = s + "      if (n > 0) tl_data_from_list(vd, &lists, buf, n);\n";
    s = s + "      {\n";
    s = s + "        int64_t h = tl_alloc(shape, rank, 0);\n";
    s = s + "        if (n > 0) {\n";
    s = s + "          memcpy(tl_get(h)->data, buf, (size_t)n * sizeof(double));\n";
    s = s + "          free(buf);\n";
    s = s + "        }\n";
    s = s + "        vala_push(&stack, V_tensor(h));\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_FILL) {\n";
    s = s + "      Value vv, vt;\n";
    s = s + "      double x;\n";
    s = s + "      Tensor *t;\n";
    s = s + "      int i;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_fill\");\n";
    s = s + "      vv = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_fill expects Tensor\");\n";
    s = s + "      x = to_f64(vv, \"t_fill\");\n";
    s = s + "      t = tl_get(vt.payload);\n";
    s = s + "      for (i = 0; i < t->n; i++) t->data[i] = x;\n";
    s = s + "      vala_push(&stack, vt);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_GET) {\n";
    s = s + "      Value vi, vt;\n";
    s = s + "      int64_t idx;\n";
    s = s + "      Tensor *t;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_get\");\n";
    s = s + "      vi = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_get expects Tensor\");\n";
    s = s + "      idx = as_i64(vi, \"t_get index\");\n";
    s = s + "      t = tl_get(vt.payload);\n";
    s = s + "      if (idx < 0 || idx >= t->n) die(\"t_get out of range\");\n";
    s = s + "      vala_push(&stack, V_f64(t->data[idx]));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_SET) {\n";
    s = s + "      Value vv, vi, vt;\n";
    s = s + "      int64_t idx;\n";
    s = s + "      Tensor *t;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow t_set\");\n";
    s = s + "      vv = stack.data[--stack.len];\n";
    s = s + "      vi = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_set expects Tensor\");\n";
    s = s + "      idx = as_i64(vi, \"t_set index\");\n";
    s = s + "      t = tl_get(vt.payload);\n";
    s = s + "      if (idx < 0 || idx >= t->n) die(\"t_set out of range\");\n";
    s = s + "      t->data[idx] = to_f64(vv, \"t_set\");\n";
    s = s + "      vala_push(&stack, vt);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_SHAPE) {\n";
    s = s + "      Value vt;\n";
    s = s + "      if (!stack.len) die(\"stack underflow t_shape\");\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_shape expects Tensor\");\n";
    s = s + "      vala_push(&stack, tl_shape_to_list(tl_get(vt.payload), &lists));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_ADD || op == OP_T_SUB || op == OP_T_MUL || op == OP_T_MATMUL ||\n";
    s = s + "        op == OP_T_DOT) {\n";
    s = s + "      Value vb, va;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow tensor binary\");\n";
    s = s + "      vb = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      if (va.tag != TAG_TENSOR || vb.tag != TAG_TENSOR) die(\"tensor op expects Tensor\");\n";
    s = s + "      if (op == OP_T_ADD)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_ew(va.payload, vb.payload, tl_op_add)));\n";
    s = s + "      else if (op == OP_T_SUB)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_ew(va.payload, vb.payload, tl_op_sub)));\n";
    s = s + "      else if (op == OP_T_MUL)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_ew(va.payload, vb.payload, tl_op_mul)));\n";
    s = s + "      else if (op == OP_T_MATMUL)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_matmul(va.payload, vb.payload)));\n";
    s = s + "      else\n";
    s = s + "        vala_push(&stack, V_f64(tl_dot(va.payload, vb.payload)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_RESHAPE) {\n";
    s = s + "      Value vs, vt;\n";
    s = s + "      int shape[TL_RANK_MAX], rank = 0, n;\n";
    s = s + "      Tensor *t;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_reshape\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_reshape expects Tensor\");\n";
    s = s + "      t = tl_get(vt.payload);\n";
    s = s + "      tl_shape_from_list(vs, &lists, shape, &rank);\n";
    s = s + "      n = tl_product(shape, rank);\n";
    s = s + "      if (n != t->n) die(\"t_reshape size mismatch\");\n";
    s = s + "      {\n";
    s = s + "        int64_t h = tl_clone_shape_data(shape, rank, t->data, t->n);\n";
    s = s + "        vala_push(&stack, V_tensor(h));\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_SCALE) {\n";
    s = s + "      Value vs, vt;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_scale\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_scale expects Tensor\");\n";
    s = s + "      vala_push(&stack, V_tensor(tl_scale(vt.payload, to_f64(vs, \"t_scale\"))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_TRANSPOSE || op == OP_T_EXP || op == OP_T_SOFTMAX || op == OP_T_SUM ||\n";
    s = s + "        op == OP_T_LOG) {\n";
    s = s + "      Value vt;\n";
    s = s + "      if (!stack.len) die(\"stack underflow tensor unary\");\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"tensor unary expects Tensor\");\n";
    s = s + "      if (op == OP_T_TRANSPOSE)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_transpose(vt.payload)));\n";
    s = s + "      else if (op == OP_T_EXP)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_exp(vt.payload)));\n";
    s = s + "      else if (op == OP_T_SOFTMAX)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_softmax(vt.payload)));\n";
    s = s + "      else if (op == OP_T_LOG)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_log(vt.payload)));\n";
    s = s + "      else\n";
    s = s + "        vala_push(&stack, V_f64(tl_sum(vt.payload)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SWEEP) {\n";
    s = s + "      vala_push(&stack, V_i64(0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_NOW_MS) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "      vala_push(&stack, V_i64((int64_t)GetTickCount64()));\n";
    s = s + "#else\n";
    s = s + "      {\n";
    s = s + "        struct timeval tv;\n";
    s = s + "        gettimeofday(&tv, 0);\n";
    s = s + "        vala_push(&stack, V_i64((int64_t)tv.tv_sec * 1000 + (int64_t)tv.tv_usec / 1000));\n";
    s = s + "      }\n";
    s = s + "#endif\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LOAD_PPM || op == OP_LOAD_WAV || op == OP_LOAD_TENSOR || op == OP_READ_FILE) {\n";
    s = s + "      Value vp;\n";
    s = s + "      const char *path;\n";
    s = s + "      if (!stack.len) die(\"stack underflow load path\");\n";
    s = s + "      vp = stack.data[--stack.len];\n";
    s = s + "      if (vp.tag != TAG_STR) die(\"path must be str\");\n";
    s = s + "      if (vp.payload < 0 || (size_t)vp.payload >= strs->len) die(\"bad str\");\n";
    s = s + "      path = strs->data[vp.payload];\n";
    s = s + "      if (op == OP_LOAD_PPM)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_load_ppm(path)));\n";
    s = s + "      else if (op == OP_LOAD_WAV)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_load_wav(path)));\n";
    s = s + "      else if (op == OP_LOAD_TENSOR)\n";
    s = s + "        vala_push(&stack, V_tensor(tl_load_tensor(path)));\n";
    s = s + "      else {\n";
    s = s + "        FILE *f = fopen(path, \"rb\");\n";
    s = s + "        long sz;\n";
    s = s + "        char *buf;\n";
    s = s + "        size_t nread;\n";
    s = s + "        if (!f) die(\"read_file: cannot open\");\n";
    s = s + "        if (fseek(f, 0, SEEK_END) != 0) {\n";
    s = s + "          fclose(f);\n";
    s = s + "          die(\"read_file: seek\");\n";
    s = s + "        }\n";
    s = s + "        sz = ftell(f);\n";
    s = s + "        if (sz < 0) {\n";
    s = s + "          fclose(f);\n";
    s = s + "          die(\"read_file: tell\");\n";
    s = s + "        }\n";
    s = s + "        rewind(f);\n";
    s = s + "        buf = (char *)malloc((size_t)sz + 1);\n";
    s = s + "        if (!buf) {\n";
    s = s + "          fclose(f);\n";
    s = s + "          die(\"oom\");\n";
    s = s + "        }\n";
    s = s + "        nread = fread(buf, 1, (size_t)sz, f);\n";
    s = s + "        fclose(f);\n";
    s = s + "        buf[nread] = 0;\n";
    s = s + "        vala_push(&stack, V_str(intern_str(buf)));\n";
    s = s + "        free(buf);\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SAVE_TENSOR) {\n";
    s = s + "      Value vp, vt;\n";
    s = s + "      const char *path;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow save_tensor\");\n";
    s = s + "      vp = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"save_tensor expects Tensor\");\n";
    s = s + "      if (vp.tag != TAG_STR) die(\"save_tensor path must be str\");\n";
    s = s + "      path = strs->data[vp.payload];\n";
    s = s + "      if (!tl_save_tensor(vt.payload, path)) die(\"save_tensor failed\");\n";
    s = s + "      vala_push(&stack, V_i64(1));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_WRITE_FILE) {\n";
    s = s + "      Value vc, vp;\n";
    s = s + "      const char *path, *body;\n";
    s = s + "      FILE *f;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow write_file\");\n";
    s = s + "      vc = stack.data[--stack.len];\n";
    s = s + "      vp = stack.data[--stack.len];\n";
    s = s + "      if (vp.tag != TAG_STR || vc.tag != TAG_STR) die(\"write_file expects str, str\");\n";
    s = s + "      path = strs->data[vp.payload];\n";
    s = s + "      body = strs->data[vc.payload];\n";
    s = s + "      f = fopen(path, \"wb\");\n";
    s = s + "      if (!f) die(\"write_file: cannot open\");\n";
    s = s + "      fwrite(body, 1, strlen(body), f);\n";
    s = s + "      fclose(f);\n";
    s = s + "      vala_push(&stack, V_i64(1));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_MEAN) {\n";
    s = s + "      Value vt;\n";
    s = s + "      double f = 0.0;\n";
    s = s + "      int is_f = 0;\n";
    s = s + "      int64_t h;\n";
    s = s + "      if (!stack.len) die(\"stack underflow t_mean\");\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_mean expects Tensor\");\n";
    s = s + "      h = tl_mean_tensor(vt.payload, &f, &is_f);\n";
    s = s + "      if (is_f)\n";
    s = s + "        vala_push(&stack, V_f64(f));\n";
    s = s + "      else\n";
    s = s + "        vala_push(&stack, V_tensor(h));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_MSE) {\n";
    s = s + "      Value vb, va;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow t_mse\");\n";
    s = s + "      vb = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      if (va.tag != TAG_TENSOR || vb.tag != TAG_TENSOR) die(\"t_mse expects Tensor\");\n";
    s = s + "      vala_push(&stack, V_f64(tl_mse_ids(va.payload, vb.payload)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_PATCH_MEAN) {\n";
    s = s + "      Value vgw, vgh, vt;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow t_patch_mean\");\n";
    s = s + "      vgw = stack.data[--stack.len];\n";
    s = s + "      vgh = stack.data[--stack.len];\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"t_patch_mean expects Tensor\");\n";
    s = s + "      vala_push(&stack, V_tensor(tl_patch_mean(vt.payload, (int)as_i64(vgh, \"t_patch_mean\"),\n";
    s = s + "                                              (int)as_i64(vgw, \"t_patch_mean\"))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_T_LINEAR_GRAD) {\n";
    s = s + "      Value vy, vx, vw;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow t_linear_grad\");\n";
    s = s + "      vy = stack.data[--stack.len];\n";
    s = s + "      vx = stack.data[--stack.len];\n";
    s = s + "      vw = stack.data[--stack.len];\n";
    s = s + "      if (vw.tag != TAG_TENSOR || vx.tag != TAG_TENSOR || vy.tag != TAG_TENSOR)\n";
    s = s + "        die(\"t_linear_grad expects Tensor\");\n";
    s = s + "      vala_push(&stack, V_tensor(tl_linear_grad(vw.payload, vx.payload, vy.payload)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LEARN) {\n";
    s = s + "      double x[PL_DIM_MAX], y[PL_DIM_MAX];\n";
    s = s + "      int xn = 0, yn = 0;\n";
    s = s + "      Value vy, vx, vm;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow learn\");\n";
    s = s + "      vy = stack.data[--stack.len];\n";
    s = s + "      vx = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"learn expects Memory\");\n";
    s = s + "      pl_value_to_pat(vx, &lists, x, &xn);\n";
    s = s + "      pl_value_to_pat(vy, &lists, y, &yn);\n";
    s = s + "      vala_push(&stack, V_f64(pl_learn(pl_get(vm.payload), x, xn, y, yn)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_PREDICT) {\n";
    s = s + "      double pat[PL_DIM_MAX], out[PL_DIM_MAX];\n";
    s = s + "      int pn = 0, on = 0;\n";
    s = s + "      Value vo, vm;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow predict\");\n";
    s = s + "      vo = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"predict expects Memory\");\n";
    s = s + "      pl_value_to_pat(vo, &lists, pat, &pn);\n";
    s = s + "      pl_predict(pl_get(vm.payload), pat, pn, out, &on);\n";
    s = s + "      vala_push(&stack, pl_pat_to_list(out, on, &lists));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_UNROLL) {\n";
    s = s + "      double pat[PL_DIM_MAX], traj[64 * PL_DIM_MAX];\n";
    s = s + "      int pn = 0, steps, os = 0, od = 0, s;\n";
    s = s + "      Value vk, vo, vm;\n";
    s = s + "      ValA empty = {0};\n";
    s = s + "      int64_t oh;\n";
    s = s + "      if (stack.len < 3) die(\"stack underflow unroll\");\n";
    s = s + "      vk = stack.data[--stack.len];\n";
    s = s + "      vo = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"unroll expects Memory\");\n";
    s = s + "      steps = (int)as_i64(vk, \"unroll steps\");\n";
    s = s + "      pl_value_to_pat(vo, &lists, pat, &pn);\n";
    s = s + "      pl_unroll(pl_get(vm.payload), pat, pn, steps, traj, &os, &od);\n";
    s = s + "      oh = (int64_t)lists.len;\n";
    s = s + "      listh_push(&lists, empty);\n";
    s = s + "      for (s = 0; s < os; s++) {\n";
    s = s + "        Value inner = pl_pat_to_list(traj + s * PL_DIM_MAX, od, &lists);\n";
    s = s + "        vala_push(&lists.data[oh], inner);\n";
    s = s + "      }\n";
    s = s + "      vala_push(&stack, V_list(oh));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_REMEMBER_NEXT) {\n";
    s = s + "      double a[PL_DIM_MAX], b[PL_DIM_MAX];\n";
    s = s + "      int an = 0, bn = 0;\n";
    s = s + "      double surprise;\n";
    s = s + "      Value vs, vn, vo, vm;\n";
    s = s + "      if (stack.len < 4) die(\"stack underflow remember_next\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      vn = stack.data[--stack.len];\n";
    s = s + "      vo = stack.data[--stack.len];\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      if (vm.tag != TAG_MEMORY) die(\"remember_next expects Memory\");\n";
    s = s + "      surprise = to_f64(vs, \"remember_next surprise\");\n";
    s = s + "      if (vs.tag == TAG_I64) surprise = (double)vs.payload / 100.0;\n";
    s = s + "      pl_value_to_pat(vo, &lists, a, &an);\n";
    s = s + "      pl_value_to_pat(vn, &lists, b, &bn);\n";
    s = s + "      vala_push(&stack, V_i64(pl_remember_pair(pl_get(vm.payload), a, an, b, bn, surprise, 0) ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_EMIT) {\n";
    s = s + "      Value vv, ve;\n";
    s = s + "      const char *ev;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow emit\");\n";
    s = s + "      vv = stack.data[--stack.len];\n";
    s = s + "      ve = stack.data[--stack.len];\n";
    s = s + "      if (ve.tag != TAG_STR) die(\"emit event must be str\");\n";
    s = s + "      if (ve.payload < 0 || (size_t)ve.payload >= strs->len) die(\"bad str\");\n";
    s = s + "      ev = strs->data[ve.payload];\n";
    s = s + "      ev_emit(ev, vv);\n";
    s = s + "      vala_push(&stack, V_i64(0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_PENDING) {\n";
    s = s + "      vala_push(&stack, V_i64(ev_pending()));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LISTEN) {\n";
    s = s + "      Value vh, ve;\n";
    s = s + "      const char *ev, *hn;\n";
    s = s + "      size_t fi;\n";
    s = s + "      int found = 0;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow listen\");\n";
    s = s + "      vh = stack.data[--stack.len];\n";
    s = s + "      ve = stack.data[--stack.len];\n";
    s = s + "      if (ve.tag != TAG_STR || vh.tag != TAG_STR) die(\"listen expects str, str\");\n";
    s = s + "      ev = strs->data[ve.payload];\n";
    s = s + "      hn = strs->data[vh.payload];\n";
    s = s + "      for (fi = 0; fi < prog->nfns; fi++) {\n";
    s = s + "        if (strcmp(prog->fns[fi].name, hn) == 0) {\n";
    s = s + "          ev_listen(ev, prog->fns[fi].addr, prog->fns[fi].arity);\n";
    s = s + "          found = 1;\n";
    s = s + "          break;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      if (!found) die(\"listen: unknown handler\");\n";
    s = s + "      vala_push(&stack, V_i64(0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_TYPEOF) {\n";
    s = s + "      Value v;\n";
    s = s + "      const char *tn = \"unknown\";\n";
    s = s + "      if (!stack.len) die(\"stack underflow typeof\");\n";
    s = s + "      v = stack.data[--stack.len];\n";
    s = s + "      if (v.tag == TAG_I64) tn = \"i64\";\n";
    s = s + "      else if (v.tag == TAG_F64) tn = \"f64\";\n";
    s = s + "      else if (v.tag == TAG_STR) tn = \"str\";\n";
    s = s + "      else if (v.tag == TAG_LIST) tn = \"list\";\n";
    s = s + "      else if (v.tag == TAG_STRUCT) tn = \"struct\";\n";
    s = s + "      else if (v.tag == TAG_MEMORY) tn = \"Memory\";\n";
    s = s + "      else if (v.tag == TAG_TENSOR) tn = \"Tensor\";\n";
    s = s + "      vala_push(&stack, V_str(intern_str(tn)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_TO_STR) {\n";
    s = s + "      Value v;\n";
    s = s + "      char *ts;\n";
    s = s + "      int h;\n";
    s = s + "      if (!stack.len) die(\"stack underflow to_str\");\n";
    s = s + "      v = stack.data[--stack.len];\n";
    s = s + "      ts = k_to_str(v, strs, &lists);\n";
    s = s + "      h = intern_str(ts);\n";
    s = s + "      free(ts);\n";
    s = s + "      vala_push(&stack, V_str(h));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_CLEAR) {\n";
    s = s + "      ag_clear();\n";
    s = s + "      vala_push(&stack, V_i64(0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_PARAM) {\n";
    s = s + "      Value vt;\n";
    s = s + "      if (!stack.len) die(\"stack underflow ag_param\");\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag != TAG_TENSOR) die(\"ag_param expects Tensor\");\n";
    s = s + "      vala_push(&stack, V_i64(ag_param(vt.payload)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_CONST) {\n";
    s = s + "      Value vt;\n";
    s = s + "      if (!stack.len) die(\"stack underflow ag_const\");\n";
    s = s + "      vt = stack.data[--stack.len];\n";
    s = s + "      if (vt.tag == TAG_TENSOR)\n";
    s = s + "        vala_push(&stack, V_i64(ag_const_t(vt.payload)));\n";
    s = s + "      else if (vt.tag == TAG_F64 || vt.tag == TAG_I64)\n";
    s = s + "        vala_push(&stack, V_i64(ag_const_f(to_f64(vt, \"ag_const\"))));\n";
    s = s + "      else\n";
    s = s + "        die(\"ag_const expects Tensor|number\");\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_ADD || op == OP_AG_SUB || op == OP_AG_MUL || op == OP_AG_MATMUL ||\n";
    s = s + "        op == OP_AG_MSE) {\n";
    s = s + "      Value vb, va;\n";
    s = s + "      int a, b;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow ag binary\");\n";
    s = s + "      vb = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      a = (int)as_i64(va, \"ag node\");\n";
    s = s + "      b = (int)as_i64(vb, \"ag node\");\n";
    s = s + "      if (op == OP_AG_ADD)\n";
    s = s + "        vala_push(&stack, V_i64(ag_add_ids(a, b)));\n";
    s = s + "      else if (op == OP_AG_SUB)\n";
    s = s + "        vala_push(&stack, V_i64(ag_sub_ids(a, b)));\n";
    s = s + "      else if (op == OP_AG_MUL)\n";
    s = s + "        vala_push(&stack, V_i64(ag_mul_ids(a, b)));\n";
    s = s + "      else if (op == OP_AG_MATMUL)\n";
    s = s + "        vala_push(&stack, V_i64(ag_matmul_ids(a, b)));\n";
    s = s + "      else\n";
    s = s + "        vala_push(&stack, V_i64(ag_mse_n(a, b)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_SCALE) {\n";
    s = s + "      Value vs, va;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow ag_scale\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      vala_push(&stack, V_i64(ag_scale_n((int)as_i64(va, \"ag_scale\"), to_f64(vs, \"ag_scale\"))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_RESHAPE) {\n";
    s = s + "      Value vs, va;\n";
    s = s + "      int shape[TL_RANK_MAX], rank = 0;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow ag_reshape\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      tl_shape_from_list(vs, &lists, shape, &rank);\n";
    s = s + "      vala_push(&stack, V_i64(ag_reshape_n((int)as_i64(va, \"ag_reshape\"), shape, rank)));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_STEP) {\n";
    s = s + "      Value vs, va;\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow ag_step\");\n";
    s = s + "      vs = stack.data[--stack.len];\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      vala_push(&stack, V_tensor(ag_step_n((int)as_i64(va, \"ag_step\"), to_f64(vs, \"ag_step\"))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AG_RELU || op == OP_AG_NEG || op == OP_AG_TRANSPOSE || op == OP_AG_EXP ||\n";
    s = s + "        op == OP_AG_LOG || op == OP_AG_SOFTMAX || op == OP_AG_SUM || op == OP_AG_VALUE ||\n";
    s = s + "        op == OP_AG_GRAD || op == OP_AG_BACKWARD) {\n";
    s = s + "      Value va;\n";
    s = s + "      int id;\n";
    s = s + "      if (!stack.len) die(\"stack underflow ag unary\");\n";
    s = s + "      va = stack.data[--stack.len];\n";
    s = s + "      id = (int)as_i64(va, \"ag unary\");\n";
    s = s + "      if (op == OP_AG_RELU)\n";
    s = s + "        vala_push(&stack, V_i64(ag_relu_n(id)));\n";
    s = s + "      else if (op == OP_AG_NEG)\n";
    s = s + "        vala_push(&stack, V_i64(ag_neg_n(id)));\n";
    s = s + "      else if (op == OP_AG_TRANSPOSE)\n";
    s = s + "        vala_push(&stack, V_i64(ag_transpose_n(id)));\n";
    s = s + "      else if (op == OP_AG_EXP)\n";
    s = s + "        vala_push(&stack, V_i64(ag_exp_n(id)));\n";
    s = s + "      else if (op == OP_AG_LOG)\n";
    s = s + "        vala_push(&stack, V_i64(ag_log_n(id)));\n";
    s = s + "      else if (op == OP_AG_SOFTMAX)\n";
    s = s + "        vala_push(&stack, V_i64(ag_softmax_n(id)));\n";
    s = s + "      else if (op == OP_AG_SUM)\n";
    s = s + "        vala_push(&stack, V_i64(ag_sum_n(id)));\n";
    s = s + "      else if (op == OP_AG_VALUE)\n";
    s = s + "        vala_push(&stack, ag_value_v(id));\n";
    s = s + "      else if (op == OP_AG_GRAD)\n";
    s = s + "        vala_push(&stack, ag_grad_v(id));\n";
    s = s + "      else {\n";
    s = s + "        ag_backward(id);\n";
    s = s + "        vala_push(&stack, V_i64(0));\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_PUMP) {\n";
    s = s + "      Value vm;\n";
    s = s + "      if (!stack.len) die(\"stack underflow pump\");\n";
    s = s + "      vm = stack.data[--stack.len];\n";
    s = s + "      pump_left = as_i64(vm, \"pump\");\n";
    s = s + "      if (pump_left < 0) die(\"pump expects non-negative\");\n";
    s = s + "      pump_done = 0;\n";
    s = s + "      pump_ret_ip = ip; /* resume here after draining queue */\n";
    s = s + "    pump_step:\n";
    s = s + "      {\n";
    s = s + "        int launched = 0;\n";
    s = s + "        while (pump_left > 0) {\n";
    s = s + "          char *en = NULL;\n";
    s = s + "          Value ev;\n";
    s = s + "          EvHandler *h;\n";
    s = s + "          if (!ev_dequeue(&en, &ev)) break;\n";
    s = s + "          pump_left--;\n";
    s = s + "          h = ev_find(en);\n";
    s = s + "          free(en);\n";
    s = s + "          if (!h) continue;\n";
    s = s + "          i64a_push(&ret_ips, -2); /* resume pump */\n";
    s = s + "          i64a_push(&slot_bases, slot_base);\n";
    s = s + "          i64a_push(&stack_bases, (int64_t)stack.len);\n";
    s = s + "          slot_base = (int64_t)slots.len;\n";
    s = s + "          if (h->arity == 1) {\n";
    s = s + "            ensure_slot(&slots, slot_base);\n";
    s = s + "            slots.data[slot_base] = ev;\n";
    s = s + "          } else if (h->arity != 0) {\n";
    s = s + "            die(\"event handler arity must be 0 or 1\");\n";
    s = s + "          }\n";
    s = s + "          ip = (size_t)h->addr;\n";
    s = s + "          launched = 1;\n";
    s = s + "          break;\n";
    s = s + "        }\n";
    s = s + "        if (launched) continue;\n";
    s = s + "        ip = pump_ret_ip;\n";
    s = s + "        vala_push(&stack, V_i64(pump_done));\n";
    s = s + "        continue;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_STRUCT_NEW) {\n";
    s = s + "      int64_t tid = code->data[ip++];\n";
    s = s + "      if (tid < 0 || (size_t)tid >= prog->nstypes) die(\"bad struct type id\");\n";
    s = s + "      StructType *st = &prog->stypes[tid];\n";
    s = s + "      size_t nf = st->fields.len;\n";
    s = s + "      if (stack.len < nf) die(\"stack underflow STRUCT_NEW\");\n";
    s = s + "      StructObj obj;\n";
    s = s + "      obj.type_id = (int)tid;\n";
    s = s + "      memset(&obj.fields, 0, sizeof(obj.fields));\n";
    s = s + "      /* fields were pushed in decl order; top is last field */\n";
    s = s + "      int64_t *tmp = NULL;\n";
    s = s + "      if (nf) {\n";
    s = s + "        tmp = (int64_t *)malloc(nf * sizeof(int64_t));\n";
    s = s + "        if (!tmp) die(\"oom\");\n";
    s = s + "      }\n";
    s = s + "      for (size_t fi = nf; fi > 0;) {\n";
    s = s + "        fi--;\n";
    s = s + "        Value fv = stack.data[--stack.len];\n";
    s = s + "        tmp[fi] = as_i64(fv, \"struct fields must be i64\");\n";
    s = s + "      }\n";
    s = s + "      for (size_t fi = 0; fi < nf; fi++) i64a_push(&obj.fields, tmp[fi]);\n";
    s = s + "      free(tmp);\n";
    s = s + "      int64_t h = (int64_t)structs.len;\n";
    s = s + "      structh_push(&structs, obj);\n";
    s = s + "      vala_push(&stack, V_struct(h));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_GET_FIELD) {\n";
    s = s + "      int64_t name_idx = code->data[ip++];\n";
    s = s + "      if (!stack.len) die(\"stack underflow GET_FIELD\");\n";
    s = s + "      Value sv = stack.data[--stack.len];\n";
    s = s + "      if (sv.tag != TAG_STRUCT) die(\"field access: not a struct\");\n";
    s = s + "      if (sv.payload < 0 || (size_t)sv.payload >= structs.len) die(\"bad struct handle\");\n";
    s = s + "      if (name_idx < 0 || (size_t)name_idx >= strs->len) die(\"bad field name\");\n";
    s = s + "      StructObj *o = &structs.data[sv.payload];\n";
    s = s + "      if (o->type_id < 0 || (size_t)o->type_id >= prog->nstypes) die(\"bad struct type\");\n";
    s = s + "      int fidx = field_index_of(&prog->stypes[o->type_id], strs->data[name_idx]);\n";
    s = s + "      if (fidx < 0) die(\"unknown field\");\n";
    s = s + "      if ((size_t)fidx >= o->fields.len) die(\"bad field index\");\n";
    s = s + "      vala_push(&stack, V_i64(o->fields.data[fidx]));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SET_FIELD) {\n";
    s = s + "      int64_t name_idx = code->data[ip++];\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow SET_FIELD\");\n";
    s = s + "      Value vv = stack.data[--stack.len];\n";
    s = s + "      Value sv = stack.data[--stack.len];\n";
    s = s + "      int64_t val = as_i64(vv, \"struct fields must be i64\");\n";
    s = s + "      if (sv.tag != TAG_STRUCT) die(\"field assign: not a struct\");\n";
    s = s + "      if (sv.payload < 0 || (size_t)sv.payload >= structs.len) die(\"bad struct handle\");\n";
    s = s + "      if (name_idx < 0 || (size_t)name_idx >= strs->len) die(\"bad field name\");\n";
    s = s + "      StructObj *o = &structs.data[sv.payload];\n";
    s = s + "      if (o->type_id < 0 || (size_t)o->type_id >= prog->nstypes) die(\"bad struct type\");\n";
    s = s + "      int fidx = field_index_of(&prog->stypes[o->type_id], strs->data[name_idx]);\n";
    s = s + "      if (fidx < 0) die(\"unknown field\");\n";
    s = s + "      if ((size_t)fidx >= o->fields.len) die(\"bad field index\");\n";
    s = s + "      o->fields.data[fidx] = val;\n";
    s = s + "      vala_push(&stack, sv);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "#define BIN_NUM(OP_I, OP_F, AS_CMP)                                             \\\n";
    s = s + "  do {                                                                          \\\n";
    s = s + "    if (stack.len < 2) die(\"stack underflow\");                                  \\\n";
    s = s + "    Value vb = stack.data[--stack.len];                                         \\\n";
    s = s + "    Value va = stack.data[--stack.len];                                         \\\n";
    s = s + "    if (!is_num(va) || !is_num(vb)) die(\"arith expects number\");                \\\n";
    s = s + "    if (va.tag == TAG_F64 || vb.tag == TAG_F64) {                               \\\n";
    s = s + "      double a = to_f64(va, \"arith\");                                           \\\n";
    s = s + "      double b = to_f64(vb, \"arith\");                                           \\\n";
    s = s + "      if (AS_CMP)                                                               \\\n";
    s = s + "        vala_push(&stack, V_i64((OP_F) ? 1 : 0));                               \\\n";
    s = s + "      else                                                                      \\\n";
    s = s + "        vala_push(&stack, V_f64(OP_F));                                         \\\n";
    s = s + "    } else {                                                                    \\\n";
    s = s + "      int64_t a = va.payload;                                                   \\\n";
    s = s + "      int64_t b = vb.payload;                                                   \\\n";
    s = s + "      if (AS_CMP)                                                               \\\n";
    s = s + "        vala_push(&stack, V_i64((OP_I) ? 1 : 0));                               \\\n";
    s = s + "      else                                                                      \\\n";
    s = s + "        vala_push(&stack, V_i64(OP_I));                                         \\\n";
    s = s + "    }                                                                           \\\n";
    s = s + "  } while (0)\n";
    s = s + "    if (op == OP_ADD) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      if (va.tag == TAG_STR && vb.tag == TAG_STR) {\n";
    s = s + "        if (va.payload < 0 || vb.payload < 0 || (size_t)va.payload >= strs->len ||\n";
    s = s + "            (size_t)vb.payload >= strs->len)\n";
    s = s + "          die(\"bad str handle\");\n";
    s = s + "        const char *a = strs->data[va.payload];\n";
    s = s + "        const char *b = strs->data[vb.payload];\n";
    s = s + "        size_t na = strlen(a), nb = strlen(b);\n";
    s = s + "        char *cat = (char *)malloc(na + nb + 1);\n";
    s = s + "        if (!cat) die(\"oom\");\n";
    s = s + "        memcpy(cat, a, na);\n";
    s = s + "        memcpy(cat + na, b, nb + 1);\n";
    s = s + "        int h = intern_str(cat);\n";
    s = s + "        free(cat);\n";
    s = s + "        vala_push(&stack, V_str(h));\n";
    s = s + "      } else {\n";
    s = s + "        /* restore for BIN_NUM path */\n";
    s = s + "        vala_push(&stack, va);\n";
    s = s + "        vala_push(&stack, vb);\n";
    s = s + "        BIN_NUM(a + b, a + b, 0);\n";
    s = s + "      }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_SUB) {\n";
    s = s + "      BIN_NUM(a - b, a - b, 0);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MUL) {\n";
    s = s + "      BIN_NUM(a * b, a * b, 0);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_DIV) {\n";
    s = s + "      BIN_NUM(a / b, a / b, 0);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_MOD) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      int64_t a = as_i64(va, \"% expects i64\");\n";
    s = s + "      int64_t b = as_i64(vb, \"% expects i64\");\n";
    s = s + "      if (b == 0) die(\"% by zero\");\n";
    s = s + "      vala_push(&stack, V_i64(a % b));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_AND) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      int64_t a = as_i64(va, \"&& expects i64\");\n";
    s = s + "      int64_t b = as_i64(vb, \"&& expects i64\");\n";
    s = s + "      vala_push(&stack, V_i64((a != 0 && b != 0) ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_OR) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      int64_t a = as_i64(va, \"|| expects i64\");\n";
    s = s + "      int64_t b = as_i64(vb, \"|| expects i64\");\n";
    s = s + "      vala_push(&stack, V_i64((a != 0 || b != 0) ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_NOT) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow NOT\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      int64_t a = as_i64(v, \"! expects i64\");\n";
    s = s + "      vala_push(&stack, V_i64(a == 0 ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LT) {\n";
    s = s + "      BIN_NUM(a < b, a < b, 1);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_GT) {\n";
    s = s + "      BIN_NUM(a > b, a > b, 1);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_LE) {\n";
    s = s + "      BIN_NUM(a <= b, a <= b, 1);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_GE) {\n";
    s = s + "      BIN_NUM(a >= b, a >= b, 1);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "#undef BIN_NUM\n";
    s = s + "    if (op == OP_ROUND) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow ROUND\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      vala_push(&stack, V_i64(k_round_d(to_f64(v, \"round expects number\"))));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_ASSERT) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow ASSERT\");\n";
    s = s + "      Value v = stack.data[--stack.len];\n";
    s = s + "      int64_t ok = as_i64(v, \"assert expects i64\");\n";
    s = s + "      if (!ok) die(\"assert failed\");\n";
    s = s + "      vala_push(&stack, V_i64(0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_POP) {\n";
    s = s + "      if (!stack.len) die(\"stack underflow POP\");\n";
    s = s + "      stack.len--;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_EQ) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      vala_push(&stack, V_i64(values_eq(va, vb, strs) ? 1 : 0));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_NE) {\n";
    s = s + "      if (stack.len < 2) die(\"stack underflow\");\n";
    s = s + "      Value vb = stack.data[--stack.len];\n";
    s = s + "      Value va = stack.data[--stack.len];\n";
    s = s + "      vala_push(&stack, V_i64(values_eq(va, vb, strs) ? 0 : 1));\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_JMP) {\n";
    s = s + "      ip = (size_t)code->data[ip];\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_JMPF) {\n";
    s = s + "      int64_t t = code->data[ip++];\n";
    s = s + "      if (!stack.len) die(\"stack underflow JMPF\");\n";
    s = s + "      Value c = stack.data[--stack.len];\n";
    s = s + "      int64_t cv = as_i64(c, \"condition must be i64\");\n";
    s = s + "      if (cv == 0) ip = (size_t)t;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_CALL) {\n";
    s = s + "      int64_t addr = code->data[ip++];\n";
    s = s + "      int64_t argc = code->data[ip++];\n";
    s = s + "      if ((int64_t)stack.len < argc) die(\"stack underflow CALL\");\n";
    s = s + "      Value args_buf[64];\n";
    s = s + "      if (argc > 64) die(\"too many args\");\n";
    s = s + "      for (int64_t ai = argc - 1; ai >= 0; ai--) args_buf[ai] = stack.data[--stack.len];\n";
    s = s + "      i64a_push(&ret_ips, (int64_t)ip);\n";
    s = s + "      i64a_push(&slot_bases, slot_base);\n";
    s = s + "      i64a_push(&stack_bases, (int64_t)stack.len); /* caller's stack depth */\n";
    s = s + "      slot_base = (int64_t)slots.len;\n";
    s = s + "      for (int64_t ai = 0; ai < argc; ai++) {\n";
    s = s + "        ensure_slot(&slots, slot_base + ai);\n";
    s = s + "        slots.data[slot_base + ai] = args_buf[ai];\n";
    s = s + "      }\n";
    s = s + "      ip = (size_t)addr;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (op == OP_RET) {\n";
    s = s + "      /* void fn / trailing RET after statements: implicit 0 */\n";
    s = s + "      Value retv = stack.len ? stack.data[--stack.len] : V_i64(0);\n";
    s = s + "      int64_t rip;\n";
    s = s + "      slots.len = (size_t)slot_base;\n";
    s = s + "      if (!slot_bases.len || !ret_ips.len || !stack_bases.len) die(\"ret with empty frame\");\n";
    s = s + "      slot_base = slot_bases.data[--slot_bases.len];\n";
    s = s + "      {\n";
    s = s + "        int64_t sb = stack_bases.data[--stack_bases.len];\n";
    s = s + "        if (sb < 0 || (size_t)sb > stack.len) die(\"bad stack frame\");\n";
    s = s + "        stack.len = (size_t)sb; /* drop callee junk */\n";
    s = s + "      }\n";
    s = s + "      rip = ret_ips.data[--ret_ips.len];\n";
    s = s + "      if (rip == -2) {\n";
    s = s + "        pump_done++;\n";
    s = s + "        goto pump_step;\n";
    s = s + "      }\n";
    s = s + "      ip = (size_t)rip;\n";
    s = s + "      vala_push(&stack, retv);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    die(\"bad opcode\");\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    int64_t r = 0;\n";
    s = s + "    if (stack.len) {\n";
    s = s + "      Value top = stack.data[stack.len - 1];\n";
    s = s + "      if (top.tag != TAG_I64) die(\"main must return i64\");\n";
    s = s + "      r = top.payload;\n";
    s = s + "    }\n";
    s = s + "    vala_free(&stack);\n";
    s = s + "    vala_free(&slots);\n";
    s = s + "    i64a_free(&ret_ips);\n";
    s = s + "    i64a_free(&slot_bases);\n";
    s = s + "    i64a_free(&stack_bases);\n";
    s = s + "    listh_free(&lists);\n";
    s = s + "    structh_free(&structs);\n";
    s = s + "    pl_mems_reset();\n";
    s = s + "    tl_tensors_reset();\n";
    s = s + "    ag_clear();\n";
    s = s + "    ev_reset();\n";
    s = s + "    return r;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    assert(write_file("bootstrap/generated/rt_vm.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_vm.inc.c");
    println("rt_vm ok");
    return 0;
}
