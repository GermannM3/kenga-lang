// Emit Prophet Memory for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_prophet.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_prophet.kenga — do not hand-edit */\n";
    s = s + "/* Prophet Memory for kenga-lite — CPU f64 residual MLP, no Rust.\n";
    s = s + " * Included into kenga_lite.c (single TU). */\n";
    s = s + "#include <math.h>\n";
    s = s + "\n";
    s = s + "#ifndef KENGA_PROPHET_INC\n";
    s = s + "#define KENGA_PROPHET_INC\n";
    s = s + "\n";
    s = s + "#define PL_EP_MAX 128\n";
    s = s + "#define PL_CORE_MAX 64\n";
    s = s + "#define PL_DIM_MAX 64\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  double pattern[PL_DIM_MAX];\n";
    s = s + "  double target[PL_DIM_MAX];\n";
    s = s + "  int has_target;\n";
    s = s + "  int dim;\n";
    s = s + "  int target_dim;\n";
    s = s + "  double surprise;\n";
    s = s + "  uint64_t ts_ms;\n";
    s = s + "} PlEpisode;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  double pattern[PL_DIM_MAX];\n";
    s = s + "  int dim;\n";
    s = s + "  double importance;\n";
    s = s + "  uint64_t replays;\n";
    s = s + "} PlCore;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int dim, hidden;\n";
    s = s + "  double w1[PL_DIM_MAX * PL_DIM_MAX * 3]; /* h*d, h<=3*d */\n";
    s = s + "  double b1[PL_DIM_MAX * 3];\n";
    s = s + "  double w2[PL_DIM_MAX * PL_DIM_MAX * 3]; /* d*h */\n";
    s = s + "  double b2[PL_DIM_MAX];\n";
    s = s + "  double w1_lock[PL_DIM_MAX * PL_DIM_MAX * 3];\n";
    s = s + "  double b1_lock[PL_DIM_MAX * 3];\n";
    s = s + "  double w2_lock[PL_DIM_MAX * PL_DIM_MAX * 3];\n";
    s = s + "  double b2_lock[PL_DIM_MAX];\n";
    s = s + "  uint64_t steps;\n";
    s = s + "} PlWorld;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  PlEpisode ep[PL_EP_MAX];\n";
    s = s + "  int nep;\n";
    s = s + "  PlCore core[PL_CORE_MAX];\n";
    s = s + "  int ncore;\n";
    s = s + "  PlWorld model;\n";
    s = s + "  double threshold;\n";
    s = s + "  int ep_cap;\n";
    s = s + "  int core_cap;\n";
    s = s + "  double lr;\n";
    s = s + "} ProphetMem;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  ProphetMem *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} MemHeap;\n";
    s = s + "\n";
    s = s + "static MemHeap g_mems;\n";
    s = s + "\n";
    s = s + "static Value V_mem(int64_t h) {\n";
    s = s + "  Value v;\n";
    s = s + "  v.tag = TAG_MEMORY;\n";
    s = s + "  v.payload = h;\n";
    s = s + "  return v;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_hidden_for(int dim) {\n";
    s = s + "  int h = dim * 3;\n";
    s = s + "  if (h < 8) h = 8;\n";
    s = s + "  if (h > 64) h = 64;\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double pl_xavier(int fan_in, int fan_out, int i) {\n";
    s = s + "  double s = sqrt(6.0 / (double)(fan_in + fan_out));\n";
    s = s + "  int64_t t = (int64_t)i * 1103515245LL + 12345LL;\n";
    s = s + "  if (t < 0) t = -t;\n";
    s = s + "  double u = (double)(t % 10000LL) / 10000.0;\n";
    s = s + "  return (u * 2.0 - 1.0) * s;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_wm_init(PlWorld *m, int dim) {\n";
    s = s + "  if (dim < 1) dim = 1;\n";
    s = s + "  if (dim > PL_DIM_MAX) dim = PL_DIM_MAX;\n";
    s = s + "  memset(m, 0, sizeof(*m));\n";
    s = s + "  m->dim = dim;\n";
    s = s + "  m->hidden = pl_hidden_for(dim);\n";
    s = s + "  {\n";
    s = s + "    int d = m->dim, h = m->hidden, i;\n";
    s = s + "    for (i = 0; i < h * d; i++) m->w1[i] = pl_xavier(d, h, i);\n";
    s = s + "    for (i = 0; i < d * h; i++) m->w2[i] = pl_xavier(h, d, i + 17) * 0.25;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_wm_ensure(PlWorld *m, int dim) {\n";
    s = s + "  if (dim < 1) dim = 1;\n";
    s = s + "  if (dim > PL_DIM_MAX) dim = PL_DIM_MAX;\n";
    s = s + "  if (dim <= m->dim) return;\n";
    s = s + "  {\n";
    s = s + "    PlWorld *old = (PlWorld *)malloc(sizeof(PlWorld));\n";
    s = s + "    int od, oh, nh, r, c;\n";
    s = s + "    if (!old) die(\"oom prophet grow\");\n";
    s = s + "    memcpy(old, m, sizeof(PlWorld));\n";
    s = s + "    od = old->dim;\n";
    s = s + "    oh = old->hidden;\n";
    s = s + "    pl_wm_init(m, dim);\n";
    s = s + "    nh = m->hidden;\n";
    s = s + "    for (r = 0; r < oh && r < nh; r++) {\n";
    s = s + "      for (c = 0; c < od; c++) {\n";
    s = s + "        m->w1[r * m->dim + c] = old->w1[r * od + c];\n";
    s = s + "        m->w1_lock[r * m->dim + c] = old->w1_lock[r * od + c];\n";
    s = s + "      }\n";
    s = s + "      m->b1[r] = old->b1[r];\n";
    s = s + "      m->b1_lock[r] = old->b1_lock[r];\n";
    s = s + "    }\n";
    s = s + "    for (r = 0; r < od; r++) {\n";
    s = s + "      for (c = 0; c < oh && c < nh; c++) {\n";
    s = s + "        m->w2[r * nh + c] = old->w2[r * oh + c];\n";
    s = s + "        m->w2_lock[r * nh + c] = old->w2_lock[r * oh + c];\n";
    s = s + "      }\n";
    s = s + "      m->b2[r] = old->b2[r];\n";
    s = s + "      m->b2_lock[r] = old->b2_lock[r];\n";
    s = s + "    }\n";
    s = s + "    m->steps = old->steps;\n";
    s = s + "    free(old);\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_predict(const ProphetMem *mem, const double *obs, int on, double *out, int *out_n);\n";
    s = s + "\n";
    s = s + "static void pl_forward(const PlWorld *m, const double *x, int xn, double *h_out, double *y_out) {\n";
    s = s + "  int d = m->dim, h = m->hidden, r, c;\n";
    s = s + "  for (r = 0; r < h; r++) {\n";
    s = s + "    double s = m->b1[r];\n";
    s = s + "    for (c = 0; c < d; c++) s += m->w1[r * d + c] * (c < xn ? x[c] : 0.0);\n";
    s = s + "    h_out[r] = tanh(s);\n";
    s = s + "  }\n";
    s = s + "  for (r = 0; r < d; r++) {\n";
    s = s + "    double delta = m->b2[r];\n";
    s = s + "    for (c = 0; c < h; c++) delta += m->w2[r * h + c] * h_out[c];\n";
    s = s + "    y_out[r] = (r < xn ? x[r] : 0.0) + delta;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double pl_train_step(PlWorld *m, const double *x, int xn, const double *tgt, int tn,\n";
    s = s + "                            double lr) {\n";
    s = s + "  int need = xn > tn ? xn : tn;\n";
    s = s + "  if (need < 1) need = 1;\n";
    s = s + "  pl_wm_ensure(m, need);\n";
    s = s + "  {\n";
    s = s + "    double hh[64], yy[64], dy[64], dh[64];\n";
    s = s + "    int d = m->dim, h = m->hidden, r, c, i;\n";
    s = s + "    double loss = 0.0;\n";
    s = s + "    pl_forward(m, x, xn, hh, yy);\n";
    s = s + "    for (i = 0; i < d; i++) {\n";
    s = s + "      double t = i < tn ? tgt[i] : 0.0;\n";
    s = s + "      double err = t - yy[i];\n";
    s = s + "      loss += err * err;\n";
    s = s + "      dy[i] = err;\n";
    s = s + "    }\n";
    s = s + "    loss /= (double)d;\n";
    s = s + "    for (c = 0; c < h; c++) {\n";
    s = s + "      double s = 0.0;\n";
    s = s + "      for (r = 0; r < d; r++) s += m->w2[r * h + c] * dy[r];\n";
    s = s + "      dh[c] = s * (1.0 - hh[c] * hh[c]);\n";
    s = s + "    }\n";
    s = s + "    for (r = 0; r < d; r++) {\n";
    s = s + "      for (c = 0; c < h; c++) {\n";
    s = s + "        int idx = r * h + c;\n";
    s = s + "        double g = dy[r] * hh[c];\n";
    s = s + "        double eff = lr / (1.0 + m->w2_lock[idx]);\n";
    s = s + "        m->w2[idx] += eff * g;\n";
    s = s + "        m->w2_lock[idx] += 0.02 * fabs(g);\n";
    s = s + "      }\n";
    s = s + "      {\n";
    s = s + "        double eff = lr / (1.0 + m->b2_lock[r]);\n";
    s = s + "        m->b2[r] += eff * dy[r];\n";
    s = s + "        m->b2_lock[r] += 0.02 * fabs(dy[r]);\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    for (r = 0; r < h; r++) {\n";
    s = s + "      for (c = 0; c < d; c++) {\n";
    s = s + "        int idx = r * d + c;\n";
    s = s + "        double xv = c < xn ? x[c] : 0.0;\n";
    s = s + "        double g = dh[r] * xv;\n";
    s = s + "        double eff = lr / (1.0 + m->w1_lock[idx]);\n";
    s = s + "        m->w1[idx] += eff * g;\n";
    s = s + "        m->w1_lock[idx] += 0.02 * fabs(g);\n";
    s = s + "      }\n";
    s = s + "      {\n";
    s = s + "        double eff = lr / (1.0 + m->b1_lock[r]);\n";
    s = s + "        m->b1[r] += eff * dh[r];\n";
    s = s + "        m->b1_lock[r] += 0.02 * fabs(dh[r]);\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    m->steps++;\n";
    s = s + "    return loss;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double pl_surprise(const double *a, int an, const double *b, int bn) {\n";
    s = s + "  int n = an > bn ? an : bn;\n";
    s = s + "  int i;\n";
    s = s + "  double sum = 0.0;\n";
    s = s + "  if (n < 1) n = 1;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    double x = i < an ? a[i] : 0.0;\n";
    s = s + "    double y = i < bn ? b[i] : 0.0;\n";
    s = s + "    double d = x - y;\n";
    s = s + "    sum += d * d;\n";
    s = s + "  }\n";
    s = s + "  return sqrt(sum / (double)n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_value_to_pat(Value v, ListHeap *lists, double *out, int *out_n) {\n";
    s = s + "  if (v.tag == TAG_LIST) {\n";
    s = s + "    ValA *L;\n";
    s = s + "    size_t i;\n";
    s = s + "    if (v.payload < 0 || (size_t)v.payload >= lists->len) die(\"bad list\");\n";
    s = s + "    L = &lists->data[v.payload];\n";
    s = s + "    if (L->len > (size_t)PL_DIM_MAX) die(\"pattern too long\");\n";
    s = s + "    for (i = 0; i < L->len; i++) out[i] = to_f64(L->data[i], \"pattern\");\n";
    s = s + "    *out_n = (int)L->len;\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  if (v.tag == TAG_I64 || v.tag == TAG_F64) {\n";
    s = s + "    out[0] = to_f64(v, \"pattern\");\n";
    s = s + "    *out_n = 1;\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  die(\"memory pattern expects list or number\");\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value pl_pat_to_list(const double *p, int n, ListHeap *lists) {\n";
    s = s + "  ValA empty = {0};\n";
    s = s + "  int64_t h;\n";
    s = s + "  int i;\n";
    s = s + "  h = (int64_t)lists->len;\n";
    s = s + "  listh_push(lists, empty);\n";
    s = s + "  for (i = 0; i < n; i++) vala_push(&lists->data[h], V_f64(p[i]));\n";
    s = s + "  return V_list(h);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static ProphetMem *pl_get(int64_t h) {\n";
    s = s + "  if (h < 0 || (size_t)h >= g_mems.len) die(\"bad memory handle\");\n";
    s = s + "  return &g_mems.data[h];\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t pl_mem_new(double thr, int ep_cap, int core_cap) {\n";
    s = s + "  ProphetMem *m;\n";
    s = s + "  if (g_mems.len + 1 > g_mems.cap) {\n";
    s = s + "    g_mems.cap = g_mems.cap ? g_mems.cap * 2 : 4;\n";
    s = s + "    g_mems.data = (ProphetMem *)xrealloc(g_mems.data, g_mems.cap * sizeof(ProphetMem));\n";
    s = s + "  }\n";
    s = s + "  m = &g_mems.data[g_mems.len];\n";
    s = s + "  memset(m, 0, sizeof(*m));\n";
    s = s + "  m->threshold = thr;\n";
    s = s + "  m->ep_cap = ep_cap < 1 ? 1 : (ep_cap > PL_EP_MAX ? PL_EP_MAX : ep_cap);\n";
    s = s + "  m->core_cap = core_cap < 1 ? 1 : (core_cap > PL_CORE_MAX ? PL_CORE_MAX : core_cap);\n";
    s = s + "  m->lr = 0.08;\n";
    s = s + "  pl_wm_init(&m->model, 1);\n";
    s = s + "  return (int64_t)g_mems.len++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_mems_reset(void) {\n";
    s = s + "  free(g_mems.data);\n";
    s = s + "  g_mems.data = NULL;\n";
    s = s + "  g_mems.len = g_mems.cap = 0;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_remember(ProphetMem *mem, const double *pat, int dim, double surprise) {\n";
    s = s + "  int i, min_i;\n";
    s = s + "  double min_s;\n";
    s = s + "  if (surprise < mem->threshold) return 0;\n";
    s = s + "  pl_wm_ensure(&mem->model, dim);\n";
    s = s + "  if (mem->nep >= mem->ep_cap) {\n";
    s = s + "    min_i = 0;\n";
    s = s + "    min_s = mem->ep[0].surprise;\n";
    s = s + "    for (i = 1; i < mem->nep; i++) {\n";
    s = s + "      if (mem->ep[i].surprise < min_s) {\n";
    s = s + "        min_s = mem->ep[i].surprise;\n";
    s = s + "        min_i = i;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    mem->ep[min_i] = mem->ep[mem->nep - 1];\n";
    s = s + "    mem->nep--;\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    PlEpisode *e = &mem->ep[mem->nep++];\n";
    s = s + "    memset(e, 0, sizeof(*e));\n";
    s = s + "    e->dim = dim;\n";
    s = s + "    e->surprise = surprise;\n";
    s = s + "    e->has_target = 0;\n";
    s = s + "    e->ts_ms = 0;\n";
    s = s + "    for (i = 0; i < dim; i++) e->pattern[i] = pat[i];\n";
    s = s + "  }\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_remember_pair(ProphetMem *mem, const double *pat, int dim, const double *tgt,\n";
    s = s + "                            int td, double surprise, uint64_t ts_ms) {\n";
    s = s + "  int i, min_i;\n";
    s = s + "  double min_s;\n";
    s = s + "  if (surprise < mem->threshold) return 0;\n";
    s = s + "  pl_wm_ensure(&mem->model, dim > td ? dim : td);\n";
    s = s + "  if (mem->nep >= mem->ep_cap) {\n";
    s = s + "    min_i = 0;\n";
    s = s + "    min_s = mem->ep[0].surprise;\n";
    s = s + "    for (i = 1; i < mem->nep; i++) {\n";
    s = s + "      if (mem->ep[i].surprise < min_s) {\n";
    s = s + "        min_s = mem->ep[i].surprise;\n";
    s = s + "        min_i = i;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    mem->ep[min_i] = mem->ep[mem->nep - 1];\n";
    s = s + "    mem->nep--;\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    PlEpisode *e = &mem->ep[mem->nep++];\n";
    s = s + "    memset(e, 0, sizeof(*e));\n";
    s = s + "    e->dim = dim;\n";
    s = s + "    e->surprise = surprise;\n";
    s = s + "    e->ts_ms = ts_ms;\n";
    s = s + "    e->has_target = tgt && td > 0;\n";
    s = s + "    for (i = 0; i < dim; i++) e->pattern[i] = pat[i];\n";
    s = s + "    if (e->has_target) {\n";
    s = s + "      int n = td < PL_DIM_MAX ? td : PL_DIM_MAX;\n";
    s = s + "      e->target_dim = n;\n";
    s = s + "      for (i = 0; i < n; i++) e->target[i] = tgt[i];\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double pl_learn(ProphetMem *mem, const double *x, int xn, const double *y, int yn) {\n";
    s = s + "  return pl_train_step(&mem->model, x, xn, y, yn, mem->lr);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_unroll(const ProphetMem *mem, const double *obs, int on, int steps, double *traj,\n";
    s = s + "                      int *out_steps, int *out_dim) {\n";
    s = s + "  double cur[PL_DIM_MAX], nxt[PL_DIM_MAX];\n";
    s = s + "  int cn = 0, nn = 0, s, i;\n";
    s = s + "  if (steps < 1) steps = 1;\n";
    s = s + "  if (steps > 64) steps = 64;\n";
    s = s + "  for (i = 0; i < on && i < PL_DIM_MAX; i++) cur[i] = obs[i];\n";
    s = s + "  cn = on < PL_DIM_MAX ? on : PL_DIM_MAX;\n";
    s = s + "  for (s = 0; s < steps; s++) {\n";
    s = s + "    pl_predict(mem, cur, cn, nxt, &nn);\n";
    s = s + "    for (i = 0; i < nn; i++) traj[s * PL_DIM_MAX + i] = nxt[i];\n";
    s = s + "    for (i = 0; i < nn; i++) cur[i] = nxt[i];\n";
    s = s + "    cn = nn;\n";
    s = s + "  }\n";
    s = s + "  *out_steps = steps;\n";
    s = s + "  *out_dim = cn;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double pl_train_physics_epoch(ProphetMem *mem) {\n";
    s = s + "  double loss = 0.0, n = 0.0;\n";
    s = s + "  int pos, vel;\n";
    s = s + "  for (pos = 0; pos < 14; pos++) {\n";
    s = s + "    for (vel = 0; vel < 3; vel++) {\n";
    s = s + "      int v = vel - 1;\n";
    s = s + "      int fuel = 9;\n";
    s = s + "      double x[3], y[3];\n";
    s = s + "      x[0] = (double)pos;\n";
    s = s + "      x[1] = (double)v;\n";
    s = s + "      x[2] = (double)fuel;\n";
    s = s + "      y[0] = (double)(pos + v);\n";
    s = s + "      y[1] = (double)v;\n";
    s = s + "      y[2] = (double)(fuel - 1);\n";
    s = s + "      pl_remember_pair(mem, x, 3, y, 3, 0.5, 0);\n";
    s = s + "      loss += pl_learn(mem, x, 3, y, 3);\n";
    s = s + "      n += 1.0;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return loss / (n > 1.0 ? n : 1.0);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_write_f64s(FILE *f, const double *xs, int n) {\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    if (i) fputc(' ', f);\n";
    s = s + "    fprintf(f, \"%.17g\", xs[i]);\n";
    s = s + "  }\n";
    s = s + "  fputc('\\n', f);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_ensure_parent(const char *path) {\n";
    s = s + "  char buf[1024];\n";
    s = s + "  size_t i, n = strlen(path);\n";
    s = s + "  if (n == 0 || n >= sizeof(buf)) return;\n";
    s = s + "  memcpy(buf, path, n + 1);\n";
    s = s + "  for (i = 1; i < n; i++) {\n";
    s = s + "    if (buf[i] == '/' || buf[i] == '\\\\') {\n";
    s = s + "      char c = buf[i];\n";
    s = s + "      buf[i] = 0;\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "      _mkdir(buf);\n";
    s = s + "#else\n";
    s = s + "      mkdir(buf, 0755);\n";
    s = s + "#endif\n";
    s = s + "      buf[i] = c;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_save_mind(const ProphetMem *mem, const char *path) {\n";
    s = s + "  FILE *f;\n";
    s = s + "  int d, h, i;\n";
    s = s + "  pl_ensure_parent(path);\n";
    s = s + "  f = fopen(path, \"wb\");\n";
    s = s + "  if (!f) return 0;\n";
    s = s + "  d = mem->model.dim;\n";
    s = s + "  h = mem->model.hidden;\n";
    s = s + "  fprintf(f, \"KENGA_MIND 1\\n\");\n";
    s = s + "  fprintf(f, \"threshold %.17g\\n\", mem->threshold);\n";
    s = s + "  fprintf(f, \"ep_cap %d\\n\", mem->ep_cap);\n";
    s = s + "  fprintf(f, \"core_cap %d\\n\", mem->core_cap);\n";
    s = s + "  fprintf(f, \"lr %.17g\\n\", mem->lr);\n";
    s = s + "  fprintf(f, \"model %d %d %llu\\n\", d, h, (unsigned long long)mem->model.steps);\n";
    s = s + "  pl_write_f64s(f, mem->model.w1, h * d);\n";
    s = s + "  pl_write_f64s(f, mem->model.b1, h);\n";
    s = s + "  pl_write_f64s(f, mem->model.w2, d * h);\n";
    s = s + "  pl_write_f64s(f, mem->model.b2, d);\n";
    s = s + "  pl_write_f64s(f, mem->model.w1_lock, h * d);\n";
    s = s + "  pl_write_f64s(f, mem->model.b1_lock, h);\n";
    s = s + "  pl_write_f64s(f, mem->model.w2_lock, d * h);\n";
    s = s + "  pl_write_f64s(f, mem->model.b2_lock, d);\n";
    s = s + "  fprintf(f, \"core %d\\n\", mem->ncore);\n";
    s = s + "  for (i = 0; i < mem->ncore; i++) {\n";
    s = s + "    fprintf(f, \"%.17g %llu %d\\n\", mem->core[i].importance,\n";
    s = s + "            (unsigned long long)mem->core[i].replays, mem->core[i].dim);\n";
    s = s + "    pl_write_f64s(f, mem->core[i].pattern, mem->core[i].dim);\n";
    s = s + "  }\n";
    s = s + "  fprintf(f, \"episodic %d\\n\", mem->nep);\n";
    s = s + "  for (i = 0; i < mem->nep; i++) {\n";
    s = s + "    int has_t = mem->ep[i].has_target ? 1 : 0;\n";
    s = s + "    int tlen = has_t ? (mem->ep[i].target_dim > 0 ? mem->ep[i].target_dim : mem->ep[i].dim) : 0;\n";
    s = s + "    fprintf(f, \"%.17g %llu %d %d %d\\n\", mem->ep[i].surprise,\n";
    s = s + "            (unsigned long long)mem->ep[i].ts_ms, mem->ep[i].dim, has_t, tlen);\n";
    s = s + "    pl_write_f64s(f, mem->ep[i].pattern, mem->ep[i].dim);\n";
    s = s + "    if (has_t) pl_write_f64s(f, mem->ep[i].target, tlen);\n";
    s = s + "  }\n";
    s = s + "  fclose(f);\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_parse_f64s_line(const char *line, double *out, int maxn, int expect) {\n";
    s = s + "  int n = 0;\n";
    s = s + "  const char *p = line;\n";
    s = s + "  while (*p && n < maxn) {\n";
    s = s + "    char *end = NULL;\n";
    s = s + "    double v;\n";
    s = s + "    while (*p == ' ' || *p == '\\t') p++;\n";
    s = s + "    if (!*p || *p == '\\n' || *p == '\\r') break;\n";
    s = s + "    v = strtod(p, &end);\n";
    s = s + "    if (end == p) return -1;\n";
    s = s + "    out[n++] = v;\n";
    s = s + "    p = end;\n";
    s = s + "  }\n";
    s = s + "  if (expect >= 0 && n != expect) return -1;\n";
    s = s + "  return n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static char *pl_read_file(const char *path, size_t *out_len) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\");\n";
    s = s + "  long sz;\n";
    s = s + "  char *buf;\n";
    s = s + "  if (!f) return NULL;\n";
    s = s + "  if (fseek(f, 0, SEEK_END) != 0) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  sz = ftell(f);\n";
    s = s + "  if (sz < 0) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  rewind(f);\n";
    s = s + "  buf = (char *)malloc((size_t)sz + 1);\n";
    s = s + "  if (!buf) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) {\n";
    s = s + "    free(buf);\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  buf[sz] = 0;\n";
    s = s + "  fclose(f);\n";
    s = s + "  if (out_len) *out_len = (size_t)sz;\n";
    s = s + "  return buf;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* Split non-empty lines into pointers into mutable buffer (newlines → 0). */\n";
    s = s + "static int pl_split_lines(char *raw, char **lines, int max_lines) {\n";
    s = s + "  int n = 0;\n";
    s = s + "  char *p = raw;\n";
    s = s + "  while (*p && n < max_lines) {\n";
    s = s + "    char *start;\n";
    s = s + "    while (*p == '\\r' || *p == '\\n') p++;\n";
    s = s + "    if (!*p) break;\n";
    s = s + "    start = p;\n";
    s = s + "    while (*p && *p != '\\n' && *p != '\\r') p++;\n";
    s = s + "    if (*p) {\n";
    s = s + "      *p = 0;\n";
    s = s + "      p++;\n";
    s = s + "    }\n";
    s = s + "    if (start[0]) lines[n++] = start;\n";
    s = s + "  }\n";
    s = s + "  return n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t pl_load_mind(const char *path) {\n";
    s = s + "  char *raw;\n";
    s = s + "  char *lines[4096];\n";
    s = s + "  int nlines, li = 0;\n";
    s = s + "  ProphetMem *pm;\n";
    s = s + "  int d, h, i, core_n, ep_n;\n";
    s = s + "  unsigned long long steps;\n";
    s = s + "  pm = (ProphetMem *)malloc(sizeof(ProphetMem));\n";
    s = s + "  if (!pm) die(\"oom load_mind\");\n";
    s = s + "  memset(pm, 0, sizeof(*pm));\n";
    s = s + "#define m (*pm)\n";
    s = s + "  raw = pl_read_file(path, NULL);\n";
    s = s + "  if (!raw) die(\"cannot read mind file\");\n";
    s = s + "  nlines = pl_split_lines(raw, lines, 4096);\n";
    s = s + "  if (nlines < 6 || strcmp(lines[0], \"KENGA_MIND 1\") != 0) {\n";
    s = s + "    free(raw);\n";
    s = s + "    die(\"unsupported mind format\");\n";
    s = s + "  }\n";
    s = s + "  if (sscanf(lines[1], \"threshold %lf\", &m.threshold) != 1) die(\"bad threshold\");\n";
    s = s + "  if (sscanf(lines[2], \"ep_cap %d\", &m.ep_cap) != 1) die(\"bad ep_cap\");\n";
    s = s + "  if (sscanf(lines[3], \"core_cap %d\", &m.core_cap) != 1) die(\"bad core_cap\");\n";
    s = s + "  if (sscanf(lines[4], \"lr %lf\", &m.lr) != 1) die(\"bad lr\");\n";
    s = s + "  if (sscanf(lines[5], \"model %d %d %llu\", &d, &h, &steps) != 3) die(\"bad model\");\n";
    s = s + "  if (d < 1 || d > PL_DIM_MAX || h < 1 || h > PL_DIM_MAX * 3) die(\"model dims too large for lite\");\n";
    s = s + "  if (m.ep_cap > PL_EP_MAX) m.ep_cap = PL_EP_MAX;\n";
    s = s + "  if (m.core_cap > PL_CORE_MAX) m.core_cap = PL_CORE_MAX;\n";
    s = s + "  memset(&m.model, 0, sizeof(m.model));\n";
    s = s + "  m.model.dim = d;\n";
    s = s + "  m.model.hidden = h;\n";
    s = s + "  m.model.steps = (uint64_t)steps;\n";
    s = s + "  li = 6;\n";
    s = s + "#define PL_TAKE(dst, count, what)                                                                  \\\n";
    s = s + "  do {                                                                                             \\\n";
    s = s + "    int _got;                                                                                      \\\n";
    s = s + "    if (li >= nlines) {                                                                            \\\n";
    s = s + "      free(raw);                                                                                   \\\n";
    s = s + "      die(\"missing \" what);                                                                        \\\n";
    s = s + "    }                                                                                              \\\n";
    s = s + "    _got = pl_parse_f64s_line(lines[li++], (dst), (count), (count));                               \\\n";
    s = s + "    if (_got < 0) {                                                                                \\\n";
    s = s + "      free(raw);                                                                                   \\\n";
    s = s + "      die(\"bad \" what);                                                                            \\\n";
    s = s + "    }                                                                                              \\\n";
    s = s + "  } while (0)\n";
    s = s + "  PL_TAKE(m.model.w1, h * d, \"w1\");\n";
    s = s + "  PL_TAKE(m.model.b1, h, \"b1\");\n";
    s = s + "  PL_TAKE(m.model.w2, d * h, \"w2\");\n";
    s = s + "  PL_TAKE(m.model.b2, d, \"b2\");\n";
    s = s + "  PL_TAKE(m.model.w1_lock, h * d, \"w1_lock\");\n";
    s = s + "  PL_TAKE(m.model.b1_lock, h, \"b1_lock\");\n";
    s = s + "  PL_TAKE(m.model.w2_lock, d * h, \"w2_lock\");\n";
    s = s + "  PL_TAKE(m.model.b2_lock, d, \"b2_lock\");\n";
    s = s + "#undef PL_TAKE\n";
    s = s + "  if (li >= nlines || sscanf(lines[li++], \"core %d\", &core_n) != 1) {\n";
    s = s + "    free(raw);\n";
    s = s + "    die(\"bad core header\");\n";
    s = s + "  }\n";
    s = s + "  if (core_n < 0 || core_n > PL_CORE_MAX) {\n";
    s = s + "    free(raw);\n";
    s = s + "    die(\"too many core traces\");\n";
    s = s + "  }\n";
    s = s + "  m.ncore = core_n;\n";
    s = s + "  for (i = 0; i < core_n; i++) {\n";
    s = s + "    unsigned long long rep;\n";
    s = s + "    int plen;\n";
    s = s + "    if (li >= nlines) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"missing core meta\");\n";
    s = s + "    }\n";
    s = s + "    if (sscanf(lines[li++], \"%lf %llu %d\", &m.core[i].importance, &rep, &plen) != 3) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad core meta\");\n";
    s = s + "    }\n";
    s = s + "    m.core[i].replays = (uint64_t)rep;\n";
    s = s + "    if (plen < 1 || plen > PL_DIM_MAX) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad core plen\");\n";
    s = s + "    }\n";
    s = s + "    m.core[i].dim = plen;\n";
    s = s + "    if (li >= nlines || pl_parse_f64s_line(lines[li++], m.core[i].pattern, plen, plen) < 0) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad core pattern\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (li >= nlines || sscanf(lines[li++], \"episodic %d\", &ep_n) != 1) {\n";
    s = s + "    free(raw);\n";
    s = s + "    die(\"bad episodic header\");\n";
    s = s + "  }\n";
    s = s + "  if (ep_n < 0 || ep_n > PL_EP_MAX) {\n";
    s = s + "    free(raw);\n";
    s = s + "    die(\"too many episodes\");\n";
    s = s + "  }\n";
    s = s + "  m.nep = ep_n;\n";
    s = s + "  for (i = 0; i < ep_n; i++) {\n";
    s = s + "    unsigned long long ts;\n";
    s = s + "    int plen, has_t, tlen;\n";
    s = s + "    if (li >= nlines) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"missing episode meta\");\n";
    s = s + "    }\n";
    s = s + "    if (sscanf(lines[li++], \"%lf %llu %d %d %d\", &m.ep[i].surprise, &ts, &plen, &has_t, &tlen) !=\n";
    s = s + "        5) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad episode meta\");\n";
    s = s + "    }\n";
    s = s + "    m.ep[i].ts_ms = (uint64_t)ts;\n";
    s = s + "    m.ep[i].has_target = has_t ? 1 : 0;\n";
    s = s + "    if (plen < 1 || plen > PL_DIM_MAX) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad episode plen\");\n";
    s = s + "    }\n";
    s = s + "    m.ep[i].dim = plen;\n";
    s = s + "    if (li >= nlines || pl_parse_f64s_line(lines[li++], m.ep[i].pattern, plen, plen) < 0) {\n";
    s = s + "      free(raw);\n";
    s = s + "      die(\"bad episode pattern\");\n";
    s = s + "    }\n";
    s = s + "    if (has_t) {\n";
    s = s + "      if (tlen < 1 || tlen > PL_DIM_MAX) {\n";
    s = s + "        free(raw);\n";
    s = s + "        die(\"bad episode tlen\");\n";
    s = s + "      }\n";
    s = s + "      m.ep[i].target_dim = tlen;\n";
    s = s + "      if (li >= nlines || pl_parse_f64s_line(lines[li++], m.ep[i].target, tlen, tlen) < 0) {\n";
    s = s + "        free(raw);\n";
    s = s + "        die(\"bad episode target\");\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  free(raw);\n";
    s = s + "  if (g_mems.len + 1 > g_mems.cap) {\n";
    s = s + "    g_mems.cap = g_mems.cap ? g_mems.cap * 2 : 4;\n";
    s = s + "    g_mems.data = (ProphetMem *)xrealloc(g_mems.data, g_mems.cap * sizeof(ProphetMem));\n";
    s = s + "  }\n";
    s = s + "#undef m\n";
    s = s + "  g_mems.data[g_mems.len] = *pm;\n";
    s = s + "  free(pm);\n";
    s = s + "  return (int64_t)g_mems.len++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int pl_nearest_core(const ProphetMem *mem, const double *pat, int dim, double *out_dist) {\n";
    s = s + "  int i, best = -1;\n";
    s = s + "  double best_d = 1e300;\n";
    s = s + "  for (i = 0; i < mem->ncore; i++) {\n";
    s = s + "    double d = pl_surprise(mem->core[i].pattern, mem->core[i].dim, pat, dim);\n";
    s = s + "    if (d < best_d) {\n";
    s = s + "      best_d = d;\n";
    s = s + "      best = i;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (out_dist) *out_dist = best_d;\n";
    s = s + "  return best;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_blend_core(const ProphetMem *mem, const double *obs, int on, double *out, int *out_n) {\n";
    s = s + "  int i, t, dim = on;\n";
    s = s + "  double wsum = 0.0;\n";
    s = s + "  double ws[PL_CORE_MAX];\n";
    s = s + "  int idx[PL_CORE_MAX];\n";
    s = s + "  int n = mem->ncore;\n";
    s = s + "  if (n == 0) {\n";
    s = s + "    *out_n = 0;\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    double d = pl_surprise(mem->core[i].pattern, mem->core[i].dim, obs, on);\n";
    s = s + "    ws[i] = (1.0 / (0.05 + d)) * (1.0 + mem->core[i].importance);\n";
    s = s + "    idx[i] = i;\n";
    s = s + "    if (mem->core[i].dim > dim) dim = mem->core[i].dim;\n";
    s = s + "  }\n";
    s = s + "  /* selection sort top-3 by weight */\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    int j;\n";
    s = s + "    for (j = i + 1; j < n; j++) {\n";
    s = s + "      if (ws[idx[j]] > ws[idx[i]]) {\n";
    s = s + "        int tmp = idx[i];\n";
    s = s + "        idx[i] = idx[j];\n";
    s = s + "        idx[j] = tmp;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  t = n < 3 ? n : 3;\n";
    s = s + "  for (i = 0; i < dim; i++) out[i] = 0.0;\n";
    s = s + "  for (i = 0; i < t; i++) {\n";
    s = s + "    int ci = idx[i];\n";
    s = s + "    int k;\n";
    s = s + "    wsum += ws[ci];\n";
    s = s + "    for (k = 0; k < dim; k++) {\n";
    s = s + "      double p = k < mem->core[ci].dim ? mem->core[ci].pattern[k] : 0.0;\n";
    s = s + "      out[k] += ws[ci] * p;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (wsum < 1e-9) wsum = 1e-9;\n";
    s = s + "  for (i = 0; i < dim; i++) out[i] /= wsum;\n";
    s = s + "  *out_n = dim;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_predict(const ProphetMem *mem, const double *obs, int on, double *out, int *out_n) {\n";
    s = s + "  double hh[64];\n";
    s = s + "  int need = on > 0 ? on : 1;\n";
    s = s + "  if (mem->model.dim < need) pl_wm_ensure((PlWorld *)&mem->model, need);\n";
    s = s + "  pl_forward(&mem->model, obs, on, hh, out);\n";
    s = s + "  *out_n = mem->model.dim;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_foresee(const ProphetMem *mem, const double *obs, int on, double *out, int *out_n) {\n";
    s = s + "  double neural[PL_DIM_MAX], core[PL_DIM_MAX];\n";
    s = s + "  int nn = 0, cn = 0, dim, i;\n";
    s = s + "  double nw, cw;\n";
    s = s + "  pl_predict(mem, obs, on, neural, &nn);\n";
    s = s + "  pl_blend_core(mem, obs, on, core, &cn);\n";
    s = s + "  if (cn == 0) {\n";
    s = s + "    if (mem->model.steps == 0) {\n";
    s = s + "      for (i = 0; i < on; i++) out[i] = obs[i];\n";
    s = s + "      *out_n = on;\n";
    s = s + "    } else {\n";
    s = s + "      for (i = 0; i < nn; i++) out[i] = neural[i];\n";
    s = s + "      *out_n = nn;\n";
    s = s + "    }\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  dim = nn > cn ? nn : cn;\n";
    s = s + "  if (on > dim) dim = on;\n";
    s = s + "  nw = mem->model.steps > 0 ? 0.6 : 0.15;\n";
    s = s + "  cw = 1.0 - nw;\n";
    s = s + "  for (i = 0; i < dim; i++) {\n";
    s = s + "    double n = i < nn ? neural[i] : 0.0;\n";
    s = s + "    double c = i < cn ? core[i] : 0.0;\n";
    s = s + "    double o = i < on ? obs[i] : 0.0;\n";
    s = s + "    out[i] = nw * n + cw * c * 0.8 + o * 0.2;\n";
    s = s + "  }\n";
    s = s + "  *out_n = dim;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void pl_foresee_n(const ProphetMem *mem, const double *obs, int on, int steps, double *traj,\n";
    s = s + "                      int *out_steps, int *out_dim) {\n";
    s = s + "  double cur[PL_DIM_MAX], nxt[PL_DIM_MAX];\n";
    s = s + "  int cn = 0, nn = 0, s, i;\n";
    s = s + "  if (steps < 1) steps = 1;\n";
    s = s + "  if (steps > 64) steps = 64;\n";
    s = s + "  for (i = 0; i < on && i < PL_DIM_MAX; i++) cur[i] = obs[i];\n";
    s = s + "  cn = on < PL_DIM_MAX ? on : PL_DIM_MAX;\n";
    s = s + "  for (s = 0; s < steps; s++) {\n";
    s = s + "    pl_foresee(mem, cur, cn, nxt, &nn);\n";
    s = s + "    for (i = 0; i < nn; i++) traj[s * PL_DIM_MAX + i] = nxt[i];\n";
    s = s + "    for (i = 0; i < nn; i++) cur[i] = nxt[i];\n";
    s = s + "    cn = nn;\n";
    s = s + "  }\n";
    s = s + "  *out_steps = steps;\n";
    s = s + "  *out_dim = cn;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t pl_consolidate(ProphetMem *mem) {\n";
    s = s + "  int folded = 0;\n";
    s = s + "  int e;\n";
    s = s + "  int nep = mem->nep;\n";
    s = s + "  PlEpisode *eps = (PlEpisode *)malloc(sizeof(PlEpisode) * (size_t)(nep > 0 ? nep : 1));\n";
    s = s + "  if (!eps) die(\"oom consolidate\");\n";
    s = s + "  memcpy(eps, mem->ep, sizeof(eps[0]) * (size_t)nep);\n";
    s = s + "  mem->nep = 0;\n";
    s = s + "  for (e = 0; e < nep; e++) {\n";
    s = s + "    PlEpisode *ep = &eps[e];\n";
    s = s + "    const double *tgt = ep->has_target ? ep->target : ep->pattern;\n";
    s = s + "    int td = ep->has_target ? (ep->target_dim > 0 ? ep->target_dim : ep->dim) : ep->dim;\n";
    s = s + "    double dist = 0.0;\n";
    s = s + "    int ni;\n";
    s = s + "    folded++;\n";
    s = s + "    pl_wm_ensure(&mem->model, ep->dim > td ? ep->dim : td);\n";
    s = s + "    pl_train_step(&mem->model, ep->pattern, ep->dim, tgt, td, mem->lr);\n";
    s = s + "    if (ep->surprise > 0.4)\n";
    s = s + "      pl_train_step(&mem->model, ep->pattern, ep->dim, tgt, td, mem->lr * 0.5);\n";
    s = s + "    ni = pl_nearest_core(mem, ep->pattern, ep->dim, &dist);\n";
    s = s + "    if (ni >= 0 && dist < 0.35) {\n";
    s = s + "      double lock = mem->core[ni].importance;\n";
    s = s + "      double lr = 0.35 / (1.0 + (lock > 0.0 ? lock : 0.0));\n";
    s = s + "      int dim = mem->core[ni].dim > ep->dim ? mem->core[ni].dim : ep->dim;\n";
    s = s + "      int i;\n";
    s = s + "      if (dim > PL_DIM_MAX) dim = PL_DIM_MAX;\n";
    s = s + "      for (i = 0; i < dim; i++) {\n";
    s = s + "        double old = i < mem->core[ni].dim ? mem->core[ni].pattern[i] : 0.0;\n";
    s = s + "        double nw = i < ep->dim ? ep->pattern[i] : old;\n";
    s = s + "        mem->core[ni].pattern[i] = old * (1.0 - lr) + nw * lr;\n";
    s = s + "      }\n";
    s = s + "      mem->core[ni].dim = dim;\n";
    s = s + "      mem->core[ni].importance += ep->surprise * 0.5;\n";
    s = s + "      mem->core[ni].replays++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (mem->ncore < mem->core_cap) {\n";
    s = s + "      PlCore *c = &mem->core[mem->ncore++];\n";
    s = s + "      int i;\n";
    s = s + "      memset(c, 0, sizeof(*c));\n";
    s = s + "      c->dim = ep->dim;\n";
    s = s + "      c->importance = ep->surprise;\n";
    s = s + "      c->replays = 1;\n";
    s = s + "      for (i = 0; i < ep->dim; i++) c->pattern[i] = ep->pattern[i];\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (mem->ncore > mem->core_cap) {\n";
    s = s + "    /* drop lowest importance */\n";
    s = s + "    while (mem->ncore > mem->core_cap) {\n";
    s = s + "      int i, worst = 0;\n";
    s = s + "      for (i = 1; i < mem->ncore; i++)\n";
    s = s + "        if (mem->core[i].importance < mem->core[worst].importance) worst = i;\n";
    s = s + "      mem->core[worst] = mem->core[mem->ncore - 1];\n";
    s = s + "      mem->ncore--;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  free(eps);\n";
    s = s + "  return folded;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value pl_recall(ProphetMem *mem, const double *q, int qn, int k, ListHeap *lists) {\n";
    s = s + "  typedef struct {\n";
    s = s + "    double d;\n";
    s = s + "    int dim;\n";
    s = s + "    double p[PL_DIM_MAX];\n";
    s = s + "  } Hit;\n";
    s = s + "  Hit hits[PL_EP_MAX + PL_CORE_MAX];\n";
    s = s + "  int nh = 0, i, j;\n";
    s = s + "  ValA outer = {0};\n";
    s = s + "  int64_t oh;\n";
    s = s + "  if (k < 1) k = 1;\n";
    s = s + "  for (i = 0; i < mem->ncore && nh < (int)(sizeof hits / sizeof hits[0]); i++) {\n";
    s = s + "    hits[nh].d = pl_surprise(mem->core[i].pattern, mem->core[i].dim, q, qn);\n";
    s = s + "    hits[nh].dim = mem->core[i].dim;\n";
    s = s + "    memcpy(hits[nh].p, mem->core[i].pattern, sizeof(double) * (size_t)mem->core[i].dim);\n";
    s = s + "    nh++;\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < mem->nep && nh < (int)(sizeof hits / sizeof hits[0]); i++) {\n";
    s = s + "    hits[nh].d = pl_surprise(mem->ep[i].pattern, mem->ep[i].dim, q, qn);\n";
    s = s + "    hits[nh].dim = mem->ep[i].dim;\n";
    s = s + "    memcpy(hits[nh].p, mem->ep[i].pattern, sizeof(double) * (size_t)mem->ep[i].dim);\n";
    s = s + "    nh++;\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < nh; i++) {\n";
    s = s + "    for (j = i + 1; j < nh; j++) {\n";
    s = s + "      if (hits[j].d < hits[i].d) {\n";
    s = s + "        Hit t = hits[i];\n";
    s = s + "        hits[i] = hits[j];\n";
    s = s + "        hits[j] = t;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (k > nh) k = nh;\n";
    s = s + "  oh = (int64_t)lists->len;\n";
    s = s + "  listh_push(lists, outer);\n";
    s = s + "  for (i = 0; i < k; i++) {\n";
    s = s + "    Value inner = pl_pat_to_list(hits[i].p, hits[i].dim, lists);\n";
    s = s + "    vala_push(&lists->data[oh], inner);\n";
    s = s + "  }\n";
    s = s + "  return V_list(oh);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value pl_stats(ProphetMem *mem, ListHeap *lists) {\n";
    s = s + "  ValA empty = {0};\n";
    s = s + "  int64_t h = (int64_t)lists->len;\n";
    s = s + "  int locked = 0, i;\n";
    s = s + "  for (i = 0; i < mem->ncore; i++)\n";
    s = s + "    if (mem->core[i].importance >= 1.0) locked++;\n";
    s = s + "  listh_push(lists, empty);\n";
    s = s + "  vala_push(&lists->data[h], V_i64(mem->nep));\n";
    s = s + "  vala_push(&lists->data[h], V_i64(mem->ncore));\n";
    s = s + "  vala_push(&lists->data[h], V_i64(locked));\n";
    s = s + "  vala_push(&lists->data[h], V_i64((int64_t)mem->model.steps));\n";
    s = s + "  vala_push(&lists->data[h], V_i64(mem->model.dim));\n";
    s = s + "  vala_push(&lists->data[h], V_i64(mem->model.hidden));\n";
    s = s + "  return V_list(h);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "#endif /* KENGA_PROPHET_INC */\n";
    assert(write_file("bootstrap/generated/rt_prophet.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_prophet.inc.c");
    println("rt_prophet ok");
    return 0;
}
