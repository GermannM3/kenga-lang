// Emit ident / number / string parsers for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_parse.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_parse.kenga — do not hand-edit */\n";
    s = s + "typedef struct { char *name; size_t i; } Ident;\n";
    s = s + "static Ident parse_ident(const char *s, size_t i, size_t n) {\n";
    s = s + "  Ident r; r.name = NULL; r.i = i;\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  size_t start = i;\n";
    s = s + "  if (i >= n || !is_ident_start(s[i])) die(\"expected ident\");\n";
    s = s + "  i++;\n";
    s = s + "  while (i < n && is_ident(s[i])) i++;\n";
    s = s + "  size_t len = i - start;\n";
    s = s + "  char *name = (char *)malloc(len + 1);\n";
    s = s + "  if (!name) die(\"oom\");\n";
    s = s + "  memcpy(name, s + start, len);\n";
    s = s + "  name[len] = 0;\n";
    s = s + "  r.name = name; r.i = i;\n";
    s = s + "  return r;\n";
    s = s + "}\n\n";
    s = s + "typedef struct { int is_float; int64_t i; double f; } ParsedNum;\n";
    s = s + "static ParsedNum parse_number(const char *s, size_t *i, size_t n) {\n";
    s = s + "  ParsedNum r; r.is_float = 0; r.i = 0; r.f = 0.0;\n";
    s = s + "  *i = skip(s, *i, n);\n";
    s = s + "  if (*i >= n || !isdigit((unsigned char)s[*i])) die(\"expected number\");\n";
    s = s + "  int64_t v = 0;\n";
    s = s + "  if (s[*i] == '0' && *i + 1 < n) {\n";
    s = s + "    char p = s[*i + 1];\n";
    s = s + "    if (p == 'x' || p == 'X') {\n";
    s = s + "      *i += 2; if (*i >= n) die(\"expected hex digit\");\n";
    s = s + "      int any = 0;\n";
    s = s + "      while (*i < n) {\n";
    s = s + "        unsigned char c = (unsigned char)s[*i]; int d = -1;\n";
    s = s + "        if (c >= '0' && c <= '9') d = c - '0';\n";
    s = s + "        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;\n";
    s = s + "        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;\n";
    s = s + "        if (d < 0) break; v = v * 16 + d; (*i)++; any = 1;\n";
    s = s + "      }\n";
    s = s + "      if (!any) die(\"expected hex digit\"); r.i = v; return r;\n";
    s = s + "    }\n";
    s = s + "    if (p == 'b' || p == 'B') {\n";
    s = s + "      *i += 2; if (*i >= n) die(\"expected binary digit\");\n";
    s = s + "      int any = 0;\n";
    s = s + "      while (*i < n && (s[*i] == '0' || s[*i] == '1')) {\n";
    s = s + "        v = v * 2 + (s[*i] - '0'); (*i)++; any = 1;\n";
    s = s + "      }\n";
    s = s + "      if (!any) die(\"expected binary digit\"); r.i = v; return r;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  while (*i < n && isdigit((unsigned char)s[*i])) {\n";
    s = s + "    v = v * 10 + (s[*i] - '0');\n";
    s = s + "    (*i)++;\n";
    s = s + "  }\n";
    s = s + "  if (*i < n && s[*i] == '.') {\n";
    s = s + "    if (*i + 1 < n && s[*i + 1] == '.') { r.i = v; return r; }\n";
    s = s + "    (*i)++;\n";
    s = s + "    double frac = 0.0; double place = 0.1; int any = 0;\n";
    s = s + "    while (*i < n && isdigit((unsigned char)s[*i])) {\n";
    s = s + "      frac += (s[*i] - '0') * place; place *= 0.1; (*i)++; any = 1;\n";
    s = s + "    }\n";
    s = s + "    if (!any) die(\"expected digits after decimal point\");\n";
    s = s + "    r.is_float = 1; r.f = (double)v + frac; return r;\n";
    s = s + "  }\n";
    s = s + "  r.i = v; return r;\n";
    s = s + "}\n\n";
    s = s + "static char *parse_string(const char *s, size_t *i, size_t n) {\n";
    s = s + "  *i = skip(s, *i, n);\n";
    s = s + "  if (*i >= n || s[*i] != '\"') die(\"expected string\");\n";
    s = s + "  (*i)++;\n";
    s = s + "  size_t cap = 32, len = 0;\n";
    s = s + "  char *buf = (char *)malloc(cap);\n";
    s = s + "  if (!buf) die(\"oom\");\n";
    s = s + "  while (*i < n && s[*i] != '\"') {\n";
    s = s + "    char c = s[*i];\n";
    s = s + "    if (c == '\\\\') {\n";
    s = s + "      (*i)++;\n";
    s = s + "      if (*i >= n) die(\"bad string escape\");\n";
    s = s + "      char e = s[*i];\n";
    s = s + "      if (e == 'n') c = '\\n';\n";
    s = s + "      else if (e == 't') c = '\\t';\n";
    s = s + "      else if (e == '\"' || e == '\\\\') c = e;\n";
    s = s + "      else die(\"bad string escape\");\n";
    s = s + "    }\n";
    s = s + "    if (len + 1 >= cap) { cap *= 2; buf = (char *)xrealloc(buf, cap); }\n";
    s = s + "    buf[len++] = c; (*i)++;\n";
    s = s + "  }\n";
    s = s + "  if (*i >= n || s[*i] != '\"') die(\"unclosed string\");\n";
    s = s + "  (*i)++; buf[len] = 0; return buf;\n";
    s = s + "}\n\n";
    s = s + "static int slot_of(StrA *vnames, const char *name) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < vnames->len; i++) {\n";
    s = s + "    if (strcmp(vnames->data[i], name) == 0) return (int)i;\n";
    s = s + "  }\n";
    s = s + "  stra_push(vnames, xstrdup(name));\n";
    s = s + "  return (int)vnames->len - 1;\n";
    s = s + "}\n\n";
    s = s + "static void emit2(I64A *code, int64_t a, int64_t b) {\n";
    s = s + "  i64a_push(code, a); i64a_push(code, b);\n";
    s = s + "}\n";
    s = s + "static void emit3(I64A *code, int64_t a, int64_t b, int64_t c) {\n";
    s = s + "  i64a_push(code, a); i64a_push(code, b); i64a_push(code, c);\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_parse.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_parse.inc.c");
    println("rt_parse ok");
    return 0;
}
