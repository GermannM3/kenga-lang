// Emit dense f64 tensors for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_tensor.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_tensor.kenga — do not hand-edit */\n";
    s = s + "/* Dense f64 tensors for kenga-lite — no Rust.\n";
    s = s + " * Included into kenga_lite.c after Value/List helpers. */\n";
    s = s + "#ifndef KENGA_TENSOR_LITE_INC\n";
    s = s + "#define KENGA_TENSOR_LITE_INC\n";
    s = s + "\n";
    s = s + "#define TL_RANK_MAX 8\n";
    s = s + "#define TL_ELEMS_MAX (1 << 20) /* 1M doubles safety cap */\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int rank;\n";
    s = s + "  int shape[TL_RANK_MAX];\n";
    s = s + "  int n;\n";
    s = s + "  double *data;\n";
    s = s + "} Tensor;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  Tensor *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} TensorHeap;\n";
    s = s + "\n";
    s = s + "static TensorHeap g_tensors;\n";
    s = s + "\n";
    s = s + "static Value V_tensor(int64_t h) {\n";
    s = s + "  Value v;\n";
    s = s + "  v.tag = TAG_TENSOR;\n";
    s = s + "  v.payload = h;\n";
    s = s + "  return v;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void tl_tensors_reset(void) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < g_tensors.len; i++) free(g_tensors.data[i].data);\n";
    s = s + "  free(g_tensors.data);\n";
    s = s + "  g_tensors.data = NULL;\n";
    s = s + "  g_tensors.len = g_tensors.cap = 0;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Tensor *tl_get(int64_t h) {\n";
    s = s + "  if (h < 0 || (size_t)h >= g_tensors.len) die(\"bad tensor handle\");\n";
    s = s + "  return &g_tensors.data[h];\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int tl_product(const int *shape, int rank) {\n";
    s = s + "  int i, n = 1;\n";
    s = s + "  if (rank <= 0) return 0;\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (shape[i] < 0) die(\"negative tensor dim\");\n";
    s = s + "    if (shape[i] > 0 && n > TL_ELEMS_MAX / shape[i]) die(\"tensor too large\");\n";
    s = s + "    n *= shape[i];\n";
    s = s + "  }\n";
    s = s + "  return n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_alloc(const int *shape, int rank, int zero) {\n";
    s = s + "  Tensor t;\n";
    s = s + "  int i, n;\n";
    s = s + "  memset(&t, 0, sizeof(t));\n";
    s = s + "  if (rank < 0 || rank > TL_RANK_MAX) die(\"tensor rank out of range\");\n";
    s = s + "  t.rank = rank;\n";
    s = s + "  for (i = 0; i < rank; i++) t.shape[i] = shape[i];\n";
    s = s + "  n = tl_product(shape, rank);\n";
    s = s + "  t.n = n;\n";
    s = s + "  if (n > 0) {\n";
    s = s + "    t.data = (double *)malloc((size_t)n * sizeof(double));\n";
    s = s + "    if (!t.data) die(\"oom tensor\");\n";
    s = s + "    if (zero) memset(t.data, 0, (size_t)n * sizeof(double));\n";
    s = s + "  }\n";
    s = s + "  if (g_tensors.len + 1 > g_tensors.cap) {\n";
    s = s + "    g_tensors.cap = g_tensors.cap ? g_tensors.cap * 2 : 4096;\n";
    s = s + "    g_tensors.data = (Tensor *)xrealloc(g_tensors.data, g_tensors.cap * sizeof(Tensor));\n";
    s = s + "  }\n";
    s = s + "  g_tensors.data[g_tensors.len] = t;\n";
    s = s + "  return (int64_t)g_tensors.len++;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_zeros(const int *shape, int rank) { return tl_alloc(shape, rank, 1); }\n";
    s = s + "\n";
    s = s + "static int64_t tl_clone_shape_data(const int *shape, int rank, const double *data, int n) {\n";
    s = s + "  int64_t h = tl_alloc(shape, rank, 0);\n";
    s = s + "  Tensor *t = tl_get(h);\n";
    s = s + "  if (t->n != n) die(\"internal tensor size\");\n";
    s = s + "  if (n > 0) memcpy(t->data, data, (size_t)n * sizeof(double));\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void tl_shape_from_list(Value v, ListHeap *lists, int *shape, int *rank) {\n";
    s = s + "  ValA *L;\n";
    s = s + "  size_t i;\n";
    s = s + "  if (v.tag != TAG_LIST) die(\"tensor shape expects list\");\n";
    s = s + "  if (v.payload < 0 || (size_t)v.payload >= lists->len) die(\"bad list\");\n";
    s = s + "  L = &lists->data[v.payload];\n";
    s = s + "  if (L->len > (size_t)TL_RANK_MAX) die(\"tensor rank too high\");\n";
    s = s + "  *rank = (int)L->len;\n";
    s = s + "  for (i = 0; i < L->len; i++) {\n";
    s = s + "    if (L->data[i].tag != TAG_I64) die(\"shape dim must be i64\");\n";
    s = s + "    shape[i] = (int)L->data[i].payload;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void tl_data_from_list(Value v, ListHeap *lists, double *out, int n) {\n";
    s = s + "  ValA *L;\n";
    s = s + "  size_t i;\n";
    s = s + "  if (v.tag != TAG_LIST) die(\"tensor data expects list\");\n";
    s = s + "  if (v.payload < 0 || (size_t)v.payload >= lists->len) die(\"bad list\");\n";
    s = s + "  L = &lists->data[v.payload];\n";
    s = s + "  if ((int)L->len != n) die(\"t_from data length mismatch\");\n";
    s = s + "  for (i = 0; i < L->len; i++) out[i] = to_f64(L->data[i], \"tensor data\");\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static Value tl_shape_to_list(const Tensor *t, ListHeap *lists) {\n";
    s = s + "  ValA empty = {0};\n";
    s = s + "  int64_t h = (int64_t)lists->len;\n";
    s = s + "  int i;\n";
    s = s + "  listh_push(lists, empty);\n";
    s = s + "  for (i = 0; i < t->rank; i++) vala_push(&lists->data[h], V_i64(t->shape[i]));\n";
    s = s + "  return V_list(h);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_ew(int64_t ha, int64_t hb, double (*op)(double, double)) {\n";
    s = s + "  Tensor *a = tl_get(ha), *b = tl_get(hb);\n";
    s = s + "  int i, n, rank, shape[TL_RANK_MAX];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  Tensor *o;\n";
    s = s + "  if (a->rank != b->rank || a->n != b->n) die(\"tensor shape mismatch\");\n";
    s = s + "  for (i = 0; i < a->rank; i++)\n";
    s = s + "    if (a->shape[i] != b->shape[i]) die(\"tensor shape mismatch\");\n";
    s = s + "  rank = a->rank;\n";
    s = s + "  n = a->n;\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i];\n";
    s = s + "  ad = a->data;\n";
    s = s + "  bd = b->data;\n";
    s = s + "  h = tl_alloc(shape, rank, 0);\n";
    s = s + "  o = tl_get(h);\n";
    s = s + "  for (i = 0; i < n; i++) o->data[i] = op(ad[i], bd[i]);\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double tl_op_add(double x, double y) { return x + y; }\n";
    s = s + "static double tl_op_sub(double x, double y) { return x - y; }\n";
    s = s + "static double tl_op_mul(double x, double y) { return x * y; }\n";
    s = s + "\n";
    s = s + "static int64_t tl_matmul(int64_t ha, int64_t hb) {\n";
    s = s + "  Tensor *a = tl_get(ha), *b = tl_get(hb);\n";
    s = s + "  int m, k, k2, n, i, j, t;\n";
    s = s + "  int shape[2];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  Tensor *o;\n";
    s = s + "  if (a->rank != 2 || b->rank != 2) die(\"t_matmul expects rank-2\");\n";
    s = s + "  m = a->shape[0];\n";
    s = s + "  k = a->shape[1];\n";
    s = s + "  k2 = b->shape[0];\n";
    s = s + "  n = b->shape[1];\n";
    s = s + "  if (k != k2) die(\"t_matmul inner dim mismatch\");\n";
    s = s + "  ad = a->data;\n";
    s = s + "  bd = b->data;\n";
    s = s + "  shape[0] = m;\n";
    s = s + "  shape[1] = n;\n";
    s = s + "  h = tl_zeros(shape, 2);\n";
    s = s + "  o = tl_get(h);\n";
    s = s + "  for (i = 0; i < m; i++)\n";
    s = s + "    for (j = 0; j < n; j++) {\n";
    s = s + "      double s = 0.0;\n";
    s = s + "      for (t = 0; t < k; t++) s += ad[i * k + t] * bd[t * n + j];\n";
    s = s + "      o->data[i * n + j] = s;\n";
    s = s + "    }\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_transpose(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int r, c, shape[2];\n";
    s = s + "  double *ad;\n";
    s = s + "  int64_t h;\n";
    s = s + "  Tensor *o;\n";
    s = s + "  if (a->rank != 2) die(\"t_transpose expects rank-2\");\n";
    s = s + "  r = a->shape[0];\n";
    s = s + "  c = a->shape[1];\n";
    s = s + "  ad = a->data;\n";
    s = s + "  shape[0] = c;\n";
    s = s + "  shape[1] = r;\n";
    s = s + "  h = tl_zeros(shape, 2);\n";
    s = s + "  o = tl_get(h);\n";
    s = s + "  {\n";
    s = s + "    int i, j;\n";
    s = s + "    for (i = 0; i < r; i++)\n";
    s = s + "      for (j = 0; j < c; j++) o->data[j * r + i] = ad[i * c + j];\n";
    s = s + "  }\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_scale(int64_t ha, double s) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int64_t h = tl_clone_shape_data(a->shape, a->rank, a->data, a->n);\n";
    s = s + "  Tensor *o = tl_get(h);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] *= s;\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double tl_sum(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  double s = 0.0;\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < a->n; i++) s += a->data[i];\n";
    s = s + "  return s;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double tl_dot(int64_t ha, int64_t hb) {\n";
    s = s + "  Tensor *a = tl_get(ha), *b = tl_get(hb);\n";
    s = s + "  double s = 0.0;\n";
    s = s + "  int i;\n";
    s = s + "  if (a->n != b->n) die(\"t_dot length mismatch\");\n";
    s = s + "  for (i = 0; i < a->n; i++) s += a->data[i] * b->data[i];\n";
    s = s + "  return s;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_exp(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int64_t h = tl_clone_shape_data(a->shape, a->rank, a->data, a->n);\n";
    s = s + "  Tensor *o = tl_get(h);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] = exp(o->data[i]);\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_log(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int64_t h = tl_clone_shape_data(a->shape, a->rank, a->data, a->n);\n";
    s = s + "  Tensor *o = tl_get(h);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) {\n";
    s = s + "    double x = o->data[i];\n";
    s = s + "    if (x < 1e-12) x = 1e-12;\n";
    s = s + "    o->data[i] = log(x);\n";
    s = s + "  }\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int tl_save_tensor(int64_t ha, const char *path) {\n";
    s = s + "  Tensor *t = tl_get(ha);\n";
    s = s + "  FILE *f = fopen(path, \"wb\");\n";
    s = s + "  int i;\n";
    s = s + "  if (!f) return 0;\n";
    s = s + "  fprintf(f, \"KENGA_TENSOR 1\\n%d\\n\", t->rank);\n";
    s = s + "  for (i = 0; i < t->rank; i++) {\n";
    s = s + "    if (i) fputc(' ', f);\n";
    s = s + "    fprintf(f, \"%d\", t->shape[i]);\n";
    s = s + "  }\n";
    s = s + "  fputc('\\n', f);\n";
    s = s + "  for (i = 0; i < t->n; i++) {\n";
    s = s + "    if (i) fputc(' ', f);\n";
    s = s + "    fprintf(f, \"%.17g\", t->data[i]);\n";
    s = s + "  }\n";
    s = s + "  fputc('\\n', f);\n";
    s = s + "  fclose(f);\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_load_tensor(const char *path) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\");\n";
    s = s + "  char magic[32];\n";
    s = s + "  int ver = 0, rank = 0, i, shape[TL_RANK_MAX], n;\n";
    s = s + "  int64_t h;\n";
    s = s + "  Tensor *t;\n";
    s = s + "  if (!f) die(\"load_tensor: cannot open\");\n";
    s = s + "  if (fscanf(f, \"%31s %d\", magic, &ver) != 2 || strcmp(magic, \"KENGA_TENSOR\") != 0 || ver != 1) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    die(\"load_tensor: bad header\");\n";
    s = s + "  }\n";
    s = s + "  if (fscanf(f, \"%d\", &rank) != 1 || rank < 0 || rank > TL_RANK_MAX) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    die(\"load_tensor: bad rank\");\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (fscanf(f, \"%d\", &shape[i]) != 1) {\n";
    s = s + "      fclose(f);\n";
    s = s + "      die(\"load_tensor: bad shape\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  n = tl_product(shape, rank);\n";
    s = s + "  h = tl_alloc(shape, rank, 0);\n";
    s = s + "  t = tl_get(h);\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    if (fscanf(f, \"%lf\", &t->data[i]) != 1) {\n";
    s = s + "      fclose(f);\n";
    s = s + "      die(\"load_tensor: bad data\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  fclose(f);\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_softmax(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int64_t h = tl_clone_shape_data(a->shape, a->rank, a->data, a->n);\n";
    s = s + "  Tensor *o = tl_get(h);\n";
    s = s + "  double mx = -1e300, sum = 0.0;\n";
    s = s + "  int i;\n";
    s = s + "  if (o->n < 1) return h;\n";
    s = s + "  for (i = 0; i < o->n; i++)\n";
    s = s + "    if (o->data[i] > mx) mx = o->data[i];\n";
    s = s + "  for (i = 0; i < o->n; i++) {\n";
    s = s + "    o->data[i] = exp(o->data[i] - mx);\n";
    s = s + "    sum += o->data[i];\n";
    s = s + "  }\n";
    s = s + "  if (sum < 1e-300) sum = 1e-300;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] /= sum;\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void tl_print(const Tensor *t) {\n";
    s = s + "  int i;\n";
    s = s + "  printf(\"Tensor(shape=[\");\n";
    s = s + "  for (i = 0; i < t->rank; i++) {\n";
    s = s + "    if (i) printf(\", \");\n";
    s = s + "    printf(\"%d\", t->shape[i]);\n";
    s = s + "  }\n";
    s = s + "  printf(\"], len=%d)\", t->n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static unsigned char *tl_read_bytes(const char *path, size_t *out_len) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\");\n";
    s = s + "  char alt[512];\n";
    s = s + "  long sz;\n";
    s = s + "  unsigned char *buf;\n";
    s = s + "  if (!f && path[0] == '.' && path[1] == '.' && (path[2] == '/' || path[2] == '\\\\'))\n";
    s = s + "    f = fopen(path + 3, \"rb\");\n";
    s = s + "  if (!f && strlen(path) + 4 < sizeof(alt)) {\n";
    s = s + "    alt[0] = '.'; alt[1] = '.'; alt[2] = '/';\n";
    s = s + "    memcpy(alt + 3, path, strlen(path) + 1);\n";
    s = s + "    f = fopen(alt, \"rb\");\n";
    s = s + "  }\n";
    s = s + "  if (!f) return NULL;\n";
    s = s + "  if (fseek(f, 0, SEEK_END) != 0) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  sz = ftell(f);\n";
    s = s + "  if (sz < 0) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  rewind(f);\n";
    s = s + "  buf = (unsigned char *)malloc((size_t)sz + 1);\n";
    s = s + "  if (!buf) {\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) {\n";
    s = s + "    free(buf);\n";
    s = s + "    fclose(f);\n";
    s = s + "    return NULL;\n";
    s = s + "  }\n";
    s = s + "  fclose(f);\n";
    s = s + "  if (out_len) *out_len = (size_t)sz;\n";
    s = s + "  return buf;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static void tl_skip_ws_comments(const unsigned char *b, size_t n, size_t *i) {\n";
    s = s + "  for (;;) {\n";
    s = s + "    while (*i < n && (b[*i] == ' ' || b[*i] == '\\t' || b[*i] == '\\r' || b[*i] == '\\n')) (*i)++;\n";
    s = s + "    if (*i < n && b[*i] == '#') {\n";
    s = s + "      while (*i < n && b[*i] != '\\n') (*i)++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    break;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int tl_read_token(const unsigned char *b, size_t n, size_t *i, char *out, size_t outcap) {\n";
    s = s + "  size_t start, len;\n";
    s = s + "  tl_skip_ws_comments(b, n, i);\n";
    s = s + "  start = *i;\n";
    s = s + "  while (*i < n && b[*i] != ' ' && b[*i] != '\\t' && b[*i] != '\\r' && b[*i] != '\\n' && b[*i] != '#')\n";
    s = s + "    (*i)++;\n";
    s = s + "  if (start == *i) return 0;\n";
    s = s + "  len = *i - start;\n";
    s = s + "  if (len + 1 > outcap) len = outcap - 1;\n";
    s = s + "  memcpy(out, b + start, len);\n";
    s = s + "  out[len] = 0;\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* P6 binary PPM → Tensor [h,w,3] in 0..1 */\n";
    s = s + "static int64_t tl_load_ppm(const char *path) {\n";
    s = s + "  size_t n = 0, i = 0;\n";
    s = s + "  unsigned char *b = tl_read_bytes(path, &n);\n";
    s = s + "  char tok[64];\n";
    s = s + "  int w, h, maxv, need, p;\n";
    s = s + "  int shape[3];\n";
    s = s + "  int64_t th;\n";
    s = s + "  Tensor *t;\n";
    s = s + "  if (!b) die(\"load_ppm: cannot read file\");\n";
    s = s + "  if (!tl_read_token(b, n, &i, tok, sizeof(tok)) || strcmp(tok, \"P6\") != 0) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: only P6 binary PPM supported\");\n";
    s = s + "  }\n";
    s = s + "  if (!tl_read_token(b, n, &i, tok, sizeof(tok))) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: bad width\");\n";
    s = s + "  }\n";
    s = s + "  w = atoi(tok);\n";
    s = s + "  if (!tl_read_token(b, n, &i, tok, sizeof(tok))) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: bad height\");\n";
    s = s + "  }\n";
    s = s + "  h = atoi(tok);\n";
    s = s + "  if (!tl_read_token(b, n, &i, tok, sizeof(tok))) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: bad maxval\");\n";
    s = s + "  }\n";
    s = s + "  maxv = atoi(tok);\n";
    s = s + "  if (w < 1 || h < 1 || maxv < 1) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: bad header nums\");\n";
    s = s + "  }\n";
    s = s + "  if (i < n && (b[i] == ' ' || b[i] == '\\t' || b[i] == '\\r' || b[i] == '\\n')) i++;\n";
    s = s + "  need = w * h * 3;\n";
    s = s + "  if (n < i + (size_t)need) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_ppm: truncated pixel data\");\n";
    s = s + "  }\n";
    s = s + "  shape[0] = h;\n";
    s = s + "  shape[1] = w;\n";
    s = s + "  shape[2] = 3;\n";
    s = s + "  th = tl_alloc(shape, 3, 0);\n";
    s = s + "  t = tl_get(th);\n";
    s = s + "  for (p = 0; p < need; p++) t->data[p] = (double)b[i + (size_t)p] / (double)maxv;\n";
    s = s + "  free(b);\n";
    s = s + "  return th;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static uint32_t tl_u32le(const unsigned char *p) {\n";
    s = s + "  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static uint16_t tl_u16le(const unsigned char *p) {\n";
    s = s + "  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* PCM16 WAV → Tensor [n] in -1..1 (first channel) */\n";
    s = s + "static int64_t tl_load_wav(const char *path) {\n";
    s = s + "  size_t n = 0, pos = 12;\n";
    s = s + "  unsigned char *b = tl_read_bytes(path, &n);\n";
    s = s + "  uint16_t channels = 1, bits = 16;\n";
    s = s + "  size_t data_off = 0, data_len = 0;\n";
    s = s + "  int samples, s, shape[1];\n";
    s = s + "  int64_t th;\n";
    s = s + "  Tensor *t;\n";
    s = s + "  if (!b) die(\"load_wav: cannot read file\");\n";
    s = s + "  if (n < 44 || memcmp(b, \"RIFF\", 4) != 0 || memcmp(b + 8, \"WAVE\", 4) != 0) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_wav: not a RIFF/WAVE file\");\n";
    s = s + "  }\n";
    s = s + "  while (pos + 8 <= n) {\n";
    s = s + "    unsigned char *id = b + pos;\n";
    s = s + "    uint32_t size = tl_u32le(b + pos + 4);\n";
    s = s + "    size_t chunk = pos + 8;\n";
    s = s + "    if (memcmp(id, \"fmt \", 4) == 0) {\n";
    s = s + "      uint16_t format;\n";
    s = s + "      if (size < 16 || chunk + 16 > n) {\n";
    s = s + "        free(b);\n";
    s = s + "        die(\"load_wav: bad fmt chunk\");\n";
    s = s + "      }\n";
    s = s + "      format = tl_u16le(b + chunk);\n";
    s = s + "      if (format != 1) {\n";
    s = s + "        free(b);\n";
    s = s + "        die(\"load_wav: only PCM format=1\");\n";
    s = s + "      }\n";
    s = s + "      channels = tl_u16le(b + chunk + 2);\n";
    s = s + "      bits = tl_u16le(b + chunk + 14);\n";
    s = s + "    } else if (memcmp(id, \"data\", 4) == 0) {\n";
    s = s + "      data_off = chunk;\n";
    s = s + "      data_len = size;\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    pos = chunk + size + (size % 2);\n";
    s = s + "  }\n";
    s = s + "  if (data_off == 0 || bits != 16) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_wav: need 16-bit PCM data chunk\");\n";
    s = s + "  }\n";
    s = s + "  if (data_off + data_len > n) {\n";
    s = s + "    free(b);\n";
    s = s + "    die(\"load_wav: truncated data\");\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    int step = channels < 1 ? 1 : (int)channels;\n";
    s = s + "    samples = (int)(data_len / 2 / (size_t)step);\n";
    s = s + "    if (samples < 1) samples = 0;\n";
    s = s + "    if (samples > TL_ELEMS_MAX) {\n";
    s = s + "      free(b);\n";
    s = s + "      die(\"load_wav: too many samples\");\n";
    s = s + "    }\n";
    s = s + "    shape[0] = samples;\n";
    s = s + "    th = tl_alloc(shape, 1, 0);\n";
    s = s + "    t = tl_get(th);\n";
    s = s + "    for (s = 0; s < samples; s++) {\n";
    s = s + "      size_t off = data_off + (size_t)s * (size_t)step * 2;\n";
    s = s + "      int16_t sample = (int16_t)tl_u16le(b + off);\n";
    s = s + "      t->data[s] = (double)sample / 32768.0;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  free(b);\n";
    s = s + "  return th;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* Mean: rank3 → [c]; rank2 → [1]; else → caller gets F64 via out_is_f64 */\n";
    s = s + "static int64_t tl_mean_tensor(int64_t ha, double *out_f64, int *is_f64) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  *is_f64 = 0;\n";
    s = s + "  if (a->rank == 3) {\n";
    s = s + "    int h = a->shape[0], w = a->shape[1], c = a->shape[2];\n";
    s = s + "    double n = (double)(h * w);\n";
    s = s + "    double *ad = a->data;\n";
    s = s + "    int shape[1];\n";
    s = s + "    int64_t oh;\n";
    s = s + "    Tensor *o;\n";
    s = s + "    int y, x, ch;\n";
    s = s + "    shape[0] = c;\n";
    s = s + "    oh = tl_zeros(shape, 1);\n";
    s = s + "    o = tl_get(oh);\n";
    s = s + "    for (y = 0; y < h; y++)\n";
    s = s + "      for (x = 0; x < w; x++)\n";
    s = s + "        for (ch = 0; ch < c; ch++) o->data[ch] += ad[(y * w + x) * c + ch];\n";
    s = s + "    for (ch = 0; ch < c; ch++) o->data[ch] /= n > 0.0 ? n : 1.0;\n";
    s = s + "    return oh;\n";
    s = s + "  }\n";
    s = s + "  if (a->rank == 2) {\n";
    s = s + "    double s = 0.0;\n";
    s = s + "    double *ad = a->data;\n";
    s = s + "    int i, an = a->n, shape[1] = {1};\n";
    s = s + "    int64_t oh;\n";
    s = s + "    for (i = 0; i < an; i++) s += ad[i];\n";
    s = s + "    oh = tl_zeros(shape, 1);\n";
    s = s + "    tl_get(oh)->data[0] = s / (an > 0 ? (double)an : 1.0);\n";
    s = s + "    return oh;\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    double s = 0.0;\n";
    s = s + "    int i;\n";
    s = s + "    for (i = 0; i < a->n; i++) s += a->data[i];\n";
    s = s + "    *out_f64 = s / (a->n > 0 ? (double)a->n : 1.0);\n";
    s = s + "    *is_f64 = 1;\n";
    s = s + "    return -1;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static double tl_mse_ids(int64_t ha, int64_t hb) {\n";
    s = s + "  Tensor *a = tl_get(ha), *b = tl_get(hb);\n";
    s = s + "  double s = 0.0;\n";
    s = s + "  int i, n;\n";
    s = s + "  if (a->n != b->n) die(\"t_mse size mismatch\");\n";
    s = s + "  n = a->n > 0 ? a->n : 1;\n";
    s = s + "  for (i = 0; i < a->n; i++) {\n";
    s = s + "    double d = a->data[i] - b->data[i];\n";
    s = s + "    s += d * d;\n";
    s = s + "  }\n";
    s = s + "  return s / (double)n;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int64_t tl_clone_h(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  return tl_clone_shape_data(a->shape, a->rank, a->data, a->n);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* Ensure (n,) or (n,1) → (n,1) clone. */\n";
    s = s + "static int64_t tl_ensure_col(int64_t ha) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int shape[2];\n";
    s = s + "  if (a->rank == 1) {\n";
    s = s + "    shape[0] = a->shape[0];\n";
    s = s + "    shape[1] = 1;\n";
    s = s + "    return tl_clone_shape_data(shape, 2, a->data, a->n);\n";
    s = s + "  }\n";
    s = s + "  if (a->rank == 2 && a->shape[1] == 1) return tl_clone_h(ha);\n";
    s = s + "  die(\"expected vector or column (n,)/(n,1)\");\n";
    s = s + "  return -1;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* dL/dW for pred=W@x, L=mse(pred,y): err @ x^T */\n";
    s = s + "static int64_t tl_linear_grad(int64_t hw, int64_t hx, int64_t hy) {\n";
    s = s + "  int64_t xcol = tl_ensure_col(hx);\n";
    s = s + "  int64_t ycol = tl_ensure_col(hy);\n";
    s = s + "  int64_t pred = tl_matmul(hw, xcol);\n";
    s = s + "  int64_t err = tl_ew(pred, ycol, tl_op_sub);\n";
    s = s + "  int64_t xt = tl_transpose(xcol);\n";
    s = s + "  return tl_matmul(err, xt);\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "/* Non-overlapping mean pool [h,w,c] → [gh,gw,c] */\n";
    s = s + "static int64_t tl_patch_mean(int64_t ha, int gh, int gw) {\n";
    s = s + "  Tensor *a = tl_get(ha);\n";
    s = s + "  int h, w, c, ph, pw, gy, gx, ch, y, x;\n";
    s = s + "  int oshape[3];\n";
    s = s + "  int64_t oh;\n";
    s = s + "  Tensor *o;\n";
    s = s + "  if (gh <= 0 || gw <= 0) die(\"t_patch_mean grid must be > 0\");\n";
    s = s + "  if (a->rank != 3) die(\"t_patch_mean expects Tensor [h,w,c]\");\n";
    s = s + "  h = a->shape[0];\n";
    s = s + "  w = a->shape[1];\n";
    s = s + "  c = a->shape[2];\n";
    s = s + "  ph = h / gh;\n";
    s = s + "  pw = w / gw;\n";
    s = s + "  if (ph == 0 || pw == 0) die(\"t_patch_mean: image smaller than grid\");\n";
    s = s + "  oshape[0] = gh;\n";
    s = s + "  oshape[1] = gw;\n";
    s = s + "  oshape[2] = c;\n";
    s = s + "  {\n";
    s = s + "    double *ad = a->data;\n";
    s = s + "    oh = tl_zeros(oshape, 3);\n";
    s = s + "    o = tl_get(oh);\n";
    s = s + "    for (gy = 0; gy < gh; gy++) {\n";
    s = s + "      for (gx = 0; gx < gw; gx++) {\n";
    s = s + "        for (ch = 0; ch < c; ch++) {\n";
    s = s + "          double s = 0.0, n = 0.0;\n";
    s = s + "          for (y = gy * ph; y < (gy + 1) * ph; y++) {\n";
    s = s + "            for (x = gx * pw; x < (gx + 1) * pw; x++) {\n";
    s = s + "              s += ad[(y * w + x) * c + ch];\n";
    s = s + "              n += 1.0;\n";
    s = s + "            }\n";
    s = s + "          }\n";
    s = s + "          o->data[(gy * gw + gx) * c + ch] = s / (n > 0.0 ? n : 1.0);\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return oh;\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "#endif /* KENGA_TENSOR_LITE_INC */\n";
    assert(write_file("bootstrap/generated/rt_tensor.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_tensor.inc.c");
    println("rt_tensor ok");
    return 0;
}
