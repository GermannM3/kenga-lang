// Emit type-annot skip + brace matching for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_scan.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_scan.kenga — do not hand-edit */\n";
    s = s + "static size_t skip_type_annot(const char *s, size_t i, size_t n) {\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i >= n || s[i] != ':') return i;\n";
    s = s + "  i = skip(s, i + 1, n);\n";
    s = s + "  if (i >= n || !is_ident_start(s[i])) die(\"expected type after :\");\n";
    s = s + "  Ident ty = parse_ident(s, i, n);\n";
    s = s + "  free(ty.name);\n";
    s = s + "  i = skip(s, ty.i, n);\n";
    s = s + "  if (starts_kw(s, i, n, \"ttl\")) {\n";
    s = s + "    i = skip(s, i + 3, n);\n";
    s = s + "    if (i >= n || !isdigit((unsigned char)s[i])) die(\"expected duration after ttl\");\n";
    s = s + "    while (i < n && isdigit((unsigned char)s[i])) i++;\n";
    s = s + "    if (i + 1 < n && s[i] == 'm' && s[i + 1] == 's') i += 2;\n";
    s = s + "    else if (i < n && (s[i] == 's' || s[i] == 'm' || s[i] == 'h' || s[i] == 'd')) i++;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static char *slice_dup(const char *s, size_t a, size_t b) {\n";
    s = s + "  size_t len = b - a;\n";
    s = s + "  char *o = (char *)malloc(len + 1);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  memcpy(o, s + a, len);\n";
    s = s + "  o[len] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n";
    s = s + "static size_t match_brace_block(const char *s, size_t i, size_t n) {\n";
    s = s + "  int depth;\n";
    s = s + "  if (i >= n || s[i] != '{') die(\"expected {\");\n";
    s = s + "  depth = 0;\n";
    s = s + "  while (i < n) {\n";
    s = s + "    char c = s[i];\n";
    s = s + "    if (c == '/' && i + 1 < n && s[i + 1] == '/') {\n";
    s = s + "      i += 2;\n";
    s = s + "      while (i < n && s[i] != '\\n') i++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (c == '\"') {\n";
    s = s + "      i++;\n";
    s = s + "      while (i < n && s[i] != '\"') {\n";
    s = s + "        if (s[i] == '\\\\' && i + 1 < n) i += 2;\n";
    s = s + "        else i++;\n";
    s = s + "      }\n";
    s = s + "      if (i < n) i++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (c == '{') { depth++; i++; continue; }\n";
    s = s + "    if (c == '}') {\n";
    s = s + "      depth--; i++;\n";
    s = s + "      if (depth == 0) return i;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    i++;\n";
    s = s + "  }\n";
    s = s + "  die(\"unclosed brace block\");\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_scan.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_scan.inc.c");
    println("rt_scan ok");
    return 0;
}
