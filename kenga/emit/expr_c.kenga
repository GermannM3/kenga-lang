// Emit step: Kenga writes a standalone C99 main for a pure i64 expression.
// No Rust. Next ladder rung: emit stmts/control from more's dialect.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\expr_c.kenga

fn emit_c_expr_program(expr_c: str, want: i64) -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/expr_c.kenga — no Rust */\n";
    s = s + "#include <stdio.h>\n";
    s = s + "#include <stdint.h>\n";
    s = s + "int main(void) {\n";
    s = s + "  int64_t r = ";
    s = s + expr_c;
    s = s + ";\n";
    s = s + "  printf(\"%lld\\n\", (long long)r);\n";
    s = s + "  if (r != ";
    // want as decimal digits
    let digs: str = "0123456789";
    let n: i64 = want;
    let w: str = "";
    if n == 0 { w = "0"; }
    while n > 0 {
        let d: i64 = n - (n / 10) * 10;
        w = digs[d] + w;
        n = n / 10;
    }
    s = s + w;
    s = s + "LL) return 1;\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    return s;
}

fn main() -> i64 {
    let src = emit_c_expr_program("(2 + 3) * 4", 20);
    assert(write_file("bootstrap/bin/expr_from_kenga.c", src) == true);
    let back = read_file("bootstrap/bin/expr_from_kenga.c");
    assert(len(back) > 80);
    println("wrote bootstrap/bin/expr_from_kenga.c");
    println("expr_c ok");
    return 0;
}
