// Parse tiny Kenga source → bytecode → C VM driver (no hand-assembled ops).
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\bc_src_c.kenga

fn OP_CONST() -> i64 { return 1; }
fn OP_LOAD() -> i64 { return 2; }
fn OP_STORE() -> i64 { return 3; }
fn OP_ADD() -> i64 { return 4; }
fn OP_MUL() -> i64 { return 6; }
fn OP_LT() -> i64 { return 8; }
fn OP_GT() -> i64 { return 9; }
fn OP_EQ() -> i64 { return 10; }
fn OP_NE() -> i64 { return 25; }
fn OP_JMP() -> i64 { return 11; }
fn OP_JMPF() -> i64 { return 12; }
fn OP_HALT() -> i64 { return 13; }
fn OP_CALL() -> i64 { return 15; }
fn OP_RET() -> i64 { return 16; }
fn OP_PRINTLN() -> i64 { return 17; }
fn OP_ASSERT() -> i64 { return 18; }
fn OP_PRINT_STR() -> i64 { return 32; }
fn OP_CONST_F64() -> i64 { return 33; }
fn OP_ROUND() -> i64 { return 19; }
fn OP_LIST_NEW() -> i64 { return 21; }
fn OP_LIST_PUSH() -> i64 { return 22; }
fn OP_LEN() -> i64 { return 23; }
fn OP_GET() -> i64 { return 24; }
fn OP_SET() -> i64 { return 28; }

fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let s: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        s = digs[d] + s;
        x = x / 10;
    }
    if n < 0 { return "-" + s; }
    return s;
}

fn emit_code(code: list) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < len(code) {
        if i > 0 { s = s + ", "; }
        s = s + itoa(code[i]);
        i = i + 1;
    }
    return s;
}

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}

fn slot_of(vnames: list, name: str) -> list {
    let i: i64 = 0;
    while i < len(vnames) {
        if vnames[i] == name { return [i, vnames]; }
        i = i + 1;
    }
    vnames = push(vnames, name);
    return [len(vnames) - 1, vnames];
}
fn emit2(code: list, a: i64, b: i64) -> list {
    code = push(code, a);
    return push(code, b);
}
fn emit3(code: list, a: i64, b: i64, c: i64) -> list {
    code = push(code, a);
    code = push(code, b);
    return push(code, c);
}

fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i);
    let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch;
        i = i + 1;
    }
    return [name, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\"" { return [out, i + 1]; }
        if s[i] == "\\" {
            if i + 1 < len(s) {
                out = out + s[i + 1];
                i = i + 2;
                continue;
            }
        }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn c_escape(s: str) -> str {
    let out: str = "";
    let i: i64 = 0;
    while i < len(s) {
        if s[i] == "\\" {
            out = out + "\\\\";
        } else {
            if s[i] == "\"" {
                out = out + "\\\"";
            } else {
                if s[i] == "\n" {
                    out = out + "\\n";
                } else {
                    out = out + s[i];
                }
            }
        }
        i = i + 1;
    }
    return out;
}
fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    let start: i64 = i;
    while i < len(s) {
        if is_digit(s[i]) == 0 { break; }
        v = v * 10 + (ord(s[i]) - 48);
        i = i + 1;
    }
    if i < len(s) {
        if s[i] == "." {
            if i + 1 < len(s) {
                if s[i + 1] == "." { return [0, v, i]; }
            }
            let lit: str = "";
            let j: i64 = start;
            while j < i { lit = lit + s[j]; j = j + 1; }
            lit = lit + ".";
            i = i + 1;
            while i < len(s) {
                if is_digit(s[i]) == 0 { break; }
                lit = lit + s[i];
                i = i + 1;
            }
            return [1, lit, i];
        }
    }
    return [0, v, i];
}

fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(1 == 0);
    return i;
}

fn fn_index(fnames: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fnames) {
        if fnames[i] == name { return i; }
        i = i + 1;
    }
    return -1;
}

fn emit_factor(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    i = skip(s, i);
    if s[i] == "[" {
        i = i + 1;
        code = push(code, OP_LIST_NEW());
        i = skip(s, i);
        if s[i] != "]" {
            while true {
                let ar = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
                code = push(ar[0], OP_LIST_PUSH());
                i = ar[1]; vnames = ar[2];
                i = skip(s, i);
                if s[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(s[i] == "]");
        i = i + 1;
    } else {
        if is_alpha(s[i]) == 1 {
            let id = parse_ident(s, i);
            let j: i64 = skip(s, id[1]);
            if j < len(s) {
                if s[j] == "(" {
                    j = j + 1;
                    if id[0] == "round" {
                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                        code = ar[0]; j = ar[1]; vnames = ar[2];
                        j = skip(s, j);
                        assert(s[j] == ")");
                        j = j + 1;
                        code = push(code, OP_ROUND());
                        i = j;
                    } else {
                        if id[0] == "len" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_LEN());
                            i = j;
                        } else {
                            if id[0] == "push" {
                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ",");
                                j = j + 1;
                                ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ")");
                                j = j + 1;
                                code = push(code, OP_LIST_PUSH());
                                i = j;
                            } else {
                                let argc: i64 = 0;
                                j = skip(s, j);
                                if s[j] != ")" {
                                    while true {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                        code = ar[0]; j = ar[1]; vnames = ar[2];
                                        argc = argc + 1;
                                        j = skip(s, j);
                                        if s[j] == "," { j = j + 1; continue; }
                                        break;
                                    }
                                }
                                assert(s[j] == ")");
                                j = j + 1;
                                let fi: i64 = fn_index(fnames, id[0]);
                                assert(fi >= 0);
                                assert(fargc[fi] == argc);
                                code = emit3(code, OP_CALL(), faddrs[fi], argc);
                                i = j;
                            }
                        }
                    }
                } else {
                    let sl = slot_of(vnames, id[0]);
                    code = emit2(code, OP_LOAD(), sl[0]);
                    i = id[1]; vnames = sl[1];
                }
            } else {
                let sl = slot_of(vnames, id[0]);
                code = emit2(code, OP_LOAD(), sl[0]);
                i = id[1]; vnames = sl[1];
            }
        } else {
            let n = parse_number(s, i);
            if n[0] == 1 {
                let floats = strbox[1];
                floats = push(floats, n[1]);
                strbox[1] = floats;
                code = emit2(code, OP_CONST_F64(), len(floats) - 1);
            } else {
                code = emit2(code, OP_CONST(), n[1]);
            }
            i = n[2];
        }
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "[" { break; }
        let ix = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = ix[0]; i = ix[1]; vnames = ix[2];
        i = skip(s, i);
        assert(s[i] == "]");
        i = i + 1;
        code = push(code, OP_GET());
    }
    return [code, i, vnames];
}

fn emit_term(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_factor(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "*" {
            r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_MUL());
            i = r[1]; vnames = r[2];
        } else { break; }
    }
    return [code, i, vnames];
}

fn emit_sum(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_term(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "+" {
            r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_ADD());
            i = r[1]; vnames = r[2];
        } else { break; }
    }
    return [code, i, vnames];
}

fn emit_cmp(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    i = skip(s, i);
    if i >= len(s) { return [code, i, vnames]; }
    if starts_with(s, i, "==") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_EQ());
        return [code, r[1], r[2]];
    }
    if starts_with(s, i, "!=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_NE());
        return [code, r[1], r[2]];
    }
    if s[i] == "<" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_LT());
        return [code, r[1], r[2]];
    }
    if s[i] == ">" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_GT());
        return [code, r[1], r[2]];
    }
    return [code, i, vnames];
}

fn loops_pop(loops: list) -> list {
    let n: i64 = len(loops);
    assert(n > 0);
    let out: list = [];
    let i: i64 = 0;
    while i < n - 1 {
        out = push(out, loops[i]);
        i = i + 1;
    }
    return out;
}
fn patch_jmp_sites(code: list, sites: list, target: i64) -> list {
    let i: i64 = 0;
    while i < len(sites) {
        code[sites[i]] = target;
        i = i + 1;
    }
    return code;
}

fn emit_stmt(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, loops: list, strbox: list) -> list {
    i = skip(s, i);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        if i < len(s) {
            if s[i] == ":" {
                i = i + 1;
                let ty = parse_ident(s, i);
                i = skip(s, ty[1]);
            }
        }
        assert(s[i] == "=");
        i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let sl = slot_of(vnames, id[0]);
        vnames = sl[1];
        code = emit2(code, OP_STORE(), sl[0]);
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let lo = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = lo[0]; i = lo[1]; vnames = lo[2];
        i = skip(s, i);
        if starts_with(s, i, "..") == 1 {
            // for v in lo..hi
            let sl = slot_of(vnames, id[0]);
            vnames = sl[1];
            code = emit2(code, OP_STORE(), sl[0]);
            i = i + 2;
            let hi_slot_name: str = "__hi" + itoa(len(vnames));
            let hi = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
            code = hi[0]; i = hi[1]; vnames = hi[2];
            let hs = slot_of(vnames, hi_slot_name);
            vnames = hs[1];
            code = emit2(code, OP_STORE(), hs[0]);
            let loop_start: i64 = len(code);
            code = emit2(code, OP_LOAD(), sl[0]);
            code = emit2(code, OP_LOAD(), hs[0]);
            code = push(code, OP_LT());
            let jmpf_at: i64 = len(code);
            code = emit2(code, OP_JMPF(), 0);
            loops = push(loops, [[], []]);
            i = skip(s, i);
            let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
            code = body[0]; i = body[1]; vnames = body[2];
            let top: i64 = len(loops) - 1;
            let frame = loops[top];
            let cont_ip: i64 = len(code);
            code = patch_jmp_sites(code, frame[0], cont_ip);
            code = emit2(code, OP_LOAD(), sl[0]);
            code = emit2(code, OP_CONST(), 1);
            code = push(code, OP_ADD());
            code = emit2(code, OP_STORE(), sl[0]);
            code = emit2(code, OP_JMP(), loop_start);
            let end_ip: i64 = len(code);
            code[jmpf_at + 1] = end_ip;
            code = patch_jmp_sites(code, frame[1], end_ip);
            loops = loops_pop(loops);
            return [code, i, vnames];
        }
        // for v in xs
        let xs_name: str = "__xs" + itoa(len(vnames));
        let ix_name: str = "__xi" + itoa(len(vnames));
        let xs = slot_of(vnames, xs_name);
        vnames = xs[1];
        code = emit2(code, OP_STORE(), xs[0]);
        let ix = slot_of(vnames, ix_name);
        vnames = ix[1];
        code = emit2(code, OP_CONST(), 0);
        code = emit2(code, OP_STORE(), ix[0]);
        let vsl = slot_of(vnames, id[0]);
        vnames = vsl[1];
        let loop_start: i64 = len(code);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = emit2(code, OP_LOAD(), xs[0]);
        code = push(code, OP_LEN());
        code = push(code, OP_LT());
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        code = emit2(code, OP_LOAD(), xs[0]);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = push(code, OP_GET());
        code = emit2(code, OP_STORE(), vsl[0]);
        loops = push(loops, [[], []]);
        i = skip(s, i);
        let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = body[0]; i = body[1]; vnames = body[2];
        let top2: i64 = len(loops) - 1;
        let frame2 = loops[top2];
        let cont_ip2: i64 = len(code);
        code = patch_jmp_sites(code, frame2[0], cont_ip2);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = emit2(code, OP_CONST(), 1);
        code = push(code, OP_ADD());
        code = emit2(code, OP_STORE(), ix[0]);
        code = emit2(code, OP_JMP(), loop_start);
        let end_ip2: i64 = len(code);
        code[jmpf_at + 1] = end_ip2;
        code = patch_jmp_sites(code, frame2[1], end_ip2);
        loops = loops_pop(loops);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "while") == 1 {
        let loop_start: i64 = len(code);
        i = skip(s, i + 5);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        loops = push(loops, [[], []]);
        i = skip(s, i);
        let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = body[0]; i = body[1]; vnames = body[2];
        let top3: i64 = len(loops) - 1;
        let frame3 = loops[top3];
        code = patch_jmp_sites(code, frame3[0], loop_start);
        code = emit2(code, OP_JMP(), loop_start);
        let end_ip3: i64 = len(code);
        code[jmpf_at + 1] = end_ip3;
        code = patch_jmp_sites(code, frame3[1], end_ip3);
        loops = loops_pop(loops);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "if") == 1 {
        i = skip(s, i + 2);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        i = skip(s, i);
        assert(s[i] == "{");
        let th = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = th[0]; i = th[1]; vnames = th[2];
        let jmp_end: i64 = len(code);
        code = emit2(code, OP_JMP(), 0);
        code[jmpf_at + 1] = len(code);
        i = skip(s, i);
        if starts_kw(s, i, "else") == 1 {
            i = skip(s, i + 4);
            if starts_kw(s, i, "if") == 1 {
                let el = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
                code = el[0]; i = el[1]; vnames = el[2];
            } else {
                let el = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
                code = el[0]; i = el[1]; vnames = el[2];
            }
        }
        code[jmp_end + 1] = len(code);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "break") == 1 {
        assert(len(loops) > 0);
        let top4: i64 = len(loops) - 1;
        code = emit2(code, OP_JMP(), 0);
        let brks = loops[top4][1];
        brks = push(brks, len(code) - 1);
        loops[top4] = [loops[top4][0], brks];
        i = skip(s, i + 5);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "continue") == 1 {
        assert(len(loops) > 0);
        let top5: i64 = len(loops) - 1;
        code = emit2(code, OP_JMP(), 0);
        let conts = loops[top5][0];
        conts = push(conts, len(code) - 1);
        loops[top5] = [conts, loops[top5][1]];
        i = skip(s, i + 8);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6);
        assert(s[i] == "(");
        i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        i = skip(s, i);
        assert(s[i] == ")");
        i = i + 1;
        code = push(code, OP_ASSERT());
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7);
        assert(s[i] == "(");
        i = i + 1;
        i = skip(s, i);
        if s[i] == "\"" {
            let ps = parse_string(s, i);
            let strs = strbox[0];
            strs = push(strs, ps[0]);
            strbox[0] = strs;
            code = emit2(code, OP_PRINT_STR(), len(strs) - 1);
            i = skip(s, ps[1]);
            assert(s[i] == ")");
            i = i + 1;
        } else {
            let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
            code = r[0]; i = r[1]; vnames = r[2];
            i = skip(s, i);
            assert(s[i] == ")");
            i = i + 1;
            code = push(code, OP_PRINTLN());
        }
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "return") == 1 {
        i = skip(s, i + 6);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        code = push(code, OP_RET());
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let sl = slot_of(vnames, id[0]);
                vnames = sl[1];
                code = emit2(code, OP_LOAD(), sl[0]);
                j = j + 1;
                let ix = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                code = ix[0]; j = ix[1]; vnames = ix[2];
                j = skip(s, j);
                assert(s[j] == "]");
                j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, strbox);
                        code = r[0]; j = r[1]; vnames = r[2];
                        code = push(code, OP_SET());
                        j = skip(s, j);
                        if j < len(s) { if s[j] == ";" { j = j + 1; } }
                        return [code, j, vnames];
                    }
                }
                let nc: list = [];
                let ki: i64 = 0;
                while ki < len(code) - 2 { nc = push(nc, code[ki]); ki = ki + 1; }
                code = nc;
                i = save;
            } else {
                if s[j] == "=" {
                    let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, strbox);
                    code = r[0]; i = r[1]; vnames = r[2];
                    let sl = slot_of(vnames, id[0]);
                    vnames = sl[1];
                    code = emit2(code, OP_STORE(), sl[0]);
                    i = skip(s, i);
                    if i < len(s) { if s[i] == ";" { i = i + 1; } }
                    return [code, i, vnames];
                }
            }
        }
    }
    let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    i = skip(s, i);
    if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [code, i, vnames];
}

fn compile_body(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, loops: list, strbox: list) -> list {
    i = skip(s, i);
    assert(s[i] == "{");
    i = i + 1;
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = st[0]; i = st[1]; vnames = st[2];
    }
    assert(s[i] == "}");
    return [code, i + 1, vnames];
}

fn compile_src(src: str) -> list {
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "(");
        i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                params = push(params, pn[0]);
                i = skip(src, pn[1]);
                if src[i] == ":" {
                    i = i + 1;
                    let ty = parse_ident(src, i);
                    i = ty[1];
                }
                i = skip(src, i);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
    }

    assert(fn_index(fnames, "main") >= 0);

    let fargc: list = [];
    let fi: i64 = 0;
    while fi < len(fnames) {
        fargc = push(fargc, len(fparams[fi]));
        fi = fi + 1;
    }

    let code: list = emit2([], OP_JMP(), 0);
    let faddrs: list = [];
    let strbox: list = [[], []];
    fi = 0;
    while fi < len(fnames) {
        if fnames[fi] != "main" {
            faddrs = push(faddrs, len(code));
            let vnames: list = [];
            let pi: i64 = 0;
            while pi < len(fparams[fi]) {
                vnames = push(vnames, fparams[fi][pi]);
                pi = pi + 1;
            }
            let bl = compile_body(fbodies[fi], 0, code, vnames, fnames, faddrs, fargc, [], strbox);
            code = bl[0];
            code = push(code, OP_RET());
        } else {
            faddrs = push(faddrs, 0);
        }
        fi = fi + 1;
    }

    let main_ip: i64 = len(code);
    code[1] = main_ip;

    let mi: i64 = fn_index(fnames, "main");
    faddrs[mi] = main_ip;
    let vnames: list = [];
    let bl = compile_body(fbodies[mi], 0, code, vnames, fnames, faddrs, fargc, [], strbox);
    code = bl[0];
    code = push(code, OP_HALT());
    return [code, strbox[0], strbox[1]];
}

fn emit_strs_table(strs: list) -> str {
    if len(strs) == 0 {
        return "static const char *g_strs[] = { \"\" };\n\n";
    }
    let s: str = "static const char *g_strs[] = { ";
    let i: i64 = 0;
    while i < len(strs) {
        if i > 0 { s = s + ", "; }
        s = s + "\"" + c_escape(strs[i]) + "\"";
        i = i + 1;
    }
    s = s + " };\n\n";
    return s;
}

fn emit_f64s_table(floats: list) -> str {
    if len(floats) == 0 {
        return "static const double g_f64s[] = { 0.0 };\n\n";
    }
    let s: str = "static const double g_f64s[] = { ";
    let i: i64 = 0;
    while i < len(floats) {
        if i > 0 { s = s + ", "; }
        s = s + floats[i];
        i = i + 1;
    }
    s = s + " };\n\n";
    return s;
}

fn write_c_driver(code: list, strs: list, floats: list) -> str {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/bc_src_c.kenga — parsed source → bytecode */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <math.h>\n";
    s = s + "#include \"opcodes.inc.c\"\n\n";
    s = s + "typedef struct { int tag; int64_t i; double f; } V;\n";
    s = s + "static V Vi(int64_t x) { V v; v.tag=0; v.i=x; v.f=0; return v; }\n";
    s = s + "static V Vf(double x) { V v; v.tag=1; v.i=0; v.f=x; return v; }\n";
    s = s + "static double as_f(V v) { return v.tag ? v.f : (double)v.i; }\n";
    s = s + "static int64_t as_i(V v) { return v.tag ? (int64_t)llround(v.f) : v.i; }\n\n";
    s = s + "typedef struct { int64_t *d; size_t n, cap; } LObj;\n";
    s = s + "static LObj gL[256];\n";
    s = s + "static int gLn = 0;\n\n";
    s = s + "static int64_t lnew(void) {\n";
    s = s + "  if (gLn >= 256) { fprintf(stderr, \"list heap full\\n\"); exit(1); }\n";
    s = s + "  gL[gLn].d = NULL; gL[gLn].n = 0; gL[gLn].cap = 0;\n";
    s = s + "  return (int64_t)gLn++;\n";
    s = s + "}\n";
    s = s + "static void lgrow(int id) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  size_t nc = L->cap ? L->cap * 2 : 4;\n";
    s = s + "  int64_t *nd = (int64_t*)realloc(L->d, nc * sizeof(int64_t));\n";
    s = s + "  if (!nd) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "  L->d = nd; L->cap = nc;\n";
    s = s + "}\n";
    s = s + "static void lpush(int64_t id, int64_t v) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (L->n >= L->cap) lgrow((int)id);\n";
    s = s + "  L->d[L->n++] = v;\n";
    s = s + "}\n";
    s = s + "static int64_t lget(int64_t id, int64_t i) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (i < 0 || (size_t)i >= L->n) { fprintf(stderr, \"index oob\\n\"); exit(1); }\n";
    s = s + "  return L->d[i];\n";
    s = s + "}\n";
    s = s + "static void lset(int64_t id, int64_t i, int64_t v) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (i < 0 || (size_t)i >= L->n) { fprintf(stderr, \"index oob\\n\"); exit(1); }\n";
    s = s + "  L->d[i] = v;\n";
    s = s + "}\n";
    s = s + "static int64_t llen(int64_t id) {\n";
    s = s + "  return (int64_t)gL[id].n;\n";
    s = s + "}\n\n";
    s = s + emit_strs_table(strs);
    s = s + emit_f64s_table(floats);
    s = s + "static int64_t vm_run(const int64_t *code, int64_t n) {\n";
    s = s + "  V stack[256]; int sp = 0;\n";
    s = s + "  V slots[256]; int64_t slot_used = 0;\n";
    s = s + "  int64_t ret_ips[64]; int rsp = 0;\n";
    s = s + "  int64_t slot_bases[64];\n";
    s = s + "  int64_t slot_base = 0;\n";
    s = s + "  int64_t ip = 0; int i;\n";
    s = s + "  for (i = 0; i < 256; i++) slots[i] = Vi(0);\n";
    s = s + "  while (ip < n) {\n";
    s = s + "    int64_t op = code[ip++];\n";
    s = s + "    if (op == OP_CONST) { stack[sp++] = Vi(code[ip++]); }\n";
    s = s + "    else if (op == OP_CONST_F64) { stack[sp++] = Vf(g_f64s[code[ip++]]); }\n";
    s = s + "    else if (op == OP_LOAD) { stack[sp++] = slots[slot_base + code[ip++]]; }\n";
    s = s + "    else if (op == OP_STORE) { int64_t idx=slot_base+code[ip++]; slots[idx]=stack[--sp]; if (idx+1>slot_used) slot_used=idx+1; }\n";
    s = s + "    else if (op == OP_ADD) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vf(as_f(a)+as_f(b)); else stack[sp++]=Vi(a.i+b.i); }\n";
    s = s + "    else if (op == OP_MUL) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vf(as_f(a)*as_f(b)); else stack[sp++]=Vi(a.i*b.i); }\n";
    s = s + "    else if (op == OP_LT) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vi(as_f(a)<as_f(b)); else stack[sp++]=Vi(a.i<b.i); }\n";
    s = s + "    else if (op == OP_GT) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vi(as_f(a)>as_f(b)); else stack[sp++]=Vi(a.i>b.i); }\n";
    s = s + "    else if (op == OP_EQ) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vi(as_f(a)==as_f(b)); else stack[sp++]=Vi(a.i==b.i); }\n";
    s = s + "    else if (op == OP_NE) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag||b.tag) stack[sp++]=Vi(as_f(a)!=as_f(b)); else stack[sp++]=Vi(a.i!=b.i); }\n";
    s = s + "    else if (op == OP_ROUND) { V x=stack[--sp]; stack[sp++]=Vi((int64_t)llround(as_f(x))); }\n";
    s = s + "    else if (op == OP_JMP) { ip = code[ip]; }\n";
    s = s + "    else if (op == OP_JMPF) { int64_t t=code[ip++]; int64_t c=as_i(stack[--sp]); if (!c) ip = t; }\n";
    s = s + "    else if (op == OP_PRINTLN) { V v=stack[--sp]; if (v.tag) printf(\"%g\\n\", v.f); else printf(\"%lld\\n\", (long long)v.i); }\n";
    s = s + "    else if (op == OP_ASSERT) { if (!as_i(stack[--sp])) { fprintf(stderr, \"assert failed\\n\"); exit(1); } }\n";
    s = s + "    else if (op == OP_PRINT_STR) { puts(g_strs[code[ip++]]); }\n";
    s = s + "    else if (op == OP_LIST_NEW) { stack[sp++] = Vi(lnew()); }\n";
    s = s + "    else if (op == OP_LIST_PUSH) {\n";
    s = s + "      int64_t v = as_i(stack[--sp]); int64_t lid = as_i(stack[--sp]);\n";
    s = s + "      lpush(lid, v); stack[sp++] = Vi(lid);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LEN) { int64_t x = as_i(stack[--sp]); stack[sp++] = Vi(llen(x)); }\n";
    s = s + "    else if (op == OP_GET) {\n";
    s = s + "      int64_t ix = as_i(stack[--sp]); int64_t lid = as_i(stack[--sp]);\n";
    s = s + "      stack[sp++] = Vi(lget(lid, ix));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SET) {\n";
    s = s + "      int64_t v = as_i(stack[--sp]); int64_t ix = as_i(stack[--sp]); int64_t lid = as_i(stack[--sp]);\n";
    s = s + "      lset(lid, ix, v);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_CALL) {\n";
    s = s + "      int64_t addr = code[ip++]; int64_t argc = code[ip++];\n";
    s = s + "      V args[16]; int64_t ai;\n";
    s = s + "      for (ai = argc - 1; ai >= 0; ai--) args[ai] = stack[--sp];\n";
    s = s + "      ret_ips[rsp] = ip; slot_bases[rsp] = slot_base; rsp++;\n";
    s = s + "      slot_base = slot_used;\n";
    s = s + "      for (ai = 0; ai < argc; ai++) {\n";
    s = s + "        slots[slot_base + ai] = args[ai];\n";
    s = s + "        if (slot_base + ai + 1 > slot_used) slot_used = slot_base + ai + 1;\n";
    s = s + "      }\n";
    s = s + "      ip = addr;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_RET) {\n";
    s = s + "      V val = sp > 0 ? stack[--sp] : Vi(0);\n";
    s = s + "      if (rsp == 0) return as_i(val);\n";
    s = s + "      rsp--; slot_base = slot_bases[rsp]; ip = ret_ips[rsp];\n";
    s = s + "      stack[sp++] = val;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_HALT) { return 0; }\n";
    s = s + "    else { fprintf(stderr, \"bad op %lld\\n\", (long long)op); exit(1); }\n";
    s = s + "  }\n";
    s = s + "  return 0;\n}\n\n";
    s = s + "int main(void) {\n";
    s = s + "  static const int64_t code[] = { " + emit_code(code) + " };\n";
    s = s + "  vm_run(code, (int64_t)(sizeof(code)/sizeof(code[0])));\n";
    s = s + "  return 0;\n}\n";
    return s;
}

fn main() -> i64 {
    let src: str = read_file("examples/selfhost/bc_mini.kenga");
    let r = compile_src(src);
    assert(len(r[0]) > 10);
    assert(write_file("bootstrap/generated/bc_from_src.c", write_c_driver(r[0], r[1], r[2])) == true);

    let src2: str = read_file("examples/selfhost/bc_for.kenga");
    let r2 = compile_src(src2);
    assert(write_file("bootstrap/generated/bc_from_for.c", write_c_driver(r2[0], r2[1], r2[2])) == true);

    let src3: str = read_file("examples/selfhost/bc_fn_mini.kenga");
    let r3 = compile_src(src3);
    assert(write_file("bootstrap/generated/bc_from_fn.c", write_c_driver(r3[0], r3[1], r3[2])) == true);

    let src4: str = read_file("examples/selfhost/bc_lists.kenga");
    let r4 = compile_src(src4);
    assert(write_file("bootstrap/generated/bc_from_lists.c", write_c_driver(r4[0], r4[1], r4[2])) == true);

    let src5: str = read_file("examples/selfhost/bc_for_list.kenga");
    let r5 = compile_src(src5);
    assert(write_file("bootstrap/generated/bc_from_for_list.c", write_c_driver(r5[0], r5[1], r5[2])) == true);

    let src6: str = read_file("examples/selfhost/bc_break.kenga");
    let r6 = compile_src(src6);
    assert(write_file("bootstrap/generated/bc_from_break.c", write_c_driver(r6[0], r6[1], r6[2])) == true);

    let src7: str = read_file("examples/selfhost/for_lite.kenga");
    let r7 = compile_src(src7);
    assert(write_file("bootstrap/generated/bc_from_for_lite.c", write_c_driver(r7[0], r7[1], r7[2])) == true);

    let src8: str = read_file("examples/selfhost/lists_lite.kenga");
    let r8 = compile_src(src8);
    assert(write_file("bootstrap/generated/bc_from_lists_lite.c", write_c_driver(r8[0], r8[1], r8[2])) == true);

    let src9: str = read_file("examples/selfhost/bc_elif.kenga");
    let r9 = compile_src(src9);
    assert(write_file("bootstrap/generated/bc_from_elif.c", write_c_driver(r9[0], r9[1], r9[2])) == true);

    let src10: str = read_file("examples/selfhost/elif_lite.kenga");
    let r10 = compile_src(src10);
    assert(write_file("bootstrap/generated/bc_from_elif_lite.c", write_c_driver(r10[0], r10[1], r10[2])) == true);

    let src11: str = read_file("examples/selfhost/float_lite.kenga");
    let r11 = compile_src(src11);
    assert(write_file("bootstrap/generated/bc_from_float_lite.c", write_c_driver(r11[0], r11[1], r11[2])) == true);

    println("wrote bootstrap/generated/bc_from_*.c incl for_lite/lists_lite/elif/elif_lite/float_lite");
    println("bc_src_c ok");
    return 0;
}
