fn OP_ARGC() -> i64 { return 106; }
fn OP_ARG() -> i64 { return 107; }
fn OP_FILE_EXISTS() -> i64 { return 108; }
fn OP_READ_LINE() -> i64 { return 109; }
fn dirname_of(path: str) -> str {
    let i: i64 = len(path) - 1;
    while i >= 0 {
        if path[i] == "/" { break; }
        if path[i] == "\\" { break; }
        i = i - 1;
    }
    if i < 0 { return "."; }
    let out: str = "";
    let j: i64 = 0;
    while j < i { out = out + path[j]; j = j + 1; }
    if len(out) == 0 { return "."; }
    return out;
}
fn join_path(dir: str, rel: str) -> str {
    if len(dir) == 0 { return rel; }
    if dir == "." { return rel; }
    return dir + "/" + rel;
}
fn trim_path(s: str) -> str {
    let n: i64 = len(s);
    let start: i64 = 0;
    while start < n {
        let ch: str = s[start];
        if ch == " " { start = start + 1; continue; }
        if ch == "\t" { start = start + 1; continue; }
        if ch == "\n" { start = start + 1; continue; }
        if ord(ch) == 13 { start = start + 1; continue; }
        break;
    }
    let end: i64 = n - 1;
    while end >= start {
        let ch2: str = s[end];
        if ch2 == " " { end = end - 1; continue; }
        if ch2 == "\t" { end = end - 1; continue; }
        if ch2 == "\n" { end = end - 1; continue; }
        if ord(ch2) == 13 { end = end - 1; continue; }
        break;
    }
    if end < start { return ""; }
    let out: str = "";
    let i: i64 = start;
    while i <= end { out = out + s[i]; i = i + 1; }
    return out;
}
fn resolve_imports(path: str, depth: i64) -> str {
    assert(depth < 32);
    let src: str = read_file(path);
    let dir: str = dirname_of(path);
    let i: i64 = 0;
    let acc: str = "";
    while true {
        i = skip(src, i);
        if starts_kw(src, i, "import") == 0 { break; }
        i = skip(src, i + 6);
        assert(src[i] == "\"");
        let ps = parse_string(src, i);
        i = ps[1];
        i = skip(src, i);
        if i < len(src) { if src[i] == ";" { i = i + 1; } }
        let dep_path: str = join_path(dir, ps[0]);
        acc = acc + resolve_imports(dep_path, depth + 1);
        acc = acc + "\n";
    }
    let rest: str = "";
    while i < len(src) { rest = rest + src[i]; i = i + 1; }
    return acc + rest;
}

fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let s: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        s = digs[d] + s;
        x = x / 10;
    }
    if n < 0 { return "-" + s; }
    return s;
}

fn emit_code(code: list) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < len(code) {
        if i > 0 { s = s + ", "; }
        s = s + itoa(code[i]);
        i = i + 1;
    }
    return s;
}

fn code_has_seq(code: list, seq: list) -> i64 {
    let i: i64 = 0;
    while i + len(seq) <= len(code) {
        let ok: i64 = 1;
        let j: i64 = 0;
        while j < len(seq) {
            if code[i + j] != seq[j] { ok = 0; break; }
            j = j + 1;
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
                if s[i + 1] == "*" {
                    i = i + 2;
                    let closed: i64 = 0;
                    while i + 1 < len(s) {
                        if s[i] == "*" {
                            if s[i + 1] == "/" {
                                i = i + 2;
                                closed = 1;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                    assert(closed == 1);
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}

fn slot_of(vnames: list, name: str) -> list {
    let i: i64 = 0;
    while i < len(vnames) {
        if vnames[i] == name { return [i, vnames]; }
        i = i + 1;
    }
    vnames = push(vnames, name);
    return [len(vnames) - 1, vnames];
}
fn emit2(code: list, a: i64, b: i64) -> list {
    code = push(code, a);
    return push(code, b);
}
fn emit3(code: list, a: i64, b: i64, c: i64) -> list {
    code = push(code, a);
    code = push(code, b);
    return push(code, c);
}

fn emit_n_args(s: str, j: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list, n: i64) -> list {
    let k: i64 = 0;
    while k < n {
        if k > 0 {
            j = skip(s, j);
            assert(s[j] == ",");
            j = j + 1;
        }
        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
        code = ar[0];
        j = ar[1];
        vnames = ar[2];
        k = k + 1;
    }
    j = skip(s, j);
    assert(s[j] == ")");
    j = j + 1;
    return [code, j, vnames];
}

fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i);
    let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 {
            if is_digit(ch) == 0 {
                if ch != "_" { break; }
            }
        }
        name = name + ch;
        i = i + 1;
    }
    return [name, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\\" {
            i = i + 1;
            assert(i < len(s));
            if s[i] == "n" {
                out = out + "\n";
            } else {
                if s[i] == "t" {
                    out = out + "\t";
                } else {
                    out = out + s[i];
                }
            }
            i = i + 1;
            continue;
        }
        if s[i] == "\"" { return [out, i + 1]; }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn c_escape(s: str) -> str {
    let out: str = "";
    let i: i64 = 0;
    while i < len(s) {
        if s[i] == "\\" {
            out = out + "\\\\";
        } else {
            if s[i] == "\"" {
                out = out + "\\\"";
            } else {
                if s[i] == "\n" {
                    out = out + "\\n";
                } else {
                    out = out + s[i];
                }
            }
        }
        i = i + 1;
    }
    return out;
}
fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    let start: i64 = i;
    while i < len(s) {
        if is_digit(s[i]) == 0 { break; }
        v = v * 10 + (ord(s[i]) - 48);
        i = i + 1;
    }
    if i < len(s) {
        if s[i] == "." {
            if i + 1 < len(s) {
                if s[i + 1] == "." { return [0, v, i]; }
            }
            let lit: str = "";
            let j: i64 = start;
            while j < i { lit = lit + s[j]; j = j + 1; }
            lit = lit + ".";
            i = i + 1;
            while i < len(s) {
                if is_digit(s[i]) == 0 { break; }
                lit = lit + s[i];
                i = i + 1;
            }
            return [1, lit, i];
        }
    }
    return [0, v, i];
}

fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(1 == 0);
    return i;
}

fn fn_index(fnames: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fnames) {
        if fnames[i] == name { return i; }
        i = i + 1;
    }
    return -1;
}

fn find_struct(stypes: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(stypes) {
        if stypes[i][0] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn field_index(fields: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fields) {
        if fields[i] == name { return i; }
        i = i + 1;
    }
    assert(0 == 1);
    return 0;
}
fn str_in_pool(strs: list, s: str) -> list {
    let i: i64 = 0;
    while i < len(strs) {
        if strs[i] == s { return [i, strs]; }
        i = i + 1;
    }
    strs = push(strs, s);
    return [len(strs) - 1, strs];
}

fn field_index_any(stypes: list, name: str) -> i64 {
    let si: i64 = 0;
    while si < len(stypes) {
        let fields: list = stypes[si][1];
        let fi: i64 = 0;
        while fi < len(fields) {
            if fields[fi] == name { return fi; }
            fi = fi + 1;
        }
        si = si + 1;
    }
    assert(0 == 1);
    return 0;
}

fn emit_factor(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    i = skip(s, i);
    if s[i] == "-" {
        code = emit2(code, OP_CONST(), 0);
        let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_SUB());
        return [code, r[1], r[2]];
    }
    if s[i] == "!" {
        let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_NOT());
        return [code, r[1], r[2]];
    }
    if s[i] == "(" {
        let r = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        i = skip(s, i);
        assert(s[i] == ")");
        i = i + 1;
        // fall through to postfix [ / .
    } else {
    if s[i] == "[" {
        i = i + 1;
        code = push(code, OP_LIST_NEW());
        i = skip(s, i);
        if s[i] != "]" {
            while true {
                let ar = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
                code = push(ar[0], OP_LIST_PUSH());
                i = ar[1]; vnames = ar[2];
                i = skip(s, i);
                if s[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(s[i] == "]");
        i = i + 1;
    } else {
        if s[i] == "\"" {
            let ps = parse_string(s, i);
            let sip = str_in_pool(strbox[0], ps[0]);
            strbox[0] = sip[1];
            code = emit2(code, OP_CONST_STR(), sip[0]);
            i = ps[1];
        } else {
        if is_alpha(s[i]) == 1 {
            let id = parse_ident(s, i);
            let j: i64 = skip(s, id[1]);
            if j < len(s) {
                if s[j] == "(" {
                    j = j + 1;
                    if id[0] == "round" {
                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                        code = ar[0]; j = ar[1]; vnames = ar[2];
                        j = skip(s, j);
                        assert(s[j] == ")");
                        j = j + 1;
                        code = push(code, OP_ROUND());
                        i = j;
                    } else {
                        if id[0] == "sleep_ms" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_SLEEP_MS());
                            i = j;
                        } else {
                        if id[0] == "ord" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_ORD());
                            i = j;
                        } else {
                        if id[0] == "typeof" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_TYPEOF());
                            i = j;
                        } else {
                        if id[0] == "to_str" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_TO_STR());
                            i = j;
                        } else {
                        if id[0] == "len" {
                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                            code = ar[0]; j = ar[1]; vnames = ar[2];
                            j = skip(s, j);
                            assert(s[j] == ")");
                            j = j + 1;
                            code = push(code, OP_LEN());
                            i = j;
                        } else {
                            if id[0] == "read_file" {
                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ")");
                                j = j + 1;
                                code = push(code, OP_READ_FILE());
                                i = j;
                            } else {
                            if id[0] == "write_file" {
                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ",");
                                j = j + 1;
                                ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ")");
                                j = j + 1;
                                code = push(code, OP_WRITE_FILE());
                                i = j;
                            } else {
                            if id[0] == "push" {
                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ",");
                                j = j + 1;
                                ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = ar[0]; j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                assert(s[j] == ")");
                                j = j + 1;
                                code = push(code, OP_LIST_PUSH());
                                i = j;
                            } else {
                                if id[0] == "emit" {
                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                    code = ar[0]; j = ar[1]; vnames = ar[2];
                                    j = skip(s, j);
                                    assert(s[j] == ",");
                                    j = j + 1;
                                    ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                    code = ar[0]; j = ar[1]; vnames = ar[2];
                                    j = skip(s, j);
                                    assert(s[j] == ")");
                                    j = j + 1;
                                    code = push(code, OP_EMIT());
                                    i = j;
                                } else {
                                    if id[0] == "pump" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                        code = ar[0]; j = ar[1]; vnames = ar[2];
                                        j = skip(s, j);
                                        assert(s[j] == ")");
                                        j = j + 1;
                                        code = push(code, OP_PUMP());
                                        i = j;
                                    } else {
                                        if id[0] == "pending" {
                                            j = skip(s, j);
                                            assert(s[j] == ")");
                                            j = j + 1;
                                            code = push(code, OP_PENDING());
                                            i = j;
                                        } else {
                                        if id[0] == "now_ms" {
                                            j = skip(s, j);
                                            assert(s[j] == ")");
                                            j = j + 1;
                                            code = push(code, OP_NOW_MS());
                                            i = j;
                                        } else {
                                        if id[0] == "t_from" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_FROM());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_get" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_GET());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_matmul" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_MATMUL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_shape" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_T_SHAPE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "tensor" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_TENSOR());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_fill" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_FILL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_set" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_T_SET());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_add" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_ADD());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_sub" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_SUB());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_mul" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_MUL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_scale" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_T_SCALE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_transpose" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_T_TRANSPOSE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "t_softmax" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_T_SOFTMAX());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "save_tensor" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_SAVE_TENSOR());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "load_tensor" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_LOAD_TENSOR());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "memory_config" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_MEM_CONFIG());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "learn" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_LEARN());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "predict" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_PREDICT());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_clear" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 0);
                                            code = push(ar[0], OP_AG_CLEAR());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_param" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_PARAM());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_const" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_CONST());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_matmul" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_MATMUL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_mse" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_MSE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_backward" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_BACKWARD());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_step" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_STEP());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "remember" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_REMEMBER());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "unroll" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_UNROLL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "save_mind" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_SAVE_MIND());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "load_mind" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_LOAD_MIND());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "remember_next" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 4);
                                            code = push(ar[0], OP_REMEMBER_NEXT());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "surprise" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_SURPRISE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "consolidate" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_CONSOLIDATE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "mem_stats" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_MEM_STATS());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "foresee" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_FORESEE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "foresee_n" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 3);
                                            code = push(ar[0], OP_FORESEE_N());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_add" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_ADD());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_sub" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_SUB());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_mul" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_MUL());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_scale" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_SCALE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_relu" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_RELU());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_neg" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_NEG());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_transpose" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_TRANSPOSE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_reshape" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 2);
                                            code = push(ar[0], OP_AG_RESHAPE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_exp" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_EXP());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_log" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_LOG());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_softmax" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_SOFTMAX());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_sum" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_SUM());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_value" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_VALUE());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "ag_grad" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_AG_GRAD());
                                            i = ar[1]; vnames = ar[2];
                                        if id[0] == "argc" {
                                            code = push(code, OP_ARGC());
                                            j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                            i = j;
                                        } else {
                                        if id[0] == "arg" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_ARG());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "file_exists" {
                                            let ar = emit_n_args(s, j, code, vnames, fnames, faddrs, fargc, strbox, 1);
                                            code = push(ar[0], OP_FILE_EXISTS());
                                            i = ar[1]; vnames = ar[2];
                                        } else {
                                        if id[0] == "read_line" {
                                            code = push(code, OP_READ_LINE());
                                            j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                            i = j;
                                        } else {
                                let argc: i64 = 0;
                                j = skip(s, j);
                                if s[j] != ")" {
                                    while true {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                        code = ar[0]; j = ar[1]; vnames = ar[2];
                                        argc = argc + 1;
                                        j = skip(s, j);
                                        if s[j] == "," { j = j + 1; continue; }
                                        break;
                                    }
                                }
                                assert(s[j] == ")");
                                j = j + 1;
                                let fi: i64 = fn_index(fnames, id[0]);
                                assert(fi >= 0);
                                assert(fargc[fi] == argc);
                                code = emit3(code, OP_CALL(), faddrs[fi], argc);
                                i = j;
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                        }
                                    }
                                }
                            }
                            }
                            }
                        }
                        }
                        }
                        }
                        }
                    }
                } else {
                    if s[j] == "{" {
                        let tid: i64 = find_struct(strbox[2], id[0]);
                        if tid >= 0 {
                            let fields: list = strbox[2][tid][1];
                            j = j + 1;
                            code = push(code, OP_LIST_NEW());
                            let fi: i64 = 0;
                            while fi < len(fields) {
                                j = skip(s, j);
                                let fnm = parse_ident(s, j);
                                assert(fnm[0] == fields[fi]);
                                j = skip(s, fnm[1]);
                                assert(s[j] == ":"); j = j + 1;
                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                                code = push(ar[0], OP_LIST_PUSH());
                                j = ar[1]; vnames = ar[2];
                                j = skip(s, j);
                                if j < len(s) { if s[j] == "," { j = j + 1; } }
                                fi = fi + 1;
                            }
                            j = skip(s, j);
                            assert(s[j] == "}"); j = j + 1;
                            let strs = strbox[0];
                            strs = push(strs, id[0]);
                            strbox[0] = strs;
                            code = emit2(code, OP_LIST_TAG(), len(strs) - 1);
                            i = j;
                        } else {
                            let sl = slot_of(vnames, id[0]);
                            code = emit2(code, OP_LOAD(), sl[0]);
                            i = id[1]; vnames = sl[1];
                        }
                    } else {
                        if id[0] == "true" {
                            code = emit2(code, OP_CONST(), 1);
                            i = id[1];
                        } else {
                            if id[0] == "false" {
                                code = emit2(code, OP_CONST(), 0);
                                i = id[1];
                            } else {
                                let sl = slot_of(vnames, id[0]);
                                code = emit2(code, OP_LOAD(), sl[0]);
                                i = id[1]; vnames = sl[1];
                            }
                        }
                    }
                }
            } else {
                if id[0] == "true" {
                    code = emit2(code, OP_CONST(), 1);
                    i = id[1];
                } else {
                    if id[0] == "false" {
                        code = emit2(code, OP_CONST(), 0);
                        i = id[1];
                    } else {
                        let sl = slot_of(vnames, id[0]);
                        code = emit2(code, OP_LOAD(), sl[0]);
                        i = id[1]; vnames = sl[1];
                    }
                }
            }
        } else {
            let n = parse_number(s, i);
            if n[0] == 1 {
                let floats = strbox[1];
                floats = push(floats, n[1]);
                strbox[1] = floats;
                code = emit2(code, OP_CONST_F64(), len(floats) - 1);
            } else {
                code = emit2(code, OP_CONST(), n[1]);
            }
            i = n[2];
        }
        }
    }
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "[" { break; }
        let ix = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = ix[0]; i = ix[1]; vnames = ix[2];
        i = skip(s, i);
        assert(s[i] == "]");
        i = i + 1;
        code = push(code, OP_GET());
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "." { break; }
        if i + 1 < len(s) {
            if s[i + 1] == "." { break; }
        }
        let fld = parse_ident(s, i + 1);
        assert(len(fld[0]) > 0);
        let fidx: i64 = field_index_any(strbox[2], fld[0]);
        code = emit2(code, OP_CONST(), fidx);
        code = push(code, OP_GET());
        i = fld[1];
    }
    }
    }
    }
    }
    return [code, i, vnames];
}

fn emit_term(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_factor(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "*" {
            r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_MUL());
            i = r[1]; vnames = r[2];
        } else {
            if s[i] == "/" {
                r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
                code = push(r[0], OP_DIV());
                i = r[1]; vnames = r[2];
            } else {
                if s[i] == "%" {
                    r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
                    code = push(r[0], OP_MOD());
                    i = r[1]; vnames = r[2];
                } else { break; }
            }
        }
    }
    return [code, i, vnames];
}

fn emit_sum(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_term(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "+" {
            r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_ADD());
            i = r[1]; vnames = r[2];
        } else {
            if s[i] == "-" {
                r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
                code = push(r[0], OP_SUB());
                i = r[1]; vnames = r[2];
            } else { break; }
        }
    }
    return [code, i, vnames];
}

fn emit_rel(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    i = skip(s, i);
    if i >= len(s) { return [code, i, vnames]; }
    if starts_with(s, i, "==") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_EQ());
        return [code, r[1], r[2]];
    }
    if starts_with(s, i, "!=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_NE());
        return [code, r[1], r[2]];
    }
    if starts_with(s, i, "<=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_LE());
        return [code, r[1], r[2]];
    }
    if starts_with(s, i, ">=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_GE());
        return [code, r[1], r[2]];
    }
    if s[i] == "<" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_LT());
        return [code, r[1], r[2]];
    }
    if s[i] == ">" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, strbox);
        code = push(r[0], OP_GT());
        return [code, r[1], r[2]];
    }
    return [code, i, vnames];
}

fn emit_and(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_rel(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "&&") == 1 {
            r = emit_rel(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_AND()); i = r[1]; vnames = r[2];
        } else { break; }
    }
    return [code, i, vnames];
}

fn emit_or(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    let r = emit_and(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "||") == 1 {
            r = emit_and(s, i + 2, code, vnames, fnames, faddrs, fargc, strbox);
            code = push(r[0], OP_OR()); i = r[1]; vnames = r[2];
        } else { break; }
    }
    return [code, i, vnames];
}

fn emit_cmp(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, strbox: list) -> list {
    return emit_or(s, i, code, vnames, fnames, faddrs, fargc, strbox);
}

fn loops_pop(loops: list) -> list {
    let n: i64 = len(loops);
    assert(n > 0);
    let out: list = [];
    let i: i64 = 0;
    while i < n - 1 {
        out = push(out, loops[i]);
        i = i + 1;
    }
    return out;
}
fn loops_close(loops: list, idx: i64) -> list {
    // close frame in place (shared list): caller sees it too
    loops[idx] = 0;
    return loops;
}
fn loops_top(loops: list) -> i64 {
    // innermost open frame: scan down past closed (sentinel) frames
    let d: i64 = len(loops) - 1;
    while d >= 0 {
        if typeof(loops[d]) == "list" { return d; }
        d = d - 1;
    }
    return 0 - 1;
}
fn patch_jmp_sites(code: list, sites: list, target: i64) -> list {
    let i: i64 = 0;
    while i < len(sites) {
        code[sites[i]] = target;
        i = i + 1;
    }
    return code;
}

fn emit_stmt(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, loops: list, strbox: list) -> list {
    i = skip(s, i);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        if i < len(s) {
            if s[i] == ":" {
                i = i + 1;
                let ty = parse_ident(s, i);
                i = skip(s, ty[1]);
            }
        }
        assert(s[i] == "=");
        i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let sl = slot_of(vnames, id[0]);
        vnames = sl[1];
        code = emit2(code, OP_STORE(), sl[0]);
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let lo = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = lo[0]; i = lo[1]; vnames = lo[2];
        i = skip(s, i);
        if starts_with(s, i, "..") == 1 {
            // for v in lo..hi
            let sl = slot_of(vnames, id[0]);
            vnames = sl[1];
            code = emit2(code, OP_STORE(), sl[0]);
            i = i + 2;
            let hi_slot_name: str = "__hi" + itoa(len(vnames));
            let hi = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, strbox);
            code = hi[0]; i = hi[1]; vnames = hi[2];
            let hs = slot_of(vnames, hi_slot_name);
            vnames = hs[1];
            code = emit2(code, OP_STORE(), hs[0]);
            let loop_start: i64 = len(code);
            code = emit2(code, OP_LOAD(), sl[0]);
            code = emit2(code, OP_LOAD(), hs[0]);
            code = push(code, OP_LT());
            let jmpf_at: i64 = len(code);
            code = emit2(code, OP_JMPF(), 0);
            let my: i64 = len(loops);
            loops = push(loops, [[], []]);
            i = skip(s, i);
            let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
            code = body[0]; i = body[1]; vnames = body[2];
            let frame = loops[my];
            let cont_ip: i64 = len(code);
            code = patch_jmp_sites(code, frame[0], cont_ip);
            code = emit2(code, OP_LOAD(), sl[0]);
            code = emit2(code, OP_CONST(), 1);
            code = push(code, OP_ADD());
            code = emit2(code, OP_STORE(), sl[0]);
            code = emit2(code, OP_JMP(), loop_start);
            let end_ip: i64 = len(code);
            code[jmpf_at + 1] = end_ip;
            code = patch_jmp_sites(code, frame[1], end_ip);
            loops = loops_close(loops, my);
            return [code, i, vnames];
        }
        // for v in xs
        let xs_name: str = "__xs" + itoa(len(vnames));
        let ix_name: str = "__xi" + itoa(len(vnames));
        let xs = slot_of(vnames, xs_name);
        vnames = xs[1];
        code = emit2(code, OP_STORE(), xs[0]);
        let ix = slot_of(vnames, ix_name);
        vnames = ix[1];
        code = emit2(code, OP_CONST(), 0);
        code = emit2(code, OP_STORE(), ix[0]);
        let vsl = slot_of(vnames, id[0]);
        vnames = vsl[1];
        let loop_start: i64 = len(code);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = emit2(code, OP_LOAD(), xs[0]);
        code = push(code, OP_LEN());
        code = push(code, OP_LT());
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        code = emit2(code, OP_LOAD(), xs[0]);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = push(code, OP_GET());
        code = emit2(code, OP_STORE(), vsl[0]);
        let my2: i64 = len(loops);
        loops = push(loops, [[], []]);
        i = skip(s, i);
        let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = body[0]; i = body[1]; vnames = body[2];
        let frame2 = loops[my2];
        let cont_ip2: i64 = len(code);
        code = patch_jmp_sites(code, frame2[0], cont_ip2);
        code = emit2(code, OP_LOAD(), ix[0]);
        code = emit2(code, OP_CONST(), 1);
        code = push(code, OP_ADD());
        code = emit2(code, OP_STORE(), ix[0]);
        code = emit2(code, OP_JMP(), loop_start);
        let end_ip2: i64 = len(code);
        code[jmpf_at + 1] = end_ip2;
        code = patch_jmp_sites(code, frame2[1], end_ip2);
        loops = loops_close(loops, my2);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "while") == 1 {
        let loop_start: i64 = len(code);
        i = skip(s, i + 5);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        let my3: i64 = len(loops);
        loops = push(loops, [[], []]);
        i = skip(s, i);
        let body = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = body[0]; i = body[1]; vnames = body[2];
        let frame3 = loops[my3];
        code = patch_jmp_sites(code, frame3[0], loop_start);
        code = emit2(code, OP_JMP(), loop_start);
        let end_ip3: i64 = len(code);
        code[jmpf_at + 1] = end_ip3;
        code = patch_jmp_sites(code, frame3[1], end_ip3);
        loops = loops_close(loops, my3);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "if") == 1 {
        i = skip(s, i + 2);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        i = skip(s, i);
        assert(s[i] == "{");
        let th = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = th[0]; i = th[1]; vnames = th[2];
        let jmp_end: i64 = len(code);
        code = emit2(code, OP_JMP(), 0);
        code[jmpf_at + 1] = len(code);
        i = skip(s, i);
        if starts_kw(s, i, "else") == 1 {
            i = skip(s, i + 4);
            if starts_kw(s, i, "if") == 1 {
                let el = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
                code = el[0]; i = el[1]; vnames = el[2];
            } else {
                let el = compile_body(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
                code = el[0]; i = el[1]; vnames = el[2];
            }
        }
        code[jmp_end + 1] = len(code);
        return [code, i, vnames];
    }
    if starts_kw(s, i, "break") == 1 {
        assert(len(loops) > 0);
        let top4: i64 = loops_top(loops);
        assert(top4 >= 0);
        code = emit2(code, OP_JMP(), 0);
        let brks = loops[top4][1];
        brks = push(brks, len(code) - 1);
        loops[top4] = [loops[top4][0], brks];
        i = skip(s, i + 5);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "continue") == 1 {
        assert(len(loops) > 0);
        let top5: i64 = loops_top(loops);
        assert(top5 >= 0);
        code = emit2(code, OP_JMP(), 0);
        let conts = loops[top5][0];
        conts = push(conts, len(code) - 1);
        loops[top5] = [conts, loops[top5][1]];
        i = skip(s, i + 8);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6);
        assert(s[i] == "(");
        i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        i = skip(s, i);
        assert(s[i] == ")");
        i = i + 1;
        code = push(code, OP_ASSERT());
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7);
        assert(s[i] == "(");
        i = i + 1;
        i = skip(s, i);
        if s[i] == "\"" {
            let ps = parse_string(s, i);
            let sip = str_in_pool(strbox[0], ps[0]);
            strbox[0] = sip[1];
            code = emit2(code, OP_CONST_STR(), sip[0]);
            i = skip(s, ps[1]);
            assert(s[i] == ")");
            i = i + 1;
            code = push(code, OP_PRINTLN());
        } else {
            let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
            code = r[0]; i = r[1]; vnames = r[2];
            i = skip(s, i);
            assert(s[i] == ")");
            i = i + 1;
            code = push(code, OP_PRINTLN());
        }
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "print") == 1 {
        i = skip(s, i + 5);
        assert(s[i] == "(");
        i = i + 1;
        i = skip(s, i);
        if s[i] == "\"" {
            let ps = parse_string(s, i);
            let sip = str_in_pool(strbox[0], ps[0]);
            strbox[0] = sip[1];
            code = emit2(code, OP_CONST_STR(), sip[0]);
            i = skip(s, ps[1]);
            assert(s[i] == ")");
            i = i + 1;
            code = push(code, OP_PRINT());
        } else {
            let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
            code = r[0]; i = r[1]; vnames = r[2];
            i = skip(s, i);
            assert(s[i] == ")");
            i = i + 1;
            code = push(code, OP_PRINT());
        }
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if starts_kw(s, i, "return") == 1 {
        i = skip(s, i + 6);
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
        code = r[0]; i = r[1]; vnames = r[2];
        code = push(code, OP_RET());
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames];
    }
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let sl = slot_of(vnames, id[0]);
                vnames = sl[1];
                code = emit2(code, OP_LOAD(), sl[0]);
                j = j + 1;
                let ix = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, strbox);
                code = ix[0]; j = ix[1]; vnames = ix[2];
                j = skip(s, j);
                assert(s[j] == "]");
                j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, strbox);
                        code = r[0]; j = r[1]; vnames = r[2];
                        code = push(code, OP_SET());
                        j = skip(s, j);
                        if j < len(s) { if s[j] == ";" { j = j + 1; } }
                        return [code, j, vnames];
                    }
                }
                let nc: list = [];
                let ki: i64 = 0;
                while ki < len(code) - 2 { nc = push(nc, code[ki]); ki = ki + 1; }
                code = nc;
                i = save;
            } else {
                if s[j] == "." {
                    let sl = slot_of(vnames, id[0]);
                    vnames = sl[1];
                    let fld = parse_ident(s, j + 1);
                    j = skip(s, fld[1]);
                    if j < len(s) {
                        if s[j] == "=" {
                            if starts_with(s, j, "==") == 0 {
                                let fidx: i64 = field_index_any(strbox[2], fld[0]);
                                code = emit2(code, OP_LOAD(), sl[0]);
                                code = emit2(code, OP_CONST(), fidx);
                                let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, strbox);
                                code = r[0]; j = r[1]; vnames = r[2];
                                code = push(code, OP_SET());
                                j = skip(s, j);
                                if j < len(s) { if s[j] == ";" { j = j + 1; } }
                                return [code, j, vnames];
                            }
                        }
                    }
                    i = save;
                } else {
                if s[j] == "=" {
                    if starts_with(s, j, "==") == 0 {
                        let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, strbox);
                        code = r[0]; i = r[1]; vnames = r[2];
                        let sl = slot_of(vnames, id[0]);
                        vnames = sl[1];
                        code = emit2(code, OP_STORE(), sl[0]);
                        i = skip(s, i);
                        if i < len(s) { if s[i] == ";" { i = i + 1; } }
                        return [code, i, vnames];
                    }
                }
                }
            }
        }
    }
    let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, strbox);
    code = r[0]; i = r[1]; vnames = r[2];
    code = push(code, OP_POP());
    i = skip(s, i);
    if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [code, i, vnames];
}

fn compile_body(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, loops: list, strbox: list) -> list {
    i = skip(s, i);
    assert(s[i] == "{");
    i = i + 1;
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, loops, strbox);
        code = st[0]; i = st[1]; vnames = st[2];
    }
    assert(s[i] == "}");
    return [code, i + 1, vnames];
}

fn compile_src(src: str) -> list {
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let stypes: list = [];
    let binds: list = [];
    let on_serial: i64 = 0;
    let strbox: list = [[], [], stypes];
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        if starts_kw(src, i, "struct") == 1 {
            i = skip(src, i + 6);
            let id = parse_ident(src, i);
            i = skip(src, id[1]);
            assert(src[i] == "{"); i = i + 1;
            let fields: list = [];
            i = skip(src, i);
            if src[i] != "}" {
                while true {
                    let fnm = parse_ident(src, i);
                    fields = push(fields, fnm[0]);
                    i = skip(src, fnm[1]);
                    if i < len(src) {
                        if src[i] == ":" {
                            i = i + 1;
                            let ty = parse_ident(src, i);
                            i = ty[1];
                        }
                    }
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; i = skip(src, i); continue; }
                    break;
                }
            }
            assert(src[i] == "}"); i = i + 1;
            stypes = push(stypes, [id[0], fields]);
            strbox[2] = stypes;
            continue;
        }
        if starts_kw(src, i, "on") == 1 {
            i = skip(src, i + 2);
            assert(src[i] == "\"");
            let ps = parse_string(src, i);
            let ev: str = ps[0]; i = ps[1];
            i = skip(src, i);
            assert(src[i] == "("); i = i + 1;
            let params: list = [];
            i = skip(src, i);
            if src[i] != ")" {
                while true {
                    let pn = parse_ident(src, i);
                    params = push(params, pn[0]);
                    i = skip(src, pn[1]);
                    if i < len(src) {
                        if src[i] == ":" {
                            i = i + 1;
                            let ty = parse_ident(src, i);
                            i = ty[1];
                        }
                    }
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; continue; }
                    break;
                }
            }
            assert(src[i] == ")");
            i = skip(src, i + 1);
            assert(src[i] == "{");
            let start: i64 = i;
            i = match_brace(src, i);
            let body: str = "";
            let bi: i64 = start;
            while bi < i { body = body + src[bi]; bi = bi + 1; }
            let sip = str_in_pool(strbox[0], ev);
            strbox[0] = sip[1];
            let fname: str = "__on_" + itoa(on_serial);
            on_serial = on_serial + 1;
            binds = push(binds, [sip[0], len(fnames), len(params)]);
            fnames = push(fnames, fname);
            fparams = push(fparams, params);
            fbodies = push(fbodies, body);
            continue;
        }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "(");
        i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                params = push(params, pn[0]);
                i = skip(src, pn[1]);
                if src[i] == ":" {
                    i = i + 1;
                    let ty = parse_ident(src, i);
                    i = ty[1];
                }
                i = skip(src, i);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
    }

    assert(fn_index(fnames, "main") >= 0);

    let fargc: list = [];
    let fi: i64 = 0;
    while fi < len(fnames) {
        fargc = push(fargc, len(fparams[fi]));
        fi = fi + 1;
    }

    let code: list = emit2([], OP_JMP(), 0);
    let faddrs: list = [];
    fi = 0;
    while fi < len(fnames) {
        if fnames[fi] != "main" {
            faddrs = push(faddrs, len(code));
            let vnames: list = [];
            let pi: i64 = 0;
            while pi < len(fparams[fi]) {
                vnames = push(vnames, fparams[fi][pi]);
                pi = pi + 1;
            }
            let bl = compile_body(fbodies[fi], 0, code, vnames, fnames, faddrs, fargc, [], strbox);
            code = bl[0];
            code = push(code, OP_RET());
        } else {
            faddrs = push(faddrs, 0);
        }
        fi = fi + 1;
    }

    let resolved: list = [];
    let bi2: i64 = 0;
    while bi2 < len(binds) {
        let b = binds[bi2];
        resolved = push(resolved, [b[0], faddrs[b[1]], b[2]]);
        bi2 = bi2 + 1;
    }

    let main_ip: i64 = len(code);
    code[1] = main_ip;

    let mi: i64 = fn_index(fnames, "main");
    faddrs[mi] = main_ip;
    let vnames: list = [];
    let bl = compile_body(fbodies[mi], 0, code, vnames, fnames, faddrs, fargc, [], strbox);
    code = bl[0];
    code = push(code, OP_HALT());
    return [code, strbox[0], strbox[1], resolved];
}

fn emit_strs_table(strs: list) -> str {
    if len(strs) == 0 {
        return "static const char *g_strs[] = { \"\" };\n\n";
    }
    let s: str = "static const char *g_strs[] = { ";
    let i: i64 = 0;
    while i < len(strs) {
        if i > 0 { s = s + ", "; }
        s = s + "\"" + c_escape(strs[i]) + "\"";
        i = i + 1;
    }
    s = s + " };\n\n";
    return s;
}

fn emit_f64s_table(floats: list) -> str {
    if len(floats) == 0 {
        return "static const double g_f64s[] = { 0.0 };\n\n";
    }
    let s: str = "static const double g_f64s[] = { ";
    let i: i64 = 0;
    while i < len(floats) {
        if i > 0 { s = s + ", "; }
        s = s + floats[i];
        i = i + 1;
    }
    s = s + " };\n\n";
    return s;
}

fn emit_handlers_table(binds: list) -> str {
    let s: str = "typedef struct { int64_t str_idx; int64_t addr; int64_t arity; } EvHandler;\n";
    if len(binds) == 0 {
        s = s + "static const EvHandler g_handlers[] = { {0,0,0} };\n";
        s = s + "static const int g_nhandlers = 0;\n\n";
        return s;
    }
    s = s + "static const EvHandler g_handlers[] = { ";
    let i: i64 = 0;
    while i < len(binds) {
        if i > 0 { s = s + ", "; }
        let b: list = binds[i];
        s = s + "{" + itoa(b[0]) + ", " + itoa(b[1]) + ", " + itoa(b[2]) + "}";
        i = i + 1;
    }
    s = s + " };\n";
    s = s + "static const int g_nhandlers = " + itoa(len(binds)) + ";\n\n";
    return s;
}

fn write_runtime() -> str {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/bc_src_c.kenga ? shared bytecode VM runtime */\n";
    s = s + "/* Driver: #include opcodes.inc.c; define g_strs, g_f64s, g_handlers, g_nhandlers; then #include this file. */\n\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "#include <windows.h>\n";
    s = s + "#else\n";
    s = s + "#include <unistd.h>\n";
    s = s + "#include <sys/time.h>\n";
    s = s + "#endif\n\n";
    s = s + "enum { OP_MOD = 38, OP_AND = 39, OP_OR = 40, OP_NOT = 41, OP_TYPEOF = 42, OP_TO_STR = 43, OP_PRINT = 44, OP_SLEEP_MS = 45, OP_NOW_MS = 46, OP_T_FROM = 47, OP_T_GET = 48, OP_T_MATMUL = 49, OP_T_SHAPE = 50, OP_TENSOR = 51, OP_T_FILL = 52, OP_MEM_CONFIG = 53, OP_LEARN = 54, OP_PREDICT = 55, OP_AG_CLEAR = 56, OP_AG_PARAM = 57, OP_AG_CONST = 58, OP_AG_MATMUL = 59, OP_AG_MSE = 60, OP_AG_BACKWARD = 61, OP_AG_STEP = 62, OP_REMEMBER = 63, OP_UNROLL = 64, OP_SAVE_MIND = 65, OP_LOAD_MIND = 66, OP_REMEMBER_NEXT = 67, OP_SURPRISE = 68, OP_CONSOLIDATE = 69, OP_MEM_STATS = 70, OP_FORESEE = 71, OP_AG_ADD = 72, OP_AG_SUB = 73, OP_AG_MUL = 74, OP_AG_SCALE = 75, OP_AG_RELU = 76, OP_AG_NEG = 77, OP_AG_TRANSPOSE = 78, OP_AG_RESHAPE = 79, OP_AG_EXP = 80, OP_AG_LOG = 81, OP_AG_SOFTMAX = 82, OP_AG_SUM = 83, OP_AG_VALUE = 84, OP_AG_GRAD = 85, OP_FORESEE_N = 86, OP_T_SET = 87, OP_T_ADD = 88, OP_T_SUB = 89, OP_T_MUL = 90, OP_T_SCALE = 91, OP_T_TRANSPOSE = 92, OP_T_SOFTMAX = 93, OP_SAVE_TENSOR = 94, OP_LOAD_TENSOR = 95, OP_ARGC = 106, OP_ARG = 107, OP_FILE_EXISTS = 108, OP_READ_LINE = 109 };\n";
    s = s + "static int g_kargc = 0;\nstatic char **g_kargv = NULL;\n";
    s = s + "typedef struct { int tag; int64_t i; double f; } V;\n";
    s = s + "static V Vi(int64_t x) { V v; v.tag=0; v.i=x; v.f=0; return v; }\n";
    s = s + "static V Vf(double x) { V v; v.tag=1; v.i=0; v.f=x; return v; }\n";
    s = s + "static V Vl(int64_t x) { V v; v.tag=2; v.i=x; v.f=0; return v; }\n";
    s = s + "static V Vs(int64_t x) { V v; v.tag=3; v.i=x; v.f=0; return v; }\n";
    s = s + "static V Vm(int64_t x) { V v; v.tag=4; v.i=x; v.f=0; return v; }\n";
    s = s + "static V Vt(int64_t x) { V v; v.tag=5; v.i=x; v.f=0; return v; }\n";
    s = s + "static double as_f(V v) { return v.tag==1 ? v.f : (double)v.i; }\n";
    s = s + "static int64_t as_i(V v) { return v.tag==1 ? (int64_t)llround(v.f) : v.i; }\n";
    s = s + "static int64_t as_list(V v) {\n";
    s = s + "  if (v.tag != 2) { fprintf(stderr, \"expected list\\n\"); exit(1); }\n";
    s = s + "  return v.i;\n";
    s = s + "}\n";
    s = s + "static char *gS[65536];\n";
    s = s + "static int gSn = 0;\n";
    s = s + "static int64_t s_new(const char *s) {\n";
    s = s + "  size_t n;\n";
    s = s + "  char *p;\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < gSn; i++) if (strcmp(gS[i], s) == 0) return (int64_t)i;\n";
    s = s + "  if (gSn >= 65536) { fprintf(stderr, \"str heap full\\n\"); exit(1); }\n";
    s = s + "  n = strlen(s);\n";
    s = s + "  p = (char*)malloc(n + 1);\n";
    s = s + "  if (!p) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "  memcpy(p, s, n + 1);\n";
    s = s + "  gS[gSn] = p;\n";
    s = s + "  return (int64_t)gSn++;\n";
    s = s + "}\n";
    s = s + "static const char *as_str(V v) {\n";
    s = s + "  if (v.tag != 3) { fprintf(stderr, \"expected str\\n\"); exit(1); }\n";
    s = s + "  return gS[v.i];\n";
    s = s + "}\n";
    s = s + "static int64_t s_from_pool(int idx) { return s_new(g_strs[idx]); }\n";
    s = s + "static int64_t s_char_at(int64_t sid, int64_t ix) {\n";
    s = s + "  const char *s = gS[sid];\n";
    s = s + "  size_t n = strlen(s);\n";
    s = s + "  char buf[2];\n";
    s = s + "  if (ix < 0 || (size_t)ix >= n) { fprintf(stderr, \"index oob\\n\"); exit(1); }\n";
    s = s + "  buf[0] = s[ix]; buf[1] = 0;\n";
    s = s + "  return s_new(buf);\n";
    s = s + "}\n";
    s = s + "static char *v_to_cstr(V v) {\n";
    s = s + "  char buf[64];\n";
    s = s + "  char *out;\n";
    s = s + "  if (v.tag == 3) return strdup(as_str(v));\n";
    s = s + "  if (v.tag == 0) { sprintf(buf, \"%lld\", (long long)v.i); return strdup(buf); }\n";
    s = s + "  if (v.tag == 1) { sprintf(buf, \"%g\", v.f); return strdup(buf); }\n";
    s = s + "  fprintf(stderr, \"cannot stringify\\n\"); exit(1);\n";
    s = s + "  return NULL;\n";
    s = s + "}\n\n";
    s = s + "typedef struct { V *d; size_t n, cap; int next_free; } LObj;\n";
    s = s + "static LObj gL[1048576];\n";
    s = s + "static const char *g_ltype[1048576];\n";
    s = s + "static int gLn = 0;\n\n";
    s = s + "static int64_t gLfree = -1, gLfreecnt = 0;\n";
    s = s + "static int gGCp = 0;\n";
    s = s + "static void vprint(V v) {\n";
    s = s + "  if (v.tag==1) printf(\"%g\", v.f);\n";
    s = s + "  else if (v.tag==3) printf(\"%s\", as_str(v));\n";
    s = s + "  else if (v.tag==2) printf(\"[list:%lld]\", (long long)v.i);\n";
    s = s + "  else if (v.tag==4) printf(\"[mem:%lld]\", (long long)v.i);\n";
    s = s + "  else if (v.tag==5) printf(\"[tensor:%lld]\", (long long)v.i);\n";
    s = s + "  else printf(\"%lld\", (long long)v.i);\n";
    s = s + "}\n";
    s = s + "static int64_t lnew(void) {\n";
    s = s + "  if (gLfree >= 0) { int64_t id = gLfree; gLfree = gL[id].next_free; gLfreecnt--; gL[id].d = NULL; gL[id].n = 0; gL[id].cap = 0; g_ltype[id] = NULL; if ((gLn - gLfreecnt) > 65536) gGCp = 1; return id; }\n";
    s = s + "  if (gLn >= 1048576) { fprintf(stderr, \"list heap full\\n\"); exit(1); }\n";
    s = s + "  gL[gLn].d = NULL; gL[gLn].n = 0; gL[gLn].cap = 0; gL[gLn].next_free = -1;\n";
    s = s + "  g_ltype[gLn] = NULL;\n";
    s = s + "  if ((gLn + 1 - gLfreecnt) > 65536) gGCp = 1;\n";
    s = s + "  return (int64_t)gLn++;\n";
    s = s + "}\n";
    s = s + "static void lgrow(int id) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  size_t nc = L->cap ? L->cap * 2 : 4;\n";
    s = s + "  V *nd = (V*)realloc(L->d, nc * sizeof(V));\n";
    s = s + "  if (!nd) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "  L->d = nd; L->cap = nc;\n";
    s = s + "}\n";
    s = s + "static void lpush(int64_t id, V v) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (L->n >= L->cap) lgrow((int)id);\n";
    s = s + "  L->d[L->n++] = v;\n";
    s = s + "}\n";
    s = s + "static V lget(int64_t id, int64_t i) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (i < 0 || (size_t)i >= L->n) { fprintf(stderr, \"index oob\\n\"); exit(1); }\n";
    s = s + "  return L->d[i];\n";
    s = s + "}\n";
    s = s + "static void lset(int64_t id, int64_t i, V v) {\n";
    s = s + "  LObj *L = &gL[id];\n";
    s = s + "  if (i < 0 || (size_t)i >= L->n) { fprintf(stderr, \"index oob\\n\"); exit(1); }\n";
    s = s + "  L->d[i] = v;\n";
    s = s + "}\n";
    s = s + "static int64_t llen(int64_t id) {\n";
    s = s + "  return (int64_t)gL[id].n;\n";
    s = s + "}\n\n";
    s = s + "#ifdef KENGA_TENSOR_F32
typedef float KREAL;
#else
typedef double KREAL;
#endif
";
    s = s + "typedef struct { int rank; int shape[8]; int n; KREAL *data; int next_free; } TObj;\n";
    s = s + "static TObj *gT = NULL;\n";
    s = s + "static int gTn = 0, gTcap = 0;\n";
    s = s + "static int64_t gTfree = -1, gTfreecnt = 0; static size_t gTbytes = 0;\n";
    s = s + "static int64_t talloc(const int *shape, int rank, int zero) {\n";
    s = s + "  int n = 1, i; int64_t h;\n";
    s = s + "  if (rank < 0 || rank > 8) { fprintf(stderr, \"bad tensor rank\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (shape[i] < 0) { fprintf(stderr, \"negative tensor dim\\n\"); exit(1); }\n";
    s = s + "    if (shape[i] > 0 && n > 4096 / shape[i]) { fprintf(stderr, \"tensor too large\\n\"); exit(1); }\n";
    s = s + "    n *= shape[i];\n";
    s = s + "  }\n";
    s = s + "  if (gTfree >= 0) { h = gTfree; gTfree = gT[h].next_free; gTfreecnt--; }\n";
    s = s + "  else {\n";
    s = s + "    if (gTn >= gTcap) { int nc = gTcap ? gTcap * 2 : 64; TObj *nd = (TObj*)realloc(gT, (size_t)nc * sizeof(TObj)); if (!nd) { fprintf(stderr, \"oom\\n\"); exit(1); } gT = nd; gTcap = nc; }\n";
    s = s + "    h = gTn++;\n";
    s = s + "  }\n";
    s = s + "  gT[h].rank = rank; gT[h].n = n; gT[h].next_free = -1;\n";
    s = s + "  for (i = 0; i < rank; i++) gT[h].shape[i] = shape[i];\n";
    s = s + "  gT[h].data = n > 0 ? (KREAL*)malloc((size_t)n * sizeof(KREAL)) : NULL;\n";
    s = s + "  if (n > 0 && !gT[h].data) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "  if (n > 0 && zero) memset(gT[h].data, 0, (size_t)n * sizeof(KREAL));\n";
    s = s + "  gTbytes += (size_t)n * sizeof(KREAL);\n";
    s = s + "  if ((gTn - gTfreecnt) > 8192 || gTbytes > ((size_t)192 << 20)) gGCp = 1;\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "static TObj *tobj(V v) {\n";
    s = s + "  if (v.tag != 5 || v.i < 0 || v.i >= gTn) { fprintf(stderr, \"expected tensor\\n\"); exit(1); }\n";
    s = s + "  return &gT[v.i];\n";
    s = s + "}\n";
    s = s + "static TObj *tid(int64_t h) {\n";
    s = s + "  if (h < 0 || h >= gTn) { fprintf(stderr, \"bad tensor\\n\"); exit(1); }\n";
    s = s + "  return &gT[h];\n";
    s = s + "}\n";
    s = s + "static int64_t tclone(int64_t h) {\n";
    s = s + "  TObj *t = tid(h); int shape[8], rank = t->rank, n = t->n, i; KREAL *src = t->data; int64_t o;\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = t->shape[i];\n";
    s = s + "  o = talloc(shape, rank, 0); if (n > 0) memcpy(gT[o].data, src, (size_t)n * sizeof(KREAL)); return o;\n";
    s = s + "}\n";
    s = s + "static int64_t ttranspose(int64_t ha) {\n";
    s = s + "  TObj *a = tid(ha); int r, c, i, j, shape[2]; KREAL *ad; int64_t h;\n";
    s = s + "  if (a->rank != 2) { fprintf(stderr, \"transpose expects rank-2\\n\"); exit(1); }\n";
    s = s + "  r = a->shape[0]; c = a->shape[1]; ad = a->data; shape[0] = c; shape[1] = r; h = talloc(shape, 2, 1);\n";
    s = s + "  for (i = 0; i < r; i++) for (j = 0; j < c; j++) gT[h].data[j * r + i] = ad[i * c + j]; return h;\n";
    s = s + "}\n";
    s = s + "static int64_t tscale(int64_t ha, double s) {\n";
    s = s + "  int64_t h = tclone(ha); int i; for (i = 0; i < gT[h].n; i++) gT[h].data[i] *= s; return h;\n";
    s = s + "}\n";
    s = s + "static int64_t tew_sub(int64_t ha, int64_t hb) {\n";
    s = s + "  TObj *a = tid(ha), *b = tid(hb); int i, n = a->n, rank = a->rank, shape[8]; KREAL *ad = a->data, *bd = b->data; int64_t h;\n";
    s = s + "  if (a->n != b->n) { fprintf(stderr, \"tensor size mismatch\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i]; h = talloc(shape, rank, 0);\n";
    s = s + "  for (i = 0; i < n; i++) gT[h].data[i] = ad[i] - bd[i]; return h;\n";
    s = s + "}\n";
    s = s + "static int64_t tmatmul_ids(int64_t ha, int64_t hb) {\n";
    s = s + "  TObj *ta = tid(ha), *tb = tid(hb); int m, k, k2, n, i, j, p, shape[2]; KREAL *ad, *bd; int64_t h;\n";
    s = s + "  if (ta->rank != 2 || tb->rank != 2) { fprintf(stderr, \"t_matmul expects rank-2\\n\"); exit(1); }\n";
    s = s + "  m = ta->shape[0]; k = ta->shape[1]; k2 = tb->shape[0]; n = tb->shape[1];\n";
    s = s + "  if (k != k2) { fprintf(stderr, \"t_matmul inner dim mismatch\\n\"); exit(1); }\n";
    s = s + "  ad = ta->data; bd = tb->data; shape[0] = m; shape[1] = n; h = talloc(shape, 2, 1);\n";
    s = s + "  for (i = 0; i < m; i++) for (j = 0; j < n; j++) { double acc = 0.0; for (p = 0; p < k; p++) acc += ad[i*k+p]*bd[p*n+j]; gT[h].data[i*n+j] = acc; }\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "static int64_t tew_add(int64_t ha, int64_t hb) {\n";
    s = s + "  TObj *a = tid(ha), *b = tid(hb); int i, n = a->n, rank = a->rank, shape[8]; KREAL *ad = a->data, *bd = b->data; int64_t h;\n";
    s = s + "  if (a->n != b->n) { fprintf(stderr, \"tensor size mismatch\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i]; h = talloc(shape, rank, 0);\n";
    s = s + "  for (i = 0; i < n; i++) gT[h].data[i] = ad[i] + bd[i]; return h;\n";
    s = s + "}\n";
    s = s + "static int64_t tew_mul(int64_t ha, int64_t hb) {\n";
    s = s + "  TObj *a = tid(ha), *b = tid(hb); int i, n = a->n, rank = a->rank, shape[8]; KREAL *ad = a->data, *bd = b->data; int64_t h;\n";
    s = s + "  if (a->n != b->n) { fprintf(stderr, \"tensor size mismatch\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i]; h = talloc(shape, rank, 0);\n";
    s = s + "  for (i = 0; i < n; i++) gT[h].data[i] = ad[i] * bd[i]; return h;\n";
    s = s + "}\n";
    s = s + "static int64_t trelu(int64_t ha) { int64_t h = tclone(ha); int i; for (i = 0; i < gT[h].n; i++) if (gT[h].data[i] < 0.0) gT[h].data[i] = 0.0; return h; }\n";
    s = s + "static int64_t texp(int64_t ha) { int64_t h = tclone(ha); int i; for (i = 0; i < gT[h].n; i++) gT[h].data[i] = exp(gT[h].data[i]); return h; }\n";
    s = s + "static int64_t tlog(int64_t ha) { int64_t h = tclone(ha); int i; for (i = 0; i < gT[h].n; i++) { double x = gT[h].data[i]; if (x < 1e-12) x = 1e-12; gT[h].data[i] = log(x); } return h; }\n";
    s = s + "static int64_t tsoftmax(int64_t ha) {\n";
    s = s + "  int64_t h = tclone(ha); double mx = -1e300, sum = 0.0; int i; if (gT[h].n < 1) return h;\n";
    s = s + "  for (i = 0; i < gT[h].n; i++) if (gT[h].data[i] > mx) mx = gT[h].data[i];\n";
    s = s + "  for (i = 0; i < gT[h].n; i++) { gT[h].data[i] = exp(gT[h].data[i] - mx); sum += gT[h].data[i]; }\n";
    s = s + "  if (sum < 1e-300) sum = 1e-300; for (i = 0; i < gT[h].n; i++) gT[h].data[i] /= sum; return h;\n";
    s = s + "}\n";
    s = s + "static double tsum(int64_t ha) { TObj *a = tid(ha); double acc = 0.0; int i; for (i = 0; i < a->n; i++) acc += a->data[i]; return acc; }\n";
    s = s + "static int64_t tfill_like(int64_t ha, double v) { TObj *a = tid(ha); int shape[8], rank = a->rank, i; for (i = 0; i < rank; i++) shape[i] = a->shape[i]; int64_t h = talloc(shape, rank, 0); for (i = 0; i < gT[h].n; i++) gT[h].data[i] = v; return h; }\n";
    s = s + "enum { BAG_LEAF = 0, BAG_MATMUL, BAG_MSE, BAG_ADD, BAG_SUB, BAG_MUL, BAG_SCALE, BAG_RELU, BAG_NEG, BAG_TRANSPOSE, BAG_RESHAPE, BAG_EXP, BAG_LOG, BAG_SOFTMAX, BAG_SUM };\n";
    s = s + "typedef struct { int is_scalar, has_grad, grad_is_scalar, op, pa, pb, requires_grad, old_rank, old_shape[8]; int64_t th, gth; double scalar, gscalar, scale; } BagNode;\n";
    s = s + "static BagNode gBag[1024]; static int gBagn = 0;\n";
    s = s + "static BagNode *bag_node(int64_t id) { if (id < 0 || id >= gBagn) { fprintf(stderr, \"ag: bad node id\\n\"); exit(1); } return &gBag[id]; }\n";
    s = s + "static int64_t bag_push(BagNode n) { if (gBagn >= 1024) { fprintf(stderr, \"ag: tape full\\n\"); exit(1); } gBag[gBagn] = n; return (int64_t)gBagn++; }\n";
    s = s + "static void bag_accum(BagNode *n, int64_t add_th) {\n";
    s = s + "  int i; if (!n->has_grad) { n->has_grad = 1; n->grad_is_scalar = 0; n->gth = tclone(add_th); return; }\n";
    s = s + "  if (n->grad_is_scalar) { fprintf(stderr, \"ag: grad type mismatch\\n\"); exit(1); }\n";
    s = s + "  { TObj *g = tid(n->gth), *add = tid(add_th); if (g->n != add->n) { fprintf(stderr, \"ag: grad len mismatch\\n\"); exit(1); } for (i = 0; i < g->n; i++) g->data[i] += add->data[i]; }\n";
    s = s + "}\n";
    s = s + "static void bag_accum_s(BagNode *n, double add) {\n";
    s = s + "  if (!n->has_grad) { n->has_grad = 1; n->grad_is_scalar = 1; n->gscalar = add; return; }\n";
    s = s + "  if (!n->grad_is_scalar) { fprintf(stderr, \"ag: grad type mismatch\\n\"); exit(1); }\n";
    s = s + "  n->gscalar += add;\n";
    s = s + "}\n";
    s = s + "static int64_t bag_leaf(int64_t th, int requires_grad) {\n";
    s = s + "  BagNode n; memset(&n, 0, sizeof(n)); n.th = tclone(th); n.op = BAG_LEAF; n.requires_grad = requires_grad; n.pa = n.pb = -1; return bag_push(n);\n";
    s = s + "}\n";
    s = s + "static void bag_backward(int64_t loss_id) {\n";
    s = s + "  int i; if (loss_id < 0 || loss_id >= gBagn) { fprintf(stderr, \"ag_backward: bad loss id\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < gBagn; i++) gBag[i].has_grad = 0;\n";
    s = s + "  { BagNode *loss = &gBag[loss_id]; if (!loss->is_scalar) { fprintf(stderr, \"ag_backward: loss must be scalar\\n\"); exit(1); } loss->has_grad = 1; loss->grad_is_scalar = 1; loss->gscalar = 1.0; }\n";
    s = s + "  for (i = (int)loss_id; i >= 0; i--) {\n";
    s = s + "    BagNode *node = &gBag[i]; if (!node->has_grad) continue;\n";
    s = s + "    if (node->op == BAG_LEAF) continue;\n";
    s = s + "    if (node->op == BAG_MATMUL) {\n";
    s = s + "      BagNode *a = &gBag[node->pa], *b = &gBag[node->pb];\n";
    s = s + "      bag_accum(a, tmatmul_ids(node->gth, ttranspose(b->th)));\n";
    s = s + "      bag_accum(b, tmatmul_ids(ttranspose(a->th), node->gth)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_MSE) {\n";
    s = s + "      BagNode *p = &gBag[node->pa], *t = &gBag[node->pb];\n";
    s = s + "      double g = node->grad_is_scalar ? node->gscalar : 1.0; int64_t err = tew_sub(p->th, t->th);\n";
    s = s + "      double scale = 2.0 * g / (gT[err].n > 0 ? (double)gT[err].n : 1.0);\n";
    s = s + "      bag_accum(p, tscale(err, scale)); bag_accum(t, tscale(err, -scale)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_ADD) { bag_accum(&gBag[node->pa], node->gth); bag_accum(&gBag[node->pb], node->gth); continue; }\n";
    s = s + "    if (node->op == BAG_SUB) { bag_accum(&gBag[node->pa], node->gth); bag_accum(&gBag[node->pb], tscale(node->gth, -1.0)); continue; }\n";
    s = s + "    if (node->op == BAG_MUL) { bag_accum(&gBag[node->pa], tew_mul(node->gth, gBag[node->pb].th)); bag_accum(&gBag[node->pb], tew_mul(node->gth, gBag[node->pa].th)); continue; }\n";
    s = s + "    if (node->op == BAG_SCALE) {\n";
    s = s + "      if (node->grad_is_scalar) bag_accum_s(&gBag[node->pa], node->gscalar * node->scale);\n";
    s = s + "      else bag_accum(&gBag[node->pa], tscale(node->gth, node->scale)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_NEG) {\n";
    s = s + "      if (node->grad_is_scalar) bag_accum_s(&gBag[node->pa], -node->gscalar);\n";
    s = s + "      else bag_accum(&gBag[node->pa], tscale(node->gth, -1.0)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_TRANSPOSE) { bag_accum(&gBag[node->pa], ttranspose(node->gth)); continue; }\n";
    s = s + "    if (node->op == BAG_RESHAPE) {\n";
    s = s + "      TObj *g = tid(node->gth); KREAL *src = g->data; int nn = g->n; int64_t h = talloc(node->old_shape, node->old_rank, 0);\n";
    s = s + "      memcpy(gT[h].data, src, (size_t)nn * sizeof(KREAL)); bag_accum(&gBag[node->pa], h); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_EXP) {\n";
    s = s + "      if (node->is_scalar) bag_accum_s(&gBag[node->pa], node->gscalar * node->scalar);\n";
    s = s + "      else bag_accum(&gBag[node->pa], tew_mul(node->gth, node->th)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_LOG) {\n";
    s = s + "      BagNode *a = &gBag[node->pa];\n";
    s = s + "      if (node->grad_is_scalar) { double x = a->is_scalar ? a->scalar : 1.0; if (x < 1e-12) x = 1e-12; bag_accum_s(a, node->gscalar / x); }\n";
    s = s + "      else { TObj *xv = tid(a->th), *gg = tid(node->gth); KREAL *xd = xv->data, *gd = gg->data; int64_t h = tclone(node->gth); int j; for (j = 0; j < gT[h].n; j++) { double x = xd[j] < 1e-12 ? 1e-12 : xd[j]; gT[h].data[j] = gd[j] / x; } bag_accum(a, h); }\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_SOFTMAX) {\n";
    s = s + "      TObj *y = tid(node->th), *gy = tid(node->gth); KREAL *yd = y->data, *gyd = gy->data; double dot = 0.0; int j, yn = y->n; int64_t h;\n";
    s = s + "      if (yn != gy->n) { fprintf(stderr, \"ag softmax grad len\\n\"); exit(1); }\n";
    s = s + "      for (j = 0; j < yn; j++) dot += gyd[j] * yd[j];\n";
    s = s + "      h = tclone(node->th); for (j = 0; j < gT[h].n; j++) gT[h].data[j] = yd[j] * (gyd[j] - dot);\n";
    s = s + "      bag_accum(&gBag[node->pa], h); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_SUM) {\n";
    s = s + "      BagNode *a = &gBag[node->pa]; double g = node->grad_is_scalar ? node->gscalar : 1.0;\n";
    s = s + "      if (a->is_scalar) bag_accum_s(a, g); else bag_accum(a, tfill_like(a->th, g)); continue;\n";
    s = s + "    }\n";
    s = s + "    if (node->op == BAG_RELU) {\n";
    s = s + "      BagNode *a = &gBag[node->pa]; TObj *av = tid(a->th); KREAL *ad = av->data; int64_t h = tclone(node->gth); int j;\n";
    s = s + "      for (j = 0; j < gT[h].n; j++) if (ad[j] <= 0.0) gT[h].data[j] = 0.0;\n";
    s = s + "      bag_accum(a, h); continue;\n";
    s = s + "    }\n";
    s = s + "    fprintf(stderr, \"ag_backward: unknown op\\n\"); exit(1);\n";
    s = s + "  }\n";
    s = s + "}\n\n";
    s = s + "#define BM_D 32\n#define BM_H 32\n#define BM_EP 32\n";
    s = s + "typedef struct { int dim, hidden; double w1[BM_H*BM_D], b1[BM_H], w2[BM_D*BM_H], b2[BM_D]; double w1l[BM_H*BM_D], b1l[BM_H], w2l[BM_D*BM_H], b2l[BM_D]; uint64_t steps; } BmWorld;\n";
    s = s + "typedef struct { double pattern[BM_D]; double target[BM_D]; int dim, target_dim, has_target; double surprise; } BmEp;\n";
    s = s + "typedef struct { BmWorld model; double threshold, lr; BmEp ep[BM_EP]; int nep, ep_head, ep_cap; } BmMind;\n";
    s = s + "static BmMind gM[16]; static int gMn = 0;\n";
    s = s + "static double bm_xavier(int fan_in, int fan_out, int i) {\n";
    s = s + "  double sc = sqrt(6.0 / (double)(fan_in + fan_out)); int64_t t = (int64_t)i * 1103515245LL + 12345LL;\n";
    s = s + "  if (t < 0) t = -t; return (((double)(t % 10000LL) / 10000.0) * 2.0 - 1.0) * sc;\n";
    s = s + "}\n";
    s = s + "static void bm_init(BmWorld *m, int dim, int hidden) {\n";
    s = s + "  int i, d, h; if (dim < 1) dim = 1; if (dim > BM_D) dim = BM_D; if (hidden < 1) hidden = 1; if (hidden > BM_H) hidden = BM_H;\n";
    s = s + "  memset(m, 0, sizeof(*m)); m->dim = dim; m->hidden = hidden; d = dim; h = hidden;\n";
    s = s + "  for (i = 0; i < h * d; i++) m->w1[i] = bm_xavier(d, h, i);\n";
    s = s + "  for (i = 0; i < d * h; i++) m->w2[i] = bm_xavier(h, d, i + 17) * 0.25;\n";
    s = s + "}\n";
    s = s + "static void bm_ensure(BmWorld *m, int dim) {\n";
    s = s + "  BmWorld old; int od, h, r, c; if (dim < 1) dim = 1; if (dim > BM_D) dim = BM_D; if (dim <= m->dim) return;\n";
    s = s + "  old = *m; od = old.dim; h = old.hidden; bm_init(m, dim, h);\n";
    s = s + "  for (r = 0; r < h; r++) { for (c = 0; c < od; c++) { m->w1[r*m->dim+c]=old.w1[r*od+c]; m->w1l[r*m->dim+c]=old.w1l[r*od+c]; } m->b1[r]=old.b1[r]; m->b1l[r]=old.b1l[r]; }\n";
    s = s + "  for (r = 0; r < od; r++) { for (c = 0; c < h; c++) { m->w2[r*h+c]=old.w2[r*h+c]; m->w2l[r*h+c]=old.w2l[r*h+c]; } m->b2[r]=old.b2[r]; m->b2l[r]=old.b2l[r]; }\n";
    s = s + "  m->steps = old.steps;\n";
    s = s + "}\n";
    s = s + "static void bm_fwd(const BmWorld *m, const double *x, int xn, double *h_out, double *y_out) {\n";
    s = s + "  int d = m->dim, h = m->hidden, r, c;\n";
    s = s + "  for (r = 0; r < h; r++) { double acc = m->b1[r]; for (c = 0; c < d; c++) acc += m->w1[r*d+c] * (c < xn ? x[c] : 0.0); h_out[r] = tanh(acc); }\n";
    s = s + "  for (r = 0; r < d; r++) { double delta = m->b2[r]; for (c = 0; c < h; c++) delta += m->w2[r*h+c] * h_out[c]; y_out[r] = (r < xn ? x[r] : 0.0) + delta; }\n";
    s = s + "}\n";
    s = s + "static double bm_train(BmWorld *m, const double *x, int xn, const double *tgt, int tn, double lr) {\n";
    s = s + "  int need = xn > tn ? xn : tn; double hh[BM_H], yy[BM_D], dy[BM_D], dh[BM_H]; int d, h, r, c, i; double loss = 0.0;\n";
    s = s + "  if (need < 1) need = 1; bm_ensure(m, need); d = m->dim; h = m->hidden; bm_fwd(m, x, xn, hh, yy);\n";
    s = s + "  for (i = 0; i < d; i++) { double t = i < tn ? tgt[i] : 0.0; double err = t - yy[i]; loss += err * err; dy[i] = err; }\n";
    s = s + "  loss /= (double)d;\n";
    s = s + "  for (c = 0; c < h; c++) { double acc = 0.0; for (r = 0; r < d; r++) acc += m->w2[r*h+c] * dy[r]; dh[c] = acc * (1.0 - hh[c]*hh[c]); }\n";
    s = s + "  for (r = 0; r < d; r++) { for (c = 0; c < h; c++) { int idx = r*h+c; double g = dy[r]*hh[c]; double eff = lr/(1.0+m->w2l[idx]); m->w2[idx]+=eff*g; m->w2l[idx]+=0.02*fabs(g); }\n";
    s = s + "    { double eff = lr/(1.0+m->b2l[r]); m->b2[r]+=eff*dy[r]; m->b2l[r]+=0.02*fabs(dy[r]); } }\n";
    s = s + "  for (r = 0; r < h; r++) { for (c = 0; c < d; c++) { int idx = r*d+c; double xv = c < xn ? x[c] : 0.0; double g = dh[r]*xv; double eff = lr/(1.0+m->w1l[idx]); m->w1[idx]+=eff*g; m->w1l[idx]+=0.02*fabs(g); }\n";
    s = s + "    { double eff = lr/(1.0+m->b1l[r]); m->b1[r]+=eff*dh[r]; m->b1l[r]+=0.02*fabs(dh[r]); } }\n";
    s = s + "  m->steps++; return loss;\n";
    s = s + "}\n";
    s = s + "static int vlist_pat(V v, double *out, int maxn) {\n";
    s = s + "  int i, n; if (v.tag==0 || v.tag==1) { if (maxn<1) { fprintf(stderr, \"pattern too long\\n\"); exit(1); } out[0]=as_f(v); return 1; }\n";
    s = s + "  if (v.tag!=2) { fprintf(stderr, \"expected list\\n\"); exit(1); }\n";
    s = s + "  n = (int)llen(v.i); if (n > maxn) { fprintf(stderr, \"pattern too long\\n\"); exit(1); }\n";
    s = s + "  for (i = 0; i < n; i++) out[i] = as_f(lget(v.i, i)); return n;\n";
    s = s + "}\n";
    s = s + "static V pat_list(const double *p, int n) {\n";
    s = s + "  int64_t id = lnew(); int i; if (n < 0) n = 0; for (i = 0; i < n; i++) lpush(id, Vf(p[i])); return Vl(id);\n";
    s = s + "}\n";
    s = s + "static BmMind *bm_get(V v) {\n";
    s = s + "  if (v.tag != 4 || v.i < 0 || v.i >= gMn) { fprintf(stderr, \"expected memory\\n\"); exit(1); }\n";
    s = s + "  return &gM[v.i];\n";
    s = s + "}\n";
    s = s + "static int bm_ep_push(BmMind *m, const double *x, int xn, const double *y, int yn) {\n";
    s = s + "  int i, slot; if (xn < 0) xn = 0; if (yn < 0) yn = 0; if (xn > BM_D) xn = BM_D; if (yn > BM_D) yn = BM_D;\n";
    s = s + "  if (m->ep_cap < 1) m->ep_cap = BM_EP; if (m->ep_cap > BM_EP) m->ep_cap = BM_EP;\n";
    s = s + "  if (m->nep < m->ep_cap) { slot = m->nep; m->nep++; } else { slot = m->ep_head; m->ep_head++; if (m->ep_head >= m->ep_cap) m->ep_head = 0; }\n";
    s = s + "  memset(&m->ep[slot], 0, sizeof(m->ep[slot])); m->ep[slot].dim = xn; for (i = 0; i < xn; i++) m->ep[slot].pattern[i] = x[i];\n";
    s = s + "  m->ep[slot].has_target = yn > 0 ? 1 : 0; m->ep[slot].target_dim = yn; for (i = 0; i < yn; i++) m->ep[slot].target[i] = y[i]; return slot;\n";
    s = s + "}\n";
    s = s + "static double bm_dist(const double *a, int an, const double *b, int bn) {\n";
    s = s + "  int n = an > bn ? an : bn, i; double sum = 0.0; if (n < 1) n = 1;\n";
    s = s + "  for (i = 0; i < n; i++) { double d = (i < an ? a[i] : 0.0) - (i < bn ? b[i] : 0.0); sum += d * d; }\n";
    s = s + "  return sqrt(sum / (double)n);\n";
    s = s + "}\n";
    s = s + "static V bm_predict_list(BmMind *m, const double *xp, int xn) {\n";
    s = s + "  BmWorld tmp; double hh[BM_H], yy[BM_D]; int n; tmp = m->model; bm_ensure(&tmp, xn > 0 ? xn : 1);\n";
    s = s + "  bm_fwd(&tmp, xp, xn, hh, yy); n = xn > 0 ? xn : tmp.dim; if (n > tmp.dim) n = tmp.dim; return pat_list(yy, n);\n";
    s = s + "}\n";
    s = s + "static void bm_blend_ep(const BmMind *m, const double *obs, int on, double *out, int *out_n) {\n";
    s = s + "  int i, t, dim = on; double wsum = 0.0; double ws[BM_EP]; int idx[BM_EP]; int n = m->nep;\n";
    s = s + "  if (n == 0) { *out_n = 0; return; }\n";
    s = s + "  for (i = 0; i < n; i++) { double d = bm_dist(m->ep[i].pattern, m->ep[i].dim, obs, on); ws[i] = 1.0 / (0.05 + d); idx[i] = i; if (m->ep[i].dim > dim) dim = m->ep[i].dim; }\n";
    s = s + "  if (dim > BM_D) dim = BM_D;\n";
    s = s + "  for (i = 0; i < n; i++) { int j; for (j = i + 1; j < n; j++) { if (ws[idx[j]] > ws[idx[i]]) { int tmp = idx[i]; idx[i] = idx[j]; idx[j] = tmp; } } }\n";
    s = s + "  t = n < 3 ? n : 3; for (i = 0; i < dim; i++) out[i] = 0.0;\n";
    s = s + "  for (i = 0; i < t; i++) { int ei = idx[i], k; wsum += ws[ei]; for (k = 0; k < dim; k++) { double p = k < m->ep[ei].dim ? m->ep[ei].pattern[k] : 0.0; out[k] += ws[ei] * p; } }\n";
    s = s + "  if (wsum < 1e-9) wsum = 1e-9; for (i = 0; i < dim; i++) out[i] /= wsum; *out_n = dim;\n";
    s = s + "}\n";
    s = s + "static V bm_foresee_list(BmMind *m, const double *xp, int xn) {\n";
    s = s + "  BmWorld tmp; double hh[BM_H], neural[BM_D], core[BM_D], out[BM_D]; int nn, cn, dim, i; double nw, cw;\n";
    s = s + "  tmp = m->model; bm_ensure(&tmp, xn > 0 ? xn : 1); bm_fwd(&tmp, xp, xn, hh, neural);\n";
    s = s + "  nn = xn > 0 ? xn : tmp.dim; if (nn > tmp.dim) nn = tmp.dim; bm_blend_ep(m, xp, xn, core, &cn);\n";
    s = s + "  if (cn == 0) { if (m->model.steps == 0) return pat_list(xp, xn); return pat_list(neural, nn); }\n";
    s = s + "  dim = nn > cn ? nn : cn; if (xn > dim) dim = xn; if (dim > BM_D) dim = BM_D;\n";
    s = s + "  nw = m->model.steps > 0 ? 0.6 : 0.15; cw = 1.0 - nw;\n";
    s = s + "  for (i = 0; i < dim; i++) { double n = i < nn ? neural[i] : 0.0; double c = i < cn ? core[i] : 0.0; double o = i < xn ? xp[i] : 0.0; out[i] = nw * n + cw * c * 0.8 + o * 0.2; }\n";
    s = s + "  return pat_list(out, dim);\n";
    s = s + "}\n";
    s = s + "static void bm_write_f64s(FILE *f, const double *xs, int n) {\n";
    s = s + "  int i; for (i = 0; i < n; i++) { if (i) fputc(' ', f); fprintf(f, \"%.17g\", xs[i]); } fputc('\\n', f);\n";
    s = s + "}\n";
    s = s + "static int bm_read_f64s(FILE *f, double *out, int n) {\n";
    s = s + "  int i; for (i = 0; i < n; i++) if (fscanf(f, \"%lf\", &out[i]) != 1) return -1; return 0;\n";
    s = s + "}\n\n";
    s = s + "#define EVQ_CAP 256\n";
    s = s + "static char *ev_names[EVQ_CAP];\n";
    s = s + "static V ev_vals[EVQ_CAP];\n";
    s = s + "static int ev_head = 0, ev_tail = 0;\n\n";
    s = s + "static void ev_enqueue(const char *name, V val) {\n";
    s = s + "  if (ev_tail >= EVQ_CAP) { fprintf(stderr, \"event queue full\\n\"); exit(1); }\n";
    s = s + "  ev_names[ev_tail] = strdup(name);\n";
    s = s + "  if (!ev_names[ev_tail]) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "  ev_vals[ev_tail] = val; ev_tail++;\n";
    s = s + "}\n";
    s = s + "static int ev_dequeue(char **name, V *val) {\n";
    s = s + "  if (ev_head >= ev_tail) return 0;\n";
    s = s + "  *name = ev_names[ev_head]; *val = ev_vals[ev_head]; ev_head++; return 1;\n";
    s = s + "}\n";
    s = s + "static int64_t find_handler(const char *event_name) {\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < g_nhandlers; i++) if (strcmp(event_name, g_strs[g_handlers[i].str_idx]) == 0) return i;\n";
    s = s + "  return -1;\n";
    s = s + "}\n\n";
    s = s + "/* mark-sweep GC: roots = VM stack + slots + event queue + tape bag */\n";
    s = s + "static char *gTmk = NULL; static int64_t gTmkcap = 0;\n";
    s = s + "static char *gLmk = NULL; static int64_t gLmkcap = 0;\n";
    s = s + "static void gc_mark_v(V v) {\n";
    s = s + "  if (v.tag == 2) { int64_t id = v.i; if (id >= 0 && id < gLn && !gLmk[id]) { size_t k; gLmk[id] = 1; for (k = 0; k < gL[id].n; k++) gc_mark_v(gL[id].d[k]); } }\n";
    s = s + "  else if (v.tag == 5) { if (v.i >= 0 && v.i < gTn) gTmk[v.i] = 1; }\n";
    s = s + "}\n";
    s = s + "static void gc_sweep(V *stack, int sp, V *slots, int nslots) {\n";
    s = s + "  int64_t k; int j; int64_t f;\n";
    s = s + "  if (gTmkcap < gTn) { gTmkcap = gTn + 4096; gTmk = (char*)realloc(gTmk, (size_t)gTmkcap); if (!gTmk) { fprintf(stderr, \"oom\\n\"); exit(1); } }\n";
    s = s + "  if (gLmkcap < gLn) { gLmkcap = gLn + 4096; gLmk = (char*)realloc(gLmk, (size_t)gLmkcap); if (!gLmk) { fprintf(stderr, \"oom\\n\"); exit(1); } }\n";
    s = s + "  memset(gTmk, 0, (size_t)gTn); memset(gLmk, 0, (size_t)gLn);\n";
    s = s + "  for (j = 0; j < sp; j++) gc_mark_v(stack[j]);\n";
    s = s + "  for (j = 0; j < nslots; j++) gc_mark_v(slots[j]);\n";
    s = s + "  for (j = ev_head; j < ev_tail; j++) gc_mark_v(ev_vals[j]);\n";
    s = s + "  for (k = 0; k < gBagn; k++) { if (gBag[k].th >= 0 && gBag[k].th < gTn) gTmk[gBag[k].th] = 1; if (gBag[k].gth >= 0 && gBag[k].gth < gTn) gTmk[gBag[k].gth] = 1; }\n";
    s = s + "  f = gTfree; while (f >= 0) { gTmk[f] = 1; f = gT[f].next_free; }\n";
    s = s + "  f = gLfree; while (f >= 0) { gLmk[f] = 1; f = gL[f].next_free; }\n";
    s = s + "  for (k = 0; k < gLn; k++) if (!gLmk[k]) { if (gL[k].d) free(gL[k].d); gL[k].d = NULL; gL[k].n = 0; gL[k].cap = 0; gL[k].next_free = gLfree; gLfree = k; gLfreecnt++; g_ltype[k] = NULL; }\n";
    s = s + "  for (k = 0; k < gTn; k++) if (!gTmk[k]) { if (gT[k].data) { gTbytes -= (size_t)gT[k].n * sizeof(KREAL); free(gT[k].data); } gT[k].data = NULL; gT[k].n = 0; gT[k].next_free = gTfree; gTfree = k; gTfreecnt++; }\n";
    s = s + "}\n";

    s = s + "static int64_t vm_run(const int64_t *code, int64_t n) {\n";
    s = s + "  V stack[4096]; int sp = 0;\n";
    s = s + "  V slots[4096]; int64_t slot_used = 0;\n";
    s = s + "  int64_t ret_ips[64]; int rsp = 0;\n";
    s = s + "  int64_t slot_bases[64];\n";
    s = s + "  int64_t slot_base = 0;\n";
    s = s + "  int64_t ip = 0; int i;\n";
    s = s + "  int pump_active = 0;\n";
    s = s + "  int64_t pump_left = 0;\n";
    s = s + "  int64_t pump_done = 0;\n";
    s = s + "  int64_t pump_ret_ip = 0;\n";
    s = s + "  for (i = 0; i < 4096; i++) slots[i] = Vi(0);\n";
    s = s + "  while (ip < n) {\n";
    s = s + "  vm_step:\n";
    s = s + "if (gGCp) { gGCp = 0; gc_sweep(stack, sp, slots, 4096); }\n";
    s = s + "    if (pump_active) {\n";
    s = s + "      while (pump_left > 0) {\n";
    s = s + "        char *name_str; V val; int64_t hi, haddr, harity;\n";
    s = s + "        if (!ev_dequeue(&name_str, &val)) break;\n";
    s = s + "        pump_left--;\n";
    s = s + "        hi = find_handler(name_str);\n";
    s = s + "        if (hi < 0) continue;\n";
    s = s + "        haddr = g_handlers[hi].addr; harity = g_handlers[hi].arity;\n";
    s = s + "        ret_ips[rsp] = -1; slot_bases[rsp] = slot_base; rsp++;\n";
    s = s + "        slot_base = slot_used;\n";
    s = s + "        if (harity == 1) {\n";
    s = s + "          slots[slot_base] = val;\n";
    s = s + "          if (slot_base + 1 > slot_used) slot_used = slot_base + 1;\n";
    s = s + "        } else if (harity != 0) { fprintf(stderr, \"bad handler arity\\n\"); exit(1); }\n";
    s = s + "        ip = haddr;\n";
    s = s + "        pump_active = 0;\n";
    s = s + "        goto vm_step;\n";
    s = s + "      }\n";
    s = s + "      pump_active = 0;\n";
    s = s + "      ip = pump_ret_ip;\n";
    s = s + "      stack[sp++] = Vi(pump_done);\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    int64_t op = code[ip++];\n";
    s = s + "    if (op == OP_CONST) { stack[sp++] = Vi(code[ip++]); }\n";
    s = s + "    else if (op == OP_CONST_F64) { stack[sp++] = Vf(g_f64s[code[ip++]]); }\n";
    s = s + "    else if (op == OP_CONST_STR) { stack[sp++] = Vs(s_from_pool((int)code[ip++])); }\n";
    s = s + "    else if (op == OP_LOAD) { stack[sp++] = slots[slot_base + code[ip++]]; }\n";
    s = s + "    else if (op == OP_STORE) { int64_t idx=slot_base+code[ip++]; slots[idx]=stack[--sp]; if (idx+1>slot_used) slot_used=idx+1; }\n";
    s = s + "    else if (op == OP_ADD) {\n";
    s = s + "      V b=stack[--sp]; V a=stack[--sp];\n";
    s = s + "      if (a.tag==3 || b.tag==3) {\n";
    s = s + "        char *sa=v_to_cstr(a), *sb=v_to_cstr(b); size_t na=strlen(sa), nb=strlen(sb);\n";
    s = s + "        char *cat=(char*)malloc(na+nb+1);\n";
    s = s + "        if (!cat) { fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "        memcpy(cat, sa, na); memcpy(cat+na, sb, nb+1);\n";
    s = s + "        free(sa); free(sb); stack[sp++]=Vs(s_new(cat)); free(cat);\n";
    s = s + "      } else if (a.tag==1||b.tag==1) stack[sp++]=Vf(as_f(a)+as_f(b));\n";
    s = s + "      else stack[sp++]=Vi(a.i+b.i);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SUB) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vf(as_f(a)-as_f(b)); else stack[sp++]=Vi(a.i-b.i); }\n";
    s = s + "    else if (op == OP_MUL) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vf(as_f(a)*as_f(b)); else stack[sp++]=Vi(a.i*b.i); }\n";
    s = s + "    else if (op == OP_DIV) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vf(as_f(a)/as_f(b)); else stack[sp++]=Vi(a.i/b.i); }\n";
    s = s + "    else if (op == OP_MOD) { V b=stack[--sp]; V a=stack[--sp]; stack[sp++]=Vi(as_i(a) % as_i(b)); }\n";
    s = s + "    else if (op == OP_AND) { V b=stack[--sp]; V a=stack[--sp]; stack[sp++]=Vi((as_i(a)!=0 && as_i(b)!=0)?1:0); }\n";
    s = s + "    else if (op == OP_OR) { V b=stack[--sp]; V a=stack[--sp]; stack[sp++]=Vi((as_i(a)!=0 || as_i(b)!=0)?1:0); }\n";
    s = s + "    else if (op == OP_NOT) { V a=stack[--sp]; stack[sp++]=Vi(as_i(a)==0?1:0); }\n";
    s = s + "    else if (op == OP_LT) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)<as_f(b)); else stack[sp++]=Vi(a.i<b.i); }\n";
    s = s + "    else if (op == OP_LE) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)<=as_f(b)); else stack[sp++]=Vi(a.i<=b.i); }\n";
    s = s + "    else if (op == OP_GT) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)>as_f(b)); else stack[sp++]=Vi(a.i>b.i); }\n";
    s = s + "    else if (op == OP_GE) { V b=stack[--sp]; V a=stack[--sp]; if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)>=as_f(b)); else stack[sp++]=Vi(a.i>=b.i); }\n";
    s = s + "    else if (op == OP_EQ) {\n";
    s = s + "      V b=stack[--sp]; V a=stack[--sp];\n";
    s = s + "      if (a.tag==3 && b.tag==3) stack[sp++]=Vi(strcmp(as_str(a), as_str(b))==0);\n";
    s = s + "      else if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)==as_f(b));\n";
    s = s + "      else stack[sp++]=Vi(a.i==b.i);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_NE) {\n";
    s = s + "      V b=stack[--sp]; V a=stack[--sp];\n";
    s = s + "      if (a.tag==3 && b.tag==3) stack[sp++]=Vi(strcmp(as_str(a), as_str(b))!=0);\n";
    s = s + "      else if (a.tag==1||b.tag==1) stack[sp++]=Vi(as_f(a)!=as_f(b));\n";
    s = s + "      else stack[sp++]=Vi(a.i!=b.i);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_ROUND) { V x=stack[--sp]; stack[sp++]=Vi((int64_t)llround(as_f(x))); }\n";
    s = s + "    else if (op == OP_TYPEOF) {\n";
    s = s + "      V v=stack[--sp]; const char *tn=\"i64\";\n";
    s = s + "      if (v.tag==1) tn=\"f64\";\n";
    s = s + "      else if (v.tag==2) tn=\"list\";\n";
    s = s + "      else if (v.tag==3) tn=\"str\";\n";
    s = s + "      else if (v.tag==4) tn=\"memory\";\n";
    s = s + "      else if (v.tag==5) tn=\"tensor\";\n";
    s = s + "      stack[sp++]=Vs(s_new(tn));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_TO_STR) {\n";
    s = s + "      V v=stack[--sp]; char buf[64];\n";
    s = s + "      if (v.tag==3) stack[sp++]=v;\n";
    s = s + "      else if (v.tag==0) { snprintf(buf, sizeof(buf), \"%lld\", (long long)v.i); stack[sp++]=Vs(s_new(buf)); }\n";
    s = s + "      else if (v.tag==1) { snprintf(buf, sizeof(buf), \"%g\", v.f); stack[sp++]=Vs(s_new(buf)); }\n";
    s = s + "      else { snprintf(buf, sizeof(buf), \"[list]\"); stack[sp++]=Vs(s_new(buf)); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_JMP) { ip = code[ip]; }\n";
    s = s + "    else if (op == OP_JMPF) { int64_t t=code[ip++]; int64_t c=as_i(stack[--sp]); if (!c) ip = t; }\n";
    s = s + "    else if (op == OP_PRINTLN) {\n";
    s = s + "      V v=stack[--sp];\n";
    s = s + "      if (v.tag==2) {\n";
    s = s + "        int64_t lid=v.i; LObj *L=&gL[lid]; const char *tn=g_ltype[lid]; size_t li;\n";
    s = s + "        if (tn && tn[0]) {\n";
    s = s + "          printf(\"%s{\", tn);\n";
    s = s + "          for (li=0; li<L->n; li++) { if (li) printf(\", \"); vprint(L->d[li]); }\n";
    s = s + "          printf(\"}\\n\");\n";
    s = s + "        } else {\n";
    s = s + "          printf(\"[\");\n";
    s = s + "          for (li=0; li<L->n; li++) { if (li) printf(\", \"); vprint(L->d[li]); }\n";
    s = s + "          printf(\"]\\n\");\n";
    s = s + "        }\n";
    s = s + "      } else if (v.tag==3) printf(\"%s\\n\", as_str(v));\n";
    s = s + "      else if (v.tag==1) printf(\"%g\\n\", v.f);\n";
    s = s + "      else printf(\"%lld\\n\", (long long)v.i);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_PRINT) {\n";
    s = s + "      V v=stack[--sp];\n";
    s = s + "      if (v.tag==2) {\n";
    s = s + "        int64_t lid=v.i; LObj *L=&gL[lid]; const char *tn=g_ltype[lid]; size_t li;\n";
    s = s + "        if (tn && tn[0]) {\n";
    s = s + "          printf(\"%s{\", tn);\n";
    s = s + "          for (li=0; li<L->n; li++) { if (li) printf(\", \"); vprint(L->d[li]); }\n";
    s = s + "          printf(\"}\");\n";
    s = s + "        } else {\n";
    s = s + "          printf(\"[\");\n";
    s = s + "          for (li=0; li<L->n; li++) { if (li) printf(\", \"); vprint(L->d[li]); }\n";
    s = s + "          printf(\"]\");\n";
    s = s + "        }\n";
    s = s + "      } else if (v.tag==3) printf(\"%s\", as_str(v));\n";
    s = s + "      else if (v.tag==1) printf(\"%g\", v.f);\n";
    s = s + "      else printf(\"%lld\", (long long)v.i);\n";
    s = s + "      fflush(stdout);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SLEEP_MS) {\n";
    s = s + "      int64_t n = as_i(stack[--sp]);\n";
    s = s + "      if (n < 0) { fprintf(stderr, \"sleep_ms: n >= 0\\n\"); exit(1); }\n";
    s = s + "      if (n > 0) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "        Sleep((DWORD)n);\n";
    s = s + "#else\n";
    s = s + "        {\n";
    s = s + "          unsigned long left = (unsigned long)n;\n";
    s = s + "          while (left > 0) {\n";
    s = s + "            unsigned long chunk = left > 999UL ? 999UL : left;\n";
    s = s + "            usleep((unsigned int)(chunk * 1000UL));\n";
    s = s + "            left = left - chunk;\n";
    s = s + "          }\n";
    s = s + "        }\n";
    s = s + "#endif\n";
    s = s + "      }\n";
    s = s + "      stack[sp++] = Vi(0);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_NOW_MS) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "      stack[sp++] = Vi((int64_t)GetTickCount64());\n";
    s = s + "#else\n";
    s = s + "      {\n";
    s = s + "        struct timeval tv;\n";
    s = s + "        gettimeofday(&tv, 0);\n";
    s = s + "        stack[sp++] = Vi((int64_t)tv.tv_sec * 1000 + (int64_t)tv.tv_usec / 1000);\n";
    s = s + "      }\n";
    s = s + "#endif\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_ASSERT) { if (!as_i(stack[--sp])) { fprintf(stderr, \"assert failed\\n\"); exit(1); } }\n";
    s = s + "    else if (op == OP_POP) { if (sp > 0) sp--; }\n";
    s = s + "    else if (op == OP_PRINT_STR) { puts(g_strs[code[ip++]]); }\n";
    s = s + "    else if (op == OP_LIST_NEW) { stack[sp++] = Vl(lnew()); }\n";
    s = s + "    else if (op == OP_LIST_TAG) {\n";
    s = s + "      int64_t idx=code[ip++]; int64_t lid=as_list(stack[--sp]);\n";
    s = s + "      g_ltype[lid]=g_strs[idx]; stack[sp++]=Vl(lid);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LIST_PUSH) {\n";
    s = s + "      V v = stack[--sp]; int64_t lid = as_list(stack[--sp]);\n";
    s = s + "      lpush(lid, v); stack[sp++] = Vl(lid);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LEN) {\n";
    s = s + "      V x=stack[--sp];\n";
    s = s + "      if (x.tag==3) stack[sp++]=Vi((int64_t)strlen(as_str(x)));\n";
    s = s + "      else if (x.tag==2) stack[sp++]=Vi(llen(x.i));\n";
    s = s + "      else { fprintf(stderr, \"len: bad type\\n\"); exit(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_GET) {\n";
    s = s + "      int64_t ix = as_i(stack[--sp]); V lv = stack[--sp];\n";
    s = s + "      if (lv.tag==2) stack[sp++]=lget(lv.i, ix);\n";
    s = s + "      else if (lv.tag==3) stack[sp++]=Vs(s_char_at(lv.i, ix));\n";
    s = s + "      else { fprintf(stderr, \"get: bad type\\n\"); exit(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_ORD) {\n";
    s = s + "      V x=stack[--sp];\n";
    s = s + "      if (x.tag==3) { const char *t=as_str(x); stack[sp++]=Vi(t[0]?(unsigned char)t[0]:0); }\n";
    s = s + "      else if (x.tag==0) stack[sp++]=Vi(x.i);\n";
    s = s + "      else { fprintf(stderr, \"ord: bad type\\n\"); exit(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SET) {\n";
    s = s + "      V v = stack[--sp]; int64_t ix = as_i(stack[--sp]); int64_t lid = as_list(stack[--sp]);\n";
    s = s + "      lset(lid, ix, v);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_CALL) {\n";
    s = s + "      int64_t addr = code[ip++]; int64_t argc = code[ip++];\n";
    s = s + "      V args[16]; int64_t ai;\n";
    s = s + "      for (ai = argc - 1; ai >= 0; ai--) args[ai] = stack[--sp];\n";
    s = s + "      ret_ips[rsp] = ip; slot_bases[rsp] = slot_base; rsp++;\n";
    s = s + "      slot_base = slot_used;\n";
    s = s + "      for (ai = 0; ai < argc; ai++) {\n";
    s = s + "        slots[slot_base + ai] = args[ai];\n";
    s = s + "        if (slot_base + ai + 1 > slot_used) slot_used = slot_base + ai + 1;\n";
    s = s + "      }\n";
    s = s + "      ip = addr;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_RET) {\n";
    s = s + "      V val = sp > 0 ? stack[--sp] : Vi(0);\n";
    s = s + "      if (rsp == 0) return as_i(val);\n";
    s = s + "      slot_used = slot_base;\n";
    s = s + "      rsp--;\n";
    s = s + "      slot_base = slot_bases[rsp];\n";
    s = s + "      if (ret_ips[rsp] == -1) {\n";
    s = s + "        pump_done++;\n";
    s = s + "        stack[sp++] = val;\n";
    s = s + "        pump_active = 1;\n";
    s = s + "        continue;\n";
    s = s + "      }\n";
    s = s + "      ip = ret_ips[rsp];\n";
    s = s + "      stack[sp++] = val;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_EMIT) {\n";
    s = s + "      V val = stack[--sp];\n";
    s = s + "      V name = stack[--sp];\n";
    s = s + "      const char *nm;\n";
    s = s + "      if (name.tag==3) nm = as_str(name);\n";
    s = s + "      else if (name.tag==0) nm = g_strs[name.i];\n";
    s = s + "      else { fprintf(stderr, \"emit: bad event name\\n\"); exit(1); }\n";
    s = s + "      ev_enqueue(nm, val);\n";
    s = s + "      stack[sp++] = Vi(0);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_READ_FILE) {\n";
    s = s + "      V pathv = stack[--sp];\n";
    s = s + "      FILE *f; long sz; char *buf; size_t nread;\n";
    s = s + "      if (pathv.tag != 3) { fprintf(stderr, \"read_file: path must be str\\n\"); exit(1); }\n";
    s = s + "      f = fopen(as_str(pathv), \"rb\");\n";
    s = s + "      if (!f) { fprintf(stderr, \"read_file: cannot open\\n\"); exit(1); }\n";
    s = s + "      if (fseek(f, 0, SEEK_END) != 0) { fclose(f); fprintf(stderr, \"read_file: seek\\n\"); exit(1); }\n";
    s = s + "      sz = ftell(f);\n";
    s = s + "      if (sz < 0) { fclose(f); fprintf(stderr, \"read_file: tell\\n\"); exit(1); }\n";
    s = s + "      rewind(f);\n";
    s = s + "      buf = (char*)malloc((size_t)sz + 1);\n";
    s = s + "      if (!buf) { fclose(f); fprintf(stderr, \"oom\\n\"); exit(1); }\n";
    s = s + "      nread = fread(buf, 1, (size_t)sz, f);\n";
    s = s + "      fclose(f);\n";
    s = s + "      buf[nread] = 0;\n";
    s = s + "      stack[sp++] = Vs(s_new(buf));\n";
    s = s + "      free(buf);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_WRITE_FILE) {\n";
    s = s + "      V content = stack[--sp];\n";
    s = s + "      V pathv = stack[--sp];\n";
    s = s + "      FILE *f;\n";
    s = s + "      if (pathv.tag != 3 || content.tag != 3) { fprintf(stderr, \"write_file: expects str, str\\n\"); exit(1); }\n";
    s = s + "      f = fopen(as_str(pathv), \"wb\");\n";
    s = s + "      if (!f) stack[sp++] = Vi(0);\n";
    s = s + "      else {\n";
    s = s + "        const char *body = as_str(content);\n";
    s = s + "        fwrite(body, 1, strlen(body), f);\n";
    s = s + "        fclose(f);\n";
    s = s + "        stack[sp++] = Vi(1);\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_PENDING) { stack[sp++] = Vi((int64_t)(ev_tail - ev_head)); }\n";
    s = s + "    else if (op == OP_PUMP) {\n";
    s = s + "      pump_left = as_i(stack[--sp]);\n";
    s = s + "      pump_done = 0;\n";
    s = s + "      pump_ret_ip = ip;\n";
    s = s + "      pump_active = 1;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_FROM) {\n";
    s = s + "      V data=stack[--sp]; V shape=stack[--sp]; int ishape[8]; int rank, n, i; int64_t h; TObj *t;\n";
    s = s + "      if (shape.tag!=2 || data.tag!=2) { fprintf(stderr, \"t_from expects lists\\n\"); exit(1); }\n";
    s = s + "      rank = (int)llen(shape.i); if (rank > 8) { fprintf(stderr, \"t_from rank\\n\"); exit(1); }\n";
    s = s + "      for (i = 0; i < rank; i++) ishape[i] = (int)as_i(lget(shape.i, i));\n";
    s = s + "      h = talloc(ishape, rank, 0); t = &gT[h]; n = t->n;\n";
    s = s + "      if (llen(data.i) != (int64_t)n) { fprintf(stderr, \"t_from data length mismatch\\n\"); exit(1); }\n";
    s = s + "      for (i = 0; i < n; i++) t->data[i] = as_f(lget(data.i, i));\n";
    s = s + "      stack[sp++] = Vt(h);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_GET) {\n";
    s = s + "      int64_t ix = as_i(stack[--sp]); TObj *t = tobj(stack[--sp]);\n";
    s = s + "      if (ix < 0 || ix >= t->n) { fprintf(stderr, \"t_get out of range\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vf(t->data[ix]);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_MATMUL) {\n";
    s = s + "      V vb=stack[--sp]; V va=stack[--sp];\n";
    s = s + "      if (va.tag!=5||vb.tag!=5) { fprintf(stderr, \"t_matmul expects tensors\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tmatmul_ids(va.i, vb.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_SHAPE) {\n";
    s = s + "      TObj *t = tobj(stack[--sp]); int64_t lid = lnew(); int i;\n";
    s = s + "      for (i = 0; i < t->rank; i++) lpush(lid, Vi((int64_t)t->shape[i]));\n";
    s = s + "      stack[sp++] = Vl(lid);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_TENSOR) {\n";
    s = s + "      int64_t cols = as_i(stack[--sp]); int64_t rows = as_i(stack[--sp]); int shape[2];\n";
    s = s + "      if (rows < 0 || cols < 0) { fprintf(stderr, \"negative tensor dim\\n\"); exit(1); }\n";
    s = s + "      shape[0] = (int)rows; shape[1] = (int)cols;\n";
    s = s + "      stack[sp++] = Vt(talloc(shape, 2, 1));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_FILL) {\n";
    s = s + "      double x = as_f(stack[--sp]); V tv = stack[--sp]; TObj *t = tobj(tv); int i;\n";
    s = s + "      for (i = 0; i < t->n; i++) t->data[i] = x;\n";
    s = s + "      stack[sp++] = tv;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_SET) {\n";
    s = s + "      double val = as_f(stack[--sp]); int64_t idx = as_i(stack[--sp]); V tv = stack[--sp]; TObj *t = tobj(tv);\n";
    s = s + "      if (idx < 0 || idx >= t->n) { fprintf(stderr, \"t_set out of range\\n\"); exit(1); }\n";
    s = s + "      t->data[idx] = val;\n";
    s = s + "      stack[sp++] = tv;\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_ADD) {\n";
    s = s + "      V vb = stack[--sp]; V va = stack[--sp];\n";
    s = s + "      if (va.tag != 5 || vb.tag != 5) { fprintf(stderr, \"t_add expects tensors\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tew_add(va.i, vb.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_SUB) {\n";
    s = s + "      V vb = stack[--sp]; V va = stack[--sp];\n";
    s = s + "      if (va.tag != 5 || vb.tag != 5) { fprintf(stderr, \"t_sub expects tensors\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tew_sub(va.i, vb.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_MUL) {\n";
    s = s + "      V vb = stack[--sp]; V va = stack[--sp];\n";
    s = s + "      if (va.tag != 5 || vb.tag != 5) { fprintf(stderr, \"t_mul expects tensors\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tew_mul(va.i, vb.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_SCALE) {\n";
    s = s + "      double sc = as_f(stack[--sp]); V tv = stack[--sp];\n";
    s = s + "      if (tv.tag != 5) { fprintf(stderr, \"t_scale expects tensor\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tscale(tv.i, sc));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_TRANSPOSE) {\n";
    s = s + "      V tv = stack[--sp];\n";
    s = s + "      if (tv.tag != 5) { fprintf(stderr, \"t_transpose expects tensor\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(ttranspose(tv.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_T_SOFTMAX) {\n";
    s = s + "      V tv = stack[--sp];\n";
    s = s + "      if (tv.tag != 5) { fprintf(stderr, \"t_softmax expects tensor\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tsoftmax(tv.i));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SAVE_TENSOR) {\n";
    s = s + "      V pathv = stack[--sp]; V tv = stack[--sp];\n";
    s = s + "      if (pathv.tag != 3 || tv.tag != 5) { fprintf(stderr, \"save_tensor: expects tensor, str\\n\"); exit(1); }\n";
    s = s + "      { TObj *t = tobj(tv); FILE *f = fopen(as_str(pathv), \"wb\"); int i;\n";
    s = s + "        if (!f) { stack[sp++] = Vi(0); }\n";
    s = s + "        else {\n";
    s = s + "          fprintf(f, \"KENGA_TENSOR 1\\n%d\\n\", t->rank);\n";
    s = s + "          for (i = 0; i < t->rank; i++) fprintf(f, \"%s%d\", i ? \" \" : \"\", t->shape[i]);\n";
    s = s + "          fprintf(f, \"\\n\");\n";
    s = s + "          for (i = 0; i < t->n; i++) fprintf(f, \"%s%.17g\", i ? \" \" : \"\", t->data[i]);\n";
    s = s + "          fprintf(f, \"\\n\");\n";
    s = s + "          fclose(f); stack[sp++] = Vi(1);\n";
    s = s + "        } }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LOAD_TENSOR) {\n";
    s = s + "      V pathv = stack[--sp];\n";
    s = s + "      if (pathv.tag != 3) { fprintf(stderr, \"load_tensor: path must be str\\n\"); exit(1); }\n";
    s = s + "      { FILE *f = fopen(as_str(pathv), \"rb\"); char hdr[64]; int rank, i, shape[8]; TObj *t; int64_t h;\n";
    s = s + "        if (!f) { fprintf(stderr, \"load_tensor: cannot open\\n\"); exit(1); }\n";
    s = s + "        if (fscanf(f, \"%63s %*d\", hdr) != 1 || strcmp(hdr, \"KENGA_TENSOR\") != 0) { fclose(f); fprintf(stderr, \"load_tensor: bad format\\n\"); exit(1); }\n";
    s = s + "        if (fscanf(f, \"%d\", &rank) != 1 || rank < 1 || rank > 8) { fclose(f); fprintf(stderr, \"load_tensor: bad rank\\n\"); exit(1); }\n";
    s = s + "        for (i = 0; i < rank; i++) { if (fscanf(f, \"%d\", &shape[i]) != 1) { fclose(f); fprintf(stderr, \"load_tensor: bad shape\\n\"); exit(1); } }\n";
    s = s + "        h = talloc(shape, rank, 0); t = &gT[h];\n";
    s = s + "        for (i = 0; i < t->n; i++) { double tmpv; if (fscanf(f, \"%lf\", &tmpv) != 1) { fclose(f); fprintf(stderr, \"load_tensor: bad data\\n\"); exit(1); } t->data[i] = (KREAL)tmpv; }\n";
    s = s + "        fclose(f);\n";
    s = s + "        stack[sp++] = Vt(h); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_ARGC) {\n";
    s = s + "      stack[sp++] = Vi((int64_t)g_kargc);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_ARG) {\n";
    s = s + "      int64_t idx = as_i(stack[--sp]);\n";
    s = s + "      if (idx >= 0 && idx < g_kargc) { stack[sp++] = Vs(s_new(g_kargv[idx])); }\n";
    s = s + "      else { stack[sp++] = Vs(s_new(\"\")); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_FILE_EXISTS) {\n";
    s = s + "      V pathv = stack[--sp];\n";
    s = s + "      if (pathv.tag != 3) { fprintf(stderr, \"file_exists: path must be str\\n\"); exit(1); }\n";
    s = s + "      { FILE *f = fopen(as_str(pathv), \"rb\"); stack[sp++] = Vi(f ? 1 : 0); if (f) fclose(f); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_READ_LINE) {\n";
    s = s + "      static char buf[65536];\n";
    s = s + "      char *r = fgets(buf, sizeof(buf), stdin);\n";
    s = s + "      if (r) { size_t n = strlen(buf); while (n > 0 && (buf[n-1] == 10 || buf[n-1] == 13)) { buf[--n] = 0; } stack[sp++] = Vs(s_new(buf)); }\n";
    s = s + "      else { stack[sp++] = Vs(s_new(\"\")); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_MEM_CONFIG) {\n";
    s = s + "      int64_t hidden = as_i(stack[--sp]); int64_t ep_cap = as_i(stack[--sp]); double thr = as_f(stack[--sp]);\n";
    s = s + "      int h, cap; if (gMn >= 16) { fprintf(stderr, \"memory heap full\\n\"); exit(1); }\n";
    s = s + "      memset(&gM[gMn], 0, sizeof(gM[gMn])); gM[gMn].threshold = thr; gM[gMn].lr = 0.08;\n";
    s = s + "      h = (int)hidden; if (h < 1) h = 8; if (h > BM_H) h = BM_H;\n";
    s = s + "      cap = (int)ep_cap; if (cap < 1) cap = 1; if (cap > BM_EP) cap = BM_EP; gM[gMn].ep_cap = cap;\n";
    s = s + "      bm_init(&gM[gMn].model, 1, h); stack[sp++] = Vm((int64_t)gMn++);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LEARN) {\n";
    s = s + "      V y=stack[--sp]; V x=stack[--sp]; BmMind *m = bm_get(stack[--sp]);\n";
    s = s + "      double xp[BM_D], yp[BM_D]; int xn = vlist_pat(x, xp, BM_D); int yn = vlist_pat(y, yp, BM_D);\n";
    s = s + "      { double loss = bm_train(&m->model, xp, xn, yp, yn, m->lr); bm_ep_push(m, xp, xn, yp, yn); stack[sp++] = Vf(loss); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_PREDICT) {\n";
    s = s + "      V x=stack[--sp]; BmMind *m = bm_get(stack[--sp]); double xp[BM_D]; int xn = vlist_pat(x, xp, BM_D);\n";
    s = s + "      stack[sp++] = bm_predict_list(m, xp, xn);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_FORESEE) {\n";
    s = s + "      V x=stack[--sp]; BmMind *m = bm_get(stack[--sp]); double xp[BM_D]; int xn = vlist_pat(x, xp, BM_D);\n";
    s = s + "      stack[sp++] = bm_foresee_list(m, xp, xn);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_REMEMBER) {\n";
    s = s + "      double s = as_f(stack[--sp]); V pat=stack[--sp]; BmMind *m = bm_get(stack[--sp]); double xp[BM_D]; int xn;\n";
    s = s + "      if (s < m->threshold) stack[sp++] = Vi(0);\n";
    s = s + "      else { xn = vlist_pat(pat, xp, BM_D); m->ep[bm_ep_push(m, xp, xn, NULL, 0)].surprise = s; stack[sp++] = Vi(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_REMEMBER_NEXT) {\n";
    s = s + "      double s = as_f(stack[--sp]); V b=stack[--sp]; V a=stack[--sp]; BmMind *m = bm_get(stack[--sp]);\n";
    s = s + "      double xp[BM_D], yp[BM_D]; int xn, yn;\n";
    s = s + "      if (s < m->threshold) stack[sp++] = Vi(0);\n";
    s = s + "      else { xn = vlist_pat(a, xp, BM_D); yn = vlist_pat(b, yp, BM_D); m->ep[bm_ep_push(m, xp, xn, yp, yn)].surprise = s; stack[sp++] = Vi(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_UNROLL) {\n";
    s = s + "      int steps = (int)as_i(stack[--sp]); V x=stack[--sp]; BmMind *m = bm_get(stack[--sp]);\n";
    s = s + "      double cur[BM_D]; int cn = vlist_pat(x, cur, BM_D), i; int64_t out = lnew();\n";
    s = s + "      if (steps < 1) steps = 1; if (steps > 64) steps = 64;\n";
    s = s + "      for (i = 0; i < steps; i++) { V nxt = bm_predict_list(m, cur, cn); lpush(out, nxt); cn = vlist_pat(nxt, cur, BM_D); }\n";
    s = s + "      stack[sp++] = Vl(out);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_FORESEE_N) {\n";
    s = s + "      int steps = (int)as_i(stack[--sp]); V x=stack[--sp]; BmMind *m = bm_get(stack[--sp]);\n";
    s = s + "      double cur[BM_D]; int cn = vlist_pat(x, cur, BM_D), i; int64_t out = lnew();\n";
    s = s + "      if (steps < 1) steps = 1; if (steps > 64) steps = 64;\n";
    s = s + "      for (i = 0; i < steps; i++) { V nxt = bm_foresee_list(m, cur, cn); lpush(out, nxt); cn = vlist_pat(nxt, cur, BM_D); }\n";
    s = s + "      stack[sp++] = Vl(out);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SURPRISE) {\n";
    s = s + "      V b=stack[--sp]; V a=stack[--sp]; double pa[BM_D], pb[BM_D]; int an = vlist_pat(a, pa, BM_D); int bn = vlist_pat(b, pb, BM_D);\n";
    s = s + "      stack[sp++] = Vf(bm_dist(pa, an, pb, bn));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_CONSOLIDATE) {\n";
    s = s + "      BmMind *m = bm_get(stack[--sp]); int i, n = 0;\n";
    s = s + "      for (i = 0; i < m->nep; i++) { if (!m->ep[i].has_target) continue; bm_train(&m->model, m->ep[i].pattern, m->ep[i].dim, m->ep[i].target, m->ep[i].target_dim, m->lr); n++; }\n";
    s = s + "      stack[sp++] = Vi((int64_t)n);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_MEM_STATS) {\n";
    s = s + "      BmMind *m = bm_get(stack[--sp]); int64_t id = lnew();\n";
    s = s + "      lpush(id, Vi((int64_t)m->nep)); lpush(id, Vi((int64_t)m->model.steps)); lpush(id, Vf(m->threshold)); stack[sp++] = Vl(id);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_SAVE_MIND) {\n";
    s = s + "      V path=stack[--sp]; BmMind *m = bm_get(stack[--sp]); FILE *f; int d, h, i;\n";
    s = s + "      if (path.tag != 3) { fprintf(stderr, \"save_mind: path must be str\\n\"); exit(1); }\n";
    s = s + "      f = fopen(as_str(path), \"wb\"); if (!f) { stack[sp++] = Vi(0); }\n";
    s = s + "      else {\n";
    s = s + "        d = m->model.dim; h = m->model.hidden;\n";
    s = s + "        fprintf(f, \"KENGA_MIND 1\\nthreshold %.17g\\nep_cap %d\\ncore_cap %d\\nlr %.17g\\nmodel %d %d %llu\\n\", m->threshold, m->ep_cap, h, m->lr, d, h, (unsigned long long)m->model.steps);\n";
    s = s + "        bm_write_f64s(f, m->model.w1, h*d); bm_write_f64s(f, m->model.b1, h); bm_write_f64s(f, m->model.w2, d*h); bm_write_f64s(f, m->model.b2, d);\n";
    s = s + "        bm_write_f64s(f, m->model.w1l, h*d); bm_write_f64s(f, m->model.b1l, h); bm_write_f64s(f, m->model.w2l, d*h); bm_write_f64s(f, m->model.b2l, d);\n";
    s = s + "        fprintf(f, \"core 0\\nepisodic %d\\n\", m->nep);\n";
    s = s + "        for (i = 0; i < m->nep; i++) {\n";
    s = s + "          int has_t = m->ep[i].has_target ? 1 : 0; int tlen = has_t ? (m->ep[i].target_dim > 0 ? m->ep[i].target_dim : m->ep[i].dim) : 0;\n";
    s = s + "          fprintf(f, \"%.17g 0 %d %d %d\\n\", m->ep[i].surprise, m->ep[i].dim, has_t, tlen);\n";
    s = s + "          bm_write_f64s(f, m->ep[i].pattern, m->ep[i].dim); if (has_t) bm_write_f64s(f, m->ep[i].target, tlen);\n";
    s = s + "        }\n";
    s = s + "        fclose(f); stack[sp++] = Vi(1);\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_LOAD_MIND) {\n";
    s = s + "      V path=stack[--sp]; FILE *f; BmMind m; char line[256]; int d, h, i, core_n, ep_n; unsigned long long steps;\n";
    s = s + "      if (path.tag != 3) { fprintf(stderr, \"load_mind: path must be str\\n\"); exit(1); }\n";
    s = s + "      if (gMn >= 16) { fprintf(stderr, \"memory heap full\\n\"); exit(1); }\n";
    s = s + "      memset(&m, 0, sizeof(m)); f = fopen(as_str(path), \"rb\"); if (!f) { fprintf(stderr, \"load_mind: cannot open\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f) || strncmp(line, \"KENGA_MIND 1\", 12) != 0) { fclose(f); fprintf(stderr, \"load_mind: bad header\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f) || sscanf(line, \"threshold %lf\", &m.threshold) != 1) { fclose(f); fprintf(stderr, \"load_mind: threshold\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f) || sscanf(line, \"ep_cap %d\", &m.ep_cap) != 1) { fclose(f); fprintf(stderr, \"load_mind: ep_cap\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f)) { fclose(f); fprintf(stderr, \"load_mind: core_cap\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f) || sscanf(line, \"lr %lf\", &m.lr) != 1) { fclose(f); fprintf(stderr, \"load_mind: lr\\n\"); exit(1); }\n";
    s = s + "      if (!fgets(line, sizeof(line), f) || sscanf(line, \"model %d %d %llu\", &d, &h, &steps) != 3) { fclose(f); fprintf(stderr, \"load_mind: model\\n\"); exit(1); }\n";
    s = s + "      if (d < 1 || d > BM_D || h < 1 || h > BM_H) { fclose(f); fprintf(stderr, \"load_mind: dims\\n\"); exit(1); }\n";
    s = s + "      if (m.ep_cap < 1 || m.ep_cap > BM_EP) m.ep_cap = BM_EP;\n";
    s = s + "      m.model.dim = d; m.model.hidden = h; m.model.steps = (uint64_t)steps;\n";
    s = s + "      if (bm_read_f64s(f, m.model.w1, h*d) || bm_read_f64s(f, m.model.b1, h) || bm_read_f64s(f, m.model.w2, d*h) || bm_read_f64s(f, m.model.b2, d)) { fclose(f); fprintf(stderr, \"load_mind: weights\\n\"); exit(1); }\n";
    s = s + "      if (bm_read_f64s(f, m.model.w1l, h*d) || bm_read_f64s(f, m.model.b1l, h) || bm_read_f64s(f, m.model.w2l, d*h) || bm_read_f64s(f, m.model.b2l, d)) { fclose(f); fprintf(stderr, \"load_mind: locks\\n\"); exit(1); }\n";
    s = s + "      if (fscanf(f, \" core %d\", &core_n) != 1) { fclose(f); fprintf(stderr, \"load_mind: core\\n\"); exit(1); }\n";
    s = s + "      for (i = 0; i < core_n; i++) { double dummy[BM_D]; int plen; unsigned long long rep; double imp; if (fscanf(f, \"%lf %llu %d\", &imp, &rep, &plen) != 3 || plen < 1 || plen > BM_D || bm_read_f64s(f, dummy, plen)) { fclose(f); fprintf(stderr, \"load_mind: core pat\\n\"); exit(1); } }\n";
    s = s + "      if (fscanf(f, \" episodic %d\", &ep_n) != 1 || ep_n < 0 || ep_n > BM_EP) { fclose(f); fprintf(stderr, \"load_mind: episodic\\n\"); exit(1); }\n";
    s = s + "      m.nep = ep_n;\n";
    s = s + "      for (i = 0; i < ep_n; i++) {\n";
    s = s + "        unsigned long long ts; int plen, has_t, tlen;\n";
    s = s + "        if (fscanf(f, \"%lf %llu %d %d %d\", &m.ep[i].surprise, &ts, &plen, &has_t, &tlen) != 5) { fclose(f); fprintf(stderr, \"load_mind: ep meta\\n\"); exit(1); }\n";
    s = s + "        m.ep[i].has_target = has_t ? 1 : 0; m.ep[i].dim = plen;\n";
    s = s + "        if (plen < 1 || plen > BM_D || bm_read_f64s(f, m.ep[i].pattern, plen)) { fclose(f); fprintf(stderr, \"load_mind: ep pat\\n\"); exit(1); }\n";
    s = s + "        if (has_t) { m.ep[i].target_dim = tlen; if (tlen < 1 || tlen > BM_D || bm_read_f64s(f, m.ep[i].target, tlen)) { fclose(f); fprintf(stderr, \"load_mind: ep tgt\\n\"); exit(1); } }\n";
    s = s + "      }\n";
    s = s + "      fclose(f); gM[gMn] = m; stack[sp++] = Vm((int64_t)gMn++);\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_CLEAR) { gBagn = 0; stack[sp++] = Vi(0); }\n";
    s = s + "    else if (op == OP_AG_PARAM) {\n";
    s = s + "      V t=stack[--sp]; if (t.tag!=5) { fprintf(stderr, \"ag_param expects tensor\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vi(bag_leaf(t.i, 1));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_CONST) {\n";
    s = s + "      V t=stack[--sp];\n";
    s = s + "      if (t.tag==5) stack[sp++] = Vi(bag_leaf(t.i, 0));\n";
    s = s + "      else if (t.tag==0||t.tag==1) {\n";
    s = s + "        BagNode n; memset(&n, 0, sizeof(n)); n.is_scalar = 1; n.scalar = as_f(t); n.op = BAG_LEAF; n.pa = n.pb = -1; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "      } else { fprintf(stderr, \"ag_const expects tensor or number\\n\"); exit(1); }\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_MATMUL) {\n";
    s = s + "      int64_t b=as_i(stack[--sp]), a=as_i(stack[--sp]); BagNode *na=bag_node(a), *nb=bag_node(b); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar||nb->is_scalar) { fprintf(stderr, \"ag_matmul expects tensors\\n\"); exit(1); }\n";
    s = s + "      n.th = tmatmul_ids(na->th, nb->th); n.op = BAG_MATMUL; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "      n.requires_grad = na->requires_grad || nb->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_MSE) {\n";
    s = s + "      int64_t t=as_i(stack[--sp]), p=as_i(stack[--sp]); BagNode *np=bag_node(p), *nt=bag_node(t); BagNode n;\n";
    s = s + "      TObj *a, *b; double acc = 0.0; int i, nn;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (np->is_scalar||nt->is_scalar) { fprintf(stderr, \"ag_mse expects tensors\\n\"); exit(1); }\n";
    s = s + "      a = tid(np->th); b = tid(nt->th); if (a->n != b->n) { fprintf(stderr, \"ag_mse size mismatch\\n\"); exit(1); }\n";
    s = s + "      nn = a->n > 0 ? a->n : 1; for (i = 0; i < a->n; i++) { double d = a->data[i] - b->data[i]; acc += d * d; }\n";
    s = s + "      n.is_scalar = 1; n.scalar = acc / (double)nn; n.op = BAG_MSE; n.pa = (int)p; n.pb = (int)t;\n";
    s = s + "      n.requires_grad = np->requires_grad || nt->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_BACKWARD) { bag_backward(as_i(stack[--sp])); stack[sp++] = Vi(0); }\n";
    s = s + "    else if (op == OP_AG_STEP) {\n";
    s = s + "      double lr = as_f(stack[--sp]); BagNode *n = bag_node(as_i(stack[--sp]));\n";
    s = s + "      if (!n->has_grad) { fprintf(stderr, \"ag_step: missing grad\\n\"); exit(1); }\n";
    s = s + "      if (n->is_scalar || n->grad_is_scalar) { fprintf(stderr, \"ag_step expects tensor param\\n\"); exit(1); }\n";
    s = s + "      stack[sp++] = Vt(tew_sub(n->th, tscale(n->gth, lr)));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_ADD) {\n";
    s = s + "      int64_t b=as_i(stack[--sp]), a=as_i(stack[--sp]); BagNode *na=bag_node(a), *nb=bag_node(b); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar||nb->is_scalar) { fprintf(stderr, \"ag_add expects tensors\\n\"); exit(1); }\n";
    s = s + "      n.th = tew_add(na->th, nb->th); n.op = BAG_ADD; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "      n.requires_grad = na->requires_grad || nb->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_SUB) {\n";
    s = s + "      int64_t b=as_i(stack[--sp]), a=as_i(stack[--sp]); BagNode *na=bag_node(a), *nb=bag_node(b); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar||nb->is_scalar) { fprintf(stderr, \"ag_sub expects tensors\\n\"); exit(1); }\n";
    s = s + "      n.th = tew_sub(na->th, nb->th); n.op = BAG_SUB; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "      n.requires_grad = na->requires_grad || nb->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_MUL) {\n";
    s = s + "      int64_t b=as_i(stack[--sp]), a=as_i(stack[--sp]); BagNode *na=bag_node(a), *nb=bag_node(b); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar||nb->is_scalar) { fprintf(stderr, \"ag_mul expects tensors\\n\"); exit(1); }\n";
    s = s + "      n.th = tew_mul(na->th, nb->th); n.op = BAG_MUL; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "      n.requires_grad = na->requires_grad || nb->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_SCALE) {\n";
    s = s + "      double sc = as_f(stack[--sp]); int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n));\n";
    s = s + "      if (na->is_scalar) { n.is_scalar = 1; n.scalar = na->scalar * sc; } else n.th = tscale(na->th, sc);\n";
    s = s + "      n.op = BAG_SCALE; n.pa = (int)a; n.pb = -1; n.scale = sc; n.requires_grad = na->requires_grad;\n";
    s = s + "      stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_RELU) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar) { fprintf(stderr, \"ag_relu expects tensors\\n\"); exit(1); }\n";
    s = s + "      n.th = trelu(na->th); n.op = BAG_RELU; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad;\n";
    s = s + "      stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_NEG) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n));\n";
    s = s + "      if (na->is_scalar) { n.is_scalar = 1; n.scalar = -na->scalar; } else n.th = tscale(na->th, -1.0);\n";
    s = s + "      n.op = BAG_NEG; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad;\n";
    s = s + "      stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_TRANSPOSE) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar) { fprintf(stderr, \"ag_transpose expects tensor\\n\"); exit(1); }\n";
    s = s + "      n.th = ttranspose(na->th); n.op = BAG_TRANSPOSE; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad;\n";
    s = s + "      stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_RESHAPE) {\n";
    s = s + "      V sh=stack[--sp]; int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); TObj *t; BagNode n; int i, need, ishape[8], rank;\n";
    s = s + "      memset(&n, 0, sizeof(n)); if (na->is_scalar) { fprintf(stderr, \"ag_reshape expects tensor\\n\"); exit(1); }\n";
    s = s + "      if (sh.tag!=2) { fprintf(stderr, \"ag_reshape expects shape list\\n\"); exit(1); }\n";
    s = s + "      t = tid(na->th); n.old_rank = t->rank; for (i = 0; i < t->rank; i++) n.old_shape[i] = t->shape[i];\n";
    s = s + "      rank = (int)llen(sh.i); if (rank < 1 || rank > 8) { fprintf(stderr, \"ag_reshape rank\\n\"); exit(1); }\n";
    s = s + "      need = 1; for (i = 0; i < rank; i++) { ishape[i] = (int)as_i(lget(sh.i, i)); if (ishape[i] < 1) { fprintf(stderr, \"ag_reshape dim\\n\"); exit(1); } need *= ishape[i]; }\n";
    s = s + "      if (need != t->n) { fprintf(stderr, \"ag_reshape size mismatch\\n\"); exit(1); }\n";
    s = s + "      { KREAL *src = t->data; int nn = t->n; n.th = talloc(ishape, rank, 0); memcpy(gT[n.th].data, src, (size_t)nn * sizeof(KREAL)); }\n";
    s = s + "      n.op = BAG_RESHAPE; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_EXP) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n));\n";
    s = s + "      if (na->is_scalar) { n.is_scalar = 1; n.scalar = exp(na->scalar); } else n.th = texp(na->th);\n";
    s = s + "      n.op = BAG_EXP; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_LOG) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n));\n";
    s = s + "      if (na->is_scalar) { double x = na->scalar < 1e-12 ? 1e-12 : na->scalar; n.is_scalar = 1; n.scalar = log(x); } else n.th = tlog(na->th);\n";
    s = s + "      n.op = BAG_LOG; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_SOFTMAX) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n));\n";
    s = s + "      if (na->is_scalar) { n.is_scalar = 1; n.scalar = 1.0; } else n.th = tsoftmax(na->th);\n";
    s = s + "      n.op = BAG_SOFTMAX; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_SUM) {\n";
    s = s + "      int64_t a=as_i(stack[--sp]); BagNode *na=bag_node(a); BagNode n;\n";
    s = s + "      memset(&n, 0, sizeof(n)); n.is_scalar = 1; n.scalar = na->is_scalar ? na->scalar : tsum(na->th);\n";
    s = s + "      n.op = BAG_SUM; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; stack[sp++] = Vi(bag_push(n));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_VALUE) {\n";
    s = s + "      BagNode *n = bag_node(as_i(stack[--sp]));\n";
    s = s + "      if (n->is_scalar) stack[sp++] = Vf(n->scalar); else stack[sp++] = Vt(tclone(n->th));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_AG_GRAD) {\n";
    s = s + "      BagNode *n = bag_node(as_i(stack[--sp]));\n";
    s = s + "      if (!n->has_grad) { fprintf(stderr, \"ag_grad: no grad\\n\"); exit(1); }\n";
    s = s + "      if (n->grad_is_scalar) stack[sp++] = Vf(n->gscalar); else stack[sp++] = Vt(tclone(n->gth));\n";
    s = s + "    }\n";
    s = s + "    else if (op == OP_HALT) { return 0; }\n";
    s = s + "    else { fprintf(stderr, \"bad op %lld\\n\", (long long)op); exit(1); }\n";
    s = s + "  }\n";
    s = s + "  return 0;\n}\n";
    return s;
}

fn write_c_driver(code: list, strs: list, floats: list, binds: list) -> str {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/bc_src_c.kenga ? parsed source ? bytecode */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n";
    s = s + "#ifdef _WIN32\n#include <windows.h>\n#else\n#include <unistd.h>\n#endif\n";
    s = s + "#include \"opcodes.inc.c\"\n\n";
    s = s + emit_handlers_table(binds);
    s = s + emit_strs_table(strs);
    s = s + emit_f64s_table(floats);
    s = s + "#include \"bc_rt.inc.c\"\n\n";
    s = s + "int main(int argc, char **argv) {\n";
    s = s + "  g_kargc = argc; g_kargv = argv;\n";
    s = s + "  static const int64_t code[] = { " + emit_code(code) + " };\n";
    s = s + "  vm_run(code, (int64_t)(sizeof(code)/sizeof(code[0])));\n";
    s = s + "  return 0;\n}\n";
    return s;
}

fn main() -> i64 {
    assert(write_file("bootstrap/generated/bc_rt.inc.c", write_runtime()) == true);

    let r = compile_src(resolve_imports("examples/selfhost/bc_mini.kenga", 0));
    assert(len(r[0]) > 10);
    assert(write_file("bootstrap/generated/bc_from_src.c", write_c_driver(r[0], r[1], r[2], r[3])) == true);

    let r2 = compile_src(resolve_imports("examples/selfhost/bc_for.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_for.c", write_c_driver(r2[0], r2[1], r2[2], r2[3])) == true);

    let r3 = compile_src(resolve_imports("examples/selfhost/bc_fn_mini.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_fn.c", write_c_driver(r3[0], r3[1], r3[2], r3[3])) == true);

    let r4 = compile_src(resolve_imports("examples/selfhost/bc_lists.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_lists.c", write_c_driver(r4[0], r4[1], r4[2], r4[3])) == true);

    let r5 = compile_src(resolve_imports("examples/selfhost/bc_for_list.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_for_list.c", write_c_driver(r5[0], r5[1], r5[2], r5[3])) == true);

    let r6 = compile_src(resolve_imports("examples/selfhost/bc_break.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_break.c", write_c_driver(r6[0], r6[1], r6[2], r6[3])) == true);

    let r7 = compile_src(resolve_imports("examples/selfhost/for_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_for_lite.c", write_c_driver(r7[0], r7[1], r7[2], r7[3])) == true);

    let r8 = compile_src(resolve_imports("examples/selfhost/lists_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_lists_lite.c", write_c_driver(r8[0], r8[1], r8[2], r8[3])) == true);

    let r9 = compile_src(resolve_imports("examples/selfhost/bc_elif.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_elif.c", write_c_driver(r9[0], r9[1], r9[2], r9[3])) == true);

    let r10 = compile_src(resolve_imports("examples/selfhost/elif_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_elif_lite.c", write_c_driver(r10[0], r10[1], r10[2], r10[3])) == true);

    let r11 = compile_src(resolve_imports("examples/selfhost/float_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_float_lite.c", write_c_driver(r11[0], r11[1], r11[2], r11[3])) == true);

    let r12 = compile_src(resolve_imports("examples/selfhost/struct_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_struct_lite.c", write_c_driver(r12[0], r12[1], r12[2], r12[3])) == true);

    let r13 = compile_src(resolve_imports("examples/agent.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_agent.c", write_c_driver(r13[0], r13[1], r13[2], r13[3])) == true);

    let r14 = compile_src(resolve_imports("examples/selfhost/lower_import.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_import.c", write_c_driver(r14[0], r14[1], r14[2], r14[3])) == true);

    let r15 = compile_src(resolve_imports("examples/selfhost/bc_arith.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_arith.c", write_c_driver(r15[0], r15[1], r15[2], r15[3])) == true);

    let r16 = compile_src(resolve_imports("examples/selfhost/fact_lite.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_fact_lite.c", write_c_driver(r16[0], r16[1], r16[2], r16[3])) == true);

    let r17 = compile_src(resolve_imports("examples/selfhost/bc_str.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_str.c", write_c_driver(r17[0], r17[1], r17[2], r17[3])) == true);

    let r18 = compile_src(resolve_imports("examples/selfhost/bc_io.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_io.c", write_c_driver(r18[0], r18[1], r18[2], r18[3])) == true);

    let r19 = compile_src(resolve_imports("examples/ml/kenga_net.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_net.c", write_c_driver(r19[0], r19[1], r19[2], r19[3])) == true);

    let r20 = compile_src(resolve_imports("examples/ml/kenga_birth.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_birth.c", write_c_driver(r20[0], r20[1], r20[2], r20[3])) == true);

    let r21 = compile_src(resolve_imports("examples/selfhost/bc_logic.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_logic.c", write_c_driver(r21[0], r21[1], r21[2], r21[3])) == true);
    assert(code_has_seq(r21[0], [OP_CONST(), 10, OP_CONST(), 3, OP_MOD()]) == 1);
    assert(code_has_seq(r21[0], [OP_CONST(), 1, OP_CONST(), 0, OP_AND()]) == 1);
    assert(code_has_seq(r21[0], [OP_CONST(), 0, OP_CONST(), 1, OP_OR()]) == 1);
    assert(code_has_seq(r21[0], [OP_CONST(), 0, OP_NOT()]) == 1);

    let r22 = compile_src(resolve_imports("examples/selfhost/bc_typeof.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_typeof.c", write_c_driver(r22[0], r22[1], r22[2], r22[3])) == true);
    assert(code_has_seq(r22[0], [OP_CONST(), 1, OP_TYPEOF()]) == 1);
    assert(code_has_seq(r22[0], [OP_CONST(), 42, OP_TO_STR()]) == 1);

    let r23 = compile_src(resolve_imports("examples/selfhost/bc_print.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_print.c", write_c_driver(r23[0], r23[1], r23[2], r23[3])) == true);
    assert(code_has_seq(r23[0], [OP_CONST(), 0, OP_SLEEP_MS()]) == 1);

    let r24 = compile_src(resolve_imports("examples/selfhost/bc_now.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_now.c", write_c_driver(r24[0], r24[1], r24[2], r24[3])) == true);
    assert(code_has_seq(r24[0], [OP_NOW_MS()]) == 1);

    let r25 = compile_src(resolve_imports("examples/selfhost/bc_tensor.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_tensor.c", write_c_driver(r25[0], r25[1], r25[2], r25[3])) == true);
    assert(code_has_seq(r25[0], [OP_T_MATMUL()]) == 1);
    assert(code_has_seq(r25[0], [OP_T_FROM()]) == 1);

    let r26 = compile_src(resolve_imports("examples/selfhost/bc_mem.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_mem.c", write_c_driver(r26[0], r26[1], r26[2], r26[3])) == true);
    assert(code_has_seq(r26[0], [OP_MEM_CONFIG()]) == 1);
    assert(code_has_seq(r26[0], [OP_LEARN()]) == 1);
    assert(code_has_seq(r26[0], [OP_PREDICT()]) == 1);
    assert(code_has_seq(r26[0], [OP_FORESEE()]) == 1);
    assert(code_has_seq(r26[0], [OP_REMEMBER()]) == 1);
    assert(code_has_seq(r26[0], [OP_UNROLL()]) == 1);
    assert(code_has_seq(r26[0], [OP_FORESEE_N()]) == 1);
    assert(code_has_seq(r26[0], [OP_SAVE_MIND()]) == 1);
    assert(code_has_seq(r26[0], [OP_LOAD_MIND()]) == 1);

    let r27 = compile_src(resolve_imports("examples/selfhost/bc_tape.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_tape.c", write_c_driver(r27[0], r27[1], r27[2], r27[3])) == true);
    assert(code_has_seq(r27[0], [OP_AG_CLEAR()]) == 1);
    assert(code_has_seq(r27[0], [OP_AG_MATMUL()]) == 1);
    assert(code_has_seq(r27[0], [OP_AG_STEP()]) == 1);

    let r28 = compile_src(resolve_imports("examples/selfhost/bc_tape_ops.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_tape_ops.c", write_c_driver(r28[0], r28[1], r28[2], r28[3])) == true);
    assert(code_has_seq(r28[0], [OP_AG_SOFTMAX()]) == 1);
    assert(code_has_seq(r28[0], [OP_AG_RELU()]) == 1);
    assert(code_has_seq(r28[0], [OP_AG_GRAD()]) == 1);

    let r29 = compile_src(resolve_imports("examples/selfhost/bc_argc.kenga", 0));
    assert(write_file("bootstrap/generated/bc_from_argc.c", write_c_driver(r29[0], r29[1], r29[2], r29[3])) == true);
    assert(code_has_seq(r29[0], [OP_ARGC()]) == 1);
    assert(code_has_seq(r29[0], [OP_ARG()]) == 1);
    assert(code_has_seq(r29[0], [OP_FILE_EXISTS()]) == 1);
    assert(code_has_seq(r29[0], [OP_READ_LINE()]) == 1);

    let raw: str = read_file("bootstrap/generated/_bc_path.txt");
    let one: str = trim_path(raw);
    if len(one) > 0 {
        let r17 = compile_src(resolve_imports(one, 0));
        assert(write_file("bootstrap/generated/bc_one_out.c", write_c_driver(r17[0], r17[1], r17[2], r17[3])) == true);
        println("wrote bc_one_out.c for " + one);
    }

    println("wrote bootstrap/generated/bc_rt.inc.c + bc_from_*.c incl agent/import/io/net/birth/logic/typeof/print/now/tensor/mem/tape/tape_ops");
    println("bc_src_c ok");
    return 0;
}
