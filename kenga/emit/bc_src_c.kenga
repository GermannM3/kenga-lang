// Parse tiny Kenga source ? bytecode ? C VM driver (no hand-assembled ops).
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\bc_src_c.kenga

fn OP_CONST() -> i64 { return 1; }
fn OP_LOAD() -> i64 { return 2; }
fn OP_STORE() -> i64 { return 3; }
fn OP_ADD() -> i64 { return 4; }
fn OP_SUB() -> i64 { return 5; }
fn OP_MUL() -> i64 { return 6; }
fn OP_DIV() -> i64 { return 7; }
fn OP_LT() -> i64 { return 8; }
fn OP_GT() -> i64 { return 9; }
fn OP_EQ() -> i64 { return 10; }
fn OP_NE() -> i64 { return 25; }
fn OP_LE() -> i64 { return 14; }
fn OP_GE() -> i64 { return 26; }
fn OP_JMP() -> i64 { return 11; }
fn OP_JMPF() -> i64 { return 12; }
fn OP_HALT() -> i64 { return 13; }
fn OP_CALL() -> i64 { return 15; }
fn OP_RET() -> i64 { return 16; }
fn OP_PRINTLN() -> i64 { return 17; }
fn OP_ASSERT() -> i64 { return 18; }
fn OP_PRINT_STR() -> i64 { return 32; }
fn OP_CONST_F64() -> i64 { return 33; }
fn OP_ROUND() -> i64 { return 19; }
fn OP_LIST_NEW() -> i64 { return 21; }
fn OP_LIST_PUSH() -> i64 { return 22; }
fn OP_LEN() -> i64 { return 23; }
fn OP_GET() -> i64 { return 24; }
fn OP_SET() -> i64 { return 28; }
fn OP_LIST_TAG() -> i64 { return 34; }
fn OP_CONST_STR() -> i64 { return 35; }
fn OP_ORD() -> i64 { return 27; }
fn OP_EMIT() -> i64 { return 29; }
fn OP_PUMP() -> i64 { return 30; }
fn OP_PENDING() -> i64 { return 31; }
fn OP_READ_FILE() -> i64 { return 36; }
fn OP_WRITE_FILE() -> i64 { return 37; }
fn OP_MOD() -> i64 { return 38; }
fn OP_AND() -> i64 { return 39; }
fn OP_OR() -> i64 { return 40; }
fn OP_NOT() -> i64 { return 41; }
fn OP_TYPEOF() -> i64 { return 42; }
fn OP_TO_STR() -> i64 { return 43; }
fn OP_PRINT() -> i64 { return 44; }
fn OP_SLEEP_MS() -> i64 { return 45; }
fn OP_NOW_MS() -> i64 { return 46; }
fn OP_T_FROM() -> i64 { return 47; }
fn OP_T_GET() -> i64 { return 48; }
fn OP_T_MATMUL() -> i64 { return 49; }
fn OP_T_SHAPE() -> i64 { return 50; }
fn OP_TENSOR() -> i64 { return 51; }
fn OP_T_FILL() -> i64 { return 52; }
fn OP_MEM_CONFIG() -> i64 { return 53; }
fn OP_LEARN() -> i64 { return 54; }
fn OP_PREDICT() -> i64 { return 55; }
fn OP_AG_CLEAR() -> i64 { return 56; }
fn OP_AG_PARAM() -> i64 { return 57; }
fn OP_AG_CONST() -> i64 { return 58; }
fn OP_AG_MATMUL() -> i64 { return 59; }
fn OP_AG_MSE() -> i64 { return 60; }
fn OP_AG_BACKWARD() -> i64 { return 61; }
fn OP_AG_STEP() -> i64 { return 62; }
fn OP_REMEMBER() -> i64 { return 63; }
fn OP_UNROLL() -> i64 { return 64; }
fn OP_SAVE_MIND() -> i64 { return 65; }
fn OP_LOAD_MIND() -> i64 { return 66; }
fn OP_REMEMBER_NEXT() -> i64 { return 67; }
fn OP_SURPRISE() -> i64 { return 68; }
fn OP_CONSOLIDATE() -> i64 { return 69; }
fn OP_MEM_STATS() -> i64 { return 70; }
fn OP_FORESEE() -> i64 { return 71; }
fn OP_FORESEE_N() -> i64 { return 86; }
fn OP_T_SET() -> i64 { return 87; }
fn OP_T_ADD() -> i64 { return 88; }
fn OP_T_SUB() -> i64 { return 89; }
fn OP_T_MUL() -> i64 { return 90; }
fn OP_T_SCALE() -> i64 { return 91; }
fn OP_T_TRANSPOSE() -> i64 { return 92; }
fn OP_T_SOFTMAX() -> i64 { return 93; }
fn OP_SAVE_TENSOR() -> i64 { return 94; }
fn OP_LOAD_TENSOR() -> i64 { return 95; }
fn OP_AG_ADD() -> i64 { return 72; }
fn OP_AG_SUB() -> i64 { return 73; }
fn OP_AG_MUL() -> i64 { return 74; }
fn OP_AG_SCALE() -> i64 { return 75; }
