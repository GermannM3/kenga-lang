// Mini codegen: parse a tiny Kenga fragment and write C99 (no Rust, no hand C).
// Dialect: fn main() { let x = N; while x < M { x = x + 1; } return x; }
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\mini_codegen.kenga

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 0 { break; }
        i = i + 1;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn parse_int(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    while i < len(s) {
        let c: i64 = ord(s[i]);
        if c < 48 { break; }
        if c > 57 { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return [v, i];
}
fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let out: str = "";
    let x: i64 = n;
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        out = digs[d] + out;
        x = x / 10;
    }
    return out;
}

fn emit_while_main(start: i64, limit: i64) -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/mini_codegen.kenga */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n";
    s = s + "int main(void) {\n";
    s = s + "  int64_t x = ";
    s = s + itoa(start);
    s = s + ";\n";
    s = s + "  while (x < ";
    s = s + itoa(limit);
    s = s + ") { x = x + 1; }\n";
    s = s + "  printf(\"%lld\\n\", (long long)x);\n";
    s = s + "  return (int)(x == ";
    s = s + itoa(limit);
    s = s + " ? 0 : 1);\n}\n";
    return s;
}

fn parse_while_prog(src: str) -> list {
    // fn main() { let x = A; while x < B { x = x + 1; } return x; }
    let i: i64 = skip(src, 0);
    assert(starts_with(src, i, "fn main()") == 1);
    i = skip(src, i + 9);
    assert(src[i] == "{"); i = i + 1;
    i = skip(src, i);
    assert(starts_with(src, i, "let x =") == 1);
    i = skip(src, i + 7);
    let a = parse_int(src, i); i = a[1];
    i = skip(src, i); if src[i] == ";" { i = i + 1; }
    i = skip(src, i);
    assert(starts_with(src, i, "while x <") == 1);
    i = skip(src, i + 9);
    let b = parse_int(src, i);
    return [a[0], b[0]];
}

fn main() -> i64 {
    let src: str = "fn main() { let x = 0; while x < 5 { x = x + 1; } return x; }";
    let ab = parse_while_prog(src);
    assert(ab[0] == 0);
    assert(ab[1] == 5);
    let c = emit_while_main(ab[0], ab[1]);
    assert(write_file("bootstrap/bin/mini_from_kenga.c", c) == true);
    assert(len(read_file("bootstrap/bin/mini_from_kenga.c")) > 80);
    println("wrote bootstrap/bin/mini_from_kenga.c");
    println("mini_codegen ok");
    return 0;
}
