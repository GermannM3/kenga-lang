// Minimal bytecode VM seed emitted from Kenga (no Rust).
// Proves VM host can be generated; runs CONST/ADD/PRINTLN/HALT.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\bc_vm_c.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/bc_vm_c.kenga — tiny i64 bytecode VM */\n";
    s = s + "#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n";
    s = s + "#include \"opcodes.inc.c\"\n\n";
    s = s + "static int64_t vm_run(const int64_t *code, int64_t n) {\n";
    s = s + "  int64_t stack[256]; int sp = 0; int64_t ip = 0;\n";
    s = s + "  while (ip < n) {\n";
    s = s + "    int64_t op = code[ip++];\n";
    s = s + "    if (op == OP_CONST) { stack[sp++] = code[ip++]; }\n";
    s = s + "    else if (op == OP_ADD) { int64_t b=stack[--sp]; int64_t a=stack[--sp]; stack[sp++]=a+b; }\n";
    s = s + "    else if (op == OP_SUB) { int64_t b=stack[--sp]; int64_t a=stack[--sp]; stack[sp++]=a-b; }\n";
    s = s + "    else if (op == OP_MUL) { int64_t b=stack[--sp]; int64_t a=stack[--sp]; stack[sp++]=a*b; }\n";
    s = s + "    else if (op == OP_PRINTLN) { printf(\"%lld\\n\", (long long)stack[--sp]); }\n";
    s = s + "    else if (op == OP_HALT) { return sp ? stack[sp-1] : 0; }\n";
    s = s + "    else { fprintf(stderr, \"bad op %lld\\n\", (long long)op); exit(1); }\n";
    s = s + "  }\n";
    s = s + "  return 0;\n}\n\n";
    s = s + "int main(void) {\n";
    s = s + "  /* 20 * 21 + 2 → 422 */\n";
    s = s + "  static const int64_t code[] = {\n";
    s = s + "    OP_CONST, 20, OP_CONST, 21, OP_MUL,\n";
    s = s + "    OP_CONST, 2, OP_ADD, OP_PRINTLN, OP_HALT\n";
    s = s + "  };\n";
    s = s + "  vm_run(code, (int64_t)(sizeof(code)/sizeof(code[0])));\n";
    s = s + "  return 0;\n}\n";
    assert(write_file("bootstrap/generated/bc_vm_seed.c", s) == true);
    println("wrote bootstrap/generated/bc_vm_seed.c");
    return 0;
}
