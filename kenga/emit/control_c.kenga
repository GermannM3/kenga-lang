// Emit: tiny control-flow program → C99 (no Rust).
// Ladder after expr_c: while + if + i64 locals.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\control_c.kenga

fn emit_control_c() -> str {
    let s: str = "";
    s = s + "/* generated by kenga/emit/control_c.kenga — no Rust */\n";
    s = s + "#include <stdio.h>\n";
    s = s + "#include <stdint.h>\n";
    s = s + "int main(void) {\n";
    s = s + "  int64_t n = 1;\n";
    s = s + "  int64_t i = 1;\n";
    s = s + "  while (i <= 5) {\n";
    s = s + "    n = n * i;\n";
    s = s + "    i = i + 1;\n";
    s = s + "  }\n";
    s = s + "  printf(\"%lld\\n\", (long long)n);\n";
    s = s + "  return n == 120 ? 0 : 1;\n";
    s = s + "}\n";
    return s;
}

fn main() -> i64 {
    let src = emit_control_c();
    assert(write_file("bootstrap/bin/control_from_kenga.c", src) == true);
    assert(len(read_file("bootstrap/bin/control_from_kenga.c")) > 100);
    println("wrote bootstrap/bin/control_from_kenga.c");
    println("control_c ok");
    return 0;
}
