// Emit Prophet world-model core on tagged KVal (no Rust, no lite VM).
// Writes bootstrap/generated/rt_kval_mem.inc.c -- include after rt_kval.inc.c.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_kval_mem.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_kval_mem.kenga -- do not hand-edit */\n";
    s = s + "/* requires rt_kval.inc.c (KVal, k_die, lists) */\n";
    s = s + "#ifndef KENGA_RT_KVAL_MEM_INC\n#define KENGA_RT_KVAL_MEM_INC\n";
    s = s + "#include <math.h>\n\n";
    s = s + "#define KM_DIM_MAX 64\n";
    s = s + "#define KM_HID_MAX 64\n";
    s = s + "#define KM_EP_MAX 64\n\n";
    s = s + "typedef struct {\n";
    s = s + "  int dim, hidden;\n";
    s = s + "  double w1[KM_HID_MAX * KM_DIM_MAX];\n";
    s = s + "  double b1[KM_HID_MAX];\n";
    s = s + "  double w2[KM_DIM_MAX * KM_HID_MAX];\n";
    s = s + "  double b2[KM_DIM_MAX];\n";
    s = s + "  double w1_lock[KM_HID_MAX * KM_DIM_MAX];\n";
    s = s + "  double b1_lock[KM_HID_MAX];\n";
    s = s + "  double w2_lock[KM_DIM_MAX * KM_HID_MAX];\n";
    s = s + "  double b2_lock[KM_DIM_MAX];\n";
    s = s + "  uint64_t steps;\n";
    s = s + "} KmWorld;\n\n";
    s = s + "typedef struct {\n";
    s = s + "  double pattern[KM_DIM_MAX];\n";
    s = s + "  double target[KM_DIM_MAX];\n";
    s = s + "  int dim;\n";
    s = s + "  int target_dim;\n";
    s = s + "  int has_target;\n";
    s = s + "  double surprise;\n";
    s = s + "} KmEpisode;\n\n";
    s = s + "typedef struct {\n";
    s = s + "  KmWorld model;\n";
    s = s + "  double threshold;\n";
    s = s + "  double lr;\n";
    s = s + "  KmEpisode ep[KM_EP_MAX];\n";
    s = s + "  int nep;\n";
    s = s + "  int ep_head;\n";
    s = s + "  int ep_cap;\n";
    s = s + "} KmMind;\n\n";
    s = s + "static KmMind *g_minds = NULL;\n";
    s = s + "static size_t g_minds_len = 0;\n";
    s = s + "static size_t g_minds_cap = 0;\n\n";
    s = s + "static double km_xavier(int fan_in, int fan_out, int i) {\n";
    s = s + "  double sc = sqrt(6.0 / (double)(fan_in + fan_out));\n";
    s = s + "  int64_t t = (int64_t)i * 1103515245LL + 12345LL;\n";
    s = s + "  if (t < 0) t = -t;\n";
    s = s + "  double u = (double)(t % 10000LL) / 10000.0;\n";
    s = s + "  return (u * 2.0 - 1.0) * sc;\n";
    s = s + "}\n\n";
    s = s + "static void km_wm_init(KmWorld *m, int dim, int hidden) {\n";
    s = s + "  int i, d, h;\n";
    s = s + "  if (dim < 1) dim = 1;\n";
    s = s + "  if (dim > KM_DIM_MAX) dim = KM_DIM_MAX;\n";
    s = s + "  if (hidden < 1) hidden = 1;\n";
    s = s + "  if (hidden > KM_HID_MAX) hidden = KM_HID_MAX;\n";
    s = s + "  memset(m, 0, sizeof(*m));\n";
    s = s + "  m->dim = dim;\n";
    s = s + "  m->hidden = hidden;\n";
    s = s + "  d = m->dim; h = m->hidden;\n";
    s = s + "  for (i = 0; i < h * d; i++) m->w1[i] = km_xavier(d, h, i);\n";
    s = s + "  for (i = 0; i < d * h; i++) m->w2[i] = km_xavier(h, d, i + 17) * 0.25;\n";
    s = s + "}\n\n";
    s = s + "static void km_wm_ensure(KmWorld *m, int dim) {\n";
    s = s + "  KmWorld old;\n";
    s = s + "  int od, h, r, c;\n";
    s = s + "  if (dim < 1) dim = 1;\n";
    s = s + "  if (dim > KM_DIM_MAX) dim = KM_DIM_MAX;\n";
    s = s + "  if (dim <= m->dim) return;\n";
    s = s + "  old = *m;\n";
    s = s + "  od = old.dim; h = old.hidden;\n";
    s = s + "  km_wm_init(m, dim, h);\n";
    s = s + "  for (r = 0; r < h; r++) {\n";
    s = s + "    for (c = 0; c < od; c++) {\n";
    s = s + "      m->w1[r * m->dim + c] = old.w1[r * od + c];\n";
    s = s + "      m->w1_lock[r * m->dim + c] = old.w1_lock[r * od + c];\n";
    s = s + "    }\n";
    s = s + "    m->b1[r] = old.b1[r];\n";
    s = s + "    m->b1_lock[r] = old.b1_lock[r];\n";
    s = s + "  }\n";
    s = s + "  for (r = 0; r < od; r++) {\n";
    s = s + "    for (c = 0; c < h; c++) {\n";
    s = s + "      m->w2[r * h + c] = old.w2[r * h + c];\n";
    s = s + "      m->w2_lock[r * h + c] = old.w2_lock[r * h + c];\n";
    s = s + "    }\n";
    s = s + "    m->b2[r] = old.b2[r];\n";
    s = s + "    m->b2_lock[r] = old.b2_lock[r];\n";
    s = s + "  }\n";
    s = s + "  m->steps = old.steps;\n";
    s = s + "}\n\n";
    s = s + "static void km_forward(const KmWorld *m, const double *x, int xn, double *h_out, double *y_out) {\n";
    s = s + "  int d = m->dim, h = m->hidden, r, c;\n";
    s = s + "  for (r = 0; r < h; r++) {\n";
    s = s + "    double acc = m->b1[r];\n";
    s = s + "    for (c = 0; c < d; c++) acc += m->w1[r * d + c] * (c < xn ? x[c] : 0.0);\n";
    s = s + "    h_out[r] = tanh(acc);\n";
    s = s + "  }\n";
    s = s + "  for (r = 0; r < d; r++) {\n";
    s = s + "    double delta = m->b2[r];\n";
    s = s + "    for (c = 0; c < h; c++) delta += m->w2[r * h + c] * h_out[c];\n";
    s = s + "    y_out[r] = (r < xn ? x[r] : 0.0) + delta;\n";
    s = s + "  }\n";
    s = s + "}\n\n";
    s = s + "static double km_train_step(KmWorld *m, const double *x, int xn, const double *tgt, int tn, double lr) {\n";
    s = s + "  int need = xn > tn ? xn : tn;\n";
    s = s + "  double hh[KM_HID_MAX], yy[KM_DIM_MAX], dy[KM_DIM_MAX], dh[KM_HID_MAX];\n";
    s = s + "  int d, h, r, c, i;\n";
    s = s + "  double loss = 0.0;\n";
    s = s + "  if (need < 1) need = 1;\n";
    s = s + "  km_wm_ensure(m, need);\n";
    s = s + "  d = m->dim; h = m->hidden;\n";
    s = s + "  km_forward(m, x, xn, hh, yy);\n";
    s = s + "  for (i = 0; i < d; i++) {\n";
    s = s + "    double t = i < tn ? tgt[i] : 0.0;\n";
    s = s + "    double err = t - yy[i];\n";
    s = s + "    loss += err * err;\n";
    s = s + "    dy[i] = err;\n";
    s = s + "  }\n";
    s = s + "  loss /= (double)d;\n";
    s = s + "  for (c = 0; c < h; c++) {\n";
    s = s + "    double acc = 0.0;\n";
    s = s + "    for (r = 0; r < d; r++) acc += m->w2[r * h + c] * dy[r];\n";
    s = s + "    dh[c] = acc * (1.0 - hh[c] * hh[c]);\n";
    s = s + "  }\n";
    s = s + "  for (r = 0; r < d; r++) {\n";
    s = s + "    for (c = 0; c < h; c++) {\n";
    s = s + "      int idx = r * h + c;\n";
    s = s + "      double g = dy[r] * hh[c];\n";
    s = s + "      double eff = lr / (1.0 + m->w2_lock[idx]);\n";
    s = s + "      m->w2[idx] += eff * g;\n";
    s = s + "      m->w2_lock[idx] += 0.02 * fabs(g);\n";
    s = s + "    }\n";
    s = s + "    {\n";
    s = s + "      double eff = lr / (1.0 + m->b2_lock[r]);\n";
    s = s + "      m->b2[r] += eff * dy[r];\n";
    s = s + "      m->b2_lock[r] += 0.02 * fabs(dy[r]);\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  for (r = 0; r < h; r++) {\n";
    s = s + "    for (c = 0; c < d; c++) {\n";
    s = s + "      int idx = r * d + c;\n";
    s = s + "      double xv = c < xn ? x[c] : 0.0;\n";
    s = s + "      double g = dh[r] * xv;\n";
    s = s + "      double eff = lr / (1.0 + m->w1_lock[idx]);\n";
    s = s + "      m->w1[idx] += eff * g;\n";
    s = s + "      m->w1_lock[idx] += 0.02 * fabs(g);\n";
    s = s + "    }\n";
    s = s + "    {\n";
    s = s + "      double eff = lr / (1.0 + m->b1_lock[r]);\n";
    s = s + "      m->b1[r] += eff * dh[r];\n";
    s = s + "      m->b1_lock[r] += 0.02 * fabs(dh[r]);\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  m->steps++;\n";
    s = s + "  return loss;\n";
    s = s + "}\n\n";
    s = s + "static int kval_list_to_pat(KVal v, double *out, int maxn) {\n";
    s = s + "  KListObj *l;\n";
    s = s + "  size_t i;\n";
    s = s + "  if (v.tag == KV_I64 || v.tag == KV_F64) {\n";
    s = s + "    if (maxn < 1) k_die(\"pattern too long\");\n";
    s = s + "    out[0] = kval_as_f64(v);\n";
    s = s + "    return 1;\n";
    s = s + "  }\n";
    s = s + "  if (v.tag != KV_LIST) k_die(\"expected list\");\n";
    s = s + "  l = klist_obj(v.u.list_id);\n";
    s = s + "  if ((int)l->len > maxn) k_die(\"pattern too long\");\n";
    s = s + "  for (i = 0; i < l->len; i++) out[i] = kval_as_f64(l->data[i]);\n";
    s = s + "  return (int)l->len;\n";
    s = s + "}\n\n";
    s = s + "static KVal pat_to_kval_list(const double *p, int n) {\n";
    s = s + "  int64_t id = klist_new();\n";
    s = s + "  int i;\n";
    s = s + "  if (n < 0) n = 0;\n";
    s = s + "  for (i = 0; i < n; i++) klist_push_val(id, kval_f64(p[i]));\n";
    s = s + "  return kval_list(id);\n";
    s = s + "}\n\n";
    s = s + "static KmMind *km_get(KVal v) {\n";
    s = s + "  int64_t id;\n";
    s = s + "  if (v.tag != KV_MEM) k_die(\"expected memory\");\n";
    s = s + "  id = v.u.i;\n";
    s = s + "  if (id < 0 || (size_t)id >= g_minds_len) k_die(\"bad memory\");\n";
    s = s + "  return &g_minds[id];\n";
    s = s + "}\n\n";
    s = s + "static double km_dist(const double *a, int an, const double *b, int bn) {\n";
    s = s + "  int n = an > bn ? an : bn;\n";
    s = s + "  int i;\n";
    s = s + "  double sum = 0.0;\n";
    s = s + "  if (n < 1) n = 1;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    double xa = i < an ? a[i] : 0.0;\n";
    s = s + "    double yb = i < bn ? b[i] : 0.0;\n";
    s = s + "    double d = xa - yb;\n";
    s = s + "    sum += d * d;\n";
    s = s + "  }\n";
    s = s + "  return sqrt(sum / (double)n);\n";
    s = s + "}\n\n";
    s = s + "static int km_ep_push(KmMind *m, const double *x, int xn, const double *y, int yn) {\n";
    s = s + "  KmEpisode *e;\n";
    s = s + "  int i, slot;\n";
    s = s + "  if (xn < 0) xn = 0;\n";
    s = s + "  if (yn < 0) yn = 0;\n";
    s = s + "  if (xn > KM_DIM_MAX) xn = KM_DIM_MAX;\n";
    s = s + "  if (yn > KM_DIM_MAX) yn = KM_DIM_MAX;\n";
    s = s + "  if (m->ep_cap < 1) m->ep_cap = KM_EP_MAX;\n";
    s = s + "  if (m->nep < m->ep_cap) {\n";
    s = s + "    slot = m->nep;\n";
    s = s + "    m->nep++;\n";
    s = s + "  } else {\n";
    s = s + "    slot = m->ep_head;\n";
    s = s + "    m->ep_head++;\n";
    s = s + "    if (m->ep_head >= m->ep_cap) m->ep_head = 0;\n";
    s = s + "  }\n";
    s = s + "  e = &m->ep[slot];\n";
    s = s + "  memset(e, 0, sizeof(*e));\n";
    s = s + "  e->dim = xn;\n";
    s = s + "  for (i = 0; i < xn; i++) e->pattern[i] = x[i];\n";
    s = s + "  e->has_target = yn > 0 ? 1 : 0;\n";
    s = s + "  e->target_dim = yn;\n";
    s = s + "  for (i = 0; i < yn; i++) e->target[i] = y[i];\n";
    s = s + "  return slot;\n";
    s = s + "}\n\n";
    s = s + "/* blend nearby episode patterns -- inverse-distance weights, top-3 */\n";
    s = s + "static void km_blend_ep(const KmMind *m, const double *obs, int on, double *out, int *out_n) {\n";
    s = s + "  int i, t, dim = on;\n";
    s = s + "  double wsum = 0.0;\n";
    s = s + "  double ws[KM_EP_MAX];\n";
    s = s + "  int idx[KM_EP_MAX];\n";
    s = s + "  int n = m->nep;\n";
    s = s + "  if (n == 0) {\n";
    s = s + "    *out_n = 0;\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    double d = km_dist(m->ep[i].pattern, m->ep[i].dim, obs, on);\n";
    s = s + "    ws[i] = 1.0 / (0.05 + d);\n";
    s = s + "    idx[i] = i;\n";
    s = s + "    if (m->ep[i].dim > dim) dim = m->ep[i].dim;\n";
    s = s + "  }\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    int j;\n";
    s = s + "    for (j = i + 1; j < n; j++) {\n";
    s = s + "      if (ws[idx[j]] > ws[idx[i]]) {\n";
    s = s + "        int tmp = idx[i];\n";
    s = s + "        idx[i] = idx[j];\n";
    s = s + "        idx[j] = tmp;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  t = n < 3 ? n : 3;\n";
    s = s + "  for (i = 0; i < dim; i++) out[i] = 0.0;\n";
    s = s + "  for (i = 0; i < t; i++) {\n";
    s = s + "    int ei = idx[i];\n";
    s = s + "    int k;\n";
    s = s + "    wsum += ws[ei];\n";
    s = s + "    for (k = 0; k < dim; k++) {\n";
    s = s + "      double p = k < m->ep[ei].dim ? m->ep[ei].pattern[k] : 0.0;\n";
    s = s + "      out[k] += ws[ei] * p;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (wsum < 1e-9) wsum = 1e-9;\n";
    s = s + "  for (i = 0; i < dim; i++) out[i] /= wsum;\n";
    s = s + "  *out_n = dim;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_memory_config(double threshold, int64_t ep_cap, int64_t hidden) {\n";
    s = s + "  KmMind m;\n";
    s = s + "  int h = (int)hidden;\n";
    s = s + "  int cap = (int)ep_cap;\n";
    s = s + "  memset(&m, 0, sizeof(m));\n";
    s = s + "  m.threshold = threshold;\n";
    s = s + "  m.lr = 0.08;\n";
    s = s + "  if (h < 1) h = 8; if (h > KM_HID_MAX) h = KM_HID_MAX;\n";
    s = s + "  if (cap < 1) cap = 1; if (cap > KM_EP_MAX) cap = KM_EP_MAX;\n";
    s = s + "  m.ep_cap = cap;\n";
    s = s + "  km_wm_init(&m.model, 1, h);\n";
    s = s + "  if (g_minds_len + 1 > g_minds_cap) {\n";
    s = s + "    size_t ncap = g_minds_cap ? g_minds_cap * 2 : 4;\n";
    s = s + "    KmMind *nd = (KmMind *)realloc(g_minds, ncap * sizeof(KmMind));\n";
    s = s + "    if (!nd) k_die(\"oom\");\n";
    s = s + "    g_minds = nd; g_minds_cap = ncap;\n";
    s = s + "  }\n";
    s = s + "  g_minds[g_minds_len] = m;\n";
    s = s + "  return kval_mem((int64_t)g_minds_len++);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_learn(KVal mem, KVal x, KVal y) {\n";
    s = s + "  KmMind *m = km_get(mem);\n";
    s = s + "  double xp[KM_DIM_MAX], yp[KM_DIM_MAX];\n";
    s = s + "  double loss;\n";
    s = s + "  int xn = kval_list_to_pat(x, xp, KM_DIM_MAX);\n";
    s = s + "  int yn = kval_list_to_pat(y, yp, KM_DIM_MAX);\n";
    s = s + "  loss = km_train_step(&m->model, xp, xn, yp, yn, m->lr);\n";
    s = s + "  km_ep_push(m, xp, xn, yp, yn);\n";
    s = s + "  return kval_f64(loss);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_predict(KVal mem, KVal x) {\n";
    s = s + "  KmMind *m = km_get(mem);\n";
    s = s + "  KmWorld tmp;\n";
    s = s + "  double xp[KM_DIM_MAX], hh[KM_HID_MAX], yy[KM_DIM_MAX], out[KM_DIM_MAX];\n";
    s = s + "  int xn, n, i;\n";
    s = s + "  xn = kval_list_to_pat(x, xp, KM_DIM_MAX);\n";
    s = s + "  tmp = m->model;\n";
    s = s + "  km_wm_ensure(&tmp, xn > 0 ? xn : 1);\n";
    s = s + "  km_forward(&tmp, xp, xn, hh, yy);\n";
    s = s + "  n = xn > 0 ? xn : tmp.dim;\n";
    s = s + "  if (n > tmp.dim) n = tmp.dim;\n";
    s = s + "  for (i = 0; i < n; i++) out[i] = yy[i];\n";
    s = s + "  return pat_to_kval_list(out, n);\n";
    s = s + "}\n\n";
    s = s + "/* foresee: neural + episode-pattern blend -- same mix as lite pl_foresee */\n";
    s = s + "static KVal k_foresee(KVal mem, KVal x) {\n";
    s = s + "  KmMind *m = km_get(mem);\n";
    s = s + "  KmWorld tmp;\n";
    s = s + "  double xp[KM_DIM_MAX], hh[KM_HID_MAX];\n";
    s = s + "  double neural[KM_DIM_MAX], core[KM_DIM_MAX], out[KM_DIM_MAX];\n";
    s = s + "  int xn, nn, cn, dim, i;\n";
    s = s + "  double nw, cw;\n";
    s = s + "  xn = kval_list_to_pat(x, xp, KM_DIM_MAX);\n";
    s = s + "  tmp = m->model;\n";
    s = s + "  km_wm_ensure(&tmp, xn > 0 ? xn : 1);\n";
    s = s + "  km_forward(&tmp, xp, xn, hh, neural);\n";
    s = s + "  nn = xn > 0 ? xn : tmp.dim;\n";
    s = s + "  if (nn > tmp.dim) nn = tmp.dim;\n";
    s = s + "  km_blend_ep(m, xp, xn, core, &cn);\n";
    s = s + "  if (cn == 0) {\n";
    s = s + "    if (m->model.steps == 0) return pat_to_kval_list(xp, xn);\n";
    s = s + "    return pat_to_kval_list(neural, nn);\n";
    s = s + "  }\n";
    s = s + "  dim = nn > cn ? nn : cn;\n";
    s = s + "  if (xn > dim) dim = xn;\n";
    s = s + "  nw = m->model.steps > 0 ? 0.6 : 0.15;\n";
    s = s + "  cw = 1.0 - nw;\n";
    s = s + "  for (i = 0; i < dim; i++) {\n";
    s = s + "    double n = i < nn ? neural[i] : 0.0;\n";
    s = s + "    double c = i < cn ? core[i] : 0.0;\n";
    s = s + "    double o = i < xn ? xp[i] : 0.0;\n";
    s = s + "    out[i] = nw * n + cw * c * 0.8 + o * 0.2;\n";
    s = s + "  }\n";
    s = s + "  return pat_to_kval_list(out, dim);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_surprise(KVal a, KVal b) {\n";
    s = s + "  double pa[KM_DIM_MAX], pb[KM_DIM_MAX];\n";
    s = s + "  int an = kval_list_to_pat(a, pa, KM_DIM_MAX);\n";
    s = s + "  int bn = kval_list_to_pat(b, pb, KM_DIM_MAX);\n";
    s = s + "  return kval_f64(km_dist(pa, an, pb, bn));\n";
    s = s + "}\n";
    s = s + "static KVal k_remember(KVal mem, KVal pat, KVal sur) {\n";
    s = s + "  KmMind *m = km_get(mem); double xp[KM_DIM_MAX]; int xn; double s = kval_as_f64(sur);\n";
    s = s + "  if (s < m->threshold) return kval_i64(0);\n";
    s = s + "  xn = kval_list_to_pat(pat, xp, KM_DIM_MAX);\n";
    s = s + "  m->ep[km_ep_push(m, xp, xn, NULL, 0)].surprise = s;\n";
    s = s + "  return kval_i64(1);\n";
    s = s + "}\n";
    s = s + "static KVal k_remember_next(KVal mem, KVal a, KVal b, KVal sur) {\n";
    s = s + "  KmMind *m = km_get(mem); double xp[KM_DIM_MAX], yp[KM_DIM_MAX]; int xn, yn; double s = kval_as_f64(sur);\n";
    s = s + "  if (s < m->threshold) return kval_i64(0);\n";
    s = s + "  xn = kval_list_to_pat(a, xp, KM_DIM_MAX); yn = kval_list_to_pat(b, yp, KM_DIM_MAX);\n";
    s = s + "  m->ep[km_ep_push(m, xp, xn, yp, yn)].surprise = s;\n";
    s = s + "  return kval_i64(1);\n";
    s = s + "}\n";
    s = s + "static KVal k_unroll(KVal mem, KVal x, KVal nsteps) {\n";
    s = s + "  KmMind *m = km_get(mem); double cur[KM_DIM_MAX]; int cn, steps, s, i;\n";
    s = s + "  int64_t out = klist_new();\n";
    s = s + "  cn = kval_list_to_pat(x, cur, KM_DIM_MAX);\n";
    s = s + "  steps = (int)kval_as_i64(nsteps); if (steps < 1) steps = 1; if (steps > 64) steps = 64;\n";
    s = s + "  for (s = 0; s < steps; s++) {\n";
    s = s + "    KVal nxt = k_predict(mem, pat_to_kval_list(cur, cn));\n";
    s = s + "    klist_push_val(out, nxt);\n";
    s = s + "    cn = kval_list_to_pat(nxt, cur, KM_DIM_MAX);\n";
    s = s + "  }\n";
    s = s + "  return kval_list(out);\n";
    s = s + "}\n";
    s = s + "static KVal k_foresee_n(KVal mem, KVal x, KVal nsteps) {\n";
    s = s + "  double cur[KM_DIM_MAX]; int cn, steps, s;\n";
    s = s + "  int64_t out = klist_new();\n";
    s = s + "  cn = kval_list_to_pat(x, cur, KM_DIM_MAX);\n";
    s = s + "  steps = (int)kval_as_i64(nsteps); if (steps < 1) steps = 1; if (steps > 64) steps = 64;\n";
    s = s + "  for (s = 0; s < steps; s++) {\n";
    s = s + "    KVal nxt = k_foresee(mem, pat_to_kval_list(cur, cn));\n";
    s = s + "    klist_push_val(out, nxt);\n";
    s = s + "    cn = kval_list_to_pat(nxt, cur, KM_DIM_MAX);\n";
    s = s + "  }\n";
    s = s + "  return kval_list(out);\n";
    s = s + "}\n";
    s = s + "static KVal k_consolidate(KVal mem) {\n";
    s = s + "  KmMind *m = km_get(mem); int i, n = 0;\n";
    s = s + "  for (i = 0; i < m->nep; i++) {\n";
    s = s + "    if (!m->ep[i].has_target) continue;\n";
    s = s + "    km_train_step(&m->model, m->ep[i].pattern, m->ep[i].dim, m->ep[i].target, m->ep[i].target_dim, m->lr);\n";
    s = s + "    n++;\n";
    s = s + "  }\n";
    s = s + "  return kval_i64((int64_t)n);\n";
    s = s + "}\n";
    s = s + "static KVal k_mem_stats(KVal mem) {\n";
    s = s + "  KmMind *m = km_get(mem); int64_t id = klist_new();\n";
    s = s + "  klist_push_val(id, kval_i64((int64_t)m->nep));\n";
    s = s + "  klist_push_val(id, kval_i64((int64_t)m->model.steps));\n";
    s = s + "  klist_push_val(id, kval_f64(m->threshold));\n";
    s = s + "  return kval_list(id);\n";
    s = s + "}\n";
    s = s + "static void km_write_f64s(FILE *f, const double *xs, int n) {\n";
    s = s + "  int i; for (i = 0; i < n; i++) { if (i) fputc(' ', f); fprintf(f, \"%.17g\", xs[i]); }\n";
    s = s + "  fputc('\\n', f);\n";
    s = s + "}\n";
    s = s + "static int km_read_f64s(FILE *f, double *out, int n) {\n";
    s = s + "  int i; for (i = 0; i < n; i++) if (fscanf(f, \"%lf\", &out[i]) != 1) return -1; return 0;\n";
    s = s + "}\n";
    s = s + "static int km_parse_f64s(const char *line, double *out, int expect) {\n";
    s = s + "  int n = 0; const char *p = line;\n";
    s = s + "  while (*p && n < expect) {\n";
    s = s + "    char *end = NULL; double v;\n";
    s = s + "    while (*p == ' ' || *p == '\\t') p++;\n";
    s = s + "    if (!*p || *p == '\\n' || *p == '\\r') break;\n";
    s = s + "    v = strtod(p, &end); if (end == p) return -1;\n";
    s = s + "    out[n++] = v; p = end;\n";
    s = s + "  }\n";
    s = s + "  return n == expect ? n : -1;\n";
    s = s + "}\n";
    s = s + "static KVal k_save_mind(KVal mem, KVal path) {\n";
    s = s + "  KmMind *m = km_get(mem); FILE *f = fopen(kval_as_str(path), \"wb\");\n";
    s = s + "  int d, h, i;\n";
    s = s + "  if (!f) return kval_i64(0);\n";
    s = s + "  d = m->model.dim; h = m->model.hidden;\n";
    s = s + "  fprintf(f, \"KENGA_MIND 1\\n\");\n";
    s = s + "  fprintf(f, \"threshold %.17g\\n\", m->threshold);\n";
    s = s + "  fprintf(f, \"ep_cap %d\\n\", m->ep_cap);\n";
    s = s + "  fprintf(f, \"core_cap %d\\n\", h);\n";
    s = s + "  fprintf(f, \"lr %.17g\\n\", m->lr);\n";
    s = s + "  fprintf(f, \"model %d %d %llu\\n\", d, h, (unsigned long long)m->model.steps);\n";
    s = s + "  km_write_f64s(f, m->model.w1, h * d);\n";
    s = s + "  km_write_f64s(f, m->model.b1, h);\n";
    s = s + "  km_write_f64s(f, m->model.w2, d * h);\n";
    s = s + "  km_write_f64s(f, m->model.b2, d);\n";
    s = s + "  km_write_f64s(f, m->model.w1_lock, h * d);\n";
    s = s + "  km_write_f64s(f, m->model.b1_lock, h);\n";
    s = s + "  km_write_f64s(f, m->model.w2_lock, d * h);\n";
    s = s + "  km_write_f64s(f, m->model.b2_lock, d);\n";
    s = s + "  fprintf(f, \"core 0\\n\");\n";
    s = s + "  fprintf(f, \"episodic %d\\n\", m->nep);\n";
    s = s + "  for (i = 0; i < m->nep; i++) {\n";
    s = s + "    int has_t = m->ep[i].has_target ? 1 : 0;\n";
    s = s + "    int tlen = has_t ? (m->ep[i].target_dim > 0 ? m->ep[i].target_dim : m->ep[i].dim) : 0;\n";
    s = s + "    fprintf(f, \"%.17g 0 %d %d %d\\n\", m->ep[i].surprise, m->ep[i].dim, has_t, tlen);\n";
    s = s + "    km_write_f64s(f, m->ep[i].pattern, m->ep[i].dim);\n";
    s = s + "    if (has_t) km_write_f64s(f, m->ep[i].target, tlen);\n";
    s = s + "  }\n";
    s = s + "  fclose(f); return kval_i64(1);\n";
    s = s + "}\n";
    s = s + "static KVal k_load_mind(KVal path) {\n";
    s = s + "  FILE *f = fopen(kval_as_str(path), \"rb\");\n";
    s = s + "  KmMind m; char line[8192]; int d, h, i, core_n, ep_n; unsigned long long steps;\n";
    s = s + "  memset(&m, 0, sizeof(m));\n";
    s = s + "  if (!f) k_die(\"load_mind: cannot open\");\n";
    s = s + "  if (!fgets(line, sizeof(line), f) || strncmp(line, \"KENGA_MIND 1\", 12) != 0) { fclose(f); k_die(\"load_mind: bad header\"); }\n";
    s = s + "  if (!fgets(line, sizeof(line), f) || sscanf(line, \"threshold %lf\", &m.threshold) != 1) { fclose(f); k_die(\"load_mind: threshold\"); }\n";
    s = s + "  if (!fgets(line, sizeof(line), f) || sscanf(line, \"ep_cap %d\", &m.ep_cap) != 1) { fclose(f); k_die(\"load_mind: ep_cap\"); }\n";
    s = s + "  if (!fgets(line, sizeof(line), f)) { fclose(f); k_die(\"load_mind: core_cap\"); }\n";
    s = s + "  if (!fgets(line, sizeof(line), f) || sscanf(line, \"lr %lf\", &m.lr) != 1) { fclose(f); k_die(\"load_mind: lr\"); }\n";
    s = s + "  if (!fgets(line, sizeof(line), f) || sscanf(line, \"model %d %d %llu\", &d, &h, &steps) != 3) { fclose(f); k_die(\"load_mind: model\"); }\n";
    s = s + "  if (d < 1 || d > KM_DIM_MAX || h < 1 || h > KM_HID_MAX) { fclose(f); k_die(\"load_mind: dims\"); }\n";
    s = s + "  if (m.ep_cap < 1 || m.ep_cap > KM_EP_MAX) m.ep_cap = KM_EP_MAX;\n";
    s = s + "  m.model.dim = d; m.model.hidden = h; m.model.steps = (uint64_t)steps;\n";
    s = s + "  if (km_read_f64s(f, m.model.w1, h * d) != 0) { fclose(f); k_die(\"load_mind: w1\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.b1, h) != 0) { fclose(f); k_die(\"load_mind: b1\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.w2, d * h) != 0) { fclose(f); k_die(\"load_mind: w2\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.b2, d) != 0) { fclose(f); k_die(\"load_mind: b2\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.w1_lock, h * d) != 0) { fclose(f); k_die(\"load_mind: w1_lock\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.b1_lock, h) != 0) { fclose(f); k_die(\"load_mind: b1_lock\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.w2_lock, d * h) != 0) { fclose(f); k_die(\"load_mind: w2_lock\"); }\n";
    s = s + "  if (km_read_f64s(f, m.model.b2_lock, d) != 0) { fclose(f); k_die(\"load_mind: b2_lock\"); }\n";
    s = s + "  if (fscanf(f, \" core %d\", &core_n) != 1) { fclose(f); k_die(\"load_mind: core\"); }\n";
    s = s + "  for (i = 0; i < core_n; i++) {\n";
    s = s + "    double dummy[KM_DIM_MAX]; int plen; unsigned long long rep; double imp;\n";
    s = s + "    if (fscanf(f, \"%lf %llu %d\", &imp, &rep, &plen) != 3) { fclose(f); k_die(\"load_mind: core meta\"); }\n";
    s = s + "    if (plen < 1 || plen > KM_DIM_MAX || km_read_f64s(f, dummy, plen) != 0) { fclose(f); k_die(\"load_mind: core pat\"); }\n";
    s = s + "    (void)imp; (void)rep;\n";
    s = s + "  }\n";
    s = s + "  if (fscanf(f, \" episodic %d\", &ep_n) != 1) { fclose(f); k_die(\"load_mind: episodic\"); }\n";
    s = s + "  if (ep_n < 0 || ep_n > KM_EP_MAX) { fclose(f); k_die(\"load_mind: too many ep\"); }\n";
    s = s + "  m.nep = ep_n;\n";
    s = s + "  for (i = 0; i < ep_n; i++) {\n";
    s = s + "    unsigned long long ts; int plen, has_t, tlen;\n";
    s = s + "    if (fscanf(f, \"%lf %llu %d %d %d\", &m.ep[i].surprise, &ts, &plen, &has_t, &tlen) != 5) { fclose(f); k_die(\"load_mind: ep meta\"); }\n";
    s = s + "    m.ep[i].has_target = has_t ? 1 : 0; m.ep[i].dim = plen;\n";
    s = s + "    if (plen < 1 || plen > KM_DIM_MAX || km_read_f64s(f, m.ep[i].pattern, plen) != 0) { fclose(f); k_die(\"load_mind: ep pat\"); }\n";
    s = s + "    if (has_t) {\n";
    s = s + "      m.ep[i].target_dim = tlen;\n";
    s = s + "      if (tlen < 1 || tlen > KM_DIM_MAX || km_read_f64s(f, m.ep[i].target, tlen) != 0) { fclose(f); k_die(\"load_mind: ep tgt\"); }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  fclose(f);\n";
    s = s + "  if (g_minds_len + 1 > g_minds_cap) {\n";
    s = s + "    size_t ncap = g_minds_cap ? g_minds_cap * 2 : 4;\n";
    s = s + "    KmMind *nd = (KmMind *)realloc(g_minds, ncap * sizeof(KmMind));\n";
    s = s + "    if (!nd) k_die(\"oom\"); g_minds = nd; g_minds_cap = ncap;\n";
    s = s + "  }\n";
    s = s + "  g_minds[g_minds_len] = m;\n";
    s = s + "  return kval_mem((int64_t)g_minds_len++);\n";
    s = s + "}\n";
    s = s + "static KVal k_sweep(void) { return kval_i64(0); }\n";
    s = s + "static KVal k_memory(void) { return k_memory_config(0.12, 16, 8); }\n";
    s = s + "#endif /* KENGA_RT_KVAL_MEM_INC */\n";

    assert(write_file("bootstrap/generated/rt_kval_mem.inc.c", s) == true);
    println("rt_kval_mem ok");
    return 0;
}
