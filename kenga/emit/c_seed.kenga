// Self-host seed: Kenga пишет C без Rust emit-c.
// Цель лестницы: компилятор на Kenga → текст .c → gcc (временно) → native.
// Позже: тот же компилятор эмитит bytecode для VM на Kenga — и C уходит.

fn emit_c_main(expr_c: str) -> str {
    let s: str = "";
    s = s + "/* generated by emit_c_seed.kenga - no Rust */\n";
    s = s + "#include <stdio.h>\n";
    s = s + "#include <stdint.h>\n";
    s = s + "int main(void) {\n";
    s = s + "  int64_t r = ";
    s = s + expr_c;
    s = s + ";\n";
    s = s + "  printf(\"%lld\\n\", (long long)r);\n";
    s = s + "  return (int)r;\n";
    s = s + "}\n";
    return s;
}

fn main() -> i64 {
    // «компиляция» тривиального выражения — зародыш codegen на чистой Kenga
    let src = emit_c_main("(2 + 3) * 4");
    assert(write_file("bootstrap/bin/seed_from_kenga.c", src) == true);
    let back = read_file("bootstrap/bin/seed_from_kenga.c");
    assert(len(back) > 40);
    println("wrote bootstrap/bin/seed_from_kenga.c");
    println("next: gcc bootstrap/bin/seed_from_kenga.c -o bootstrap/bin/seed_from_kenga");
    println("emit_c_seed ok");
    return 0;
}
