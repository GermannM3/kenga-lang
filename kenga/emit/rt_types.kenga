// Emit opcodes and host types for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_types.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_types.kenga — do not hand-edit */\n";
    s = s + "enum {\n";
    s = s + "  OP_CONST = 1,\n";
    s = s + "  OP_LOAD,\n";
    s = s + "  OP_STORE,\n";
    s = s + "  OP_ADD,\n";
    s = s + "  OP_SUB,\n";
    s = s + "  OP_MUL,\n";
    s = s + "  OP_DIV,\n";
    s = s + "  OP_LT,\n";
    s = s + "  OP_GT,\n";
    s = s + "  OP_EQ,\n";
    s = s + "  OP_JMP,\n";
    s = s + "  OP_JMPF,\n";
    s = s + "  OP_HALT,\n";
    s = s + "  OP_LE,\n";
    s = s + "  OP_CALL,\n";
    s = s + "  OP_RET,\n";
    s = s + "  OP_NE,\n";
    s = s + "  OP_GE,\n";
    s = s + "  OP_PRINTLN,\n";
    s = s + "  OP_CONST_STR,\n";
    s = s + "  OP_LIST_NEW,\n";
    s = s + "  OP_LIST_PUSH,\n";
    s = s + "  OP_LEN,\n";
    s = s + "  OP_GET,\n";
    s = s + "  OP_SET,\n";
    s = s + "  OP_STRUCT_NEW,\n";
    s = s + "  OP_GET_FIELD,\n";
    s = s + "  OP_SET_FIELD,\n";
    s = s + "  OP_CONST_F64,\n";
    s = s + "  OP_ROUND,\n";
    s = s + "  OP_ASSERT,\n";
    s = s + "  OP_POP,\n";
    s = s + "  OP_ORD,\n";
    s = s + "  OP_NOW_MS,\n";
    s = s + "  OP_EMIT,\n";
    s = s + "  OP_PUMP,\n";
    s = s + "  OP_PENDING,\n";
    s = s + "  OP_LISTEN,\n";
    s = s + "  OP_TYPEOF,\n";
    s = s + "  OP_WRITE_FILE,\n";
    s = s + "  OP_READ_FILE,\n";
    s = s + "  OP_MOD,\n";
    s = s + "  OP_AND,\n";
    s = s + "  OP_OR,\n";
    s = s + "  OP_NOT,\n";
    s = s + "  OP_TO_STR,\n";
    s = s + "  OP_PRINT,\n";
    s = s + "  OP_SLEEP_MS,\n";
    s = s + "  OP_READ_BYTES,\n";
    s = s + "  OP_ML_BOX,\n";
    s = s + "  OP_ARGC,\n";
    s = s + "  OP_ARG,\n";
    s = s + "  OP_FILE_EXISTS,\n";
    s = s + "  OP_READ_LINE,\n";
    s = s + "  OP_BAND,\n";
    s = s + "  OP_BOR,\n";
    s = s + "  OP_BXOR,\n";
    s = s + "  OP_BNOT,\n";
    s = s + "  OP_SHL,\n";
    s = s + "  OP_SHR,\n";
    s = s + "  OP_GETENV,\n";
    s = s + "  OP_HTTP_REQUEST,\n";
    s = s + "  OP_JSON_GET,\n";
    s = s + "  OP_JSON_ESCAPE,\n";
    s = s + "  OP_AFTER_MS,\n";
    s = s + "  OP_FLUSH_DUE,\n";
    s = s + "  OP_TIMER_N,\n";
    s = s + "  OP_URL_ENCODE,\n";
    s = s + "  OP_HTML_TEXT,\n";
    s = s + "  OP_SLICE,\n";
    s = s + "  OP_INDEX_OF,\n";
    s = s + "  OP_STARTS_WITH,\n";
    s = s + "  OP_SPLIT\n";
    s = s + "};\n";
    s = s + "static int g_kargc = 0;\n";
    s = s + "static char **g_kargv = NULL;\n";
    s = s + "\n";
    s = s + "enum { TAG_I64 = 0, TAG_STR = 1, TAG_LIST = 2, TAG_STRUCT = 3, TAG_F64 = 4 };\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int tag;\n";
    s = s + "  int64_t payload; /* i64 value, or str/list/struct handle */\n";
    s = s + "} Value;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int64_t *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} I64A;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  Value *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} ValA;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char **data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} StrA;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  I64A *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} I64AA; /* array of int arrays (param lists) */\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  ValA *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} ListHeap;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *name;\n";
    s = s + "  StrA fields;\n";
    s = s + "} StructType;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int type_id;\n";
    s = s + "  I64A fields; /* i64 field values */\n";
    s = s + "} StructObj;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  StructObj *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} StructHeap;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *event;\n";
    s = s + "  int64_t fn_index; /* compile: fn table index; then overwritten with code addr */\n";
    s = s + "  int arity;\n";
    s = s + "} EvBind;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *name;\n";
    s = s + "  int64_t addr;\n";
    s = s + "  int arity;\n";
    s = s + "} FnInfo;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  I64A code;\n";
    s = s + "  StrA strs;\n";
    s = s + "  StructType *stypes;\n";
    s = s + "  size_t nstypes;\n";
    s = s + "  EvBind *binds;\n";
    s = s + "  size_t nbinds;\n";
    s = s + "  FnInfo *fns;\n";
    s = s + "  size_t nfns;\n";
    s = s + "} Program;\n";
    s = s + "\n";
    s = s + "static StrA *g_strtab; /* active during compile */\n";
    s = s + "static StructType *g_stypes;\n";
    s = s + "static size_t g_nstypes, g_stypes_cap;\n";
    assert(write_file("bootstrap/generated/rt_types.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_types.inc.c");
    println("rt_types ok");
    return 0;
}
