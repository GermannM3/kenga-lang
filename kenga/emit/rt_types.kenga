// Emit opcodes and host types for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_types.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_types.kenga — do not hand-edit */\n";
    s = s + "enum {\n";
    s = s + "  OP_CONST = 1,\n";
    s = s + "  OP_LOAD,\n";
    s = s + "  OP_STORE,\n";
    s = s + "  OP_ADD,\n";
    s = s + "  OP_SUB,\n";
    s = s + "  OP_MUL,\n";
    s = s + "  OP_DIV,\n";
    s = s + "  OP_LT,\n";
    s = s + "  OP_GT,\n";
    s = s + "  OP_EQ,\n";
    s = s + "  OP_JMP,\n";
    s = s + "  OP_JMPF,\n";
    s = s + "  OP_HALT,\n";
    s = s + "  OP_LE,\n";
    s = s + "  OP_CALL,\n";
    s = s + "  OP_RET,\n";
    s = s + "  OP_NE,\n";
    s = s + "  OP_GE,\n";
    s = s + "  OP_PRINTLN,\n";
    s = s + "  OP_CONST_STR,\n";
    s = s + "  OP_LIST_NEW,\n";
    s = s + "  OP_LIST_PUSH,\n";
    s = s + "  OP_LEN,\n";
    s = s + "  OP_GET,\n";
    s = s + "  OP_SET,\n";
    s = s + "  OP_STRUCT_NEW,\n";
    s = s + "  OP_GET_FIELD,\n";
    s = s + "  OP_SET_FIELD,\n";
    s = s + "  OP_CONST_F64,\n";
    s = s + "  OP_ROUND,\n";
    s = s + "  OP_ASSERT,\n";
    s = s + "  OP_POP,\n";
    s = s + "  OP_ORD,\n";
    s = s + "  OP_MEM_CONFIG,\n";
    s = s + "  OP_MEM_REMEMBER,\n";
    s = s + "  OP_MEM_SURPRISE,\n";
    s = s + "  OP_MEM_FORESEE,\n";
    s = s + "  OP_MEM_CONSOLIDATE,\n";
    s = s + "  OP_MEM_STATS,\n";
    s = s + "  OP_MEM_RECALL,\n";
    s = s + "  OP_SAVE_MIND,\n";
    s = s + "  OP_LOAD_MIND,\n";
    s = s + "  OP_TENSOR,\n";
    s = s + "  OP_T_FROM,\n";
    s = s + "  OP_T_FILL,\n";
    s = s + "  OP_T_GET,\n";
    s = s + "  OP_T_SET,\n";
    s = s + "  OP_T_SHAPE,\n";
    s = s + "  OP_T_ADD,\n";
    s = s + "  OP_T_SUB,\n";
    s = s + "  OP_T_MUL,\n";
    s = s + "  OP_T_MATMUL,\n";
    s = s + "  OP_T_RESHAPE,\n";
    s = s + "  OP_T_TRANSPOSE,\n";
    s = s + "  OP_T_SCALE,\n";
    s = s + "  OP_T_SUM,\n";
    s = s + "  OP_T_DOT,\n";
    s = s + "  OP_T_EXP,\n";
    s = s + "  OP_T_SOFTMAX,\n";
    s = s + "  OP_SWEEP,\n";
    s = s + "  OP_NOW_MS,\n";
    s = s + "  OP_LOAD_PPM,\n";
    s = s + "  OP_LOAD_WAV,\n";
    s = s + "  OP_T_MEAN,\n";
    s = s + "  OP_LEARN,\n";
    s = s + "  OP_PREDICT,\n";
    s = s + "  OP_UNROLL,\n";
    s = s + "  OP_REMEMBER_NEXT,\n";
    s = s + "  OP_EMIT,\n";
    s = s + "  OP_PUMP,\n";
    s = s + "  OP_PENDING,\n";
    s = s + "  OP_LISTEN,\n";
    s = s + "  OP_TYPEOF,\n";
    s = s + "  OP_AG_CLEAR,\n";
    s = s + "  OP_AG_PARAM,\n";
    s = s + "  OP_AG_CONST,\n";
    s = s + "  OP_AG_ADD,\n";
    s = s + "  OP_AG_SUB,\n";
    s = s + "  OP_AG_MUL,\n";
    s = s + "  OP_AG_MATMUL,\n";
    s = s + "  OP_AG_SCALE,\n";
    s = s + "  OP_AG_RELU,\n";
    s = s + "  OP_AG_NEG,\n";
    s = s + "  OP_AG_TRANSPOSE,\n";
    s = s + "  OP_AG_RESHAPE,\n";
    s = s + "  OP_AG_EXP,\n";
    s = s + "  OP_AG_SOFTMAX,\n";
    s = s + "  OP_AG_MSE,\n";
    s = s + "  OP_AG_SUM,\n";
    s = s + "  OP_AG_VALUE,\n";
    s = s + "  OP_AG_GRAD,\n";
    s = s + "  OP_AG_BACKWARD,\n";
    s = s + "  OP_AG_STEP,\n";
    s = s + "  OP_T_MSE,\n";
    s = s + "  OP_T_PATCH_MEAN,\n";
    s = s + "  OP_T_LINEAR_GRAD,\n";
    s = s + "  OP_T_LOG,\n";
    s = s + "  OP_AG_LOG,\n";
    s = s + "  OP_SAVE_TENSOR,\n";
    s = s + "  OP_LOAD_TENSOR,\n";
    s = s + "  OP_WRITE_FILE,\n";
    s = s + "  OP_READ_FILE,\n";
    s = s + "  OP_MOD,\n";
    s = s + "  OP_AND,\n";
    s = s + "  OP_OR,\n";
    s = s + "  OP_NOT,\n";
    s = s + "  OP_TO_STR,\n";
    s = s + "  OP_PRINT,\n";
    s = s + "  OP_SLEEP_MS,\n";
    s = s + "  OP_FORESEE_N\n";
    s = s + "};\n";
    s = s + "\n";
    s = s + "enum { TAG_I64 = 0, TAG_STR = 1, TAG_LIST = 2, TAG_STRUCT = 3, TAG_F64 = 4, TAG_MEMORY = 5,\n";
    s = s + "       TAG_TENSOR = 6 };\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int tag;\n";
    s = s + "  int64_t payload; /* i64 value, or str/list/struct handle */\n";
    s = s + "} Value;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int64_t *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} I64A;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  Value *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} ValA;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char **data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} StrA;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  I64A *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} I64AA; /* array of int arrays (param lists) */\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  ValA *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} ListHeap;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *name;\n";
    s = s + "  StrA fields;\n";
    s = s + "} StructType;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  int type_id;\n";
    s = s + "  I64A fields; /* i64 field values */\n";
    s = s + "} StructObj;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  StructObj *data;\n";
    s = s + "  size_t len, cap;\n";
    s = s + "} StructHeap;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *event;\n";
    s = s + "  int64_t fn_index; /* compile: fn table index; then overwritten with code addr */\n";
    s = s + "  int arity;\n";
    s = s + "} EvBind;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  char *name;\n";
    s = s + "  int64_t addr;\n";
    s = s + "  int arity;\n";
    s = s + "} FnInfo;\n";
    s = s + "\n";
    s = s + "typedef struct {\n";
    s = s + "  I64A code;\n";
    s = s + "  StrA strs;\n";
    s = s + "  StructType *stypes;\n";
    s = s + "  size_t nstypes;\n";
    s = s + "  EvBind *binds;\n";
    s = s + "  size_t nbinds;\n";
    s = s + "  FnInfo *fns;\n";
    s = s + "  size_t nfns;\n";
    s = s + "} Program;\n";
    s = s + "\n";
    s = s + "static StrA *g_strtab; /* active during compile */\n";
    s = s + "static StructType *g_stypes;\n";
    s = s + "static size_t g_nstypes, g_stypes_cap;\n";
    assert(write_file("bootstrap/generated/rt_types.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_types.inc.c");
    println("rt_types ok");
    return 0;
}
