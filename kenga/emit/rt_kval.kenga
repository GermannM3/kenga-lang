// Emit tagged KVal + events + file IO runtime (no Rust).
// Writes bootstrap/generated/rt_kval.inc.c — include from lowered programs / future lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_kval.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_kval.kenga -- do not hand-edit */\n";
    s = s + "#ifndef KENGA_RT_KVAL_INC\n#define KENGA_RT_KVAL_INC\n";
    s = s + "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n#include <math.h>\n\n";
    s = s + "enum { KV_I64 = 0, KV_STR = 1, KV_LIST = 2, KV_F64 = 3, KV_MEM = 4, KV_TENSOR = 5 };\n";
    s = s + "typedef struct { int tag; union { int64_t i; const char *s; int64_t list_id; double f; } u; } KVal;\n";
    s = s + "typedef struct { KVal *data; size_t len; size_t cap; } KListObj;\n";
    s = s + "static KListObj *g_lists = NULL; static size_t g_lists_len = 0; static size_t g_lists_cap = 0;\n";
    s = s + "static void k_die(const char *msg) { fprintf(stderr, \"kenga: %s\\n\", msg); exit(1); }\n";
    s = s + "static KVal kval_i64(int64_t x) { KVal v; v.tag = KV_I64; v.u.i = x; return v; }\n";
    s = s + "static KVal kval_f64(double x) { KVal v; v.tag = KV_F64; v.u.f = x; return v; }\n";
    s = s + "static KVal kval_str(const char *s) { KVal v; v.tag = KV_STR; v.u.s = s ? s : \"\"; return v; }\n";
    s = s + "static KVal kval_list(int64_t id) { KVal v; v.tag = KV_LIST; v.u.list_id = id; return v; }\n";
    s = s + "static KVal kval_mem(int64_t id) { KVal v; v.tag = KV_MEM; v.u.i = id; return v; }\n";
    s = s + "static KVal kval_tensor(int64_t id) { KVal v; v.tag = KV_TENSOR; v.u.i = id; return v; }\n";
    s = s + "static int64_t kval_as_i64(KVal v) {\n";
    s = s + "  if (v.tag == KV_I64) return v.u.i;\n";
    s = s + "  if (v.tag == KV_F64) return (int64_t)v.u.f;\n";
    s = s + "  k_die(\"expected i64\"); return 0;\n}\n";
    s = s + "static double kval_as_f64(KVal v) {\n";
    s = s + "  if (v.tag == KV_F64) return v.u.f;\n";
    s = s + "  if (v.tag == KV_I64) return (double)v.u.i;\n";
    s = s + "  k_die(\"expected f64\"); return 0;\n}\n";
    s = s + "static const char *kval_as_str(KVal v) { if (v.tag != KV_STR) k_die(\"expected str\"); return v.u.s ? v.u.s : \"\"; }\n";
    s = s + "static int64_t kval_as_list(KVal v) { if (v.tag != KV_LIST) k_die(\"expected list\"); return v.u.list_id; }\n";
    s = s + "static KListObj *klist_obj(int64_t id) {\n";
    s = s + "  if (id < 0 || (size_t)id >= g_lists_len) k_die(\"bad list\"); return &g_lists[id];\n}\n";
    s = s + "static int64_t klist_new(void) {\n";
    s = s + "  if (g_lists_len + 1 > g_lists_cap) {\n";
    s = s + "    size_t ncap = g_lists_cap ? g_lists_cap * 2 : 8;\n";
    s = s + "    KListObj *nd = (KListObj *)realloc(g_lists, ncap * sizeof(KListObj));\n";
    s = s + "    if (!nd) k_die(\"oom\"); g_lists = nd; g_lists_cap = ncap;\n";
    s = s + "  }\n";
    s = s + "  KListObj *o = &g_lists[g_lists_len]; o->data = NULL; o->len = 0; o->cap = 0;\n";
    s = s + "  return (int64_t)g_lists_len++;\n}\n";
    s = s + "static void klist_push_val(int64_t id, KVal v) {\n";
    s = s + "  KListObj *l = klist_obj(id);\n";
    s = s + "  if (l->len + 1 > l->cap) {\n";
    s = s + "    size_t ncap = l->cap ? l->cap * 2 : 8;\n";
    s = s + "    KVal *nd = (KVal *)realloc(l->data, ncap * sizeof(KVal));\n";
    s = s + "    if (!nd) k_die(\"oom\"); l->data = nd; l->cap = ncap;\n";
    s = s + "  }\n";
    s = s + "  l->data[l->len++] = v;\n}\n";
    s = s + "static KVal klist_get_val(int64_t id, int64_t i) {\n";
    s = s + "  KListObj *l = klist_obj(id);\n";
    s = s + "  if (i < 0 || (size_t)i >= l->len) k_die(\"index oob\"); return l->data[i];\n}\n";
    s = s + "static void klist_set_val(int64_t id, int64_t i, KVal v) {\n";
    s = s + "  KListObj *l = klist_obj(id);\n";
    s = s + "  if (i < 0 || (size_t)i >= l->len) k_die(\"index oob\"); l->data[i] = v;\n}\n";
    s = s + "static int64_t klist_len(int64_t id) { return (int64_t)klist_obj(id)->len; }\n";
    s = s + "static int64_t klist_push_ret(int64_t id, KVal v) { klist_push_val(id, v); return id; }\n";
    s = s + "static const char *kstr_concat(const char *a, const char *b) {\n";
    s = s + "  if (!a) a = \"\"; if (!b) b = \"\";\n";
    s = s + "  size_t na = strlen(a), nb = strlen(b);\n";
    s = s + "  char *o = (char *)malloc(na + nb + 1); if (!o) k_die(\"oom\");\n";
    s = s + "  memcpy(o, a, na); memcpy(o + na, b, nb); o[na + nb] = 0; return o;\n}\n";
    s = s + "static KVal kstr_index_val(const char *s, int64_t i) {\n";
    s = s + "  if (!s) k_die(\"str null\"); size_t n = strlen(s);\n";
    s = s + "  if (i < 0 || (size_t)i >= n) k_die(\"str oob\");\n";
    s = s + "  char *o = (char *)malloc(2); if (!o) k_die(\"oom\"); o[0] = s[i]; o[1] = 0; return kval_str(o);\n}\n";
    s = s + "static KVal kval_index(KVal v, int64_t i) {\n";
    s = s + "  if (v.tag == KV_LIST) return klist_get_val(v.u.list_id, i);\n";
    s = s + "  if (v.tag == KV_STR) return kstr_index_val(v.u.s, i);\n";
    s = s + "  k_die(\"index\"); return kval_i64(0);\n}\n";
    s = s + "static int64_t kval_len(KVal v) {\n";
    s = s + "  if (v.tag == KV_LIST) return klist_len(v.u.list_id);\n";
    s = s + "  if (v.tag == KV_STR) return (int64_t)strlen(v.u.s ? v.u.s : \"\");\n";
    s = s + "  k_die(\"len\"); return 0;\n}\n";
    s = s + "static int64_t kval_eq(KVal a, KVal b) {\n";
    s = s + "  if (a.tag != b.tag) {\n";
    s = s + "    if ((a.tag == KV_I64 || a.tag == KV_F64) && (b.tag == KV_I64 || b.tag == KV_F64))\n";
    s = s + "      return kval_as_f64(a) == kval_as_f64(b);\n";
    s = s + "    return 0;\n";
    s = s + "  }\n";
    s = s + "  if (a.tag == KV_I64) return a.u.i == b.u.i;\n";
    s = s + "  if (a.tag == KV_F64) return a.u.f == b.u.f;\n";
    s = s + "  if (a.tag == KV_STR) return strcmp(a.u.s ? a.u.s : \"\", b.u.s ? b.u.s : \"\") == 0;\n";
    s = s + "  if (a.tag == KV_LIST) return a.u.list_id == b.u.list_id;\n";
    s = s + "  if (a.tag == KV_MEM) return a.u.i == b.u.i;\n";
    s = s + "  if (a.tag == KV_TENSOR) return a.u.i == b.u.i;\n";
    s = s + "  return 0;\n}\n";
    s = s + "static void kenga_print_val(KVal v);\n";
    s = s + "static void kenga_print_val(KVal v) {\n";
    s = s + "  if (v.tag == KV_I64) printf(\"%lld\", (long long)v.u.i);\n";
    s = s + "  else if (v.tag == KV_F64) printf(\"%g\", v.u.f);\n";
    s = s + "  else if (v.tag == KV_STR) printf(\"%s\", v.u.s ? v.u.s : \"\");\n";
    s = s + "  else if (v.tag == KV_LIST) {\n";
    s = s + "    KListObj *l = klist_obj(v.u.list_id); size_t i; putchar('[');\n";
    s = s + "    for (i = 0; i < l->len; i++) { if (i) printf(\", \"); kenga_print_val(l->data[i]); }\n";
    s = s + "    putchar(']');\n";
    s = s + "  } else if (v.tag == KV_MEM) printf(\"memory\");\n";
    s = s + "  else if (v.tag == KV_TENSOR) printf(\"tensor\");\n";
    s = s + "  else k_die(\"tag\");\n}\n";
    s = s + "static void kenga_println_val(KVal v) { kenga_print_val(v); putchar('\\n'); }\n";
    s = s + "static void k_assert(int64_t c) { if (!c) k_die(\"assert failed\"); }\n";
    s = s + "static int64_t k_ord(const char *s) { if (!s || !s[0]) return 0; return (unsigned char)s[0]; }\n";
    s = s + "static int64_t k_round(double x) { return (int64_t)llround(x); }\n";
    s = s + "static const char *k_read_file(const char *path) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\"); if (!f) k_die(\"read_file\");\n";
    s = s + "  if (fseek(f, 0, SEEK_END) != 0) k_die(\"seek\"); long n = ftell(f); if (n < 0) k_die(\"ftell\");\n";
    s = s + "  if (fseek(f, 0, SEEK_SET) != 0) k_die(\"seek\");\n";
    s = s + "  char *buf = (char *)malloc((size_t)n + 1); if (!buf) k_die(\"oom\");\n";
    s = s + "  if (n && fread(buf, 1, (size_t)n, f) != (size_t)n) k_die(\"fread\");\n";
    s = s + "  buf[n] = 0; fclose(f); return buf;\n}\n";
    s = s + "static int64_t k_write_file(const char *path, const char *data) {\n";
    s = s + "  FILE *f = fopen(path, \"wb\"); if (!f) return 0;\n";
    s = s + "  size_t n = data ? strlen(data) : 0;\n";
    s = s + "  if (n && fwrite(data, 1, n, f) != n) { fclose(f); return 0; }\n";
    s = s + "  fclose(f); return 1;\n}\n\n";
    // events
    s = s + "typedef void (*KeHandler)(KVal);\n";
    s = s + "typedef struct { const char *name; KeHandler fn; int arity; } KeBind;\n";
    s = s + "static KeBind g_binds[64]; static int g_nbinds = 0;\n";
    s = s + "#define KE_QMAX 256\n";
    s = s + "static const char *g_qev[KE_QMAX]; static KVal g_qval[KE_QMAX]; static int g_qn = 0;\n";
    s = s + "static void ke_listen(const char *name, KeHandler fn, int arity) {\n";
    s = s + "  g_binds[g_nbinds].name = name; g_binds[g_nbinds].fn = fn; g_binds[g_nbinds].arity = arity; g_nbinds++;\n}\n";
    s = s + "static int64_t ke_emit(const char *e, KVal v) {\n";
    s = s + "  if (g_qn >= KE_QMAX) k_die(\"event overflow\");\n";
    s = s + "  g_qev[g_qn] = e; g_qval[g_qn] = v; g_qn++; return 0;\n}\n";
    s = s + "static int64_t ke_pending(void) { return (int64_t)g_qn; }\n";
    s = s + "static int64_t ke_pump(int64_t maxn) {\n";
    s = s + "  int64_t done = 0;\n";
    s = s + "  while (maxn > 0 && g_qn > 0) {\n";
    s = s + "    const char *e = g_qev[0]; KVal v = g_qval[0]; int i;\n";
    s = s + "    for (i = 1; i < g_qn; i++) { g_qev[i-1]=g_qev[i]; g_qval[i-1]=g_qval[i]; }\n";
    s = s + "    g_qn--; maxn--;\n";
    s = s + "    for (i = 0; i < g_nbinds; i++) {\n";
    s = s + "      if (strcmp(g_binds[i].name, e) == 0) {\n";
    s = s + "        if (g_binds[i].arity >= 1) g_binds[i].fn(v); else g_binds[i].fn(kval_i64(0));\n";
    s = s + "        done++; break;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  return done;\n}\n";
    s = s + "#endif /* KENGA_RT_KVAL_INC */\n";

    assert(write_file("bootstrap/generated/rt_kval.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_kval.inc.c");
    return 0;
}
