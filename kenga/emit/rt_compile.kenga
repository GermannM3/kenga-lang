// Emit compile_lite for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_compile.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_compile.kenga — do not hand-edit */\n";
    s = s + "static Program compile_lite(const char *src) {\n";
    s = s + "  size_t n = strlen(src);\n";
    s = s + "  stypes_reset();\n";
    s = s + "  g_loop_sp = -1;\n";
    s = s + "  g_tmpn = 0;\n";
    s = s + "  call_patches_reset();\n";
    s = s + "  StrA fnames = {0};\n";
    s = s + "  StrA fbodies = {0};\n";
    s = s + "  I64AA fparams = {0};\n";
    s = s + "  EvBind *binds = NULL;\n";
    s = s + "  size_t nbinds = 0, binds_cap = 0;\n";
    s = s + "  int on_serial = 0;\n";
    s = s + "  size_t i = 0;\n";
    s = s + "  while (1) {\n";
    s = s + "    i = skip(src, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (starts_kw(src, i, n, \"struct\")) {\n";
    s = s + "      i = skip(src, i + 6, n);\n";
    s = s + "      Ident id = parse_ident(src, i, n);\n";
    s = s + "      if (find_struct_type(id.name) >= 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"duplicate struct\");\n";
    s = s + "      }\n";
    s = s + "      i = skip(src, id.i, n);\n";
    s = s + "      if (i >= n || src[i] != '{') {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"expected { after struct name\");\n";
    s = s + "      }\n";
    s = s + "      i++;\n";
    s = s + "      StructType st;\n";
    s = s + "      st.name = id.name;\n";
    s = s + "      memset(&st.fields, 0, sizeof(st.fields));\n";
    s = s + "      i = skip(src, i, n);\n";
    s = s + "      if (i < n && src[i] != '}') {\n";
    s = s + "        for (;;) {\n";
    s = s + "          Ident fn = parse_ident(src, i, n);\n";
    s = s + "          if (field_index_of(&st, fn.name) >= 0) {\n";
    s = s + "            free(fn.name);\n";
    s = s + "            free(st.name);\n";
    s = s + "            stra_free(&st.fields);\n";
    s = s + "            die(\"duplicate struct field\");\n";
    s = s + "          }\n";
    s = s + "          stra_push(&st.fields, fn.name);\n";
    s = s + "          i = skip_type_annot(src, fn.i, n);\n";
    s = s + "          i = skip(src, i, n);\n";
    s = s + "          if (i < n && src[i] == ',') {\n";
    s = s + "            i++;\n";
    s = s + "            i = skip(src, i, n);\n";
    s = s + "            continue;\n";
    s = s + "          }\n";
    s = s + "          break;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      i = skip(src, i, n);\n";
    s = s + "      if (i >= n || src[i] != '}') {\n";
    s = s + "        free(st.name);\n";
    s = s + "        stra_free(&st.fields);\n";
    s = s + "        die(\"expected } after struct fields\");\n";
    s = s + "      }\n";
    s = s + "      i++;\n";
    s = s + "      if (g_nstypes + 1 > g_stypes_cap) {\n";
    s = s + "        g_stypes_cap = g_stypes_cap ? g_stypes_cap * 2 : 4;\n";
    s = s + "        g_stypes = (StructType *)xrealloc(g_stypes, g_stypes_cap * sizeof(StructType));\n";
    s = s + "      }\n";
    s = s + "      g_stypes[g_nstypes++] = st;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (starts_kw(src, i, n, \"on\")) {\n";
    s = s + "      char *evname;\n";
    s = s + "      char fname[64];\n";
    s = s + "      size_t start;\n";
    s = s + "      int depth;\n";
    s = s + "      int arity = 0;\n";
    s = s + "      StrA pnames = {0};\n";
    s = s + "      i = skip(src, i + 2, n);\n";
    s = s + "      if (i >= n || src[i] != '\"') die(\"expected event string after on\");\n";
    s = s + "      i++;\n";
    s = s + "      {\n";
    s = s + "        size_t a = i;\n";
    s = s + "        while (i < n && src[i] != '\"') {\n";
    s = s + "          if (src[i] == '\\\\' && i + 1 < n) i += 2;\n";
    s = s + "          else i++;\n";
    s = s + "        }\n";
    s = s + "        if (i >= n) die(\"unclosed event string\");\n";
    s = s + "        evname = slice_dup(src, a, i);\n";
    s = s + "        i++;\n";
    s = s + "      }\n";
    s = s + "      i = skip(src, i, n);\n";
    s = s + "      if (i >= n || src[i] != '(') {\n";
    s = s + "        free(evname);\n";
    s = s + "        die(\"expected ( after on event\");\n";
    s = s + "      }\n";
    s = s + "      i++;\n";
    s = s + "      i = skip(src, i, n);\n";
    s = s + "      if (i < n && src[i] != ')') {\n";
    s = s + "        for (;;) {\n";
    s = s + "          Ident pn = parse_ident(src, i, n);\n";
    s = s + "          stra_push(&pnames, pn.name);\n";
    s = s + "          i = skip_type_annot(src, pn.i, n);\n";
    s = s + "          i = skip(src, i, n);\n";
    s = s + "          if (i < n && src[i] == ',') {\n";
    s = s + "            i++;\n";
    s = s + "            continue;\n";
    s = s + "          }\n";
    s = s + "          break;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      if (i >= n || src[i] != ')') {\n";
    s = s + "        free(evname);\n";
    s = s + "        die(\"expected ) in on\");\n";
    s = s + "      }\n";
    s = s + "      i = skip(src, i + 1, n);\n";
    s = s + "      if (i >= n || src[i] != '{') {\n";
    s = s + "        free(evname);\n";
    s = s + "        die(\"expected { on body\");\n";
    s = s + "      }\n";
    s = s + "      depth = 0;\n";
    s = s + "      start = i;\n";
    s = s + "      i = match_brace_block(src, i, n);\n";
    s = s + "      (void)depth;\n";
    s = s + "      arity = (int)pnames.len;\n";
    s = s + "      snprintf(fname, sizeof fname, \"__on_%d\", on_serial++);\n";
    s = s + "      stra_push(&fnames, xstrdup(fname));\n";
    s = s + "      stra_push(&fbodies, slice_dup(src, start, i));\n";
    s = s + "      {\n";
    s = s + "        I64A argc_holder = {0};\n";
    s = s + "        i64a_push(&argc_holder, (int64_t)arity);\n";
    s = s + "        i64aa_push(&fparams, argc_holder);\n";
    s = s + "      }\n";
    s = s + "      {\n";
    s = s + "        size_t last = fbodies.len - 1;\n";
    s = s + "        size_t need = 1, pi;\n";
    s = s + "        char *hdr, *p;\n";
    s = s + "        for (pi = 0; pi < pnames.len; pi++) need += strlen(pnames.data[pi]) + 1;\n";
    s = s + "        hdr = (char *)malloc(need + strlen(fbodies.data[last]) + 1);\n";
    s = s + "        if (!hdr) die(\"oom\");\n";
    s = s + "        p = hdr;\n";
    s = s + "        for (pi = 0; pi < pnames.len; pi++) {\n";
    s = s + "          size_t L = strlen(pnames.data[pi]);\n";
    s = s + "          memcpy(p, pnames.data[pi], L);\n";
    s = s + "          p += L;\n";
    s = s + "          *p++ = (pi + 1 < pnames.len) ? ',' : '|';\n";
    s = s + "        }\n";
    s = s + "        if (pnames.len == 0) *p++ = '|';\n";
    s = s + "        strcpy(p, fbodies.data[last]);\n";
    s = s + "        free(fbodies.data[last]);\n";
    s = s + "        fbodies.data[last] = hdr;\n";
    s = s + "        for (pi = 0; pi < pnames.len; pi++) free(pnames.data[pi]);\n";
    s = s + "        free(pnames.data);\n";
    s = s + "      }\n";
    s = s + "      if (nbinds + 1 > binds_cap) {\n";
    s = s + "        binds_cap = binds_cap ? binds_cap * 2 : 4;\n";
    s = s + "        binds = (EvBind *)xrealloc(binds, binds_cap * sizeof(EvBind));\n";
    s = s + "      }\n";
    s = s + "      binds[nbinds].event = evname;\n";
    s = s + "      binds[nbinds].fn_index = (int64_t)(fnames.len - 1);\n";
    s = s + "      binds[nbinds].arity = arity;\n";
    s = s + "      nbinds++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    if (!starts_kw(src, i, n, \"fn\")) die(\"expected fn, on, or struct\");\n";
    s = s + "    i = skip(src, i + 2, n);\n";
    s = s + "    Ident id = parse_ident(src, i, n);\n";
    s = s + "    i = skip(src, id.i, n);\n";
    s = s + "    if (i >= n || src[i] != '(') die(\"expected (\");\n";
    s = s + "    i++;\n";
    s = s + "    I64A params = {0};\n";
    s = s + "    StrA pnames = {0};\n";
    s = s + "    i = skip(src, i, n);\n";
    s = s + "    if (i < n && src[i] != ')') {\n";
    s = s + "      for (;;) {\n";
    s = s + "        Ident pn = parse_ident(src, i, n);\n";
    s = s + "        stra_push(&pnames, pn.name);\n";
    s = s + "        i = skip_type_annot(src, pn.i, n);\n";
    s = s + "        i = skip(src, i, n);\n";
    s = s + "        if (i < n && src[i] == ',') {\n";
    s = s + "          i++;\n";
    s = s + "          continue;\n";
    s = s + "        }\n";
    s = s + "        break;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    if (i >= n || src[i] != ')') die(\"expected )\");\n";
    s = s + "    i = skip(src, i + 1, n);\n";
    s = s + "    if (starts_with(src, i, n, \"->\")) {\n";
    s = s + "      i = skip(src, i + 2, n);\n";
    s = s + "      Ident ty = parse_ident(src, i, n);\n";
    s = s + "      free(ty.name);\n";
    s = s + "      i = ty.i;\n";
    s = s + "    }\n";
    s = s + "    i = skip(src, i, n);\n";
    s = s + "    if (i >= n || src[i] != '{') die(\"expected { body\");\n";
    s = s + "    size_t start = i;\n";
    s = s + "    i = match_brace_block(src, i, n);\n";
    s = s + "    stra_push(&fnames, id.name);\n";
    s = s + "    stra_push(&fbodies, slice_dup(src, start, i));\n";
    s = s + "    I64A argc_holder = {0};\n";
    s = s + "    i64a_push(&argc_holder, (int64_t)pnames.len);\n";
    s = s + "    i64aa_push(&fparams, argc_holder);\n";
    s = s + "    (void)params;\n";
    s = s + "    {\n";
    s = s + "      size_t last = fbodies.len - 1;\n";
    s = s + "      size_t need = 1;\n";
    s = s + "      for (size_t pi = 0; pi < pnames.len; pi++) need += strlen(pnames.data[pi]) + 1;\n";
    s = s + "      char *hdr = (char *)malloc(need + strlen(fbodies.data[last]) + 1);\n";
    s = s + "      if (!hdr) die(\"oom\");\n";
    s = s + "      char *p = hdr;\n";
    s = s + "      for (size_t pi = 0; pi < pnames.len; pi++) {\n";
    s = s + "        size_t L = strlen(pnames.data[pi]);\n";
    s = s + "        memcpy(p, pnames.data[pi], L);\n";
    s = s + "        p += L;\n";
    s = s + "        *p++ = (pi + 1 < pnames.len) ? ',' : '|';\n";
    s = s + "      }\n";
    s = s + "      if (pnames.len == 0) *p++ = '|';\n";
    s = s + "      strcpy(p, fbodies.data[last]);\n";
    s = s + "      free(fbodies.data[last]);\n";
    s = s + "      fbodies.data[last] = hdr;\n";
    s = s + "      for (size_t pi = 0; pi < pnames.len; pi++) free(pnames.data[pi]);\n";
    s = s + "      free(pnames.data);\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  I64A fargc = {0};\n";
    s = s + "  for (size_t fi = 0; fi < fnames.len; fi++) {\n";
    s = s + "    i64a_push(&fargc, fparams.data[fi].data[0]);\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  Program prog = {0};\n";
    s = s + "  g_strtab = &prog.strs;\n";
    s = s + "  prog.stypes = g_stypes;\n";
    s = s + "  prog.nstypes = g_nstypes;\n";
    s = s + "  /* g_stypes stays aliased for emit_factor struct literals until cleanup */\n";
    s = s + "  I64A *code = &prog.code;\n";
    s = s + "  I64A faddrs = {0};\n";
    s = s + "  emit2(code, OP_JMP, 0);\n";
    s = s + "\n";
    s = s + "  for (size_t fi = 0; fi < fnames.len; fi++) {\n";
    s = s + "    i64a_push(&faddrs, (int64_t)code->len);\n";
    s = s + "    StrA vnames = {0};\n";
    s = s + "    char *enc = fbodies.data[fi];\n";
    s = s + "    char *bar = strchr(enc, '|');\n";
    s = s + "    if (!bar) die(\"internal: missing |\");\n";
    s = s + "    if (bar != enc) {\n";
    s = s + "      char *p = enc;\n";
    s = s + "      while (p < bar) {\n";
    s = s + "        char *comma = memchr(p, ',', (size_t)(bar - p));\n";
    s = s + "        size_t len = comma ? (size_t)(comma - p) : (size_t)(bar - p);\n";
    s = s + "        char *nm = (char *)malloc(len + 1);\n";
    s = s + "        if (!nm) die(\"oom\");\n";
    s = s + "        memcpy(nm, p, len);\n";
    s = s + "        nm[len] = 0;\n";
    s = s + "        stra_push(&vnames, nm);\n";
    s = s + "        if (!comma) break;\n";
    s = s + "        p = comma + 1;\n";
    s = s + "      }\n";
    s = s + "    }\n";
    s = s + "    const char *body = bar + 1;\n";
    s = s + "    emit_block(body, 0, strlen(body), code, &vnames, &fnames, &faddrs, &fargc);\n";
    s = s + "    i64a_push(code, OP_RET);\n";
    s = s + "    for (size_t vi = 0; vi < vnames.len; vi++) free(vnames.data[vi]);\n";
    s = s + "    free(vnames.data);\n";
    s = s + "  }\n";
    s = s + "  code->data[1] = (int64_t)code->len;\n";
    s = s + "  call_patches_apply(code, &faddrs);\n";
    s = s + "  call_patches_reset();\n";
    s = s + "\n";
    s = s + "  {\n";
    s = s + "    size_t bi, fi;\n";
    s = s + "    for (bi = 0; bi < nbinds; bi++) {\n";
    s = s + "      size_t fii = (size_t)binds[bi].fn_index;\n";
    s = s + "      if (fii >= faddrs.len) die(\"bad event handler index\");\n";
    s = s + "      binds[bi].fn_index = faddrs.data[fii]; /* now address */\n";
    s = s + "    }\n";
    s = s + "    prog.binds = binds;\n";
    s = s + "    prog.nbinds = nbinds;\n";
    s = s + "    prog.nfns = fnames.len;\n";
    s = s + "    prog.fns = (FnInfo *)malloc(prog.nfns * sizeof(FnInfo));\n";
    s = s + "    if (prog.nfns && !prog.fns) die(\"oom\");\n";
    s = s + "    for (fi = 0; fi < fnames.len; fi++) {\n";
    s = s + "      prog.fns[fi].name = xstrdup(fnames.data[fi]);\n";
    s = s + "      prog.fns[fi].addr = faddrs.data[fi];\n";
    s = s + "      prog.fns[fi].arity = (int)fargc.data[fi];\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "\n";
    s = s + "  int found = 0;\n";
    s = s + "  int64_t maddr = 0;\n";
    s = s + "  for (size_t mi = 0; mi < fnames.len; mi++) {\n";
    s = s + "    if (strcmp(fnames.data[mi], \"main\") == 0) {\n";
    s = s + "      found = 1;\n";
    s = s + "      maddr = faddrs.data[mi];\n";
    s = s + "      if (fargc.data[mi] != 0) die(\"main must take 0 args\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (!found) die(\"no main()\");\n";
    s = s + "  emit3(code, OP_CALL, maddr, 0);\n";
    s = s + "  i64a_push(code, OP_HALT);\n";
    s = s + "\n";
    s = s + "  for (size_t fi = 0; fi < fnames.len; fi++) {\n";
    s = s + "    free(fnames.data[fi]);\n";
    s = s + "    free(fbodies.data[fi]);\n";
    s = s + "    i64a_free(&fparams.data[fi]);\n";
    s = s + "  }\n";
    s = s + "  free(fnames.data);\n";
    s = s + "  free(fbodies.data);\n";
    s = s + "  free(fparams.data);\n";
    s = s + "  i64a_free(&fargc);\n";
    s = s + "  i64a_free(&faddrs);\n";
    s = s + "  g_strtab = NULL;\n";
    s = s + "  g_stypes = NULL;\n";
    s = s + "  g_nstypes = g_stypes_cap = 0;\n";
    s = s + "  return prog;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_compile.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_compile.inc.c");
    println("rt_compile ok");
    return 0;
}
