// Emit * / + - compare and { } walking for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_expr.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_expr.kenga — do not hand-edit */\n";
    s = s + "static size_t emit_term(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                       StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_factor(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '*') {\n";
    s = s + "      i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_MUL);\n";
    s = s + "    } else if (s[i] == '/') {\n";
    s = s + "      i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_DIV);\n";
    s = s + "    } else if (s[i] == '%') {\n";
    s = s + "      i = emit_factor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_MOD);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_sum(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                      StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_term(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '+') {\n";
    s = s + "      i = emit_term(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_ADD);\n";
    s = s + "    } else if (s[i] == '-') {\n";
    s = s + "      i = emit_term(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_SUB);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_shift(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                        StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_sum(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (starts_with(s, i, n, \"<<\")) {\n";
    s = s + "      i = emit_sum(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_SHL);\n";
    s = s + "    } else if (starts_with(s, i, n, \">>\")) {\n";
    s = s + "      i = emit_sum(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_SHR);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_rel(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                      StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_shift(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i >= n) return i;\n";
    s = s + "  if (starts_with(s, i, n, \"<=\")) {\n";
    s = s + "    i = emit_shift(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_LE); return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_with(s, i, n, \">=\")) {\n";
    s = s + "    i = emit_shift(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_GE); return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_with(s, i, n, \"==\")) {\n";
    s = s + "    i = emit_shift(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_EQ); return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_with(s, i, n, \"!=\")) {\n";
    s = s + "    i = emit_shift(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_NE); return i;\n";
    s = s + "  }\n";
    s = s + "  if (s[i] == '<') {\n";
    s = s + "    i = emit_shift(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_LT); return i;\n";
    s = s + "  }\n";
    s = s + "  if (s[i] == '>') {\n";
    s = s + "    i = emit_shift(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_GT); return i;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_bitand(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                         StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_rel(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '&' && (i + 1 >= n || s[i + 1] != '&')) {\n";
    s = s + "      i = emit_rel(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_BAND);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_bitxor(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                         StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_bitand(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '^') {\n";
    s = s + "      i = emit_bitand(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_BXOR);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_bitor(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                        StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_bitxor(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (s[i] == '|' && (i + 1 >= n || s[i + 1] != '|')) {\n";
    s = s + "      i = emit_bitxor(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_BOR);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_and(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                      StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_bitor(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (starts_with(s, i, n, \"&&\")) {\n";
    s = s + "      i = emit_bitor(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_AND);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_or(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                     StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = emit_and(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) break;\n";
    s = s + "    if (starts_with(s, i, n, \"||\")) {\n";
    s = s + "      i = emit_and(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      i64a_push(code, OP_OR);\n";
    s = s + "    } else break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_cmp(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                      StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  return emit_or(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "}\n";
    s = s + "static size_t emit_block(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                        StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i >= n || s[i] != '{') die(\"expected {\");\n";
    s = s + "  i++;\n";
    s = s + "  for (;;) {\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) die(\"unclosed block\");\n";
    s = s + "    if (s[i] == '}') return i + 1;\n";
    s = s + "    i = emit_stmt(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  }\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_expr.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_expr.inc.c");
    println("rt_expr ok");
    return 0;
}
