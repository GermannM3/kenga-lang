// Emit file + import loader for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_host.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_host.kenga — do not hand-edit */\n";
    s = s + "static char *read_file(const char *path) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\");\n";
    s = s + "  if (!f) {\n";
    s = s + "    fprintf(stderr, \"kenga-lite: cannot open %s\\n\", path);\n";
    s = s + "    exit(1);\n";
    s = s + "  }\n";
    s = s + "  fseek(f, 0, SEEK_END);\n";
    s = s + "  long sz = ftell(f);\n";
    s = s + "  fseek(f, 0, SEEK_SET);\n";
    s = s + "  if (sz < 0) die(\"ftell\");\n";
    s = s + "  char *buf = (char *)malloc((size_t)sz + 1);\n";
    s = s + "  if (!buf) die(\"oom\");\n";
    s = s + "  if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) die(\"fread\");\n";
    s = s + "  buf[sz] = 0;\n";
    s = s + "  fclose(f);\n";
    s = s + "  return buf;\n";
    s = s + "}\n\n";
    s = s + "static char *dirname_dup(const char *path) {\n";
    s = s + "  size_t n = strlen(path);\n";
    s = s + "  size_t slash = n;\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    if (path[i] == '/' || path[i] == '\\\\') slash = i;\n";
    s = s + "  }\n";
    s = s + "  if (slash == n) return xstrdup(\".\");\n";
    s = s + "  char *d = (char *)malloc(slash + 1);\n";
    s = s + "  if (!d) die(\"oom\");\n";
    s = s + "  memcpy(d, path, slash);\n";
    s = s + "  d[slash] = 0;\n";
    s = s + "  return d;\n";
    s = s + "}\n\n";
    s = s + "static char *join_path(const char *dir, const char *rel) {\n";
    s = s + "  size_t nd = strlen(dir), nr = strlen(rel);\n";
    s = s + "  char *o = (char *)malloc(nd + nr + 2);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  memcpy(o, dir, nd);\n";
    s = s + "  o[nd] = '/';\n";
    s = s + "  memcpy(o + nd + 1, rel, nr + 1);\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static char *load_with_imports(const char *path, int depth);\n";
    s = s + "static const char *find_kenga_file(const char *fwd, const char *bwd) {\n";
    s = s + "  static char keep[8][512];\n";
    s = s + "  static int ki = 0;\n";
    s = s + "  FILE *tf;\n";
    s = s + "  char up[512];\n";
    s = s + "  const char *hit = NULL;\n";
    s = s + "  tf = fopen(fwd, \"rb\");\n";
    s = s + "  if (tf) { fclose(tf); return fwd; }\n";
    s = s + "  tf = fopen(bwd, \"rb\");\n";
    s = s + "  if (tf) { fclose(tf); return bwd; }\n";
    s = s + "  if (strlen(fwd) + 4 < sizeof(up)) {\n";
    s = s + "    snprintf(up, sizeof(up), \"../%s\", fwd);\n";
    s = s + "    tf = fopen(up, \"rb\");\n";
    s = s + "    if (tf) { fclose(tf); hit = up; }\n";
    s = s + "  }\n";
    s = s + "  if (!hit && strlen(bwd) + 4 < sizeof(up)) {\n";
    s = s + "    snprintf(up, sizeof(up), \"..\\\\%s\", bwd);\n";
    s = s + "    tf = fopen(up, \"rb\");\n";
    s = s + "    if (tf) { fclose(tf); hit = up; }\n";
    s = s + "  }\n";
    s = s + "  if (!hit) return NULL;\n";
    s = s + "  {\n";
    s = s + "    int slot = ki++ & 7;\n";
    s = s + "    size_t n = strlen(hit);\n";
    s = s + "    if (n > 511) n = 511;\n";
    s = s + "    memcpy(keep[slot], hit, n);\n";
    s = s + "    keep[slot][n] = 0;\n";
    s = s + "    return keep[slot];\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "static const char *find_ml_host(void) {\n";
    s = s + "  return find_kenga_file(\"kenga/compiler/ml_host.kenga\", \"kenga\\\\compiler\\\\ml_host.kenga\");\n";
    s = s + "}\n";
    s = s + "static const char *find_more_path(void) {\n";
    s = s + "  return find_kenga_file(\"kenga/compiler/more.kenga\", \"kenga\\\\compiler\\\\more.kenga\");\n";
    s = s + "}\n";
    s = s + "static int is_host_kenga(const char *path) {\n";
    s = s + "  if (!path) return 0;\n";
    s = s + "  if (strstr(path, \"kenga/emit/\") || strstr(path, \"kenga\\\\emit\\\\\")) return 1;\n";
    s = s + "  if (strstr(path, \"kenga/compiler/more.kenga\") || strstr(path, \"kenga\\\\compiler\\\\more.kenga\")) return 1;\n";
    s = s + "  if (strstr(path, \"kenga/compiler/native_ml.kenga\") || strstr(path, \"kenga\\\\compiler\\\\native_ml.kenga\")) return 1;\n";
    s = s + "  if (strstr(path, \"kenga/compiler/ml_host.kenga\") || strstr(path, \"kenga\\\\compiler\\\\ml_host.kenga\")) return 1;\n";
    s = s + "  if (strstr(path, \"kenga/compiler/chat.kenga\") || strstr(path, \"kenga\\\\compiler\\\\chat.kenga\")) return 1;\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "static int src_mentions_ml(const char *s) {\n";
    s = s + "  if (!s) return 0;\n";
    s = s + "  return strstr(s, \"t_from\") || strstr(s, \"t_matmul\") || strstr(s, \"t_get\") ||\n";
    s = s + "         strstr(s, \"ag_clear\") || strstr(s, \"ag_param\") || strstr(s, \"memory_config\") ||\n";
    s = s + "         strstr(s, \"load_ppm\") || strstr(s, \"load_wav\") || strstr(s, \"save_tensor\") ||\n";
    s = s + "         strstr(s, \"learn(\") || strstr(s, \"foresee\") || strstr(s, \"remember\") ||\n";
    s = s + "         strstr(s, \"t_mean\") || strstr(s, \"t_softmax\") || strstr(s, \"tensor(\");\n";
    s = s + "}\n";
    s = s + "static char *inject_ml_src(const char *src) {\n";
    s = s + "  const char *hp;\n";
    s = s + "  char *host;\n";
    s = s + "  char *mix;\n";
    s = s + "  size_t hl;\n";
    s = s + "  size_t ol;\n";
    s = s + "  if (!src) return xstrdup(\"\");\n";
    s = s + "  if (strstr(src, \"fn nt_from(\")) return xstrdup(src);\n";
    s = s + "  hp = find_ml_host();\n";
    s = s + "  if (!hp) return xstrdup(src);\n";
    s = s + "  host = load_with_imports(hp, 1);\n";
    s = s + "  hl = strlen(host);\n";
    s = s + "  ol = strlen(src);\n";
    s = s + "  mix = (char *)malloc(hl + ol + 2);\n";
    s = s + "  if (!mix) die(\"oom\");\n";
    s = s + "  memcpy(mix, host, hl);\n";
    s = s + "  mix[hl] = '\\n';\n";
    s = s + "  memcpy(mix + hl + 1, src, ol + 1);\n";
    s = s + "  free(host);\n";
    s = s + "  return mix;\n";
    s = s + "}\n";
    s = s + "static char *load_with_imports(const char *path, int depth) {\n";
    s = s + "  if (depth > 32) die(\"import nest too deep\");\n";
    s = s + "  char *src = read_file(path);\n";
    s = s + "  char *dir = dirname_dup(path);\n";
    s = s + "  size_t n = strlen(src);\n";
    s = s + "  size_t i = 0;\n";
    s = s + "  char *acc = xstrdup(\"\");\n";
    s = s + "  size_t acc_len = 0;\n";
    s = s + "  while (1) {\n";
    s = s + "    i = skip(src, i, n);\n";
    s = s + "    if (!starts_kw(src, i, n, \"import\")) break;\n";
    s = s + "    i = skip(src, i + 6, n);\n";
    s = s + "    if (i >= n || src[i] != '\"') die(\"expected string after import\");\n";
    s = s + "    size_t ii = i;\n";
    s = s + "    char *spec = parse_string(src, &ii, n);\n";
    s = s + "    i = skip(src, ii, n);\n";
    s = s + "    if (i < n && src[i] == ';') i++;\n";
    s = s + "    char *dep_path = join_path(dir, spec);\n";
    s = s + "    free(spec);\n";
    s = s + "    char *dep = load_with_imports(dep_path, depth + 1);\n";
    s = s + "    free(dep_path);\n";
    s = s + "    size_t dep_len = strlen(dep);\n";
    s = s + "    char *nacc = (char *)malloc(acc_len + dep_len + 2);\n";
    s = s + "    if (!nacc) die(\"oom\");\n";
    s = s + "    memcpy(nacc, acc, acc_len);\n";
    s = s + "    memcpy(nacc + acc_len, dep, dep_len);\n";
    s = s + "    nacc[acc_len + dep_len] = '\\n';\n";
    s = s + "    nacc[acc_len + dep_len + 1] = 0;\n";
    s = s + "    free(acc);\n";
    s = s + "    free(dep);\n";
    s = s + "    acc = nacc;\n";
    s = s + "    acc_len += dep_len + 1;\n";
    s = s + "  }\n";
    s = s + "  size_t rest = n - i;\n";
    s = s + "  char *out = (char *)malloc(acc_len + rest + 1);\n";
    s = s + "  if (!out) die(\"oom\");\n";
    s = s + "  memcpy(out, acc, acc_len);\n";
    s = s + "  memcpy(out + acc_len, src + i, rest);\n";
    s = s + "  out[acc_len + rest] = 0;\n";
    s = s + "  free(acc);\n";
    s = s + "  free(src);\n";
    s = s + "  free(dir);\n";
    s = s + "  if (depth == 0 && strstr(path, \"native_ml.kenga\") == NULL &&\n";
    s = s + "      strstr(path, \"ml_host.kenga\") == NULL && strstr(out, \"fn nt_from(\") == NULL) {\n";
    s = s + "    char *mix = inject_ml_src(out);\n";
    s = s + "    free(out);\n";
    s = s + "    out = mix;\n";
    s = s + "  }\n";
    s = s + "  return out;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_host.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_host.inc.c");
    println("rt_host ok");
    return 0;
}
