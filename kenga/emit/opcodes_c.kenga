// Emit opcode enum shared by more.kenga dialect (no Rust).
// → bootstrap/generated/opcodes.inc.c
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\opcodes_c.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/opcodes_c.kenga — more.kenga dialect opcodes */\n";
    s = s + "#ifndef KENGA_OPCODES_INC\n#define KENGA_OPCODES_INC\n";
    s = s + "enum {\n";
    s = s + "  OP_CONST = 1,\n";
    s = s + "  OP_LOAD = 2,\n";
    s = s + "  OP_STORE = 3,\n";
    s = s + "  OP_ADD = 4,\n";
    s = s + "  OP_SUB = 5,\n";
    s = s + "  OP_MUL = 6,\n";
    s = s + "  OP_DIV = 7,\n";
    s = s + "  OP_LT = 8,\n";
    s = s + "  OP_GT = 9,\n";
    s = s + "  OP_EQ = 10,\n";
    s = s + "  OP_JMP = 11,\n";
    s = s + "  OP_JMPF = 12,\n";
    s = s + "  OP_HALT = 13,\n";
    s = s + "  OP_LE = 14,\n";
    s = s + "  OP_CALL = 15,\n";
    s = s + "  OP_RET = 16,\n";
    s = s + "  OP_PRINTLN = 17,\n";
    s = s + "  OP_ASSERT = 18,\n";
    s = s + "  OP_ROUND = 19,\n";
    s = s + "  OP_POP = 20,\n";
    s = s + "  OP_LIST_NEW = 21,\n";
    s = s + "  OP_LIST_PUSH = 22,\n";
    s = s + "  OP_LEN = 23,\n";
    s = s + "  OP_GET = 24,\n";
    s = s + "  OP_NE = 25,\n";
    s = s + "  OP_GE = 26,\n";
    s = s + "  OP_ORD = 27,\n";
    s = s + "  OP_SET = 28,\n";
    s = s + "  OP_EMIT = 29,\n";
    s = s + "  OP_PUMP = 30,\n";
    s = s + "  OP_PENDING = 31,\n";
    s = s + "  OP_PRINT_STR = 32,\n";
    s = s + "  OP_CONST_F64 = 33,\n";
    s = s + "  OP_LIST_TAG = 34,\n";
    s = s + "  OP_CONST_STR = 35,\n";
    s = s + "  OP_READ_FILE = 36,\n";
    s = s + "  OP_WRITE_FILE = 37\n";
    s = s + "};\n";
    s = s + "#endif\n";
    assert(write_file("bootstrap/generated/opcodes.inc.c", s) == true);
    println("wrote bootstrap/generated/opcodes.inc.c");
    return 0;
}
