// Emit statements (let/if/for/println) for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_stmt.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_stmt.kenga — do not hand-edit */\n";
    s = s + "static char compound_op(const char *s, size_t j, size_t n) {\n";
    s = s + "  if (j + 1 >= n || s[j + 1] != '=') return 0;\n";
    s = s + "  if (s[j] == '+' || s[j] == '-' || s[j] == '*' || s[j] == '/') return s[j];\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "static void emit_compound_op(I64A *code, char op) {\n";
    s = s + "  if (op == '+') i64a_push(code, OP_ADD);\n";
    s = s + "  else if (op == '-') i64a_push(code, OP_SUB);\n";
    s = s + "  else if (op == '*') i64a_push(code, OP_MUL);\n";
    s = s + "  else i64a_push(code, OP_DIV);\n";
    s = s + "}\n";
    s = s + "/* Integer match: match <expr> { 0 => { ... } _ => { ... } } */\n";
    s = s + "static size_t emit_match(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                         StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  char mn[32];\n";
    s = s + "  int mslot;\n";
    s = s + "  I64A jmps = {0};\n";
    s = s + "  size_t ji;\n";
    s = s + "  i = emit_cmp(s, i + 5, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  snprintf(mn, sizeof mn, \"__m%d\", g_tmpn++);\n";
    s = s + "  mslot = slot_of(vnames, mn);\n";
    s = s + "  emit2(code, OP_STORE, mslot);\n";
    s = s + "  i64a_push(code, OP_POP);\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i >= n || s[i] != '{') die(\"expected { after match\");\n";
    s = s + "  i++;\n";
    s = s + "  for (;;) {\n";
    s = s + "    int wild = 0;\n";
    s = s + "    int64_t lit = 0;\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n) die(\"unclosed match\");\n";
    s = s + "    if (s[i] == '}') break;\n";
    s = s + "    if (starts_kw(s, i, n, \"_\")) {\n";
    s = s + "      wild = 1;\n";
    s = s + "      i = skip(s, i + 1, n);\n";
    s = s + "    } else if (is_ident_start(s[i])) {\n";
    s = s + "      Ident id = parse_ident(s, i, n);\n";
    s = s + "      Ident fld;\n";
    s = s + "      int tid;\n";
    s = s + "      int fidx;\n";
    s = s + "      i = skip(s, id.i, n);\n";
    s = s + "      if (i >= n || s[i] != '.' || (i + 1 < n && s[i + 1] == '.')) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"expected . after enum name in match\");\n";
    s = s + "      }\n";
    s = s + "      tid = find_struct_type(id.name);\n";
    s = s + "      if (tid < 0) {\n";
    s = s + "        free(id.name);\n";
    s = s + "        die(\"unknown enum in match\");\n";
    s = s + "      }\n";
    s = s + "      free(id.name);\n";
    s = s + "      fld = parse_ident(s, i + 1, n);\n";
    s = s + "      fidx = field_index_of(&g_stypes[tid], fld.name);\n";
    s = s + "      if (fidx < 0) {\n";
    s = s + "        free(fld.name);\n";
    s = s + "        die(\"unknown enum variant\");\n";
    s = s + "      }\n";
    s = s + "      lit = (int64_t)fidx;\n";
    s = s + "      free(fld.name);\n";
    s = s + "      i = skip(s, fld.i, n);\n";
    s = s + "    } else {\n";
    s = s + "      int neg = 0;\n";
    s = s + "      size_t ii;\n";
    s = s + "      ParsedNum num;\n";
    s = s + "      if (s[i] == '-') { neg = 1; i++; }\n";
    s = s + "      ii = i;\n";
    s = s + "      num = parse_number(s, &ii, n);\n";
    s = s + "      if (num.is_float) die(\"match arm must be integer\");\n";
    s = s + "      lit = num.i;\n";
    s = s + "      if (neg) lit = -lit;\n";
    s = s + "      i = skip(s, ii, n);\n";
    s = s + "    }\n";
    s = s + "    if (!starts_with(s, i, n, \"=>\")) die(\"expected =>\");\n";
    s = s + "    i = skip(s, i + 2, n);\n";
    s = s + "    if (!wild) {\n";
    s = s + "      size_t jmpf_at, jmp_at;\n";
    s = s + "      emit2(code, OP_LOAD, mslot);\n";
    s = s + "      emit2(code, OP_CONST, lit);\n";
    s = s + "      i64a_push(code, OP_EQ);\n";
    s = s + "      jmpf_at = code->len;\n";
    s = s + "      emit2(code, OP_JMPF, 0);\n";
    s = s + "      i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      jmp_at = code->len;\n";
    s = s + "      emit2(code, OP_JMP, 0);\n";
    s = s + "      i64a_push(&jmps, (int64_t)jmp_at);\n";
    s = s + "      code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "    } else {\n";
    s = s + "      i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    }\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] == ',') i++;\n";
    s = s + "    if (wild) {\n";
    s = s + "      i = skip(s, i, n);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (i >= n || s[i] != '}') die(\"expected } after match\");\n";
    s = s + "  i++;\n";
    s = s + "  for (ji = 0; ji < jmps.len; ji++)\n";
    s = s + "    code->data[jmps.data[ji] + 1] = (int64_t)code->len;\n";
    s = s + "  i64a_free(&jmps);\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    s = s + "static size_t emit_stmt(const char *s, size_t i, size_t n, I64A *code, StrA *vnames,\n";
    s = s + "                        StrA *fnames, I64A *faddrs, I64A *fargc) {\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (starts_kw(s, i, n, \"let\")) {\n";
    s = s + "    i = skip(s, i + 3, n);\n";
    s = s + "    Ident id = parse_ident(s, i, n);\n";
    s = s + "    i = skip_type_annot(s, id.i, n);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n || s[i] != '=') die(\"expected =\");\n";
    s = s + "    i = emit_cmp(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    int sl = slot_of(vnames, id.name);\n";
    s = s + "    free(id.name);\n";
    s = s + "    emit2(code, OP_STORE, sl);\n";
    s = s + "    i64a_push(code, OP_POP);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"return\")) {\n";
    s = s + "    i = emit_cmp(s, i + 6, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i64a_push(code, OP_RET);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"while\")) {\n";
    s = s + "    size_t loop_start = code->len;\n";
    s = s + "    i = emit_cmp(s, i + 5, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    size_t jmpf_at = code->len;\n";
    s = s + "    emit2(code, OP_JMPF, 0);\n";
    s = s + "    /* continue re-checks condition */\n";
    s = s + "    loop_push(loop_start);\n";
    s = s + "    i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    emit2(code, OP_JMP, (int64_t)loop_start);\n";
    s = s + "    code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "    loop_finish(code, code->len);\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"for\")) {\n";
    s = s + "    /* for name in start..end [step k] { }  |  for name in list { } */\n";
    s = s + "    i = skip(s, i + 3, n);\n";
    s = s + "    Ident var = parse_ident(s, i, n);\n";
    s = s + "    i = skip(s, var.i, n);\n";
    s = s + "    if (!starts_kw(s, i, n, \"in\")) {\n";
    s = s + "      free(var.name);\n";
    s = s + "      die(\"expected in after for variable\");\n";
    s = s + "    }\n";
    s = s + "    i = skip(s, i + 2, n);\n";
    s = s + "    int vslot = slot_of(vnames, var.name);\n";
    s = s + "    /* emit start or list expr */\n";
    s = s + "    i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (starts_with(s, i, n, \"..\")) {\n";
    s = s + "      /* range: for v in a..b */\n";
    s = s + "      emit2(code, OP_STORE, vslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      i = skip(s, i + 2, n);\n";
    s = s + "      char endn[32];\n";
    s = s + "      snprintf(endn, sizeof endn, \"__fe%d\", g_tmpn++);\n";
    s = s + "      int eslot = slot_of(vnames, endn);\n";
    s = s + "      i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      emit2(code, OP_STORE, eslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      i = skip(s, i, n);\n";
    s = s + "      char stepn[32];\n";
    s = s + "      snprintf(stepn, sizeof stepn, \"__fs%d\", g_tmpn++);\n";
    s = s + "      int sslot = slot_of(vnames, stepn);\n";
    s = s + "      if (starts_kw(s, i, n, \"step\")) {\n";
    s = s + "        i = skip(s, i + 4, n);\n";
    s = s + "        i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      } else {\n";
    s = s + "        emit2(code, OP_CONST, 1);\n";
    s = s + "      }\n";
    s = s + "      emit2(code, OP_STORE, sslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      size_t loop_start = code->len;\n";
    s = s + "      emit2(code, OP_LOAD, vslot);\n";
    s = s + "      emit2(code, OP_LOAD, eslot);\n";
    s = s + "      i64a_push(code, OP_LT);\n";
    s = s + "      size_t jmpf_at = code->len;\n";
    s = s + "      emit2(code, OP_JMPF, 0);\n";
    s = s + "      loop_push(0);\n";
    s = s + "      i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      size_t cont_at = code->len;\n";
    s = s + "      g_loops[g_loop_sp].cont_target = cont_at;\n";
    s = s + "      emit2(code, OP_LOAD, vslot);\n";
    s = s + "      emit2(code, OP_LOAD, sslot);\n";
    s = s + "      i64a_push(code, OP_ADD);\n";
    s = s + "      emit2(code, OP_STORE, vslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      emit2(code, OP_JMP, (int64_t)loop_start);\n";
    s = s + "      code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "      loop_finish(code, code->len);\n";
    s = s + "      free(var.name);\n";
    s = s + "      return i;\n";
    s = s + "    }\n";
    s = s + "    /* list iteration */\n";
    s = s + "    {\n";
    s = s + "      char ln[32], ix[32];\n";
    s = s + "      snprintf(ln, sizeof ln, \"__fl%d\", g_tmpn);\n";
    s = s + "      snprintf(ix, sizeof ix, \"__fi%d\", g_tmpn);\n";
    s = s + "      g_tmpn++;\n";
    s = s + "      int lslot = slot_of(vnames, ln);\n";
    s = s + "      int islot = slot_of(vnames, ix);\n";
    s = s + "      emit2(code, OP_STORE, lslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      emit2(code, OP_CONST, 0);\n";
    s = s + "      emit2(code, OP_STORE, islot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      size_t loop_start = code->len;\n";
    s = s + "      emit2(code, OP_LOAD, islot);\n";
    s = s + "      emit2(code, OP_LOAD, lslot);\n";
    s = s + "      i64a_push(code, OP_LEN);\n";
    s = s + "      i64a_push(code, OP_LT);\n";
    s = s + "      size_t jmpf_at = code->len;\n";
    s = s + "      emit2(code, OP_JMPF, 0);\n";
    s = s + "      emit2(code, OP_LOAD, lslot);\n";
    s = s + "      emit2(code, OP_LOAD, islot);\n";
    s = s + "      i64a_push(code, OP_GET);\n";
    s = s + "      emit2(code, OP_STORE, vslot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      loop_push(0);\n";
    s = s + "      i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      size_t cont_at = code->len;\n";
    s = s + "      g_loops[g_loop_sp].cont_target = cont_at;\n";
    s = s + "      emit2(code, OP_LOAD, islot);\n";
    s = s + "      emit2(code, OP_CONST, 1);\n";
    s = s + "      i64a_push(code, OP_ADD);\n";
    s = s + "      emit2(code, OP_STORE, islot);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      emit2(code, OP_JMP, (int64_t)loop_start);\n";
    s = s + "      code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "      loop_finish(code, code->len);\n";
    s = s + "      free(var.name);\n";
    s = s + "      return i;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"break\")) {\n";
    s = s + "    loop_add_break(code);\n";
    s = s + "    i = skip(s, i + 5, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"continue\")) {\n";
    s = s + "    loop_add_continue(code);\n";
    s = s + "    i = skip(s, i + 8, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"if\")) {\n";
    s = s + "    i = emit_cmp(s, i + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    size_t jmpf_at = code->len;\n";
    s = s + "    emit2(code, OP_JMPF, 0);\n";
    s = s + "    i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (starts_kw(s, i, n, \"else\")) {\n";
    s = s + "      size_t jmp_at = code->len;\n";
    s = s + "      emit2(code, OP_JMP, 0);\n";
    s = s + "      code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "      i = skip(s, i + 4, n);\n";
    s = s + "      if (starts_kw(s, i, n, \"if\")) {\n";
    s = s + "        i = emit_stmt(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      } else {\n";
    s = s + "        i = emit_block(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      }\n";
    s = s + "      code->data[jmp_at + 1] = (int64_t)code->len;\n";
    s = s + "    } else {\n";
    s = s + "      code->data[jmpf_at + 1] = (int64_t)code->len;\n";
    s = s + "    }\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"match\")) {\n";
    s = s + "    return emit_match(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"println\")) {\n";
    s = s + "    i = skip(s, i + 7, n);\n";
    s = s + "    if (i >= n || s[i] != '(') die(\"expected ( after println\");\n";
    s = s + "    i = emit_cmp(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n || s[i] != ')') die(\"expected ) after println\");\n";
    s = s + "    i++;\n";
    s = s + "    i64a_push(code, OP_PRINTLN);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (starts_kw(s, i, n, \"print\")) {\n";
    s = s + "    i = skip(s, i + 5, n);\n";
    s = s + "    if (i >= n || s[i] != '(') die(\"expected ( after print\");\n";
    s = s + "    i = emit_cmp(s, i + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i >= n || s[i] != ')') die(\"expected ) after print\");\n";
    s = s + "    i++;\n";
    s = s + "    i64a_push(code, OP_PRINT);\n";
    s = s + "    i = skip(s, i, n);\n";
    s = s + "    if (i < n && s[i] == ';') i++;\n";
    s = s + "    return i;\n";
    s = s + "  }\n";
    s = s + "  if (is_ident_start(s[i])) {\n";
    s = s + "    size_t save = i;\n";
    s = s + "    Ident id = parse_ident(s, i, n);\n";
    s = s + "    size_t j = skip(s, id.i, n);\n";
    s = s + "    /* xs[i] = v */\n";
    s = s + "    if (j < n && s[j] == '[') {\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_LOAD, sl);\n";
    s = s + "      j++;\n";
    s = s + "      j = emit_cmp(s, j, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      j = skip(s, j, n);\n";
    s = s + "      if (j >= n || s[j] != ']') die(\"expected ]\");\n";
    s = s + "      j = skip(s, j + 1, n);\n";
    s = s + "      if (j < n && s[j] == '=' && !(j + 1 < n && s[j + 1] == '=')) {\n";
    s = s + "        j = emit_cmp(s, j + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        i64a_push(code, OP_SET);\n";
    s = s + "        i64a_push(code, OP_POP);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j < n && s[j] == ';') j++;\n";
    s = s + "        return j;\n";
    s = s + "      }\n";
    s = s + "      {\n";
    s = s + "        char cop = compound_op(s, j, n);\n";
    s = s + "        if (cop) {\n";
    s = s + "          char ln[32], ix[32], vn[32];\n";
    s = s + "          int lslot, islot, rslot;\n";
    s = s + "          snprintf(ln, sizeof ln, \"__cl%d\", g_tmpn);\n";
    s = s + "          snprintf(ix, sizeof ix, \"__ci%d\", g_tmpn);\n";
    s = s + "          snprintf(vn, sizeof vn, \"__cv%d\", g_tmpn);\n";
    s = s + "          g_tmpn++;\n";
    s = s + "          lslot = slot_of(vnames, ln);\n";
    s = s + "          islot = slot_of(vnames, ix);\n";
    s = s + "          rslot = slot_of(vnames, vn);\n";
    s = s + "          emit2(code, OP_STORE, islot);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          emit2(code, OP_STORE, lslot);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          emit2(code, OP_LOAD, lslot);\n";
    s = s + "          emit2(code, OP_LOAD, islot);\n";
    s = s + "          i64a_push(code, OP_GET);\n";
    s = s + "          j = emit_cmp(s, j + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          emit_compound_op(code, cop);\n";
    s = s + "          emit2(code, OP_STORE, rslot);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          emit2(code, OP_LOAD, lslot);\n";
    s = s + "          emit2(code, OP_LOAD, islot);\n";
    s = s + "          emit2(code, OP_LOAD, rslot);\n";
    s = s + "          i64a_push(code, OP_SET);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (j < n && s[j] == ';') j++;\n";
    s = s + "          return j;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      /* not assignment — reparse as expression from save */\n";
    s = s + "      if (code->len >= 2) code->len -= 2;\n";
    s = s + "      i = save;\n";
    s = s + "      /* fall through to expression */\n";
    s = s + "    } else if (j < n && s[j] == '.') {\n";
    s = s + "      /* p.field = v — load, set field, store back */\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      j++;\n";
    s = s + "      Ident fld = parse_ident(s, j, n);\n";
    s = s + "      j = skip(s, fld.i, n);\n";
    s = s + "      if (j < n && s[j] == '=' && !(j + 1 < n && s[j + 1] == '=')) {\n";
    s = s + "        emit2(code, OP_LOAD, sl);\n";
    s = s + "        j = emit_cmp(s, j + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "        emit2(code, OP_SET_FIELD, intern_str(fld.name));\n";
    s = s + "        free(fld.name);\n";
    s = s + "        emit2(code, OP_STORE, sl);\n";
    s = s + "        i64a_push(code, OP_POP);\n";
    s = s + "        j = skip(s, j, n);\n";
    s = s + "        if (j < n && s[j] == ';') j++;\n";
    s = s + "        return j;\n";
    s = s + "      }\n";
    s = s + "      {\n";
    s = s + "        char cop = compound_op(s, j, n);\n";
    s = s + "        if (cop) {\n";
    s = s + "          char vn[32];\n";
    s = s + "          int fn, rslot;\n";
    s = s + "          snprintf(vn, sizeof vn, \"__cf%d\", g_tmpn++);\n";
    s = s + "          rslot = slot_of(vnames, vn);\n";
    s = s + "          fn = intern_str(fld.name);\n";
    s = s + "          free(fld.name);\n";
    s = s + "          emit2(code, OP_LOAD, sl);\n";
    s = s + "          emit2(code, OP_GET_FIELD, fn);\n";
    s = s + "          j = emit_cmp(s, j + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "          emit_compound_op(code, cop);\n";
    s = s + "          emit2(code, OP_STORE, rslot);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          emit2(code, OP_LOAD, sl);\n";
    s = s + "          emit2(code, OP_LOAD, rslot);\n";
    s = s + "          emit2(code, OP_SET_FIELD, fn);\n";
    s = s + "          emit2(code, OP_STORE, sl);\n";
    s = s + "          i64a_push(code, OP_POP);\n";
    s = s + "          j = skip(s, j, n);\n";
    s = s + "          if (j < n && s[j] == ';') j++;\n";
    s = s + "          return j;\n";
    s = s + "        }\n";
    s = s + "      }\n";
    s = s + "      free(fld.name);\n";
    s = s + "      i = save;\n";
    s = s + "    } else if (j < n && s[j] == '=' && !(j + 1 < n && s[j + 1] == '=')) {\n";
    s = s + "      j = emit_cmp(s, j + 1, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_STORE, sl);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      j = skip(s, j, n);\n";
    s = s + "      if (j < n && s[j] == ';') j++;\n";
    s = s + "      return j;\n";
    s = s + "    } else if (compound_op(s, j, n)) {\n";
    s = s + "      char cop = compound_op(s, j, n);\n";
    s = s + "      int sl = slot_of(vnames, id.name);\n";
    s = s + "      free(id.name);\n";
    s = s + "      emit2(code, OP_LOAD, sl);\n";
    s = s + "      j = emit_cmp(s, j + 2, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "      emit_compound_op(code, cop);\n";
    s = s + "      emit2(code, OP_STORE, sl);\n";
    s = s + "      i64a_push(code, OP_POP);\n";
    s = s + "      j = skip(s, j, n);\n";
    s = s + "      if (j < n && s[j] == ';') j++;\n";
    s = s + "      return j;\n";
    s = s + "    } else {\n";
    s = s + "      free(id.name);\n";
    s = s + "      i = save;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  i = emit_cmp(s, i, n, code, vnames, fnames, faddrs, fargc);\n";
    s = s + "  i = skip(s, i, n);\n";
    s = s + "  if (i < n && s[i] == ';') {\n";
    s = s + "    i++;\n";
    s = s + "    i64a_push(code, OP_POP); /* statement form; bare expr is implicit return */\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_stmt.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_stmt.inc.c");
    println("rt_stmt ok");
    return 0;
}
