// Emit intern + skip / keyword scan for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_lex.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_lex.kenga — do not hand-edit */\n";
    s = s + "static int intern_str(const char *s) {\n";
    s = s + "  size_t i;\n";
    s = s + "  if (!g_strtab) die(\"no strtab\");\n";
    s = s + "  for (i = 0; i < g_strtab->len; i++) {\n";
    s = s + "    if (strcmp(g_strtab->data[i], s) == 0) return (int)i;\n";
    s = s + "  }\n";
    s = s + "  stra_push(g_strtab, xstrdup(s));\n";
    s = s + "  return (int)g_strtab->len - 1;\n";
    s = s + "}\n\n";
    s = s + "static int starts_with(const char *s, size_t i, size_t n, const char *w) {\n";
    s = s + "  size_t wl = strlen(w);\n";
    s = s + "  if (i + wl > n) return 0;\n";
    s = s + "  return memcmp(s + i, w, wl) == 0;\n";
    s = s + "}\n\n";
    s = s + "static int is_ident_start(char c) {\n";
    s = s + "  return isalpha((unsigned char)c) || c == '_';\n";
    s = s + "}\n";
    s = s + "static int is_ident(char c) {\n";
    s = s + "  return isalnum((unsigned char)c) || c == '_';\n";
    s = s + "}\n\n";
    s = s + "static size_t skip(const char *s, size_t i, size_t n) {\n";
    s = s + "  while (i < n) {\n";
    s = s + "    if (isspace((unsigned char)s[i])) { i++; continue; }\n";
    s = s + "    if (s[i] == '/' && i + 1 < n && s[i + 1] == '/') {\n";
    s = s + "      i += 2;\n";
    s = s + "      while (i < n && s[i] != '\\n') i++;\n";
    s = s + "      continue;\n";
    s = s + "    }\n";
    s = s + "    break;\n";
    s = s + "  }\n";
    s = s + "  return i;\n";
    s = s + "}\n\n";
    s = s + "static int starts_kw(const char *s, size_t i, size_t n, const char *w) {\n";
    s = s + "  size_t wl = strlen(w);\n";
    s = s + "  if (!starts_with(s, i, n, w)) return 0;\n";
    s = s + "  if (i + wl < n && is_ident(s[i + wl])) return 0;\n";
    s = s + "  return 1;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_lex.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_lex.inc.c");
    println("rt_lex ok");
    return 0;
}
