// Emit dense f64 tensors on tagged KVal (no Rust, no lite VM).
// Writes bootstrap/generated/rt_kval_tensor.inc.c -- include after rt_kval.inc.c.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_kval_tensor.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_kval_tensor.kenga -- do not hand-edit */\n";
    s = s + "/* requires rt_kval.inc.c (KVal, k_die, lists) */\n";
    s = s + "#ifndef KENGA_RT_KVAL_TENSOR_INC\n#define KENGA_RT_KVAL_TENSOR_INC\n\n";
    s = s + "#define TL_ELEMS_MAX (1 << 20) /* 1M doubles safety cap */\n\n";
    s = s + "typedef struct {\n";
    s = s + "  int rank;\n";
    s = s + "  int shape[8];\n";
    s = s + "  int n;\n";
    s = s + "  double *data;\n";
    s = s + "} KvTensor;\n\n";
    s = s + "static KvTensor *g_ktensors = NULL;\n";
    s = s + "static size_t g_ktensors_len = 0;\n";
    s = s + "static size_t g_ktensors_cap = 0;\n\n";
    s = s + "static KvTensor *kt_obj(int64_t id) {\n";
    s = s + "  if (id < 0 || (size_t)id >= g_ktensors_len) k_die(\"bad tensor\");\n";
    s = s + "  return &g_ktensors[id];\n";
    s = s + "}\n\n";
    s = s + "static KvTensor *kt_get(KVal v) {\n";
    s = s + "  if (v.tag != KV_TENSOR) k_die(\"expected tensor\");\n";
    s = s + "  return kt_obj(v.u.i);\n";
    s = s + "}\n\n";
    s = s + "static int kt_product(const int *shape, int rank) {\n";
    s = s + "  int i, n = 1;\n";
    s = s + "  if (rank <= 0) return 0;\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (shape[i] < 0) k_die(\"negative tensor dim\");\n";
    s = s + "    if (shape[i] > 0 && n > TL_ELEMS_MAX / shape[i]) k_die(\"tensor too large\");\n";
    s = s + "    n *= shape[i];\n";
    s = s + "  }\n";
    s = s + "  return n;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_alloc(const int *shape, int rank, int zero) {\n";
    s = s + "  KvTensor t;\n";
    s = s + "  int i, n;\n";
    s = s + "  memset(&t, 0, sizeof(t));\n";
    s = s + "  if (rank < 0 || rank > 8) k_die(\"tensor rank out of range\");\n";
    s = s + "  t.rank = rank;\n";
    s = s + "  for (i = 0; i < rank; i++) t.shape[i] = shape[i];\n";
    s = s + "  n = kt_product(shape, rank);\n";
    s = s + "  t.n = n;\n";
    s = s + "  if (n > 0) {\n";
    s = s + "    t.data = (double *)malloc((size_t)n * sizeof(double));\n";
    s = s + "    if (!t.data) k_die(\"oom\");\n";
    s = s + "    if (zero) memset(t.data, 0, (size_t)n * sizeof(double));\n";
    s = s + "  }\n";
    s = s + "  if (g_ktensors_len + 1 > g_ktensors_cap) {\n";
    s = s + "    size_t ncap = g_ktensors_cap ? g_ktensors_cap * 2 : 8;\n";
    s = s + "    KvTensor *nd = (KvTensor *)realloc(g_ktensors, ncap * sizeof(KvTensor));\n";
    s = s + "    if (!nd) k_die(\"oom\");\n";
    s = s + "    g_ktensors = nd; g_ktensors_cap = ncap;\n";
    s = s + "  }\n";
    s = s + "  g_ktensors[g_ktensors_len] = t;\n";
    s = s + "  return (int64_t)g_ktensors_len++;\n";
    s = s + "}\n\n";
    s = s + "static int kval_list_to_i64s(KVal v, int64_t *out, int maxn) {\n";
    s = s + "  KListObj *l;\n";
    s = s + "  size_t i;\n";
    s = s + "  if (v.tag != KV_LIST) k_die(\"expected list\");\n";
    s = s + "  l = klist_obj(v.u.list_id);\n";
    s = s + "  if ((int)l->len > maxn) k_die(\"list too long\");\n";
    s = s + "  for (i = 0; i < l->len; i++) out[i] = kval_as_i64(l->data[i]);\n";
    s = s + "  return (int)l->len;\n";
    s = s + "}\n\n";
    s = s + "static int kval_list_to_f64s(KVal v, double *out, int maxn) {\n";
    s = s + "  KListObj *l;\n";
    s = s + "  size_t i;\n";
    s = s + "  if (v.tag != KV_LIST) k_die(\"expected list\");\n";
    s = s + "  l = klist_obj(v.u.list_id);\n";
    s = s + "  if ((int)l->len > maxn) k_die(\"list too long\");\n";
    s = s + "  for (i = 0; i < l->len; i++) out[i] = kval_as_f64(l->data[i]);\n";
    s = s + "  return (int)l->len;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_tensor(int64_t rows, int64_t cols) {\n";
    s = s + "  int shape[2];\n";
    s = s + "  if (rows < 0 || cols < 0) k_die(\"negative tensor dim\");\n";
    s = s + "  shape[0] = (int)rows;\n";
    s = s + "  shape[1] = (int)cols;\n";
    s = s + "  return kval_tensor(kt_alloc(shape, 2, 1));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_from(KVal shape, KVal data) {\n";
    s = s + "  int64_t dims[8];\n";
    s = s + "  int ishape[8];\n";
    s = s + "  int rank, n, i, got;\n";
    s = s + "  double *buf;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *t;\n";
    s = s + "  rank = kval_list_to_i64s(shape, dims, 8);\n";
    s = s + "  for (i = 0; i < rank; i++) ishape[i] = (int)dims[i];\n";
    s = s + "  n = kt_product(ishape, rank);\n";
    s = s + "  buf = n > 0 ? (double *)malloc((size_t)n * sizeof(double)) : NULL;\n";
    s = s + "  if (n > 0 && !buf) k_die(\"oom\");\n";
    s = s + "  got = kval_list_to_f64s(data, buf, n > 0 ? n : 0);\n";
    s = s + "  if (got != n) k_die(\"t_from data length mismatch\");\n";
    s = s + "  h = kt_alloc(ishape, rank, 0);\n";
    s = s + "  t = kt_obj(h);\n";
    s = s + "  if (n > 0) {\n";
    s = s + "    memcpy(t->data, buf, (size_t)n * sizeof(double));\n";
    s = s + "    free(buf);\n";
    s = s + "  }\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_fill(KVal t, KVal v) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  double x = kval_as_f64(v);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] = x;\n";
    s = s + "  return t;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_get(KVal t, KVal i) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t idx = kval_as_i64(i);\n";
    s = s + "  if (idx < 0 || idx >= (int64_t)o->n) k_die(\"t_get out of range\");\n";
    s = s + "  return kval_f64(o->data[idx]);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_shape(KVal t) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t id = klist_new();\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->rank; i++) klist_push_val(id, kval_i64((int64_t)o->shape[i]));\n";
    s = s + "  return kval_list(id);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_add(KVal a, KVal b) {\n";
    s = s + "  KvTensor *ta = kt_get(a), *tb = kt_get(b);\n";
    s = s + "  int i, n, rank, shape[8];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  if (ta->rank != tb->rank || ta->n != tb->n) k_die(\"tensor size mismatch\");\n";
    s = s + "  rank = ta->rank;\n";
    s = s + "  n = ta->n;\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (ta->shape[i] != tb->shape[i]) k_die(\"tensor shape mismatch\");\n";
    s = s + "    shape[i] = ta->shape[i];\n";
    s = s + "  }\n";
    s = s + "  ad = ta->data;\n";
    s = s + "  bd = tb->data;\n";
    s = s + "  h = kt_alloc(shape, rank, 0);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) o->data[i] = ad[i] + bd[i];\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_ew(KVal a, KVal b, int op) {\n";
    s = s + "  KvTensor *ta = kt_get(a), *tb = kt_get(b);\n";
    s = s + "  int i, n, rank, shape[8];\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  if (ta->rank != tb->rank || ta->n != tb->n) k_die(\"tensor size mismatch\");\n";
    s = s + "  rank = ta->rank; n = ta->n;\n";
    s = s + "  for (i = 0; i < rank; i++) {\n";
    s = s + "    if (ta->shape[i] != tb->shape[i]) k_die(\"tensor shape mismatch\");\n";
    s = s + "    shape[i] = ta->shape[i];\n";
    s = s + "  }\n";
    s = s + "  h = kt_alloc(shape, rank, 0);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    double x = ta->data[i], y = tb->data[i];\n";
    s = s + "    if (op == 1) o->data[i] = x - y;\n";
    s = s + "    else o->data[i] = x * y;\n";
    s = s + "  }\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n";
    s = s + "static KVal k_t_sub(KVal a, KVal b) { return k_t_ew(a, b, 1); }\n";
    s = s + "static KVal k_t_mul(KVal a, KVal b) { return k_t_ew(a, b, 2); }\n\n";
    s = s + "static KVal k_t_set(KVal t, KVal i, KVal v) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t idx = kval_as_i64(i);\n";
    s = s + "  if (idx < 0 || idx >= (int64_t)o->n) k_die(\"t_set out of range\");\n";
    s = s + "  o->data[idx] = kval_as_f64(v);\n";
    s = s + "  return t;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_transpose(KVal a) {\n";
    s = s + "  KvTensor *ta = kt_get(a);\n";
    s = s + "  int r, c, i, j, shape[2];\n";
    s = s + "  int64_t h; KvTensor *o;\n";
    s = s + "  if (ta->rank != 2) k_die(\"t_transpose expects rank-2\");\n";
    s = s + "  r = ta->shape[0]; c = ta->shape[1];\n";
    s = s + "  shape[0] = c; shape[1] = r;\n";
    s = s + "  h = kt_alloc(shape, 2, 1); o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < r; i++)\n";
    s = s + "    for (j = 0; j < c; j++) o->data[j * r + i] = ta->data[i * c + j];\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_reshape(KVal t, KVal sh) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t dims[8]; int ishape[8]; int rank, n, i; int64_t h; KvTensor *r;\n";
    s = s + "  rank = kval_list_to_i64s(sh, dims, 8);\n";
    s = s + "  for (i = 0; i < rank; i++) ishape[i] = (int)dims[i];\n";
    s = s + "  n = kt_product(ishape, rank);\n";
    s = s + "  if (n != o->n) k_die(\"t_reshape size mismatch\");\n";
    s = s + "  h = kt_alloc(ishape, rank, 0); r = kt_obj(h);\n";
    s = s + "  if (n > 0) memcpy(r->data, o->data, (size_t)n * sizeof(double));\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_scale(KVal t, KVal s) {\n";
    s = s + "  KvTensor *o = kt_get(t); double x = kval_as_f64(s);\n";
    s = s + "  int64_t h = kt_alloc(o->shape, o->rank, 0); KvTensor *r = kt_obj(h);\n";
    s = s + "  int i; for (i = 0; i < o->n; i++) r->data[i] = o->data[i] * x;\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_sum(KVal t) {\n";
    s = s + "  KvTensor *o = kt_get(t); double acc = 0.0; int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) acc += o->data[i];\n";
    s = s + "  return kval_f64(acc);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_dot(KVal a, KVal b) {\n";
    s = s + "  KvTensor *ta = kt_get(a), *tb = kt_get(b); double acc = 0.0; int i;\n";
    s = s + "  if (ta->n != tb->n) k_die(\"t_dot length mismatch\");\n";
    s = s + "  for (i = 0; i < ta->n; i++) acc += ta->data[i] * tb->data[i];\n";
    s = s + "  return kval_f64(acc);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_exp(KVal t) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t h = kt_alloc(o->shape, o->rank, 0); KvTensor *r = kt_obj(h);\n";
    s = s + "  int i; for (i = 0; i < o->n; i++) r->data[i] = exp(o->data[i]);\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_log(KVal t) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t h = kt_alloc(o->shape, o->rank, 0); KvTensor *r = kt_obj(h);\n";
    s = s + "  int i; for (i = 0; i < o->n; i++) {\n";
    s = s + "    double x = o->data[i]; if (x < 1e-12) x = 1e-12; r->data[i] = log(x);\n";
    s = s + "  }\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_softmax(KVal t) {\n";
    s = s + "  KvTensor *o = kt_get(t);\n";
    s = s + "  int64_t h = kt_alloc(o->shape, o->rank, 0); KvTensor *r = kt_obj(h);\n";
    s = s + "  double mx = -1e300, sum = 0.0; int i;\n";
    s = s + "  if (o->n < 1) return kval_tensor(h);\n";
    s = s + "  for (i = 0; i < o->n; i++) r->data[i] = o->data[i];\n";
    s = s + "  for (i = 0; i < r->n; i++) if (r->data[i] > mx) mx = r->data[i];\n";
    s = s + "  for (i = 0; i < r->n; i++) { r->data[i] = exp(r->data[i] - mx); sum += r->data[i]; }\n";
    s = s + "  if (sum < 1e-300) sum = 1e-300;\n";
    s = s + "  for (i = 0; i < r->n; i++) r->data[i] /= sum;\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_mse(KVal a, KVal b) {\n";
    s = s + "  KvTensor *ta = kt_get(a), *tb = kt_get(b); double acc = 0.0; int i, n;\n";
    s = s + "  if (ta->n != tb->n) k_die(\"t_mse size mismatch\");\n";
    s = s + "  n = ta->n > 0 ? ta->n : 1;\n";
    s = s + "  for (i = 0; i < ta->n; i++) { double d = ta->data[i] - tb->data[i]; acc += d * d; }\n";
    s = s + "  return kval_f64(acc / (double)n);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_mean(KVal t) {\n";
    s = s + "  KvTensor *a = kt_get(t);\n";
    s = s + "  if (a->rank == 3) {\n";
    s = s + "    int hh = a->shape[0], w = a->shape[1], c = a->shape[2];\n";
    s = s + "    double nn = (double)(hh * w); int shape[1]; int64_t oh; KvTensor *o;\n";
    s = s + "    int y, x, ch; shape[0] = c; oh = kt_alloc(shape, 1, 1); o = kt_obj(oh);\n";
    s = s + "    for (y = 0; y < hh; y++) for (x = 0; x < w; x++) for (ch = 0; ch < c; ch++)\n";
    s = s + "      o->data[ch] += a->data[(y * w + x) * c + ch];\n";
    s = s + "    for (ch = 0; ch < c; ch++) o->data[ch] /= nn > 0.0 ? nn : 1.0;\n";
    s = s + "    return kval_tensor(oh);\n";
    s = s + "  }\n";
    s = s + "  if (a->rank == 2) {\n";
    s = s + "    double acc = 0.0; int i, shape[1]; int64_t oh;\n";
    s = s + "    shape[0] = 1; for (i = 0; i < a->n; i++) acc += a->data[i];\n";
    s = s + "    oh = kt_alloc(shape, 1, 0); kt_obj(oh)->data[0] = acc / (a->n > 0 ? (double)a->n : 1.0);\n";
    s = s + "    return kval_tensor(oh);\n";
    s = s + "  }\n";
    s = s + "  { double acc = 0.0; int i; for (i = 0; i < a->n; i++) acc += a->data[i];\n";
    s = s + "    return kval_f64(acc / (a->n > 0 ? (double)a->n : 1.0)); }\n";
    s = s + "}\n\n";
    s = s + "static int k_save_tensor(KVal t, const char *path) {\n";
    s = s + "  KvTensor *o = kt_get(t); FILE *f = fopen(path, \"wb\"); int i;\n";
    s = s + "  if (!f) return 0;\n";
    s = s + "  fprintf(f, \"KENGA_TENSOR 1\\n%d\\n\", o->rank);\n";
    s = s + "  for (i = 0; i < o->rank; i++) { if (i) fputc(' ', f); fprintf(f, \"%d\", o->shape[i]); }\n";
    s = s + "  fputc('\\n', f);\n";
    s = s + "  for (i = 0; i < o->n; i++) { if (i) fputc(' ', f); fprintf(f, \"%.17g\", o->data[i]); }\n";
    s = s + "  fputc('\\n', f); fclose(f); return 1;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_load_tensor(const char *path) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\"); char magic[32]; int ver = 0, rank = 0, i, shape[8], n;\n";
    s = s + "  int64_t h; KvTensor *t;\n";
    s = s + "  if (!f) k_die(\"load_tensor: cannot open\");\n";
    s = s + "  if (fscanf(f, \"%31s %d\", magic, &ver) != 2 || strcmp(magic, \"KENGA_TENSOR\") != 0 || ver != 1) {\n";
    s = s + "    fclose(f); k_die(\"load_tensor: bad header\"); }\n";
    s = s + "  if (fscanf(f, \"%d\", &rank) != 1 || rank < 0 || rank > 8) { fclose(f); k_die(\"load_tensor: bad rank\"); }\n";
    s = s + "  for (i = 0; i < rank; i++) if (fscanf(f, \"%d\", &shape[i]) != 1) { fclose(f); k_die(\"load_tensor: bad shape\"); }\n";
    s = s + "  n = kt_product(shape, rank); h = kt_alloc(shape, rank, 0); t = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) if (fscanf(f, \"%lf\", &t->data[i]) != 1) { fclose(f); k_die(\"load_tensor: bad data\"); }\n";
    s = s + "  fclose(f); return kval_tensor(h);\n";
    s = s + "}\n\n";
    s = s + "static unsigned char *kt_read_bytes(const char *path, size_t *out_len) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\"); char alt[512]; long sz; unsigned char *buf;\n";
    s = s + "  if (!f && path[0] == '.' && path[1] == '.' && (path[2] == '/' || path[2] == '\\\\')) f = fopen(path + 3, \"rb\");\n";
    s = s + "  if (!f && strlen(path) + 4 < sizeof(alt)) {\n";
    s = s + "    alt[0] = '.'; alt[1] = '.'; alt[2] = '/'; memcpy(alt + 3, path, strlen(path) + 1); f = fopen(alt, \"rb\"); }\n";
    s = s + "  if (!f) return NULL;\n";
    s = s + "  if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }\n";
    s = s + "  sz = ftell(f); if (sz < 0) { fclose(f); return NULL; } rewind(f);\n";
    s = s + "  buf = (unsigned char *)malloc((size_t)sz + 1); if (!buf) { fclose(f); return NULL; }\n";
    s = s + "  if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) { free(buf); fclose(f); return NULL; }\n";
    s = s + "  fclose(f); if (out_len) *out_len = (size_t)sz; return buf;\n";
    s = s + "}\n\n";
    s = s + "static void kt_skip_ws(const unsigned char *b, size_t n, size_t *i) {\n";
    s = s + "  for (;;) {\n";
    s = s + "    while (*i < n && (b[*i] == ' ' || b[*i] == '\\t' || b[*i] == '\\r' || b[*i] == '\\n')) (*i)++;\n";
    s = s + "    if (*i < n && b[*i] == '#') { while (*i < n && b[*i] != '\\n') (*i)++; continue; }\n";
    s = s + "    break;\n";
    s = s + "  }\n";
    s = s + "}\n";
    s = s + "static int kt_read_token(const unsigned char *b, size_t n, size_t *i, char *out, size_t outcap) {\n";
    s = s + "  size_t start, len; kt_skip_ws(b, n, i); start = *i;\n";
    s = s + "  while (*i < n && b[*i] != ' ' && b[*i] != '\\t' && b[*i] != '\\r' && b[*i] != '\\n' && b[*i] != '#') (*i)++;\n";
    s = s + "  if (start == *i) return 0; len = *i - start; if (len + 1 > outcap) len = outcap - 1;\n";
    s = s + "  memcpy(out, b + start, len); out[len] = 0; return 1;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_load_ppm(const char *path) {\n";
    s = s + "  size_t n = 0, i = 0; unsigned char *b = kt_read_bytes(path, &n);\n";
    s = s + "  char tok[64]; int w, h, maxv, need, p, shape[3]; int64_t th; KvTensor *t;\n";
    s = s + "  if (!b) k_die(\"load_ppm: cannot read file\");\n";
    s = s + "  if (!kt_read_token(b, n, &i, tok, sizeof(tok)) || strcmp(tok, \"P6\") != 0) { free(b); k_die(\"load_ppm: only P6\"); }\n";
    s = s + "  if (!kt_read_token(b, n, &i, tok, sizeof(tok))) { free(b); k_die(\"load_ppm: bad width\"); }\n";
    s = s + "  w = atoi(tok);\n";
    s = s + "  if (!kt_read_token(b, n, &i, tok, sizeof(tok))) { free(b); k_die(\"load_ppm: bad height\"); }\n";
    s = s + "  h = atoi(tok);\n";
    s = s + "  if (!kt_read_token(b, n, &i, tok, sizeof(tok))) { free(b); k_die(\"load_ppm: bad maxval\"); }\n";
    s = s + "  maxv = atoi(tok);\n";
    s = s + "  if (w < 1 || h < 1 || maxv < 1) { free(b); k_die(\"load_ppm: bad header nums\"); }\n";
    s = s + "  if (i < n && (b[i] == ' ' || b[i] == '\\t' || b[i] == '\\r' || b[i] == '\\n')) i++;\n";
    s = s + "  need = w * h * 3; if (n < i + (size_t)need) { free(b); k_die(\"load_ppm: truncated\"); }\n";
    s = s + "  shape[0] = h; shape[1] = w; shape[2] = 3; th = kt_alloc(shape, 3, 0); t = kt_obj(th);\n";
    s = s + "  for (p = 0; p < need; p++) t->data[p] = (double)b[i + (size_t)p] / (double)maxv;\n";
    s = s + "  free(b); return kval_tensor(th);\n";
    s = s + "}\n\n";
    s = s + "static uint32_t kt_u32le(const unsigned char *p) {\n";
    s = s + "  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);\n";
    s = s + "}\n";
    s = s + "static uint16_t kt_u16le(const unsigned char *p) {\n";
    s = s + "  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_load_wav(const char *path) {\n";
    s = s + "  size_t n = 0, pos = 12; unsigned char *b = kt_read_bytes(path, &n);\n";
    s = s + "  uint16_t channels = 1, bits = 16; size_t data_off = 0, data_len = 0;\n";
    s = s + "  int samples, si, shape[1]; int64_t th; KvTensor *t;\n";
    s = s + "  if (!b) k_die(\"load_wav: cannot read file\");\n";
    s = s + "  if (n < 44 || memcmp(b, \"RIFF\", 4) != 0 || memcmp(b + 8, \"WAVE\", 4) != 0) { free(b); k_die(\"load_wav: not WAVE\"); }\n";
    s = s + "  while (pos + 8 <= n) {\n";
    s = s + "    unsigned char *id = b + pos; uint32_t size = kt_u32le(b + pos + 4); size_t chunk = pos + 8;\n";
    s = s + "    if (memcmp(id, \"fmt \", 4) == 0) {\n";
    s = s + "      if (size < 16 || chunk + 16 > n) { free(b); k_die(\"load_wav: bad fmt\"); }\n";
    s = s + "      if (kt_u16le(b + chunk) != 1) { free(b); k_die(\"load_wav: only PCM\"); }\n";
    s = s + "      channels = kt_u16le(b + chunk + 2); bits = kt_u16le(b + chunk + 14);\n";
    s = s + "    } else if (memcmp(id, \"data\", 4) == 0) { data_off = chunk; data_len = size; break; }\n";
    s = s + "    pos = chunk + size + (size % 2);\n";
    s = s + "  }\n";
    s = s + "  if (data_off == 0 || bits != 16) { free(b); k_die(\"load_wav: need 16-bit PCM\"); }\n";
    s = s + "  if (data_off + data_len > n) { free(b); k_die(\"load_wav: truncated\"); }\n";
    s = s + "  { int step = channels < 1 ? 1 : (int)channels;\n";
    s = s + "    samples = (int)(data_len / 2 / (size_t)step); if (samples < 1) samples = 0;\n";
    s = s + "    if (samples > TL_ELEMS_MAX) { free(b); k_die(\"load_wav: too many samples\"); }\n";
    s = s + "    shape[0] = samples; th = kt_alloc(shape, 1, 0); t = kt_obj(th);\n";
    s = s + "    for (si = 0; si < samples; si++) {\n";
    s = s + "      size_t off = data_off + (size_t)si * (size_t)step * 2;\n";
    s = s + "      int16_t sample = (int16_t)kt_u16le(b + off);\n";
    s = s + "      t->data[si] = (double)sample / 32768.0;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  free(b); return kval_tensor(th);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_matmul(KVal a, KVal b);\n";
    s = s + "static KVal k_t_linear_grad(KVal w, KVal x, KVal y) {\n";
    s = s + "  KVal pred = k_t_matmul(w, x);\n";
    s = s + "  KVal err = k_t_sub(pred, y);\n";
    s = s + "  return k_t_matmul(err, k_t_transpose(x));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_t_patch_mean(KVal t, KVal ghh, KVal gww) {\n";
    s = s + "  KvTensor *a = kt_get(t); int gh = (int)kval_as_i64(ghh), gw = (int)kval_as_i64(gww);\n";
    s = s + "  int h, w, c, ph, pw, gy, gx, ch, y, x, oshape[3]; int64_t oh; KvTensor *o;\n";
    s = s + "  if (gh <= 0 || gw <= 0) k_die(\"t_patch_mean grid must be > 0\");\n";
    s = s + "  if (a->rank != 3) k_die(\"t_patch_mean expects Tensor [h,w,c]\");\n";
    s = s + "  h = a->shape[0]; w = a->shape[1]; c = a->shape[2]; ph = h / gh; pw = w / gw;\n";
    s = s + "  if (ph == 0 || pw == 0) k_die(\"t_patch_mean: image smaller than grid\");\n";
    s = s + "  oshape[0] = gh; oshape[1] = gw; oshape[2] = c; oh = kt_alloc(oshape, 3, 1); o = kt_obj(oh);\n";
    s = s + "  for (gy = 0; gy < gh; gy++) for (gx = 0; gx < gw; gx++) for (ch = 0; ch < c; ch++) {\n";
    s = s + "    double acc = 0.0, nn = 0.0;\n";
    s = s + "    for (y = gy * ph; y < (gy + 1) * ph; y++) for (x = gx * pw; x < (gx + 1) * pw; x++) {\n";
    s = s + "      acc += a->data[(y * w + x) * c + ch]; nn += 1.0;\n";
    s = s + "    }\n";
    s = s + "    o->data[(gy * gw + gx) * c + ch] = acc / (nn > 0.0 ? nn : 1.0);\n";
    s = s + "  }\n";
    s = s + "  return kval_tensor(oh);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_save_tensor_v(KVal t, KVal path) { return kval_i64(k_save_tensor(t, kval_as_str(path))); }\n";
    s = s + "static KVal k_load_tensor_v(KVal path) { return k_load_tensor(kval_as_str(path)); }\n";
    s = s + "static KVal k_load_ppm_v(KVal path) { return k_load_ppm(kval_as_str(path)); }\n";
    s = s + "static KVal k_load_wav_v(KVal path) { return k_load_wav(kval_as_str(path)); }\n\n";
    s = s + "static KVal k_t_matmul(KVal a, KVal b) {\n";
    s = s + "  KvTensor *ta = kt_get(a), *tb = kt_get(b);\n";
    s = s + "  int m, k, k2, n, i, j, t;\n";
    s = s + "  int shape[2];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  if (ta->rank != 2 || tb->rank != 2) k_die(\"t_matmul expects rank-2\");\n";
    s = s + "  m = ta->shape[0];\n";
    s = s + "  k = ta->shape[1];\n";
    s = s + "  k2 = tb->shape[0];\n";
    s = s + "  n = tb->shape[1];\n";
    s = s + "  if (k != k2) k_die(\"t_matmul inner dim mismatch\");\n";
    s = s + "  ad = ta->data;\n";
    s = s + "  bd = tb->data;\n";
    s = s + "  shape[0] = m;\n";
    s = s + "  shape[1] = n;\n";
    s = s + "  h = kt_alloc(shape, 2, 1);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < m; i++)\n";
    s = s + "    for (j = 0; j < n; j++) {\n";
    s = s + "      double acc = 0.0;\n";
    s = s + "      for (t = 0; t < k; t++) acc += ad[i * k + t] * bd[t * n + j];\n";
    s = s + "      o->data[i * n + j] = acc;\n";
    s = s + "    }\n";
    s = s + "  return kval_tensor(h);\n";
    s = s + "}\n";
    s = s + "#endif /* KENGA_RT_KVAL_TENSOR_INC */\n";

    assert(write_file("bootstrap/generated/rt_kval_tensor.inc.c", s) == true);
    println("rt_kval_tensor ok");
    return 0;
}
