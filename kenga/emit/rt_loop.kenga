// Emit break/continue + forward-call patches for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_loop.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_loop.kenga — do not hand-edit */\n";
    s = s + "#define LOOP_MAX 16\n";
    s = s + "#define LOOP_PATCH 64\n";
    s = s + "typedef struct {\n";
    s = s + "  size_t cont_target;\n";
    s = s + "  size_t brk[LOOP_PATCH];\n";
    s = s + "  size_t nbrk;\n";
    s = s + "  size_t cont[LOOP_PATCH];\n";
    s = s + "  size_t ncont;\n";
    s = s + "} LoopFrame;\n";
    s = s + "static LoopFrame g_loops[LOOP_MAX];\n";
    s = s + "static int g_loop_sp = -1;\n";
    s = s + "static void loop_push(size_t cont_target) {\n";
    s = s + "  if (g_loop_sp + 1 >= LOOP_MAX) die(\"loop nesting too deep\");\n";
    s = s + "  g_loop_sp++;\n";
    s = s + "  g_loops[g_loop_sp].cont_target = cont_target;\n";
    s = s + "  g_loops[g_loop_sp].nbrk = 0;\n";
    s = s + "  g_loops[g_loop_sp].ncont = 0;\n";
    s = s + "}\n";
    s = s + "static void loop_add_break(I64A *code) {\n";
    s = s + "  if (g_loop_sp < 0) die(\"break outside loop\");\n";
    s = s + "  LoopFrame *f = &g_loops[g_loop_sp];\n";
    s = s + "  if (f->nbrk >= LOOP_PATCH) die(\"too many breaks\");\n";
    s = s + "  f->brk[f->nbrk++] = code->len;\n";
    s = s + "  emit2(code, OP_JMP, 0);\n";
    s = s + "}\n";
    s = s + "static void loop_add_continue(I64A *code) {\n";
    s = s + "  if (g_loop_sp < 0) die(\"continue outside loop\");\n";
    s = s + "  LoopFrame *f = &g_loops[g_loop_sp];\n";
    s = s + "  if (f->ncont >= LOOP_PATCH) die(\"too many continues\");\n";
    s = s + "  f->cont[f->ncont++] = code->len;\n";
    s = s + "  emit2(code, OP_JMP, 0);\n";
    s = s + "}\n";
    s = s + "static void loop_finish(I64A *code, size_t end_ip) {\n";
    s = s + "  LoopFrame *f = &g_loops[g_loop_sp];\n";
    s = s + "  size_t k;\n";
    s = s + "  for (k = 0; k < f->nbrk; k++) code->data[f->brk[k] + 1] = (int64_t)end_ip;\n";
    s = s + "  for (k = 0; k < f->ncont; k++)\n";
    s = s + "    code->data[f->cont[k] + 1] = (int64_t)f->cont_target;\n";
    s = s + "  g_loop_sp--;\n";
    s = s + "}\n";
    s = s + "typedef struct { size_t addr_at; size_t fn_i; } CallPatch;\n";
    s = s + "static CallPatch *g_call_patches;\n";
    s = s + "static size_t g_ncall_patches, g_call_patches_cap;\n";
    s = s + "static void call_patches_reset(void) {\n";
    s = s + "  free(g_call_patches);\n";
    s = s + "  g_call_patches = NULL;\n";
    s = s + "  g_ncall_patches = g_call_patches_cap = 0;\n";
    s = s + "}\n";
    s = s + "static void call_patch_add(size_t addr_at, size_t fn_i) {\n";
    s = s + "  if (g_ncall_patches + 1 > g_call_patches_cap) {\n";
    s = s + "    g_call_patches_cap = g_call_patches_cap ? g_call_patches_cap * 2 : 16;\n";
    s = s + "    g_call_patches = (CallPatch *)xrealloc(g_call_patches, g_call_patches_cap * sizeof(CallPatch));\n";
    s = s + "  }\n";
    s = s + "  g_call_patches[g_ncall_patches].addr_at = addr_at;\n";
    s = s + "  g_call_patches[g_ncall_patches].fn_i = fn_i;\n";
    s = s + "  g_ncall_patches++;\n";
    s = s + "}\n";
    s = s + "static void call_patches_apply(I64A *code, const I64A *faddrs) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < g_ncall_patches; i++) {\n";
    s = s + "    size_t fi = g_call_patches[i].fn_i;\n";
    s = s + "    if (fi >= faddrs->len) die(\"bad call patch\");\n";
    s = s + "    code->data[g_call_patches[i].addr_at] = faddrs->data[fi];\n";
    s = s + "  }\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_loop.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_loop.inc.c");
    println("rt_loop ok");
    return 0;
}
