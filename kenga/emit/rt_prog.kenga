// Emit Program teardown for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_prog.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_prog.kenga — do not hand-edit */\n";
    s = s + "static void program_free(Program *p) {\n";
    s = s + "  size_t i;\n";
    s = s + "  i64a_free(&p->code);\n";
    s = s + "  stra_free(&p->strs);\n";
    s = s + "  for (i = 0; i < p->nstypes; i++) {\n";
    s = s + "    free(p->stypes[i].name);\n";
    s = s + "    stra_free(&p->stypes[i].fields);\n";
    s = s + "  }\n";
    s = s + "  free(p->stypes); p->stypes = NULL; p->nstypes = 0;\n";
    s = s + "  for (i = 0; i < p->nbinds; i++) free(p->binds[i].event);\n";
    s = s + "  free(p->binds); p->binds = NULL; p->nbinds = 0;\n";
    s = s + "  for (i = 0; i < p->nfns; i++) free(p->fns[i].name);\n";
    s = s + "  free(p->fns); p->fns = NULL; p->nfns = 0;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_prog.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_prog.inc.c");
    println("rt_prog ok");
    return 0;
}
