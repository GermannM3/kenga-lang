// Emit getenv / HTTP / JSON / url_encode / html_text for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_net.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_net.kenga ? do not hand-edit */\n";
    s = s + "static char *k_getenv(const char *name) {\n";
    s = s + "  const char *v;\n";
    s = s + "  if (!name) return xstrdup(\"\");\n";
    s = s + "  v = getenv(name);\n";
    s = s + "  return xstrdup(v ? v : \"\");\n";
    s = s + "}\n\n";
    s = s + "static char *k_json_escape(const char *in) {\n";
    s = s + "  size_t n = 0, i, j;\n";
    s = s + "  char *o;\n";
    s = s + "  if (!in) in = \"\";\n";
    s = s + "  for (i = 0; in[i]; i++) {\n";
    s = s + "    unsigned char c = (unsigned char)in[i];\n";
    s = s + "    if (c == '\"' || c == '\\\\' || c == '\\n' || c == '\\r' || c == '\\t') n += 2;\n";
    s = s + "    else n += 1;\n";
    s = s + "  }\n";
    s = s + "  o = (char *)malloc(n + 1);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  j = 0;\n";
    s = s + "  for (i = 0; in[i]; i++) {\n";
    s = s + "    unsigned char c = (unsigned char)in[i];\n";
    s = s + "    if (c == '\"') { o[j++] = '\\\\'; o[j++] = '\"'; }\n";
    s = s + "    else if (c == '\\\\') { o[j++] = '\\\\'; o[j++] = '\\\\'; }\n";
    s = s + "    else if (c == '\\n') { o[j++] = '\\\\'; o[j++] = 'n'; }\n";
    s = s + "    else if (c == '\\r') { o[j++] = '\\\\'; o[j++] = 'r'; }\n";
    s = s + "    else if (c == '\\t') { o[j++] = '\\\\'; o[j++] = 't'; }\n";
    s = s + "    else o[j++] = (char)c;\n";
    s = s + "  }\n";
    s = s + "  o[j] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static char *k_url_encode(const char *in) {\n";
    s = s + "  static const char *hex = \"0123456789ABCDEF\";\n";
    s = s + "  size_t n = 0, i, j;\n";
    s = s + "  char *o;\n";
    s = s + "  if (!in) in = \"\";\n";
    s = s + "  for (i = 0; in[i]; i++) {\n";
    s = s + "    unsigned char c = (unsigned char)in[i];\n";
    s = s + "    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||\n";
    s = s + "        c == '-' || c == '_' || c == '.' || c == '~') n += 1;\n";
    s = s + "    else n += 3;\n";
    s = s + "  }\n";
    s = s + "  o = (char *)malloc(n + 1);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  j = 0;\n";
    s = s + "  for (i = 0; in[i]; i++) {\n";
    s = s + "    unsigned char c = (unsigned char)in[i];\n";
    s = s + "    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||\n";
    s = s + "        c == '-' || c == '_' || c == '.' || c == '~') o[j++] = (char)c;\n";
    s = s + "    else { o[j++] = '%'; o[j++] = hex[c >> 4]; o[j++] = hex[c & 15]; }\n";
    s = s + "  }\n";
    s = s + "  o[j] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static char *k_html_text(const char *in) {\n";
    s = s + "  size_t n, i, j;\n";
    s = s + "  char *o;\n";
    s = s + "  int tag = 0;\n";
    s = s + "  if (!in) in = \"\";\n";
    s = s + "  n = strlen(in);\n";
    s = s + "  o = (char *)malloc(n + 1);\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  j = 0;\n";
    s = s + "  for (i = 0; in[i]; ) {\n";
    s = s + "    if (in[i] == '<') { tag = 1; i++; continue; }\n";
    s = s + "    if (tag) { if (in[i] == '>') tag = 0; i++; continue; }\n";
    s = s + "    if (in[i] == '&') {\n";
    s = s + "      if (strncmp(in + i, \"&amp;\", 5) == 0) { o[j++] = '&'; i += 5; continue; }\n";
    s = s + "      if (strncmp(in + i, \"&lt;\", 4) == 0) { o[j++] = '<'; i += 4; continue; }\n";
    s = s + "      if (strncmp(in + i, \"&gt;\", 4) == 0) { o[j++] = '>'; i += 4; continue; }\n";
    s = s + "      if (strncmp(in + i, \"&quot;\", 6) == 0) { o[j++] = '\"'; i += 6; continue; }\n";
    s = s + "      if (strncmp(in + i, \"&#39;\", 5) == 0) { o[j++] = '\\''; i += 5; continue; }\n";
    s = s + "      if (strncmp(in + i, \"&nbsp;\", 6) == 0) { o[j++] = ' '; i += 6; continue; }\n";
    s = s + "    }\n";
    s = s + "    o[j++] = in[i++];\n";
    s = s + "  }\n";
    s = s + "  o[j] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static const char *k_jws(const char *p) {\n";
    s = s + "  while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++;\n";
    s = s + "  return p;\n";
    s = s + "}\n\n";
    s = s + "static const char *k_jstr_end(const char *p) {\n";
    s = s + "  if (*p != '\"') return p;\n";
    s = s + "  p++;\n";
    s = s + "  while (*p) {\n";
    s = s + "    if (*p == '\\\\' && p[1]) { p += 2; continue; }\n";
    s = s + "    if (*p == '\"') return p + 1;\n";
    s = s + "    p++;\n";
    s = s + "  }\n";
    s = s + "  return p;\n";
    s = s + "}\n\n";
    s = s + "static const char *k_jval_end(const char *p) {\n";
    s = s + "  int d;\n";
    s = s + "  p = k_jws(p);\n";
    s = s + "  if (*p == '\"') return k_jstr_end(p);\n";
    s = s + "  if (*p == '{' || *p == '[') {\n";
    s = s + "    char open = *p;\n";
    s = s + "    char close = (char)(open == '{' ? '}' : ']');\n";
    s = s + "    d = 1;\n";
    s = s + "    p++;\n";
    s = s + "    while (*p && d) {\n";
    s = s + "      if (*p == '\"') { p = k_jstr_end(p); continue; }\n";
    s = s + "      if (*p == open) d++;\n";
    s = s + "      else if (*p == close) d--;\n";
    s = s + "      p++;\n";
    s = s + "    }\n";
    s = s + "    return p;\n";
    s = s + "  }\n";
    s = s + "  while (*p && *p != ',' && *p != '}' && *p != ']' && *p != ' ' && *p != '\\t' && *p != '\\n' && *p != '\\r') p++;\n";
    s = s + "  return p;\n";
    s = s + "}\n\n";
    s = s + "static char *k_junesc(const char *a, const char *b) {\n";
    s = s + "  size_t n = (size_t)(b > a ? b - a : 0);\n";
    s = s + "  char *o = (char *)malloc(n + 1);\n";
    s = s + "  size_t j = 0;\n";
    s = s + "  const char *p;\n";
    s = s + "  if (!o) die(\"oom\");\n";
    s = s + "  for (p = a; p < b; ) {\n";
    s = s + "    if (*p == '\\\\' && p + 1 < b) {\n";
    s = s + "      char e = p[1];\n";
    s = s + "      p += 2;\n";
    s = s + "      if (e == 'n') o[j++] = '\\n';\n";
    s = s + "      else if (e == 't') o[j++] = '\\t';\n";
    s = s + "      else if (e == 'r') o[j++] = '\\r';\n";
    s = s + "      else if (e == '\"') o[j++] = '\"';\n";
    s = s + "      else if (e == '\\\\') o[j++] = '\\\\';\n";
    s = s + "      else if (e == 'u' && p + 3 < b) {\n";
    s = s + "        unsigned v = 0;\n";
    s = s + "        int k;\n";
    s = s + "        for (k = 0; k < 4; k++) {\n";
    s = s + "          char c = p[k];\n";
    s = s + "          v <<= 4;\n";
    s = s + "          if (c >= '0' && c <= '9') v += (unsigned)(c - '0');\n";
    s = s + "          else if (c >= 'a' && c <= 'f') v += (unsigned)(c - 'a' + 10);\n";
    s = s + "          else if (c >= 'A' && c <= 'F') v += (unsigned)(c - 'A' + 10);\n";
    s = s + "        }\n";
    s = s + "        p += 4;\n";
    s = s + "        if (v < 0x80) o[j++] = (char)v;\n";
    s = s + "        else if (v < 0x800) { o[j++] = (char)(0xC0 | (v >> 6)); o[j++] = (char)(0x80 | (v & 0x3F)); }\n";
    s = s + "        else {\n";
    s = s + "          o[j++] = (char)(0xE0 | (v >> 12));\n";
    s = s + "          o[j++] = (char)(0x80 | ((v >> 6) & 0x3F));\n";
    s = s + "          o[j++] = (char)(0x80 | (v & 0x3F));\n";
    s = s + "        }\n";
    s = s + "      } else o[j++] = e;\n";
    s = s + "    } else o[j++] = *p++;\n";
    s = s + "  }\n";
    s = s + "  o[j] = 0;\n";
    s = s + "  return o;\n";
    s = s + "}\n\n";
    s = s + "static int k_jseg_idx(const char *seg, size_t n) {\n";
    s = s + "  size_t i;\n";
    s = s + "  int v = 0;\n";
    s = s + "  if (n == 0) return -1;\n";
    s = s + "  for (i = 0; i < n; i++) {\n";
    s = s + "    if (seg[i] < '0' || seg[i] > '9') return -1;\n";
    s = s + "    v = v * 10 + (seg[i] - '0');\n";
    s = s + "  }\n";
    s = s + "  return v;\n";
    s = s + "}\n\n";
    s = s + "static int k_jkey_eq(const char *key_a, const char *key_b, const char *want, size_t wn) {\n";
    s = s + "  char *got = k_junesc(key_a, key_b);\n";
    s = s + "  int ok = (strlen(got) == wn && memcmp(got, want, wn) == 0);\n";
    s = s + "  free(got);\n";
    s = s + "  return ok;\n";
    s = s + "}\n\n";
    s = s + "static char *k_json_get(const char *doc, const char *path) {\n";
    s = s + "  const char *p;\n";
    s = s + "  const char *seg;\n";
    s = s + "  if (!doc) doc = \"\";\n";
    s = s + "  if (!path) path = \"\";\n";
    s = s + "  p = k_jws(doc);\n";
    s = s + "  seg = path;\n";
    s = s + "  while (*seg) {\n";
    s = s + "    const char *se = seg;\n";
    s = s + "    size_t sn;\n";
    s = s + "    int idx;\n";
    s = s + "    while (*se && *se != '.') se++;\n";
    s = s + "    sn = (size_t)(se - seg);\n";
    s = s + "    idx = k_jseg_idx(seg, sn);\n";
    s = s + "    p = k_jws(p);\n";
    s = s + "    if (idx >= 0) {\n";
    s = s + "      int cur = 0;\n";
    s = s + "      if (*p != '[') return xstrdup(\"\");\n";
    s = s + "      p++;\n";
    s = s + "      p = k_jws(p);\n";
    s = s + "      if (*p == ']') return xstrdup(\"\");\n";
    s = s + "      while (*p) {\n";
    s = s + "        if (cur == idx) break;\n";
    s = s + "        p = k_jval_end(p);\n";
    s = s + "        p = k_jws(p);\n";
    s = s + "        if (*p == ',') { p++; p = k_jws(p); }\n";
    s = s + "        else return xstrdup(\"\");\n";
    s = s + "        cur++;\n";
    s = s + "      }\n";
    s = s + "    } else {\n";
    s = s + "      int hit = 0;\n";
    s = s + "      if (*p != '{') return xstrdup(\"\");\n";
    s = s + "      p++;\n";
    s = s + "      for (;;) {\n";
    s = s + "        const char *ks, *ke;\n";
    s = s + "        p = k_jws(p);\n";
    s = s + "        if (*p == '}' || !*p) return xstrdup(\"\");\n";
    s = s + "        if (*p != '\"') return xstrdup(\"\");\n";
    s = s + "        ks = p + 1;\n";
    s = s + "        ke = k_jstr_end(p) - 1;\n";
    s = s + "        p = ke + 1;\n";
    s = s + "        p = k_jws(p);\n";
    s = s + "        if (*p != ':') return xstrdup(\"\");\n";
    s = s + "        p++;\n";
    s = s + "        p = k_jws(p);\n";
    s = s + "        if (k_jkey_eq(ks, ke, seg, sn)) { hit = 1; break; }\n";
    s = s + "        p = k_jval_end(p);\n";
    s = s + "        p = k_jws(p);\n";
    s = s + "        if (*p == ',') p++;\n";
    s = s + "      }\n";
    s = s + "      if (!hit) return xstrdup(\"\");\n";
    s = s + "    }\n";
    s = s + "    if (*se == '.') seg = se + 1;\n";
    s = s + "    else seg = se;\n";
    s = s + "  }\n";
    s = s + "  p = k_jws(p);\n";
    s = s + "  if (*p == '\"') {\n";
    s = s + "    const char *ke = k_jstr_end(p) - 1;\n";
    s = s + "    return k_junesc(p + 1, ke);\n";
    s = s + "  }\n";
    s = s + "  {\n";
    s = s + "    const char *e = k_jval_end(p);\n";
    s = s + "    size_t n = (size_t)(e > p ? e - p : 0);\n";
    s = s + "    char *o = (char *)malloc(n + 1);\n";
    s = s + "    if (!o) die(\"oom\");\n";
    s = s + "    memcpy(o, p, n);\n";
    s = s + "    o[n] = 0;\n";
    s = s + "    return o;\n";
    s = s + "  }\n";
    s = s + "}\n\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "static wchar_t *k_widen(const char *s) {\n";
    s = s + "  int n;\n";
    s = s + "  wchar_t *w;\n";
    s = s + "  if (!s) s = \"\";\n";
    s = s + "  n = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);\n";
    s = s + "  if (n <= 0) n = MultiByteToWideChar(CP_ACP, 0, s, -1, NULL, 0);\n";
    s = s + "  if (n <= 0) n = 1;\n";
    s = s + "  w = (wchar_t *)malloc((size_t)n * sizeof(wchar_t));\n";
    s = s + "  if (!w) die(\"oom\");\n";
    s = s + "  if (MultiByteToWideChar(CP_UTF8, 0, s, -1, w, n) <= 0)\n";
    s = s + "    MultiByteToWideChar(CP_ACP, 0, s, -1, w, n);\n";
    s = s + "  return w;\n";
    s = s + "}\n\n";
    s = s + "static wchar_t *k_http_proxy_spec(void) {\n";
    s = s + "  const char *p = getenv(\"KENGA_HTTP_PROXY\");\n";
    s = s + "  if (!p || !p[0]) p = getenv(\"HTTPS_PROXY\");\n";
    s = s + "  if (!p || !p[0]) p = getenv(\"https_proxy\");\n";
    s = s + "  if (!p || !p[0]) p = getenv(\"HTTP_PROXY\");\n";
    s = s + "  if (!p || !p[0]) p = getenv(\"http_proxy\");\n";
    s = s + "  if (!p || !p[0]) return NULL;\n";
    s = s + "  if (strncmp(p, \"http://\", 7) == 0) p += 7;\n";
    s = s + "  else if (strncmp(p, \"https://\", 8) == 0) p += 8;\n";
    s = s + "  return k_widen(p);\n";
    s = s + "}\n\n";
    s = s + "static char *k_http_request(const char *method, const char *url, const char *body, const char *headers) {\n";
    s = s + "  wchar_t *wurl, *wmethod, *wheaders;\n";
    s = s + "  URL_COMPONENTS uc;\n";
    s = s + "  wchar_t host[256];\n";
    s = s + "  wchar_t path[4096];\n";
    s = s + "  wchar_t extra[2048];\n";
    s = s + "  wchar_t full[6144];\n";
    s = s + "  HINTERNET sess, conn, req;\n";
    s = s + "  DWORD flags = 0;\n";
    s = s + "  DWORD timeout = 60000;\n";
    s = s + "  DWORD blen;\n";
    s = s + "  char *out;\n";
    s = s + "  size_t cap, len;\n";
    s = s + "  if (!method) method = \"GET\";\n";
    s = s + "  if (!url) url = \"\";\n";
    s = s + "  if (!body) body = \"\";\n";
    s = s + "  if (!headers) headers = \"\";\n";
    s = s + "  wurl = k_widen(url);\n";
    s = s + "  wmethod = k_widen(method);\n";
    s = s + "  wheaders = headers[0] ? k_widen(headers) : NULL;\n";
    s = s + "  memset(&uc, 0, sizeof(uc));\n";
    s = s + "  uc.dwStructSize = sizeof(uc);\n";
    s = s + "  uc.lpszHostName = host; uc.dwHostNameLength = 256;\n";
    s = s + "  uc.lpszUrlPath = path; uc.dwUrlPathLength = 4096;\n";
    s = s + "  uc.lpszExtraInfo = extra; uc.dwExtraInfoLength = 2048;\n";
    s = s + "  if (!WinHttpCrackUrl(wurl, 0, 0, &uc)) {\n";
    s = s + "    free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "    return xstrdup(\"ERR: bad url\");\n";
    s = s + "  }\n";
    s = s + "  full[0] = 0;\n";
    s = s + "  { size_t i = 0; const wchar_t *a = path; const wchar_t *b = extra;\n";
    s = s + "    while (*a && i < 6143) full[i++] = *a++;\n";
    s = s + "    while (*b && i < 6143) full[i++] = *b++;\n";
    s = s + "    full[i] = 0; }\n";
    s = s + "  { wchar_t *wprox = k_http_proxy_spec();\n";
    s = s + "    if (wprox) {\n";
    s = s + "      sess = WinHttpOpen(L\"kenga-lite/1.0\", WINHTTP_ACCESS_TYPE_NAMED_PROXY,\n";
    s = s + "                         wprox, WINHTTP_NO_PROXY_BYPASS, 0);\n";
    s = s + "      free(wprox);\n";
    s = s + "    } else {\n";
    s = s + "      sess = WinHttpOpen(L\"kenga-lite/1.0\", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,\n";
    s = s + "                         WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);\n";
    s = s + "    } }\n";
    s = s + "  if (!sess) { free(wurl); free(wmethod); free(wheaders); return xstrdup(\"ERR: winhttp open\"); }\n";
    s = s + "  WinHttpSetTimeouts(sess, timeout, timeout, timeout, timeout);\n";
    s = s + "  { DWORD proto = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1 |\n";
    s = s + "                  WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_1 |\n";
    s = s + "                  WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2;\n";
    s = s + "    WinHttpSetOption(sess, WINHTTP_OPTION_SECURE_PROTOCOLS, &proto, sizeof(proto)); }\n";
    s = s + "  if (!full[0]) { full[0] = '/'; full[1] = 0; }\n";
    s = s + "  conn = WinHttpConnect(sess, host, uc.nPort, 0);\n";
    s = s + "  if (!conn) {\n";
    s = s + "    WinHttpCloseHandle(sess); free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "    return xstrdup(\"ERR: connect\");\n";
    s = s + "  }\n";
    s = s + "  if (uc.nScheme == INTERNET_SCHEME_HTTPS) flags |= WINHTTP_FLAG_SECURE;\n";
    s = s + "  req = WinHttpOpenRequest(conn, wmethod, full, NULL, WINHTTP_NO_REFERER,\n";
    s = s + "                           WINHTTP_DEFAULT_ACCEPT_TYPES, flags);\n";
    s = s + "  if (!req) {\n";
    s = s + "    WinHttpCloseHandle(conn); WinHttpCloseHandle(sess);\n";
    s = s + "    free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "    return xstrdup(\"ERR: open request\");\n";
    s = s + "  }\n";
    s = s + "  if (wheaders) WinHttpAddRequestHeaders(req, wheaders, (DWORD)-1, WINHTTP_ADDREQ_FLAG_ADD);\n";
    s = s + "  blen = (DWORD)strlen(body);\n";
    s = s + "  if (!WinHttpSendRequest(req, WINHTTP_NO_ADDITIONAL_HEADERS, 0,\n";
    s = s + "                          (LPVOID)(blen ? body : NULL), blen, blen, 0)) {\n";
    s = s + "    char err[64]; snprintf(err, sizeof(err), \"ERR: send %lu\", (unsigned long)GetLastError());\n";
    s = s + "    WinHttpCloseHandle(req); WinHttpCloseHandle(conn); WinHttpCloseHandle(sess);\n";
    s = s + "    free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "    return xstrdup(err);\n";
    s = s + "  }\n";
    s = s + "  if (!WinHttpReceiveResponse(req, NULL)) {\n";
    s = s + "    char err[64]; snprintf(err, sizeof(err), \"ERR: recv %lu\", (unsigned long)GetLastError());\n";
    s = s + "    WinHttpCloseHandle(req); WinHttpCloseHandle(conn); WinHttpCloseHandle(sess);\n";
    s = s + "    free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "    return xstrdup(err);\n";
    s = s + "  }\n";
    s = s + "  cap = 4096; len = 0;\n";
    s = s + "  out = (char *)malloc(cap);\n";
    s = s + "  if (!out) die(\"oom\");\n";
    s = s + "  for (;;) {\n";
    s = s + "    DWORD avail = 0, got = 0;\n";
    s = s + "    if (!WinHttpQueryDataAvailable(req, &avail)) break;\n";
    s = s + "    if (!avail) break;\n";
    s = s + "    if (len + avail + 1 > cap) {\n";
    s = s + "      while (len + avail + 1 > cap) cap *= 2;\n";
    s = s + "      out = (char *)xrealloc(out, cap);\n";
    s = s + "    }\n";
    s = s + "    if (!WinHttpReadData(req, out + len, avail, &got) || !got) break;\n";
    s = s + "    len += got;\n";
    s = s + "  }\n";
    s = s + "  out[len] = 0;\n";
    s = s + "  WinHttpCloseHandle(req); WinHttpCloseHandle(conn); WinHttpCloseHandle(sess);\n";
    s = s + "  free(wurl); free(wmethod); free(wheaders);\n";
    s = s + "  return out;\n";
    s = s + "}\n";
    s = s + "#else\n";
    s = s + "static char *k_slurp_file(const char *path) {\n";
    s = s + "  FILE *f = fopen(path, \"rb\");\n";
    s = s + "  long sz;\n";
    s = s + "  char *buf;\n";
    s = s + "  if (!f) return xstrdup(\"ERR: read\");\n";
    s = s + "  if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return xstrdup(\"ERR: seek\"); }\n";
    s = s + "  sz = ftell(f);\n";
    s = s + "  if (sz < 0) { fclose(f); return xstrdup(\"ERR: tell\"); }\n";
    s = s + "  rewind(f);\n";
    s = s + "  buf = (char *)malloc((size_t)sz + 1);\n";
    s = s + "  if (!buf) { fclose(f); die(\"oom\"); }\n";
    s = s + "  if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) { fclose(f); free(buf); return xstrdup(\"ERR: fread\"); }\n";
    s = s + "  fclose(f);\n";
    s = s + "  buf[sz] = 0;\n";
    s = s + "  return buf;\n";
    s = s + "}\n\n";
    s = s + "static char *k_http_request(const char *method, const char *url, const char *body, const char *headers) {\n";
    s = s + "  char outp[] = \"/tmp/kenga-http-XXXXXX\";\n";
    s = s + "  char inp[] = \"/tmp/kenga-http-in-XXXXXX\";\n";
    s = s + "  char at[64];\n";
    s = s + "  int ofd, ifd, st;\n";
    s = s + "  pid_t pid;\n";
    s = s + "  char *argv[24];\n";
    s = s + "  int n = 0;\n";
    s = s + "  char *out;\n";
    s = s + "  if (!method) method = \"GET\";\n";
    s = s + "  if (!url) url = \"\";\n";
    s = s + "  if (!body) body = \"\";\n";
    s = s + "  if (!headers) headers = \"\";\n";
    s = s + "  ofd = mkstemp(outp);\n";
    s = s + "  ifd = mkstemp(inp);\n";
    s = s + "  if (ofd < 0 || ifd < 0) return xstrdup(\"ERR: tmp\");\n";
    s = s + "  if (body[0]) { ssize_t _w = write(ifd, body, strlen(body)); (void)_w; }\n";
    s = s + "  close(ifd);\n";
    s = s + "  close(ofd);\n";
    s = s + "  snprintf(at, sizeof(at), \"@%s\", inp);\n";
    s = s + "  argv[n++] = (char *)\"curl\";\n";
    s = s + "  argv[n++] = (char *)\"-sS\";\n";
    s = s + "  argv[n++] = (char *)\"-L\";\n";
    s = s + "  argv[n++] = (char *)\"--max-time\";\n";
    s = s + "  argv[n++] = (char *)\"60\";\n";
    s = s + "  argv[n++] = (char *)\"-X\";\n";
    s = s + "  argv[n++] = (char *)method;\n";
    s = s + "  if (headers[0]) { argv[n++] = (char *)\"-H\"; argv[n++] = (char *)headers; }\n";
    s = s + "  if (body[0]) { argv[n++] = (char *)\"--data-binary\"; argv[n++] = at; }\n";
    s = s + "  argv[n++] = (char *)\"-o\";\n";
    s = s + "  argv[n++] = outp;\n";
    s = s + "  argv[n++] = (char *)url;\n";
    s = s + "  argv[n++] = NULL;\n";
    s = s + "  pid = fork();\n";
    s = s + "  if (pid == 0) { execvp(\"curl\", argv); _exit(127); }\n";
    s = s + "  if (pid < 0) { unlink(outp); unlink(inp); return xstrdup(\"ERR: fork\"); }\n";
    s = s + "  waitpid(pid, &st, 0);\n";
    s = s + "  if (!WIFEXITED(st) || WEXITSTATUS(st) != 0) {\n";
    s = s + "    unlink(outp); unlink(inp);\n";
    s = s + "    return xstrdup(\"ERR: curl\");\n";
    s = s + "  }\n";
    s = s + "  out = k_slurp_file(outp);\n";
    s = s + "  unlink(outp);\n";
    s = s + "  unlink(inp);\n";
    s = s + "  return out;\n";
    s = s + "}\n";
    s = s + "#endif\n";
    assert(write_file("bootstrap/generated/rt_net.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_net.inc.c");
    println("rt_net ok");
    return 0;
}
