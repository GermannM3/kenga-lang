// Optional OpenCL GEMM behind t_matmul. No SDK link: LoadLibrary OpenCL.dll.
// Unix / missing GPU ? tl_gemm_cl returns 0, CPU loop stays.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_matmul_cl.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_matmul_cl.kenga -- do not hand-edit */\n";
    s = s + "#ifndef KENGA_RT_MATMUL_CL_INC\n#define KENGA_RT_MATMUL_CL_INC\n";
    s = s + "/* Dynamic OpenCL. Windows GPU only. Else CPU. */\n";
    s = s + "typedef int32_t tl_cl_int;\n";
    s = s + "typedef uint32_t tl_cl_uint;\n";
    s = s + "typedef void *tl_cl_obj;\n";
    s = s + "typedef uint64_t tl_cl_bits;\n";
    s = s + "typedef tl_cl_int (*tl_cl_GetPlatformIDs)(tl_cl_uint, tl_cl_obj *, tl_cl_uint *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_GetDeviceIDs)(tl_cl_obj, tl_cl_bits, tl_cl_uint, tl_cl_obj *, tl_cl_uint *);\n";
    s = s + "typedef tl_cl_obj (*tl_cl_CreateContext)(const void *, tl_cl_uint, const tl_cl_obj *, void *, void *, tl_cl_int *);\n";
    s = s + "typedef tl_cl_obj (*tl_cl_CreateCommandQueue)(tl_cl_obj, tl_cl_obj, tl_cl_bits, tl_cl_int *);\n";
    s = s + "typedef tl_cl_obj (*tl_cl_CreateProgramWithSource)(tl_cl_obj, tl_cl_uint, const char **, const size_t *, tl_cl_int *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_BuildProgram)(tl_cl_obj, tl_cl_uint, const tl_cl_obj *, const char *, void *, void *);\n";
    s = s + "typedef tl_cl_obj (*tl_cl_CreateKernel)(tl_cl_obj, const char *, tl_cl_int *);\n";
    s = s + "typedef tl_cl_obj (*tl_cl_CreateBuffer)(tl_cl_obj, tl_cl_bits, size_t, void *, tl_cl_int *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_SetKernelArg)(tl_cl_obj, tl_cl_uint, size_t, const void *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_EnqueueWriteBuffer)(tl_cl_obj, tl_cl_obj, tl_cl_uint, size_t, size_t, const void *, tl_cl_uint, const void *, void *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_EnqueueNDRangeKernel)(tl_cl_obj, tl_cl_obj, tl_cl_uint, const size_t *, const size_t *, const size_t *, tl_cl_uint, const void *, void *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_EnqueueReadBuffer)(tl_cl_obj, tl_cl_obj, tl_cl_uint, size_t, size_t, void *, tl_cl_uint, const void *, void *);\n";
    s = s + "typedef tl_cl_int (*tl_cl_Finish)(tl_cl_obj);\n";
    s = s + "typedef tl_cl_int (*tl_cl_ReleaseMemObject)(tl_cl_obj);\n";
    s = s + "\n";
    s = s + "static const char *tl_cl_src =\n";
    s = s + "  \"#pragma OPENCL EXTENSION cl_khr_fp64 : enable\\n\"\n";
    s = s + "  \"__kernel void gemm(const int M, const int N, const int K,\\n\"\n";
    s = s + "  \" __global const double *A, __global const double *B, __global double *C) {\\n\"\n";
    s = s + "  \"  int i = get_global_id(0);\\n\"\n";
    s = s + "  \"  int j = get_global_id(1);\\n\"\n";
    s = s + "  \"  if (i >= M || j >= N) return;\\n\"\n";
    s = s + "  \"  double acc = 0.0;\\n\"\n";
    s = s + "  \"  int t;\\n\"\n";
    s = s + "  \"  for (t = 0; t < K; t++) acc += A[i * K + t] * B[t * N + j];\\n\"\n";
    s = s + "  \"  C[i * N + j] = acc;\\n\"\n";
    s = s + "  \"}\\n\";\n";
    s = s + "\n";
    s = s + "static int g_tl_cl_state;\n";
    s = s + "static tl_cl_obj g_tl_cl_ctx;\n";
    s = s + "static tl_cl_obj g_tl_cl_q;\n";
    s = s + "static tl_cl_obj g_tl_cl_k;\n";
    s = s + "static tl_cl_CreateBuffer g_tl_cl_CreateBuffer;\n";
    s = s + "static tl_cl_SetKernelArg g_tl_cl_SetKernelArg;\n";
    s = s + "static tl_cl_EnqueueWriteBuffer g_tl_cl_EnqueueWriteBuffer;\n";
    s = s + "static tl_cl_EnqueueNDRangeKernel g_tl_cl_EnqueueNDRangeKernel;\n";
    s = s + "static tl_cl_EnqueueReadBuffer g_tl_cl_EnqueueReadBuffer;\n";
    s = s + "static tl_cl_Finish g_tl_cl_Finish;\n";
    s = s + "static tl_cl_ReleaseMemObject g_tl_cl_ReleaseMemObject;\n";
    s = s + "\n";
    s = s + "static int tl_cl_init(void) {\n";
    s = s + "#ifdef _WIN32\n";
    s = s + "  HMODULE lib;\n";
    s = s + "  tl_cl_GetPlatformIDs get_plats;\n";
    s = s + "  tl_cl_GetDeviceIDs get_devs;\n";
    s = s + "  tl_cl_CreateContext create_ctx;\n";
    s = s + "  tl_cl_CreateCommandQueue create_q;\n";
    s = s + "  tl_cl_CreateProgramWithSource create_prog;\n";
    s = s + "  tl_cl_BuildProgram build_prog;\n";
    s = s + "  tl_cl_CreateKernel create_k;\n";
    s = s + "  tl_cl_obj plats[8];\n";
    s = s + "  tl_cl_obj dev;\n";
    s = s + "  tl_cl_obj prog;\n";
    s = s + "  tl_cl_uint np, nd, i;\n";
    s = s + "  tl_cl_int err;\n";
    s = s + "  const char *src;\n";
    s = s + "  if (g_tl_cl_state != 0) return g_tl_cl_state == 1;\n";
    s = s + "  g_tl_cl_state = -1;\n";
    s = s + "  lib = LoadLibraryA(\"OpenCL.dll\");\n";
    s = s + "  if (!lib) return 0;\n";
    s = s + "  get_plats = (tl_cl_GetPlatformIDs)GetProcAddress(lib, \"clGetPlatformIDs\");\n";
    s = s + "  get_devs = (tl_cl_GetDeviceIDs)GetProcAddress(lib, \"clGetDeviceIDs\");\n";
    s = s + "  create_ctx = (tl_cl_CreateContext)GetProcAddress(lib, \"clCreateContext\");\n";
    s = s + "  create_q = (tl_cl_CreateCommandQueue)GetProcAddress(lib, \"clCreateCommandQueue\");\n";
    s = s + "  create_prog = (tl_cl_CreateProgramWithSource)GetProcAddress(lib, \"clCreateProgramWithSource\");\n";
    s = s + "  build_prog = (tl_cl_BuildProgram)GetProcAddress(lib, \"clBuildProgram\");\n";
    s = s + "  create_k = (tl_cl_CreateKernel)GetProcAddress(lib, \"clCreateKernel\");\n";
    s = s + "  g_tl_cl_CreateBuffer = (tl_cl_CreateBuffer)GetProcAddress(lib, \"clCreateBuffer\");\n";
    s = s + "  g_tl_cl_SetKernelArg = (tl_cl_SetKernelArg)GetProcAddress(lib, \"clSetKernelArg\");\n";
    s = s + "  g_tl_cl_EnqueueWriteBuffer = (tl_cl_EnqueueWriteBuffer)GetProcAddress(lib, \"clEnqueueWriteBuffer\");\n";
    s = s + "  g_tl_cl_EnqueueNDRangeKernel = (tl_cl_EnqueueNDRangeKernel)GetProcAddress(lib, \"clEnqueueNDRangeKernel\");\n";
    s = s + "  g_tl_cl_EnqueueReadBuffer = (tl_cl_EnqueueReadBuffer)GetProcAddress(lib, \"clEnqueueReadBuffer\");\n";
    s = s + "  g_tl_cl_Finish = (tl_cl_Finish)GetProcAddress(lib, \"clFinish\");\n";
    s = s + "  g_tl_cl_ReleaseMemObject = (tl_cl_ReleaseMemObject)GetProcAddress(lib, \"clReleaseMemObject\");\n";
    s = s + "  if (!get_plats || !get_devs || !create_ctx || !create_q || !create_prog || !build_prog || !create_k) return 0;\n";
    s = s + "  if (!g_tl_cl_CreateBuffer || !g_tl_cl_SetKernelArg || !g_tl_cl_EnqueueWriteBuffer) return 0;\n";
    s = s + "  if (!g_tl_cl_EnqueueNDRangeKernel || !g_tl_cl_EnqueueReadBuffer || !g_tl_cl_Finish) return 0;\n";
    s = s + "  if (!g_tl_cl_ReleaseMemObject) return 0;\n";
    s = s + "  np = 0;\n";
    s = s + "  if (get_plats(0, NULL, &np) != 0 || np == 0) return 0;\n";
    s = s + "  if (np > 8) np = 8;\n";
    s = s + "  if (get_plats(np, plats, NULL) != 0) return 0;\n";
    s = s + "  dev = NULL;\n";
    s = s + "  for (i = 0; i < np; i++) {\n";
    s = s + "    nd = 0;\n";
    s = s + "    if (get_devs(plats[i], 4, 0, NULL, &nd) != 0 || nd == 0) continue;\n";
    s = s + "    if (get_devs(plats[i], 4, 1, &dev, NULL) == 0) break;\n";
    s = s + "    dev = NULL;\n";
    s = s + "  }\n";
    s = s + "  if (!dev) return 0;\n";
    s = s + "  err = 0;\n";
    s = s + "  g_tl_cl_ctx = create_ctx(NULL, 1, &dev, NULL, NULL, &err);\n";
    s = s + "  if (!g_tl_cl_ctx || err != 0) return 0;\n";
    s = s + "  g_tl_cl_q = create_q(g_tl_cl_ctx, dev, 0, &err);\n";
    s = s + "  if (!g_tl_cl_q || err != 0) return 0;\n";
    s = s + "  src = tl_cl_src;\n";
    s = s + "  prog = create_prog(g_tl_cl_ctx, 1, &src, NULL, &err);\n";
    s = s + "  if (!prog || err != 0) return 0;\n";
    s = s + "  if (build_prog(prog, 1, &dev, NULL, NULL, NULL) != 0) return 0;\n";
    s = s + "  g_tl_cl_k = create_k(prog, \"gemm\", &err);\n";
    s = s + "  if (!g_tl_cl_k || err != 0) return 0;\n";
    s = s + "  g_tl_cl_state = 1;\n";
    s = s + "  fprintf(stderr, \"t_matmul: OpenCL GPU\\n\");\n";
    s = s + "  return 1;\n";
    s = s + "#else\n";
    s = s + "  (void)0;\n";
    s = s + "  if (g_tl_cl_state == 0) g_tl_cl_state = -1;\n";
    s = s + "  return 0;\n";
    s = s + "#endif\n";
    s = s + "}\n";
    s = s + "\n";
    s = s + "static int tl_gemm_cl(int m, int n, int k, const double *a, const double *b, double *c) {\n";
    s = s + "  tl_cl_obj ba, bb, bc;\n";
    s = s + "  tl_cl_int err, mi, ni, ki;\n";
    s = s + "  size_t asz, bsz, csz, gsz[2];\n";
    s = s + "  if (m < 32 || n < 32 || k < 32) return 0;\n";
    s = s + "  if (!tl_cl_init()) return 0;\n";
    s = s + "  asz = (size_t)m * (size_t)k * sizeof(double);\n";
    s = s + "  bsz = (size_t)k * (size_t)n * sizeof(double);\n";
    s = s + "  csz = (size_t)m * (size_t)n * sizeof(double);\n";
    s = s + "  err = 0;\n";
    s = s + "  ba = g_tl_cl_CreateBuffer(g_tl_cl_ctx, 4, asz, NULL, &err);\n";
    s = s + "  if (!ba || err != 0) return 0;\n";
    s = s + "  bb = g_tl_cl_CreateBuffer(g_tl_cl_ctx, 4, bsz, NULL, &err);\n";
    s = s + "  if (!bb || err != 0) { g_tl_cl_ReleaseMemObject(ba); return 0; }\n";
    s = s + "  bc = g_tl_cl_CreateBuffer(g_tl_cl_ctx, 2, csz, NULL, &err);\n";
    s = s + "  if (!bc || err != 0) { g_tl_cl_ReleaseMemObject(ba); g_tl_cl_ReleaseMemObject(bb); return 0; }\n";
    s = s + "  if (g_tl_cl_EnqueueWriteBuffer(g_tl_cl_q, ba, 1, 0, asz, a, 0, NULL, NULL) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_EnqueueWriteBuffer(g_tl_cl_q, bb, 1, 0, bsz, b, 0, NULL, NULL) != 0) goto fail;\n";
    s = s + "  mi = m; ni = n; ki = k;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 0, sizeof(mi), &mi) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 1, sizeof(ni), &ni) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 2, sizeof(ki), &ki) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 3, sizeof(ba), &ba) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 4, sizeof(bb), &bb) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_SetKernelArg(g_tl_cl_k, 5, sizeof(bc), &bc) != 0) goto fail;\n";
    s = s + "  gsz[0] = (size_t)m;\n";
    s = s + "  gsz[1] = (size_t)n;\n";
    s = s + "  if (g_tl_cl_EnqueueNDRangeKernel(g_tl_cl_q, g_tl_cl_k, 2, NULL, gsz, NULL, 0, NULL, NULL) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_EnqueueReadBuffer(g_tl_cl_q, bc, 1, 0, csz, c, 0, NULL, NULL) != 0) goto fail;\n";
    s = s + "  if (g_tl_cl_Finish(g_tl_cl_q) != 0) goto fail;\n";
    s = s + "  g_tl_cl_ReleaseMemObject(ba);\n";
    s = s + "  g_tl_cl_ReleaseMemObject(bb);\n";
    s = s + "  g_tl_cl_ReleaseMemObject(bc);\n";
    s = s + "  return 1;\n";
    s = s + "fail:\n";
    s = s + "  g_tl_cl_ReleaseMemObject(ba);\n";
    s = s + "  g_tl_cl_ReleaseMemObject(bb);\n";
    s = s + "  g_tl_cl_ReleaseMemObject(bc);\n";
    s = s + "  return 0;\n";
    s = s + "}\n";
    s = s + "#endif\n";

    assert(write_file("bootstrap/generated/rt_matmul_cl.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_matmul_cl.inc.c");
    println("rt_matmul_cl ok");
    return 0;
}
