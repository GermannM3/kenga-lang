// Emit growable arrays for the lite host.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_arena.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_arena.kenga — do not hand-edit */\n";
    s = s + "static void i64a_push(I64A *a, int64_t v) {\n";
    s = s + "  if (a->len + 1 > a->cap) {\n";
    s = s + "    a->cap = a->cap ? a->cap * 2 : 32;\n";
    s = s + "    a->data = (int64_t *)xrealloc(a->data, a->cap * sizeof(int64_t));\n";
    s = s + "  }\n";
    s = s + "  a->data[a->len++] = v;\n";
    s = s + "}\n";
    s = s + "static void vala_push(ValA *a, Value v) {\n";
    s = s + "  if (a->len + 1 > a->cap) {\n";
    s = s + "    a->cap = a->cap ? a->cap * 2 : 32;\n";
    s = s + "    a->data = (Value *)xrealloc(a->data, a->cap * sizeof(Value));\n";
    s = s + "  }\n";
    s = s + "  a->data[a->len++] = v;\n";
    s = s + "}\n";
    s = s + "static void stra_push(StrA *a, char *s) {\n";
    s = s + "  if (a->len + 1 > a->cap) {\n";
    s = s + "    a->cap = a->cap ? a->cap * 2 : 16;\n";
    s = s + "    a->data = (char **)xrealloc(a->data, a->cap * sizeof(char *));\n";
    s = s + "  }\n";
    s = s + "  a->data[a->len++] = s;\n";
    s = s + "}\n";
    s = s + "static void i64aa_push(I64AA *a, I64A v) {\n";
    s = s + "  if (a->len + 1 > a->cap) {\n";
    s = s + "    a->cap = a->cap ? a->cap * 2 : 8;\n";
    s = s + "    a->data = (I64A *)xrealloc(a->data, a->cap * sizeof(I64A));\n";
    s = s + "  }\n";
    s = s + "  a->data[a->len++] = v;\n";
    s = s + "}\n";
    s = s + "static void listh_push(ListHeap *h, ValA list) {\n";
    s = s + "  if (h->len + 1 > h->cap) {\n";
    s = s + "    h->cap = h->cap ? h->cap * 2 : 8;\n";
    s = s + "    h->data = (ValA *)xrealloc(h->data, h->cap * sizeof(ValA));\n";
    s = s + "  }\n";
    s = s + "  h->data[h->len++] = list;\n";
    s = s + "}\n";
    s = s + "static void i64a_free(I64A *a) {\n";
    s = s + "  free(a->data); a->data = NULL; a->len = a->cap = 0;\n";
    s = s + "}\n";
    s = s + "static void vala_free(ValA *a) {\n";
    s = s + "  free(a->data); a->data = NULL; a->len = a->cap = 0;\n";
    s = s + "}\n";
    s = s + "static void stra_free(StrA *a) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < a->len; i++) free(a->data[i]);\n";
    s = s + "  free(a->data); a->data = NULL; a->len = a->cap = 0;\n";
    s = s + "}\n";
    s = s + "static void listh_free(ListHeap *h) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < h->len; i++) vala_free(&h->data[i]);\n";
    s = s + "  free(h->data); h->data = NULL; h->len = h->cap = 0;\n";
    s = s + "}\n";
    s = s + "static void structh_push(StructHeap *h, StructObj obj) {\n";
    s = s + "  if (h->len + 1 > h->cap) {\n";
    s = s + "    h->cap = h->cap ? h->cap * 2 : 8;\n";
    s = s + "    h->data = (StructObj *)xrealloc(h->data, h->cap * sizeof(StructObj));\n";
    s = s + "  }\n";
    s = s + "  h->data[h->len++] = obj;\n";
    s = s + "}\n";
    s = s + "static void structh_free(StructHeap *h) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < h->len; i++) i64a_free(&h->data[i].fields);\n";
    s = s + "  free(h->data); h->data = NULL; h->len = h->cap = 0;\n";
    s = s + "}\n";
    s = s + "static void stypes_reset(void) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < g_nstypes; i++) {\n";
    s = s + "    free(g_stypes[i].name);\n";
    s = s + "    stra_free(&g_stypes[i].fields);\n";
    s = s + "  }\n";
    s = s + "  free(g_stypes); g_stypes = NULL; g_nstypes = g_stypes_cap = 0;\n";
    s = s + "}\n";
    s = s + "static int find_struct_type(const char *name) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < g_nstypes; i++) {\n";
    s = s + "    if (strcmp(g_stypes[i].name, name) == 0) return (int)i;\n";
    s = s + "  }\n";
    s = s + "  return -1;\n";
    s = s + "}\n";
    s = s + "static int field_index_of(const StructType *st, const char *field) {\n";
    s = s + "  size_t i;\n";
    s = s + "  for (i = 0; i < st->fields.len; i++) {\n";
    s = s + "    if (strcmp(st->fields.data[i], field) == 0) return (int)i;\n";
    s = s + "  }\n";
    s = s + "  return -1;\n";
    s = s + "}\n";
    assert(write_file("bootstrap/generated/rt_arena.inc.c", s) == true);
    println("wrote bootstrap/generated/rt_arena.inc.c");
    println("rt_arena ok");
    return 0;
}
