// Emit reverse-mode tape on tagged KVal (no Rust, no lite VM).
// Writes bootstrap/generated/rt_kval_tape.inc.c -- include after rt_kval_tensor.inc.c.
// Tape matches lite: add/sub/mul/matmul/scale/relu/neg/transpose/reshape/exp/log/softmax/mse/sum/value/grad.
// Run: bootstrap\bin\kenga-lite.exe run kenga\emit\rt_kval_tape.kenga

fn main() -> i64 {
    let s: str = "";
    s = s + "/* GENERATED by kenga/emit/rt_kval_tape.kenga -- do not hand-edit */\n";
    s = s + "/* requires rt_kval_tensor.inc.c (KvTensor, kt_obj, kt_alloc, k_t_matmul) */\n";
    s = s + "#ifndef KENGA_RT_KVAL_TAPE_INC\n#define KENGA_RT_KVAL_TAPE_INC\n\n";
    s = s + "#define KVAG_MAX_NODES 4096\n\n";
    s = s + "enum {\n";
    s = s + "  KVAG_LEAF = 0, KVAG_ADD, KVAG_SUB, KVAG_MUL, KVAG_MATMUL, KVAG_SCALE,\n";
    s = s + "  KVAG_RELU, KVAG_NEG, KVAG_TRANSPOSE, KVAG_RESHAPE, KVAG_EXP, KVAG_LOG,\n";
    s = s + "  KVAG_SOFTMAX, KVAG_MSE, KVAG_SUM\n";
    s = s + "};\n\n";
    s = s + "typedef struct {\n";
    s = s + "  int is_scalar;\n";
    s = s + "  int64_t th;\n";
    s = s + "  double scalar;\n";
    s = s + "  int has_grad;\n";
    s = s + "  int grad_is_scalar;\n";
    s = s + "  int64_t gth;\n";
    s = s + "  double gscalar;\n";
    s = s + "  int op;\n";
    s = s + "  int pa, pb;\n";
    s = s + "  int requires_grad;\n";
    s = s + "  double scale;\n";
    s = s + "  int old_rank;\n";
    s = s + "  int old_shape[8];\n";
    s = s + "} KvAgNode;\n\n";
    s = s + "typedef struct {\n";
    s = s + "  KvAgNode nodes[KVAG_MAX_NODES];\n";
    s = s + "  int n;\n";
    s = s + "} KvAgTape;\n\n";
    s = s + "static KvAgTape g_kvag;\n\n";
    s = s + "static int64_t kt_clone(int64_t th) {\n";
    s = s + "  KvTensor *t = kt_obj(th);\n";
    s = s + "  int shape[8];\n";
    s = s + "  int rank = t->rank;\n";
    s = s + "  int n = t->n;\n";
    s = s + "  int i;\n";
    s = s + "  double *src = t->data;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = t->shape[i];\n";
    s = s + "  h = kt_alloc(shape, rank, 0);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  if (n > 0) memcpy(o->data, src, (size_t)n * sizeof(double));\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_transpose(int64_t ha) {\n";
    s = s + "  KvTensor *a = kt_obj(ha);\n";
    s = s + "  int r, c, shape[2];\n";
    s = s + "  double *ad;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  int i, j;\n";
    s = s + "  if (a->rank != 2) k_die(\"transpose expects rank-2\");\n";
    s = s + "  r = a->shape[0];\n";
    s = s + "  c = a->shape[1];\n";
    s = s + "  ad = a->data;\n";
    s = s + "  shape[0] = c;\n";
    s = s + "  shape[1] = r;\n";
    s = s + "  h = kt_alloc(shape, 2, 1);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < r; i++)\n";
    s = s + "    for (j = 0; j < c; j++) o->data[j * r + i] = ad[i * c + j];\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_scale(int64_t ha, double s) {\n";
    s = s + "  int64_t h = kt_clone(ha);\n";
    s = s + "  KvTensor *o = kt_obj(h);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] *= s;\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_ew_sub(int64_t ha, int64_t hb) {\n";
    s = s + "  KvTensor *a = kt_obj(ha), *b = kt_obj(hb);\n";
    s = s + "  int i, n, rank, shape[8];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  if (a->n != b->n) k_die(\"tensor size mismatch\");\n";
    s = s + "  rank = a->rank;\n";
    s = s + "  n = a->n;\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i];\n";
    s = s + "  ad = a->data;\n";
    s = s + "  bd = b->data;\n";
    s = s + "  h = kt_alloc(shape, rank, 0);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) o->data[i] = ad[i] - bd[i];\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_ew_mul(int64_t ha, int64_t hb) {\n";
    s = s + "  KvTensor *a = kt_obj(ha), *b = kt_obj(hb);\n";
    s = s + "  int i, n, rank, shape[8]; int64_t h; KvTensor *o;\n";
    s = s + "  if (a->n != b->n) k_die(\"tensor size mismatch\");\n";
    s = s + "  rank = a->rank; n = a->n; for (i = 0; i < rank; i++) shape[i] = a->shape[i];\n";
    s = s + "  h = kt_alloc(shape, rank, 0); o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) o->data[i] = a->data[i] * b->data[i];\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_exp(int64_t ha) {\n";
    s = s + "  int64_t h = kt_clone(ha); KvTensor *o = kt_obj(h); int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] = exp(o->data[i]); return h;\n";
    s = s + "}\n";
    s = s + "static int64_t kt_log(int64_t ha) {\n";
    s = s + "  int64_t h = kt_clone(ha); KvTensor *o = kt_obj(h); int i;\n";
    s = s + "  for (i = 0; i < o->n; i++) { double x = o->data[i]; if (x < 1e-12) x = 1e-12; o->data[i] = log(x); }\n";
    s = s + "  return h;\n";
    s = s + "}\n";
    s = s + "static int64_t kt_softmax(int64_t ha) {\n";
    s = s + "  int64_t h = kt_clone(ha); KvTensor *o = kt_obj(h);\n";
    s = s + "  double mx = -1e300, sum = 0.0; int i;\n";
    s = s + "  if (o->n < 1) return h;\n";
    s = s + "  for (i = 0; i < o->n; i++) if (o->data[i] > mx) mx = o->data[i];\n";
    s = s + "  for (i = 0; i < o->n; i++) { o->data[i] = exp(o->data[i] - mx); sum += o->data[i]; }\n";
    s = s + "  if (sum < 1e-300) sum = 1e-300;\n";
    s = s + "  for (i = 0; i < o->n; i++) o->data[i] /= sum; return h;\n";
    s = s + "}\n";
    s = s + "static double kt_sum(int64_t ha) {\n";
    s = s + "  KvTensor *a = kt_obj(ha); double acc = 0.0; int i;\n";
    s = s + "  for (i = 0; i < a->n; i++) acc += a->data[i]; return acc;\n";
    s = s + "}\n";
    s = s + "static int64_t kt_fill_like(int64_t ha, double v) {\n";
    s = s + "  KvTensor *a = kt_obj(ha); int64_t h = kt_alloc(a->shape, a->rank, 0);\n";
    s = s + "  KvTensor *o = kt_obj(h); int i; for (i = 0; i < o->n; i++) o->data[i] = v; return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_ew_add(int64_t ha, int64_t hb) {\n";
    s = s + "  KvTensor *a = kt_obj(ha), *b = kt_obj(hb);\n";
    s = s + "  int i, n, rank, shape[8];\n";
    s = s + "  double *ad, *bd;\n";
    s = s + "  int64_t h;\n";
    s = s + "  KvTensor *o;\n";
    s = s + "  if (a->n != b->n) k_die(\"tensor size mismatch\");\n";
    s = s + "  rank = a->rank;\n";
    s = s + "  n = a->n;\n";
    s = s + "  for (i = 0; i < rank; i++) shape[i] = a->shape[i];\n";
    s = s + "  ad = a->data;\n";
    s = s + "  bd = b->data;\n";
    s = s + "  h = kt_alloc(shape, rank, 0);\n";
    s = s + "  o = kt_obj(h);\n";
    s = s + "  for (i = 0; i < n; i++) o->data[i] = ad[i] + bd[i];\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_relu(int64_t ha) {\n";
    s = s + "  int64_t h = kt_clone(ha);\n";
    s = s + "  KvTensor *o = kt_obj(h);\n";
    s = s + "  int i;\n";
    s = s + "  for (i = 0; i < o->n; i++)\n";
    s = s + "    if (o->data[i] < 0.0) o->data[i] = 0.0;\n";
    s = s + "  return h;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kt_matmul_ids(int64_t ha, int64_t hb) {\n";
    s = s + "  KVal r = k_t_matmul(kval_tensor(ha), kval_tensor(hb));\n";
    s = s + "  if (r.tag != KV_TENSOR) k_die(\"matmul\");\n";
    s = s + "  return r.u.i;\n";
    s = s + "}\n\n";
    s = s + "static double kt_mse(int64_t ha, int64_t hb) {\n";
    s = s + "  KvTensor *a = kt_obj(ha), *b = kt_obj(hb);\n";
    s = s + "  double acc = 0.0;\n";
    s = s + "  int i, n;\n";
    s = s + "  if (a->n != b->n) k_die(\"ag_mse size mismatch\");\n";
    s = s + "  n = a->n > 0 ? a->n : 1;\n";
    s = s + "  for (i = 0; i < a->n; i++) {\n";
    s = s + "    double d = a->data[i] - b->data[i];\n";
    s = s + "    acc += d * d;\n";
    s = s + "  }\n";
    s = s + "  return acc / (double)n;\n";
    s = s + "}\n\n";
    s = s + "static void kvag_clear(void) { g_kvag.n = 0; }\n\n";
    s = s + "static KvAgNode *kvag_node(int64_t id) {\n";
    s = s + "  if (id < 0 || id >= (int64_t)g_kvag.n) k_die(\"ag: bad node id\");\n";
    s = s + "  return &g_kvag.nodes[id];\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_push(KvAgNode node) {\n";
    s = s + "  if (g_kvag.n >= KVAG_MAX_NODES) k_die(\"ag: tape full\");\n";
    s = s + "  g_kvag.nodes[g_kvag.n] = node;\n";
    s = s + "  return (int64_t)g_kvag.n++;\n";
    s = s + "}\n\n";
    s = s + "static void kvag_accum_tensor(KvAgNode *n, int64_t add_th) {\n";
    s = s + "  KvTensor *add;\n";
    s = s + "  int i;\n";
    s = s + "  if (!n->has_grad) {\n";
    s = s + "    n->has_grad = 1;\n";
    s = s + "    n->grad_is_scalar = 0;\n";
    s = s + "    n->gth = kt_clone(add_th);\n";
    s = s + "    return;\n";
    s = s + "  }\n";
    s = s + "  if (n->grad_is_scalar) k_die(\"ag: grad type mismatch\");\n";
    s = s + "  add = kt_obj(add_th);\n";
    s = s + "  {\n";
    s = s + "    KvTensor *g = kt_obj(n->gth);\n";
    s = s + "    if (g->n != add->n) k_die(\"ag: grad len mismatch\");\n";
    s = s + "    for (i = 0; i < g->n; i++) g->data[i] += add->data[i];\n";
    s = s + "  }\n";
    s = s + "}\n\n";
    s = s + "static void kvag_accum_scalar(KvAgNode *n, double add) {\n";
    s = s + "  if (!n->has_grad) { n->has_grad = 1; n->grad_is_scalar = 1; n->gscalar = add; return; }\n";
    s = s + "  if (!n->grad_is_scalar) k_die(\"ag: grad type mismatch\");\n";
    s = s + "  n->gscalar += add;\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_leaf(int64_t th, int requires_grad) {\n";
    s = s + "  KvAgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  n.th = kt_clone(th);\n";
    s = s + "  n.op = KVAG_LEAF;\n";
    s = s + "  n.requires_grad = requires_grad;\n";
    s = s + "  n.pa = n.pb = -1;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_leaf_f(double x, int requires_grad) {\n";
    s = s + "  KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  n.is_scalar = 1; n.scalar = x; n.op = KVAG_LEAF; n.requires_grad = requires_grad; n.pa = n.pb = -1;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_matmul(int64_t a, int64_t b) {\n";
    s = s + "  KvAgNode *na = kvag_node(a), *nb = kvag_node(b);\n";
    s = s + "  KvAgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar || nb->is_scalar) k_die(\"ag_matmul expects tensors\");\n";
    s = s + "  n.th = kt_matmul_ids(na->th, nb->th);\n";
    s = s + "  n.op = KVAG_MATMUL;\n";
    s = s + "  n.pa = (int)a;\n";
    s = s + "  n.pb = (int)b;\n";
    s = s + "  n.requires_grad = na->requires_grad || nb->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_mse(int64_t p, int64_t t) {\n";
    s = s + "  KvAgNode *np = kvag_node(p), *nt = kvag_node(t);\n";
    s = s + "  KvAgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (np->is_scalar || nt->is_scalar) k_die(\"ag_mse expects tensors\");\n";
    s = s + "  n.is_scalar = 1;\n";
    s = s + "  n.scalar = kt_mse(np->th, nt->th);\n";
    s = s + "  n.op = KVAG_MSE;\n";
    s = s + "  n.pa = (int)p;\n";
    s = s + "  n.pb = (int)t;\n";
    s = s + "  n.requires_grad = np->requires_grad || nt->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_add(int64_t a, int64_t b) {\n";
    s = s + "  KvAgNode *na = kvag_node(a), *nb = kvag_node(b);\n";
    s = s + "  KvAgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar || nb->is_scalar) k_die(\"ag_add expects tensors\");\n";
    s = s + "  n.th = kt_ew_add(na->th, nb->th);\n";
    s = s + "  n.op = KVAG_ADD;\n";
    s = s + "  n.pa = (int)a;\n";
    s = s + "  n.pb = (int)b;\n";
    s = s + "  n.requires_grad = na->requires_grad || nb->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_relu(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a);\n";
    s = s + "  KvAgNode n;\n";
    s = s + "  memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) k_die(\"ag_relu expects tensors\");\n";
    s = s + "  n.th = kt_relu(na->th);\n";
    s = s + "  n.op = KVAG_RELU;\n";
    s = s + "  n.pa = (int)a;\n";
    s = s + "  n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_sub(int64_t a, int64_t b) {\n";
    s = s + "  KvAgNode *na = kvag_node(a), *nb = kvag_node(b); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar || nb->is_scalar) k_die(\"ag_sub expects tensors\");\n";
    s = s + "  n.th = kt_ew_sub(na->th, nb->th); n.op = KVAG_SUB; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "  n.requires_grad = na->requires_grad || nb->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_mul(int64_t a, int64_t b) {\n";
    s = s + "  KvAgNode *na = kvag_node(a), *nb = kvag_node(b); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar || nb->is_scalar) k_die(\"ag_mul expects tensors\");\n";
    s = s + "  n.th = kt_ew_mul(na->th, nb->th); n.op = KVAG_MUL; n.pa = (int)a; n.pb = (int)b;\n";
    s = s + "  n.requires_grad = na->requires_grad || nb->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_scale(int64_t a, double s) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) { n.is_scalar = 1; n.scalar = na->scalar * s; } else n.th = kt_scale(na->th, s);\n";
    s = s + "  n.op = KVAG_SCALE; n.pa = (int)a; n.pb = -1; n.scale = s; n.requires_grad = na->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_neg(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) { n.is_scalar = 1; n.scalar = -na->scalar; } else n.th = kt_scale(na->th, -1.0);\n";
    s = s + "  n.op = KVAG_NEG; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_transpose(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) k_die(\"ag_transpose expects tensor\");\n";
    s = s + "  n.th = kt_transpose(na->th); n.op = KVAG_TRANSPOSE; n.pa = (int)a; n.pb = -1;\n";
    s = s + "  n.requires_grad = na->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_reshape(int64_t a, const int *shape, int rank) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvTensor *t; KvAgNode n; int i, need;\n";
    s = s + "  memset(&n, 0, sizeof(n)); if (na->is_scalar) k_die(\"ag_reshape expects tensor\");\n";
    s = s + "  t = kt_obj(na->th); n.old_rank = t->rank; for (i = 0; i < t->rank; i++) n.old_shape[i] = t->shape[i];\n";
    s = s + "  need = kt_product(shape, rank); if (need != t->n) k_die(\"ag_reshape size mismatch\");\n";
    s = s + "  n.th = kt_alloc(shape, rank, 0); memcpy(kt_obj(n.th)->data, t->data, (size_t)t->n * sizeof(double));\n";
    s = s + "  n.op = KVAG_RESHAPE; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad;\n";
    s = s + "  return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_exp(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) { n.is_scalar = 1; n.scalar = exp(na->scalar); } else n.th = kt_exp(na->th);\n";
    s = s + "  n.op = KVAG_EXP; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_log(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) { double x = na->scalar < 1e-12 ? 1e-12 : na->scalar; n.is_scalar = 1; n.scalar = log(x); }\n";
    s = s + "  else n.th = kt_log(na->th);\n";
    s = s + "  n.op = KVAG_LOG; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_softmax(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  if (na->is_scalar) { n.is_scalar = 1; n.scalar = 1.0; } else n.th = kt_softmax(na->th);\n";
    s = s + "  n.op = KVAG_SOFTMAX; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; return kvag_push(n);\n";
    s = s + "}\n";
    s = s + "static int64_t kvag_sum(int64_t a) {\n";
    s = s + "  KvAgNode *na = kvag_node(a); KvAgNode n; memset(&n, 0, sizeof(n));\n";
    s = s + "  n.is_scalar = 1; n.scalar = na->is_scalar ? na->scalar : kt_sum(na->th);\n";
    s = s + "  n.op = KVAG_SUM; n.pa = (int)a; n.pb = -1; n.requires_grad = na->requires_grad; return kvag_push(n);\n";
    s = s + "}\n\n";
    s = s + "static void kvag_backward(int64_t loss_id) {\n";
    s = s + "  int i;\n";
    s = s + "  if (loss_id < 0 || loss_id >= (int64_t)g_kvag.n) k_die(\"ag_backward: bad loss id\");\n";
    s = s + "  for (i = 0; i < g_kvag.n; i++) g_kvag.nodes[i].has_grad = 0;\n";
    s = s + "  {\n";
    s = s + "    KvAgNode *loss = &g_kvag.nodes[loss_id];\n";
    s = s + "    if (loss->is_scalar) {\n";
    s = s + "      loss->has_grad = 1;\n";
    s = s + "      loss->grad_is_scalar = 1;\n";
    s = s + "      loss->gscalar = 1.0;\n";
    s = s + "    } else {\n";
    s = s + "      KvTensor *t = kt_obj(loss->th);\n";
    s = s + "      int64_t h = kt_alloc(t->shape, t->rank, 0);\n";
    s = s + "      KvTensor *o = kt_obj(h);\n";
    s = s + "      int j;\n";
    s = s + "      for (j = 0; j < o->n; j++) o->data[j] = 1.0;\n";
    s = s + "      loss->has_grad = 1;\n";
    s = s + "      loss->grad_is_scalar = 0;\n";
    s = s + "      loss->gth = h;\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "  for (i = (int)loss_id; i >= 0; i--) {\n";
    s = s + "    KvAgNode *node = &g_kvag.nodes[i];\n";
    s = s + "    if (!node->has_grad) continue;\n";
    s = s + "    switch (node->op) {\n";
    s = s + "    case KVAG_LEAF:\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_MATMUL: {\n";
    s = s + "      KvAgNode *a = &g_kvag.nodes[node->pa], *b = &g_kvag.nodes[node->pb];\n";
    s = s + "      int64_t bt = kt_transpose(b->th);\n";
    s = s + "      int64_t at = kt_transpose(a->th);\n";
    s = s + "      int64_t ga = kt_matmul_ids(node->gth, bt);\n";
    s = s + "      int64_t gb = kt_matmul_ids(at, node->gth);\n";
    s = s + "      kvag_accum_tensor(a, ga);\n";
    s = s + "      kvag_accum_tensor(b, gb);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_MSE: {\n";
    s = s + "      KvAgNode *p = &g_kvag.nodes[node->pa], *t = &g_kvag.nodes[node->pb];\n";
    s = s + "      double g = node->grad_is_scalar ? node->gscalar : 1.0;\n";
    s = s + "      int64_t err = kt_ew_sub(p->th, t->th);\n";
    s = s + "      KvTensor *e = kt_obj(err);\n";
    s = s + "      double scale = 2.0 * g / (e->n > 0 ? (double)e->n : 1.0);\n";
    s = s + "      int64_t gp = kt_scale(err, scale);\n";
    s = s + "      int64_t gt = kt_scale(err, -scale);\n";
    s = s + "      kvag_accum_tensor(p, gp);\n";
    s = s + "      kvag_accum_tensor(t, gt);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_ADD:\n";
    s = s + "      if (node->grad_is_scalar) k_die(\"ag add grad\");\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pa], node->gth);\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pb], node->gth);\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_SUB: {\n";
    s = s + "      if (node->grad_is_scalar) k_die(\"ag sub grad\");\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pa], node->gth);\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pb], kt_scale(node->gth, -1.0));\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_MUL: {\n";
    s = s + "      KvAgNode *a = &g_kvag.nodes[node->pa], *b = &g_kvag.nodes[node->pb];\n";
    s = s + "      kvag_accum_tensor(a, kt_ew_mul(node->gth, b->th));\n";
    s = s + "      kvag_accum_tensor(b, kt_ew_mul(node->gth, a->th));\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_SCALE:\n";
    s = s + "      if (node->grad_is_scalar) kvag_accum_scalar(&g_kvag.nodes[node->pa], node->gscalar * node->scale);\n";
    s = s + "      else kvag_accum_tensor(&g_kvag.nodes[node->pa], kt_scale(node->gth, node->scale));\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_NEG:\n";
    s = s + "      if (node->grad_is_scalar) kvag_accum_scalar(&g_kvag.nodes[node->pa], -node->gscalar);\n";
    s = s + "      else kvag_accum_tensor(&g_kvag.nodes[node->pa], kt_scale(node->gth, -1.0));\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_TRANSPOSE:\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pa], kt_transpose(node->gth));\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_RESHAPE: {\n";
    s = s + "      KvTensor *g = kt_obj(node->gth); int64_t h = kt_alloc(node->old_shape, node->old_rank, 0);\n";
    s = s + "      memcpy(kt_obj(h)->data, g->data, (size_t)g->n * sizeof(double));\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pa], h);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_EXP:\n";
    s = s + "      if (node->is_scalar) kvag_accum_scalar(&g_kvag.nodes[node->pa], node->gscalar * node->scalar);\n";
    s = s + "      else kvag_accum_tensor(&g_kvag.nodes[node->pa], kt_ew_mul(node->gth, node->th));\n";
    s = s + "      break;\n";
    s = s + "    case KVAG_LOG: {\n";
    s = s + "      KvAgNode *a = &g_kvag.nodes[node->pa];\n";
    s = s + "      if (node->grad_is_scalar) {\n";
    s = s + "        double x = a->is_scalar ? a->scalar : 1.0; if (x < 1e-12) x = 1e-12;\n";
    s = s + "        kvag_accum_scalar(a, node->gscalar / x);\n";
    s = s + "      } else {\n";
    s = s + "        KvTensor *xv = kt_obj(a->th), *gg = kt_obj(node->gth);\n";
    s = s + "        int64_t h = kt_clone(node->gth); KvTensor *o = kt_obj(h); int j;\n";
    s = s + "        for (j = 0; j < o->n; j++) { double x = xv->data[j] < 1e-12 ? 1e-12 : xv->data[j]; o->data[j] = gg->data[j] / x; }\n";
    s = s + "        kvag_accum_tensor(a, h);\n";
    s = s + "      }\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_SOFTMAX: {\n";
    s = s + "      KvTensor *y = kt_obj(node->th), *gy = kt_obj(node->gth);\n";
    s = s + "      double dot = 0.0; int j; int64_t h; KvTensor *o;\n";
    s = s + "      if (y->n != gy->n) k_die(\"ag softmax grad len\");\n";
    s = s + "      for (j = 0; j < y->n; j++) dot += gy->data[j] * y->data[j];\n";
    s = s + "      h = kt_clone(node->th); o = kt_obj(h);\n";
    s = s + "      for (j = 0; j < o->n; j++) o->data[j] = y->data[j] * (gy->data[j] - dot);\n";
    s = s + "      kvag_accum_tensor(&g_kvag.nodes[node->pa], h);\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_SUM: {\n";
    s = s + "      KvAgNode *a = &g_kvag.nodes[node->pa];\n";
    s = s + "      double g = node->grad_is_scalar ? node->gscalar : 1.0;\n";
    s = s + "      if (a->is_scalar) kvag_accum_scalar(a, g);\n";
    s = s + "      else kvag_accum_tensor(a, kt_fill_like(a->th, g));\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    case KVAG_RELU: {\n";
    s = s + "      KvAgNode *a = &g_kvag.nodes[node->pa];\n";
    s = s + "      if (node->grad_is_scalar) k_die(\"ag relu grad\");\n";
    s = s + "      {\n";
    s = s + "        KvTensor *av = kt_obj(a->th);\n";
    s = s + "        int64_t h = kt_clone(node->gth);\n";
    s = s + "        KvTensor *o = kt_obj(h);\n";
    s = s + "        int j;\n";
    s = s + "        for (j = 0; j < o->n; j++)\n";
    s = s + "          if (av->data[j] <= 0.0) o->data[j] = 0.0;\n";
    s = s + "        kvag_accum_tensor(a, h);\n";
    s = s + "      }\n";
    s = s + "      break;\n";
    s = s + "    }\n";
    s = s + "    default:\n";
    s = s + "      k_die(\"ag_backward: unknown op\");\n";
    s = s + "    }\n";
    s = s + "  }\n";
    s = s + "}\n\n";
    s = s + "static int64_t kvag_step(int64_t param_id, double lr) {\n";
    s = s + "  KvAgNode *n = kvag_node(param_id);\n";
    s = s + "  int64_t step, out;\n";
    s = s + "  if (!n->has_grad) k_die(\"ag_step: missing grad\");\n";
    s = s + "  if (n->is_scalar || n->grad_is_scalar) k_die(\"ag_step expects tensor param\");\n";
    s = s + "  step = kt_scale(n->gth, lr);\n";
    s = s + "  out = kt_ew_sub(n->th, step);\n";
    s = s + "  return out;\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_clear(void) {\n";
    s = s + "  kvag_clear();\n";
    s = s + "  return kval_i64(0);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_param(KVal t) {\n";
    s = s + "  if (t.tag != KV_TENSOR) k_die(\"ag_param expects tensor\");\n";
    s = s + "  return kval_i64(kvag_leaf(t.u.i, 1));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_const(KVal t) {\n";
    s = s + "  if (t.tag == KV_TENSOR) return kval_i64(kvag_leaf(t.u.i, 0));\n";
    s = s + "  if (t.tag == KV_F64 || t.tag == KV_I64) return kval_i64(kvag_leaf_f(kval_as_f64(t), 0));\n";
    s = s + "  k_die(\"ag_const expects tensor or number\"); return kval_i64(0);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_matmul(KVal a, KVal b) {\n";
    s = s + "  return kval_i64(kvag_matmul(kval_as_i64(a), kval_as_i64(b)));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_mse(KVal a, KVal b) {\n";
    s = s + "  return kval_i64(kvag_mse(kval_as_i64(a), kval_as_i64(b)));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_add(KVal a, KVal b) {\n";
    s = s + "  return kval_i64(kvag_add(kval_as_i64(a), kval_as_i64(b)));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_relu(KVal a) {\n";
    s = s + "  return kval_i64(kvag_relu(kval_as_i64(a)));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_sub(KVal a, KVal b) { return kval_i64(kvag_sub(kval_as_i64(a), kval_as_i64(b))); }\n";
    s = s + "static KVal k_ag_mul(KVal a, KVal b) { return kval_i64(kvag_mul(kval_as_i64(a), kval_as_i64(b))); }\n";
    s = s + "static KVal k_ag_scale(KVal a, KVal s) { return kval_i64(kvag_scale(kval_as_i64(a), kval_as_f64(s))); }\n";
    s = s + "static KVal k_ag_neg(KVal a) { return kval_i64(kvag_neg(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_transpose(KVal a) { return kval_i64(kvag_transpose(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_reshape(KVal a, KVal sh) {\n";
    s = s + "  int64_t dims[8]; int ishape[8]; int rank, i;\n";
    s = s + "  rank = kval_list_to_i64s(sh, dims, 8);\n";
    s = s + "  for (i = 0; i < rank; i++) ishape[i] = (int)dims[i];\n";
    s = s + "  return kval_i64(kvag_reshape(kval_as_i64(a), ishape, rank));\n";
    s = s + "}\n";
    s = s + "static KVal k_ag_exp(KVal a) { return kval_i64(kvag_exp(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_log(KVal a) { return kval_i64(kvag_log(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_softmax(KVal a) { return kval_i64(kvag_softmax(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_sum(KVal a) { return kval_i64(kvag_sum(kval_as_i64(a))); }\n";
    s = s + "static KVal k_ag_value(KVal id) {\n";
    s = s + "  KvAgNode *n = kvag_node(kval_as_i64(id));\n";
    s = s + "  if (n->is_scalar) return kval_f64(n->scalar);\n";
    s = s + "  return kval_tensor(kt_clone(n->th));\n";
    s = s + "}\n";
    s = s + "static KVal k_ag_grad(KVal id) {\n";
    s = s + "  KvAgNode *n = kvag_node(kval_as_i64(id));\n";
    s = s + "  if (!n->has_grad) k_die(\"ag_grad: no grad\");\n";
    s = s + "  if (n->grad_is_scalar) return kval_f64(n->gscalar);\n";
    s = s + "  return kval_tensor(kt_clone(n->gth));\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_backward(KVal loss) {\n";
    s = s + "  kvag_backward(kval_as_i64(loss));\n";
    s = s + "  return kval_i64(0);\n";
    s = s + "}\n\n";
    s = s + "static KVal k_ag_step(KVal param, KVal lr) {\n";
    s = s + "  return kval_tensor(kvag_step(kval_as_i64(param), kval_as_f64(lr)));\n";
    s = s + "}\n";
    s = s + "#endif /* KENGA_RT_KVAL_TAPE_INC */\n";

    assert(write_file("bootstrap/generated/rt_kval_tape.inc.c", s) == true);
    println("rt_kval_tape ok");
    return 0;
}
