// Prophet chat on ml_host / native_ml lists. CRT: file_exists / read_line / argc.
// kenga-lite chat [mind.km] [--script file] -> this file (lite + inject)

fn parse_f(s: str) -> f64 {
    let sign: f64 = 1.0;
    let i: i64 = 0;
    if len(s) > 0 {
        if s[0] == "-" { sign = 0.0 - 1.0; i = 1; }
    }
    let ip: f64 = 0.0;
    while i < len(s) {
        if s[i] == "." { break; }
        if s[i] == "e" { break; }
        if s[i] == "E" { break; }
        ip = ip * 10.0 + (ord(s[i]) - 48) + 0.0;
        i = i + 1;
    }
    let fp: f64 = 0.0;
    let place: f64 = 0.1;
    if i < len(s) {
        if s[i] == "." {
            i = i + 1;
            while i < len(s) {
                if s[i] == "e" { break; }
                if s[i] == "E" { break; }
                fp = fp + ((ord(s[i]) - 48) + 0.0) * place;
                place = place * 0.1;
                i = i + 1;
            }
        }
    }
    return sign * (ip + fp);
}

fn has(hay: str, needle: str) -> i64 {
    let n: i64 = len(needle);
    let m: i64 = len(hay);
    if n < 1 { return 0; }
    if n > m { return 0; }
    let i: i64 = 0;
    while i + n <= m {
        let ok: i64 = 1;
        let j: i64 = 0;
        while j < n {
            if hay[i + j] != needle[j] { ok = 0; }
            j = j + 1;
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn has_any(hay: str, xs: list) -> i64 {
    let i: i64 = 0;
    while i < len(xs) {
        if has(hay, xs[i]) == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ascii_lower(s: str) -> str {
    let abc: str = "abcdefghijklmnopqrstuvwxyz";
    let out: str = "";
    let i: i64 = 0;
    while i < len(s) {
        let o: i64 = ord(s[i]);
        if o >= 65 {
            if o <= 90 {
                out = out + abc[o - 65];
                i = i + 1;
                continue;
            }
        }
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

fn trim(s: str) -> str {
    let a: i64 = 0;
    let b: i64 = len(s);
    while a < b {
        let o: i64 = ord(s[a]);
        if o == 32 { a = a + 1; continue; }
        if o == 9 { a = a + 1; continue; }
        break;
    }
    while b > a {
        let o: i64 = ord(s[b - 1]);
        if o == 32 { b = b - 1; continue; }
        if o == 9 { b = b - 1; continue; }
        if o == 13 { b = b - 1; continue; }
        if o == 10 { b = b - 1; continue; }
        break;
    }
    let out: str = "";
    let i: i64 = a;
    while i < b {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

fn is_num_start(o: i64) -> i64 {
    if o == 45 { return 1; }
    if o == 46 { return 1; }
    if o >= 48 {
        if o <= 57 { return 1; }
    }
    return 0;
}

fn extract_nums(s: str) -> list {
    let xs: list = [];
    let i: i64 = 0;
    let n: i64 = len(s);
    while i < n {
        if is_num_start(ord(s[i])) == 0 {
            i = i + 1;
            continue;
        }
        let tok: str = "";
        let j: i64 = i;
        let digits: i64 = 0;
        while j < n {
            let c: i64 = ord(s[j]);
            let ok: i64 = 0;
            if c == 45 { ok = 1; }
            if c == 43 { ok = 1; }
            if c == 46 { ok = 1; }
            if c == 101 { ok = 1; }
            if c == 69 { ok = 1; }
            if c >= 48 {
                if c <= 57 {
                    ok = 1;
                    digits = 1;
                }
            }
            if ok == 0 { break; }
            tok = tok + s[j];
            j = j + 1;
        }
        if digits == 1 { xs = push(xs, parse_f(tok)); }
        if j == i { i = i + 1; } else { i = j; }
    }
    return xs;
}

fn is_num_line(s: str) -> i64 {
    if len(s) < 1 { return 0; }
    let i: i64 = 0;
    while i < len(s) {
        let o: i64 = ord(s[i]);
        let ok: i64 = 0;
        if o == 32 { ok = 1; }
        if o == 9 { ok = 1; }
        if o == 45 { ok = 1; }
        if o == 43 { ok = 1; }
        if o == 46 { ok = 1; }
        if o == 101 { ok = 1; }
        if o == 69 { ok = 1; }
        if o >= 48 {
            if o <= 57 { ok = 1; }
        }
        if ok == 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

fn take(xs: list, a: i64, b: i64) -> list {
    let o: list = [];
    let i: i64 = a;
    while i < b {
        o = push(o, xs[i]);
        i = i + 1;
    }
    return o;
}

fn fmt_round(xs: list) -> str {
    let s: str = "";
    let i: i64 = 0;
    while i < len(xs) {
        if i > 0 { s = s + " "; }
        s = s + to_str(round(xs[i] + 0.0));
        i = i + 1;
    }
    return s;
}

fn print_help() -> i64 {
    println("talk:     привет | ты кто | что умеешь | поговорим | честно");
    println("model:    смотри 5 1 6 | что будет через 4 | обучи 10");
    println("memory:   научи 5 1 6 -> 6 1 5 | вспомни … | спи | сохрани");
    println("quit:     выход / quit");
    println("(native_ml, not C Prophet)");
    return 0;
}

fn open_mind(path: str) -> list {
    if file_exists(path) == 0 {
        println("new mind -> will save to " + path);
        return memory_config(0.05, 128, 48);
    }
    let s: str = read_file(path);
    if has(s, "MORE_MIND") == 1 {
        println("loading " + path);
        return load_mind(path);
    }
    println("old format " + path + " -- new mind (MORE_MIND)");
    return memory_config(0.05, 128, 48);
}

fn phys_x(last: list) -> list {
    if len(last) >= 3 { return take(last, 0, 3); }
    return [5.0, 1.0, 6.0];
}

fn phys_y(x: list) -> list {
    return [x[0] + x[1], x[1] - 0.1, x[2] - 0.05];
}

fn train_epoch(m: list, last: list) -> f64 {
    let x = phys_x(last);
    return learn(m, x, phys_y(x));
}

fn handle(st: list, line: str) -> i64 {
    let m = st[0];
    let last = st[1];
    let path: str = st[2];
    let low: str = ascii_lower(line);
    let nums = extract_nums(line);
    let nn: i64 = len(nums);

    if has_any(low, ["quit", "exit", "выход", "пока"]) == 1 {
        println("пока -- mind on disk if you saved");
        return 0;
    }
    if has_any(low, ["привет", "hello", "hi", "здравств", "hey"]) == 1 {
        println("привет. world-model Kenga on native_ml (steps=" + to_str(m[6]) + ", dim=" + to_str(m[5]) + ").");
        if m[5] >= 9 {
            println("this mind is multimodal: image+sound -> vector -> predict.");
        } else {
            println("this mind is agent physics [pos vel fuel].");
        }
        println("try: «что умеешь», «поговорим», «смотри…», «помощь».");
        return 1;
    }
    if has_any(low, ["что умеешь", "что ты умеешь", "что можешь", "возможности", "capabilities"]) == 1 {
        println("can do now (native_ml):");
        println("  • predict next vector (predict / unroll)");
        println("  • surprise + episodes; sleep (consolidate)");
        println("  • save/load MORE_MIND, not C Prophet");
        if m[5] >= 9 { println("  • multimodal obs dim=" + to_str(m[5])); }
        println("cannot: free chat like a big LLM.");
        return 1;
    }
    if has_any(low, ["поговори", "поговорим", "просто поговорить", "хочу поговорить", "давай болтать"]) == 1 {
        println("ok. I talk about what the model body remembers.");
        println("now: steps=" + to_str(m[6]) + " dim=" + to_str(m[5]) + " ep=" + to_str(len(m[11])) + ".");
        println("for the ceiling -- «честно».");
        return 1;
    }
    if has_any(low, ["ты кто", "кто ты", "расскажи о себе", "о себе", "what are you", "who are you", "что ты такое"]) == 1 {
        println("Prophet-mind: residual MLP, dim=" + to_str(m[5]) + ", hidden=" + to_str(m[3]) + ", steps=" + to_str(m[6]) + ".");
        println("episodic=" + to_str(len(m[11])) + ". sense->learn->sleep.");
        if m[5] >= 9 { println("trained on PPM+WAV (living multimodal)."); }
        println("not a chat-LLM -- loop on native_ml.");
        return 1;
    }
    if has_any(low, ["честно", "ты ии", "ты llm", "как grok", "как gpt", "нейросеть", "языковая модель", "это всё"]) == 1 {
        println("честно: I am a world-model (vectors -> vectors), not a language model.");
        println("smart like Grok = tiny LM -> data -> f32/GPU. living loop is already here.");
        return 1;
    }
    if low == "?" {
        print_help();
        return 1;
    }
    if low == "help" {
        print_help();
        return 1;
    }
    if has(low, "помощь") == 1 {
        print_help();
        return 1;
    }
    if has_any(low, ["status", "статус", "как дела", "stats"]) == 1 {
        let stt = mem_stats(m);
        println("I remember: ep=" + to_str(stt[0]) + " steps=" + to_str(m[6]) + " dim=" + to_str(m[5]) + "x" + to_str(m[3]) + " (lr=" + to_str(m[4]) + ")");
        return 1;
    }
    if has_any(low, ["sleep", "спи", "консолид", "засни"]) == 1 {
        println("sleep: folded " + to_str(consolidate(m)));
        return 1;
    }
    if has_any(low, ["save", "сохрани", "запиши mind"]) == 1 {
        if save_mind(m, path) == 1 {
            println("saved " + path);
        } else {
            println("could not save " + path);
        }
        return 1;
    }
    if has_any(low, ["load", "загрузи"]) == 1 {
        st[0] = open_mind(path);
        println("loaded " + path);
        return 1;
    }
    if has_any(low, ["train", "обучи", "тренир", "учись"]) == 1 {
        let epochs: i64 = 8;
        if nn > 0 { epochs = round(nums[0]); }
        if epochs < 1 { epochs = 1; }
        if epochs > 64 { epochs = 64; }
        println("training " + to_str(epochs) + " epochs...");
        let e: i64 = 0;
        while e < epochs {
            let loss: f64 = train_epoch(m, last);
            println("  epoch " + to_str(e) + ": loss=" + to_str(loss));
            e = e + 1;
        }
        println("slept, folded episodes: " + to_str(consolidate(m)));
        return 1;
    }
    if has_any(low, ["future", "будущ", "через", "что будет", "unroll", "предскажи", "завтра", "скоро", "дальше"]) == 1 {
        let steps: i64 = 4;
        let obs: list = [];
        if has(low, "завтра") == 1 { steps = 1; }
        if has(low, "скоро") == 1 { steps = 1; }
        if nn >= 4 {
            steps = round(nums[nn - 1]);
            obs = take(nums, 0, nn - 1);
        } else {
            if nn == 1 {
                if has(low, "смотри") == 0 {
                    steps = round(nums[0]);
                    obs = last;
                    if len(obs) < 1 {
                        println("first «смотри 5 1 6», then «что будет…»");
                        return 1;
                    }
                } else {
                    obs = last;
                }
            } else {
                if nn >= 3 {
                    obs = nums;
                } else {
                    obs = last;
                    if len(obs) < 1 {
                        println("usage: future n | future a b c n");
                        return 1;
                    }
                }
            }
        }
        if steps < 1 { steps = 1; }
        let traj = foresee_n(m, obs, steps);
        println("if start " + fmt_round(obs) + ", then after " + to_str(steps) + " steps:");
        let i: i64 = 0;
        while i < len(traj) {
            println("  +" + to_str(i + 1) + " → " + fmt_round(traj[i]));
            i = i + 1;
        }
        st[1] = obs;
        return 1;
    }
    if has_any(low, ["see", "смотри", "наблюд", "сейчас", "состояние", "sense"]) == 1 {
        if nn < 1 {
            print_help();
            return 1;
        }
        let pred = predict(m, nums);
        let fore = foresee(m, nums);
        let s: f64 = surprise(pred, nums);
        println("сейчас     " + fmt_round(nums));
        println("expect      " + fmt_round(pred));
        println("hybrid      " + fmt_round(fore));
        if s > 0.5 {
            println("this is odd for me (surprise=" + to_str(s) + ")");
        } else {
            println("looks familiar (surprise=" + to_str(s) + ")");
        }
        st[1] = nums;
        return 1;
    }
    if is_num_line(line) == 1 {
        if nn < 1 {
            print_help();
            return 1;
        }
        let pred2 = predict(m, nums);
        let fore2 = foresee(m, nums);
        let s2: f64 = surprise(pred2, nums);
        println("сейчас     " + fmt_round(nums));
        println("expect      " + fmt_round(pred2));
        println("hybrid      " + fmt_round(fore2));
        if s2 > 0.5 {
            println("this is odd for me (surprise=" + to_str(s2) + ")");
        } else {
            println("looks familiar (surprise=" + to_str(s2) + ")");
        }
        st[1] = nums;
        return 1;
    }
    if has_any(low, ["teach", "научи", "запомни", "выучи"]) == 1 {
        if nn < 2 {
            println("usage: научи 5 1 6 -> 6 1 5");
            return 1;
        }
        let mid: i64 = nn / 2;
        let a = take(nums, 0, mid);
        let b = take(nums, mid, nn);
        remember_next(m, a, b, 0.6);
        let loss: f64 = learn(m, a, b);
        println("remembered " + fmt_round(a) + " → " + fmt_round(b) + "  (loss=" + to_str(loss) + ")");
        return 1;
    }
    if has(line, "->") == 1 {
        if nn < 2 {
            println("usage: научи 5 1 6 -> 6 1 5");
            return 1;
        }
        let mid2: i64 = nn / 2;
        let a2 = take(nums, 0, mid2);
        let b2 = take(nums, mid2, nn);
        remember_next(m, a2, b2, 0.6);
        let loss2: f64 = learn(m, a2, b2);
        println("remembered " + fmt_round(a2) + " → " + fmt_round(b2) + "  (loss=" + to_str(loss2) + ")");
        return 1;
    }
    if has_any(low, ["recall", "вспомни", "похож"]) == 1 {
        if nn < 1 {
            print_help();
            return 1;
        }
        let hits = recall(m, nums, 3);
        println("nearest traces to " + fmt_round(nums) + ":");
        let hi: i64 = 0;
        while hi < len(hits) {
            println("  [" + to_str(hi) + "] " + fmt_round(hits[hi]));
            hi = hi + 1;
        }
        return 1;
    }
    println("unknown command: «" + line + "»");
    println("I am a world-model (dim=" + to_str(m[5]) + ", steps=" + to_str(m[6]) + "), not a free chatbot.");
    println("try «что умеешь», «поговорим», «честно» or «помощь».");
    return 1;
}

fn run_script(st: list, body: str) -> i64 {
    let i: i64 = 0;
    while i < len(body) {
        let line: str = "";
        while i < len(body) {
            let o: i64 = ord(body[i]);
            if o == 10 { break; }
            if o == 13 { break; }
            line = line + body[i];
            i = i + 1;
        }
        if i < len(body) {
            if ord(body[i]) == 13 {
                i = i + 1;
                if i < len(body) {
                    if ord(body[i]) == 10 { i = i + 1; }
                }
            } else {
                i = i + 1;
            }
        }
        line = trim(line);
        if len(line) < 1 { continue; }
        if line[0] == "#" { continue; }
        println("> " + line);
        if handle(st, line) == 0 { return 0; }
    }
    return 0;
}

fn main() -> i64 {
    let path: str = "minds/agent.km";
    if argc() >= 2 {
        if arg(1) != "" { path = arg(1); }
    }
    let script: str = "";
    if argc() >= 3 { script = arg(2); }
    let m = open_mind(path);
    let st: list = [m, [], path];
    println("Kenga chat -- living world-model (native_ml, not C Prophet)");
    println("talk: «привет», «ты кто», «что умеешь», «поговорим», «честно»");
    println("model: «смотри 5 1 6», «что будет через 4», «обучи», «статус»");
    println("");
    if script != "" {
        if file_exists(script) == 0 {
            println("cannot read script " + script);
            return 1;
        }
        return run_script(st, read_file(script));
    }
    while true {
        print("kenga> ");
        let rl = read_line();
        if rl[0] == 0 { break; }
        let line: str = trim(rl[1]);
        if len(line) < 1 { continue; }
        if handle(st, line) == 0 { break; }
    }
    return 0;
}
