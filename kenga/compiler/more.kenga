fn OP_AG_ADD() -> i64 { return 71; }
fn OP_AG_SUB() -> i64 { return 72; }
fn OP_AG_MUL() -> i64 { return 73; }
fn OP_AG_MATMUL() -> i64 { return 74; }
fn OP_AG_SCALE() -> i64 { return 75; }
fn OP_AG_RELU() -> i64 { return 76; }
fn OP_AG_NEG() -> i64 { return 77; }
fn OP_AG_TRANSPOSE() -> i64 { return 78; }
fn OP_AG_RESHAPE() -> i64 { return 79; }
fn OP_AG_EXP() -> i64 { return 80; }
fn OP_AG_SOFTMAX() -> i64 { return 81; }
fn OP_AG_MSE() -> i64 { return 82; }
fn OP_AG_SUM() -> i64 { return 83; }
fn OP_AG_VALUE() -> i64 { return 84; }
fn OP_AG_GRAD() -> i64 { return 85; }
fn OP_AG_BACKWARD() -> i64 { return 86; }
