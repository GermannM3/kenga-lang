fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let s: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        s = digs[d] + s;
        x = x / 10;
    }
    if n < 0 { return "-" + s; }
    return s;
}

fn list_tail(xs: list) -> list {
    let out: list = [];
    let i: i64 = 1;
    while i < len(xs) { out = push(out, xs[i]); i = i + 1; }
    return out;
}

fn find_bind(binds: list, ev: str) -> list {
    // [found, addr, arity]
    let i: i64 = 0;
    while i < len(binds) {
        if binds[i][0] == ev { return [1, binds[i][1], binds[i][2]]; }
        i = i + 1;
    }
    return [0, 0, 0];
}

fn empty_lctx() -> list {
    // [conts, brkss, contss, tmpn]
    return [[], [], [], 0];
}
fn lctx_push(lctx: list, cont_target: i64) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let contss: list = lctx[2];
    conts = push(conts, cont_target);
    brkss = push(brkss, []);
    contss = push(contss, []);
    return [conts, brkss, contss, lctx[3]];
}
fn lctx_set_cont(lctx: list, cont_target: i64) -> list {
    let conts: list = lctx[0];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    conts[depth] = cont_target;
    return [conts, lctx[1], lctx[2], lctx[3]];
}
fn lctx_pop_finish(code: list, lctx: list, end_ip: i64) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let contss: list = lctx[2];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let cont_target: i64 = conts[depth];
    let brks: list = brkss[depth];
    let conts_p: list = contss[depth];
    let bi: i64 = 0;
    while bi < len(brks) {
        code[brks[bi] + 1] = end_ip;
        bi = bi + 1;
    }
    let ci: i64 = 0;
    while ci < len(conts_p) {
        code[conts_p[ci] + 1] = cont_target;
        ci = ci + 1;
    }
    let nconts: list = [];
    let nbrkss: list = [];
    let ncontss: list = [];
    let i: i64 = 0;
    while i < depth {
        nconts = push(nconts, conts[i]);
        nbrkss = push(nbrkss, brkss[i]);
        ncontss = push(ncontss, contss[i]);
        i = i + 1;
    }
    return [code, [nconts, nbrkss, ncontss, lctx[3]]];
}
fn lctx_add_break(code: list, lctx: list) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let at: i64 = len(code);
    code = emit2(code, OP_JMP(), 0);
    let brks: list = brkss[depth];
    brks = push(brks, at);
    brkss[depth] = brks;
    return [code, [conts, brkss, lctx[2], lctx[3]]];
}
fn lctx_add_continue(code: list, lctx: list) -> list {
    let conts: list = lctx[0];
    let contss: list = lctx[2];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let at: i64 = len(code);
    code = emit2(code, OP_JMP(), 0);
    let cps: list = contss[depth];
    cps = push(cps, at);
    contss[depth] = cps;
    return [code, [conts, lctx[1], contss, lctx[3]]];
}
fn skip_type_annot(s: str, i: i64) -> i64 {
    i = skip(s, i);
    if i >= len(s) { return i; }
    if s[i] != ":" { return i; }
    i = skip(s, i + 1);
    let ty = parse_ident(s, i);
    i = skip(s, ty[1]);
    if starts_kw(s, i, "ttl") == 1 {
        i = skip(s, i + 3);
        while i < len(s) {
            if is_digit(s[i]) == 0 { break; }
            i = i + 1;
        }
        if i + 1 < len(s) {
            if s[i] == "m" {
                if s[i + 1] == "s" { i = i + 2; return i; }
            }
        }
        if i < len(s) {
            if s[i] == "s" { i = i + 1; }
            if s[i] == "m" { i = i + 1; }
            if s[i] == "h" { i = i + 1; }
            if s[i] == "d" { i = i + 1; }
        }
    }
    return i;
}
fn dirname_of(path: str) -> str {
    let i: i64 = len(path) - 1;
    while i >= 0 {
        if path[i] == "/" { break; }
        if path[i] == "\\" { break; }
        i = i - 1;
    }
    if i < 0 { return "."; }
    let out: str = "";
    let j: i64 = 0;
    while j < i { out = out + path[j]; j = j + 1; }
    if len(out) == 0 { return "."; }
    return out;
}
fn join_path(dir: str, rel: str) -> str {
    if len(dir) == 0 { return rel; }
    if dir == "." { return rel; }
    return dir + "/" + rel;
}
fn resolve_imports(path: str, depth: i64) -> str {
    assert(depth < 32);
    let src: str = read_file(path);
    let dir: str = dirname_of(path);
    let i: i64 = 0;
    let acc: str = "";
    while true {
        i = skip(src, i);
        if starts_kw(src, i, "import") == 0 { break; }
        i = skip(src, i + 6);
        assert(src[i] == "\"");
        let ps = parse_string(src, i);
        i = ps[1];
        i = skip(src, i);
        if i < len(src) { if src[i] == ";" { i = i + 1; } }
        let dep_path: str = join_path(dir, ps[0]);
        acc = acc + resolve_imports(dep_path, depth + 1);
        acc = acc + "\n";
    }
    let rest: str = "";
    while i < len(src) { rest = rest + src[i]; i = i + 1; }
    return acc + rest;
}

fn list_pop(xs: list) -> list {
    let n: i64 = len(xs);
    assert(n > 0);
    let v = xs[n - 1];
    let out: list = [];
    let i: i64 = 0;
    while i < n - 1 { out = push(out, xs[i]); i = i + 1; }
    return [out, v];
}
fn ensure_slot(slots: list, si: i64) -> list {
    while len(slots) <= si { slots = push(slots, 0); }
    return slots;
}

fn vm_run(code: list, binds: list, start_ip: i64, init_slots: list, evq: list) -> list {
    // returns [result, evq]
    // fast interpreter: sp-index stack (no per-op list copies), hoisted opcode ids,
    // hot opcodes first in the dispatch chain.
    let oConst: i64 = 1;    let oLoad: i64 = 2;      let oStore: i64 = 3;
    let oAdd: i64 = 4;      let oSub: i64 = 5;       let oMul: i64 = 6;
    let oDiv: i64 = 7;      let oLt: i64 = 8;        let oGt: i64 = 9;
    let oEq: i64 = 10;      let oJmp: i64 = 11;      let oJmpf: i64 = 12;
    let oHalt: i64 = 13;    let oLe: i64 = 14;       let oCall: i64 = 15;
    let oRet: i64 = 16;     let oPrintln: i64 = 17;  let oAssert: i64 = 18;
    let oRound: i64 = 19;   let oPop: i64 = 20;      let oListNew: i64 = 21;
    let oListPush: i64 = 22; let oLen: i64 = 23;     let oGet: i64 = 24;
    let oNe: i64 = 25;      let oGe: i64 = 26;       let oOrd: i64 = 27;
    let oSet: i64 = 28;     let oEmit: i64 = 29;     let oPump: i64 = 30;
    let oPending: i64 = 31; let oWriteFile: i64 = 32; let oReadFile: i64 = 33;
    let oMod: i64 = 34;     let oAnd: i64 = 35;      let oOr: i64 = 36;
    let oNot: i64 = 37;     let oTypeof: i64 = 38;   let oToStr: i64 = 39;
    let oTFrom: i64 = 40;   let oTGet: i64 = 41;     let oTMatmul: i64 = 42;
    let oTShape: i64 = 43;  let oTAdd: i64 = 44;     let oTensor: i64 = 45;
    let oTFill: i64 = 46;   let oTSub: i64 = 47;     let oTMul: i64 = 48;
    let oTReshape: i64 = 49; let oTTranspose: i64 = 50; let oTScale: i64 = 51;
    let oTSum: i64 = 52;    let oTDot: i64 = 53;     let oTExp: i64 = 54;
    let oTLog: i64 = 55;    let oTSoftmax: i64 = 56; let oTMean: i64 = 57;
    let oTMse: i64 = 58;    let oMemConfig: i64 = 59; let oMemRemember: i64 = 60;
    let oMemSurprise: i64 = 61; let oMemForesee: i64 = 62; let oMemConsolidate: i64 = 63;
    let oMemStats: i64 = 64; let oMemRecall: i64 = 65; let oSaveMind: i64 = 66;
    let oLoadMind: i64 = 67; let oAgClear: i64 = 68;  let oAgParam: i64 = 69;
    let oAgConst: i64 = 70; let oAgAdd: i64 = 71;    let oAgSub: i64 = 72;
    let oAgMul: i64 = 73;   let oAgMatmul: i64 = 74; let oAgScale: i64 = 75;
    let oAgRelu: i64 = 76;  let oAgNeg: i64 = 77;    let oAgTranspose: i64 = 78;
    let oAgReshape: i64 = 79; let oAgExp: i64 = 80;  let oAgSoftmax: i64 = 81;
    let oAgMse: i64 = 82;   let oAgSum: i64 = 83;    let oAgValue: i64 = 84;
    let oAgGrad: i64 = 85;  let oAgBackward: i64 = 86; let oAgStep: i64 = 87;
    let oAgLog: i64 = 88;   let oTSet: i64 = 89;     let oSaveTensor: i64 = 90;
    let oLoadTensor: i64 = 91; let oSweep: i64 = 92; let oNowMs: i64 = 93;
    let oMemory: i64 = 94;  let oLoadPpm: i64 = 95;  let oLoadWav: i64 = 96;
    let oTPatchMean: i64 = 97; let oTLinearGrad: i64 = 98; let oPrint: i64 = 99;
    let oSleepMs: i64 = 100; let oLearn: i64 = 101;  let oPredict: i64 = 102;
    let oUnroll: i64 = 103; let oRememberNext: i64 = 104; let oForeseeN: i64 = 105;
    let oArgc: i64 = 106;   let oArg: i64 = 107;     let oFileExists: i64 = 108;
    let oReadLine: i64 = 109;
    let stack: list = [];
    let spi: i64 = 0;
    let prei: i64 = 0;
    while prei < 64 { stack = push(stack, 0); prei = prei + 1; }
    let slots: list = init_slots;
    let ret_ips: list = [];
    let ret_bases: list = [];
    let rsp: i64 = 0;
    let ip: i64 = start_ip;
    let slot_base: i64 = 0;
    let agbox: list = [[]];
    while ip < len(code) {
        let op: i64 = code[ip]; ip = ip + 1;
        if op == oLoad {
            let si: i64 = slot_base + code[ip]; ip = ip + 1;
            slots = ensure_slot(slots, si);
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = slots[si]; spi = spi + 1;
        } else if op == oConst {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = code[ip]; spi = spi + 1; ip = ip + 1;
        } else if op == oStore {
            let si: i64 = slot_base + code[ip]; ip = ip + 1;
            slots = ensure_slot(slots, si);
            slots[si] = stack[spi - 1];
        } else if op == oAdd {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; stack[spi] = stack[spi] + b; spi = spi + 1;
        } else if op == oSub {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; stack[spi] = stack[spi] - b; spi = spi + 1;
        } else if op == oMul {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; stack[spi] = stack[spi] * b; spi = spi + 1;
        } else if op == oDiv {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; stack[spi] = stack[spi] / b; spi = spi + 1;
        } else if op == oLt {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] < b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oGt {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] > b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oEq {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] == b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oLe {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] <= b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oNe {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] != b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oGe {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0; if stack[spi] >= b { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oJmp {
            ip = code[ip];
        } else if op == oJmpf {
            let t: i64 = code[ip]; ip = ip + 1;
            spi = spi - 1;
            if stack[spi] == 0 { ip = t; }
        } else if op == oCall {
            let addr: i64 = code[ip]; ip = ip + 1;
            let ac: i64 = code[ip]; ip = ip + 1;
            if rsp >= len(ret_ips) { ret_ips = push(ret_ips, 0); ret_bases = push(ret_bases, 0); }
            ret_ips[rsp] = ip; ret_bases[rsp] = slot_base; rsp = rsp + 1;
            slot_base = len(slots);
            let ai: i64 = ac - 1;
            while ai >= 0 {
                slots = ensure_slot(slots, slot_base + ai);
                spi = spi - 1;
                slots[slot_base + ai] = stack[spi];
                ai = ai - 1;
            }
            ip = addr;
        } else if op == oRet {
            let retv = 0;
            if spi > 0 { spi = spi - 1; retv = stack[spi]; }
            if rsp == 0 { return [retv, evq]; }
            let new_slots: list = []; let si: i64 = 0;
            while si < slot_base { new_slots = push(new_slots, slots[si]); si = si + 1; }
            slots = new_slots;
            rsp = rsp - 1; slot_base = ret_bases[rsp]; ip = ret_ips[rsp];
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = retv; spi = spi + 1;
        } else if op == oPop {
            spi = spi - 1;
        } else if op == oListPush {
            spi = spi - 1; let vv = stack[spi];
            spi = spi - 1; let lv = stack[spi];
            stack[spi] = push(lv, vv); spi = spi + 1;
        } else if op == oGet {
            spi = spi - 1; let gi = stack[spi];
            spi = spi - 1; let gx = stack[spi];
            stack[spi] = gx[gi]; spi = spi + 1;
        } else if op == oSet {
            spi = spi - 1; let sv = stack[spi];
            spi = spi - 1; let sidx = stack[spi];
            spi = spi - 1; let sxs = stack[spi];
            sxs[sidx] = sv;
            stack[spi] = sxs; spi = spi + 1;
        } else if op == oLen {
            spi = spi - 1;
            stack[spi] = len(stack[spi]); spi = spi + 1;
        } else if op == oListNew {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = []; spi = spi + 1;
        } else if op == oHalt {
            if spi == 0 { return [0, evq]; }
            return [stack[spi - 1], evq];
        } else if op == oTFrom {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_from(a, b); spi = spi + 1;
        } else if op == oTGet {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_get(a, b); spi = spi + 1;
        } else if op == oTMatmul {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_matmul(a, b); spi = spi + 1;
        } else if op == oTShape {
            spi = spi - 1;
            stack[spi] = nt_shape(stack[spi]); spi = spi + 1;
        } else if op == oTAdd {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_add(a, b); spi = spi + 1;
        } else if op == oTensor {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_tensor(a, b); spi = spi + 1;
        } else if op == oTFill {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_fill(a, b); spi = spi + 1;
        } else if op == oTSub {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_sub(a, b); spi = spi + 1;
        } else if op == oTMul {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_mul(a, b); spi = spi + 1;
        } else if op == oTReshape {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_reshape(a, b); spi = spi + 1;
        } else if op == oTTranspose {
            spi = spi - 1;
            stack[spi] = nt_transpose(stack[spi]); spi = spi + 1;
        } else if op == oTScale {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_scale(a, b); spi = spi + 1;
        } else if op == oTSum {
            spi = spi - 1;
            stack[spi] = nt_sum(stack[spi]); spi = spi + 1;
        } else if op == oTDot {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_dot(a, b); spi = spi + 1;
        } else if op == oTExp {
            spi = spi - 1;
            stack[spi] = nt_texp(stack[spi]); spi = spi + 1;
        } else if op == oTLog {
            spi = spi - 1;
            stack[spi] = nt_tlog(stack[spi]); spi = spi + 1;
        } else if op == oTSoftmax {
            spi = spi - 1;
            stack[spi] = nt_softmax(stack[spi]); spi = spi + 1;
        } else if op == oTMean {
            spi = spi - 1;
            stack[spi] = nt_mean(stack[spi]); spi = spi + 1;
        } else if op == oTMse {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_mse(a, b); spi = spi + 1;
        } else if op == oMemConfig {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_mind(a, b, c); spi = spi + 1;
        } else if op == oMemRemember {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_remember(a, b, c); spi = spi + 1;
        } else if op == oMemSurprise {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_surprise(a, b); spi = spi + 1;
        } else if op == oMemForesee {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_foresee(a, b); spi = spi + 1;
        } else if op == oMemConsolidate {
            spi = spi - 1;
            stack[spi] = nt_consolidate(stack[spi]); spi = spi + 1;
        } else if op == oMemStats {
            spi = spi - 1;
            stack[spi] = nt_mem_stats(stack[spi]); spi = spi + 1;
        } else if op == oMemRecall {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_recall(a, b, c); spi = spi + 1;
        } else if op == oSaveMind {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_save_mind(a, b); spi = spi + 1;
        } else if op == oLoadMind {
            spi = spi - 1;
            stack[spi] = nt_load_mind(stack[spi]); spi = spi + 1;
        } else if op == oAgClear {
            nt_ag_clear(agbox);
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = 0; spi = spi + 1;
        } else if op == oAgParam {
            spi = spi - 1;
            stack[spi] = nt_ag_param(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgConst {
            spi = spi - 1;
            stack[spi] = nt_ag_const(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgAdd {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_add(agbox, a, b); spi = spi + 1;
        } else if op == oAgSub {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_sub(agbox, a, b); spi = spi + 1;
        } else if op == oAgMul {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_mul(agbox, a, b); spi = spi + 1;
        } else if op == oAgMatmul {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_matmul(agbox, a, b); spi = spi + 1;
        } else if op == oAgScale {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_scale(agbox, a, b); spi = spi + 1;
        } else if op == oAgRelu {
            spi = spi - 1;
            stack[spi] = nt_ag_relu(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgNeg {
            spi = spi - 1;
            stack[spi] = nt_ag_neg(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgTranspose {
            spi = spi - 1;
            stack[spi] = nt_ag_transpose(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgReshape {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_reshape(agbox, a, b); spi = spi + 1;
        } else if op == oAgExp {
            spi = spi - 1;
            stack[spi] = nt_ag_exp(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgSoftmax {
            spi = spi - 1;
            stack[spi] = nt_ag_softmax(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgMse {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_mse(agbox, a, b); spi = spi + 1;
        } else if op == oAgSum {
            spi = spi - 1;
            stack[spi] = nt_ag_sum(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgValue {
            spi = spi - 1;
            stack[spi] = nt_ag_value(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgGrad {
            spi = spi - 1;
            stack[spi] = nt_ag_grad(agbox, stack[spi]); spi = spi + 1;
        } else if op == oAgBackward {
            spi = spi - 1;
            nt_ag_backward(agbox, stack[spi]);
            stack[spi] = 0; spi = spi + 1;
        } else if op == oAgStep {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_ag_step(agbox, a, b); spi = spi + 1;
        } else if op == oAgLog {
            spi = spi - 1;
            stack[spi] = nt_ag_log(agbox, stack[spi]); spi = spi + 1;
        } else if op == oTSet {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_set(a, b, c); spi = spi + 1;
        } else if op == oSaveTensor {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_save_tensor(a, b); spi = spi + 1;
        } else if op == oLoadTensor {
            spi = spi - 1;
            stack[spi] = nt_load_tensor(stack[spi]); spi = spi + 1;
        } else if op == oSweep {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = 0; spi = spi + 1;
        } else if op == oNowMs {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = now_ms(); spi = spi + 1;
        } else if op == oMemory {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = nt_mind(0.12, 16, 8); spi = spi + 1;
        } else if op == oLoadPpm {
            spi = spi - 1;
            stack[spi] = nt_load_ppm(stack[spi]); spi = spi + 1;
        } else if op == oLoadWav {
            spi = spi - 1;
            stack[spi] = nt_load_wav(stack[spi]); spi = spi + 1;
        } else if op == oTPatchMean {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_patch_mean(a, b, c); spi = spi + 1;
        } else if op == oTLinearGrad {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_linear_grad(a, b, c); spi = spi + 1;
        } else if op == oPrint {
            spi = spi - 1; print(stack[spi]);
        } else if op == oSleepMs {
            spi = spi - 1;
            stack[spi] = sleep_ms(stack[spi]); spi = spi + 1;
        } else if op == oLearn {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_learn(a, b, c); spi = spi + 1;
        } else if op == oPredict {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_predict(a, b); spi = spi + 1;
        } else if op == oUnroll {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_unroll(a, b, c); spi = spi + 1;
        } else if op == oForeseeN {
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_foresee_n(a, b, c); spi = spi + 1;
        } else if op == oRememberNext {
            spi = spi - 1; let d = stack[spi];
            spi = spi - 1; let c = stack[spi];
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let a = stack[spi];
            stack[spi] = nt_remember_next(a, b, c, d); spi = spi + 1;
        } else if op == oMod {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let q = stack[spi] / b;
            stack[spi] = stack[spi] - q * b; spi = spi + 1;
        } else if op == oAnd {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0;
            if stack[spi] != 0 {
                if b != 0 { r = 1; }
            }
            stack[spi] = r; spi = spi + 1;
        } else if op == oOr {
            spi = spi - 1; let b = stack[spi];
            spi = spi - 1; let r: i64 = 0;
            if stack[spi] != 0 { r = 1; }
            if b != 0 { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oNot {
            spi = spi - 1;
            let r: i64 = 1;
            if stack[spi] != 0 { r = 0; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oTypeof {
            spi = spi - 1;
            stack[spi] = typeof(stack[spi]); spi = spi + 1;
        } else if op == oToStr {
            spi = spi - 1;
            let t = typeof(stack[spi]);
            if t == "str" {
                spi = spi + 1;
            } else {
                if t == "i64" {
                    stack[spi] = itoa(stack[spi]); spi = spi + 1;
                } else {
                    if t == "f64" {
                        stack[spi] = itoa(round(stack[spi])); spi = spi + 1;
                    } else {
                        stack[spi] = itoa(ord(t)); spi = spi + 1;
                    }
                }
            }
        } else if op == oPrintln {
            spi = spi - 1; println(stack[spi]);
        } else if op == oAssert {
            spi = spi - 1; assert(stack[spi]);
        } else if op == oRound {
            spi = spi - 1;
            stack[spi] = round(stack[spi]); spi = spi + 1;
        } else if op == oOrd {
            spi = spi - 1;
            stack[spi] = ord(stack[spi]); spi = spi + 1;
        } else if op == oEmit {
            spi = spi - 1; let ev = stack[spi];
            spi = spi - 1; let en = stack[spi];
            evq = push(evq, [en, ev]);
            stack[spi] = 0; spi = spi + 1;
        } else if op == oPending {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = len(evq); spi = spi + 1;
        } else if op == oWriteFile {
            spi = spi - 1; let pc = stack[spi];
            spi = spi - 1; let pp = stack[spi];
            let ok = write_file(pp, pc);
            let r: i64 = 0;
            if ok == true { r = 1; }
            stack[spi] = r; spi = spi + 1;
        } else if op == oReadFile {
            spi = spi - 1;
            stack[spi] = read_file(stack[spi]); spi = spi + 1;
        } else if op == oArgc {
            let n: i64 = argc();
            if spi >= len(stack) { stack = push(stack, 0); }
            if n < 1 { stack[spi] = 0; } else { stack[spi] = n - 1; }
            spi = spi + 1;
        } else if op == oArg {
            spi = spi - 1;
            stack[spi] = arg(stack[spi] + 1); spi = spi + 1;
        } else if op == oFileExists {
            spi = spi - 1;
            stack[spi] = file_exists(stack[spi]); spi = spi + 1;
        } else if op == oReadLine {
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = read_line(); spi = spi + 1;
        } else if op == oPump {
            spi = spi - 1;
            let left: i64 = stack[spi];
            let done: i64 = 0;
            while left > 0 {
                if len(evq) == 0 { break; }
                let item = evq[0];
                evq = list_tail(evq);
                left = left - 1;
                let hb = find_bind(binds, item[0]);
                if hb[0] == 1 {
                    let init: list = [];
                    if hb[2] == 1 {
                        init = push(init, item[1]);
                    } else {
                        if hb[2] != 0 { assert(0 == 1); }
                    }
                    let hr = vm_run(code, binds, hb[1], init, evq);
                    evq = hr[1];
                    done = done + 1;
                }
            }
            if spi >= len(stack) { stack = push(stack, 0); }
            stack[spi] = done; spi = spi + 1;
        }
    }
    if spi == 0 { return [0, evq]; }
    return [stack[spi - 1], evq];
}

fn vm_exec(code: list, binds: list) -> i64 {
    let r = vm_run(code, binds, 0, [], []);
    return r[0];
}

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
                if s[i + 1] == "*" {
                    i = i + 2;
                    let closed: i64 = 0;
                    while i + 1 < len(s) {
                        if s[i] == "*" {
                            if s[i + 1] == "/" {
                                i = i + 2;
                                closed = 1;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                    assert(closed == 1);
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i); let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch; i = i + 1;
    }
    return [name, i];
}
fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i); let v: i64 = 0;
    while i < len(s) {
        if is_digit(s[i]) == 0 { break; }
        v = v * 10 + (ord(s[i]) - 48); i = i + 1;
    }
    if i < len(s) {
        if s[i] == "." {
            // `0..n` range — not a float
            if i + 1 < len(s) {
                if s[i + 1] == "." { return [v, i]; }
            }
            i = i + 1;
            let f = v + 0.0;
            let place = 0.1;
            while i < len(s) {
                if is_digit(s[i]) == 0 { break; }
                let d = (ord(s[i]) - 48) + 0.0;
                f = f + d * place;
                place = place * 0.1;
                i = i + 1;
            }
            return [f, i];
        }
    }
    return [v, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\\" {
            i = i + 1;
            assert(i < len(s));
            if s[i] == "n" {
                out = out + "\n";
            } else {
                if s[i] == "t" {
                    out = out + "\t";
                } else {
                    out = out + s[i];
                }
            }
            i = i + 1;
            continue;
        }
        if s[i] == "\"" { return [out, i + 1]; }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn slot_of(vnames: list, name: str) -> list {
    let i: i64 = 0;
    while i < len(vnames) { if vnames[i] == name { return [i, vnames]; } i = i + 1; }
    vnames = push(vnames, name);
    return [len(vnames) - 1, vnames];
}
fn emit2(code: list, a: i64, b) -> list { code = push(code, a); return push(code, b); }
fn emit3(code: list, a: i64, b: i64, c: i64) -> list {
    code = push(code, a); code = push(code, b); return push(code, c);
}

fn find_struct(stypes: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(stypes) {
        if stypes[i][0] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn field_index(fields: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fields) {
        if fields[i] == name { return i; }
        i = i + 1;
    }
    assert(0 == 1);
    return 0;
}
fn field_index_any(stypes: list, name: str) -> i64 {
    let si: i64 = 0;
    while si < len(stypes) {
        let fields: list = stypes[si][1];
        let fi: i64 = 0;
        while fi < len(fields) {
            if fields[fi] == name { return fi; }
            fi = fi + 1;
        }
        si = si + 1;
    }
    assert(0 == 1);
    return 0;
}

fn emit_factor(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    i = skip(s, i);
    if s[i] == "(" {
        let r = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = skip(s, r[1]); vnames = r[2]; patches = r[3]; assert(s[i] == ")");
        i = i + 1;
    } else {
        if s[i] == "-" {
            code = emit2(code, OP_CONST(), 0);
            let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_SUB()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "!" {
                let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_NOT()); i = r[1]; vnames = r[2]; patches = r[3];
            } else {
            if s[i] == "\"" {
                let ps = parse_string(s, i);
                code = emit2(code, OP_CONST(), ps[0]); i = ps[1];
            } else {
                if s[i] == "[" {
                    i = i + 1;
                    code = push(code, OP_LIST_NEW());
                    i = skip(s, i);
                    if s[i] != "]" {
                        while true {
                            let ar = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
                            code = push(ar[0], OP_LIST_PUSH()); i = ar[1]; vnames = ar[2]; patches = ar[3];
                            i = skip(s, i);
                            if s[i] == "," { i = i + 1; continue; }
                            break;
                        }
                    }
                    assert(s[i] == "]"); i = i + 1;
                } else {
                    if is_alpha(s[i]) == 1 {
                        let id = parse_ident(s, i);
                        let j: i64 = skip(s, id[1]);
                        if j < len(s) {
                            if s[j] == "(" {
                                j = j + 1; j = skip(s, j);
                                if id[0] == "round" {
                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                    j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                    code = push(code, OP_ROUND());
                                    i = j;
                                } else {
                                    if id[0] == "ord" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_ORD());
                                        i = j;
                                    } else {
                                    if id[0] == "len" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_LEN());
                                        i = j;
                                    } else {
                                    if id[0] == "typeof" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_TYPEOF());
                                        i = j;
                                    } else {
                                    if id[0] == "to_str" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_TO_STR());
                                        i = j;
                                    } else {
                                        if id[0] == "push" {
                                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                            code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                            j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                            ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                            code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                            j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                            code = push(code, OP_LIST_PUSH());
                                            i = j;
                                        } else {
                                            if id[0] == "emit" {
                                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                code = push(code, OP_EMIT());
                                                i = j;
                                            } else {
                                                if id[0] == "pump" {
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                    j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                    code = push(code, OP_PUMP());
                                                    i = j;
                                                } else {
                                                    if id[0] == "pending" {
                                                        assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_PENDING());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "write_file" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_WRITE_FILE());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "read_file" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_READ_FILE());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_from" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_FROM());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_get" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_GET());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_matmul" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_MATMUL());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_shape" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_SHAPE());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_add" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_ADD());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "tensor" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_TENSOR());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "t_fill" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_T_FILL());
                                                        i = j;
                                                    } else {
                                                    let zop: i64 = 0;
                                                    if id[0] == "ag_clear" { zop = OP_AG_CLEAR(); }
                                                    if id[0] == "sweep" { zop = OP_SWEEP(); }
                                                    if id[0] == "now_ms" { zop = OP_NOW_MS(); }
                                                    if id[0] == "memory" { zop = OP_MEMORY(); }
                                                    if id[0] == "argc" { zop = OP_ARGC(); }
                                                    if id[0] == "read_line" { zop = OP_READ_LINE(); }
                                                    if zop != 0 {
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, zop);
                                                        i = j;
                                                    } else {
                                                    let hop: i64 = 0;
                                                    if id[0] == "t_sub" { hop = OP_T_SUB(); }
                                                    if id[0] == "t_mul" { hop = OP_T_MUL(); }
                                                    if id[0] == "t_dot" { hop = OP_T_DOT(); }
                                                    if id[0] == "t_reshape" { hop = OP_T_RESHAPE(); }
                                                    if id[0] == "t_scale" { hop = OP_T_SCALE(); }
                                                    if id[0] == "t_mse" { hop = OP_T_MSE(); }
                                                    if id[0] == "surprise" { hop = OP_MEM_SURPRISE(); }
                                                    if id[0] == "foresee" { hop = OP_MEM_FORESEE(); }
                                                    if id[0] == "save_mind" { hop = OP_SAVE_MIND(); }
                                                    if id[0] == "save_tensor" { hop = OP_SAVE_TENSOR(); }
                                                    if id[0] == "ag_add" { hop = OP_AG_ADD(); }
                                                    if id[0] == "ag_sub" { hop = OP_AG_SUB(); }
                                                    if id[0] == "ag_mul" { hop = OP_AG_MUL(); }
                                                    if id[0] == "ag_matmul" { hop = OP_AG_MATMUL(); }
                                                    if id[0] == "ag_mse" { hop = OP_AG_MSE(); }
                                                    if id[0] == "ag_scale" { hop = OP_AG_SCALE(); }
                                                    if id[0] == "ag_reshape" { hop = OP_AG_RESHAPE(); }
                                                    if id[0] == "ag_step" { hop = OP_AG_STEP(); }
                                                    if id[0] == "predict" { hop = OP_PREDICT(); }
                                                    if hop != 0 {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, hop);
                                                        i = j;
                                                    } else {
                                                    let uop: i64 = 0;
                                                    if id[0] == "t_transpose" { uop = OP_T_TRANSPOSE(); }
                                                    if id[0] == "t_exp" { uop = OP_T_EXP(); }
                                                    if id[0] == "t_log" { uop = OP_T_LOG(); }
                                                    if id[0] == "t_softmax" { uop = OP_T_SOFTMAX(); }
                                                    if id[0] == "t_sum" { uop = OP_T_SUM(); }
                                                    if id[0] == "t_mean" { uop = OP_T_MEAN(); }
                                                    if id[0] == "consolidate" { uop = OP_MEM_CONSOLIDATE(); }
                                                    if id[0] == "mem_stats" { uop = OP_MEM_STATS(); }
                                                    if id[0] == "load_mind" { uop = OP_LOAD_MIND(); }
                                                    if id[0] == "ag_param" { uop = OP_AG_PARAM(); }
                                                    if id[0] == "ag_const" { uop = OP_AG_CONST(); }
                                                    if id[0] == "ag_relu" { uop = OP_AG_RELU(); }
                                                    if id[0] == "ag_neg" { uop = OP_AG_NEG(); }
                                                    if id[0] == "ag_transpose" { uop = OP_AG_TRANSPOSE(); }
                                                    if id[0] == "ag_exp" { uop = OP_AG_EXP(); }
                                                    if id[0] == "ag_log" { uop = OP_AG_LOG(); }
                                                    if id[0] == "ag_softmax" { uop = OP_AG_SOFTMAX(); }
                                                    if id[0] == "ag_sum" { uop = OP_AG_SUM(); }
                                                    if id[0] == "ag_value" { uop = OP_AG_VALUE(); }
                                                    if id[0] == "ag_grad" { uop = OP_AG_GRAD(); }
                                                    if id[0] == "ag_backward" { uop = OP_AG_BACKWARD(); }
                                                    if id[0] == "load_tensor" { uop = OP_LOAD_TENSOR(); }
                                                    if id[0] == "load_ppm" { uop = OP_LOAD_PPM(); }
                                                    if id[0] == "load_wav" { uop = OP_LOAD_WAV(); }
                                                    if id[0] == "sleep_ms" { uop = OP_SLEEP_MS(); }
                                                    if id[0] == "file_exists" { uop = OP_FILE_EXISTS(); }
                                                    if id[0] == "arg" { uop = OP_ARG(); }
                                                    if uop != 0 {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, uop);
                                                        i = j;
                                                    } else {
                                                    let t3: i64 = 0;
                                                    if id[0] == "memory_config" { t3 = OP_MEM_CONFIG(); }
                                                    if id[0] == "remember" { t3 = OP_MEM_REMEMBER(); }
                                                    if id[0] == "recall" { t3 = OP_MEM_RECALL(); }
                                                    if id[0] == "t_set" { t3 = OP_T_SET(); }
                                                    if id[0] == "t_patch_mean" { t3 = OP_T_PATCH_MEAN(); }
                                                    if id[0] == "t_linear_grad" { t3 = OP_T_LINEAR_GRAD(); }
                                                    if id[0] == "learn" { t3 = OP_LEARN(); }
                                                    if id[0] == "unroll" { t3 = OP_UNROLL(); }
                                                    if id[0] == "foresee_n" { t3 = OP_FORESEE_N(); }
                                                    if t3 != 0 {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, t3);
                                                        i = j;
                                                    } else {
                                                    let t4: i64 = 0;
                                                    if id[0] == "remember_next" { t4 = OP_REMEMBER_NEXT(); }
                                                    if t4 != 0 {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, t4);
                                                        i = j;
                                                    } else {
                                            let argc: i64 = 0;
                                            if s[j] != ")" {
                                                while true {
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3]; argc = argc + 1;
                                                    j = skip(s, j);
                                                    if s[j] == "," { j = j + 1; continue; }
                                                    break;
                                                }
                                            }
                                            assert(s[j] == ")"); j = j + 1;
                                            let fi: i64 = 0; let found: i64 = 0; let fni: i64 = 0;
                                            while fi < len(fnames) {
                                                if fnames[fi] == id[0] {
                                                    found = 1; fni = fi; assert(fargc[fi] == argc);
                                                }
                                                fi = fi + 1;
                                            }
                                            assert(found == 1);
                                            let addr_at: i64 = len(code) + 1;
                                            code = emit3(code, OP_CALL(), faddrs[fni], argc);
                                            if faddrs[fni] == 0 {
                                                patches = push(patches, [addr_at, fni]);
                                            }
                                            i = j;
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                    }
                                    }
                                    }
                                }
                            } else {
                                if id[0] == "true" {
                                    code = emit2(code, OP_CONST(), 1); i = id[1];
                                } else {
                                    if id[0] == "false" {
                                        code = emit2(code, OP_CONST(), 0); i = id[1];
                                    } else {
                                        if s[j] == "{" {
                                            let tid: i64 = find_struct(stypes, id[0]);
                                            if tid < 0 {
                                                let sl = slot_of(vnames, id[0]);
                                                code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                            } else {
                                                let fields: list = stypes[tid][1];
                                                j = j + 1;
                                                code = push(code, OP_LIST_NEW());
                                                let fi: i64 = 0;
                                                while fi < len(fields) {
                                                    j = skip(s, j);
                                                    let fnm = parse_ident(s, j);
                                                    assert(fnm[0] == fields[fi]);
                                                    j = skip(s, fnm[1]);
                                                    assert(s[j] == ":"); j = j + 1;
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = push(ar[0], OP_LIST_PUSH()); j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                    j = skip(s, j);
                                                    if j < len(s) { if s[j] == "," { j = j + 1; } }
                                                    fi = fi + 1;
                                                }
                                                j = skip(s, j);
                                                assert(s[j] == "}"); j = j + 1;
                                                i = j;
                                            }
                                        } else {
                                            let sl = slot_of(vnames, id[0]);
                                            code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                        }
                                    }
                                }
                            }
                        } else {
                            if id[0] == "true" {
                                code = emit2(code, OP_CONST(), 1); i = id[1];
                            } else {
                                if id[0] == "false" {
                                    code = emit2(code, OP_CONST(), 0); i = id[1];
                                } else {
                                    let sl = slot_of(vnames, id[0]);
                                    code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                }
                            }
                        }
                    } else {
                        let n = parse_number(s, i);
                        code = emit2(code, OP_CONST(), n[0]); i = n[1];
                    }
                }
            }
            }
        }
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "[" { break; }
        let ix = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = ix[0]; i = ix[1]; vnames = ix[2]; patches = ix[3];
        i = skip(s, i); assert(s[i] == "]"); i = i + 1;
        code = push(code, OP_GET());
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "." { break; }
        // `..` is range, not field
        if i + 1 < len(s) {
            if s[i + 1] == "." { break; }
        }
        let fld = parse_ident(s, i + 1);
        assert(len(fld[0]) > 0);
        let fidx: i64 = field_index_any(stypes, fld[0]);
        code = emit2(code, OP_CONST(), fidx);
        code = push(code, OP_GET());
        i = fld[1];
    }
    return [code, i, vnames, patches];
}

fn emit_term(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_factor(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "*" {
            r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_MUL()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "/" {
                r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_DIV()); i = r[1]; vnames = r[2]; patches = r[3];
            } else {
                if s[i] == "%" {
                    r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                    code = push(r[0], OP_MOD()); i = r[1]; vnames = r[2]; patches = r[3];
                } else { break; }
            }
        }
    }
    return [code, i, vnames, patches];
}

fn emit_sum(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_term(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "+" {
            r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_ADD()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "-" {
                r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_SUB()); i = r[1]; vnames = r[2]; patches = r[3];
            } else { break; }
        }
    }
    return [code, i, vnames, patches];
}

fn emit_rel(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3]; i = skip(s, i);
    if i >= len(s) { return [code, i, vnames, patches]; }
    if starts_with(s, i, "<=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_LE()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, ">=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_GE()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, "==") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_EQ()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, "!=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_NE()), r[1], r[2], r[3]];
    }
    if s[i] == "<" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_LT()), r[1], r[2], r[3]];
    }
    if s[i] == ">" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_GT()), r[1], r[2], r[3]];
    }
    return [code, i, vnames, patches];
}

fn emit_and(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_rel(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "&&") == 1 {
            r = emit_rel(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_AND()); i = r[1]; vnames = r[2]; patches = r[3];
        } else { break; }
    }
    return [code, i, vnames, patches];
}

fn emit_or(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_and(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "||") == 1 {
            r = emit_and(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_OR()); i = r[1]; vnames = r[2]; patches = r[3];
        } else { break; }
    }
    return [code, i, vnames, patches];
}

fn emit_cmp(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    return emit_or(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
}

fn emit_block(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list, lctx: list) -> list {
    i = skip(s, i); assert(s[i] == "{"); i = i + 1;
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = st[0]; i = st[1]; vnames = st[2]; patches = st[3]; lctx = st[4];
    }
    assert(s[i] == "}");
    return [code, i + 1, vnames, patches, lctx];
}

fn emit_stmt(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list, lctx: list) -> list {
    i = skip(s, i);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip_type_annot(s, id[1]);
        i = skip(s, i);
        assert(s[i] == "="); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let sl = slot_of(vnames, id[0]); vnames = sl[1];
        code = emit2(code, OP_STORE(), sl[0]);
        code = push(code, OP_POP());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7);
        assert(s[i] == "("); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i); assert(s[i] == ")"); i = i + 1;
        code = push(code, OP_PRINTLN());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "print") == 1 {
        i = skip(s, i + 5);
        assert(s[i] == "("); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i); assert(s[i] == ")"); i = i + 1;
        code = push(code, OP_PRINT());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6);
        assert(s[i] == "("); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i); assert(s[i] == ")"); i = i + 1;
        code = push(code, OP_ASSERT());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "return") == 1 {
        let r = emit_cmp(s, i + 6, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        code = push(code, OP_RET());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "while") == 1 {
        let loop_start: i64 = len(code);
        let r = emit_cmp(s, i + 5, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        lctx = lctx_push(lctx, loop_start);
        let bl = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl[0]; i = bl[1]; vnames = bl[2]; patches = bl[3]; lctx = bl[4];
        code = emit2(code, OP_JMP(), loop_start);
        code[jmpf_at + 1] = len(code);
        let fin = lctx_pop_finish(code, lctx, len(code));
        code = fin[0]; lctx = fin[1];
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let var = parse_ident(s, i);
        i = skip(s, var[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let sl = slot_of(vnames, var[0]); vnames = sl[1];
        let vslot: i64 = sl[0];
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i);
        if starts_with(s, i, "..") == 1 {
            code = emit2(code, OP_STORE(), vslot);
            code = push(code, OP_POP());
            i = skip(s, i + 2);
            let tmpn: i64 = lctx[3];
            let digs: str = "0123456789";
            let endn: str = "__fe";
            let t: i64 = tmpn;
            let digits: str = "";
            if t == 0 { digits = "0"; }
            while t > 0 {
                let d: i64 = t - (t / 10) * 10;
                digits = digs[d] + digits;
                t = t / 10;
            }
            endn = endn + digits;
            lctx = [lctx[0], lctx[1], lctx[2], tmpn + 1];
            let esl = slot_of(vnames, endn); vnames = esl[1];
            let eslot: i64 = esl[0];
            r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
            code = emit2(code, OP_STORE(), eslot);
            code = push(code, OP_POP());
            let loop_start: i64 = len(code);
            code = emit2(code, OP_LOAD(), vslot);
            code = emit2(code, OP_LOAD(), eslot);
            code = push(code, OP_LT());
            let jmpf_at: i64 = len(code);
            code = emit2(code, OP_JMPF(), 0);
            lctx = lctx_push(lctx, 0);
            let bl = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
            code = bl[0]; i = bl[1]; vnames = bl[2]; patches = bl[3]; lctx = bl[4];
            let cont_at: i64 = len(code);
            lctx = lctx_set_cont(lctx, cont_at);
            code = emit2(code, OP_LOAD(), vslot);
            code = emit2(code, OP_CONST(), 1);
            code = push(code, OP_ADD());
            code = emit2(code, OP_STORE(), vslot);
            code = push(code, OP_POP());
            code = emit2(code, OP_JMP(), loop_start);
            code[jmpf_at + 1] = len(code);
            let fin = lctx_pop_finish(code, lctx, len(code));
            code = fin[0]; lctx = fin[1];
            return [code, i, vnames, patches, lctx];
        }
        // list iteration
        let tmpn2: i64 = lctx[3];
        let digs2: str = "0123456789";
        let td: str = "";
        let t2: i64 = tmpn2;
        if t2 == 0 { td = "0"; }
        while t2 > 0 {
            let d2: i64 = t2 - (t2 / 10) * 10;
            td = digs2[d2] + td;
            t2 = t2 / 10;
        }
        let ln: str = "__fl" + td;
        let ix: str = "__fi" + td;
        lctx = [lctx[0], lctx[1], lctx[2], tmpn2 + 1];
        let lsl = slot_of(vnames, ln); vnames = lsl[1];
        let lslot: i64 = lsl[0];
        let isl = slot_of(vnames, ix); vnames = isl[1];
        let islot: i64 = isl[0];
        code = emit2(code, OP_STORE(), lslot);
        code = push(code, OP_POP());
        code = emit2(code, OP_CONST(), 0);
        code = emit2(code, OP_STORE(), islot);
        code = push(code, OP_POP());
        let loop_start2: i64 = len(code);
        code = emit2(code, OP_LOAD(), islot);
        code = emit2(code, OP_LOAD(), lslot);
        code = push(code, OP_LEN());
        code = push(code, OP_LT());
        let jmpf_at2: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        code = emit2(code, OP_LOAD(), lslot);
        code = emit2(code, OP_LOAD(), islot);
        code = push(code, OP_GET());
        code = emit2(code, OP_STORE(), vslot);
        code = push(code, OP_POP());
        lctx = lctx_push(lctx, 0);
        let bl2 = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl2[0]; i = bl2[1]; vnames = bl2[2]; patches = bl2[3]; lctx = bl2[4];
        let cont_at2: i64 = len(code);
        lctx = lctx_set_cont(lctx, cont_at2);
        code = emit2(code, OP_LOAD(), islot);
        code = emit2(code, OP_CONST(), 1);
        code = push(code, OP_ADD());
        code = emit2(code, OP_STORE(), islot);
        code = push(code, OP_POP());
        code = emit2(code, OP_JMP(), loop_start2);
        code[jmpf_at2 + 1] = len(code);
        let fin2 = lctx_pop_finish(code, lctx, len(code));
        code = fin2[0]; lctx = fin2[1];
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "break") == 1 {
        let br = lctx_add_break(code, lctx);
        code = br[0]; lctx = br[1];
        i = skip(s, i + 5);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "continue") == 1 {
        let cr = lctx_add_continue(code, lctx);
        code = cr[0]; lctx = cr[1];
        i = skip(s, i + 8);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "if") == 1 {
        let r = emit_cmp(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        let th = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = th[0]; i = th[1]; vnames = th[2]; patches = th[3]; lctx = th[4];
        i = skip(s, i);
        if starts_kw(s, i, "else") == 1 {
            let jmp_at: i64 = len(code);
            code = emit2(code, OP_JMP(), 0);
            code[jmpf_at + 1] = len(code);
            i = skip(s, i + 4);
            if starts_kw(s, i, "if") == 1 {
                let el = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
                code = el[0]; i = el[1]; vnames = el[2]; patches = el[3]; lctx = el[4];
            } else {
                let el = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
                code = el[0]; i = el[1]; vnames = el[2]; patches = el[3]; lctx = el[4];
            }
            code[jmp_at + 1] = len(code);
        } else {
            code[jmpf_at + 1] = len(code);
        }
        return [code, i, vnames, patches, lctx];
    }
    // bare assign, xs[i]=, or expr
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let sl = slot_of(vnames, id[0]); vnames = sl[1];
                code = emit2(code, OP_LOAD(), sl[0]);
                j = j + 1;
                let ix = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = ix[0]; j = ix[1]; vnames = ix[2]; patches = ix[3];
                j = skip(s, j); assert(s[j] == "]"); j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        if starts_with(s, j, "==") == 0 {
                            let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                            code = r[0]; j = r[1]; vnames = r[2]; patches = r[3];
                            code = push(code, OP_SET());
                            code = emit2(code, OP_STORE(), sl[0]);
                            code = push(code, OP_POP());
                            j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                            return [code, j, vnames, patches, lctx];
                        }
                    }
                }
                // not assignment — drop the LOAD we emitted and reparse as expr
                // (LOAD + slot = 2 ops)
                let nc: list = [];
                let ki: i64 = 0;
                while ki < len(code) - 2 { nc = push(nc, code[ki]); ki = ki + 1; }
                code = nc;
                i = save;
            } else {
                if s[j] == "." {
                    let sl = slot_of(vnames, id[0]); vnames = sl[1];
                    let fld = parse_ident(s, j + 1);
                    j = skip(s, fld[1]);
                    if j < len(s) {
                        if s[j] == "=" {
                            if starts_with(s, j, "==") == 0 {
                                let fidx: i64 = field_index_any(stypes, fld[0]);
                                code = emit2(code, OP_LOAD(), sl[0]);
                                code = emit2(code, OP_CONST(), fidx);
                                let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                code = r[0]; j = r[1]; vnames = r[2]; patches = r[3];
                                code = push(code, OP_SET());
                                code = emit2(code, OP_STORE(), sl[0]);
                                code = push(code, OP_POP());
                                j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                                return [code, j, vnames, patches, lctx];
                            }
                        }
                    }
                    i = save;
                } else {
                if s[j] == "=" {
                    if starts_with(s, j, "==") == 0 {
                        let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
                        let sl = slot_of(vnames, id[0]); vnames = sl[1];
                        code = emit2(code, OP_STORE(), sl[0]);
                        code = push(code, OP_POP());
                        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
                        return [code, i, vnames, patches, lctx];
                    }
                }
                }
            }
        }
    }
    let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    i = skip(s, i);
    if i < len(s) {
        if s[i] == ";" {
            i = i + 1;
            code = push(code, OP_POP());
        }
    }
    return [code, i, vnames, patches, lctx];
}

fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "\"" {
            i = i + 1;
            while i < n {
                if src[i] == "\\" { i = i + 2; continue; }
                if src[i] == "\"" { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(1 == 0);
    return i;
}

fn compile_lite(src: str) -> list {
    // returns [code, binds] where binds = [[event, addr, arity], ...]
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let stypes: list = [];
    let binds: list = [];
    let on_serial: i64 = 0;
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        if starts_kw(src, i, "struct") == 1 {
            i = skip(src, i + 6);
            let id = parse_ident(src, i);
            i = skip(src, id[1]);
            assert(src[i] == "{"); i = i + 1;
            let fields: list = [];
            i = skip(src, i);
            if src[i] != "}" {
                while true {
                    let fnm = parse_ident(src, i);
                    fields = push(fields, fnm[0]);
                    i = skip_type_annot(src, fnm[1]);
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; i = skip(src, i); continue; }
                    break;
                }
            }
            assert(src[i] == "}"); i = i + 1;
            stypes = push(stypes, [id[0], fields]);
            continue;
        }
        if starts_kw(src, i, "on") == 1 {
            i = skip(src, i + 2);
            assert(src[i] == "\"");
            let ps = parse_string(src, i);
            let ev: str = ps[0]; i = ps[1];
            i = skip(src, i);
            assert(src[i] == "("); i = i + 1;
            let params: list = [];
            i = skip(src, i);
            if src[i] != ")" {
                while true {
                    let pn = parse_ident(src, i);
                    params = push(params, pn[0]);
                    i = skip_type_annot(src, pn[1]);
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; continue; }
                    break;
                }
            }
            assert(src[i] == ")");
            i = skip(src, i + 1);
            assert(src[i] == "{");
            let start: i64 = i;
            i = match_brace(src, i);
            let body: str = "";
            let bi: i64 = start;
            while bi < i { body = body + src[bi]; bi = bi + 1; }
            let fname: str = "__on_" + itoa(on_serial);
            on_serial = on_serial + 1;
            binds = push(binds, [ev, len(fnames), len(params)]);
            fnames = push(fnames, fname);
            fparams = push(fparams, params);
            fbodies = push(fbodies, body);
            continue;
        }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "("); i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                params = push(params, pn[0]);
                i = skip_type_annot(src, pn[1]);
                i = skip(src, i);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
    }

    let fargc: list = [];
    let fi: i64 = 0;
    while fi < len(fnames) { fargc = push(fargc, len(fparams[fi])); fi = fi + 1; }

    let code: list = emit2([], OP_JMP(), 0);
    let faddrs: list = [];
    fi = 0;
    while fi < len(fnames) { faddrs = push(faddrs, 0); fi = fi + 1; }
    let patches: list = [];
    fi = 0;
    while fi < len(fnames) {
        faddrs[fi] = len(code);
        let vnames: list = [];
        let pi: i64 = 0;
        while pi < len(fparams[fi]) { vnames = push(vnames, fparams[fi][pi]); pi = pi + 1; }
        let lctx = empty_lctx();
        let bl = emit_block(fbodies[fi], 0, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl[0];
        patches = bl[3];
        code = push(code, OP_RET());
        fi = fi + 1;
    }
    let pgi: i64 = 0;
    while pgi < len(patches) {
        code[patches[pgi][0]] = faddrs[patches[pgi][1]];
        pgi = pgi + 1;
    }
    code[1] = len(code);

    let resolved: list = [];
    let bi2: i64 = 0;
    while bi2 < len(binds) {
        let b = binds[bi2];
        resolved = push(resolved, [b[0], faddrs[b[1]], b[2]]);
        bi2 = bi2 + 1;
    }

    let mi: i64 = 0; let found: i64 = 0; let maddr: i64 = 0;
    while mi < len(fnames) {
        if fnames[mi] == "main" { found = 1; maddr = faddrs[mi]; assert(fargc[mi] == 0); }
        mi = mi + 1;
    }
    assert(found == 1);
    code = emit3(code, OP_CALL(), maddr, 0);
    code = push(code, OP_HALT());
    return [code, resolved];
}

fn run_lite(src: str) -> i64 {
    let p = compile_lite(src);
    return vm_exec(p[0], p[1]);
}

fn run_file(path: str) -> i64 {
    let p = compile_lite(resolve_imports(path, 0));
    return vm_exec(p[0], p[1]);
}

fn main() -> i64 {
    if argc() >= 2 {
        return run_file(arg(1));
    }
    println("kenga-more → bytecode");
    assert(run_lite("fn main() { 2 + 3 * 4 }") == 14);
    assert(run_lite("fn main() { let x = 2 + 3; let y = x * 4; y }") == 20);
    assert(run_lite("fn add(a, b) { a + b } fn main() { add(20, 22) }") == 42);
    assert(run_lite("fn main() { let x = 0; while x < 5 { x = x + 1; } x }") == 5);
    assert(run_lite("fn main() { let x = 3; if x > 2 { 10 } else { 20 } }") == 10);
    assert(run_lite("fn main() -> i64 { let n = 1; let i = 1; while i <= 5 { n = n * i; i = i + 1; } return n; }") == 120);
    assert(run_lite("fn main() { round(1.5 + 2.5) }") == 4);
    assert(run_lite("fn main() { let xs = [10, 20]; xs = push(xs, 30); xs[0] + xs[1] + xs[2] }") == 60);
    assert(run_lite("fn main() { println(\"x{y}\"); 0 }") == 0);
    assert(run_lite("fn main() { let s = \"ab\"; s = s + \"c\"; println(s); 0 }") == 0);
    assert(run_lite("fn main() { if true { 7 } else { 0 } }") == 7);
    assert(run_lite("fn main() { ord(\"A\") }") == 65);
    assert(run_lite("fn main() { let xs = [1, 2]; xs[0] = 7; xs[0] + xs[1] }") == 9);
    assert(run_lite("fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } label }") == 30);
    assert(run_lite("fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } acc }") == 3);
    assert(run_lite("fn main() { let skip = 0; for i in 0..5 { if i == 2 { continue; } skip = skip + i; } skip }") == 8);
    assert(run_lite("fn sum(xs: list) -> i64 { let s: i64 = 0; for v in xs { s = s + v; } return s; } fn main() -> i64 { let xs: list = [1, 2, 3, 4]; xs[0] = 10; return sum(xs); }") == 19);
    assert(run_file("examples/selfhost/for_lite.kenga") == 0);
    assert(run_file("examples/selfhost/elif_lite.kenga") == 0);
    assert(run_file("examples/selfhost/float_lite.kenga") == 0);
    assert(run_file("examples/selfhost/lists_lite.kenga") == 0);
    assert(run_file("examples/selfhost/struct_lite.kenga") == 0);
    assert(run_lite("fn main() -> i64 { return ahead(41); } fn ahead(x: i64) -> i64 { return x + 1; }") == 42);
    assert(run_lite("on \"ping\"(x) { emit(\"pong\", x); } on \"pong\"(x) { println(x); } fn main() { emit(\"ping\", 7); assert(pump(8) == 2); assert(pending() == 0); 0 }") == 0);
    assert(run_file("examples/agent.kenga") == 0);
    assert(run_file("examples/selfhost/fact_lite.kenga") == 0);
    assert(run_lite("fn main() { assert(write_file(\"minds/_more_io.txt\", \"hi\") == 1); ord(read_file(\"minds/_more_io.txt\")[0]) }") == 104);
    assert(run_lite("fn main() { argc() }") == 0);
    assert(run_lite("fn main() { file_exists(\"kenga/compiler/more.kenga\") }") == 1);
    assert(run_file("examples/selfhost/argc_more.kenga") == 0);
    assert(run_lite("fn main() { let s = \"a\\nb\"; len(s) }") == 3);
    assert(run_lite("fn main() { 10 % 3 }") == 1);
    assert(run_lite("fn main() { 1 && 0 }") == 0);
    assert(run_lite("fn main() { 1 && 1 }") == 1);
    assert(run_lite("fn main() { 0 || 1 }") == 1);
    assert(run_lite("fn main() { !0 }") == 1);
    assert(run_lite("fn main() { !(1 == 2) }") == 1);
    assert(run_lite("fn main() { 1 < 2 && 3 > 1 }") == 1);
    assert(run_lite("fn main() { /* c */ 1 + /* x */ 2 }") == 3);
    assert(run_file("examples/selfhost/comments_lite.kenga") == 0);
    assert(run_file("examples/selfhost/logic_lite.kenga") == 0);
    assert(run_lite("fn main() { typeof(1) == \"i64\" }") == 1);
    assert(run_lite("fn main() { typeof(\"a\") == \"str\" }") == 1);
    assert(run_lite("fn main() { \"n=\" + to_str(42) == \"n=42\" }") == 1);
    assert(run_file("examples/selfhost/typeof_lite.kenga") == 0);
    assert(run_file("examples/ml/kenga_birth.kenga") == 0);
    assert(run_file("examples/ml/kenga_born.kenga") == 0);
    assert(run_file("examples/ml/kenga_net.kenga") == 0);
    assert(run_file("kenga/emit/c_seed.kenga") == 0);
    assert(run_file("kenga/emit/expr_c.kenga") == 0);
    assert(run_file("examples/selfhost/tensor_more.kenga") == 0);
    assert(run_file("examples/selfhost/prophet_more.kenga") == 0);
    assert(run_file("examples/prophet.kenga") == 0);
    assert(run_file("examples/selfhost/tape_more.kenga") == 0);
    assert(run_file("examples/ml/autograd_tape.kenga") == 0);
    assert(run_file("examples/selfhost/tensor_io_more.kenga") == 0);
    assert(run_file("examples/ml/mlp_autograd.kenga") == 0);
    assert(run_file("examples/selfhost/vision_more.kenga") == 0);
    assert(run_file("examples/selfhost/print_more.kenga") == 0);
    assert(run_file("examples/selfhost/learn_more.kenga") == 0);
    assert(run_file("examples/selfhost/unroll_more.kenga") == 0);
    assert(run_file("examples/selfhost/foresee_n_more.kenga") == 0);
    assert(run_file("examples/ml/living_multimodal.kenga") == 0);
    assert(run_file("examples/ml/word_lm.kenga") == 0);
    println("kenga-more ok");
    return 0;
}
