// Self-host compiler on Kenga (canonical). Replaces growing slice of src/compiler.rs + vm.rs.
// Run suite: bootstrap\bin\kenga-lite.exe run kenga\compiler\more.kenga
// User file: kenga-lite run examples\selfhost\fact_lite.kenga  (more VM)
// Dialect: i64/f64, lists, str, for/break/continue, else if, xs[i]=, struct, import,
//          XOR, birth→24, c_seed/expr_c (Kenga writes .c) via run_file.
//          on/emit/pump/pending, types/ttl skip, && || % !, typeof/to_str,
//          t_from/t_get/t_matmul/t_shape/t_add/tensor/t_fill,
//          t_sub/t_mul/t_reshape/t_transpose/t_scale/t_sum/t_dot,
//          t_exp/t_log/t_softmax/t_mean/t_mse,
//          memory_config/remember/foresee/consolidate/save_mind,
//          ag_clear/ag_param/ag_matmul/ag_mse/ag_backward/ag_step,
//          t_set/save_tensor/load_tensor/sweep/now_ms/memory,
//          load_ppm/load_wav/t_patch_mean/t_linear_grad,
//          print/sleep_ms/learn/predict/unroll/remember_next/foresee_n
//          argc/arg/file_exists/read_line (guest argv skips more path)
// Tensor/tape/Prophet dispatch → native_ml.kenga (Kenga lists).
// Host left: CRT. ppm/wav via read_bytes + Kenga parse.

import "native_ml.kenga"

fn OP_CONST() -> i64 { return 1; }
fn OP_LOAD() -> i64 { return 2; }
fn OP_STORE() -> i64 { return 3; }
fn OP_ADD() -> i64 { return 4; }
fn OP_SUB() -> i64 { return 5; }
fn OP_MUL() -> i64 { return 6; }
fn OP_DIV() -> i64 { return 7; }
fn OP_LT() -> i64 { return 8; }
fn OP_GT() -> i64 { return 9; }
fn OP_EQ() -> i64 { return 10; }
fn OP_JMP() -> i64 { return 11; }
fn OP_JMPF() -> i64 { return 12; }
fn OP_HALT() -> i64 { return 13; }
fn OP_LE() -> i64 { return 14; }
fn OP_CALL() -> i64 { return 15; }
fn OP_RET() -> i64 { return 16; }
fn OP_PRINTLN() -> i64 { return 17; }
fn OP_ASSERT() -> i64 { return 18; }
fn OP_ROUND() -> i64 { return 19; }
fn OP_POP() -> i64 { return 20; }
fn OP_LIST_NEW() -> i64 { return 21; }
fn OP_LIST_PUSH() -> i64 { return 22; }
fn OP_LEN() -> i64 { return 23; }
fn OP_GET() -> i64 { return 24; }
fn OP_NE() -> i64 { return 25; }
fn OP_GE() -> i64 { return 26; }
fn OP_ORD() -> i64 { return 27; }
fn OP_SET() -> i64 { return 28; }
fn OP_EMIT() -> i64 { return 29; }
fn OP_PUMP() -> i64 { return 30; }
fn OP_PENDING() -> i64 { return 31; }
fn OP_WRITE_FILE() -> i64 { return 32; }
fn OP_READ_FILE() -> i64 { return 33; }
fn OP_MOD() -> i64 { return 34; }
fn OP_AND() -> i64 { return 35; }
fn OP_OR() -> i64 { return 36; }
fn OP_NOT() -> i64 { return 37; }
fn OP_TYPEOF() -> i64 { return 38; }
fn OP_TO_STR() -> i64 { return 39; }
fn OP_T_FROM() -> i64 { return 40; }
fn OP_T_GET() -> i64 { return 41; }
fn OP_T_MATMUL() -> i64 { return 42; }
fn OP_T_SHAPE() -> i64 { return 43; }
fn OP_T_ADD() -> i64 { return 44; }
fn OP_TENSOR() -> i64 { return 45; }
fn OP_T_FILL() -> i64 { return 46; }
fn OP_T_SUB() -> i64 { return 47; }
fn OP_T_MUL() -> i64 { return 48; }
fn OP_T_RESHAPE() -> i64 { return 49; }
fn OP_T_TRANSPOSE() -> i64 { return 50; }
fn OP_T_SCALE() -> i64 { return 51; }
fn OP_T_SUM() -> i64 { return 52; }
fn OP_T_DOT() -> i64 { return 53; }
fn OP_T_EXP() -> i64 { return 54; }
fn OP_T_LOG() -> i64 { return 55; }
fn OP_T_SOFTMAX() -> i64 { return 56; }
fn OP_T_MEAN() -> i64 { return 57; }
fn OP_T_MSE() -> i64 { return 58; }
fn OP_MEM_CONFIG() -> i64 { return 59; }
fn OP_MEM_REMEMBER() -> i64 { return 60; }
fn OP_MEM_SURPRISE() -> i64 { return 61; }
fn OP_MEM_FORESEE() -> i64 { return 62; }
fn OP_MEM_CONSOLIDATE() -> i64 { return 63; }
fn OP_MEM_STATS() -> i64 { return 64; }
fn OP_MEM_RECALL() -> i64 { return 65; }
fn OP_SAVE_MIND() -> i64 { return 66; }
fn OP_LOAD_MIND() -> i64 { return 67; }
