// Self-host compiler on Kenga (canonical). Replaces growing slice of src/compiler.rs + vm.rs.
// Run: bootstrap\bin\kenga-lite.exe run kenga\compiler\more.kenga
// Dialect: i64/f64, lists, str, for/break/continue, else if, xs[i]=, struct, import,
//          XOR, birth→24, c_seed/expr_c (Kenga writes .c) via run_file.
//          on/emit/pump/pending, types/ttl skip, && || % !

fn OP_CONST() -> i64 { return 1; }
fn OP_LOAD() -> i64 { return 2; }
fn OP_STORE() -> i64 { return 3; }
fn OP_ADD() -> i64 { return 4; }
fn OP_SUB() -> i64 { return 5; }
fn OP_MUL() -> i64 { return 6; }
fn OP_DIV() -> i64 { return 7; }
fn OP_LT() -> i64 { return 8; }
fn OP_GT() -> i64 { return 9; }
fn OP_EQ() -> i64 { return 10; }
fn OP_JMP() -> i64 { return 11; }
fn OP_JMPF() -> i64 { return 12; }
fn OP_HALT() -> i64 { return 13; }
fn OP_LE() -> i64 { return 14; }
fn OP_CALL() -> i64 { return 15; }
fn OP_RET() -> i64 { return 16; }
fn OP_PRINTLN() -> i64 { return 17; }
fn OP_ASSERT() -> i64 { return 18; }
fn OP_ROUND() -> i64 { return 19; }
fn OP_POP() -> i64 { return 20; }
fn OP_LIST_NEW() -> i64 { return 21; }
fn OP_LIST_PUSH() -> i64 { return 22; }
fn OP_LEN() -> i64 { return 23; }
fn OP_GET() -> i64 { return 24; }
fn OP_NE() -> i64 { return 25; }
fn OP_GE() -> i64 { return 26; }
fn OP_ORD() -> i64 { return 27; }
fn OP_SET() -> i64 { return 28; }
fn OP_EMIT() -> i64 { return 29; }
fn OP_PUMP() -> i64 { return 30; }
fn OP_PENDING() -> i64 { return 31; }
fn OP_WRITE_FILE() -> i64 { return 32; }
fn OP_READ_FILE() -> i64 { return 33; }
fn OP_MOD() -> i64 { return 34; }
fn OP_AND() -> i64 { return 35; }
fn OP_OR() -> i64 { return 36; }
fn OP_NOT() -> i64 { return 37; }

fn itoa(n: i64) -> str {
    let digs: str = "0123456789";
    if n == 0 { return "0"; }
    let s: str = "";
    let x: i64 = n;
    if x < 0 { x = 0 - x; }
    while x > 0 {
        let d: i64 = x - (x / 10) * 10;
        s = digs[d] + s;
        x = x / 10;
    }
    if n < 0 { return "-" + s; }
    return s;
}

fn list_tail(xs: list) -> list {
    let out: list = [];
    let i: i64 = 1;
    while i < len(xs) { out = push(out, xs[i]); i = i + 1; }
    return out;
}

fn find_bind(binds: list, ev: str) -> list {
    // [found, addr, arity]
    let i: i64 = 0;
    while i < len(binds) {
        if binds[i][0] == ev { return [1, binds[i][1], binds[i][2]]; }
        i = i + 1;
    }
    return [0, 0, 0];
}

fn empty_lctx() -> list {
    // [conts, brkss, contss, tmpn]
    return [[], [], [], 0];
}
fn lctx_push(lctx: list, cont_target: i64) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let contss: list = lctx[2];
    conts = push(conts, cont_target);
    brkss = push(brkss, []);
    contss = push(contss, []);
    return [conts, brkss, contss, lctx[3]];
}
fn lctx_set_cont(lctx: list, cont_target: i64) -> list {
    let conts: list = lctx[0];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    conts[depth] = cont_target;
    return [conts, lctx[1], lctx[2], lctx[3]];
}
fn lctx_pop_finish(code: list, lctx: list, end_ip: i64) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let contss: list = lctx[2];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let cont_target: i64 = conts[depth];
    let brks: list = brkss[depth];
    let conts_p: list = contss[depth];
    let bi: i64 = 0;
    while bi < len(brks) {
        code[brks[bi] + 1] = end_ip;
        bi = bi + 1;
    }
    let ci: i64 = 0;
    while ci < len(conts_p) {
        code[conts_p[ci] + 1] = cont_target;
        ci = ci + 1;
    }
    let nconts: list = [];
    let nbrkss: list = [];
    let ncontss: list = [];
    let i: i64 = 0;
    while i < depth {
        nconts = push(nconts, conts[i]);
        nbrkss = push(nbrkss, brkss[i]);
        ncontss = push(ncontss, contss[i]);
        i = i + 1;
    }
    return [code, [nconts, nbrkss, ncontss, lctx[3]]];
}
fn lctx_add_break(code: list, lctx: list) -> list {
    let conts: list = lctx[0];
    let brkss: list = lctx[1];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let at: i64 = len(code);
    code = emit2(code, OP_JMP(), 0);
    let brks: list = brkss[depth];
    brks = push(brks, at);
    brkss[depth] = brks;
    return [code, [conts, brkss, lctx[2], lctx[3]]];
}
fn lctx_add_continue(code: list, lctx: list) -> list {
    let conts: list = lctx[0];
    let contss: list = lctx[2];
    let depth: i64 = len(conts) - 1;
    assert(depth >= 0);
    let at: i64 = len(code);
    code = emit2(code, OP_JMP(), 0);
    let cps: list = contss[depth];
    cps = push(cps, at);
    contss[depth] = cps;
    return [code, [conts, lctx[1], contss, lctx[3]]];
}
fn skip_type_annot(s: str, i: i64) -> i64 {
    i = skip(s, i);
    if i >= len(s) { return i; }
    if s[i] != ":" { return i; }
    i = skip(s, i + 1);
    let ty = parse_ident(s, i);
    i = skip(s, ty[1]);
    if starts_kw(s, i, "ttl") == 1 {
        i = skip(s, i + 3);
        while i < len(s) {
            if is_digit(s[i]) == 0 { break; }
            i = i + 1;
        }
        if i + 1 < len(s) {
            if s[i] == "m" {
                if s[i + 1] == "s" { i = i + 2; return i; }
            }
        }
        if i < len(s) {
            if s[i] == "s" { i = i + 1; }
            if s[i] == "m" { i = i + 1; }
            if s[i] == "h" { i = i + 1; }
            if s[i] == "d" { i = i + 1; }
        }
    }
    return i;
}
fn dirname_of(path: str) -> str {
    let i: i64 = len(path) - 1;
    while i >= 0 {
        if path[i] == "/" { break; }
        if path[i] == "\\" { break; }
        i = i - 1;
    }
    if i < 0 { return "."; }
    let out: str = "";
    let j: i64 = 0;
    while j < i { out = out + path[j]; j = j + 1; }
    if len(out) == 0 { return "."; }
    return out;
}
fn join_path(dir: str, rel: str) -> str {
    if len(dir) == 0 { return rel; }
    if dir == "." { return rel; }
    return dir + "/" + rel;
}
fn resolve_imports(path: str, depth: i64) -> str {
    assert(depth < 32);
    let src: str = read_file(path);
    let dir: str = dirname_of(path);
    let i: i64 = 0;
    let acc: str = "";
    while true {
        i = skip(src, i);
        if starts_kw(src, i, "import") == 0 { break; }
        i = skip(src, i + 6);
        assert(src[i] == "\"");
        let ps = parse_string(src, i);
        i = ps[1];
        i = skip(src, i);
        if i < len(src) { if src[i] == ";" { i = i + 1; } }
        let dep_path: str = join_path(dir, ps[0]);
        acc = acc + resolve_imports(dep_path, depth + 1);
        acc = acc + "\n";
    }
    let rest: str = "";
    while i < len(src) { rest = rest + src[i]; i = i + 1; }
    return acc + rest;
}

fn list_pop(xs: list) -> list {
    let n: i64 = len(xs);
    assert(n > 0);
    let v = xs[n - 1];
    let out: list = [];
    let i: i64 = 0;
    while i < n - 1 { out = push(out, xs[i]); i = i + 1; }
    return [out, v];
}
fn ensure_slot(slots: list, si: i64) -> list {
    while len(slots) <= si { slots = push(slots, 0); }
    return slots;
}

fn vm_run(code: list, binds: list, start_ip: i64, init_slots: list, evq: list) -> list {
    // returns [result, evq]
    let stack: list = [];
    let slots: list = init_slots;
    let ret_ips: list = [];
    let slot_bases: list = [];
    let ip: i64 = start_ip;
    let slot_base: i64 = 0;
    while ip < len(code) {
        let op: i64 = code[ip]; ip = ip + 1;
        if op == OP_HALT() {
            if len(stack) == 0 { return [0, evq]; }
            return [stack[len(stack) - 1], evq];
        }
        if op == OP_CONST() { stack = push(stack, code[ip]); ip = ip + 1; }
        if op == OP_LOAD() {
            let si: i64 = slot_base + code[ip]; ip = ip + 1;
            slots = ensure_slot(slots, si); stack = push(stack, slots[si]);
        }
        if op == OP_STORE() {
            let si: i64 = slot_base + code[ip]; ip = ip + 1;
            slots = ensure_slot(slots, si);
            let p = list_pop(stack); stack = p[0]; slots[si] = p[1]; stack = push(stack, p[1]);
        }
        if op == OP_ADD() { let b=list_pop(stack); let a=list_pop(b[0]); stack=push(a[0], a[1]+b[1]); }
        if op == OP_SUB() { let b=list_pop(stack); let a=list_pop(b[0]); stack=push(a[0], a[1]-b[1]); }
        if op == OP_MUL() { let b=list_pop(stack); let a=list_pop(b[0]); stack=push(a[0], a[1]*b[1]); }
        if op == OP_DIV() { let b=list_pop(stack); let a=list_pop(b[0]); stack=push(a[0], a[1]/b[1]); }
        if op == OP_MOD() {
            let b=list_pop(stack); let a=list_pop(b[0]);
            let q = a[1] / b[1];
            stack=push(a[0], a[1] - q * b[1]);
        }
        if op == OP_AND() {
            let b=list_pop(stack); let a=list_pop(b[0]);
            let r: i64 = 0;
            if a[1] != 0 {
                if b[1] != 0 { r = 1; }
            }
            stack=push(a[0], r);
        }
        if op == OP_OR() {
            let b=list_pop(stack); let a=list_pop(b[0]);
            let r: i64 = 0;
            if a[1] != 0 { r = 1; }
            if b[1] != 0 { r = 1; }
            stack=push(a[0], r);
        }
        if op == OP_NOT() {
            let p=list_pop(stack);
            let r: i64 = 1;
            if p[1] != 0 { r = 0; }
            stack=push(p[0], r);
        }
        if op == OP_LT() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]<b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_GT() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]>b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_EQ() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]==b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_LE() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]<=b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_NE() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]!=b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_GE() { let b=list_pop(stack); let a=list_pop(b[0]); let r:i64=0; if a[1]>=b[1]{r=1;} stack=push(a[0],r); }
        if op == OP_JMP() { ip = code[ip]; }
        if op == OP_JMPF() {
            let t: i64 = code[ip]; ip = ip + 1;
            let p = list_pop(stack); stack = p[0]; if p[1] == 0 { ip = t; }
        }
        if op == OP_CALL() {
            let addr: i64 = code[ip]; ip = ip + 1;
            let argc: i64 = code[ip]; ip = ip + 1;
            let args: list = []; let ai: i64 = 0;
            while ai < argc { let p=list_pop(stack); stack=p[0]; args=push(args,p[1]); ai=ai+1; }
            let args2: list = []; ai = len(args)-1;
            while ai >= 0 { args2=push(args2, args[ai]); ai=ai-1; }
            ret_ips = push(ret_ips, ip);
            slot_bases = push(slot_bases, slot_base);
            slot_base = len(slots);
            ai = 0;
            while ai < argc {
                slots = ensure_slot(slots, slot_base + ai);
                slots[slot_base + ai] = args2[ai]; ai = ai + 1;
            }
            ip = addr;
        }
        if op == OP_RET() {
            let retv = 0;
            if len(stack) > 0 {
                let p = list_pop(stack); retv = p[1]; stack = p[0];
            }
            if len(ret_ips) == 0 {
                return [retv, evq];
            }
            let new_slots: list = []; let si: i64 = 0;
            while si < slot_base { new_slots = push(new_slots, slots[si]); si = si + 1; }
            slots = new_slots;
            let rb = list_pop(slot_bases); slot_bases = rb[0]; slot_base = rb[1];
            let ri = list_pop(ret_ips); ret_ips = ri[0]; ip = ri[1];
            stack = push(stack, retv);
        }
        if op == OP_PRINTLN() {
            let p = list_pop(stack); stack = p[0]; println(p[1]);
        }
        if op == OP_ASSERT() {
            let p = list_pop(stack); stack = p[0]; assert(p[1]);
        }
        if op == OP_ROUND() {
            let p = list_pop(stack); stack = push(p[0], round(p[1]));
        }
        if op == OP_POP() {
            let p = list_pop(stack); stack = p[0];
        }
        if op == OP_LIST_NEW() { stack = push(stack, []); }
        if op == OP_LIST_PUSH() {
            let pv = list_pop(stack); let px = list_pop(pv[0]);
            stack = push(px[0], push(px[1], pv[1]));
        }
        if op == OP_LEN() {
            let p = list_pop(stack); stack = push(p[0], len(p[1]));
        }
        if op == OP_GET() {
            let pi = list_pop(stack); let px = list_pop(pi[0]);
            stack = push(px[0], px[1][pi[1]]);
        }
        if op == OP_SET() {
            let pv = list_pop(stack);
            let pi = list_pop(pv[0]);
            let px = list_pop(pi[0]);
            let xs = px[1];
            xs[pi[1]] = pv[1];
            stack = push(px[0], xs);
        }
        if op == OP_ORD() {
            let p = list_pop(stack); stack = push(p[0], ord(p[1]));
        }
        if op == OP_EMIT() {
            let pv = list_pop(stack);
            let pe = list_pop(pv[0]);
            stack = pe[0];
            evq = push(evq, [pe[1], pv[1]]);
            stack = push(stack, 0);
        }
        if op == OP_PENDING() {
            stack = push(stack, len(evq));
        }
        if op == OP_WRITE_FILE() {
            let pc = list_pop(stack);
            let pp = list_pop(pc[0]);
            let ok = write_file(pp[1], pc[1]);
            let r: i64 = 0;
            if ok == true { r = 1; }
            stack = push(pp[0], r);
        }
        if op == OP_READ_FILE() {
            let p = list_pop(stack);
            stack = push(p[0], read_file(p[1]));
        }
        if op == OP_PUMP() {
            let pm = list_pop(stack); stack = pm[0];
            let left: i64 = pm[1];
            let done: i64 = 0;
            while left > 0 {
                if len(evq) == 0 { break; }
                let item = evq[0];
                evq = list_tail(evq);
                left = left - 1;
                let hb = find_bind(binds, item[0]);
                if hb[0] == 1 {
                    let init: list = [];
                    if hb[2] == 1 {
                        init = push(init, item[1]);
                    } else {
                        if hb[2] != 0 { assert(0 == 1); }
                    }
                    let hr = vm_run(code, binds, hb[1], init, evq);
                    evq = hr[1];
                    done = done + 1;
                }
            }
            stack = push(stack, done);
        }
    }
    if len(stack) == 0 { return [0, evq]; }
    return [stack[len(stack) - 1], evq];
}

fn vm_exec(code: list, binds: list) -> i64 {
    let r = vm_run(code, binds, 0, [], []);
    return r[0];
}

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        if s[i] == "/" {
            if i + 1 < len(s) {
                if s[i + 1] == "/" {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
                if s[i + 1] == "*" {
                    i = i + 2;
                    let closed: i64 = 0;
                    while i + 1 < len(s) {
                        if s[i] == "*" {
                            if s[i + 1] == "/" {
                                i = i + 2;
                                closed = 1;
                                break;
                            }
                        }
                        i = i + 1;
                    }
                    assert(closed == 1);
                    continue;
                }
            }
        }
        break;
    }
    return i;
}
fn starts_with(s: str, i: i64, w: str) -> i64 {
    let j: i64 = 0;
    while j < len(w) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != w[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
fn starts_kw(s: str, i: i64, w: str) -> i64 {
    if starts_with(s, i, w) == 0 { return 0; }
    if i + len(w) < len(s) {
        let n: str = s[i + len(w)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i); let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch; i = i + 1;
    }
    return [name, i];
}
fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i); let v: i64 = 0;
    while i < len(s) {
        if is_digit(s[i]) == 0 { break; }
        v = v * 10 + (ord(s[i]) - 48); i = i + 1;
    }
    if i < len(s) {
        if s[i] == "." {
            // `0..n` range — not a float
            if i + 1 < len(s) {
                if s[i + 1] == "." { return [v, i]; }
            }
            i = i + 1;
            let f = v + 0.0;
            let place = 0.1;
            while i < len(s) {
                if is_digit(s[i]) == 0 { break; }
                let d = (ord(s[i]) - 48) + 0.0;
                f = f + d * place;
                place = place * 0.1;
                i = i + 1;
            }
            return [f, i];
        }
    }
    return [v, i];
}
fn parse_string(s: str, i: i64) -> list {
    assert(s[i] == "\"");
    i = i + 1;
    let out: str = "";
    while i < len(s) {
        if s[i] == "\\" {
            i = i + 1;
            assert(i < len(s));
            if s[i] == "n" {
                out = out + "\n";
            } else {
                if s[i] == "t" {
                    out = out + "\t";
                } else {
                    out = out + s[i];
                }
            }
            i = i + 1;
            continue;
        }
        if s[i] == "\"" { return [out, i + 1]; }
        out = out + s[i];
        i = i + 1;
    }
    assert(0 == 1);
    return [out, i];
}
fn slot_of(vnames: list, name: str) -> list {
    let i: i64 = 0;
    while i < len(vnames) { if vnames[i] == name { return [i, vnames]; } i = i + 1; }
    vnames = push(vnames, name);
    return [len(vnames) - 1, vnames];
}
fn emit2(code: list, a: i64, b) -> list { code = push(code, a); return push(code, b); }
fn emit3(code: list, a: i64, b: i64, c: i64) -> list {
    code = push(code, a); code = push(code, b); return push(code, c);
}

fn find_struct(stypes: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(stypes) {
        if stypes[i][0] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
fn field_index(fields: list, name: str) -> i64 {
    let i: i64 = 0;
    while i < len(fields) {
        if fields[i] == name { return i; }
        i = i + 1;
    }
    assert(0 == 1);
    return 0;
}
fn field_index_any(stypes: list, name: str) -> i64 {
    let si: i64 = 0;
    while si < len(stypes) {
        let fields: list = stypes[si][1];
        let fi: i64 = 0;
        while fi < len(fields) {
            if fields[fi] == name { return fi; }
            fi = fi + 1;
        }
        si = si + 1;
    }
    assert(0 == 1);
    return 0;
}

fn emit_factor(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    i = skip(s, i);
    if s[i] == "(" {
        let r = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = skip(s, r[1]); vnames = r[2]; patches = r[3]; assert(s[i] == ")");
        i = i + 1;
    } else {
        if s[i] == "-" {
            code = emit2(code, OP_CONST(), 0);
            let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_SUB()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "!" {
                let r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_NOT()); i = r[1]; vnames = r[2]; patches = r[3];
            } else {
            if s[i] == "\"" {
                let ps = parse_string(s, i);
                code = emit2(code, OP_CONST(), ps[0]); i = ps[1];
            } else {
                if s[i] == "[" {
                    i = i + 1;
                    code = push(code, OP_LIST_NEW());
                    i = skip(s, i);
                    if s[i] != "]" {
                        while true {
                            let ar = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
                            code = push(ar[0], OP_LIST_PUSH()); i = ar[1]; vnames = ar[2]; patches = ar[3];
                            i = skip(s, i);
                            if s[i] == "," { i = i + 1; continue; }
                            break;
                        }
                    }
                    assert(s[i] == "]"); i = i + 1;
                } else {
                    if is_alpha(s[i]) == 1 {
                        let id = parse_ident(s, i);
                        let j: i64 = skip(s, id[1]);
                        if j < len(s) {
                            if s[j] == "(" {
                                j = j + 1; j = skip(s, j);
                                if id[0] == "round" {
                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                    j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                    code = push(code, OP_ROUND());
                                    i = j;
                                } else {
                                    if id[0] == "ord" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_ORD());
                                        i = j;
                                    } else {
                                    if id[0] == "len" {
                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                        code = push(code, OP_LEN());
                                        i = j;
                                    } else {
                                        if id[0] == "push" {
                                            let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                            code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                            j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                            ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                            code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                            j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                            code = push(code, OP_LIST_PUSH());
                                            i = j;
                                        } else {
                                            if id[0] == "emit" {
                                                let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                code = push(code, OP_EMIT());
                                                i = j;
                                            } else {
                                                if id[0] == "pump" {
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                    j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                    code = push(code, OP_PUMP());
                                                    i = j;
                                                } else {
                                                    if id[0] == "pending" {
                                                        assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_PENDING());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "write_file" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ","); j = j + 1;
                                                        ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_WRITE_FILE());
                                                        i = j;
                                                    } else {
                                                    if id[0] == "read_file" {
                                                        let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                        code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                        j = skip(s, j); assert(s[j] == ")"); j = j + 1;
                                                        code = push(code, OP_READ_FILE());
                                                        i = j;
                                                    } else {
                                            let argc: i64 = 0;
                                            if s[j] != ")" {
                                                while true {
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = ar[0]; j = ar[1]; vnames = ar[2]; patches = ar[3]; argc = argc + 1;
                                                    j = skip(s, j);
                                                    if s[j] == "," { j = j + 1; continue; }
                                                    break;
                                                }
                                            }
                                            assert(s[j] == ")"); j = j + 1;
                                            let fi: i64 = 0; let found: i64 = 0; let fni: i64 = 0;
                                            while fi < len(fnames) {
                                                if fnames[fi] == id[0] {
                                                    found = 1; fni = fi; assert(fargc[fi] == argc);
                                                }
                                                fi = fi + 1;
                                            }
                                            assert(found == 1);
                                            let addr_at: i64 = len(code) + 1;
                                            code = emit3(code, OP_CALL(), faddrs[fni], argc);
                                            if faddrs[fni] == 0 {
                                                patches = push(patches, [addr_at, fni]);
                                            }
                                            i = j;
                                                    }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    }
                                }
                            } else {
                                if id[0] == "true" {
                                    code = emit2(code, OP_CONST(), 1); i = id[1];
                                } else {
                                    if id[0] == "false" {
                                        code = emit2(code, OP_CONST(), 0); i = id[1];
                                    } else {
                                        if s[j] == "{" {
                                            let tid: i64 = find_struct(stypes, id[0]);
                                            if tid < 0 {
                                                let sl = slot_of(vnames, id[0]);
                                                code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                            } else {
                                                let fields: list = stypes[tid][1];
                                                j = j + 1;
                                                code = push(code, OP_LIST_NEW());
                                                let fi: i64 = 0;
                                                while fi < len(fields) {
                                                    j = skip(s, j);
                                                    let fnm = parse_ident(s, j);
                                                    assert(fnm[0] == fields[fi]);
                                                    j = skip(s, fnm[1]);
                                                    assert(s[j] == ":"); j = j + 1;
                                                    let ar = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                                    code = push(ar[0], OP_LIST_PUSH()); j = ar[1]; vnames = ar[2]; patches = ar[3];
                                                    j = skip(s, j);
                                                    if j < len(s) { if s[j] == "," { j = j + 1; } }
                                                    fi = fi + 1;
                                                }
                                                j = skip(s, j);
                                                assert(s[j] == "}"); j = j + 1;
                                                i = j;
                                            }
                                        } else {
                                            let sl = slot_of(vnames, id[0]);
                                            code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                        }
                                    }
                                }
                            }
                        } else {
                            if id[0] == "true" {
                                code = emit2(code, OP_CONST(), 1); i = id[1];
                            } else {
                                if id[0] == "false" {
                                    code = emit2(code, OP_CONST(), 0); i = id[1];
                                } else {
                                    let sl = slot_of(vnames, id[0]);
                                    code = emit2(code, OP_LOAD(), sl[0]); i = id[1]; vnames = sl[1];
                                }
                            }
                        }
                    } else {
                        let n = parse_number(s, i);
                        code = emit2(code, OP_CONST(), n[0]); i = n[1];
                    }
                }
            }
            }
        }
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "[" { break; }
        let ix = emit_cmp(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = ix[0]; i = ix[1]; vnames = ix[2]; patches = ix[3];
        i = skip(s, i); assert(s[i] == "]"); i = i + 1;
        code = push(code, OP_GET());
    }
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] != "." { break; }
        // `..` is range, not field
        if i + 1 < len(s) {
            if s[i + 1] == "." { break; }
        }
        let fld = parse_ident(s, i + 1);
        assert(len(fld[0]) > 0);
        let fidx: i64 = field_index_any(stypes, fld[0]);
        code = emit2(code, OP_CONST(), fidx);
        code = push(code, OP_GET());
        i = fld[1];
    }
    return [code, i, vnames, patches];
}

fn emit_term(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_factor(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "*" {
            r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_MUL()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "/" {
                r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_DIV()); i = r[1]; vnames = r[2]; patches = r[3];
            } else {
                if s[i] == "%" {
                    r = emit_factor(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                    code = push(r[0], OP_MOD()); i = r[1]; vnames = r[2]; patches = r[3];
                } else { break; }
            }
        }
    }
    return [code, i, vnames, patches];
}

fn emit_sum(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_term(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if s[i] == "+" {
            r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_ADD()); i = r[1]; vnames = r[2]; patches = r[3];
        } else {
            if s[i] == "-" {
                r = emit_term(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = push(r[0], OP_SUB()); i = r[1]; vnames = r[2]; patches = r[3];
            } else { break; }
        }
    }
    return [code, i, vnames, patches];
}

fn emit_rel(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_sum(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3]; i = skip(s, i);
    if i >= len(s) { return [code, i, vnames, patches]; }
    if starts_with(s, i, "<=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_LE()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, ">=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_GE()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, "==") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_EQ()), r[1], r[2], r[3]];
    }
    if starts_with(s, i, "!=") == 1 {
        r = emit_sum(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_NE()), r[1], r[2], r[3]];
    }
    if s[i] == "<" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_LT()), r[1], r[2], r[3]];
    }
    if s[i] == ">" {
        r = emit_sum(s, i + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
        return [push(r[0], OP_GT()), r[1], r[2], r[3]];
    }
    return [code, i, vnames, patches];
}

fn emit_and(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_rel(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "&&") == 1 {
            r = emit_rel(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_AND()); i = r[1]; vnames = r[2]; patches = r[3];
        } else { break; }
    }
    return [code, i, vnames, patches];
}

fn emit_or(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    let r = emit_and(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    while true {
        i = skip(s, i); if i >= len(s) { break; }
        if starts_with(s, i, "||") == 1 {
            r = emit_and(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = push(r[0], OP_OR()); i = r[1]; vnames = r[2]; patches = r[3];
        } else { break; }
    }
    return [code, i, vnames, patches];
}

fn emit_cmp(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list) -> list {
    return emit_or(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
}

fn emit_block(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list, lctx: list) -> list {
    i = skip(s, i); assert(s[i] == "{"); i = i + 1;
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if s[i] == "}" { break; }
        let st = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = st[0]; i = st[1]; vnames = st[2]; patches = st[3]; lctx = st[4];
    }
    assert(s[i] == "}");
    return [code, i + 1, vnames, patches, lctx];
}

fn emit_stmt(s: str, i: i64, code: list, vnames: list, fnames: list, faddrs: list, fargc: list, stypes: list, patches: list, lctx: list) -> list {
    i = skip(s, i);
    if starts_kw(s, i, "let") == 1 {
        i = skip(s, i + 3);
        let id = parse_ident(s, i);
        i = skip_type_annot(s, id[1]);
        i = skip(s, i);
        assert(s[i] == "="); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let sl = slot_of(vnames, id[0]); vnames = sl[1];
        code = emit2(code, OP_STORE(), sl[0]);
        code = push(code, OP_POP());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "println") == 1 {
        i = skip(s, i + 7);
        assert(s[i] == "("); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i); assert(s[i] == ")"); i = i + 1;
        code = push(code, OP_PRINTLN());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "assert") == 1 {
        i = skip(s, i + 6);
        assert(s[i] == "("); i = i + 1;
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i); assert(s[i] == ")"); i = i + 1;
        code = push(code, OP_ASSERT());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "return") == 1 {
        let r = emit_cmp(s, i + 6, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        code = push(code, OP_RET());
        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "while") == 1 {
        let loop_start: i64 = len(code);
        let r = emit_cmp(s, i + 5, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        lctx = lctx_push(lctx, loop_start);
        let bl = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl[0]; i = bl[1]; vnames = bl[2]; patches = bl[3]; lctx = bl[4];
        code = emit2(code, OP_JMP(), loop_start);
        code[jmpf_at + 1] = len(code);
        let fin = lctx_pop_finish(code, lctx, len(code));
        code = fin[0]; lctx = fin[1];
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "for") == 1 {
        i = skip(s, i + 3);
        let var = parse_ident(s, i);
        i = skip(s, var[1]);
        assert(starts_kw(s, i, "in") == 1);
        i = skip(s, i + 2);
        let sl = slot_of(vnames, var[0]); vnames = sl[1];
        let vslot: i64 = sl[0];
        let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        i = skip(s, i);
        if starts_with(s, i, "..") == 1 {
            code = emit2(code, OP_STORE(), vslot);
            code = push(code, OP_POP());
            i = skip(s, i + 2);
            let tmpn: i64 = lctx[3];
            let digs: str = "0123456789";
            let endn: str = "__fe";
            let t: i64 = tmpn;
            let digits: str = "";
            if t == 0 { digits = "0"; }
            while t > 0 {
                let d: i64 = t - (t / 10) * 10;
                digits = digs[d] + digits;
                t = t / 10;
            }
            endn = endn + digits;
            lctx = [lctx[0], lctx[1], lctx[2], tmpn + 1];
            let esl = slot_of(vnames, endn); vnames = esl[1];
            let eslot: i64 = esl[0];
            r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
            code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
            code = emit2(code, OP_STORE(), eslot);
            code = push(code, OP_POP());
            let loop_start: i64 = len(code);
            code = emit2(code, OP_LOAD(), vslot);
            code = emit2(code, OP_LOAD(), eslot);
            code = push(code, OP_LT());
            let jmpf_at: i64 = len(code);
            code = emit2(code, OP_JMPF(), 0);
            lctx = lctx_push(lctx, 0);
            let bl = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
            code = bl[0]; i = bl[1]; vnames = bl[2]; patches = bl[3]; lctx = bl[4];
            let cont_at: i64 = len(code);
            lctx = lctx_set_cont(lctx, cont_at);
            code = emit2(code, OP_LOAD(), vslot);
            code = emit2(code, OP_CONST(), 1);
            code = push(code, OP_ADD());
            code = emit2(code, OP_STORE(), vslot);
            code = push(code, OP_POP());
            code = emit2(code, OP_JMP(), loop_start);
            code[jmpf_at + 1] = len(code);
            let fin = lctx_pop_finish(code, lctx, len(code));
            code = fin[0]; lctx = fin[1];
            return [code, i, vnames, patches, lctx];
        }
        // list iteration
        let tmpn2: i64 = lctx[3];
        let digs2: str = "0123456789";
        let td: str = "";
        let t2: i64 = tmpn2;
        if t2 == 0 { td = "0"; }
        while t2 > 0 {
            let d2: i64 = t2 - (t2 / 10) * 10;
            td = digs2[d2] + td;
            t2 = t2 / 10;
        }
        let ln: str = "__fl" + td;
        let ix: str = "__fi" + td;
        lctx = [lctx[0], lctx[1], lctx[2], tmpn2 + 1];
        let lsl = slot_of(vnames, ln); vnames = lsl[1];
        let lslot: i64 = lsl[0];
        let isl = slot_of(vnames, ix); vnames = isl[1];
        let islot: i64 = isl[0];
        code = emit2(code, OP_STORE(), lslot);
        code = push(code, OP_POP());
        code = emit2(code, OP_CONST(), 0);
        code = emit2(code, OP_STORE(), islot);
        code = push(code, OP_POP());
        let loop_start2: i64 = len(code);
        code = emit2(code, OP_LOAD(), islot);
        code = emit2(code, OP_LOAD(), lslot);
        code = push(code, OP_LEN());
        code = push(code, OP_LT());
        let jmpf_at2: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        code = emit2(code, OP_LOAD(), lslot);
        code = emit2(code, OP_LOAD(), islot);
        code = push(code, OP_GET());
        code = emit2(code, OP_STORE(), vslot);
        code = push(code, OP_POP());
        lctx = lctx_push(lctx, 0);
        let bl2 = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl2[0]; i = bl2[1]; vnames = bl2[2]; patches = bl2[3]; lctx = bl2[4];
        let cont_at2: i64 = len(code);
        lctx = lctx_set_cont(lctx, cont_at2);
        code = emit2(code, OP_LOAD(), islot);
        code = emit2(code, OP_CONST(), 1);
        code = push(code, OP_ADD());
        code = emit2(code, OP_STORE(), islot);
        code = push(code, OP_POP());
        code = emit2(code, OP_JMP(), loop_start2);
        code[jmpf_at2 + 1] = len(code);
        let fin2 = lctx_pop_finish(code, lctx, len(code));
        code = fin2[0]; lctx = fin2[1];
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "break") == 1 {
        let br = lctx_add_break(code, lctx);
        code = br[0]; lctx = br[1];
        i = skip(s, i + 5);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "continue") == 1 {
        let cr = lctx_add_continue(code, lctx);
        code = cr[0]; lctx = cr[1];
        i = skip(s, i + 8);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [code, i, vnames, patches, lctx];
    }
    if starts_kw(s, i, "if") == 1 {
        let r = emit_cmp(s, i + 2, code, vnames, fnames, faddrs, fargc, stypes, patches);
        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
        let jmpf_at: i64 = len(code);
        code = emit2(code, OP_JMPF(), 0);
        let th = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = th[0]; i = th[1]; vnames = th[2]; patches = th[3]; lctx = th[4];
        i = skip(s, i);
        if starts_kw(s, i, "else") == 1 {
            let jmp_at: i64 = len(code);
            code = emit2(code, OP_JMP(), 0);
            code[jmpf_at + 1] = len(code);
            i = skip(s, i + 4);
            if starts_kw(s, i, "if") == 1 {
                let el = emit_stmt(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
                code = el[0]; i = el[1]; vnames = el[2]; patches = el[3]; lctx = el[4];
            } else {
                let el = emit_block(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
                code = el[0]; i = el[1]; vnames = el[2]; patches = el[3]; lctx = el[4];
            }
            code[jmp_at + 1] = len(code);
        } else {
            code[jmpf_at + 1] = len(code);
        }
        return [code, i, vnames, patches, lctx];
    }
    // bare assign, xs[i]=, or expr
    if is_alpha(s[i]) == 1 {
        let save: i64 = i;
        let id = parse_ident(s, i);
        let j: i64 = skip(s, id[1]);
        if j < len(s) {
            if s[j] == "[" {
                let sl = slot_of(vnames, id[0]); vnames = sl[1];
                code = emit2(code, OP_LOAD(), sl[0]);
                j = j + 1;
                let ix = emit_cmp(s, j, code, vnames, fnames, faddrs, fargc, stypes, patches);
                code = ix[0]; j = ix[1]; vnames = ix[2]; patches = ix[3];
                j = skip(s, j); assert(s[j] == "]"); j = skip(s, j + 1);
                if j < len(s) {
                    if s[j] == "=" {
                        if starts_with(s, j, "==") == 0 {
                            let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                            code = r[0]; j = r[1]; vnames = r[2]; patches = r[3];
                            code = push(code, OP_SET());
                            code = emit2(code, OP_STORE(), sl[0]);
                            code = push(code, OP_POP());
                            j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                            return [code, j, vnames, patches, lctx];
                        }
                    }
                }
                // not assignment — drop the LOAD we emitted and reparse as expr
                // (LOAD + slot = 2 ops)
                let nc: list = [];
                let ki: i64 = 0;
                while ki < len(code) - 2 { nc = push(nc, code[ki]); ki = ki + 1; }
                code = nc;
                i = save;
            } else {
                if s[j] == "." {
                    let sl = slot_of(vnames, id[0]); vnames = sl[1];
                    let fld = parse_ident(s, j + 1);
                    j = skip(s, fld[1]);
                    if j < len(s) {
                        if s[j] == "=" {
                            if starts_with(s, j, "==") == 0 {
                                let fidx: i64 = field_index_any(stypes, fld[0]);
                                code = emit2(code, OP_LOAD(), sl[0]);
                                code = emit2(code, OP_CONST(), fidx);
                                let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                                code = r[0]; j = r[1]; vnames = r[2]; patches = r[3];
                                code = push(code, OP_SET());
                                code = emit2(code, OP_STORE(), sl[0]);
                                code = push(code, OP_POP());
                                j = skip(s, j); if j < len(s) { if s[j] == ";" { j = j + 1; } }
                                return [code, j, vnames, patches, lctx];
                            }
                        }
                    }
                    i = save;
                } else {
                if s[j] == "=" {
                    if starts_with(s, j, "==") == 0 {
                        let r = emit_cmp(s, j + 1, code, vnames, fnames, faddrs, fargc, stypes, patches);
                        code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
                        let sl = slot_of(vnames, id[0]); vnames = sl[1];
                        code = emit2(code, OP_STORE(), sl[0]);
                        code = push(code, OP_POP());
                        i = skip(s, i); if i < len(s) { if s[i] == ";" { i = i + 1; } }
                        return [code, i, vnames, patches, lctx];
                    }
                }
                }
            }
        }
    }
    let r = emit_cmp(s, i, code, vnames, fnames, faddrs, fargc, stypes, patches);
    code = r[0]; i = r[1]; vnames = r[2]; patches = r[3];
    i = skip(s, i);
    if i < len(s) {
        if s[i] == ";" {
            i = i + 1;
            code = push(code, OP_POP());
        }
    }
    return [code, i, vnames, patches, lctx];
}

fn match_brace(src: str, i: i64) -> i64 {
    assert(src[i] == "{");
    let depth: i64 = 0;
    let n: i64 = len(src);
    while i < n {
        let ch: str = src[i];
        if ch == "/" {
            if i + 1 < n {
                if src[i + 1] == "/" {
                    i = i + 2;
                    while i < n {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        if ch == "\"" {
            i = i + 1;
            while i < n {
                if src[i] == "\\" { i = i + 2; continue; }
                if src[i] == "\"" { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        if ch == "{" { depth = depth + 1; i = i + 1; continue; }
        if ch == "}" {
            depth = depth - 1;
            i = i + 1;
            if depth == 0 { return i; }
            continue;
        }
        i = i + 1;
    }
    assert(1 == 0);
    return i;
}

fn compile_lite(src: str) -> list {
    // returns [code, binds] where binds = [[event, addr, arity], ...]
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let stypes: list = [];
    let binds: list = [];
    let on_serial: i64 = 0;
    let i: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        if starts_kw(src, i, "struct") == 1 {
            i = skip(src, i + 6);
            let id = parse_ident(src, i);
            i = skip(src, id[1]);
            assert(src[i] == "{"); i = i + 1;
            let fields: list = [];
            i = skip(src, i);
            if src[i] != "}" {
                while true {
                    let fnm = parse_ident(src, i);
                    fields = push(fields, fnm[0]);
                    i = skip_type_annot(src, fnm[1]);
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; i = skip(src, i); continue; }
                    break;
                }
            }
            assert(src[i] == "}"); i = i + 1;
            stypes = push(stypes, [id[0], fields]);
            continue;
        }
        if starts_kw(src, i, "on") == 1 {
            i = skip(src, i + 2);
            assert(src[i] == "\"");
            let ps = parse_string(src, i);
            let ev: str = ps[0]; i = ps[1];
            i = skip(src, i);
            assert(src[i] == "("); i = i + 1;
            let params: list = [];
            i = skip(src, i);
            if src[i] != ")" {
                while true {
                    let pn = parse_ident(src, i);
                    params = push(params, pn[0]);
                    i = skip_type_annot(src, pn[1]);
                    i = skip(src, i);
                    if src[i] == "," { i = i + 1; continue; }
                    break;
                }
            }
            assert(src[i] == ")");
            i = skip(src, i + 1);
            assert(src[i] == "{");
            let start: i64 = i;
            i = match_brace(src, i);
            let body: str = "";
            let bi: i64 = start;
            while bi < i { body = body + src[bi]; bi = bi + 1; }
            let fname: str = "__on_" + itoa(on_serial);
            on_serial = on_serial + 1;
            binds = push(binds, [ev, len(fnames), len(params)]);
            fnames = push(fnames, fname);
            fparams = push(fparams, params);
            fbodies = push(fbodies, body);
            continue;
        }
        assert(starts_kw(src, i, "fn") == 1);
        i = skip(src, i + 2);
        let id = parse_ident(src, i);
        i = skip(src, id[1]);
        assert(src[i] == "("); i = i + 1;
        let params: list = [];
        i = skip(src, i);
        if src[i] != ")" {
            while true {
                let pn = parse_ident(src, i);
                params = push(params, pn[0]);
                i = skip_type_annot(src, pn[1]);
                i = skip(src, i);
                if src[i] == "," { i = i + 1; continue; }
                break;
            }
        }
        assert(src[i] == ")");
        i = skip(src, i + 1);
        if starts_with(src, i, "->") == 1 {
            i = skip(src, i + 2);
            let ty = parse_ident(src, i);
            i = ty[1];
        }
        i = skip(src, i);
        assert(src[i] == "{");
        let start: i64 = i;
        i = match_brace(src, i);
        let body: str = "";
        let bi: i64 = start;
        while bi < i { body = body + src[bi]; bi = bi + 1; }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
    }

    let fargc: list = [];
    let fi: i64 = 0;
    while fi < len(fnames) { fargc = push(fargc, len(fparams[fi])); fi = fi + 1; }

    let code: list = emit2([], OP_JMP(), 0);
    let faddrs: list = [];
    fi = 0;
    while fi < len(fnames) { faddrs = push(faddrs, 0); fi = fi + 1; }
    let patches: list = [];
    fi = 0;
    while fi < len(fnames) {
        faddrs[fi] = len(code);
        let vnames: list = [];
        let pi: i64 = 0;
        while pi < len(fparams[fi]) { vnames = push(vnames, fparams[fi][pi]); pi = pi + 1; }
        let lctx = empty_lctx();
        let bl = emit_block(fbodies[fi], 0, code, vnames, fnames, faddrs, fargc, stypes, patches, lctx);
        code = bl[0];
        patches = bl[3];
        code = push(code, OP_RET());
        fi = fi + 1;
    }
    let pgi: i64 = 0;
    while pgi < len(patches) {
        code[patches[pgi][0]] = faddrs[patches[pgi][1]];
        pgi = pgi + 1;
    }
    code[1] = len(code);

    let resolved: list = [];
    let bi2: i64 = 0;
    while bi2 < len(binds) {
        let b = binds[bi2];
        resolved = push(resolved, [b[0], faddrs[b[1]], b[2]]);
        bi2 = bi2 + 1;
    }

    let mi: i64 = 0; let found: i64 = 0; let maddr: i64 = 0;
    while mi < len(fnames) {
        if fnames[mi] == "main" { found = 1; maddr = faddrs[mi]; assert(fargc[mi] == 0); }
        mi = mi + 1;
    }
    assert(found == 1);
    code = emit3(code, OP_CALL(), maddr, 0);
    code = push(code, OP_HALT());
    return [code, resolved];
}

fn run_lite(src: str) -> i64 {
    let p = compile_lite(src);
    return vm_exec(p[0], p[1]);
}

fn run_file(path: str) -> i64 {
    let p = compile_lite(resolve_imports(path, 0));
    return vm_exec(p[0], p[1]);
}

fn main() -> i64 {
    println("kenga-more → bytecode");
    assert(run_lite("fn main() { 2 + 3 * 4 }") == 14);
    assert(run_lite("fn main() { let x = 2 + 3; let y = x * 4; y }") == 20);
    assert(run_lite("fn add(a, b) { a + b } fn main() { add(20, 22) }") == 42);
    assert(run_lite("fn main() { let x = 0; while x < 5 { x = x + 1; } x }") == 5);
    assert(run_lite("fn main() { let x = 3; if x > 2 { 10 } else { 20 } }") == 10);
    assert(run_lite("fn main() -> i64 { let n = 1; let i = 1; while i <= 5 { n = n * i; i = i + 1; } return n; }") == 120);
    assert(run_lite("fn main() { round(1.5 + 2.5) }") == 4);
    assert(run_lite("fn main() { let xs = [10, 20]; xs = push(xs, 30); xs[0] + xs[1] + xs[2] }") == 60);
    assert(run_lite("fn main() { println(\"x{y}\"); 0 }") == 0);
    assert(run_lite("fn main() { let s = \"ab\"; s = s + \"c\"; println(s); 0 }") == 0);
    assert(run_lite("fn main() { if true { 7 } else { 0 } }") == 7);
    assert(run_lite("fn main() { ord(\"A\") }") == 65);
    assert(run_lite("fn main() { let xs = [1, 2]; xs[0] = 7; xs[0] + xs[1] }") == 9);
    assert(run_lite("fn main() { let n = 2; let label = 0; if n == 0 { label = 10; } else if n == 1 { label = 20; } else if n == 2 { label = 30; } else { label = 40; } label }") == 30);
    assert(run_lite("fn main() { let acc = 0; for i in 0..5 { if i == 3 { break; } acc = acc + i; } acc }") == 3);
    assert(run_lite("fn main() { let skip = 0; for i in 0..5 { if i == 2 { continue; } skip = skip + i; } skip }") == 8);
    assert(run_lite("fn sum(xs: list) -> i64 { let s: i64 = 0; for v in xs { s = s + v; } return s; } fn main() -> i64 { let xs: list = [1, 2, 3, 4]; xs[0] = 10; return sum(xs); }") == 19);
    assert(run_file("examples/selfhost/for_lite.kenga") == 0);
    assert(run_file("examples/selfhost/elif_lite.kenga") == 0);
    assert(run_file("examples/selfhost/float_lite.kenga") == 0);
    assert(run_file("examples/selfhost/lists_lite.kenga") == 0);
    assert(run_file("examples/selfhost/struct_lite.kenga") == 0);
    assert(run_lite("fn main() -> i64 { return ahead(41); } fn ahead(x: i64) -> i64 { return x + 1; }") == 42);
    assert(run_lite("on \"ping\"(x) { emit(\"pong\", x); } on \"pong\"(x) { println(x); } fn main() { emit(\"ping\", 7); assert(pump(8) == 2); assert(pending() == 0); 0 }") == 0);
    assert(run_file("examples/agent.kenga") == 0);
    assert(run_file("examples/selfhost/fact_lite.kenga") == 0);
    assert(run_file("examples/ml/kenga_net.kenga") == 0);
    assert(run_lite("fn main() { assert(write_file(\"minds/_more_io.txt\", \"hi\") == 1); ord(read_file(\"minds/_more_io.txt\")[0]) }") == 104);
    assert(run_lite("fn main() { let s = \"a\\nb\"; len(s) }") == 3);
    assert(run_lite("fn main() { 10 % 3 }") == 1);
    assert(run_lite("fn main() { 1 && 0 }") == 0);
    assert(run_lite("fn main() { 1 && 1 }") == 1);
    assert(run_lite("fn main() { 0 || 1 }") == 1);
    assert(run_lite("fn main() { !0 }") == 1);
    assert(run_lite("fn main() { !(1 == 2) }") == 1);
    assert(run_lite("fn main() { 1 < 2 && 3 > 1 }") == 1);
    assert(run_lite("fn main() { /* c */ 1 + /* x */ 2 }") == 3);
    assert(run_file("examples/selfhost/comments_lite.kenga") == 0);
    assert(run_file("examples/selfhost/logic_lite.kenga") == 0);
    assert(run_file("examples/ml/kenga_birth.kenga") == 0);
    assert(run_file("examples/ml/kenga_born.kenga") == 0);
    assert(run_file("kenga/emit/c_seed.kenga") == 0);
    assert(run_file("kenga/emit/expr_c.kenga") == 0);
    println("kenga-more ok");
    return 0;
}
