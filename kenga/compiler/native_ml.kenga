// Tensor / tape / Prophet on Kenga lists. more.kenga VM calls these
// instead of lite C builtins. CRT stays: read_file / write_file / now_ms.

fn nt_exp(x: f64) -> f64 {
    // exp via range reduction: x = k*ln2 + r, r in [0,ln2); taylor(r,10) * 2^k
    let ln2: f64 = 0.6931471805599453;
    let neg: i64 = 0;
    if x < 0.0 { neg = 1; x = 0.0 - x; }
    if x > 44.0 { x = 44.0; }
    let kf: f64 = x / ln2;
    let k: f64 = round(kf);
    if k > kf { k = k - 1.0; }
    let r: f64 = x - k * ln2;
    let sum: f64 = 1.0;
    let term: f64 = 1.0;
    let n: f64 = 1.0;
    while n <= 10.0 {
        term = term * r / n;
        sum = sum + term;
        n = n + 1.0;
    }
    let i: f64 = 0.0;
    while i < k { sum = sum + sum; i = i + 1.0; }
    if neg == 1 { return 1.0 / sum; }
    return sum;
}

fn nt_ln_pos(x: f64) -> f64 {
    // ln(x) for x > 0: reciprocal for x<1, halve to [1,2), atanh series
    let sign: f64 = 1.0;
    if x < 1.0 { x = 1.0 / x; sign = 0.0 - 1.0; }
    let e: f64 = 0.0;
    while x >= 2.0 { x = x * 0.5; e = e + 1.0; }
    let t: f64 = (x - 1.0) / (x + 1.0);
    let t2: f64 = t * t;
    let sum: f64 = t;
    let term: f64 = t;
    let n: f64 = 1.0;
    while n < 12.0 {
        term = term * t2;
        sum = sum + term / (n + n + 1.0);
        n = n + 1.0;
    }
    let res: f64 = e * 0.6931471805599453 + sum + sum;
    if sign < 0.0 { return 0.0 - res; }
    return res;
}

fn nt_log(x: f64) -> f64 {
    if x < 0.000000000001 { x = 0.000000000001; }
    return nt_ln_pos(x);
}

fn nt_n(sh: list) -> i64 {
    let n: i64 = 1;
    let i: i64 = 0;
    while i < len(sh) {
        n = n * sh[i];
        i = i + 1;
    }
    return n;
}

fn nt_zeros(n: i64) -> list {
    let d: list = [];
    let i: i64 = 0;
    while i < n {
        d = push(d, 0.0);
        i = i + 1;
    }
    return d;
}

fn nt_dclone(d: list) -> list {
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) {
        o = push(o, d[i]);
        i = i + 1;
    }
    return o;
}

fn nt_sclone(sh: list) -> list {
    let o: list = [];
    let i: i64 = 0;
    while i < len(sh) {
        o = push(o, sh[i]);
        i = i + 1;
    }
    return o;
}

fn L2(xs: list, i: i64, j: i64) {
    let a = xs[i];
    return a[j];
}
fn L3(xs: list, i: i64, j: i64, k: i64) {
    let a = xs[i];
    let b = a[j];
    return b[k];
}
fn S2(xs: list, i: i64, j: i64, v) {
    let a = xs[i];
    a[j] = v;
    return 0;
}

fn nt_from(sh: list, data: list) -> list {
    assert(len(data) == nt_n(sh));
    return ["T", nt_sclone(sh), nt_dclone(data)];
}

fn nt_tensor(r: i64, c: i64) -> list {
    return ["T", [r, c], nt_zeros(r * c)];
}

fn nt_fill(t: list, x: f64) -> list {
    let d = t[2];
    let i: i64 = 0;
    while i < len(d) {
        d[i] = x;
        i = i + 1;
    }
    return t;
}

fn nt_get(t: list, i: i64) -> f64 {
    return L2(t, 2, i);
}

fn nt_set(t: list, i: i64, v: f64) -> list {
    S2(t, 2, i, v);
    return t;
}

fn nt_shape(t: list) -> list {
    return t[1];
}

fn nt_clone(t: list) -> list {
    return ["T", nt_sclone(t[1]), nt_dclone(t[2])];
}

fn nt_add(a: list, b: list) -> list {
    let da = a[2];
    let db = b[2];
    let n: i64 = len(da);
    let o: list = [];
    let i: i64 = 0;
    while i < n { o = push(o, da[i] + db[i]); i = i + 1; }
    return ["T", nt_sclone(a[1]), o];
}
fn nt_sub(a: list, b: list) -> list {
    let da = a[2];
    let db = b[2];
    let n: i64 = len(da);
    let o: list = [];
    let i: i64 = 0;
    while i < n { o = push(o, da[i] - db[i]); i = i + 1; }
    return ["T", nt_sclone(a[1]), o];
}
fn nt_mul(a: list, b: list) -> list {
    let da = a[2];
    let db = b[2];
    let n: i64 = len(da);
    let o: list = [];
    let i: i64 = 0;
    while i < n { o = push(o, da[i] * db[i]); i = i + 1; }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_scale(a: list, s: f64) -> list {
    let d = a[2];
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) {
        o = push(o, d[i] * s);
        i = i + 1;
    }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_sum(a: list) -> f64 {
    let d = a[2];
    let acc: f64 = 0.0;
    let i: i64 = 0;
    while i < len(d) {
        acc = acc + d[i];
        i = i + 1;
    }
    return acc;
}

fn nt_dot(a: list, b: list) -> f64 {
    let da = a[2];
    let db = b[2];
    let n: i64 = len(da);
    let acc: f64 = 0.0;
    let i: i64 = 0;
    while i < n { acc = acc + da[i] * db[i]; i = i + 1; }
    return acc;
}

fn nt_mean(a: list) -> list {
    let sh = a[1];
    if len(sh) == 3 {
        let h: i64 = sh[0];
        let w: i64 = sh[1];
        let c: i64 = sh[2];
        let d = a[2];
        let o: list = [];
        let ch: i64 = 0;
        let n: f64 = (h * w) + 0.0;
        if n < 1.0 { n = 1.0; }
        while ch < c {
            let acc: f64 = 0.0;
            let y: i64 = 0;
            while y < h {
                let x: i64 = 0;
                while x < w {
                    acc = acc + d[(y * w + x) * c + ch];
                    x = x + 1;
                }
                y = y + 1;
            }
            o = push(o, acc / n);
            ch = ch + 1;
        }
        return ["T", [c], o];
    }
    let acc: f64 = nt_sum(a);
    let n: f64 = len(a[2]) + 0.0;
    if n < 1.0 { n = 1.0; }
    if len(sh) == 2 {
        return ["T", [1], [acc / n]];
    }
    return acc / n;
}

fn nt_mse(a: list, b: list) -> f64 {
    let d = nt_sub(a, b)[2];
    let acc: f64 = 0.0;
    let i: i64 = 0;
    while i < len(d) {
        acc = acc + d[i] * d[i];
        i = i + 1;
    }
    let n: f64 = len(d) + 0.0;
    if n < 1.0 { n = 1.0; }
    return acc / n;
}

fn nt_matmul(a: list, b: list) -> list {
    let sa = a[1];
    let sb = b[1];
    assert(len(sa) == 2);
    assert(len(sb) == 2);
    let m: i64 = sa[0];
    let k: i64 = sa[1];
    assert(k == sb[0]);
    let n: i64 = sb[1];
    let ad = a[2];
    let bd = b[2];
    let o: list = [];
    let i: i64 = 0;
    while i < m {
        let j: i64 = 0;
        while j < n {
            let acc: f64 = 0.0;
            let p: i64 = 0;
            while p < k {
                acc = acc + ad[i * k + p] * bd[p * n + j];
                p = p + 1;
            }
            o = push(o, acc);
            j = j + 1;
        }
        i = i + 1;
    }
    return ["T", [m, n], o];
}

fn nt_reshape(a: list, sh: list) -> list {
    assert(nt_n(sh) == len(a[2]));
    return ["T", nt_sclone(sh), nt_dclone(a[2])];
}

fn nt_transpose(a: list) -> list {
    let sh = a[1];
    assert(len(sh) == 2);
    let r: i64 = sh[0];
    let c: i64 = sh[1];
    let d = a[2];
    let o: list = [];
    let j: i64 = 0;
    while j < c {
        let i: i64 = 0;
        while i < r {
            o = push(o, d[i * c + j]);
            i = i + 1;
        }
        j = j + 1;
    }
    return ["T", [c, r], o];
}

fn nt_texp(a: list) -> list {
    let d = a[2];
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) {
        o = push(o, nt_exp(d[i]));
        i = i + 1;
    }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_tlog(a: list) -> list {
    let d = a[2];
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) {
        o = push(o, nt_log(d[i]));
        i = i + 1;
    }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_softmax(a: list) -> list {
    let d = a[2];
    if len(d) < 1 { return nt_clone(a); }
    let mx: f64 = d[0];
    let i: i64 = 1;
    while i < len(d) {
        if d[i] > mx { mx = d[i]; }
        i = i + 1;
    }
    let o: list = [];
    let s: f64 = 0.0;
    i = 0;
    while i < len(d) {
        let e: f64 = nt_exp(d[i] - mx);
        o = push(o, e);
        s = s + e;
        i = i + 1;
    }
    if s < 0.000000000000001 { s = 0.000000000000001; }
    i = 0;
    while i < len(o) {
        o[i] = o[i] / s;
        i = i + 1;
    }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_relu_t(a: list) -> list {
    let d = a[2];
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) {
        let v: f64 = d[i];
        if v < 0.0 { v = 0.0; }
        o = push(o, v);
        i = i + 1;
    }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_fill_like(a: list, v: f64) -> list {
    let n: i64 = len(a[2]);
    let o: list = [];
    let i: i64 = 0;
    while i < n { o = push(o, v); i = i + 1; }
    return ["T", nt_sclone(a[1]), o];
}

fn nt_patch_mean(a: list, gh: i64, gw: i64) -> list {
    let sh = a[1];
    assert(len(sh) == 3);
    let h: i64 = sh[0];
    let w: i64 = sh[1];
    let c: i64 = sh[2];
    let ph: i64 = h / gh;
    let pw: i64 = w / gw;
    assert(ph > 0);
    assert(pw > 0);
    let d = a[2];
    let o: list = [];
    let gy: i64 = 0;
    while gy < gh {
        let gx: i64 = 0;
        while gx < gw {
            let ch: i64 = 0;
            while ch < c {
                let acc: f64 = 0.0;
                let n: f64 = 0.0;
                let y: i64 = gy * ph;
                while y < (gy + 1) * ph {
                    let x: i64 = gx * pw;
                    while x < (gx + 1) * pw {
                        acc = acc + d[(y * w + x) * c + ch];
                        n = n + 1.0;
                        x = x + 1;
                    }
                    y = y + 1;
                }
                if n < 1.0 { n = 1.0; }
                o = push(o, acc / n);
                ch = ch + 1;
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    return ["T", [gh, gw, c], o];
}

fn nt_linear_grad(w: list, x: list, y: list) -> list {
    let xc = x;
    if len(x[1]) == 1 { xc = nt_reshape(x, [L2(x, 1, 0), 1]); }
    let yc = y;
    if len(y[1]) == 1 { yc = nt_reshape(y, [L2(y, 1, 0), 1]); }
    let pred = nt_matmul(w, xc);
    let err = nt_sub(pred, yc);
    return nt_matmul(err, nt_transpose(xc));
}

fn nt_wrap_host(t: list) -> list {
    let sh = nt_shape(t);
    let n: i64 = nt_n(sh);
    let d: list = [];
    let i: i64 = 0;
    while i < n {
        d = push(d, nt_get(t, i));
        i = i + 1;
    }
    return ["T", sh, d];
}

fn nt_u16le(xs: list, i: i64) -> i64 {
    return xs[i] + xs[i + 1] * 256;
}

fn nt_u32le(xs: list, i: i64) -> i64 {
    return xs[i] + xs[i + 1] * 256 + xs[i + 2] * 65536 + xs[i + 3] * 16777216;
}

fn nt_ppm_skip(xs: list, i: i64) -> i64 {
    while i < len(xs) {
        let c: i64 = xs[i];
        if c == 32 { i = i + 1; continue; }
        if c == 9 { i = i + 1; continue; }
        if c == 10 { i = i + 1; continue; }
        if c == 13 { i = i + 1; continue; }
        if c == 35 {
            while i < len(xs) {
                if xs[i] == 10 { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        break;
    }
    return i;
}

fn nt_ppm_tok(xs: list, i: i64) -> list {
    i = nt_ppm_skip(xs, i);
    let a: i64 = i;
    while i < len(xs) {
        let c: i64 = xs[i];
        if c == 32 { break; }
        if c == 9 { break; }
        if c == 10 { break; }
        if c == 13 { break; }
        if c == 35 { break; }
        i = i + 1;
    }
    let n: i64 = 0;
    let j: i64 = a;
    let neg: i64 = 0;
    if j < i {
        if xs[j] == 45 { neg = 1; j = j + 1; }
    }
    while j < i {
        n = n * 10 + (xs[j] - 48);
        j = j + 1;
    }
    if neg == 1 { n = 0 - n; }
    return [n, i, a];
}

fn nt_load_ppm(path: str) -> list {
    let xs = read_bytes(path);
    let p = nt_ppm_tok(xs, 0);
    assert(p[2] + 2 == p[1]);
    assert(xs[p[2]] == 80);
    assert(xs[p[2] + 1] == 54);
    p = nt_ppm_tok(xs, p[1]);
    let w: i64 = p[0];
    p = nt_ppm_tok(xs, p[1]);
    let h: i64 = p[0];
    p = nt_ppm_tok(xs, p[1]);
    let maxv: i64 = p[0];
    assert(w > 0);
    assert(h > 0);
    assert(maxv > 0);
    let i: i64 = p[1];
    if i < len(xs) {
        let c: i64 = xs[i];
        if c == 32 { i = i + 1; } else {
            if c == 9 { i = i + 1; } else {
                if c == 10 { i = i + 1; } else {
                    if c == 13 { i = i + 1; }
                }
            }
        }
    }
    let need: i64 = w * h * 3;
    assert(i + need <= len(xs));
    let scale: f64 = 1.0 / (maxv + 0.0);
    let d: list = [];
    let k: i64 = 0;
    while k < need {
        d = push(d, (xs[i + k] + 0.0) * scale);
        k = k + 1;
    }
    return ["T", [h, w, 3], d];
}

fn nt_load_wav(path: str) -> list {
    let xs = read_bytes(path);
    assert(len(xs) >= 44);
    assert(xs[0] == 82);
    assert(xs[1] == 73);
    assert(xs[2] == 70);
    assert(xs[3] == 70);
    assert(xs[8] == 87);
    assert(xs[9] == 65);
    assert(xs[10] == 86);
    assert(xs[11] == 69);
    let pos: i64 = 12;
    let channels: i64 = 1;
    let bits: i64 = 16;
    let data_off: i64 = 0;
    let data_len: i64 = 0;
    while pos + 8 <= len(xs) {
        let id0: i64 = xs[pos];
        let id1: i64 = xs[pos + 1];
        let id2: i64 = xs[pos + 2];
        let id3: i64 = xs[pos + 3];
        let size: i64 = nt_u32le(xs, pos + 4);
        let chunk: i64 = pos + 8;
        if id0 == 102 {
            if id1 == 109 {
                if id2 == 116 {
                    if id3 == 32 {
                        assert(size >= 16);
                        assert(nt_u16le(xs, chunk) == 1);
                        channels = nt_u16le(xs, chunk + 2);
                        bits = nt_u16le(xs, chunk + 14);
                    }
                }
            }
        }
        if id0 == 100 {
            if id1 == 97 {
                if id2 == 116 {
                    if id3 == 97 {
                        data_off = chunk;
                        data_len = size;
                        break;
                    }
                }
            }
        }
        pos = chunk + size + (size % 2);
    }
    assert(data_off > 0);
    assert(bits == 16);
    assert(data_off + data_len <= len(xs));
    let step: i64 = channels;
    if step < 1 { step = 1; }
    let samples: i64 = data_len / 2 / step;
    if samples < 1 { samples = 0; }
    let d: list = [];
    let s: i64 = 0;
    while s < samples {
        let off: i64 = data_off + s * step * 2;
        let u: i64 = nt_u16le(xs, off);
        if u >= 32768 { u = u - 65536; }
        d = push(d, (u + 0.0) / 32768.0);
        s = s + 1;
    }
    return ["T", [samples], d];
}

fn nt_save_tensor(t: list, path: str) -> i64 {
    let sh = t[1];
    let d = t[2];
    let s: str = "KENGA_TENSOR 1\n" + to_str(len(sh)) + "\n";
    let i: i64 = 0;
    while i < len(sh) {
        if i > 0 { s = s + " "; }
        s = s + to_str(sh[i]);
        i = i + 1;
    }
    s = s + "\n";
    i = 0;
    while i < len(d) {
        if i > 0 { s = s + " "; }
        s = s + to_str(d[i]);
        i = i + 1;
    }
    s = s + "\n";
    return write_file(path, s);
}

fn nt_skip_ws(s: str, i: i64) -> i64 {
    while i < len(s) {
        let c = s[i];
        if c == " " { i = i + 1; continue; }
        if c == "\n" { i = i + 1; continue; }
        if ord(c) == 13 { i = i + 1; continue; }
        if c == "\t" { i = i + 1; continue; }
        break;
    }
    return i;
}

fn nt_read_tok(s: str, i: i64) -> list {
    i = nt_skip_ws(s, i);
    let t: str = "";
    while i < len(s) {
        let c = s[i];
        if c == " " { break; }
        if c == "\n" { break; }
        if ord(c) == 13 { break; }
        if c == "\t" { break; }
        t = t + c;
        i = i + 1;
    }
    return [t, i];
}

fn nt_parse_i(s: str) -> i64 {
    let n: i64 = 0;
    let i: i64 = 0;
    let neg: i64 = 0;
    if len(s) > 0 {
        if s[0] == "-" { neg = 1; i = 1; }
    }
    while i < len(s) {
        n = n * 10 + (ord(s[i]) - 48);
        i = i + 1;
    }
    if neg == 1 { return 0 - n; }
    return n;
}

fn nt_parse_f(s: str) -> f64 {
    let sign: f64 = 1.0;
    let i: i64 = 0;
    if len(s) > 0 {
        if s[0] == "-" { sign = 0.0 - 1.0; i = 1; }
    }
    let ip: f64 = 0.0;
    while i < len(s) {
        if s[i] == "." { break; }
        if s[i] == "e" { break; }
        if s[i] == "E" { break; }
        ip = ip * 10.0 + (ord(s[i]) - 48) + 0.0;
        i = i + 1;
    }
    let fp: f64 = 0.0;
    let place: f64 = 0.1;
    if i < len(s) {
        if s[i] == "." {
            i = i + 1;
            while i < len(s) {
                if s[i] == "e" { break; }
                if s[i] == "E" { break; }
                fp = fp + ((ord(s[i]) - 48) + 0.0) * place;
                place = place * 0.1;
                i = i + 1;
            }
        }
    }
    let v: f64 = sign * (ip + fp);
    if i < len(s) {
        if s[i] == "e" { i = i + 1; } else {
            if s[i] == "E" { i = i + 1; }
        }
        if i < len(s) {
            let es: f64 = 1.0;
            if s[i] == "-" { es = 0.0 - 1.0; i = i + 1; } else {
                if s[i] == "+" { i = i + 1; }
            }
            let ev: i64 = 0;
            while i < len(s) {
                ev = ev * 10 + (ord(s[i]) - 48);
                i = i + 1;
            }
            let e: i64 = 0;
            let f: f64 = 1.0;
            while e < ev {
                f = f * 10.0;
                e = e + 1;
            }
            if es < 0.0 { v = v / f; } else { v = v * f; }
        }
    }
    return v;
}

fn nt_load_tensor(path: str) -> list {
    let s: str = read_file(path);
    let p = nt_read_tok(s, 0);
    assert(p[0] == "KENGA_TENSOR");
    p = nt_read_tok(s, p[1]);
    p = nt_read_tok(s, p[1]);
    let rank: i64 = nt_parse_i(p[0]);
    let sh: list = [];
    let i: i64 = 0;
    while i < rank {
        p = nt_read_tok(s, p[1]);
        sh = push(sh, nt_parse_i(p[0]));
        i = i + 1;
    }
    let n: i64 = nt_n(sh);
    let d: list = [];
    i = 0;
    while i < n {
        p = nt_read_tok(s, p[1]);
        d = push(d, nt_parse_f(p[0]));
        i = i + 1;
    }
    return ["T", sh, d];
}

fn nt_node(op: i64, pa: i64, pb: i64, th: list, is_s: i64, sc: f64, req: i64, scale: f64, old: list) -> list {
    return [op, pa, pb, th, is_s, sc, req, 0, 0, 0.0, scale, old];
}

fn nt_ag_clear(box: list) -> i64 {
    box[0] = [];
    return 0;
}

fn nt_ag_push(box: list, n: list) -> i64 {
    let tape = box[0];
    let id: i64 = len(tape);
    box[0] = push(tape, n);
    return id;
}

fn nt_ag_param(box: list, t: list) -> i64 {
    return nt_ag_push(box, nt_node(0, 0 - 1, 0 - 1, nt_clone(t), 0, 0.0, 1, 0.0, []));
}

fn nt_ag_const(box: list, t: list) -> i64 {
    if typeof(t) == "list" {
        return nt_ag_push(box, nt_node(0, 0 - 1, 0 - 1, nt_clone(t), 0, 0.0, 0, 0.0, []));
    }
    return nt_ag_push(box, nt_node(0, 0 - 1, 0 - 1, 0, 1, t + 0.0, 0, 0.0, []));
}

fn nt_ag_bin(box: list, a: i64, b: i64, op: i64, th: list) -> i64 {
    let tape = box[0];
    let na = tape[a];
    let nb = tape[b];
    let req: i64 = 0;
    if na[6] == 1 { req = 1; }
    if nb[6] == 1 { req = 1; }
    return nt_ag_push(box, nt_node(op, a, b, th, 0, 0.0, req, 0.0, []));
}

fn nt_ag_un(box: list, a: i64, op: i64, th: list, is_s: i64, sc: f64, scale: f64, old: list) -> i64 {
    let tape = box[0];
    let na = tape[a];
    return nt_ag_push(box, nt_node(op, a, 0 - 1, th, is_s, sc, na[6], scale, old));
}

fn nt_th(box: list, id: i64) {
    return L3(box, 0, id, 3);
}
fn nt_nd(box: list, id: i64) {
    return L2(box, 0, id);
}

fn nt_ag_add(box: list, a: i64, b: i64) -> i64 {
    return nt_ag_bin(box, a, b, 3, nt_add(nt_th(box, a), nt_th(box, b)));
}
fn nt_ag_sub(box: list, a: i64, b: i64) -> i64 {
    return nt_ag_bin(box, a, b, 4, nt_sub(nt_th(box, a), nt_th(box, b)));
}
fn nt_ag_mul(box: list, a: i64, b: i64) -> i64 {
    return nt_ag_bin(box, a, b, 5, nt_mul(nt_th(box, a), nt_th(box, b)));
}
fn nt_ag_matmul(box: list, a: i64, b: i64) -> i64 {
    return nt_ag_bin(box, a, b, 1, nt_matmul(nt_th(box, a), nt_th(box, b)));
}
fn nt_ag_mse(box: list, a: i64, b: i64) -> i64 {
    let na = nt_nd(box, a);
    let nb = nt_nd(box, b);
    let loss: f64 = nt_mse(na[3], nb[3]);
    let req: i64 = 0;
    if na[6] == 1 { req = 1; }
    if nb[6] == 1 { req = 1; }
    return nt_ag_push(box, nt_node(2, a, b, 0, 1, loss, req, 0.0, []));
}
fn nt_ag_scale(box: list, a: i64, s: f64) -> i64 {
    let n = nt_nd(box, a);
    if n[4] == 1 {
        return nt_ag_un(box, a, 6, 0, 1, n[5] * s, s, []);
    }
    return nt_ag_un(box, a, 6, nt_scale(n[3], s), 0, 0.0, s, []);
}
fn nt_ag_relu(box: list, a: i64) -> i64 {
    return nt_ag_un(box, a, 7, nt_relu_t(nt_th(box, a)), 0, 0.0, 0.0, []);
}
fn nt_ag_neg(box: list, a: i64) -> i64 {
    return nt_ag_scale(box, a, 0.0 - 1.0);
}
fn nt_ag_transpose(box: list, a: i64) -> i64 {
    return nt_ag_un(box, a, 8, nt_transpose(nt_th(box, a)), 0, 0.0, 0.0, []);
}
fn nt_ag_reshape(box: list, a: i64, sh: list) -> i64 {
    let th = nt_th(box, a);
    return nt_ag_un(box, a, 9, nt_reshape(th, sh), 0, 0.0, 0.0, nt_sclone(th[1]));
}
fn nt_ag_exp(box: list, a: i64) -> i64 {
    let n = nt_nd(box, a);
    if n[4] == 1 {
        return nt_ag_un(box, a, 10, 0, 1, nt_exp(n[5]), 0.0, []);
    }
    return nt_ag_un(box, a, 10, nt_texp(n[3]), 0, 0.0, 0.0, []);
}
fn nt_ag_log(box: list, a: i64) -> i64 {
    let n = nt_nd(box, a);
    if n[4] == 1 {
        return nt_ag_un(box, a, 11, 0, 1, nt_log(n[5]), 0.0, []);
    }
    return nt_ag_un(box, a, 11, nt_tlog(n[3]), 0, 0.0, 0.0, []);
}
fn nt_ag_softmax(box: list, a: i64) -> i64 {
    let n = nt_nd(box, a);
    if n[4] == 1 {
        return nt_ag_un(box, a, 12, 0, 1, 1.0, 0.0, []);
    }
    return nt_ag_un(box, a, 12, nt_softmax(n[3]), 0, 0.0, 0.0, []);
}
fn nt_ag_sum(box: list, a: i64) -> i64 {
    let n = nt_nd(box, a);
    let s: f64 = n[5];
    if n[4] == 0 { s = nt_sum(n[3]); }
    return nt_ag_un(box, a, 13, 0, 1, s, 0.0, []);
}
fn nt_ag_value(box: list, id: i64) -> list {
    let n = nt_nd(box, id);
    if n[4] == 1 { return n[5]; }
    return nt_clone(n[3]);
}
fn nt_ag_grad(box: list, id: i64) -> list {
    let n = nt_nd(box, id);
    assert(n[7] == 1);
    if n[4] == 1 { return n[9]; }
    return nt_clone(n[8]);
}

fn nt_accum(box: list, id: i64, g: list) -> i64 {
    let n = nt_nd(box, id);
    if n[7] == 0 {
        n[7] = 1;
        n[8] = nt_clone(g);
        S2(box, 0, id, n);
        return 0;
    }
    let a = n[8][2];
    let b = g[2];
    let i: i64 = 0;
    while i < len(a) { a[i] = a[i] + b[i]; i = i + 1; }
    return 0;
}

fn nt_accum_s(box: list, id: i64, g: f64) -> i64 {
    let n = nt_nd(box, id);
    if n[7] == 0 {
        n[7] = 1;
        n[9] = g;
        S2(box, 0, id, n);
        return 0;
    }
    n[9] = n[9] + g;
    S2(box, 0, id, n);
    return 0;
}

fn nt_ag_backward(box: list, loss: i64) -> i64 {
    let tape = box[0];
    let i: i64 = 0;
    while i < len(tape) {
        let n = tape[i];
        n[7] = 0;
        tape[i] = n;
        i = i + 1;
    }
    let ln = tape[loss];
    assert(ln[4] == 1);
    ln[7] = 1;
    ln[9] = 1.0;
    tape[loss] = ln;
    box[0] = tape;
    i = loss;
    while i >= 0 {
        let n = nt_nd(box, i);
        if n[7] == 0 {
            i = i - 1;
            continue;
        }
        let op: i64 = n[0];
        if op == 0 { }
        if op == 1 {
            let a = nt_nd(box, n[1]);
            let b = nt_nd(box, n[2]);
            nt_accum(box, n[1], nt_matmul(n[8], nt_transpose(b[3])));
            nt_accum(box, n[2], nt_matmul(nt_transpose(a[3]), n[8]));
        }
        if op == 2 {
            let err = nt_sub(nt_th(box, n[1]), nt_th(box, n[2]));
            let nn: f64 = len(err[2]) + 0.0;
            if nn < 1.0 { nn = 1.0; }
            let sc: f64 = 2.0 * n[9] / nn;
            nt_accum(box, n[1], nt_scale(err, sc));
            nt_accum(box, n[2], nt_scale(err, 0.0 - sc));
        }
        if op == 3 {
            nt_accum(box, n[1], n[8]);
            nt_accum(box, n[2], n[8]);
        }
        if op == 4 {
            nt_accum(box, n[1], n[8]);
            nt_accum(box, n[2], nt_scale(n[8], 0.0 - 1.0));
        }
        if op == 5 {
            nt_accum(box, n[1], nt_mul(n[8], nt_th(box, n[2])));
            nt_accum(box, n[2], nt_mul(n[8], nt_th(box, n[1])));
        }
        if op == 6 {
            if n[4] == 1 { nt_accum_s(box, n[1], n[9] * n[10]); } else { nt_accum(box, n[1], nt_scale(n[8], n[10])); }
        }
        if op == 7 {
            let par = nt_th(box, n[1]);
            let av = par[2];
            let g = nt_clone(n[8]);
            let gd = g[2];
            let j: i64 = 0;
            while j < len(gd) {
                if av[j] <= 0.0 { gd[j] = 0.0; }
                j = j + 1;
            }
            nt_accum(box, n[1], g);
        }
        if op == 8 { nt_accum(box, n[1], nt_transpose(n[8])); }
        if op == 9 { nt_accum(box, n[1], nt_reshape(n[8], n[11])); }
        if op == 10 {
            if n[4] == 1 { nt_accum_s(box, n[1], n[9] * n[5]); } else { nt_accum(box, n[1], nt_mul(n[8], n[3])); }
        }
        if op == 11 {
            if n[4] == 1 {
                let pn = nt_nd(box, n[1]);
                let x: f64 = pn[5];
                if x < 0.000000000001 { x = 0.000000000001; }
                nt_accum_s(box, n[1], n[9] / x);
            } else {
                let par = nt_th(box, n[1]);
                let xv = par[2];
                let g = nt_clone(n[8]);
                let gd = g[2];
                let gg = n[8];
                let ggd = gg[2];
                let j: i64 = 0;
                while j < len(gd) {
                    let x: f64 = xv[j];
                    if x < 0.000000000001 { x = 0.000000000001; }
                    gd[j] = ggd[j] / x;
                    j = j + 1;
                }
                nt_accum(box, n[1], g);
            }
        }
        if op == 12 {
            let yth = n[3];
            let y = yth[2];
            let gth = n[8];
            let gy = gth[2];
            let dot: f64 = 0.0;
            let j: i64 = 0;
            while j < len(y) {
                dot = dot + gy[j] * y[j];
                j = j + 1;
            }
            let g = nt_clone(n[3]);
            let gd = g[2];
            j = 0;
            while j < len(gd) {
                gd[j] = y[j] * (gy[j] - dot);
                j = j + 1;
            }
            nt_accum(box, n[1], g);
        }
        if op == 13 {
            let a = nt_nd(box, n[1]);
            if a[4] == 1 { nt_accum_s(box, n[1], n[9]); } else { nt_accum(box, n[1], nt_fill_like(a[3], n[9])); }
        }
        i = i - 1;
    }
    return 0;
}

fn nt_ag_step(box: list, id: i64, lr: f64) -> list {
    let n = nt_nd(box, id);
    assert(n[7] == 1);
    let d = n[3][2];
    let g = n[8][2];
    let o: list = [];
    let i: i64 = 0;
    while i < len(d) { o = push(o, d[i] - g[i] * lr); i = i + 1; }
    return ["T", nt_sclone(n[3][1]), o];
}

fn nt_winit(n: i64) -> list {
    let d: list = [];
    let i: i64 = 0;
    while i < n {
        d = push(d, 0.08 * ((i % 17) + 0.0) / 17.0 - 0.04);
        i = i + 1;
    }
    return d;
}

fn nt_mind(thr: f64, cap: i64, hid: i64) -> list {
    if hid < 1 { hid = 8; }
    if cap < 1 { cap = 8; }
    let dim: i64 = 16;
    let w1 = ["T", [hid, dim], nt_winit(hid * dim)];
    let b1 = ["T", [hid, 1], nt_zeros(hid)];
    let w2 = ["T", [dim, hid], nt_winit(dim * hid)];
    let b2 = ["T", [dim, 1], nt_zeros(dim)];
    return ["M", thr, cap, hid, 0.08, dim, 0, w1, b1, w2, b2, []];
}

fn nt_as_col(xs: list, dim: i64) -> list {
    let d: list = [];
    let i: i64 = 0;
    while i < dim {
        if i < len(xs) { d = push(d, xs[i] + 0.0); } else { d = push(d, 0.0); }
        i = i + 1;
    }
    return ["T", [dim, 1], d];
}

fn nt_fwd(m: list, xs: list) -> list {
    let dim: i64 = m[5];
    let x = nt_as_col(xs, dim);
    let h0 = nt_add(nt_matmul(m[7], x), m[8]);
    let h = nt_relu_t(h0);
    return nt_add(nt_matmul(m[9], h), m[10]);
}

fn nt_pred_list(m: list, xs: list) -> list {
    let y = nt_fwd(m, xs)[2];
    let o: list = [];
    let n: i64 = len(xs);
    if n < 1 { n = 1; }
    if n > len(y) { n = len(y); }
    let i: i64 = 0;
    while i < n {
        o = push(o, y[i]);
        i = i + 1;
    }
    return o;
}

fn nt_train(m: list, x: list, y: list) -> f64 {
    let pred = nt_fwd(m, x);
    let yt = nt_as_col(y, m[5]);
    let err = nt_sub(pred, yt);
    let loss: f64 = nt_mse(pred, yt);
    let lr: f64 = m[4];
    let xt = nt_transpose(nt_as_col(x, m[5]));
    let gw2 = nt_matmul(err, nt_transpose(nt_relu_t(nt_add(nt_matmul(m[7], nt_as_col(x, m[5])), m[8]))));
    let gb2 = err;
    let h = nt_relu_t(nt_add(nt_matmul(m[7], nt_as_col(x, m[5])), m[8]));
    let dh = nt_matmul(nt_transpose(m[9]), err);
    let h0 = nt_add(nt_matmul(m[7], nt_as_col(x, m[5])), m[8]);
    let j: i64 = 0;
    while j < len(dh[2]) {
        let h0d = h0[2];
        let dhd = dh[2];
        if h0d[j] <= 0.0 { dhd[j] = 0.0; }
        j = j + 1;
    }
    let gw1 = nt_matmul(dh, xt);
    m[7] = nt_sub(m[7], nt_scale(gw1, lr));
    m[8] = nt_sub(m[8], nt_scale(dh, lr));
    m[9] = nt_sub(m[9], nt_scale(gw2, lr));
    m[10] = nt_sub(m[10], nt_scale(gb2, lr));
    m[6] = m[6] + 1;
    return loss;
}

fn nt_ep_push(m: list, x: list, y: list, sur: f64) -> i64 {
    let eps = m[11];
    let cap: i64 = m[2];
    let e = [x, y, sur];
    if len(eps) < cap {
        m[11] = push(eps, e);
        return len(m[11]) - 1;
    }
    let i: i64 = 0;
    while i < cap - 1 {
        eps[i] = eps[i + 1];
        i = i + 1;
    }
    eps[cap - 1] = e;
    m[11] = eps;
    return cap - 1;
}

fn nt_learn(m: list, x: list, y: list) -> f64 {
    let loss: f64 = nt_train(m, x, y);
    nt_ep_push(m, x, y, 0.0);
    return loss;
}

fn nt_predict(m: list, x: list) -> list {
    return nt_pred_list(m, x);
}

fn nt_dist(a: list, b: list) -> f64 {
    let n: i64 = len(a);
    if len(b) > n { n = len(b); }
    if n < 1 { n = 1; }
    let acc: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let av: f64 = 0.0;
        let bv: f64 = 0.0;
        if i < len(a) { av = a[i] + 0.0; }
        if i < len(b) { bv = b[i] + 0.0; }
        acc = acc + (av - bv) * (av - bv);
        i = i + 1;
    }
    return nt_exp(nt_log(acc / (n + 0.0)) * 0.5);
}

fn nt_blend(m: list, obs: list) -> list {
    let eps = m[11];
    if len(eps) == 0 { return []; }
    let ws: list = [];
    let idx: list = [];
    let i: i64 = 0;
    while i < len(eps) {
        let epi = eps[i];
        ws = push(ws, 1.0 / (0.05 + nt_dist(epi[0], obs)));
        idx = push(idx, i);
        i = i + 1;
    }
    i = 0;
    while i < len(idx) {
        let j: i64 = i + 1;
        while j < len(idx) {
            if ws[idx[j]] > ws[idx[i]] {
                let tmp = idx[i];
                idx[i] = idx[j];
                idx[j] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let t: i64 = 3;
    if len(idx) < t { t = len(idx); }
    let dim: i64 = len(obs);
    i = 0;
    while i < t {
        let eix = idx[i];
        let epx = eps[eix];
        if len(epx[0]) > dim { dim = len(epx[0]); }
        i = i + 1;
    }
    let out: list = [];
    i = 0;
    while i < dim {
        out = push(out, 0.0);
        i = i + 1;
    }
    let wsum: f64 = 0.0;
    i = 0;
    while i < t {
        let ei: i64 = idx[i];
        wsum = wsum + ws[ei];
        let k: i64 = 0;
        while k < dim {
            let p: f64 = 0.0;
            let epe = eps[ei];
            let pat = epe[0];
            if k < len(pat) { p = pat[k] + 0.0; }
            out[k] = out[k] + ws[ei] * p;
            k = k + 1;
        }
        i = i + 1;
    }
    if wsum < 0.000000001 { wsum = 0.000000001; }
    i = 0;
    while i < dim {
        out[i] = out[i] / wsum;
        i = i + 1;
    }
    return out;
}

fn nt_foresee(m: list, x: list) -> list {
    let neural = nt_pred_list(m, x);
    let core = nt_blend(m, x);
    if len(core) == 0 {
        if m[6] == 0 { return x; }
        return neural;
    }
    let dim: i64 = len(neural);
    if len(core) > dim { dim = len(core); }
    if len(x) > dim { dim = len(x); }
    let nw: f64 = 0.15;
    if m[6] > 0 { nw = 0.6; }
    let cw: f64 = 1.0 - nw;
    let out: list = [];
    let i: i64 = 0;
    while i < dim {
        let n: f64 = 0.0;
        let c: f64 = 0.0;
        let o: f64 = 0.0;
        if i < len(neural) { n = neural[i]; }
        if i < len(core) { c = core[i]; }
        if i < len(x) { o = x[i] + 0.0; }
        out = push(out, nw * n + cw * c * 0.8 + o * 0.2);
        i = i + 1;
    }
    return out;
}

fn nt_remember(m: list, pat: list, sur: f64) -> i64 {
    if sur < m[1] { return 0; }
    nt_ep_push(m, pat, [], sur);
    return 1;
}

fn nt_remember_next(m: list, a: list, b: list, sur: f64) -> i64 {
    if sur < m[1] { return 0; }
    nt_ep_push(m, a, b, sur);
    return 1;
}

fn nt_unroll(m: list, x: list, steps: i64) -> list {
    if steps < 1 { steps = 1; }
    if steps > 64 { steps = 64; }
    let cur = x;
    let out: list = [];
    let i: i64 = 0;
    while i < steps {
        cur = nt_predict(m, cur);
        out = push(out, cur);
        i = i + 1;
    }
    return out;
}

fn nt_foresee_n(m: list, x: list, steps: i64) -> list {
    if steps < 1 { steps = 1; }
    if steps > 64 { steps = 64; }
    let cur = x;
    let out: list = [];
    let i: i64 = 0;
    while i < steps {
        cur = nt_foresee(m, cur);
        out = push(out, cur);
        i = i + 1;
    }
    return out;
}

fn nt_consolidate(m: list) -> i64 {
    let eps = m[11];
    let n: i64 = 0;
    let i: i64 = 0;
    while i < len(eps) {
        let e = eps[i];
        if len(e[1]) > 0 {
            nt_train(m, e[0], e[1]);
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 { m[6] = m[6] + 1; n = 1; }
    return n;
}

fn nt_mem_stats(m: list) -> list {
    return [len(m[11]), m[6], m[1]];
}

fn nt_recall(m: list, q: list, k: i64) -> list {
    if k < 1 { k = 1; }
    let eps = m[11];
    let hits: list = [];
    let i: i64 = 0;
    while i < len(eps) {
        let epi = eps[i];
        hits = push(hits, [nt_dist(epi[0], q), epi[0]]);
        i = i + 1;
    }
    i = 0;
    while i < len(hits) {
        let j: i64 = i + 1;
        while j < len(hits) {
            let hj = hits[j];
            let hi = hits[i];
            if hj[0] < hi[0] {
                let tmp = hits[i];
                hits[i] = hits[j];
                hits[j] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if k > len(hits) { k = len(hits); }
    let out: list = [];
    i = 0;
    while i < k {
        let hi = hits[i];
        out = push(out, hi[1]);
        i = i + 1;
    }
    return out;
}

fn nt_surprise(a: list, b: list) -> f64 {
    return nt_dist(a, b);
}

fn nt_save_mind(m: list, path: str) -> i64 {
    let s: str = "MORE_MIND 1\n";
    s = s + to_str(m[1]) + " " + to_str(m[2]) + " " + to_str(m[3]) + " " + to_str(m[4]) + " " + to_str(m[5]) + " " + to_str(m[6]) + "\n";
    let packs: list = [m[7], m[8], m[9], m[10]];
    let pi: i64 = 0;
    while pi < 4 {
        let pk = packs[pi];
        let d = pk[2];
        let i: i64 = 0;
        while i < len(d) {
            if i > 0 { s = s + " "; }
            s = s + to_str(d[i]);
            i = i + 1;
        }
        s = s + "\n";
        pi = pi + 1;
    }
    let eps = m[11];
    s = s + to_str(len(eps)) + "\n";
    let e: i64 = 0;
    while e < len(eps) {
        let ee = eps[e];
        let pat = ee[0];
        let tgt = ee[1];
        s = s + to_str(ee[2]) + " " + to_str(len(pat));
        let i: i64 = 0;
        while i < len(pat) {
            s = s + " " + to_str(pat[i]);
            i = i + 1;
        }
        s = s + " " + to_str(len(tgt));
        i = 0;
        while i < len(tgt) {
            s = s + " " + to_str(tgt[i]);
            i = i + 1;
        }
        s = s + "\n";
        e = e + 1;
    }
    return write_file(path, s);
}

fn nt_load_mind(path: str) -> list {
    let s: str = read_file(path);
    let p = nt_read_tok(s, 0);
    assert(p[0] == "MORE_MIND");
    p = nt_read_tok(s, p[1]);
    p = nt_read_tok(s, p[1]);
    let thr: f64 = nt_parse_f(p[0]);
    p = nt_read_tok(s, p[1]);
    let cap: i64 = nt_parse_i(p[0]);
    p = nt_read_tok(s, p[1]);
    let hid: i64 = nt_parse_i(p[0]);
    p = nt_read_tok(s, p[1]);
    let lr: f64 = nt_parse_f(p[0]);
    p = nt_read_tok(s, p[1]);
    let dim: i64 = nt_parse_i(p[0]);
    p = nt_read_tok(s, p[1]);
    let steps: i64 = nt_parse_i(p[0]);
    let m = nt_mind(thr, cap, hid);
    m[4] = lr;
    m[5] = dim;
    m[6] = steps;
    let need: list = [hid * dim, hid, dim * hid, dim];
    let packs: list = [7, 8, 9, 10];
    let pi: i64 = 0;
    while pi < 4 {
        let d: list = [];
        let i: i64 = 0;
        while i < need[pi] {
            p = nt_read_tok(s, p[1]);
            d = push(d, nt_parse_f(p[0]));
            i = i + 1;
        }
        let pidx = packs[pi];
        let ten = m[pidx];
        ten[2] = d;
        m[pidx] = ten;
        pi = pi + 1;
    }
    p = nt_read_tok(s, p[1]);
    let ne: i64 = nt_parse_i(p[0]);
    let eps: list = [];
    let e: i64 = 0;
    while e < ne {
        p = nt_read_tok(s, p[1]);
        let sur: f64 = nt_parse_f(p[0]);
        p = nt_read_tok(s, p[1]);
        let pn: i64 = nt_parse_i(p[0]);
        let pat: list = [];
        let i: i64 = 0;
        while i < pn {
            p = nt_read_tok(s, p[1]);
            pat = push(pat, nt_parse_f(p[0]));
            i = i + 1;
        }
        p = nt_read_tok(s, p[1]);
        let tn: i64 = nt_parse_i(p[0]);
        let tgt: list = [];
        i = 0;
        while i < tn {
            p = nt_read_tok(s, p[1]);
            tgt = push(tgt, nt_parse_f(p[0]));
            i = i + 1;
        }
        eps = push(eps, [pat, tgt, sur]);
        e = e + 1;
    }
    m[11] = eps;
    return m;
}
