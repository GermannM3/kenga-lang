// Cooperative timers: after_ms + pump. Not threads � one VM, many due events.

on "tick"(n: i64) {
    println(n);
    if n < 3 {
        after_ms(15, "tick", n + 1);
    }
}

fn main() -> i64 {
    after_ms(0, "tick", 1);
    let i: i64 = 0;
    while i < 24 {
        pump(8);
        if pending() == 0 { break; }
        sleep_ms(15);
        i = i + 1;
    }
    assert(pending() == 0);
    return 0;
}
