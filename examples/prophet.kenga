// Память Пророка: surprise → remember → sleep/consolidate → foresee/recall

fn main() -> i64 {
    let mind: Memory = memory_config(10, 32, 16); // thr=0.10
    println("prophet mind online");
    println(mind);

    // Calm world — prediction matches observation → not stored
    let calm = [1, 2, 3];
    let pred0 = foresee(mind, calm);
    let s0 = surprise(pred0, calm);
    assert(remember(mind, calm, s0) == false);

    // Surprising episodes enter episodic buffer
    assert(remember(mind, [9, 0, 9], 80) == true);
    assert(remember(mind, [8, 1, 8], 70) == true);
    assert(remember(mind, [1, 1, 1], 5) == false);

    println(mem_stats(mind)); // [episodic, core, locked]

    // Sleep: fold episodes into core with importance locks (EWC-lite)
    let folded = consolidate(mind);
    println(folded);
    println(mem_stats(mind));

    // After sleep, foresee uses core knowledge
    println(foresee(mind, [9, 0, 0]));
    println(recall(mind, [9, 0, 9], 2));

    // New similar surprise blends in — old knowledge stays
    assert(remember(mind, [9, 0, 8], 60) == true);
    consolidate(mind);
    println(mem_stats(mind));

    sense_and_sleep(mind);
    println("prophet ok");
    return 0;
}

fn sense_and_sleep(mind: Memory) {
    let obs = [2, 2, 9];
    let pred = foresee(mind, obs);
    let s = surprise(pred, obs);
    if s > 0.2 {
        remember(mind, obs, s);
        println("surprised — stored episode");
    } else {
        println("expected — ignored");
    }
    consolidate(mind);
    println(mem_stats(mind));
}
