// Урок 4 — ветвление if / else.
//
// if условие { ... } else { ... } — классическое ветвление со скобками K&R.
// Условием служит сравнение (< <= > >= == !=); результат сравнения —
// число: 0 значит ложь, всё остальное — истина.
// Для цепочек проверок есть else if.
//
// Ожидаемый вывод:
//   10
//   10

fn max_of_two(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    } else {
        return b;
    }
}

fn main() -> i64 {
    println(max_of_two(10, 3));
    println(max_of_two(3, 10));
    return 0;
}
