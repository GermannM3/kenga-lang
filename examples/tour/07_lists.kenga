// Урок 7 — списки.
//
// Литерал списка: [элемент, элемент, ...]. Элементы нумеруются с нуля:
//   чтение            xs[i]
//   перезапись        xs[i] = v
//   размер            len(xs)
// Метода append нет: рост списка делается встроенной функцией push(xs, v),
// которая возвращает НОВЫЙ список и не трогает старый:
//     xs = push(xs, 99);
// println умеет печатать список целиком.
//
// Ожидаемый вывод:
//   3
//   20
//   60
//   [10, 20, 30, 99]

fn sum(xs: list) -> i64 {
    let s = 0;
    let i = 0;
    while i < len(xs) {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    let xs: list = [10, 20, 30];
    println(len(xs));
    println(xs[1]);
    println(sum(xs));
    xs = push(xs, 99);
    println(xs);
    return 0;
}
