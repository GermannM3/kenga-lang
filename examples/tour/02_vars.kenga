// Урок 2 — переменные и арифметика.
//
// let объявляет переменную: let имя = выражение;
// или с явным типом:        let имя: i64 = выражение;
// i64 — целое со знаком, основной числовой тип портативного подмножества.
// Повторное присваивание — просто имя = выражение; (без let).
// Арифметика: + - * / % ; деление и остаток — целочисленные.
//
// Ожидаемый вывод:
//   6
//   42
//   48

fn main() -> i64 {
    let a: i64 = 6;
    let b = 7;
    let c = a * b;
    println(a);
    println(c);
    a = c + a;
    println(a);
    return 0;
}
