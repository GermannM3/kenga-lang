// Урок 5 — цикл while: сумма чисел от 1 до n.
//
// while условие { тело } повторяет тело, пока условие не равно 0.
// Классический паттерн: счётчик i и аккумулятор s, оба обновляются вручную.
// Тот же результат даёт рекурсия — см. fib/fact в examples/ml/kenga_seed_*.kenga.
// На полном VM и в kenga-lite.exe есть ещё for (см. docs/SPEC.md), здесь — while,
// потому что он работает везде, включая self-host компилятор kenga_lite.kenga.
//
// Ожидаемый вывод:
//   5050

fn sum_to(n: i64) -> i64 {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(sum_to(100));
    return 0;
}
