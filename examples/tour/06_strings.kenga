// Урок 6 — строки.
//
// Строковый литерал пишется в двойных кавычках: "...";
// внутри работают escape-последовательности \n \t \\ \".
// Операции над строками:
//   конкатенация      s + t
//   длина             len(s)
//   индексация        s[i]  — возвращает строку из ОДНОГО символа
//   сравнение         == и !=
//   код символа       ord(ch) — числовой код первого символа
//
// Ожидаемый вывод:
//   Hello, Kenga!
//   13
//   match!
//   H

fn main() -> i64 {
    let who = "Kenga";
    let greeting = "Hello, " + who + "!";
    println(greeting);
    println(len(greeting));
    if greeting == "Hello, Kenga!" {
        println("match!");
    }
    println(greeting[0]);
    return 0;
}
