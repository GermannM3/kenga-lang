// Урок 3 — функции.
//
// fn имя(параметр: тип, ...) -> тип_результата { ... } объявляет функцию,
// вызов — обычный: имя(аргументы). Параметры передаются по значению.
// Рекурсия разрешена (см. fib в examples/ml/kenga_seed_fib.kenga).
// Порядок определений не важен: kenga-lite собирает все имена функций
// до компиляции тел, поэтому quad может вызывать double, объявленную ниже
// (forward reference).
//
// Ожидаемый вывод:
//   42
//   84

fn quad(x: i64) -> i64 {
    return double(double(x));
}

fn double(x: i64) -> i64 {
    return x * 2;
}

fn main() -> i64 {
    println(double(21));
    println(quad(21));
    return 0;
}
