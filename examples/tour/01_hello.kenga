// Урок 1 — Hello, Kenga!
//
// Любая программа на Kenga начинается с функции main.
// println(...) печатает значение и переводит строку.
// return 0 означает «программа завершилась успешно» (код возврата 0).
// Фигурные скобки — в стиле K&R, отступ — 4 пробела, операторы — с точкой
// с запятой. Комментарии начинаются с //.
//
// Запуск: bootstrap\bin\kenga-lite.exe run examples\tour\01_hello.kenga
// Ожидаемый вывод:
//   42

fn main() -> i64 {
    println(42);
    return 0;
}
