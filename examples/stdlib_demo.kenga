import "../stdlib/math.kenga";
import "../stdlib/list.kenga";
import "../stdlib/agent.kenga";

fn main() -> i64 {
    let xs: list = [1, 2, 2, 3];
    assert(sum(xs) == 8);
    assert(product(xs) == 12);
    assert(max_of(xs) == 3);
    assert(fold_add(xs) == 8);
    assert(count_eq(xs, 2) == 2);
    assert(contains(xs, 3) == 1);
    assert(abs(0 - 5) == 5);
    assert(clamp(99, 0, 10) == 10);
    assert(pow_i(2, 5) == 32);
    println("stdlib ok");
    return 0;
}
