// Suffix LM: continue the longest match in our .kenga, write a runnable file.
// Prompt "fn add" hits the seed; the model walks the rest of that source.
//
//   scripts\kenga-birth.cmd

fn last_n_eq(src: str, at: i64, ctx: str, n: i64) -> i64 {
    let end: i64 = at + n;
    if end > len(src) { return 0; }
    if n > len(ctx) { return 0; }
    let i: i64 = 0;
    while i < n {
        let si: i64 = at + i;
        let ci: i64 = len(ctx) - n;
        ci = ci + i;
        if src[si] != ctx[ci] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn find_str(src: str, needle: str) -> i64 {
    let i: i64 = 0;
    while i + len(needle) <= len(src) {
        if last_n_eq(src, i, needle, len(needle)) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn step_pos(src: str, ctx: str, pos: i64, maxn: i64) -> i64 {
    let n: i64 = len(ctx);
    if n > maxn { n = maxn; }
    while n > 0 {
        let start: i64 = pos - n + 1;
        if start >= 0 {
            if last_n_eq(src, start, ctx, n) == 1 {
                if pos + 1 < len(src) { return pos + 1; }
            }
        }
        n = n - 1;
    }
    n = len(ctx);
    if n > maxn { n = maxn; }
    while n > 0 {
        let hit: i64 = 0 - 1;
        let at: i64 = 0;
        let lim: i64 = len(src);
        while at + n < lim {
            if last_n_eq(src, at, ctx, n) == 1 { hit = at; }
            at = at + 1;
        }
        if hit >= 0 { return hit + n; }
        n = n - 1;
    }
    return pos;
}

fn has_main(s: str) -> i64 {
    if find_str(s, "fn main") >= 0 { return 1; }
    return 0;
}

fn main() -> i64 {
    println("=== kenga birth (suffix LM writes a runnable .kenga) ===");
    let src: str = read_file("examples/ml/kenga_seed.kenga");
    let prompt: str = "fn add";
    let at = find_str(src, prompt);
    assert(at >= 0);
    let pos: i64 = at + len(prompt) - 1;
    let out: str = prompt;
    let guard: i64 = 0;
    while pos + 1 < len(src) {
        pos = step_pos(src, out, pos, 12);
        out = out + src[pos];
        guard = guard + 1;
        if guard > len(src) + 8 { break; }
    }
    println(out);
    assert(len(out) > 40);
    assert(has_main(out) == 1);
    assert(find_str(out, "return") >= 0);
    assert(write_file("examples/ml/kenga_born.kenga", out) == 1);
    println("wrote examples/ml/kenga_born.kenga");
    println("kenga birth ok");
    return 0;
}
