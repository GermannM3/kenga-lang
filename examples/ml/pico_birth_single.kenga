// pico_birth_single: suffix-LM matches a prompt in a seed file, walks the
// longest suffix-match, writes a complete .kenga program.
//
// Args file: examples\ml\_pico_args.txt
//   line 1 (prompt)        - the seed prefix
//   line 2 (seed-file path) - the source to walk
//   line 3 (out-file path)  - where to write the generated program
//
//   scripts\pico-birth.cmd writes the args file then runs this program.
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\pico_birth_single.kenga

fn last_n_eq(src: str, at: i64, ctx: str, n: i64) -> i64 {
    let end: i64 = at + n;
    if end > len(src) { return 0; }
    if n > len(ctx) { return 0; }
    let i: i64 = 0;
    while i < n {
        let si: i64 = at + i;
        let ci: i64 = len(ctx) - n;
        ci = ci + i;
        if src[si] != ctx[ci] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn find_str(src: str, needle: str) -> i64 {
    let i: i64 = 0;
    while i + len(needle) <= len(src) {
        if last_n_eq(src, i, needle, len(needle)) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn step_pos(src: str, ctx: str, pos: i64, maxn: i64) -> i64 {
    let n: i64 = len(ctx);
    if n > maxn { n = maxn; }
    while n > 0 {
        let start: i64 = pos - n + 1;
        if start >= 0 {
            if last_n_eq(src, start, ctx, n) == 1 {
                if pos + 1 < len(src) { return pos + 1; }
            }
        }
        n = n - 1;
    }
    n = len(ctx);
    if n > maxn { n = maxn; }
    while n > 0 {
        let hit: i64 = 0 - 1;
        let at: i64 = 0;
        let lim: i64 = len(src);
        while at + n < lim {
            if last_n_eq(src, at, ctx, n) == 1 { hit = at; }
            at = at + 1;
        }
        if hit >= 0 { return hit + n; }
        n = n - 1;
    }
    return pos;
}

fn copy_chars(src: str, lo: i64, hi: i64) -> str {
    let o = "";
    let i: i64 = lo;
    while i < hi {
        o = o + src[i];
        i = i + 1;
    }
    return o;
}

fn split3(text: str) -> list {
    let n = len(text);
    let p1 = find_str(text, "
");
    if p1 < 0 { return [text, "", ""]; }
    let a: str = copy_chars(text, 0, p1);
    let rest1 = copy_chars(text, p1 + 1, n);
    let p2 = find_str(rest1, "
");
    if p2 < 0 { return [a, rest1, ""]; }
    let b: str = copy_chars(rest1, 0, p2);
    let end2 = len(rest1);
    if end2 > 0 {
        let last = rest1[end2 - 1];
        if last == "
" { end2 = end2 - 1; }
        if last == "" { end2 = end2 - 1; }
    }
    let rest2 = copy_chars(rest1, p2 + 1, end2);
    return [a, b, rest2];
}

fn has_main(s: str) -> i64 {
    if find_str(s, "fn main") >= 0 { return 1; }
    return 0;
}

fn main() -> i64 {
    println("=== pico birth single ===");
    let args = split3(read_file("examples/ml/_pico_args.txt"));
    let prompt: str = args[0];
    let src_path: str = args[1];
    let out_path: str = args[2];
    let src: str = read_file(src_path);
    let at = find_str(src, prompt);
    if at < 0 {
        println("prompt not in source");
        return 2;
    }
    let pos: i64 = at + len(prompt) - 1;
    let out: str = prompt;
    let guard: i64 = 0;
    while pos + 1 < len(src) {
        pos = step_pos(src, out, pos, 12);
        out = out + src[pos];
        guard = guard + 1;
        if guard > len(src) + 8 { break; }
    }
    if has_main(out) == 0 {
        println("generated has no fn main");
        return 3;
    }
    if write_file(out_path, out) != 1 {
        println("write_file failed");
        return 4;
    }
    println(out_path);
    return 0;
}
