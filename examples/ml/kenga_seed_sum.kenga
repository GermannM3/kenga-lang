// pico seed sumto: sumto(10) = 55
fn sumto(n: i64) -> i64 {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}
fn prodto(n: i64) -> i64 {
    let p = 1;
    let i = 2;
    while i <= n {
        p = p * i;
        i = i + 1;
    }
    return p;
}
fn main() -> i64 {
    let y = sumto(10);
    println(y);
    return 0;
}
