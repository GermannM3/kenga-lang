// Tape autograd: learn W for y ≈ W @ x via ag_* API

fn main() -> i64 {
    let w0 = t_from([2, 2], [0.0, 0.0, 0.0, 0.0]);
    let x = t_from([2, 1], [1.0, 1.0]);
    let y = t_from([2, 1], [2.0, 3.0]);

    let i = 0;
    let w = w0;
    while i < 50 {
        ag_clear();
        let wid = ag_param(w);
        let xid = ag_const(x);
        let yid = ag_const(y);
        let pred = ag_matmul(wid, xid);
        let loss = ag_mse(pred, yid);
        ag_backward(loss);
        w = ag_step(wid, 0.25);
        i = i + 1;
    }

    let pred = t_matmul(w, x);
    let e0 = t_get(pred, 0) - 2.0;
    let e1 = t_get(pred, 1) - 3.0;
    if e0 < 0.0 { e0 = 0.0 - e0; }
    if e1 < 0.0 { e1 = 0.0 - e1; }
    assert(e0 < 0.2);
    assert(e1 < 0.2);
    println(round(t_get(pred, 0) * 10.0));
    println(round(t_get(pred, 1) * 10.0));
    println("autograd ok");
    return 0;
}
