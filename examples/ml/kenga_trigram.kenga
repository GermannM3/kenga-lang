// Char trigram on our .kenga. Sparse counts (no V^3 table).
// No Tensor, no GGUF. Runs on lite and bytecode VM.
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\kenga_trigram.kenga
//   scripts\bc-run.cmd examples\ml\kenga_trigram.kenga

fn ch_id(alpha: str, ch: str) -> i64 {
    let i: i64 = 0;
    while i < len(alpha) {
        if alpha[i] == ch { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn build_alpha(src: str) -> str {
    let a: str = "";
    let i: i64 = 0;
    while i < len(src) {
        if ch_id(a, src[i]) < 0 { a = a + src[i]; }
        i = i + 1;
    }
    return a;
}

fn encode(src: str, alpha: str) -> list {
    let ids = [];
    let i: i64 = 0;
    while i < len(src) {
        let id = ch_id(alpha, src[i]);
        if id >= 0 { ids = push(ids, id); }
        i = i + 1;
    }
    return ids;
}

fn strip_line_comments(src: str) -> str {
    let out: str = "";
    let i: i64 = 0;
    while i < len(src) {
        if i + 1 < len(src) {
            if src[i] == "/" {
                if src[i + 1] == "/" {
                    while i < len(src) {
                        if src[i] == "\n" { break; }
                        i = i + 1;
                    }
                    continue;
                }
            }
        }
        out = out + src[i];
        i = i + 1;
    }
    return out;
}

fn take(s: str, n: i64) -> str {
    if len(s) <= n { return s; }
    let out: str = "";
    let i: i64 = 0;
    while i < n {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

fn load_corpus() -> str {
    let s: str = "";
    s = s + strip_line_comments(read_file("examples/ml/kenga_seed.kenga"));
    s = s + "\n";
    s = s + strip_line_comments(read_file("examples/selfhost/fact_lite.kenga"));
    s = s + "\n";
    s = s + strip_line_comments(read_file("examples/selfhost/lists_lite.kenga"));
    s = s + "\n";
    s = s + take(read_file("kenga/compiler/lite.kenga"), 800);
    return s;
}

fn find_tri(ta: list, tb: list, tc: list, a: i64, b: i64, c: i64) -> i64 {
    let i: i64 = 0;
    while i < len(ta) {
        if ta[i] == a {
            if tb[i] == b {
                if tc[i] == c { return i; }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn best_next(ta: list, tb: list, tc: list, tn: list, a: i64, b: i64, banned: i64) -> i64 {
    let best: i64 = 0;
    let bv: i64 = 0 - 1;
    let i: i64 = 0;
    while i < len(ta) {
        if ta[i] == a {
            if tb[i] == b {
                if tc[i] != banned {
                    if tn[i] > bv {
                        bv = tn[i];
                        best = tc[i];
                    }
                }
            }
        }
        i = i + 1;
    }
    return best;
}

fn main() -> i64 {
    println("=== kenga trigram (our .kenga, sparse list/i64) ===");
    let src: str = load_corpus();
    let alpha: str = build_alpha(src);
    let ids = encode(src, alpha);
    println("chars");
    println(len(src));
    println("vocab");
    println(len(alpha));

    let ta = [];
    let tb = [];
    let tc = [];
    let tn = [];
    let i: i64 = 2;
    while i < len(ids) {
        let a: i64 = ids[i - 2];
        let b: i64 = ids[i - 1];
        let c: i64 = ids[i];
        let hit = find_tri(ta, tb, tc, a, b, c);
        if hit < 0 {
            ta = push(ta, a);
            tb = push(tb, b);
            tc = push(tc, c);
            tn = push(tn, 1);
        } else {
            tn[hit] = tn[hit] + 1;
        }
        i = i + 1;
    }
    println("trigrams");
    println(len(ta));

    let prompt: str = "fn add";
    let ctx = encode(prompt, alpha);
    let out: str = prompt;
    let step: i64 = 0;
    let last: i64 = 0 - 1;
    let prev2: i64 = 0 - 1;
    while step < 56 {
        let a: i64 = ctx[len(ctx) - 2];
        let b: i64 = ctx[len(ctx) - 1];
        let nxt = best_next(ta, tb, tc, tn, a, b, 0 - 1);
        if nxt == prev2 { nxt = best_next(ta, tb, tc, tn, a, b, nxt); }
        if nxt == last { nxt = best_next(ta, tb, tc, tn, a, b, nxt); }
        prev2 = last;
        last = nxt;
        out = out + alpha[nxt];
        ctx = push(ctx, nxt);
        step = step + 1;
    }
    println(out);
    assert(len(out) > 16);
    assert(ch_id(out, "(") >= 0);
    assert(write_file("examples/ml/kenga_trigram_sample.txt", out) == 1);
    println("kenga trigram ok");
    return 0;
}
