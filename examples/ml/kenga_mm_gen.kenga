// Vision picks the first letter; the decoder writes the rest of the color word.
// Same CTX window at train and generate. Not GGUF.
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\kenga_mm_gen.kenga

import "kenga_dec.kenga";

fn fuse_col(img_path: str, wav_path: str) -> Tensor {
    let img = t_mean(load_ppm(img_path));
    let wav = load_wav(wav_path);
    let am = t_mean(wav);
    let energy = t_mean(t_mul(wav, wav));
    return t_from([6, 1], [t_get(img, 0), t_get(img, 1), t_get(img, 2), am, energy, energy * 2.0]);
}

fn scene_col(i: i64) -> Tensor {
    if i == 0 { return fuse_col("examples/ml/assets/frame0.ppm", "examples/ml/assets/tone0.wav"); }
    if i == 1 { return fuse_col("examples/ml/assets/frame1.ppm", "examples/ml/assets/tone1.wav"); }
    return fuse_col("examples/ml/assets/frame2.ppm", "examples/ml/assets/tone2.wav");
}

fn caption(i: i64) -> str {
    if i == 0 { return "kenga vidit krasnyj kadr i slyshit ton"; }
    if i == 1 { return "kenga vidit zelenyj kadr i slyshit ton"; }
    return "kenga vidit sinij kadr i slyshit ton";
}

fn color_word(i: i64) -> str {
    if i == 0 { return "krasnyj"; }
    if i == 1 { return "zelenyj"; }
    return "sinij";
}

fn train_text(e: Tensor, wlm: Tensor, ids: list, vv: i64, wq: list, wk: list, wv: list, wo: list, wf1: list, wf2: list) -> list {
    let ctxn: i64 = CTX();
    let p: i64 = 1;
    while p < len(ids) {
        let packed = train_last(e, wlm, window(ids, p, ctxn), ids[p], 0.12, vv, wq, wk, wv, wo, wf1, wf2);
        e = packed[0];
        wlm = packed[1];
        p = p + 1;
    }
    return [e, wlm];
}

fn train_color_text(e: Tensor, wlm: Tensor, prefix: str, word: str, alpha: str, vv: i64, wq: list, wk: list, wv: list, wo: list, wf1: list, wf2: list) -> list {
    let ctxn: i64 = CTX();
    let ctx = clip_ctx(encode(prefix, alpha), ctxn);
    let i: i64 = 0;
    while i < len(word) {
        let tid = ch_id(alpha, word[i]);
        let packed = train_last(e, wlm, ctx, tid, 0.16, vv, wq, wk, wv, wo, wf1, wf2);
        e = packed[0];
        wlm = packed[1];
        ctx = clip_ctx(push(ctx, tid), ctxn);
        i = i + 1;
    }
    return [e, wlm];
}

fn main() -> i64 {
    println("=== kenga mm-gen (decoder writes the color word) ===");
    let text: str = caption(0) + "\n" + caption(1) + "\n" + caption(2) + "\n";
    let alpha: str = build_alpha(text);
    let vv: i64 = len(alpha);
    let d: i64 = D();
    let ff: i64 = FF();
    println("vocab");
    println(vv);

    let e = fill_w(vv, d, 7);
    let att = frozen_attn(d, ff);
    let wq = att[0];
    let wk = att[1];
    let wv = att[2];
    let wo = att[3];
    let wf1 = att[4];
    let wf2 = att[5];
    let wlm = fill_w(vv, d, 59);
    let whead = fill_w(vv, 6, 71);
    let f0 = scene_col(0);
    let f1 = scene_col(1);
    let f2 = scene_col(2);
    let id0 = encode(caption(0), alpha);
    let id1 = encode(caption(1), alpha);
    let id2 = encode(caption(2), alpha);
    let prefix: str = "kenga vidit ";
    let fork = clip_ctx(encode(prefix, alpha), CTX());

    let ep: i64 = 0;
    while ep < 8 {
        let p = train_text(e, wlm, id0, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_text(e, wlm, id1, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_text(e, wlm, id2, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_color_text(e, wlm, prefix, color_word(0), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_color_text(e, wlm, prefix, color_word(1), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_color_text(e, wlm, prefix, color_word(2), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        ep = ep + 1;
    }

    let br: i64 = 0;
    while br < 80 {
        whead = train_whead_only(whead, fork, ch_id(alpha, "k"), 0.35, vv, f0, e, wq, wk, wv, wo, wf1, wf2, wlm);
        whead = train_whead_only(whead, fork, ch_id(alpha, "z"), 0.35, vv, f1, e, wq, wk, wv, wo, wf1, wf2, wlm);
        whead = train_whead_only(whead, fork, ch_id(alpha, "s"), 0.35, vv, f2, e, wq, wk, wv, wo, wf1, wf2, wlm);
        br = br + 1;
    }

    let more: i64 = 0;
    while more < 40 {
        let q = train_color_text(e, wlm, prefix, color_word(0), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = q[0];
        wlm = q[1];
        q = train_color_text(e, wlm, prefix, color_word(1), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = q[0];
        wlm = q[1];
        q = train_color_text(e, wlm, prefix, color_word(2), alpha, vv, wq, wk, wv, wo, wf1, wf2);
        e = q[0];
        wlm = q[1];
        more = more + 1;
    }

    let g0 = generate_vis_greedy(prefix, alpha, e, f0, whead, wq, wk, wv, wo, wf1, wf2, wlm, 7);
    let g1 = generate_vis_greedy(prefix, alpha, e, f1, whead, wq, wk, wv, wo, wf1, wf2, wlm, 7);
    let g2 = generate_vis_greedy(prefix, alpha, e, f2, whead, wq, wk, wv, wo, wf1, wf2, wlm, 5);
    println(g0);
    println(g1);
    println(g2);
    assert(teacher_word(prefix, "kra", alpha, e, f0, whead, wq, wk, wv, wo, wf1, wf2, wlm) == 1);
    assert(teacher_word(prefix, "ze", alpha, e, f1, whead, wq, wk, wv, wo, wf1, wf2, wlm) == 1);
    assert(teacher_word(prefix, "si", alpha, e, f2, whead, wq, wk, wv, wo, wf1, wf2, wlm) == 1);
    assert(has_sub(g0, "kra") == 1);
    assert(has_sub(g1, "ze") == 1);
    assert(has_sub(g2, "si") == 1);
    assert(write_file("minds/kenga_mm_alpha.txt", alpha) == 1);
    assert(write_file("examples/ml/kenga_mm_gen_sample.txt", g0 + "\n" + g1 + "\n" + g2 + "\n") == 1);
    assert(save_tensor(e, "minds/kenga_mm_e.kt") == 1);
    assert(save_tensor(wlm, "minds/kenga_mm_wlm.kt") == 1);
    assert(save_tensor(whead, "minds/kenga_mm_whead.kt") == 1);
    println("kenga mm-gen ok");
    return 0;
}
