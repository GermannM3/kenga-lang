// Explicit SGD on tensors: learn W for y ≈ W @ x
// Target: W = [[2,0],[0,3]] so [1,1] → [2,3]

fn main() -> i64 {
    let w = t_from([2, 2], [0.0, 0.0, 0.0, 0.0]);
    let x = t_from([2, 1], [1.0, 1.0]);
    let y = t_from([2, 1], [2.0, 3.0]);
    let lr = 0.25;
    let i = 0;
    while i < 40 {
        w = t_sgd_step(w, x, y, lr);
        i = i + 1;
    }
    let pred = t_matmul(w, x);
    let e0 = t_get(pred, 0) - 2.0;
    let e1 = t_get(pred, 1) - 3.0;
    if e0 < 0.0 { e0 = 0.0 - e0; }
    if e1 < 0.0 { e1 = 0.0 - e1; }
    assert(e0 < 0.15);
    assert(e1 < 0.15);
    println(round(t_get(pred, 0) * 10.0));
    println(round(t_get(pred, 1) * 10.0));
    println("sgd ok");
    return 0;
}
