// Word-level decoder + visual fork. Color is one token.
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\kenga_mm_words.kenga

import "kenga_mm_wcore.kenga";

fn train_ids(e: Tensor, wlm: Tensor, ids: list, vv: i64, wq: list, wk: list, wv: list, wo: list, wf1: list, wf2: list) -> list {
    let ctxn: i64 = CTX();
    let p: i64 = 1;
    while p < len(ids) {
        let packed = train_last(e, wlm, window(ids, p, ctxn), ids[p], 0.16, vv, wq, wk, wv, wo, wf1, wf2);
        e = packed[0];
        wlm = packed[1];
        p = p + 1;
    }
    return [e, wlm];
}

fn main() -> i64 {
    println("=== kenga mm-words (decoder writes a color token) ===");
    let vocab = vocab_of();
    let vv: i64 = len(vocab);
    let d: i64 = D();
    let ff: i64 = FF();
    let e = fill_w(vv, d, 7);
    let att = frozen_attn(d, ff);
    let wq = att[0];
    let wk = att[1];
    let wv = att[2];
    let wo = att[3];
    let wf1 = att[4];
    let wf2 = att[5];
    let wlm = fill_w(vv, d, 59);
    let whead = fill_w(vv, 6, 71);
    let f0 = scene_col(0);
    let f1 = scene_col(1);
    let f2 = scene_col(2);
    let id0 = encode_words(caption_words(0), vocab);
    let id1 = encode_words(caption_words(1), vocab);
    let id2 = encode_words(caption_words(2), vocab);
    let fork = encode_words(["kenga", "vidit"], vocab);

    let ep: i64 = 0;
    while ep < 12 {
        let p = train_ids(e, wlm, id0, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_ids(e, wlm, id1, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        p = train_ids(e, wlm, id2, vv, wq, wk, wv, wo, wf1, wf2);
        e = p[0];
        wlm = p[1];
        ep = ep + 1;
    }

    let br: i64 = 0;
    while br < 80 {
        whead = train_whead_only(whead, fork, word_id(vocab, "krasnyj"), 0.35, vv, f0, e, wq, wk, wv, wo, wf1, wf2, wlm);
        whead = train_whead_only(whead, fork, word_id(vocab, "zelenyj"), 0.35, vv, f1, e, wq, wk, wv, wo, wf1, wf2, wlm);
        whead = train_whead_only(whead, fork, word_id(vocab, "sinij"), 0.35, vv, f2, e, wq, wk, wv, wo, wf1, wf2, wlm);
        br = br + 1;
    }

    let prompt = ["kenga", "vidit"];
    let g0 = generate_words(prompt, vocab, e, f0, whead, wq, wk, wv, wo, wf1, wf2, wlm, 5);
    let g1 = generate_words(prompt, vocab, e, f1, whead, wq, wk, wv, wo, wf1, wf2, wlm, 5);
    let g2 = generate_words(prompt, vocab, e, f2, whead, wq, wk, wv, wo, wf1, wf2, wlm, 5);
    println(g0);
    println(g1);
    println(g2);
    assert(has_sub(g0, color_of(0)) == 1);
    assert(has_sub(g1, color_of(1)) == 1);
    assert(has_sub(g2, color_of(2)) == 1);
    assert(write_file("examples/ml/kenga_mm_words_sample.txt", g0 + "\n" + g1 + "\n" + g2 + "\n") == 1);
    assert(save_tensor(e, "minds/kenga_mm_we.kt") == 1);
    assert(save_tensor(wlm, "minds/kenga_mm_wwlm.kt") == 1);
    assert(save_tensor(whead, "minds/kenga_mm_wwhead.kt") == 1);
    println("kenga mm-words ok");
    return 0;
}
