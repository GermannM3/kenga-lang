// Vision+audio → text. Train the multimodal seed. Not GGUF.
//   bootstrap\bin\kenga-lite.exe run examples\ml\kenga_mm_lm.kenga

import "kenga_mm_core.kenga";

fn train_one(w: Tensor, b: Tensor, x: Tensor, y: Tensor, lr: f64) -> list {
    ag_clear();
    let wid = ag_param(w);
    let bid = ag_param(b);
    let probs = ag_softmax(ag_add(ag_matmul(wid, ag_const(x)), bid));
    let loss = ag_neg(ag_sum(ag_mul(ag_const(y), ag_log(probs))));
    ag_backward(loss);
    return [ag_step(wid, lr), ag_step(bid, lr)];
}

fn main() -> i64 {
    println("=== kenga mm-LM (PPM+WAV → caption, native) ===");
    let x0 = scene_col(0);
    let x1 = scene_col(1);
    let x2 = scene_col(2);
    let y0 = t_from([3, 1], onehot(0, 3));
    let y1 = t_from([3, 1], onehot(1, 3));
    let y2 = t_from([3, 1], onehot(2, 3));

    let w = t_from([3, 6], zeros(18));
    let b = t_from([3, 1], zeros(3));
    let ep: i64 = 0;
    while ep < 80 {
        let p = train_one(w, b, x0, y0, 0.35);
        w = p[0];
        b = p[1];
        p = train_one(w, b, x1, y1, 0.35);
        w = p[0];
        b = p[1];
        p = train_one(w, b, x2, y2, 0.35);
        w = p[0];
        b = p[1];
        ep = ep + 1;
    }

    let c0 = label_of(w, b, x0);
    let c1 = label_of(w, b, x1);
    let c2 = label_of(w, b, x2);
    println(caption(c0));
    println(caption(c1));
    println(caption(c2));
    assert(c0 == 0);
    assert(c1 == 1);
    assert(c2 == 2);
    assert(save_tensor(w, "minds/kenga_mm_w.kt") == 1);
    assert(save_tensor(b, "minds/kenga_mm_b.kt") == 1);
    let card: str = "kenga-seed-mm\nvision=ppm-mean-rgb\naudio=wav-energy\ntext=caption-3\narch=linear-softmax-6d\nver=3.13.0\n";
    assert(write_file("hf/kenga-seed/weights.md", card) == 1);
    println("kenga mm-lm ok");
    return 0;
}
