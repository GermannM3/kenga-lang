// Vision → text in Kenga. PPM mean RGB → linear → softmax → caption.
// Seed of the multimodal LM we will put on Hugging Face when it is large.
// Not GGUF. Weights: minds/kenga_mm_w.kt
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\kenga_mm_lm.kenga

fn zeros(n: i64) -> list {
    let xs = [];
    let i: i64 = 0;
    while i < n {
        xs = push(xs, 0.05);
        i = i + 1;
    }
    return xs;
}

fn onehot(idx: i64, n: i64) -> list {
    let xs = [];
    let j: i64 = 0;
    while j < n {
        if j == idx { xs = push(xs, 1.0); } else { xs = push(xs, 0.0); }
        j = j + 1;
    }
    return xs;
}

fn rgb_col(path: str) -> Tensor {
    let m = t_mean(load_ppm(path));
    return t_from([3, 1], [t_get(m, 0), t_get(m, 1), t_get(m, 2)]);
}

fn caption(i: i64) -> str {
    if i == 0 { return "kenga vidit krasnyj kadr"; }
    if i == 1 { return "kenga vidit zelenyj kadr"; }
    return "kenga vidit sinij kadr";
}

fn argmax3(t: Tensor) -> i64 {
    let best: i64 = 0;
    let bv = t_get(t, 0);
    let i: i64 = 1;
    while i < 3 {
        let x = t_get(t, i);
        if x > bv {
            bv = x;
            best = i;
        }
        i = i + 1;
    }
    return best;
}

fn train_one(w: Tensor, b: Tensor, x: Tensor, y: Tensor, lr: f64) -> list {
    ag_clear();
    let wid = ag_param(w);
    let bid = ag_param(b);
    let probs = ag_softmax(ag_add(ag_matmul(wid, ag_const(x)), bid));
    let loss = ag_neg(ag_sum(ag_mul(ag_const(y), ag_log(probs))));
    ag_backward(loss);
    return [ag_step(wid, lr), ag_step(bid, lr)];
}

fn main() -> i64 {
    println("=== kenga mm-LM (PPM → caption, native) ===");
    let x0 = rgb_col("examples/ml/assets/frame0.ppm");
    let x1 = rgb_col("examples/ml/assets/frame1.ppm");
    let x2 = rgb_col("examples/ml/assets/frame2.ppm");
    let y0 = t_from([3, 1], onehot(0, 3));
    let y1 = t_from([3, 1], onehot(1, 3));
    let y2 = t_from([3, 1], onehot(2, 3));

    let w = t_from([3, 3], zeros(9));
    let b = t_from([3, 1], zeros(3));
    let ep: i64 = 0;
    while ep < 80 {
        let p = train_one(w, b, x0, y0, 0.35);
        w = p[0];
        b = p[1];
        p = train_one(w, b, x1, y1, 0.35);
        w = p[0];
        b = p[1];
        p = train_one(w, b, x2, y2, 0.35);
        w = p[0];
        b = p[1];
        ep = ep + 1;
    }

    let c0 = argmax3(t_softmax(t_add(t_matmul(w, x0), b)));
    let c1 = argmax3(t_softmax(t_add(t_matmul(w, x1), b)));
    let c2 = argmax3(t_softmax(t_add(t_matmul(w, x2), b)));
    println(caption(c0));
    println(caption(c1));
    println(caption(c2));
    assert(c0 == 0);
    assert(c1 == 1);
    assert(c2 == 2);
    assert(save_tensor(w, "minds/kenga_mm_w.kt") == 1);
    assert(save_tensor(b, "minds/kenga_mm_b.kt") == 1);
    let card: str = "kenga-seed-mm\nvision=ppm-mean-rgb\ntext=caption-3\narch=linear-softmax\n";
    assert(write_file("hf/kenga-seed/weights.md", card) == 1);
    println("kenga mm-lm ok");
    return 0;
}
