// Patch encoder + explicit grad (autograd slice)

fn main() -> i64 {
    let img = load_ppm("examples/ml/assets/dot.ppm"); // [2,2,3]
    let patches = t_patch_mean(img, 1, 1); // [1,1,3]
    println(t_shape(patches));

    let w = t_from([1, 3], [0.0, 0.0, 0.0]);
    let x = t_reshape(t_mean(img), [3, 1]);
    let y = t_from([1, 1], [1.5]);
    let g = t_linear_grad(w, x, y);
    let loss0 = t_mse(t_matmul(w, x), y);
    w = t_sub(w, t_scale(g, 0.5));
    let loss1 = t_mse(t_matmul(w, x), y);
    assert(loss1 < loss0);
    println(loss0);
    println(loss1);
    println("encoder+grad ok");
    return 0;
}
