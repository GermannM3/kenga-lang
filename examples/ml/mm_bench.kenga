// микро-бенчмарк: накладные расходы t_get в цикле
fn zeros(n: i64) -> list {
    let xs = [];
    let i: i64 = 0;
    while i < n { xs = push(xs, 0.05); i = i + 1; }
    return xs;
}

fn main() -> i64 {
    let a = t_from([16, 16], zeros(256));
    let acc: f64 = 0.0;
    let it: i64 = 0;
    while it < 2000 {
        let j: i64 = 0;
        while j < 256 { acc = acc + t_get(a, j); j = j + 1; }
        it = it + 1;
    }
    if acc > 0.0 { println("get ok"); }
    return 0;
}