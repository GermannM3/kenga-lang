// Prophet 400M — industrial body for CPU. Z rank-curriculum + Kenga mix.
// Fair class vs Giga-Embeddings ~480M. GPU 400M froze the 1660; CPU is the pitch.
//
//   bootstrap\bin\kenga-lite.exe run examples\ml\prophet_400m.kenga
// Train: D:\z-system\exp_PROPHET_400.py  (DEVICE=cpu)

fn d_model() -> i64 { return 1280; }
fn n_layers() -> i64 { return 19; }
fn n_heads() -> i64 { return 20; }
fn d_ff() -> i64 { return 5120; }
fn k_attn_full() -> i64 { return 512; }
fn k_ff_full() -> i64 { return 1280; }
fn k_attn0() -> i64 { return 128; }
fn k_ff0() -> i64 { return 320; }

fn z_is_alive(p: str) -> i64 { return file_exists(p); }

fn bl_params(inf: i64, outf: i64, k: i64) -> i64 {
    return outf * k + inf * k + k + outf;
}

fn n_params() -> i64 {
    let d = d_model();
    let ka = k_attn_full();
    let kf = k_ff_full();
    let dff = d_ff();
    let attn = 4 * bl_params(d, d, ka);
    let ff = bl_params(d, dff, kf) + bl_params(dff, d, kf);
    return n_layers() * (attn + ff);
}

fn stamp(path: str, n: i64) {
    let body: str = "{\"kind\":\"kenga-prophet-400\",\"D\":1280,\"L\":19,\"K_ATTN\":512,\"K_FF\":1280,\"n_params\":";
    body = body + to_str(n);
    body = body + ",\"device\":\"cpu\",\"z_curriculum\":\"128/320 -> 256/640 -> 512/1280\",\"kenga_mix\":1}\n";
    write_file(path, body);
}

fn main() -> i64 {
    let n = n_params();
    println("PROPHET_400_CPU");
    println(d_model());
    println(n_layers());
    println(k_attn_full());
    println(k_ff_full());
    println(n);
    stamp("minds/_prophet_400m.passport.json", n);
    assert(n > 380000000);
    assert(n < 430000000);
    assert(z_is_alive("minds/_prophet_400m.passport.json") == 1);
    println("prophet 400 cpu spec ok");
    return 0;
}
