// Multimodal bridge: PPM image → tensor → mean RGB embedding

fn main() -> i64 {
    let img = load_ppm("examples/ml/assets/dot.ppm");
    println(t_shape(img)); // [2, 2, 3]
    let emb = t_mean(img);  // average RGB over pixels
    println(t_shape(emb));  // [3]
    // pixels: R,G / B,W → mean ≈ (0.5, 0.5, 0.5)
    let r = t_get(emb, 0);
    let g = t_get(emb, 1);
    let b = t_get(emb, 2);
    assert(round(r * 10.0) == 5);
    assert(round(g * 10.0) == 5);
    assert(round(b * 10.0) == 5);

    // feed embedding into a tiny linear head
    let w = t_from([1, 3], [1.0, 1.0, 1.0]);
    let x = t_reshape(emb, [3, 1]);
    let score = t_get(t_matmul(w, x), 0);
    assert(round(score * 10.0) == 15); // 0.5*3
    println(score);
    println("vision bridge ok");
    return 0;
}
