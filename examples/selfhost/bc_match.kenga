// Integer match via bc_src_c (parse ? bytecode ? C).
//   match n { 0 => { ... } 1 => { ... } _ => { ... } }

fn classify(n: i64) -> i64 {
    match n {
        0 => { return 10; }
        1 => { return 20; }
        2 => { return 30; }
        _ => { return 40; }
    }
}

fn main() -> i64 {
    assert(classify(0) == 10);
    assert(classify(1) == 20);
    assert(classify(2) == 30);
    assert(classify(7) == 40);
    let x: i64 = 2;
    let v: i64 = 0;
    match x {
        2 => { v = 99; }
        _ => { v = 0; }
    }
    assert(v == 99);
    let y: i64 = 0 - 1;
    let w: i64 = 0;
    match y {
        -1 => { w = 7; }
        0x2 => { w = 8; }
        _ => { w = 0; }
    }
    assert(w == 7);
    println(classify(2));
    println("match ok");
    return 0;
}
