// else if chain via bc_src (no float yet).

fn main() -> i64 {
    let n = 2;
    let label = 0;
    if n == 0 {
        label = 10;
    } else if n == 1 {
        label = 20;
    } else if n == 2 {
        label = 30;
    } else {
        label = 40;
    }
    assert(label == 30);
    println(label);
    println("elif ok");
    return 0;
}
