// for_lite dialect via bc_src (no str println/assert yet).

fn sum(xs: list) -> i64 {
    let s: i64 = 0;
    for v in xs {
        s = s + v;
    }
    return s;
}

fn main() -> i64 {
    let xs: list = [1, 2, 3, 4];
    xs[0] = 10;
    println(sum(xs));

    let acc: i64 = 0;
    for i in 0..5 {
        if i == 3 {
            break;
        }
        acc = acc + i;
    }
    println(acc);

    let skip: i64 = 0;
    for i in 0..5 {
        if i == 2 {
            continue;
        }
        skip = skip + i;
    }
    println(skip);
    return 0;
}
