// Bitwise & | ^ ~ << >> on kenga-lite C VM + more.kenga
//   bootstrap\bin\kenga-lite.exe run examples\selfhost\bitops.kenga

fn main() -> i64 {
    assert((5 & 3) == 1);
    assert((5 | 3) == 7);
    assert((5 ^ 3) == 6);
    assert((~0) == -1);
    assert((1 << 4) == 16);
    assert((16 >> 2) == 4);
    assert((1 + 2 << 3) == 24);
    assert((2 << 2 & 8 | 1) == 9);
    assert((32 & 240) == 32);
    assert((10 >> 1) == 5);
    println("bitops ok");
    return 0;
}
