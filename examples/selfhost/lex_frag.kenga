// Compiler-shaped string helpers — lowered via lower_kv (path to free more.kenga).

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}
fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}
fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 1 { i = i + 1; continue; }
        break;
    }
    return i;
}
fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i);
    let name: str = "";
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 { if is_digit(ch) == 0 { break; } }
        name = name + ch;
        i = i + 1;
    }
    return [name, i];
}

fn main() -> i64 {
    let src: str = "  foo42 + bar";
    let id = parse_ident(src, 0);
    assert(id[0] == "foo42");
    assert(id[1] == 7);
    let id2 = parse_ident(src, id[1]);
    // skip spaces then fail alpha on '+'
    assert(id2[0] == "");
    println(id[0]);
    println("lex_frag ok");
    return 0;
}
