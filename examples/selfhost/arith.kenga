// Self-host seed: арифметический интерпретатор на чистом Kenga.
// Это зародыш компилятора-на-Kenga: лексер + recursive descent + eval.

fn is_space(ch: str) -> i64 {
    if ch == " " {
        return 1;
    }
    if ch == "\t" {
        return 1;
    }
    return 0;
}

fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 {
        if c <= 57 {
            return 1;
        }
    }
    return 0;
}

fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 0 {
            break;
        }
        i = i + 1;
    }
    return i;
}

fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    let got: i64 = 0;
    while i < len(s) {
        if is_digit(s[i]) == 0 {
            break;
        }
        v = v * 10 + (ord(s[i]) - 48);
        i = i + 1;
        got = 1;
    }
    assert(got == 1);
    return [v, i];
}

fn parse_factor(s: str, i: i64) -> list {
    i = skip(s, i);
    if i < len(s) {
        if s[i] == "(" {
            let e = parse_expr(s, i + 1);
            let j: i64 = skip(s, e[1]);
            assert(s[j] == ")");
            return [e[0], j + 1];
        }
        if s[i] == "-" {
            let f = parse_factor(s, i + 1);
            return [0 - f[0], f[1]];
        }
    }
    return parse_number(s, i);
}

fn parse_term(s: str, i: i64) -> list {
    let left = parse_factor(s, i);
    let v: i64 = left[0];
    let j: i64 = left[1];
    while true {
        j = skip(s, j);
        if j >= len(s) {
            break;
        }
        let op: str = s[j];
        if op == "*" {
            let r = parse_factor(s, j + 1);
            v = v * r[0];
            j = r[1];
        } else {
            if op == "/" {
                let r = parse_factor(s, j + 1);
                v = v / r[0];
                j = r[1];
            } else {
                break;
            }
        }
    }
    return [v, j];
}

fn parse_expr(s: str, i: i64) -> list {
    let left = parse_term(s, i);
    let v: i64 = left[0];
    let j: i64 = left[1];
    while true {
        j = skip(s, j);
        if j >= len(s) {
            break;
        }
        let op: str = s[j];
        if op == "+" {
            let r = parse_term(s, j + 1);
            v = v + r[0];
            j = r[1];
        } else {
            if op == "-" {
                let r = parse_term(s, j + 1);
                v = v - r[0];
                j = r[1];
            } else {
                break;
            }
        }
    }
    return [v, j];
}

fn eval_expr(s: str) -> i64 {
    let r = parse_expr(s, 0);
    return r[0];
}

fn main() -> i64 {
    println("self-host seed: arith on pure Kenga");

    assert(eval_expr("2+3") == 5);
    assert(eval_expr("2+3*4") == 14);
    assert(eval_expr("(2+3)*4") == 20);
    assert(eval_expr("10-3-2") == 5);
    assert(eval_expr("20/4*2") == 10);
    assert(eval_expr("-5+12") == 7);
    assert(eval_expr("1+(2*(3+4))") == 15);

    println(eval_expr("2+3*4"));
    println(eval_expr("(2+3)*4"));
    println("arith ok");
    return 0;
}
