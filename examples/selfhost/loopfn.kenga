// Self-host step 4: while + simple functions (tree-walk).
// x=0; while x<5 do x=x+1 end; x  → 5
// fn add(a,b)=a+b; add(2,3) → 5

fn is_space(ch: str) -> i64 {
    if ch == " " { return 1; }
    if ch == "\t" { return 1; }
    if ch == "\n" { return 1; }
    return 0;
}

fn is_digit(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}

fn is_alpha(ch: str) -> i64 {
    let c: i64 = ord(ch);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if ch == "_" { return 1; }
    return 0;
}

fn skip(s: str, i: i64) -> i64 {
    while i < len(s) {
        if is_space(s[i]) == 0 { break; }
        i = i + 1;
    }
    return i;
}

fn starts_with(s: str, i: i64, word: str) -> i64 {
    let j: i64 = 0;
    while j < len(word) {
        if i + j >= len(s) { return 0; }
        if s[i + j] != word[j] { return 0; }
        j = j + 1;
    }
    return 1;
}

fn starts_kw(s: str, i: i64, word: str) -> i64 {
    if starts_with(s, i, word) == 0 { return 0; }
    if i + len(word) < len(s) {
        let n: str = s[i + len(word)];
        if is_alpha(n) == 1 { return 0; }
        if is_digit(n) == 1 { return 0; }
    }
    return 1;
}

fn parse_number(s: str, i: i64) -> list {
    i = skip(s, i);
    let v: i64 = 0;
    let got: i64 = 0;
    while i < len(s) {
        if is_digit(s[i]) == 0 { break; }
        v = v * 10 + (ord(s[i]) - 48);
        i = i + 1;
        got = 1;
    }
    assert(got == 1);
    return [v, i];
}

fn parse_ident(s: str, i: i64) -> list {
    i = skip(s, i);
    let name: str = "";
    assert(is_alpha(s[i]) == 1);
    while i < len(s) {
        let ch: str = s[i];
        if is_alpha(ch) == 0 {
            if is_digit(ch) == 0 { break; }
        }
        name = name + ch;
        i = i + 1;
    }
    return [name, i];
}

fn env_get(names: list, vals: list, key: str) -> i64 {
    let i: i64 = 0;
    while i < len(names) {
        if names[i] == key { return vals[i]; }
        i = i + 1;
    }
    assert(0 == 1);
    return 0;
}

fn env_set(names: list, vals: list, key: str, v: i64) -> list {
    let i: i64 = 0;
    while i < len(names) {
        if names[i] == key {
            vals[i] = v;
            return [names, vals];
        }
        i = i + 1;
    }
    return [push(names, key), push(vals, v)];
}

fn fn_get(fnames: list, fparams: list, fbodies: list, key: str) -> list {
    let i: i64 = 0;
    while i < len(fnames) {
        if fnames[i] == key {
            return [1, fparams[i], fbodies[i]];
        }
        i = i + 1;
    }
    return [0, "", ""];
}

fn parse_factor(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    i = skip(s, i);
    if i < len(s) {
        if s[i] == "(" {
            let e = parse_expr(s, i + 1, names, vals, fnames, fparams, fbodies);
            let j: i64 = skip(s, e[1]);
            assert(s[j] == ")");
            return [e[0], j + 1, e[2], e[3]];
        }
        if s[i] == "-" {
            let f = parse_factor(s, i + 1, names, vals, fnames, fparams, fbodies);
            return [0 - f[0], f[1], f[2], f[3]];
        }
        if is_alpha(s[i]) == 1 {
            let id = parse_ident(s, i);
            let j: i64 = skip(s, id[1]);
            // call: name(
            if j < len(s) {
                if s[j] == "(" {
                    let hit = fn_get(fnames, fparams, fbodies, id[0]);
                    assert(hit[0] == 1);
                    let params: str = hit[1];
                    let body: str = hit[2];
                    j = j + 1;
                    // bind args
                    let local_n: list = [];
                    let local_v: list = [];
                    // copy outer env
                    let k: i64 = 0;
                    while k < len(names) {
                        local_n = push(local_n, names[k]);
                        local_v = push(local_v, vals[k]);
                        k = k + 1;
                    }
                    // parse param names from params string "a,b"
                    let pi: i64 = 0;
                    while true {
                        pi = skip(params, pi);
                        if pi >= len(params) { break; }
                        let pn = parse_ident(params, pi);
                        pi = skip(params, pn[1]);
                        j = skip(s, j);
                        let arg = parse_expr(s, j, names, vals, fnames, fparams, fbodies);
                        let env = env_set(local_n, local_v, pn[0], arg[0]);
                        local_n = env[0];
                        local_v = env[1];
                        j = arg[1];
                        j = skip(s, j);
                        if j < len(s) {
                            if s[j] == "," {
                                j = j + 1;
                                if pi < len(params) {
                                    if params[pi] == "," { pi = pi + 1; }
                                }
                                continue;
                            }
                        }
                        break;
                    }
                    j = skip(s, j);
                    assert(s[j] == ")");
                    j = j + 1;
                    let res = parse_expr(body, 0, local_n, local_v, fnames, fparams, fbodies);
                    return [res[0], j, names, vals];
                }
            }
            let v: i64 = env_get(names, vals, id[0]);
            return [v, id[1], names, vals];
        }
    }
    let n = parse_number(s, i);
    return [n[0], n[1], names, vals];
}

fn parse_term(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    let left = parse_factor(s, i, names, vals, fnames, fparams, fbodies);
    let v: i64 = left[0];
    let j: i64 = left[1];
    names = left[2];
    vals = left[3];
    while true {
        j = skip(s, j);
        if j >= len(s) { break; }
        let op: str = s[j];
        if op == "*" {
            let r = parse_factor(s, j + 1, names, vals, fnames, fparams, fbodies);
            v = v * r[0]; j = r[1]; names = r[2]; vals = r[3];
        } else {
            if op == "/" {
                let r = parse_factor(s, j + 1, names, vals, fnames, fparams, fbodies);
                v = v / r[0]; j = r[1]; names = r[2]; vals = r[3];
            } else { break; }
        }
    }
    return [v, j, names, vals];
}

fn parse_sum(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    let left = parse_term(s, i, names, vals, fnames, fparams, fbodies);
    let v: i64 = left[0];
    let j: i64 = left[1];
    names = left[2];
    vals = left[3];
    while true {
        j = skip(s, j);
        if j >= len(s) { break; }
        let op: str = s[j];
        if op == "+" {
            let r = parse_term(s, j + 1, names, vals, fnames, fparams, fbodies);
            v = v + r[0]; j = r[1]; names = r[2]; vals = r[3];
        } else {
            if op == "-" {
                let r = parse_term(s, j + 1, names, vals, fnames, fparams, fbodies);
                v = v - r[0]; j = r[1]; names = r[2]; vals = r[3];
            } else { break; }
        }
    }
    return [v, j, names, vals];
}

fn parse_cmp(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    let left = parse_sum(s, i, names, vals, fnames, fparams, fbodies);
    let v: i64 = left[0];
    let j: i64 = left[1];
    names = left[2];
    vals = left[3];
    j = skip(s, j);
    if j >= len(s) { return [v, j, names, vals]; }
    if starts_with(s, j, ">=") == 1 {
        let r = parse_sum(s, j + 2, names, vals, fnames, fparams, fbodies);
        let ok: i64 = 0;
        if v >= r[0] { ok = 1; }
        return [ok, r[1], r[2], r[3]];
    }
    if starts_with(s, j, "<=") == 1 {
        let r = parse_sum(s, j + 2, names, vals, fnames, fparams, fbodies);
        let ok: i64 = 0;
        if v <= r[0] { ok = 1; }
        return [ok, r[1], r[2], r[3]];
    }
    if starts_with(s, j, "==") == 1 {
        let r = parse_sum(s, j + 2, names, vals, fnames, fparams, fbodies);
        let ok: i64 = 0;
        if v == r[0] { ok = 1; }
        return [ok, r[1], r[2], r[3]];
    }
    if s[j] == ">" {
        let r = parse_sum(s, j + 1, names, vals, fnames, fparams, fbodies);
        let ok: i64 = 0;
        if v > r[0] { ok = 1; }
        return [ok, r[1], r[2], r[3]];
    }
    if s[j] == "<" {
        let r = parse_sum(s, j + 1, names, vals, fnames, fparams, fbodies);
        let ok: i64 = 0;
        if v < r[0] { ok = 1; }
        return [ok, r[1], r[2], r[3]];
    }
    return [v, j, names, vals];
}

fn parse_expr(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    i = skip(s, i);
    if starts_with(s, i, "if") == 1 {
        let c = parse_cmp(s, i + 2, names, vals, fnames, fparams, fbodies);
        let j: i64 = skip(s, c[1]);
        assert(starts_with(s, j, "then") == 1);
        let a = parse_expr(s, j + 4, c[2], c[3], fnames, fparams, fbodies);
        j = skip(s, a[1]);
        assert(starts_with(s, j, "else") == 1);
        let b = parse_expr(s, j + 4, a[2], a[3], fnames, fparams, fbodies);
        if c[0] != 0 {
            return [a[0], b[1], b[2], b[3]];
        }
        return [b[0], b[1], b[2], b[3]];
    }
    return parse_cmp(s, i, names, vals, fnames, fparams, fbodies);
}

fn exec_block(s: str, i: i64, end_word: str, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    // execute statements until end_word; return [last, pos, names, vals, fnames, fparams, fbodies]
    let last: i64 = 0;
    while true {
        i = skip(s, i);
        if i >= len(s) { break; }
        if starts_with(s, i, end_word) == 1 {
            break;
        }
        let r = exec_stmt(s, i, names, vals, fnames, fparams, fbodies);
        last = r[0];
        i = r[1];
        names = r[2];
        vals = r[3];
        fnames = r[4];
        fparams = r[5];
        fbodies = r[6];
    }
    return [last, i, names, vals, fnames, fparams, fbodies];
}

fn exec_stmt(s: str, i: i64, names: list, vals: list, fnames: list, fparams: list, fbodies: list) -> list {
    i = skip(s, i);
    // fn name(a,b)=body;
    if starts_with(s, i, "fn") == 1 {
        i = skip(s, i + 2);
        let id = parse_ident(s, i);
        i = skip(s, id[1]);
        assert(s[i] == "(");
        i = i + 1;
        let params: str = "";
        while true {
            i = skip(s, i);
            if s[i] == ")" { break; }
            let pn = parse_ident(s, i);
            if len(params) == 0 {
                params = pn[0];
            } else {
                params = params + "," + pn[0];
            }
            i = skip(s, pn[1]);
            if s[i] == "," { i = i + 1; }
        }
        assert(s[i] == ")");
        i = skip(s, i + 1);
        assert(s[i] == "=");
        i = i + 1;
        // body until ';'
        let body: str = "";
        while i < len(s) {
            if s[i] == ";" { break; }
            body = body + s[i];
            i = i + 1;
        }
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        fnames = push(fnames, id[0]);
        fparams = push(fparams, params);
        fbodies = push(fbodies, body);
        return [0, i, names, vals, fnames, fparams, fbodies];
    }
    // while cond do ... end
    if starts_with(s, i, "while") == 1 {
        let cond_start: i64 = i + 5;
        // find "do"
        let j: i64 = cond_start;
        while j < len(s) {
            if starts_with(s, j, "do") == 1 { break; }
            j = j + 1;
        }
        assert(starts_with(s, j, "do") == 1);
        let body_start: i64 = j + 2;
        // find matching end
        let k: i64 = body_start;
        while k < len(s) {
            if starts_with(s, k, "end") == 1 { break; }
            k = k + 1;
        }
        assert(starts_with(s, k, "end") == 1);
        let last: i64 = 0;
        while true {
            let c = parse_cmp(s, cond_start, names, vals, fnames, fparams, fbodies);
            if c[0] == 0 { break; }
            let b = exec_block(s, body_start, "end", names, vals, fnames, fparams, fbodies);
            last = b[0];
            names = b[2];
            vals = b[3];
            fnames = b[4];
            fparams = b[5];
            fbodies = b[6];
        }
        i = k + 3;
        i = skip(s, i);
        if i < len(s) { if s[i] == ";" { i = i + 1; } }
        return [last, i, names, vals, fnames, fparams, fbodies];
    }
    // assign or expr
    let save: i64 = i;
    if is_alpha(s[i]) == 1 {
        if starts_with(s, i, "if") == 0 {
            if starts_with(s, i, "while") == 0 {
                if starts_with(s, i, "fn") == 0 {
                    let id = parse_ident(s, i);
                    let j: i64 = skip(s, id[1]);
                    if j < len(s) {
                        if s[j] == "=" {
                            let e = parse_expr(s, j + 1, names, vals, fnames, fparams, fbodies);
                            let env = env_set(e[2], e[3], id[0], e[0]);
                            names = env[0];
                            vals = env[1];
                            i = e[1];
                            i = skip(s, i);
                            if i < len(s) { if s[i] == ";" { i = i + 1; } }
                            return [e[0], i, names, vals, fnames, fparams, fbodies];
                        }
                    }
                }
            }
        }
    }
    let e = parse_expr(s, save, names, vals, fnames, fparams, fbodies);
    i = e[1];
    i = skip(s, i);
    if i < len(s) { if s[i] == ";" { i = i + 1; } }
    return [e[0], i, e[2], e[3], fnames, fparams, fbodies];
}

fn run_program(src: str) -> i64 {
    let names: list = [];
    let vals: list = [];
    let fnames: list = [];
    let fparams: list = [];
    let fbodies: list = [];
    let i: i64 = 0;
    let last: i64 = 0;
    while i < len(src) {
        i = skip(src, i);
        if i >= len(src) { break; }
        let r = exec_stmt(src, i, names, vals, fnames, fparams, fbodies);
        last = r[0];
        i = r[1];
        names = r[2];
        vals = r[3];
        fnames = r[4];
        fparams = r[5];
        fbodies = r[6];
    }
    return last;
}

fn main() -> i64 {
    println("self-host while+fn");
    assert(run_program("2+3*4") == 14);
    assert(run_program("x=0; while x<5 do x=x+1 end; x") == 5);
    assert(run_program("s=0; i=1; while i<=4 do s=s+i; i=i+1 end; s") == 10);
    assert(run_program("fn dbl(n)=n*2; dbl(21)") == 42);
    assert(run_program("fn add(a,b)=a+b; add(20,22)") == 42);
    assert(run_program("fn sq(n)=n*n; x=sq(5); x+1") == 26);
    assert(run_program("x=1; i=1; while i<=5 do x=x*i; i=i+1 end; x") == 120);
    println("loopfn ok");
    return 0;
}
