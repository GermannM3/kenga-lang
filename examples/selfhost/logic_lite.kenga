fn in_range(n: i64, lo: i64, hi: i64) -> i64 {
    return n >= lo && n <= hi;
}

fn main() -> i64 {
    assert(10 % 3 == 1);
    assert(1 && 1);
    assert(!(1 && 0));
    assert(0 || 1);
    assert(!0);
    assert(!(1 == 2));
    assert(in_range(3, 1, 5));
    assert(!in_range(9, 1, 5));
    if 1 < 2 && 3 > 0 {
        println("logic ok");
    } else {
        assert(0);
    }
    return 0;
}
