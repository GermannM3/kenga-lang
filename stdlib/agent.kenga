//! Agent utilities: reduce / scan helpers over lists.

fn fold_add(xs: list) -> i64 {
    let s: i64 = 0;
    for v in xs {
        s = s + v;
    }
    return s;
}

fn count_eq(xs: list, needle: i64) -> i64 {
    let n: i64 = 0;
    for v in xs {
        if v == needle {
            n = n + 1;
        }
    }
    return n;
}

fn contains(xs: list, needle: i64) -> i64 {
    for v in xs {
        if v == needle {
            return 1;
        }
    }
    return 0;
}
