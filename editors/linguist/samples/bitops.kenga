// Bitwise & | ^ ~ << >> on i64 (see examples/bitops.kenga). MIT.

fn main() -> i64 {
  let flags: i64 = 0;
  flags = flags | (1 << 0);
  flags = flags | (1 << 1);
  flags = flags & ~(1 << 1);
  println(0xF0 & 0x0F);
  println(0xF0 | 0x0F);
  println(1 << 4);
  println((flags >> 0) & 1);
  return 0;
}
