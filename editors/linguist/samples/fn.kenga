// Recursion and a helper, not a hello-world. MIT.

fn fact(n: i64) -> i64 {
  if n <= 1 {
    return 1;
  }
  return n * fact(n - 1);
}

fn main() -> i64 {
  let n: i64 = 6;
  let acc: i64 = 1;
  let i: i64 = 1;
  while i <= n {
    acc = acc * i;
    i = i + 1;
  }
  println(fact(n));
  println(acc);
  return 0;
}
